import c
import files
import io
import memory
import platform
import strings

extern func float_environment_begin() -> i32
extern func float_environment_check()
extern func float_rounding(kind: i32)
extern func float_environment_end()
extern func float_fault_begin(mode: i32)
extern func float_fault_end(expected_hits: i32)

func check_failures() -> !:
    for mode in 1..<(8 if platform.macos or platform.windows else 9):
        let expected = memory.exhausted if mode == 1 or mode == 3 else strings.invalid_number if mode == 5 else strings.conversion_failed
        for narrow in 0..<2:
            var failed = false
            float_fault_begin((i32)mode)
            if mode < 6:
                if narrow == 0:
                    discard(strings.parse_f64("12.5") catch failure:
                        assert(failure.code == expected)
                        failed = true
                        recover 0.0)
                else:
                    discard(strings.parse_f32("12.5") catch failure:
                        assert(failure.code == expected)
                        failed = true
                        recover (f32)0)
            else:
                var output: u8[32]
                memory.set(output, 85)
                if narrow == 0:
                    discard(strings.format_f64(12.5, output) catch failure:
                        assert(failure.code == expected)
                        failed = true
                        recover "")
                else:
                    discard(strings.format_f32((f32)12.5, output) catch failure:
                        assert(failure.code == expected)
                        failed = true
                        recover "")
                for byte in output:
                    assert(byte == 85)
            assert(failed)
            float_fault_end(1)
    var empty: u8[]
    var refusing = memory.FixedBuffer.over(empty)
    with refusing:
        for narrow in 0..<2:
            float_fault_begin(9)
            var failed = false
            if narrow == 0:
                discard(strings.parse_f64("12.5") catch failure:
                    assert(failure.code == memory.exhausted)
                    failed = true
                    recover 0.0)
            else:
                discard(strings.parse_f32("12.5") catch failure:
                    assert(failure.code == memory.exhausted)
                    failed = true
                    recover (f32)0)
            assert(failed)
            float_fault_end(0)
        # Special values need neither an input copy nor a numeric locale.
        float_fault_begin(1)
        discard(try strings.parse_f64("-inf"))
        discard(try strings.parse_f32("nan"))
        float_fault_end(0)
        var output: u8[32]
        assert(try strings.format_f64(12.5, output) == "12.5")
        assert(try strings.format_f32((f32)12.5, output) == "12.5")

func check64(text: str, status: u32, bits: u64) -> !:
    var failed = false
    let value = strings.parse_f64(text) catch failure:
        assert(status != 1)
        assert(failure.code == (strings.invalid_number if status == 0 else strings.number_out_of_range))
        failed = true
        recover 0.0
    if failed:
        return
    assert(status == 1 and memory.read[u64](&value) == bits)
    var output: u8[32]
    memory.set(output, 85)
    let rendered = try strings.format_f64(value, output)
    assert(rendered.length > 0 and rendered.length < 32)
    for byte in output[rendered.length..]:
        assert(byte == 85)
    let restored = try strings.parse_f64(rendered)
    if (bits & 9223372036854775807) <= 9218868437227405312:
        assert(memory.read[u64](&restored) == bits)
    memory.set(output, 85)
    failed = false
    discard(strings.format_f64(value, output[..<rendered.length - 1]) catch failure:
        assert(failure.code == io.full)
        failed = true
        recover "")
    assert(failed)
    for byte in output:
        assert(byte == 85)

func check32(text: str, status: u32, bits: u32) -> !:
    var failed = false
    let value = strings.parse_f32(text) catch failure:
        assert(status != 1)
        assert(failure.code == (strings.invalid_number if status == 0 else strings.number_out_of_range))
        failed = true
        recover (f32)0
    if failed:
        return
    assert(status == 1 and memory.read[u32](&value) == bits)
    var output: u8[32]
    memory.set(output, 85)
    let rendered = try strings.format_f32(value, output)
    for byte in output[rendered.length..]:
        assert(byte == 85)
    let restored = try strings.parse_f32(rendered)
    if (bits & 2147483647) <= 2139095040:
        assert(memory.read[u32](&restored) == bits)
    memory.set(output, 85)
    failed = false
    discard(strings.format_f32(value, output[..<rendered.length - 1]) catch failure:
        assert(failure.code == io.full)
        failed = true
        recover "")
    assert(failed)
    for byte in output:
        assert(byte == 85)

pub func main(arguments: c.str[]) -> i32!:
    discard(float_environment_begin())
    defer float_environment_end()
    let corpus = try files.read(arguments[1])
    defer free(corpus)
    var position: usize = 0
    var count: usize = 0
    while position < corpus.length:
        let length = (usize)memory.read[u32](corpus.data + position)
        let status64 = memory.read[u32](corpus.data + position + 4)
        let status32 = memory.read[u32](corpus.data + position + 8)
        let bits64 = memory.read[u64](corpus.data + position + 12)
        let bits32 = memory.read[u32](corpus.data + position + 20)
        position += 24
        let text = (str)corpus[position..<position + length]
        position += length
        try check64(text, status64, bits64)
        try check32(text, status32, bits32)
        float_environment_check()
        count += 1
    assert(count > 5000)
    for kind in 0..<4:
        float_rounding((i32)kind)
        let value = try strings.parse_f64("1.00000000000000011102230246251565404236316680908203125")
        assert(memory.read[u64](&value) == (4607182418800017409 if kind == 2 else 4607182418800017408))
        let narrow = try strings.parse_f32("1.000000059604644775390625")
        assert(memory.read[u32](&narrow) == (1065353217 if kind == 2 else 1065353216))
        var failed = false
        discard(strings.parse_f64("1e1000") catch failure:
            assert(failure.code == strings.number_out_of_range)
            failed = true
            recover 0.0)
        assert(failed)
        failed = false
        discard(strings.parse_f32("-1e1000") catch failure:
            assert(failure.code == strings.number_out_of_range)
            failed = true
            recover (f32)0)
        assert(failed)
        float_environment_check()
        var output: u8[32]
        discard(try strings.format_f64(value, output))
        discard(try strings.format_f32(narrow, output))
        float_environment_check()
    float_rounding(0)
    try check_failures()
    print("ok floating-point text conversion")
    return 0
