## The same editor with a window: SDL3 for the window, the renderer, and the
## keyboard, through `sdl3.lucb`, the module `luce-base bind` writes from SDL's own
## headers, and nothing else. The editing session, the buffer, and the history are
## the terminal editor's modules.
##
##     gui FILE                     edit FILE in a window
##     gui FILE --replay SCRIPT     apply the keys headlessly (the dummy video driver), save, print the frame
##
## Build: luce-base build tests/programs/gui/main.lucb --native (the manifest names SDL3 through pkg-config)

import c
import editor.buffer
import editor.session
import editor.terminal
import files
import memory
import sdl3

## The debug font is 8 by 8; the renderer scales it up.
let cell: f32 = 8.0
let scale: f32 = 2.0

pub let failed: ErrorCode = ErrorCode.package(2)

struct Window:
    var window: sdl3.SDL_Window
    var renderer: sdl3.SDL_Renderer
    var columns: usize
    var rows: usize
    var top: usize

    static func open(headless: bool) -> Window!:
        if headless:
            discard(sdl3.SDL_SetHint("SDL_VIDEO_DRIVER", "dummy"))
        if not sdl3.SDL_Init(sdl3.SDL_INIT_VIDEO):
            error(failed, sdl_error())
        let window = sdl3.SDL_CreateWindow("luce editor", 960, 640, sdl3.SDL_WINDOW_RESIZABLE | sdl3.SDL_WINDOW_HIGH_PIXEL_DENSITY) else error(failed, sdl_error())
        let renderer = sdl3.SDL_CreateRenderer(window, none) else error(failed, sdl_error())
        discard(sdl3.SDL_SetRenderScale(renderer, scale, scale))
        var w = Window(window = window, renderer = renderer, columns = 60, rows = 40, top = 0)
        w.measure()
        return w

    mutating func measure():
        var width: i32 = 960
        var height: i32 = 640
        discard(sdl3.SDL_GetRenderOutputSize(self.renderer, &width, &height))
        self.columns = (usize)((f32)width / scale / cell)
        self.rows = (usize)((f32)height / scale / cell)
        if self.rows < 3:
            self.rows = 3
        if self.columns < 8:
            self.columns = 8

    func close():
        sdl3.SDL_DestroyRenderer(self.renderer)
        sdl3.SDL_DestroyWindow(self.window)
        sdl3.SDL_Quit()

    ## One frame: the text rows, the cursor as a block, a status line, the message.
    mutating func draw(text: buffer.Buffer*, name: str, message: str):
        let text_rows = self.rows - 2
        let line = text.line_of(text.cursor)
        if line < self.top:
            self.top = line
        if line >= self.top + text_rows:
            self.top = line + 1 - text_rows
        discard(sdl3.SDL_SetRenderDrawColor(self.renderer, 24, 24, 30, 255))
        discard(sdl3.SDL_RenderClear(self.renderer))
        var row_bytes: u8[1024]
        let total = text.count_lines()
        var row: usize = 0
        while row < text_rows:
            let index = self.top + row
            if index < total:
                let start = text.line_at(index)
                let end = text.line_end(start)
                let raw = text.slice(start, end, row_bytes[..<row_bytes.length - 1])
                self.text_at(0, row, raw, 220, 220, 220)
            row += 1
        # the cursor
        let column = text.column_of(text.cursor)
        let cursor = sdl3.SDL_FRect(x = (f32)column * cell, y = (f32)(line - self.top) * cell, w = cell, h = cell)
        discard(sdl3.SDL_SetRenderDrawColor(self.renderer, 250, 200, 80, 160))
        discard(sdl3.SDL_RenderFillRect(self.renderer, &cursor))
        # the status line and the message
        let bar = sdl3.SDL_FRect(x = 0.0, y = (f32)text_rows * cell, w = (f32)self.columns * cell, h = cell)
        discard(sdl3.SDL_SetRenderDrawColor(self.renderer, 70, 70, 90, 255))
        discard(sdl3.SDL_RenderFillRect(self.renderer, &bar))
        var status: u8[256]
        let mark = " *" if text.dirty else ""
        let shown = format(status, f" {name}{mark}   {line + 1}:{column + 1}   {total} lines") catch:
            return
        self.text_at(0, text_rows, shown.bytes, 255, 255, 255)
        self.text_at(0, text_rows + 1, message.bytes, 180, 180, 200)
        discard(sdl3.SDL_RenderPresent(self.renderer))

    ## Text at a cell position, NUL-terminated for SDL, cut at the right edge.
    func text_at(column: usize, row: usize, raw: const u8[], r: u8, g: u8, b: u8):
        var line: u8[1024]
        var n = raw.length if raw.length < line.length - 1 else line.length - 1
        if n > self.columns:
            n = self.columns
        memory.copy(line, raw, n)
        line[n] = 0
        discard(sdl3.SDL_SetRenderDrawColor(self.renderer, r, g, b, 255))
        discard(sdl3.SDL_RenderDebugText(self.renderer, (f32)column * cell, (f32)row * cell, (c.str)(str)line[..<n]))

## SDL's last error as text; the binding says it may be null, so an empty text stands in.
func sdl_error() -> str:
    let text = sdl3.SDL_GetError() else return "SDL failed without a message"
    return (str)text

## The next key from SDL's queue, none when the queue is empty; quit closes the session.
func next_key(quit: bool*) -> terminal.Key?:
    var event: sdl3.SDL_Event = ---
    while sdl3.SDL_PollEvent(&event):
        let kind = event.type_
        if kind == (u32)sdl3.SDL_EventType.SDL_EVENT_QUIT:
            *quit = true
            return none
        if kind == (u32)sdl3.SDL_EventType.SDL_EVENT_TEXT_INPUT:
            let text = event.text.text else continue
            let bytes = (str)text
            if bytes.length > 0:
                # the rest of a multi-byte character follows through the queue
                pending_text = bytes
                pending_at = 1
                return terminal.Key.character(byte = bytes.bytes[0])
            continue
        if kind == (u32)sdl3.SDL_EventType.SDL_EVENT_KEY_DOWN:
            if let translated = translate(event.key.key, (u32)event.key.mod):
                return translated
    return none

## Bytes of a multi-byte character after its first, handed out one key at a time.
var pending_text: str
var pending_at: usize

func pending_key() -> terminal.Key?:
    if pending_at == 0 or pending_at >= pending_text.length:
        pending_at = 0
        return none
    let byte = pending_text.bytes[pending_at]
    pending_at += 1
    return terminal.Key.character(byte = byte)

func translate(key: u32, mod: u32) -> terminal.Key?:
    if (mod & sdl3.SDL_KMOD_CTRL) != 0 or (mod & sdl3.SDL_KMOD_GUI) != 0:
        if key >= (u32)'a' and key <= (u32)'z':
            return terminal.Key.control(letter = (u8)key - 32)
        return none
    let by_word = (mod & sdl3.SDL_KMOD_ALT) != 0
    if key == sdl3.SDLK_RETURN:
        return terminal.Key.enter
    if key == sdl3.SDLK_BACKSPACE:
        return terminal.Key.backspace
    if key == sdl3.SDLK_ESCAPE:
        return terminal.Key.escape
    if key == sdl3.SDLK_DELETE:
        return terminal.Key.delete
    if key == sdl3.SDLK_LEFT:
        return terminal.Key.word_left if by_word else terminal.Key.left
    if key == sdl3.SDLK_RIGHT:
        return terminal.Key.word_right if by_word else terminal.Key.right
    if key == sdl3.SDLK_UP:
        return terminal.Key.up
    if key == sdl3.SDLK_DOWN:
        return terminal.Key.down
    if key == sdl3.SDLK_HOME:
        return terminal.Key.home
    if key == sdl3.SDLK_END:
        return terminal.Key.end_
    if key == sdl3.SDLK_PAGEUP:
        return terminal.Key.page_up
    if key == sdl3.SDLK_PAGEDOWN:
        return terminal.Key.page_down
    if key == sdl3.SDLK_TAB:
        return terminal.Key.character(byte = 9)
    return none

pub func main(arguments: str[]) -> i32!:
    if arguments.length < 2 or arguments.length == 3 or arguments.length > 4:
        print("usage: gui FILE [--replay SCRIPT]")
        return 2
    let headless = arguments.length == 4
    var editor = session.Session.open(arguments[1]) catch failure:
        print(f"gui: {failure.message}")
        return 1
    defer editor.close()
    var window = Window.open(headless) catch failure:
        print(f"gui: {failure.message}")
        return 1
    defer window.close()
    editor.page_rows = window.rows - 2
    if headless:
        var script_name: u8[1024]
        let script_path = try format(script_name, f"{arguments[3]}")
        let keys = try files.read((c.str)script_path)
        defer free(keys)
        try editor.replay(try str(keys))
        window.draw(&editor.text, editor.path, editor.message())
        let copy = try editor.text.copy()
        defer free(copy)
        # the frame the window would show, as text, for the proving script to compare
        print(f"{window.columns}x{window.rows} cells")
        print((str)copy)
        print(editor.message())
        return 0
    discard(sdl3.SDL_StartTextInput(window.window))
    editor.say("^S save  ^Q quit  ^F find  ^Z undo  ^Y redo  ^K delete line")
    var quit = false
    while editor.running and not quit:
        window.measure()
        editor.page_rows = window.rows - 2
        window.draw(&editor.text, editor.path, editor.message())
        var key = pending_key()
        if key == none:
            key = next_key(&quit)
        if let k = key:
            editor.handle(k) catch failure:
                editor.say(failure.message)
        else:
            sdl3.SDL_Delay(16)
    return 0
