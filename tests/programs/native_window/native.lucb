## Test-only AppKit calls manufacture native events and find windows by title.
## The production library exports no injection hooks or raw native pointers.
import c

extern struct ProbePoint:
    x: f64
    y: f64

extern func objc_getClass(name: c.str) -> void*
extern func sel_registerName(name: c.str) -> void*
extern func objc_autoreleasePoolPush() -> void*
extern func objc_autoreleasePoolPop(pool: void*)
extern func msg as "objc_msgSend"(object: void*, selector: void*) -> void*
extern func uint as "objc_msgSend"(object: void*, selector: void*) -> u64
extern func indexed as "objc_msgSend"(object: void*, selector: void*, index: u64) -> void*
extern func text as "objc_msgSend"(object: void*, selector: void*) -> c.str
extern func call as "objc_msgSend"(object: void*, selector: void*, argument: void*?)
extern func invoke as "objc_msgSend"(object: void*, selector: void*)
extern func notify as "objc_msgSend"(object: void*, selector: void*, name: void*, sender: void*)
extern var NSWindowDidBecomeKeyNotification: void*
extern var NSWindowDidResignKeyNotification: void*
extern func CGEventCreateScrollWheelEvent(source: void*?, units: u32, wheels: u32, vertical: i32, ...) -> void*
extern func CFRelease(object: void*)
extern func from_cg as "objc_msgSend"(object: void*, selector: void*, event: void*) -> void*
extern func key_event as "objc_msgSend"(object: void*, selector: void*, kind: u64, point: ProbePoint, flags: u64, time: f64, number: i64, context: void*?, characters: void*, plain: void*, repeated: bool, code: u16) -> void*
extern func mouse_event as "objc_msgSend"(object: void*, selector: void*, kind: u64, point: ProbePoint, flags: u64, time: f64, number: i64, context: void*?, sequence: i64, clicks: i64, pressure: f32) -> void*

pub func pool() -> void*:
    return objc_autoreleasePoolPush()

pub func drain(token: void*):
    objc_autoreleasePoolPop(token)

pub func find(title: str) -> void*:
    let app = msg(objc_getClass("NSApplication"), sel_registerName("sharedApplication"))
    let windows = msg(app, sel_registerName("windows"))
    var i: u64 = 0
    while i < uint(windows, sel_registerName("count")):
        let native = indexed(windows, sel_registerName("objectAtIndex:"), i)
        let name = msg(native, sel_registerName("title"))
        if (str)text(name, sel_registerName("UTF8String")) == title:
            return native
        i += 1
    trap("test window was not registered with AppKit")

pub func close(window: void*):
    call(window, sel_registerName("performClose:"), none)

## Focus acquisition is controlled by the desktop, including its foreground app.
## Exercise the actual notification-to-delegate path without stealing user focus.
pub func focus_notification(window: void*, gained: bool):
    let center = msg(objc_getClass("NSNotificationCenter"), sel_registerName("defaultCenter"))
    notify(center, sel_registerName("postNotificationName:object:"), NSWindowDidBecomeKeyNotification if gained else NSWindowDidResignKeyNotification, window)

pub func key(window: void*, kind: u64, code: u16, repeated: bool = false, direct: bool = false):
    let characters = msg(objc_getClass("NSString"), sel_registerName("new"))
    let event = key_event(objc_getClass("NSEvent"), sel_registerName("keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:"), kind, ProbePoint(), 1 << 17, 0.0, (i64)uint(window, sel_registerName("windowNumber")), none, characters, characters, repeated, code)
    if direct:
        let view = msg(window, sel_registerName("contentView"))
        call(view, sel_registerName("flagsChanged:" if kind == 12 else ("keyDown:" if kind == 10 else "keyUp:")), event)
    else:
        call(window, sel_registerName("sendEvent:"), event)
    invoke(characters, sel_registerName("release"))

pub func mouse(window: void*, kind: u64, x: f64, y: f64):
    let event = mouse_event(objc_getClass("NSEvent"), sel_registerName("mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:"), kind, ProbePoint(x = x, y = y), 0, 0.0, (i64)uint(window, sel_registerName("windowNumber")), none, 1, 1, 0.0)
    let view = msg(window, sel_registerName("contentView"))
    call(view, sel_registerName("mouseDown:" if kind == 1 else "mouseUp:"), event)

pub func scroll(window: void*, points: bool):
    let cg = CGEventCreateScrollWheelEvent(none, 0 if points else 1, 2, i32(3), i32(-2))
    defer CFRelease(cg)
    let event = from_cg(objc_getClass("NSEvent"), sel_registerName("eventWithCGEvent:"), cg)
    let view = msg(window, sel_registerName("contentView"))
    call(view, sel_registerName("scrollWheel:"), event)
