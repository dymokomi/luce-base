import memory
import thread
from ownership import Object, Info, allocate, retain, release, release_held, candidate_limit, reserve, discard_unpublished, abandon, context_id, weak_make, weak_drop, weak_get, pool_object, mark, drain, collect, finish_run, live_count

## A hand-built class, shaped as the emitter shapes one: the header first, then the fields.
struct Node:
    var header: Object
    var value: i64
    var next: Node*?

local var log: u8[64]
local var logged: usize = 0

func note(byte: u8):
    if logged < log.length:
        log[logged] = byte
        logged += 1

func node_finish(o: Object*):
    let n = (Node*)o
    note(u8(48 + n.value))

func node_drop(o: Object*):
    let n = (Node*)o
    if let next = n.next:
        n.next = none
        release((Object*)next)

func node_trace(o: Object*, visit: func(Object*, void*) -> unit, context: void*):
    let n = (Node*)o
    if let next = n.next:
        visit((Object*)next, context)

var node_info: Info = Info(name = "Node", size = memory.size_of(Node), finish = node_finish, drop = node_drop, trace = node_trace)

func node(value: i64) -> Node*:
    let n = (Node*)allocate(&node_info)
    n.value = value
    return n

## The same node as a native object's owner, whose finish disposes what others may reach.
var disposing_info: Info = Info(name = "Disposing", size = memory.size_of(Node), finish = node_finish, drop = node_drop,
                                trace = node_trace, disposes = true)

func disposing(value: i64) -> Node*:
    let n = (Node*)allocate(&disposing_info)
    n.value = value
    return n

## The shared runtime uses stable heap storage between isolated test arenas.
func fresh():
    assert(finish_run(0) == 0)
    logged = 0

test "a release at zero destroys: deinit, then the fields":
    fresh()
    let a = node(1)
    a.next = node(2)
    release((Object*)a)
    assert((str)log[..<logged] == "12")
    assert(live_count() == 0)

test "a cycle is collected with its deinits in the order its objects were made":
    fresh()
    let a = node(3)
    let b = node(4)
    a.next = (Node*)retain((Object*)b)
    b.next = (Node*)retain((Object*)a)
    release((Object*)b)
    release((Object*)a)
    assert(live_count() == 2)
    collect()
    assert(live_count() == 0)
    # `a` was made first, though `b` became a candidate first
    assert((str)log[..<logged] == "34")

test "a weak reference outlives its object and answers none":
    fresh()
    let a = node(5)
    let w = weak_make((Object*)a)
    assert(weak_get(w) != none)
    release((Object*)a)   # the get above retained
    assert(live_count() == 1)
    release((Object*)a)
    assert(live_count() == 0)
    assert(weak_get(w) == none)
    weak_drop(w)
    assert((str)log[..<logged] == "5")

test "temporaries drain in the order they were pooled":
    fresh()
    let m = mark()
    _ = pool_object((Object*)node(6))
    _ = pool_object((Object*)node(7))
    assert(logged == 0)
    drain(m)
    assert((str)log[..<logged] == "67")
    assert(live_count() == 0)

test "the run's end reports what is alive":
    fresh()
    let a = node(8)
    # this writes `runtime: 1 objects alive at exit` to stderr on purpose: the report is
    # what is under test, and the test output carries the line after `passed`
    assert(finish_run(0) == 3)
    release((Object*)a)
    assert(finish_run(0) == 0)

test "unpublished native failure skips successful-object finalization":
    fresh()
    let value = try reserve(&node_info, memory.size_of(Node))
    discard_unpublished(value)
    assert(live_count() == 0 and logged == 0)
    assert(finish_run(0) == 0)

test "an allocation records its allocator and does not reuse its identity":
    fresh()
    var storage: u8[2048]
    var arena = memory.FixedBuffer.over(storage)
    let allocator: memory.Allocator = &arena
    let first = try reserve(&node_info, memory.size_of(Node), allocator)
    let address = (usize)first
    let generation = first.generation
    discard_unpublished(first)
    let second = try reserve(&node_info, memory.size_of(Node), allocator)
    assert((usize)second == address)
    assert(second.generation != generation)
    assert(second.context == context_id())
    discard_unpublished(second)
    assert(finish_run(0) == 0)

test "reservation propagates allocation failure without publishing ownership":
    fresh()
    var storage: u8[1]
    var arena = memory.FixedBuffer.over(storage)
    let allocator: memory.Allocator = &arena
    let value = reserve(&node_info, memory.size_of(Node), allocator) catch failure:
        assert(failure.code == memory.exhausted)
        assert(live_count() == 0 and logged == 0)
        return
    _ = value
    assert(false)

## A class whose drop runs a collection after releasing its field, and whose trace counts
## the walks into it that happen while it is being dropped.
local var dropping: bool = false
local var walked_while_dropping: usize = 0

func probe_drop(o: Object*):
    let n = (Node*)o
    dropping = true
    if let next = n.next:
        release((Object*)next)
    # the field is released but left in place, as a drop that tolerates unassigned fields
    # may leave it: a walk into the object now would read freed storage
    collect()
    dropping = false

func probe_trace(o: Object*, visit: func(Object*, void*) -> unit, context: void*):
    if dropping:
        walked_while_dropping += 1
        return
    let n = (Node*)o
    if let next = n.next:
        visit((Object*)next, context)

var probe_info: Info = Info(name = "Probe", size = memory.size_of(Node), finish = none, drop = probe_drop, trace = probe_trace)

test "abandon takes the object out of the collector's candidates before its fields go":
    fresh()
    let probe = (Node*)allocate(&probe_info)
    probe.next = node(1)
    # a release that leaves a count makes the object a purple candidate
    _ = retain((Object*)probe)
    release((Object*)probe)
    abandon((Object*)probe, "", "")
    assert(walked_while_dropping == 0)
    assert(live_count() == 0)
    assert((str)log[..<logged] == "1")
    assert(finish_run(0) == 0)

test "abandon lets go of a field that refers back to the object":
    fresh()
    let parent = node(2)
    let child = node(3)
    child.next = (Node*)retain((Object*)parent)
    parent.next = child
    # the child's release of its parent is bookkeeping; no `deinit` runs for the parent
    abandon((Object*)parent, "", "")
    assert(live_count() == 0)
    assert((str)log[..<logged] == "3")
    assert(finish_run(0) == 0)

## A hand-built class with two references, for a cycle that also refers outside itself.
struct Duo:
    var header: Object
    var left: Object*?
    var right: Object*?

func duo_drop(o: Object*):
    let d = (Duo*)o
    if let left = d.left:
        d.left = none
        release(left)
    if let right = d.right:
        d.right = none
        release(right)

func duo_trace(o: Object*, visit: func(Object*, void*) -> unit, context: void*):
    let d = (Duo*)o
    if let left = d.left:
        visit(left, context)
    if let right = d.right:
        visit(right, context)

var duo_info: Info = Info(name = "Duo", size = memory.size_of(Duo), finish = none, drop = duo_drop, trace = duo_trace)

test "a garbage cycle's reference to a live object costs the object that one reference":
    fresh()
    let kept = node(5)
    let a = (Duo*)allocate(&duo_info)
    let b = (Duo*)allocate(&duo_info)
    a.left = retain((Object*)b)
    b.left = retain((Object*)a)
    a.right = retain((Object*)kept)
    b.right = retain((Object*)kept)
    release((Object*)b)
    release((Object*)a)
    collect()
    # the cycle is gone and `kept` lost the two references it held, no more
    assert(live_count() == 1)
    assert(logged == 0)
    release((Object*)kept)
    assert((str)log[..<logged] == "5")
    assert(live_count() == 0)

test "a cycle's deinits run first, then its disposals, each before what it refers to":
    fresh()
    # made oldest first: a native node, the native object holding it, a plain object holding
    # that; the node's reference back to the plain object closes the cycle
    let inner = disposing(1)
    let outer = disposing(2)
    let root = node(3)
    outer.next = (Node*)retain((Object*)inner)
    root.next = (Node*)retain((Object*)outer)
    inner.next = (Node*)retain((Object*)root)
    release((Object*)inner)
    release((Object*)outer)
    release((Object*)root)
    collect()
    assert((str)log[..<logged] == "321")
    assert(live_count() == 0)
    assert(finish_run(0) == 0)

## Counts the blocks taken from the heap it wraps.
struct Counting: memory.Allocator:
    var upstream: memory.Allocator
    var live: usize

    pub func allocate(size: usize, alignment: usize) -> u8[]?:
        let block = self.upstream.allocate(size, alignment) else return none
        self.live += 1
        return block

    pub func resize(block: u8[], size: usize) -> bool:
        return false

    pub func release(block: u8[]):
        self.live -= 1
        self.upstream.release(block)

## A worker's collector starts with no buffers: they grow in its first collection, and the
## end of its run gives them back. Its cycle is of plain objects or of native ones.
func collect_cycle(native: bool):
    let a = disposing(1) if native else node(1)
    let b = disposing(2) if native else node(2)
    a.next = (Node*)retain((Object*)b)
    b.next = (Node*)retain((Object*)a)
    release((Object*)a)
    release((Object*)b)
    collect()
    assert(finish_run(0) == 0)

func collect_plain_cycle(context: void*?):
    collect_cycle(false)

func collect_native_cycle(context: void*?):
    collect_cycle(true)

## The blocks left in `memory.heap` by a worker running `body`, its thread's own included.
func left_by(body: func(void*?) -> unit) -> usize!:
    var counting = Counting(upstream = memory.heap, live = 0)
    let previous = memory.heap
    memory.heap = &counting
    defer memory.heap = previous
    let worker = try thread.spawn(body, none)
    try worker.join()
    return counting.live

test "the end of a run gives back every buffer a collection of native objects grew":
    fresh()
    assert(try left_by(collect_native_cycle) == try left_by(collect_plain_cycle))

test "a release through a native handle never collects, so a field it left stale is never traced":
    fresh()
    # `child` is held once, by `owner`; `holder`'s traced field still names it after native
    # code released that edge, and before it stores the field's next value. Both holders
    # are candidates, so a collection would take `child`'s one reference away twice.
    let owner = node(1)
    let holder = node(2)
    let child = node(3)
    owner.next = child
    holder.next = (Node*)retain((Object*)child)
    release_held(retain((Object*)owner))
    release_held(retain((Object*)holder))
    var fillers: Node*[1024] = ---
    for i in 0..<candidate_limit - 3:
        fillers[i] = node(4)
        release_held(retain((Object*)fillers[i]))
    # the candidate that fills the buffer, with `holder.next` stale
    release_held((Object*)child)
    holder.next = none
    collect()
    assert(live_count() == candidate_limit and logged == 0)
    for i in 0..<candidate_limit - 3:
        release((Object*)fillers[i])
    release((Object*)holder)
    release((Object*)owner)
    assert(live_count() == 0)
    assert(finish_run(0) == 0)
