## Observable loops and failure paths used by an independent C driver. These
## exports stay callable so optimizer checks inspect runtime inputs, not folds.
export func safe_total(values: const u64[]) -> u64:
    var total: u64 = 0
    var index: usize = 0
    while index < values.length:
        total +%= values[index]
        index += 1
    return total

export func repeated(values: const u64[], index: usize) -> u64:
    return values[index] +% values[index]

export func changed_index(values: const u64[], index: usize) -> u64:
    if index < values.length:
        print("before bounds")
        return values[index + 1]
    return 0

export func changed_length(values: const u64[], index: usize) -> u64:
    var view = values
    if index < view.length:
        print("before bounds")
        view = view[..<index]
        return view[index]
    return 0

export func joined(values: const u64[], index: usize, guarded: bool) -> u64:
    if guarded:
        if index >= values.length:
            return 0
    return values[index]

export func checked_next(value: u64) -> u64:
    if value <= 18446744073709551615:
        return value + 1
    return 0

export func signed_next(value: i64) -> i64:
    return value + 1

export func distance(left: u64, right: u64) -> u64:
    return left - right if left >= right else right - left

export func small_product(left: u32, right: u32) -> u32:
    if left < 65536 and right < 65536:
        return left * right
    return left * right

export func uncertain(values: const u64[], index: usize) -> u64:
    return values[index]

export func empty_division(iterations: usize, divisor: u64) -> u64:
    var total: u64 = 0
    var at: usize = 0
    while at < iterations:
        total +%= 100 // divisor
        at += 1
    return total

export func changing_limit(limit: usize*) -> usize:
    var index: usize = 0
    while index < *limit:
        *limit -= 1
        index += 1
    return index

export func invariant_float(iterations: usize, value: f64) -> f64:
    var result = value
    var index: usize = 0
    while index < iterations:
        result = result * 0.125 + 0.375
        index += 1
    return result

struct LargeValue:
    var first: u64
    var second: u64
    var third: u64

noinline func optional_large(index: usize) -> LargeValue?:
    if index % 2 == 0:
        return none
    return LargeValue(first = (u64)index, second = 7, third = 11)

export func changing_call_result(iterations: usize) -> u64:
    var result: u64 = 0
    var index: usize = 0
    while index < iterations:
        if let value = optional_large(index):
            result +%= value.first +% value.second +% value.third
        index += 1
    return result

export func discarded_call_result() -> u64:
    discard(optional_large(1))
    return 77

export func map_doubles(target: f64[], source: const f64[]):
    assert(target.length == source.length)
    var index: usize = 0
    while index < target.length:
        target[index] = target[index] * 0.125 + source[index] * 0.375
        index += 1

export func map_floats(target: f32[], source: const f32[]):
    assert(target.length == source.length)
    var index: usize = 0
    while index < target.length:
        target[index] = target[index] * 0.125 + source[index] * 0.375
        index += 1

export func sum_dwords(values: const u32[], initial: u32) -> u32:
    var result = initial
    var index: usize = 0
    while index < values.length:
        result +%= values[index]
        index += 1
    return result

export func checked_total(values: const u64[]) -> u64:
    var result: u64 = 0
    var index: usize = 0
    while index < values.length:
        result += values[index]
        index += 1
    return result

export func grid_read(values: const u64[], rows: usize, columns: usize, row: usize, column: usize) -> u64:
    assert(values.length == rows * columns)
    if row < rows:
        if column < columns:
            return values[row * columns + column]
    return 0

export func grid_edge(rows: u64, width: u64, row: u64, column: u64) -> u64:
    discard(rows * width)
    if row <= rows:
        if column < width:
            return row * width + column
    return 0
