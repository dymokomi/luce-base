## Hidden native windows exercise committed text without GPU hardware or focus.
import input
import thread
import window

extern func PostMessageW(window: void*, message: u32, word: usize, value: isize) -> i32

pub func main(arguments: str[]) -> i32!:
    var host = try window.Window.open(window.Options(title = "Luce text input contract"))
    defer host.destroy()
    var lease = try host.acquire_presentation()
    defer lease.destroy()
    let handle = try lease.windows_handle()
    while let event = try host.poll():
        discard(event)
    try host.set_text_input(true)
    assert(PostMessageW(handle, 258, 233, 1) != 0)
    assert(PostMessageW(handle, 258, 0xD83D, 1) != 0)
    assert(PostMessageW(handle, 258, 0xDE00, 1) != 0)
    assert(PostMessageW(handle, 265, 0x4E16, 1) != 0)
    var expected: u32[3] = [233, 128512, 0x4E16]
    var received: usize = 0
    for tick in 0..<200:
        while let event = try host.poll():
            if event.kind == input.EventKind.text_input:
                assert(received < expected.length and event.codepoint == expected[received])
                received += 1
        if received == expected.length:
            break
        thread.sleep(1)
    assert(received == expected.length)
    try host.set_text_input(false)
    assert(PostMessageW(handle, 258, 97, 1) != 0)
    for tick in 0..<8:
        while let event = try host.poll():
            assert(event.kind != input.EventKind.text_input)
        thread.sleep(1)
    print("ok Windows Unicode text input")
    return 0
