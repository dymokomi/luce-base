import interop
import memory
import ownership
import thread
import tests.robustness.memory.counting

var disposed: i64 = 0

struct Recorder:
    var signal: interop.Signal[i64]
    var weak: interop.WeakReference[Recorder]?
    var first: interop.Reference[interop.Connection]?
    var second: interop.Reference[interop.Connection]?
    var added: interop.Reference[interop.Connection]?
    var events: i64[32]
    var count: usize

    mutating func record(value: i64):
        self.events[self.count] = value
        self.count += 1

    mutating func on_first(value: i64) -> interop.Outcome[unit]:
        self.record(10 + value)
        if value == 1:
            (self.second else trap("missing second connection")).value().disconnect()
            let owner = (self.weak else trap("missing owner")).get() else trap("expired owner")
            defer owner.release()
            let callback = interop.Callback[i64, unit].bind_mutating(owner, Recorder.on_added) catch failure: trap(failure.message)
            defer callback.release()
            self.added = self.signal.connect(callback) catch failure: trap(failure.message)
            let nested = self.signal.emit(2)
            defer nested.release()
            discard(nested.get() catch failure: trap(failure.message))
        elif value == 3:
            (self.first else trap("missing first connection")).value().disconnect()
        return interop.Outcome[unit].success(interop.Owned[unit](()))

    mutating func on_second(value: i64) -> interop.Outcome[unit]:
        self.record(20 + value)
        return interop.Outcome[unit].success(interop.Owned[unit](()))

    mutating func on_added(value: i64) -> interop.Outcome[unit]:
        self.record(30 + value)
        if value == 4:
            self.signal.close()
        return interop.Outcome[unit].success(interop.Owned[unit](()))

    mutating func fail(value: i64) -> interop.Outcome[unit]:
        self.record(value)
        let text = interop.copy_text("native callback failure") catch failure: trap(failure.message)
        return interop.Outcome[unit].failure(interop.invalid, text)

    mutating func close():
        disposed += 1
        self.signal.close()
        self.signal.release()
        if let connection = self.first:
            connection.release()
        if let connection = self.second:
            connection.release()
        if let connection = self.added:
            connection.release()
        if let weak = self.weak:
            weak.release()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        self.signal.trace(visit, context)
        if let connection = self.first:
            connection.trace(visit, context)
        if let connection = self.second:
            connection.trace(visit, context)
        if let connection = self.added:
            connection.trace(visit, context)

let recorder_type: interop.Type[Recorder] = interop.Type[Recorder](name = "Recorder",
    dispose = Recorder.close, trace = Recorder.trace, closeable = true)

func make() -> interop.Reference[Recorder]!:
    var reservation = try interop.Reservation[Recorder](recorder_type)
    errdefer reservation.cancel()
    let signal = try interop.Signal[i64]()
    errdefer signal.release()
    let owner = reservation.publish(try new Recorder(signal = signal) in memory.heap, memory.heap)
    owner.value().weak = interop.WeakReference[Recorder](owner)
    return owner

func connect(owner: interop.Reference[Recorder]) -> !:
    let first = try interop.Callback[i64, unit].bind_mutating(owner, Recorder.on_first)
    defer first.release()
    let second = try interop.Callback[i64, unit].bind_mutating(owner, Recorder.on_second)
    defer second.release()
    let recorder = owner.value()
    recorder.first = try recorder.signal.connect(first)
    recorder.second = try recorder.signal.connect(second)

func deliver(signal: interop.Signal[i64], value: i64) -> !:
    let result = signal.emit(value)
    defer result.release()
    discard(try result.get())

func delivery() -> !:
    let owner = try make()
    defer owner.release()
    defer owner.close()
    try connect(owner)
    let recorder = owner.value()
    try deliver(recorder.signal, 1)
    assert(recorder.count == 3 and recorder.events[0] == 11 and recorder.events[1] == 12 and recorder.events[2] == 32)
    assert(not (recorder.second else trap("missing second")).value().is_connected())
    try deliver(recorder.signal, 3)
    assert(recorder.count == 5 and recorder.events[3] == 13 and recorder.events[4] == 33)
    try deliver(recorder.signal, 4)
    assert(recorder.count == 6 and recorder.events[5] == 34 and recorder.signal.is_closed())
    let closed = recorder.signal.emit(5)
    assert(not closed.is_success())
    closed.release()

func failures() -> !:
    let owner = try make()
    defer owner.release()
    defer owner.close()
    let callback = try interop.Callback[i64, unit].bind_mutating(owner, Recorder.fail)
    defer callback.release()
    let connection = try owner.value().signal.connect(callback)
    defer connection.release()
    let failed = owner.value().signal.emit(99)
    failed.get() catch failure:
        assert(failure.code == interop.invalid and failure.message == "native callback failure")
    failed.release()
    assert(connection.value().is_connected())
    connection.value().disconnect()
    connection.value().disconnect()
    assert(not connection.value().is_connected())
    owner.close()
    let closed = callback.invoke(1)
    assert(not closed.is_success())
    closed.release()

func allocation_failure() -> !:
    var allocator = counting.Counting.unlimited()
    let signal = try interop.Signal[i64](&allocator)
    let owner = try make()
    let callback = try interop.Callback[i64, unit].bind_mutating(owner, Recorder.on_second)
    let baseline = allocator.bytes
    # The connection's native allocation succeeds, then its registration fails.
    allocator.limit = baseline + sizeof(interop.Connection)
    let rejected: interop.Reference[interop.Connection]? = signal.connect(callback) catch failure:
        assert(failure.code == memory.exhausted and allocator.bytes == baseline)
        recover none
    assert(rejected == none)
    allocator.limit = 0
    let connected = try signal.connect(callback)
    allocator.limit = allocator.bytes
    let failed = signal.emit(1)
    assert(not failed.is_success() and connected.value().is_connected())
    failed.release()
    allocator.limit = 0
    try deliver(signal, 1)
    connected.release()
    callback.release()
    owner.close()
    owner.release()
    signal.close()
    signal.release()
    ownership.collect()
    assert(allocator.live == 0 and allocator.bytes == 0)

func wrong_thread(context: void*?):
    let callback = (interop.Callback[i64, unit]*)(context else trap("missing callback"))
    let result = callback.invoke(1)
    result.release()

pub func main(arguments: str[]) -> i32!:
    if arguments.length > 1:
        let owner = try make()
        let callback = try interop.Callback[i64, unit].bind_mutating(owner, Recorder.on_second)
        let worker = try thread.spawn(wrong_thread, (void*)&callback)
        try worker.join()
        trap("wrong-thread callback was accepted")
    try delivery()
    try failures()
    try allocation_failure()
    let before = disposed
    let cycle = try make()
    try connect(cycle)
    cycle.release()
    ownership.collect()
    assert(disposed == before + 1)
    return ownership.finish_run(0)
