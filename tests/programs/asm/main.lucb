## Inline assembly in Base source (§16.7), one block per architecture. Each `asm
## arch(operands): lines` binds Base values to named registers, then the raw lines run with
## those registers in place. The native backend emits the lines as they are written; the C
## backend hands them to the C compiler's extended asm. Both agree, so the same source is
## portable across them; the x86_64 lines are in the AT&T syntax both consume.

## `a + b`, computed by the machine's add instruction rather than the language's.
func add(a: i64, b: i64) -> i64:
    var out: i64 = 0
    asm arm64(in("x0") a, in("x1") b, out("x0") out):
        add x0, x0, x1
    asm x86_64(in("rdi") a, in("rsi") b, out("rax") out):
        movq %rdi, %rax
        addq %rsi, %rax
    return out

## The bytes of a 64-bit word reversed, one `rev` instruction, the way a byte-order swap
## is written by hand.
func byteswap(value: u64) -> u64:
    var out: u64 = 0
    asm arm64(in("x1") value, out("x0") out):
        rev x0, x1
    asm x86_64(in("rdi") value, out("rax") out):
        movq %rdi, %rax
        bswapq %rax
    return out

## The number of set bits, using the NEON population-count on a single lane.
func popcount(value: u64) -> u64:
    var out: u64 = 0
    asm arm64(in("x1") value, out("x0") out):
        fmov d0, x1
        cnt v0.8b, v0.8b
        uaddlv h0, v0.8b
        fmov w0, s0
    asm x86_64(in("rdi") value, out("rax") out):
        popcntq %rdi, %rax
    return out

## The count of leading zero bits.
func leading_zeros(value: u64) -> u64:
    var out: u64 = 0
    asm arm64(in("x1") value, out("x0") out):
        clz x0, x1
    asm x86_64(in("rdi") value, out("rax") out):
        bsrq %rdi, %rax
        xorq $63, %rax
    return out

## A saturating unsigned add of two bytes, which the language spells `+|` but which is
## one instruction on the vector unit.
func saturating_add(a: u64, b: u64) -> u64:
    var out: u64 = 0
    asm arm64(in("x1") a, in("x2") b, out("x0") out):
        fmov d0, x1
        fmov d1, x2
        uqadd v0.8b, v0.8b, v1.8b
        fmov x0, d0
    asm x86_64(in("rdi") a, in("rsi") b, out("rax") out):
        movq %rdi, %xmm0
        movq %rsi, %xmm1
        paddusb %xmm1, %xmm0
        movq %xmm0, %rax
    return out

## Operands moved into each other's registers: `a` arrives where `b` goes and `b` where `a`
## goes, so every operand is read before any named register is written.
noinline func crossed(a: i64, b: i64) -> i64:
    var out: i64 = 0
    asm arm64(in("x1") a, in("x0") b, out("x0") out):
        sub x0, x0, x1
    asm x86_64(in("rsi") a, in("rdi") b, out("rax") out):
        movq %rdi, %rax
        subq %rsi, %rax
    return out

## The same with floats, and a value live across the block in a register it may name.
noinline func crossed_floats(a: f64, b: f64) -> f64:
    let kept = a * 3.0 + b
    var out: f64 = 0.0
    asm arm64(in("d1") a, in("d0") b, out("d0") out):
        fsub d0, d0, d1
    asm x86_64(in("xmm1") a, in("xmm0") b, out("xmm0") out):
        subsd %xmm1, %xmm0
    return out * 100.0 + kept

## Twelve values live across a block whose operands go to xmm0 and xmm1 (d0 and d1): the
## moves into those registers come before the block and must not overwrite any of them.
noinline func crowded(seed: f64) -> f64:
    let v0 = seed * 1.0 + 0.5
    let v1 = seed * 2.0 + 1.5
    let v2 = seed * 3.0 + 2.5
    let v3 = seed * 4.0 + 3.5
    let v4 = seed * 5.0 + 4.5
    let v5 = seed * 6.0 + 5.5
    let v6 = seed * 7.0 + 6.5
    let v7 = seed * 8.0 + 7.5
    let v8 = seed * 9.0 + 8.5
    let v9 = seed * 10.0 + 9.5
    let v10 = seed * 11.0 + 10.5
    let v11 = seed * 12.0 + 11.5
    let a = seed * 2.0
    let b = seed * 3.0
    var out: f64 = 0.0
    asm arm64(in("d1") a, in("d0") b, out("d0") out):
        fsub d0, d0, d1
    asm x86_64(in("xmm1") a, in("xmm0") b, out("xmm0") out):
        subsd %xmm1, %xmm0
    return out + v0 * 1.0 + v1 * 2.0 + v2 * 4.0 + v3 * 8.0 + v4 * 16.0 + v5 * 32.0 + v6 * 64.0 + v7 * 128.0 + v8 * 256.0 + v9 * 512.0 + v10 * 1024.0 + v11 * 2048.0

pub func main(arguments: str[]) -> i32:
    print(f"crowded(1.0) = {crowded(1.0)}")
    print(f"crossed(2, 7) = {crossed(2, 7)}")
    print(f"crossed_floats(1.5, 4.0) = {crossed_floats(1.5, 4.0)}")
    print(f"add(40, 2) = {add(40, 2)}")
    print(f"byteswap(1) = {byteswap(1)}")
    print(f"popcount(255) = {popcount(255)}")
    print(f"popcount(0xF0F0) = {popcount(61680)}")
    print(f"double_and_add(19, 2) = {double_and_add(19, 2)}")
    print(f"leading_zeros(1) = {leading_zeros(1)}")
    print(f"saturating_add(200, 100) = {saturating_add(200, 100) & 255}")
    return 0

## `reg` operands (§8.9): the compiler chooses the registers, and `{name}` in the text is
## the one it chose for the operand whose expression is that name.
func double_and_add(a: u64, b: u64) -> u64:
    var out: u64 = 0
    asm arm64(in(reg) a, in(reg) b, out(reg) out):
        add {out}, {a}, {a}
        add {out}, {out}, {b}
    asm x86_64(in(reg) a, in(reg) b, out(reg) out):
        leaq ({a}, {a}), {out}
        addq {b}, {out}
    return out

## A block that destroys a callee-saved register, named as a discarded output: the function
## saves and restores it, so the caller's value in it survives the call.
noinline func overwrite_saved(marker: usize):
    asm arm64(in("x9") marker, out("x19") _):
        mov x19, x9
    asm x86_64(in("rax") marker, out("rbx") _):
        movq %rax, %rbx

test "a callee-saved register an asm block destroys is preserved for the caller":
    var total: usize = 0
    for i in 0..<10:
        overwrite_saved(0xdead)
        total += (usize)i
    assert(total == 45)
