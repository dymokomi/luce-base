## Files and directories through `files` (§16.6): the directory entry is laid out
## differently on every operating system, and `files.list` reads the target's.
import c
import luce_std.files
import os
import luce_std.process
import strings
from io import path
from memory import FixedBuffer

pub func main(arguments: str[]) -> i32!:
    var backing: u8[65536]
    var arena = FixedBuffer.over(backing)
    with arena:
        var room: u8[1024]
        let base = try strings.format(room[..<256], f"{path.temp()}/luce-platform-{os.pid()}")
        let mkdir_args: c.str[1] = [(c.str)base]
        let made = try process.run("mkdir", mkdir_args)
        defer made.release()
        if made.value.exit_code != 0:
            error(files.failed, "the directory cannot be made")
        let first = try strings.format(room[256..<512], f"{base}/first.txt")
        let second = try strings.format(room[512..<768], f"{base}/second.txt")
        let third = try strings.format(room[768..], f"{base}/.hidden")
        try files.write((c.str)first, "one\n".bytes)
        try files.write((c.str)second, "two and more\n".bytes)
        try files.write((c.str)third, "".bytes)
        let names = try files.list((c.str)base)
        defer names.release()
        print(f"{names.value.length} entries")
        for name in names.value:
            print(name)
        let back = try files.read((c.str)second)
        defer back.release()
        print(f"{back.value.length} bytes: {strings.trim((str)back.value)}")
        print(f"exists {files.exists((c.str)first)} {files.exists("/definitely/not/here")}")
        let rm_args: c.str[2] = ["-r", (c.str)base]
        let removed = try process.run("rm", rm_args)
        defer removed.release()
        print(f"removed {removed.value.exit_code == 0} {files.exists((c.str)first)}")
    return 0
