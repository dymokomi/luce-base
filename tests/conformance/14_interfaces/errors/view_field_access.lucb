# error: 
## §14.3: a view has no fields, only the interface's methods.
interface Shape:
    func area() -> f64

struct Square: Shape:
    var side: f64

    func area() -> f64:
        return self.side * self.side

pub func main(arguments: str[]) -> i32:
    var q = Square(side = 1.0)
    let v: Shape = &q
    let s = v.side
    return 0
