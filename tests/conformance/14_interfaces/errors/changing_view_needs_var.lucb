# error: `scale` changes its receiver, so a view of it needs a mutable pointer
# oracle: none
## §14.3: a view of a conformer whose implementation changes its receiver needs a `var`.
interface Shape:
    func area() -> f64
    func scale(factor: f64)

struct Square: Shape:
    var side: f64

    func area() -> f64:
        return self.side * self.side

    func scale(factor: f64):
        self.side = self.side * factor

pub func main(arguments: str[]) -> i32:
    let q = Square(side = 1.0)
    let v: Shape = &q
    return 0
