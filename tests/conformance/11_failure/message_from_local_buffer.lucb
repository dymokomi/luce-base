## §11.3, §6.6: an error's message may be made in a local buffer, formatted or cast from
## bytes: `error` copies it before the frame that holds the buffer is gone.
import strings

let code = ErrorCode.package(1)

func fail(n: i64) -> !:
    var buffer: u8[64]
    let text = try strings.format(buffer, f"bad {n}")
    error(code, text)

func spell() -> i64!:
    var bytes: u8[4] = ['o', 'o', 'p', 's']
    error(code, (str)bytes)

## Another frame where the buffers were, written over.
func overwrite() -> u64:
    var junk: u8[64]
    var sum: u64 = 0
    for i in 0..<64:
        junk[i] = 'x'
        sum += u64(junk[i])
    return sum

pub func main(arguments: str[]) -> i32:
    fail(42) catch failure:
        _ = overwrite()
        print(failure.message)
    let n = spell() catch failure:
        _ = overwrite()
        print(failure.message)
        recover 0
    print(f"{n}")
    return 0
