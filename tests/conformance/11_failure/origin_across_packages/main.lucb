# oracle: none
## §11.3: an error raised in another package keeps where it was raised, through that
## package's `try`, this one's, and `error(failure)`. A source outside this package's root
## is named by its whole path, so only its file name is printed.
import origin_source.raise

func through(n: i64) -> i64!:
    return try raise.passed_on(n)

func passed(n: i64) -> i64!:
    let v = through(n) catch failure:
        error(failure)
    return v

## The text after the last `/` or `\` of `path`.
func file_name(path: str) -> str:
    var start: usize = 0
    for i in 0..<path.length:
        if path.bytes[i] == '/' or path.bytes[i] == '\\':
            start = i + 1
    return (str)path.bytes[start..]

pub func main(arguments: str[]) -> i32:
    _ = passed(-1) catch failure:
        print(f"{file_name(failure.at)}: {failure.message} {failure.code == raise.refused}")
        recover 0
    return 0
