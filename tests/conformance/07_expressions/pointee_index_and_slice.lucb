## §7.6, §7.7: through a pointer to an array or a span, `(*p)[i]` is an element, checked
## against the length, and `(*p)[start..<end]` a slice that views the same elements.
func mid(p: const i64[4]*) -> i64:
    let s = (*p)[1..<3]
    return s[0] * 10 + s[1] + (i64)s.length * 100

func tail(p: (const i64[])*) -> i64:
    let s = (*p)[1..]
    return s[0] + (i64)s.length * 100 + (*p)[0] * 1000

func bump(p: i64[4]*):
    let s = (*p)[2..]
    s[0] += 1
    (*p)[3] += 10

pub func main(arguments: str[]) -> i32:
    var a: i64[4] = [5, 6, 7, 8]
    var s: const i64[] = a
    bump(&a)
    print(f"{mid(&a)} {tail(&s)} {a[2]} {a[3]}")
    return 0
