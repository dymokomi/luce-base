## §7.7: an array a call returns is sliced where it stands, `f(x)[..<n]`, as a bound one is;
## the slice reads a temporary that lives as the function's own locals do, so it outlives
## the statement, and the call runs once.
struct Holder:
    var values: i64[4]

var calls: i64 = 0

func numbers(n: i64) -> i64[4]:
    calls += 1
    return [n, n + 1, n + 2, n + 3]

func holder(n: i64) -> Holder:
    calls += 1
    return Holder(numbers(n))

func total(values: const i64[]) -> i64:
    var sum: i64 = 0
    for v in values:
        sum += v
    return sum

pub func main(arguments: str[]) -> i32:
    let head = numbers(10)[..<2]
    let tail = numbers(20)[2..]
    print(f"{head.length} {head[0]} {head[1]} {tail.length} {tail[0]} {tail[1]}")
    print(f"{total(numbers(1)[1..<3])}")
    let inner = holder(5).values[1..]
    print(f"{inner.length} {inner[0]} {inner[2]}")
    print(f"{calls}")
    return 0
