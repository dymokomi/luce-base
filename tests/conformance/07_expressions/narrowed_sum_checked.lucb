## §7.2: a checked sum of a word narrowed from a 64-bit division keeps its overflow check:
## (0x7c000000000 // 1024) narrows to 0xf0000000, and adding 0x20000000 passes the u32 range.
noinline func grown(a: u64) -> u32:
    let w = (u32)(a // 1024)
    return w + 0x20000000

pub func main(arguments: str[]) -> i32:
    print(f"{grown(0x7c000000000 + (u64)arguments.length - 1)}")
    return 0
