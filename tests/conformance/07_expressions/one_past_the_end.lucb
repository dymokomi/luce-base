## §7.7: `&a[N]` on an array or span of length `N` is the one-past-the-end address, the
## bound of a C-style walk; every other index is checked.
pub func main(arguments: str[]) -> i32:
    var values: i32[4] = [1, 2, 3, 4]
    var sum: i32 = 0
    var p = &values[0]
    let end = &values[4]
    while p < end:
        sum += *p
        p = p + 1
    let view: i32[] = values[0..<4]
    let view_end = &view[4]
    print(f"{sum} {end - &values[0]} {view_end == end}")
    return 0
