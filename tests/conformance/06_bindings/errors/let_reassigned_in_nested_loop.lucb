# error: cannot assign to a `let`
## §6.2: a `let` stays immutable however deep the loop that tries to change it.
pub func main(arguments: str[]) -> i32:
    let total: i32 = 0
    var i: i32 = 0
    while i < 3:
        var j: i32 = 0
        while j < 3:
            if i == j:
                total += 1
            j += 1
        i += 1
    return total
