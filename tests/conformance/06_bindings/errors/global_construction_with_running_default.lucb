# error: a global's initialiser is a constant expression (§6.3)
# oracle: none (the seed does not look at the defaults a construction leaves out)
## §6.4: a construction is constant only when the defaults it leaves out are; this field's
## default calls a function, which runs.
func start() -> i64:
    return 5

struct Counter:
    var n: i64 = start()

var counter: Counter = Counter()

pub func main(arguments: str[]) -> i32:
    return (i32)counter.n
