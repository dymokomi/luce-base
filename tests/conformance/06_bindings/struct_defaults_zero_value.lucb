# oracle: none
## §6.1, §10.1: a struct with no `init` whose every field has a default or a zero value has a
## zero value, `S()`: `var s: S` holds it, its defaults filled and every other field zero,
## and a field of that type may be left out of a construction.
struct Style:
    var width: i32 = 2
    var name: str = "plain"
    var count: u32

struct Box:
    var style: Style
    var size: i32 = 7

pub func main(arguments: str[]) -> i32:
    var style: Style
    print(f"{style.width} {style.name} {style.count}")
    var box: Box
    print(f"{box.size} {box.style.width} {box.style.name}")
    let built = Box(size = 1)
    print(f"{built.size} {built.style.name}")
    style.count += 1
    print(f"{style.count}")
    return 0
