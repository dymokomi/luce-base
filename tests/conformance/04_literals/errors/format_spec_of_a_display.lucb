# error: a format specification lays out a number, a `str`, a `char`, or a `bool`
## §5.5: a value that shows itself through `Display` takes no specification.
import io

struct Celsius:
    var degrees: f64

    pub func display(sink: io.Writer) -> !:
        _ = try sink.write("C".bytes)

pub func main(arguments: str[]) -> i32:
    print(f"{Celsius(degrees = 1.0):>8}")
    return 0
