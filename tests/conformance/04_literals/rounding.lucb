## §4.3: conversion from decimal is correctly rounded, at every width, from the digits
## themselves: an `f32` or `f16` literal is rounded once, never through a double. The bits
## are the IEEE encodings; the values include halfway points, the largest finite values,
## and the smallest subnormals.
pub func main(arguments: str[]) -> i32:
    let a: f64 = 1e-10
    let b: f64 = 1e-20
    let c: f64 = 1e-100
    let d: f64 = 2.2250738585072014e-308
    let e: f64 = 1.7976931348623157e308
    let f: f64 = 5e-324
    let g: f64 = 2.4703282292062328e-324
    let h: f64 = 9007199254740993.0
    let i: f64 = 9007199254740993.0000000000000000000001
    print(f"{a.bits()} {b.bits()} {c.bits()} {d.bits()} {e.bits()}")
    print(f"{f.bits()} {g.bits()} {h.bits()} {i.bits()}")
    let j: f32 = 16777217.0
    let k: f32 = 16777217.00000000000000000000001
    let l: f32 = 3.4028235677973366e38
    let m: f32 = 1.4e-45
    let n: f32 = 7.006492321624085e-46
    let o: f32 = 7.0064923216240854e-46
    let p: f32 = 1.1754943508222875e-38
    let q: f32 = 0.1f32
    print(f"{j.bits()} {k.bits()} {l.bits()} {m.bits()} {n.bits()} {o.bits()} {p.bits()} {q.bits()}")
    let r: f16 = 2049.0
    let s: f16 = 2049.0000000000000000001
    let t: f16 = 2051.0
    let u: f16 = 65519.0
    let v: f16 = 65519.00000000000000001
    let w: f16 = 0.0000000298023223876953125
    let x: f16 = 0.00000002980232238769531250000001
    let y: f16 = 0.000000059604644775390625
    let z: f16 = 6.097555160522461e-05
    print(f"{r.bits()} {s.bits()} {t.bits()} {u.bits()} {v.bits()} {w.bits()} {x.bits()} {y.bits()} {z.bits()}")
    return 0
