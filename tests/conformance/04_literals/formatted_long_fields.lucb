## §4 formatted strings: a field longer than any format buffer the compiler keeps is still
## written whole by `print`, with the text around it, and `format` into a buffer too small
## for it reports the overflow instead of answering a shorter text.
func letters(room: u8[], count: usize) -> str:
    for i in 0..<count:
        room[i] = 97 + (u8)(i % 26)
    return (str)room[..<count]

pub func main(arguments: str[]) -> i32:
    var room: u8[3000] = ---
    let text = letters(room, 2600)
    print(f"[{text.length}] {text} [{true} {1.5} {text.length}]")
    var small: u8[16] = ---
    let fitted = format(small, f"{text}") catch:
        print("format: the text does not fit")
        return 0
    print(f"format answered {fitted.length} bytes")
    return 0
