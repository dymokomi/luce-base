## §8.3, §8.5: `break` inside a `match` leaves the loop around the match, as it does anywhere
## else in the loop's body, whatever the match compiles to: a C `switch` once took it for
## its own, and the loop ran forever (luce-js's resolve_labels_code).
enum Step:
    again
    done
    skip

enum Shape:
    dot
    circle(r: i64)
    rect(w: i64, h: i64)

pub func main(arguments: str[]) -> i32:
    var step = Step.again
    var turns: i64 = 0
    while true:
        turns += 1
        if turns > 10:
            return 1
        match step:
            .again:
                step = Step.skip
            .skip:
                step = Step.done
                continue
            .done:
                break
    var seen: i64 = 0
    for n in 0..<100:
        match n % 4:
            0:
                seen += 1
            3:
                if n > 10:
                    break
            _:
                continue
    var area: i64 = 0
    let shapes: Shape[4] = [Shape.circle(r = 2), Shape.rect(w = 2, h = 3), Shape.dot, Shape.rect(w = 9, h = 9)]
    for s in shapes:
        match s:
            .circle(r):
                area += r * r * 3
            .rect(w, h):
                area += w * h
            .dot:
                break
    var outer_count: i64 = 0
    outer: for i in 0..<5:
        for j in 0..<5:
            match j:
                2:
                    break
                3:
                    break outer
                _:
                    outer_count += 1
    print(f"{turns} {seen} {area} {outer_count}")
    return 0
