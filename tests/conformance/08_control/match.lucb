## §8.4, §7.8: `match` over payload enums, optionals, integers, characters, text, ranges,
## alternatives, guards, and `_`; the statement and expression forms.
enum Command:
    open(path: str)
    save(path: str)
    resize(width: u32, height: u32)
    quit

enum Access as u32:
    empty = 0
    read = 1
    write = 2

func describe(c: Command) -> str:
    match c:
        .open(path):
            return "open"
        .save(path) if path.length == 0:
            return "save nowhere"
        .save(path):
            return "save"
        .resize(width, _):
            return "resize" if width > 0 else "shrink"
        .quit:
            return "quit"

func grade(score: i64) -> str:
    return match score:
        90..=100 => "A"
        80..<90 => "B"
        0, 1, 2 => "zero-ish"
        _ => "other"

func kind(c: char) -> str:
    return match c:
        '0'..='9' => "digit"
        'a'..='z', 'A'..='Z' => "letter"
        _ => "other"

func flag(a: Access) -> str:
    return match a:
        .read => "r"
        .write => "w"
        _ => "?"

func present(v: i64?) -> i64:
    match v:
        .some(value):
            return value * 2
        .none:
            return -1

func word(s: str) -> i64:
    return match s:
        "one" => 1
        "two", "deux" => 2
        _ => 0

pub func main(arguments: str[]) -> i32:
    let commands: Command[5] = [Command.open(path = "a"), Command.save(path = ""), Command.save(path = "b"), Command.resize(width = 0, height = 3), Command.quit]
    var out = ""
    for c in commands:
        out = describe(c)
        print(out)
    let some: i64? = 21
    let none_at_all: i64? = none
    print(f"{grade(95)} {grade(85)} {grade(1)} {grade(50)} {kind('7')} {kind('x')} {kind('-')} {flag(.read)} {flag(.write)} {flag(.read | .write)}")
    print(f"{present(some)} {present(none_at_all)} {word("one")} {word("deux")} {word("three")}")
    return 0
