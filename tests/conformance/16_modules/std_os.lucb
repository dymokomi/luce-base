## §16.6: the `os` module names the target as constants and answers what the process can
## ask of the system.
# oracle: none
import os

pub func main(arguments: str[]) -> i32!:
    try os.set_env("LUCE_CONFORMANCE", "yes")
    let value = os.env("LUCE_CONFORMANCE") else return 1
    let missing = os.env("LUCE_CONFORMANCE_UNSET_NAME") == none
    let cwd = try os.cwd()
    let host = try os.hostname()
    # one architecture and one operating system, whichever the host is (tests/platform names them)
    let one_arch = os.arm64 != os.x86_64
    let one_os = ((u32)os.macos + (u32)os.linux + (u32)os.windows == 1) and (os.posix != os.windows)
    print(f"{one_arch} {one_os} {os.pointer_bits} {os.cpus() >= 1} {os.page_size() >= 4096} {value} {missing} {cwd.length > 0} {host.length > 0} {os.pid() > 0} {os.name.length > 0}")
    return 0
