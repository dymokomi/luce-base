## Painting: more methods of `Canvas`, and of `Tool`, each calling across fragments. A
## fragment opens with imports of its own (§16.1).
import strings

extend Canvas:
    pub mutating func paint(tool: Tool) -> !:
        if tool.erases() and self.strokes == 0:
            error(nothing_to_erase, "nothing to erase")
        self.strokes += 1 if not tool.erases() else -1
        self.select_all()

extend Tool:
    pub func erases() -> bool:
        return self == Tool.eraser

    ## Whether `name` spells an erasing tool exactly when this one erases.
    pub func is_named(name: str) -> bool:
        return strings.starts_with(name, "eraser") == self.erases()

pub let nothing_to_erase: ErrorCode = ErrorCode.package(1)
