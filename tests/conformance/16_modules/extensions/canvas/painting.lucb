## Painting: more methods of `Canvas`, and one of `Tool`, each calling across fragments.
extend Canvas:
    pub mutating func paint(tool: Tool) -> !:
        if tool.erases() and self.strokes == 0:
            error(nothing_to_erase, "nothing to erase")
        self.strokes += 1 if not tool.erases() else -1
        self.select_all()

extend Tool:
    pub func erases() -> bool:
        return self == Tool.eraser

pub let nothing_to_erase: ErrorCode = ErrorCode.package(1)
