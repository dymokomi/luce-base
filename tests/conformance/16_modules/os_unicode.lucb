# oracle: none
# Native OS ownership and Unicode APIs are supplied by Base, not Seed.
import c
import os
import luce_std.files
import strings
import luce_std.paths

pub func main(arguments: str[]) -> i32!:
    try os.set_env("LUCE_UNICODE_名字", "café/日本語/😀")
    defer os.unset_env("LUCE_UNICODE_名字") catch: _ = 0
    assert((os.env("LUCE_UNICODE_名字") else "") == "café/日本語/😀")
    try os.set_env("LUCE_EMPTY_TEST", "")
    assert(os.env("LUCE_EMPTY_TEST") != none)
    assert((os.env("LUCE_EMPTY_TEST") else "missing") == "")
    try os.unset_env("LUCE_EMPTY_TEST")
    assert(os.env("LUCE_EMPTY_TEST") == none)
    let original = try os.cwd()
    defer strings.release(original)
    var scratch: u8[256]
    let folder = try strings.format(scratch, f"luce-path-名字-😀-{os.pid()}")
    let full = try paths.join(original, folder)
    defer full.release()
    try files.create_directory((c.str)full.value)
    defer files.remove_directory((c.str)full.value) catch: _ = 0
    try os.change_dir((c.str)full.value)
    defer os.change_dir((c.str)original) catch: _ = 0
    let current = try os.cwd()
    defer strings.release(current)
    assert(paths.base(current) == folder)
    try files.write("café-😀.txt", "hello\nworld\r\n".bytes)
    defer files.remove_file("renamed-日本語.txt") catch: _ = 0
    try files.rename("café-😀.txt", "renamed-日本語.txt")
    let content = try files.read("renamed-日本語.txt")
    defer content.release()
    assert((str)content.value == "hello\nworld\r\n")
    let entries = try files.list(".")
    defer entries.release()
    assert(entries.value.length == 1 and entries.value[0] == "renamed-日本語.txt")
    assert(os.parent_pid() > 0)
    print("unicode OS paths ok")
    return 0
