## `math.mod_floor` with divisor -1 is zero for every dividend, including the minimum,
## whose quotient by -1 has no representation.
import math

pub func main(arguments: str[]) -> i32:
    let lowest: i64 = -9223372036854775807 - (i64)arguments.length
    print(f"{math.mod_floor(lowest, -1)} {math.mod_floor(-7, 2)} {math.div_floor(-7, 2)}")
    return 0
