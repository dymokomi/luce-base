# oracle: none -- The seed interpreter has no math32 module.
import math32

pub func main(arguments: str[]) -> i32:
    let negative_zero = f32.bits(0x80000000)
    let payload_nan = f32.bits(0xffc00042)
    assert(math32.abs(negative_zero).bits() == 0)
    assert(math32.abs(payload_nan).bits() == 0x7fc00042)
    assert(math32.signbit(payload_nan))
    assert(math32.is_nan(f32.bits(0x7f800001)))
    assert(not math32.is_finite(math32.infinity))
    assert(math32.is_finite(f32.bits(1)))
    assert(math32.is_infinite(math32.infinity))
    assert(math32.min(negative_zero, 0.0).bits() == negative_zero.bits())
    assert(math32.min(0.0, negative_zero).bits() == negative_zero.bits())
    assert(math32.max(negative_zero, 0.0).bits() == 0)
    assert(math32.max(0.0, negative_zero).bits() == 0)
    assert(math32.min(1.0, payload_nan).bits() == payload_nan.bits())
    assert(math32.max(payload_nan, 1.0).bits() == payload_nan.bits())
    assert(math32.sign(negative_zero).bits() == negative_zero.bits())
    assert(math32.copysign(1.0, negative_zero) == -1.0)
    assert(math32.sqrt(16.0) == 4.0)
    assert(math32.round(-2.5) == -3.0)
    assert(math32.floor(-2.5) == -3.0)
    assert(math32.ceil(-2.5) == -2.0)
    assert(math32.trunc(-2.5) == -2.0)
    assert(math32.log2(8.0) == 3.0)
    assert(math32.exp2(3.0) == 8.0)
    assert(math32.hypot(3.0, 4.0) == 5.0)
    let tiny = math32.scalbn(1.0, -26)
    assert(math32.log1p(tiny).bits() == tiny.bits())
    assert(math32.expm1(tiny).bits() == tiny.bits())
    let increment = math32.scalbn(1.0, -13)
    assert(math32.fma(1.0 + increment, 1.0 - increment, -1.0) == -tiny)
    assert(math32.next_up(1.0).bits() == 0x3f800001)
    assert(math32.next_down(1.0).bits() == 0x3f7fffff)
    assert(math32.next_up(negative_zero).bits() == 1)
    assert(math32.next_down(0.0).bits() == 0x80000001)
    let (fraction, exponent) = math32.frexp(f32.bits(1))
    assert(fraction == 0.5 and exponent == -148)
    assert(math32.scalbn(fraction, exponent).bits() == 1)
    let (decimal, integral) = math32.modf(-3.25)
    assert(decimal == -0.25 and integral == -3.0)
    assert(math32.remainder(7.0, 2.0) == -1.0)
    assert(math32.mod(7.0, 2.0) == 1.0)
    assert(math32.clamp(-3.0, -1.0, 1.0) == -1.0)
    print("ok math single precision")
    return 0
