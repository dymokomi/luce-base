# oracle: none -- Base's explicit NaN and signed-zero contracts extend the seed's math.
import math

pub func main(arguments: str[]) -> i32:
    let positive_zero = f64.bits(0)
    let negative_zero = f64.bits(9223372036854775808)
    let negative_nan = f64.bits(18444492273895866434)
    let signaling_nan = f64.bits(9218868437227405313)
    let smallest = f64.bits(1)
    assert(math.abs(negative_zero).bits() == 0)
    assert(math.abs(negative_nan).bits() == 9221120237041090626)
    assert(math.copysign(negative_nan, positive_zero).bits() == 9221120237041090626)
    assert(math.copysign(smallest, negative_zero).bits() == 9223372036854775809)
    assert(math.signbit(negative_zero))
    assert(not math.signbit(positive_zero))
    assert(math.signbit(negative_nan))
    assert(math.is_nan(signaling_nan))
    assert(math.is_nan(negative_nan))
    assert(not math.is_finite(signaling_nan))
    assert(math.is_finite(negative_zero))
    assert(math.is_finite(smallest))
    assert(math.is_infinite(math.infinity))
    assert(math.is_infinite(math.copysign(math.infinity, negative_zero)))
    assert(not math.is_infinite(negative_nan))
    assert(math.sign(negative_zero).bits() == negative_zero.bits())
    assert(math.sign(negative_nan).bits() == negative_nan.bits())
    assert(math.min(positive_zero, negative_zero).bits() == negative_zero.bits())
    assert(math.min(negative_zero, positive_zero).bits() == negative_zero.bits())
    assert(math.max(positive_zero, negative_zero).bits() == 0)
    assert(math.max(negative_zero, positive_zero).bits() == 0)
    assert(math.min(negative_nan, 3.0).bits() == negative_nan.bits())
    assert(math.min(3.0, negative_nan).bits() == negative_nan.bits())
    assert(math.max(negative_nan, 3.0).bits() == negative_nan.bits())
    assert(math.max(3.0, negative_nan).bits() == negative_nan.bits())
    assert(math.min(signaling_nan, negative_nan).bits() == signaling_nan.bits())
    assert(math.clamp(negative_nan, -1.0, 1.0).bits() == negative_nan.bits())
    assert(math.clamp(negative_zero, positive_zero, 1.0).bits() == negative_zero.bits())
    assert(math.clamp(math.infinity, -1.0, 1.0) == 1.0)
    assert(math.iclamp(3, 2, 2) == 2)
    print("ok math special values")
    return 0
