## §16.6: the `math` module, qualified through `import math` or bare through
## `from math import`; the integer floor division `div_floor` and `mod_floor` beside the
## truncating `//` and `%` of §7.2.
import math
from math import sqrt, floor

pub func main(arguments: str[]) -> i32:
    let root = sqrt(16.0)
    let below = floor(-2.5)
    let above = math.ceil(-2.5)
    let nearest = math.round(2.5)
    let cut = math.trunc(-2.7)
    let side = math.hypot(3.0, 4.0)
    let power = math.pow(2.0, 10.0)
    let angle = math.atan2(1.0, 1.0) * 4.0
    let same_pi = math.abs(angle - math.pi) < 1.0e-12
    let clamped = math.clamp(7.5, 0.0, 1.0)
    print(f"{root} {below} {above} {nearest} {cut} {side} {power} {same_pi} {clamped}")
    print(f"{-7 // 2} {-7 % 2} {math.div_floor(-7, 2)} {math.mod_floor(-7, 2)} {math.iabs(-3)} {math.iclamp(12, 0, 10)}")
    print(f"{math.is_nan(math.nan)} {math.is_infinite(math.infinity)} {math.is_finite(1.0)} {math.sign(-4.0)} {math.log2(8.0)} {math.exp2(3.0)}")
    return 0
