# oracle: none -- The utf8 module is supplied by Base.
import utf8

pub func main(arguments: str[]) -> i32!:
    var bytes: u8[32]
    let letter: char = 'é'
    let ideograph: char = '水'
    let symbol: char = '😀'
    let text = try format(bytes, f"A {letter} {ideograph} {symbol}")
    assert(text == "A é 水 😀")
    var encoded: u8[4]
    assert(utf8.encode((u32)symbol, encoded) == 4)
    assert((str)encoded == "😀")
    # Both the formatting sink and direct character printing use C runtime
    # encoding helpers. Their symbols must not collide with utf8.encode.
    print(f"A {letter} {ideograph} {symbol}")
    return 0
