# error: `bump` changes its receiver, so it needs a `var` here
# oracle: none
## §9.5: a method that changes its receiver cannot run on a `let` reached through a field
## chain.
struct Counter:
    var n: i32

    pub func bump():
        self.n += 1

struct Holder:
    var inner: Counter

pub func main(arguments: str[]) -> i32:
    let h = Holder(inner = Counter(n = 0))
    h.inner.bump()
    return h.inner.n
