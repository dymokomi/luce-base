# error: `origin` is `static`, a function of the type: call it as `Point.origin()`
# oracle: none
## §9.5: a `static` function belongs to the type and is called through it.
struct Point:
    var x: f64

    static func origin() -> Point:
        return Point(x = 0.0)

pub func main(arguments: str[]) -> i32:
    let p = Point(x = 1.0)
    let q = p.origin()
    return 0
