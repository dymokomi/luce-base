# error: `poke` changes its receiver, so it needs a `var` or a mutable pointer here
# oracle: none
## §9.5: a method passing a part of its receiver where a mutable pointer is wanted changes
## its receiver, found when its body is checked, after a use above it: here through a
## function value, which the walk before checking cannot name.
func reader() -> i64:
    let c = Counter(n = 0)
    c.poke(touch)
    return c.n

func touch(p: i64*):
    *p += 1

struct Counter:
    var n: i64

    func poke(apply: func(i64*) -> unit):
        apply(&self.n)

pub func main(arguments: str[]) -> i32:
    return 0
