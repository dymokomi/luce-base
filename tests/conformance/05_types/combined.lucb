## §5: the types together: a struct of arrays of tuples, spans over them, pointers to
## elements, a nullable pointer walk, a function value, and `sizeof` of each, so layout
## and access agree across executions.
struct Cell:
    var pair: (i32, u8)
    var next: Cell*?

struct Grid:
    var cells: Cell[3]
    var scale: f64

func total(view: const Cell[]) -> i64:
    var sum: i64 = 0
    for c in view:
        let (a, b) = c.pair
        sum += a * (i64)b
    return sum

func twice(n: i32) -> i32:
    return n * 2

pub func main(arguments: str[]) -> i32:
    var g = Grid(cells = [Cell(pair = (1, 2), next = none), Cell(pair = (3, 4), next = none), Cell(pair = (5, 6), next = none)], scale = 0.5)
    g.cells[0].next = &g.cells[1]
    g.cells[1].next = &g.cells[2]
    var walked: i32 = 0
    var cursor: Cell*? = &g.cells[0]
    while let c = cursor:
        let (a, _) = c.pair
        walked += a
        cursor = c.next
    let f: func(i32) -> i32 = twice
    let view = g.cells[1..<3]
    g.cells[2].pair = (5, 9)
    let (_, last) = g.cells[2].pair
    print(f"{total(g.cells[0..<3])} {total(view)} {walked} {f(21)} {sizeof(Cell)} {sizeof(Grid)} {sizeof((i32, u8))} {last}")
    return 0
