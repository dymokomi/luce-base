## The module's documentation: a `##` block at the top, then a blank line (§3.3).

## §3.2: a suite after `:` is one simple statement on the line or an indented block;
## newlines are spacing inside delimiters; trailing commas are accepted in multi-line lists.
func classify(n: i64) -> str:
    if n < 0: return "negative"
    if n == 0:
        return "zero"
    return "positive"

func sum3(a: i64,
          b: i64,
          c: i64,
) -> i64:
    return a + b + c

# An ordinary comment. Blank lines do not affect meaning.


pub func main(arguments: str[]) -> i32:
    let values: i64[3] = [
        1,
        2,
        3,
    ]
    let (first, last) = (values[0],
                         values[2],)
    print(f"{classify(-4)} {classify(0)} {classify(9)}")
    let total = sum3(values[0], values[1],
                     values[2])
    print(f"{total} {first} {last}")
    var cached = true
    var count = 0
    while cached: cached = false
    for i in 0..<3: count += 1
    print(f"{cached} {count}")
    return 0
