## §15.1: the arguments of an `@T` method may be named as the specification spells them,
## `cas(expected, desired, success, failure, weak)` and `order` on the others; an ordering
## left out before a named one is `seq_cst`. `atomic.fence(.signal)` orders the compiler
## alone and emits no instruction.
import atomic

pub func main(arguments: str[]) -> i32:
    discard(arguments)
    var hits: @u64
    let (exchanged, seen) = hits.cas(0, 2, weak = false)
    let (again, before) = hits.cas(2, 3, success = .acq_rel, failure = .acquire)
    discard(hits.add(5, order = .relaxed))
    atomic.fence(.signal)
    hits.store(10, order = .release)
    print(f"{exchanged} {seen} {again} {before} {hits.load(order = .acquire)}")
    return 0
