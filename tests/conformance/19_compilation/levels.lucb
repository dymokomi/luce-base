## §19.5: a program compiled for an instruction-set level uses what the level has: on
## x86-64-v2 a wrapping multiply of doubleword lanes is one instruction, on v1 four.
pub func main(arguments: str[]) -> i32:
    let a: u32[4] = [1, 2, 3, 4]
    let b: u32[4] = [5, 6, 7, 8]
    let p = a *% b
    print(f"{p[0]} {p[3]} {p.sum()}")
    return 0
