## §19.5, §19.6: `--target NAME` decides `os` constants at compile time, so exactly one arm
## of a target test survives in the output for each target; the native backend emits the
## host only, and an unknown name is refused.
# oracle: none
import os

pub func main(arguments: str[]) -> i32:
    if os.linux and os.x86_64:
        print("ARM_LINUX_X86")
    elif os.macos and os.arm64:
        print("ARM_MACOS_ARM64")
    elif os.linux:
        print("ARM_LINUX_ARM64")
    elif os.windows:
        print("ARM_WINDOWS")
    print(f"{os.posix}")
    return 0
