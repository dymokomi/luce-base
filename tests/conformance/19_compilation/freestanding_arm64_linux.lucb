## §19.4 on arm64 Linux: the freestanding program of `freestanding.lucb` with the ELF
## sections and relocations and the Linux system calls, since an `asm` block is chosen by
## architecture and that file's arm64 block speaks to the macOS kernel.
asm arm64:
    .section .rodata
    lb_conformance_freestanding_line:
    .ascii "no shim\n"
    .text

export naked func _start():
    asm arm64:
        mov x0, #1
        adrp x1, lb_conformance_freestanding_line
        add x1, x1, :lo12:lb_conformance_freestanding_line
        mov x2, #8
        mov x8, #64
        svc #0
        mov x0, #3
        mov x8, #93
        svc #0
