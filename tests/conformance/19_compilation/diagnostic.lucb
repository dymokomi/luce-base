## §19.4: the diagnostic profile fills `---` storage, quarantines released blocks in the
## standard allocators, and records allocation sites; the default profile does none of that,
## and neither changes overflow, bounds, evaluation order, or error behaviour.
import memory

pub func main(arguments: str[]) -> i32!:
    var word: u64 = ---
    print(f"{word:x}")
    let block = try new u8[16] ---
    let data = block.data
    free(block)
    print(f"{data[0]:x} {data[15]:x}")
    let sites = memory.allocation_sites()
    print(f"{sites.length} {sites[0].size} {sites[0].line}")
    return 0
