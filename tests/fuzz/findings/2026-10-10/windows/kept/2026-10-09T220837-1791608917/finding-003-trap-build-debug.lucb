pub func main(arguments: str[]) -> i32!:
    var s: i64 = 1
    var k: i64 = 0
    while k < 5:
        s = s *% 6364136223846793005 +% 1442695040888963407
        k += 1
    var table: i64[8] = [0, 1, 2, 3, 4, 5, 6, 7]
    var acc: i64 = s
    acc = acc % (s & 3)
    s = s *% 1103515245 +% 12345
    acc = acc + (i64)(u8)s
    s = s *% 1103515245 +% 12345
    acc = acc + table[(usize)(s & 15)]
    s = s *% 1103515245 +% 12345
    acc = acc // (s & 3)
    s = s *% 1103515245 +% 12345
    acc = acc + (i64)(u8)s
    s = s *% 1103515245 +% 12345
    acc = acc + s
    s = s *% 1103515245 +% 12345
    print(f"{acc}")
    return 0
