## What the checker warns about and removes (§19.6): the program's answer is unchanged.
import memory
import io
import os
from io import Writer
var hits: i64 = 0

func bump() -> i64:
    hits += 1
    return 1

## A branch on a target constant is meant for some targets: neither it nor the code it
## makes unreachable on this one draws a warning, on any target.
pub func per_target(a: i64, b: i64) -> i64:
    if os.x86_64:
        return a
    return b

func never_called() -> i64:
    return 7

pub func main(arguments: str[]) -> i32:
    let unused = 5
    let effect = bump()
    let out: Writer = io.stdout()
    discard(out)
    var total: i64 = 40
    if true:
        total += 1
    else:
        total += 100
    if false:
        total += 100
    while false:
        total += 100
    total += hits
    print(f"{total}")
    return 0
    total += 1000
