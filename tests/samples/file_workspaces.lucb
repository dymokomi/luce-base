import c
import luce_std.files
import luce_std.paths
import strings

pub func main(arguments: str[]) -> i32!:
    var root = try files.TemporaryDirectory()
    defer root.destroy()
    let parent = try paths.join(root.path(), "日本語 😀")
    defer parent.release()
    try files.create_directory((c.str)parent.value)
    var work = try files.TemporaryDirectory((c.str)parent.value)
    defer work.destroy()
    let saved = try strings.copy(work.path())
    defer strings.release(saved)
    let file = try paths.join(work.path(), "data.txt")
    defer file.release()
    try files.write((c.str)file.value, "owned contents".bytes)
    let equivalent = try paths.join(work.path(), "./data.txt")
    defer equivalent.release()
    let identity = try files.canonical((c.str)file.value)
    defer identity.release()
    let same = try files.canonical((c.str)equivalent.value)
    defer same.release()
    assert(identity.value == same.value)
    try work.close()
    try work.close()
    work.destroy()
    assert(not files.exists((c.str)saved))
    files.canonical((c.str)saved) catch failure:
        assert(failure.code == files.missing)
        print("ok temporary directory ownership, Unicode paths and canonical identity")
        return 0
    trap("canonical resolution accepted a missing path")
