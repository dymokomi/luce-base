## The `json` module against its archive: object and array building, insertion order
## across the scalar types, string escaping, nested containers, and the transactional
## error paths. Building a value needs a current allocator, so each test sets one.
import json
import memory
import math

test "an empty object and an empty array encode as themselves":
    with memory.heap:
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        assert(obj.encode() == "{}")
        let arr = try json.Value.array()
        defer arr.release()
        assert((try arr.get()).encode() == "[]")

test "an object keeps its members in insertion order across the scalar types":
    with memory.heap:
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        try obj.set_integer("count", 42)
        try obj.set_boolean("ready", true)
        try obj.set_number("ratio", 1.5)
        assert(obj.encode() == "{\"count\":42,\"ready\":true,\"ratio\":1.5}")

test "text members escape quotes, backslashes and control bytes":
    with memory.heap:
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        let tab: u8[1] = [0x09]
        try obj.set_text("q", "\"")
        try obj.set_text("t", (str)tab[0..])
        assert(obj.encode() == "{\"q\":\"\\\"\",\"t\":\"\\u0009\"}")

test "an array of scalars nests inside an object, snapshotting the child":
    with memory.heap:
        let arr = try json.Value.array()
        defer arr.release()
        try arr.get().append(try json.Value.integer(1))
        try arr.get().append(try json.Value.integer(2))
        assert((try arr.get()).encode() == "[1,2]")
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        try obj.set("items", arr)
        try obj.set_text("name", "hi")
        # a later change to the array does not reach the snapshot the object holds
        try arr.get().append(try json.Value.integer(3))
        assert(obj.encode() == "{\"items\":[1,2],\"name\":\"hi\"}")

test "a duplicate key is refused and leaves the object unchanged":
    with memory.heap:
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        try obj.set_integer("x", 1)
        var raised = false
        obj.set_integer("x", 2) catch failure:
            raised = true
            assert(failure.code == json.invalid)
        assert(raised and obj.encode() == "{\"x\":1}")

test "non-finite numbers, container mismatches and the byte limit are refused":
    with memory.heap:
        let obj = try new json.Value()
        defer free(obj)
        defer obj.close()
        var bad_number = false
        obj.set_number("inf", math.infinity) catch failure:
            bad_number = true
            assert(failure.code == json.invalid)
        assert(bad_number)
        # an object refuses the array operation, an array refuses the object operation
        let child = try json.Value.integer(7)
        defer child.release()
        var wrong_append = false
        obj.append(child) catch failure:
            wrong_append = true
            assert(failure.code == json.invalid)
        assert(wrong_append)
        let arr = try json.Value.array()
        defer arr.release()
        let arr_native = try arr.get()
        var wrong_set = false
        arr_native.set("k", child) catch failure:
            wrong_set = true
            assert(failure.code == json.invalid)
        assert(wrong_set)
        # a two-byte value holds "{}" and refuses any member past its limit
        let tiny = try new json.Value(2)
        defer free(tiny)
        defer tiny.close()
        var over_limit = false
        tiny.set_integer("a", 1) catch failure:
            over_limit = true
            assert(failure.code == json.limit_exceeded)
        assert(over_limit and tiny.encode() == "{}")
