import allocator
import c
import files
import memory
import strings

extern func fcntl(descriptor: i32, command: i32, ...) -> i32
extern func fault_arm(kind: i32)
extern func fault_hits() -> i32
let callback_failure = ErrorCode.package(60001)

func descriptors() -> usize:
    var count: usize = 0
    var fd: i32 = 0
    while fd < 256:
        if fcntl(fd, 1) >= 0:
            count += 1
        fd += 1
    return count

struct Visitor: files.WalkVisitor:
    var visits: usize
    var fail_after: usize
    var prune_root: bool

    pub mutating func visit(path: str, info: files.Metadata, depth: usize) -> bool!:
        # Deliberately change the ambient allocator. Traversal must still grow
        # and free its storage through the allocator it captured on entry.
        memory.allocator = memory.heap
        self.visits += 1
        if self.fail_after != 0 and self.visits == self.fail_after:
            error(callback_failure, "injected visitor failure")
        return not (self.prune_root and depth == 0) and not strings.ends_with(path, "/skip")

func attempt(root: c.str, fail_at: usize) -> usize:
    let before = descriptors()
    var owner = allocator.Failing.at(fail_at)
    var visitor = Visitor()
    var rejected = false
    with owner:
        files.walk(root, &visitor, 100) catch failure:
            assert(failure.code == memory.exhausted)
            rejected = true
    assert(rejected == (fail_at != 0))
    assert(owner.failures == (1 if rejected else 0))
    owner.finish()
    assert(descriptors() == before)
    return owner.attempts

func failure_cases(root: c.str) -> !:
    let before = descriptors()
    let kinds: i32[4] = [20, 21, 22, 37]
    for kind in kinds:
        var owner = allocator.Failing.at(0)
        var visitor = Visitor()
        var rejected = false
        with owner:
            fault_arm(kind)
            files.walk(root, &visitor, 100) catch failure:
                assert(failure.code == (files.directory_cycle if kind == 37 else files.failed))
                rejected = true
        assert(rejected == (kind != 22) and fault_hits() == 1)
        owner.finish()
        assert(descriptors() == before)
    var mode: usize = 0
    while mode < 2:
        var owner = allocator.Failing.at(0)
        var visitor = Visitor(fail_after = 3 if mode == 0 else 0)
        var rejected = false
        with owner:
            files.walk(root, &visitor, 3 if mode == 1 else 100) catch failure:
                assert(failure.code == (callback_failure if mode == 0 else files.depth_limit))
                rejected = true
        assert(rejected)
        owner.finish()
        assert(descriptors() == before)
        mode += 1

pub func main(arguments: c.str[]) -> i32!:
    let steps = attempt(arguments[1], 0)
    assert(steps >= 4, "the callback redirected traversal allocations")
    var fail_at: usize = 1
    while fail_at <= steps:
        discard(attempt(arguments[1], fail_at))
        fail_at += 1
    try failure_cases(arguments[1])
    var owner = allocator.Failing.at(1)
    var pruned = Visitor(prune_root = true)
    with owner:
        try files.walk(arguments[1], &pruned, 0)
    assert(pruned.visits == 1 and owner.attempts == 0)
    var leaf = Visitor()
    with owner:
        try files.walk(arguments[2], &leaf, 0)
    assert(leaf.visits == 1 and owner.attempts == 0)
    owner.finish()
    print("ok walk failures")
    return 0
