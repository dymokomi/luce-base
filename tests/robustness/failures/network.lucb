import io
import net
extern func socketpair(domain: i32, kind: i32, protocol: i32, pair: i32*) -> i32
extern func fault_arm(kind: i32)
extern func fault_hits() -> i32
extern func fault_resolver_nodes() -> i32
extern func fault_socket_close(descriptor: i32)
extern func fault_socket_close_calls() -> i32
extern func fault_socket_option_closed() -> i32
extern func fault_socket_cloexec(descriptor: i32) -> i32
extern func fault_descriptor_closed(descriptor: i32) -> i32

func adoption_cases() -> !:
    var kind: i32 = 45
    while kind <= 48:
        var pair: i32[2]
        assert(socketpair(1, 1, 0, &pair[0]) == 0)
        var peer = try net.Connection.over(pair[1])
        defer peer.destroy()
        fault_arm(kind)
        var rejected = false
        var connection = net.Connection.over(pair[0]) catch failure:
            assert(failure.code == net.failed)
            rejected = true
            recover net.Connection()
        defer connection.destroy()
        assert(rejected == (kind >= 47) and fault_hits() == 1)
        if rejected:
            assert(fault_descriptor_closed(pair[0]) == 1)
        else:
            assert(fault_socket_cloexec(pair[0]) == 1)
        kind += 1
    var rejected = false
    discard(net.Connection.over(-1) catch failure:
        assert(failure.code == net.closed)
        rejected = true
        recover net.Connection())
    assert(rejected)

func closed_values() -> !:
    var connection: net.Connection
    var listener: net.Listener
    var datagram: net.Datagram
    assert(connection.descriptor() == none and listener.descriptor() == none and datagram.descriptor() == none)
    try connection.close()
    try listener.close()
    try datagram.close()
    connection.destroy()
    listener.destroy()
    datagram.destroy()
    var buffer: u8[]
    var rejected = false
    discard(connection.write(buffer) catch failure:
        assert(failure.code == net.closed)
        rejected = true
        recover 0)
    assert(rejected)
    rejected = false
    discard(connection.read(buffer) catch failure:
        assert(failure.code == net.closed)
        rejected = true
        recover 0)
    assert(rejected)
    rejected = false
    discard(listener.address() catch failure:
        assert(failure.code == net.closed)
        rejected = true
        recover net.Address.any(0))
    assert(rejected)
    rejected = false
    discard(listener.accept() catch failure:
        assert(failure.code == net.closed)
        rejected = true
        recover net.Connection())
    assert(rejected)
    rejected = false
    datagram.send_to(buffer, net.Address.loopback(1)) catch failure:
        assert(failure.code == net.closed)
        rejected = true
    assert(rejected)

func resolver_cases() -> !:
    var kind: i32 = 23
    while kind <= 26:
        fault_arm(kind)
        var rejected = false
        let address = net.resolve("injected.invalid", 4321) catch failure:
            assert(failure.code == net.unknown_host)
            rejected = true
            recover net.Address.any(0)
        assert(rejected == (kind <= 24))
        if not rejected:
            assert(address.ip == 2130706474 and address.port == 4321)
        assert(fault_hits() == 1 and fault_resolver_nodes() == 0)
        kind += 1

pub func main(arguments: str[]) -> i32!:
    try closed_values()
    try adoption_cases()
    try resolver_cases()
    var pair: i32[2]
    assert(socketpair(1, 1, 0, &pair[0]) == 0)
    var sender = try net.Connection.over(pair[0])
    defer sender.destroy()
    var receiver = try net.Connection.over(pair[1])
    fault_arm(1)
    assert(try sender.write("abcdefgh".bytes) == 3)
    try io.write_all(&sender, "defgh".bytes)
    assert(fault_hits() == 1)
    var buffer: u8[8]
    var got: usize = 0
    fault_arm(2)
    while got < buffer.length:
        got += try receiver.receive(buffer[got..])
    assert(fault_hits() == 1)
    assert((str)buffer == "abcdefgh")
    var kind: i32 = 3
    while kind <= 4:
        fault_arm(kind)
        var failed = false
        discard(sender.write("bad".bytes) catch failure:
            assert(failure.code == (net.closed if kind == 3 else io.no_progress))
            failed = true
            recover 0)
        assert(failed and fault_hits() == 1)
        kind += 1
    # A failure after the first successful short send must report that prefix.
    var confirmed: usize = 0
    fault_arm(38)
    var blocked = false
    io.write_all(&sender, "retry-me".bytes, &confirmed) catch failure:
        assert(failure.code == io.would_block)
        blocked = true
    assert(blocked and confirmed == 3 and fault_hits() == 1)
    try io.write_all(&sender, "retry-me".bytes[confirmed..])
    try io.read_exact(&receiver, buffer)
    assert((str)buffer == "retry-me")
    fault_arm(39)
    blocked = false
    discard(receiver.read(buffer) catch failure:
        assert(failure.code == io.would_block)
        blocked = true
        recover 0)
    assert(blocked and fault_hits() == 1)
    fault_arm(40)
    blocked = false
    discard(sender.write("x".bytes) catch failure:
        assert(failure.code == net.failed)
        blocked = true
        recover 0)
    assert(blocked and fault_hits() == 1)
    try receiver.close()
    var closed = false
    discard(sender.write("closed".bytes) catch failure:
        assert(failure.code == net.closed)
        closed = true
        recover 0)
    assert(closed)
    fault_arm(44)
    var option_failed = false
    discard(net.Listener.bind(net.Address.loopback(0)) catch failure:
        assert(failure.code == net.failed)
        option_failed = true
        recover net.Listener())
    assert(option_failed and fault_hits() == 1 and fault_socket_option_closed() == 1)
    var listener = try net.Listener.bind(net.Address.loopback(0))
    defer listener.destroy()
    fault_arm(41)
    assert((try listener.address()).port != 0 and fault_hits() == 1)
    kind = 42
    while kind <= 43:
        fault_arm(kind)
        var rejected = false
        discard(listener.address() catch failure:
            assert(failure.code == net.failed)
            rejected = true
            recover net.Address.any(0))
        assert(rejected and fault_hits() == 1)
        kind += 1
    var client = try net.Connection.connect((try listener.address()))
    defer client.destroy()
    fault_arm(5)
    var accepted = try listener.accept()
    defer accepted.destroy()
    assert(fault_hits() == 1)
    var left = try net.Datagram.bind(net.Address.loopback(0))
    defer left.destroy()
    var right = try net.Datagram.bind(net.Address.loopback(0))
    defer right.destroy()
    let listener_fd = listener.descriptor() else trap("listener is closed")
    let client_fd = client.descriptor() else trap("client is closed")
    let accepted_fd = accepted.descriptor() else trap("accepted socket is closed")
    let datagram_fd = right.descriptor() else trap("datagram is closed")
    assert(fault_socket_cloexec(listener_fd) == 1 and fault_socket_cloexec(client_fd) == 1)
    assert(fault_socket_cloexec(accepted_fd) == 1 and fault_socket_cloexec(datagram_fd) == 1)
    fault_arm(6)
    try left.send_to("packet".bytes, (try right.address()))
    assert(fault_hits() == 1)
    fault_arm(7)
    let (count, peer) = try right.receive_from(buffer)
    assert(count == 6 and peer.port == (try left.address()).port)
    assert((str)buffer[..<count] == "packet" and fault_hits() == 1)
    let descriptor = accepted.descriptor() else trap("accepted socket is not open")
    fault_socket_close(descriptor)
    var rejected = false
    accepted.close() catch failure:
        assert(failure.code == net.failed)
        rejected = true
    assert(rejected and accepted.descriptor() == none)
    try accepted.close()
    accepted.destroy()
    assert(fault_socket_close_calls() == 1)
    assert((try client.read(buffer)) == 0)
    try listener.close()
    try listener.close()
    try left.close()
    try left.close()
    assert(listener.descriptor() == none and left.descriptor() == none)
    print("ok network failures")
    return 0
