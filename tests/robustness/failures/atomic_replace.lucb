import allocator
import c
import files
import io
import memory
import paths
import strings

extern func atomic_fault_arm(kind: i32)
extern func atomic_fault_clear()
extern func atomic_fault_hits() -> i32
extern func atomic_descriptors() -> i32

func check_state(path: c.str, directory: c.str, expected: str, descriptors: i32) -> !:
    let data = try files.read(path)
    defer free(data)
    assert((str)data == expected)
    let entries = try files.list(directory)
    defer files.release_list(entries)
    for entry in entries:
        assert(not strings.starts_with(entry, ".luce-"), "a temporary entry was left behind")
    assert(atomic_descriptors() == descriptors)

func allocation_case(path: c.str, directory: c.str, fail_at: usize) -> usize!:
    try files.write(path, "old".bytes)
    let before = atomic_descriptors()
    var owner = allocator.Failing.at(fail_at)
    var rejected = false
    var published = true
    with owner:
        files.write_atomic(path, "replacement".bytes, synchronize = true, published = &published) catch failure:
            assert(failure.code == memory.exhausted)
            rejected = true
    assert(rejected == (fail_at != 0) and published == (fail_at == 0))
    owner.finish()
    try check_state(path, directory, "old" if rejected else "replacement", before)
    return owner.attempts

func syscall_cases(path: c.str, directory: c.str) -> !:
    var kind: i32 = 1
    while kind <= 7:
        try files.write(path, "old".bytes)
        let before = atomic_descriptors()
        var owner = allocator.Failing.at(0)
        var rejected = false
        var published = false
        with owner:
            atomic_fault_arm(kind)
            files.write_atomic(path, "replacement".bytes, synchronize = true, published = &published) catch failure:
                assert(failure.code == (files.no_space if kind == 2 else files.failed))
                rejected = true
        assert(rejected and atomic_fault_hits() == 1)
        assert(published == (kind >= 6), "publication status lost a post-rename failure")
        owner.finish()
        try check_state(path, directory, "replacement" if published else "old", before)
        kind += 1

func temporary_cases(directory: c.str) -> !:
    let before = atomic_descriptors()
    var owner = allocator.Failing.at(0)
    var temporary: files.TemporaryFile
    with owner:
        atomic_fault_arm(9)
        temporary = try files.TemporaryFile.create(directory)
        try io.write_all(&temporary, "kept".bytes)
        var rejected = false
        discard(files.TemporaryFile.create(directory) catch failure:
            assert(failure.code == files.already_exists)
            rejected = true
            var empty: files.TemporaryFile
            recover empty)
        assert(rejected and atomic_fault_hits() == 129)
        atomic_fault_clear()
    # The object retains its pathname allocator across with blocks.
    discard(try temporary.seek(0))
    var bytes: u8[4]
    try io.read_exact(&temporary, bytes)
    assert((str)bytes == "kept")
    let contents = try files.read((c.str)temporary.path())
    defer free(contents)
    assert((str)contents == "kept")
    atomic_fault_arm(8)
    var rejected = false
    temporary.discard() catch failure:
        assert(failure.code == files.permission_denied)
        rejected = true
    assert(rejected and atomic_fault_hits() == 1 and temporary.path().length > 0)
    try temporary.discard()
    try temporary.discard()
    temporary.destroy()
    owner.finish()
    assert(atomic_descriptors() == before)

func copy_cases(path: c.str, directory: c.str) -> !:
    let source_name = try paths.join((str)directory, "copy-source")
    defer strings.release(source_name)
    let source = (c.str)source_name
    try files.write(source, "source".bytes)
    let before = atomic_descriptors()
    var rejected = false
    var published = true
    discard(files.copy_file(source, source, replace = true, published = &published) catch failure:
        assert(failure.code == files.invalid_options)
        rejected = true
        recover 0)
    assert(rejected and not published)
    let alias = try paths.join((str)directory, "copy-alias")
    defer strings.release(alias)
    try files.create_hard_link(source, (c.str)alias)
    rejected = false
    discard(files.copy_file(source, (c.str)alias, replace = true) catch failure:
        assert(failure.code == files.invalid_options)
        rejected = true
        recover 0)
    assert(rejected)
    try files.remove_file((c.str)alias)
    var allocation_index: usize = 0
    var allocation_steps: usize = 0
    while allocation_index <= allocation_steps:
        try files.write(path, "old".bytes)
        var owner = allocator.Failing.at(allocation_index)
        rejected = false
        published = false
        with owner:
            discard(files.copy_file(source, path, replace = true, synchronize = true, published = &published) catch failure:
                assert(failure.code == memory.exhausted)
                rejected = true
                recover 0)
        if allocation_index == 0:
            allocation_steps = owner.attempts
        assert(rejected == (allocation_index != 0) and published == (allocation_index == 0))
        assert(owner.failures == (1 if rejected else 0))
        owner.finish()
        try check_state(path, directory, "old" if rejected else "source", before)
        allocation_index += 1
    try files.write(path, "old".bytes)
    rejected = false
    discard(files.copy_file(source, path) catch failure:
        assert(failure.code == files.already_exists)
        rejected = true
        recover 0)
    assert(rejected)
    rejected = false
    discard(files.copy_file(source, path, limit = 5, replace = true, published = &published) catch failure:
        assert(failure.code == files.too_large)
        rejected = true
        recover 0)
    assert(rejected and not published)
    try check_state(path, directory, "old", before)
    var kind: i32 = 10
    while kind <= 13:
        try files.write(path, "old".bytes)
        if kind == 12:
            try files.remove_file(path)
        var owner = allocator.Failing.at(0)
        rejected = false
        published = false
        var count: usize = 0
        with owner:
            atomic_fault_arm(kind)
            count = files.copy_file(source, path, replace = kind != 12, synchronize = true, published = &published) catch failure:
                assert(failure.code == (files.already_exists if kind == 12 else files.failed))
                rejected = true
                recover 0
        assert(rejected == (kind != 13) and published == (kind == 13))
        assert(atomic_fault_hits() == 1)
        owner.finish()
        if kind == 13:
            assert(count == 6)
        try check_state(path, directory, "source" if kind == 13 else ("racer" if kind == 12 else "old"), before)
        kind += 1
    try files.remove_file(path)
    published = false
    assert(try files.copy_file(source, path, limit = 6, published = &published) == 6)
    assert(published)
    try check_state(path, directory, "source", before)
    try files.remove_file(source)

pub func main(arguments: c.str[]) -> i32!:
    let path = arguments[1]
    let parent = try strings.copy(paths.directory((str)path))
    defer strings.release(parent)
    let directory = (c.str)parent
    let steps = try allocation_case(path, directory, 0)
    var fail_at: usize = 1
    while fail_at <= steps:
        discard(try allocation_case(path, directory, fail_at))
        fail_at += 1
    try syscall_cases(path, directory)
    try temporary_cases(directory)
    try copy_cases(path, directory)
    print("ok atomic failures")
    return 0
