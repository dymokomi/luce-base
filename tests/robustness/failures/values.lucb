## Allocation failures must preserve existing values and use their original allocator.
import allocator
import memory
import strings
import luce_std.paths
import luce_std.unicode

func text_work() -> !:
    let folded = try unicode.case_fold("Straße")
    defer folded.release()
    assert(folded.value == "strasse")
    let unicode_upper = try unicode.to_upper("Straße")
    defer unicode_upper.release()
    assert(unicode_upper.value == "STRASSE")
    let unicode_lower = try unicode.to_lower("ΟΣ")
    defer unicode_lower.release()
    assert(unicode_lower.value == "ος")
    let unicode_empty = try unicode.case_fold("")
    defer unicode_empty.release()
    assert(unicode_empty.value == "")
    # U+0315 (class 232) precedes U+0300 (class 230): sorting needs scratch storage.
    let normalized = try unicode.normalize("À̕")
    defer normalized.release()
    assert(normalized.value == "À̕")
    let normalized_empty = try unicode.normalize("")
    defer normalized_empty.release()
    assert(normalized_empty.value == "")
    assert(try strings.parse_f64("12.5") == 12.5)
    assert(try strings.parse_f32("-0.125") == (f32)-0.125)
    let parts = try strings.split("ab,,Cd,", ',')
    defer free(parts)
    assert(parts.length == 4 and parts[1] == "" and parts[3] == "")
    let fields = try strings.split_by("a::::b::", "::")
    defer free(fields)
    assert(fields.length == 4 and fields[0] == "a" and fields[1] == "" and fields[2] == "b" and fields[3] == "")
    let replaced = try strings.replace("ab--cd--", "--", "/")
    defer strings.release(replaced)
    assert(replaced == "ab/cd/")
    let limited = try strings.replace("ab--cd--", "--", "/", 1)
    defer strings.release(limited)
    assert(limited == "ab/cd--")
    let deleted = try strings.replace("aaaa", "aa", "")
    defer strings.release(deleted)
    assert(deleted == "")
    let joined = try strings.join(parts, ":")
    defer strings.release(joined)
    assert(joined == "ab::Cd:")
    let copy = try strings.copy(joined)
    defer strings.release(copy)
    let upper = try strings.to_upper(copy)
    defer strings.release(upper)
    let lower = try strings.to_lower(upper)
    defer strings.release(lower)
    assert(lower == "ab::cd:")
    let empty = try strings.copy("")
    defer strings.release(empty)
    assert(empty.length == 0)
    let left: str[5] = ["a", "a/", "", "ignored", "/"]
    let right: str[5] = ["b", "b", "b", "/b", ""]
    let expected: str[5] = ["a/b", "a/b", "b", "/b", "/"]
    for i in 0..<left.length:
        let path = try paths.join(left[i], right[i])
        assert(path.value == expected[i])
        path.release()

func arena_work(owner: memory.Allocator, other: memory.Allocator) -> !:
    var arena = try memory.Arena.over(owner, 128)
    with other:
        defer arena.destroy()
        let first = arena.allocate(24, 16) else trap("room in arena")
        assert((usize)first.data % 16 == 0)
        let used = arena.in_use()
        assert(arena.allocate(256, 16) == none)
        assert(arena.in_use() == used)
        arena.reset()
        assert(arena.in_use() == 0)
        assert(arena.allocate(64, 16) != none)

func grow_work() -> !:
    var block = try new u8[8] ---
    defer free(block)
    memory.set(block, 23)
    block = memory.grow(block, 256) catch failure:
        assert(block.length == 8)
        for b in block:
            assert(b == 23)
        error(failure.code, failure.message)
    assert(block.length == 256)
    for b in block[..<8]:
        assert(b == 23)

func attempt(which: i32, fail_at: usize) -> usize:
    var owner = allocator.Failing.at(fail_at)
    var other = allocator.Failing.at(1)
    var rejected = false
    with owner:
        if which == 0:
            text_work() catch failure:
                assert(failure.code == memory.exhausted)
                rejected = true
                recover ()
        elif which == 1:
            arena_work(&owner, &other) catch failure:
                assert(failure.code == memory.exhausted)
                rejected = true
                recover ()
        else:
            grow_work() catch failure:
                assert(failure.code == memory.exhausted)
                rejected = true
                recover ()
    assert(rejected == (fail_at != 0))
    assert(owner.failures == (1 if rejected else 0))
    assert(other.attempts == 0, "an operation lost its allocator owner")
    owner.finish()
    other.finish()
    return owner.attempts

pub func main(arguments: str[]) -> i32:
    var which: i32 = 0
    while which < 3:
        let steps = attempt(which, 0)
        var i: usize = 1
        while i <= steps:
            _ = attempt(which, i)
            i += 1
        which += 1
    print("ok value failures")
    return 0
