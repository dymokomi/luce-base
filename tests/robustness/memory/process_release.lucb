## What the library allocates on a program's behalf comes back exactly: the texts
## `process.run` answers through the result's `release`, the texts `strings` makes through
## `strings.release`, the array `split` answers through `free`, and a builder's bytes
## through `destroy`, whatever allocator was current when each was made.
import c
import counting
import luce_std.collections
import luce_std.process
import strings

pub func main(arguments: str[]) -> i32!:
    var counter = counting.Counting.unlimited()
    with counter:
        let echo_args: c.str[2] = ["-n", "hello there"]
        let ran = try process.run("echo", echo_args)
        print(f"{ran.value.exit_code} {ran.value.output} [{ran.value.error_output.length}]")
        ran.release()
        let pieces: str[3] = ["a", "b", "c"]
        let joined = try strings.join(pieces, ", ")
        let copied = try strings.copy(joined)
        let upper = try strings.to_upper(copied)
        let parts = try strings.split(upper, ',')
        print(f"{joined} {copied} {upper} {parts.length}")
        free(parts)
        strings.release(upper)
        strings.release(copied)
        strings.release(joined)
    var builder: collections.Buffer
    try builder.reserve(8)
    with counter:
        var i: usize = 0
        while i < 500:
            try builder.put_text("ab")
            i += 1
    # the buffer grew in the allocator of its first growth, the heap, whatever was current meanwhile
    print(f"{builder.length()} {counter.live} {counter.bytes}")
    builder.destroy()
    counter.report("process_release")
    return 0
