## Small functions called in a loop: leaf calls should inline, and a struct passed by value
## should not be copied more than the ABI requires.
struct Point:
    var x: i64
    var y: i64

func square(n: i64) -> i64:
    return n * n

func norm(p: Point) -> i64:
    return square(p.x) + square(p.y)

pub func main(arguments: str[]) -> i32:
    var acc: i64 = 0
    var i: i64 = 0
    while i < 100:
        acc += norm(Point(x = i, y = 1))
        i += 1
    print(f"{acc}")
    return 0
