#==============================================================================================
#
#   backend - The interface every code generator implements
#
#   DESCRIPTION:
#       The pipeline is checked tree (the high-level form the checker leaves, with a type and
#       a resolution on every node) to a target. A `Backend` is the last stage: it takes the
#       checked program and yields the text its host tool consumes. Two implement it today:
#       `CBackend` streams C for the host C compiler; `NativeBackend` lowers the tree to the
#       machine-neutral IR of `ir` (the middle form, in the spirit of QBE) and turns that into
#       the target's assembly, arm64 (Mach-O) or x86_64 (ELF). A third target adds a
#       generator and a line here and changes nothing else: the driver holds a `Backend`
#       view and never names a generator.
#
#==============================================================================================

import memory
import back.arm64
import back.cfg
import back.dessa
import back.gvn
import back.load
import back.ssa
import back.target as targets
import back.x86_64
import back.emit
import back.inline
import back.ir
import back.irtext
import back.lower
import back.opt
import front.ast
import sema.check

pub let unsupported_target: ErrorCode = ErrorCode.package(20)

## The last stage of the pipeline: the checked program as the target's text.
pub interface Backend:
    ## `mode` is 0 for a `main` program, 1 for the test runner, 2 for an `answer()` program,
    ## 3 for a library, which has no entry and initialises itself when loaded (§17.6), 4 for
    ## a freestanding program, whose own `_start` is the entry (§19.4).
    mutating func compile(mode: u32) -> str!

## C for the host C compiler.
pub struct CBackend: Backend:
    var emitter: emit.Emitter

    pub static func over(c: check.Checker*, entry: ast.Node*, diagnostic: bool) -> CBackend!:
        var emitter = try emit.Emitter.create(c, entry)
        emitter.diagnostic = diagnostic
        return CBackend(emitter = emitter)

    pub mutating func compile(mode: u32) -> str!:
        try self.emitter.program(mode)
        return self.emitter.text()

## arm64 assembly through the IR: lower the tree, then generate.
pub struct NativeBackend: Backend:
    var lowerer: lower.Lowerer
    var debug: bool
    ## `--emit=ir`: the IR as text after every pass before the target, instead of assembly.
    pub var dump_ir: bool
    ## How far the optimiser goes, and on how many functions (`--opt`, `--opt-count`).
    pub var opt_level: u32
    pub var opt_count: u32
    ## The target of the build (§19.5): arm64-macos and x86_64-linux have generators.
    var target: targets.Target

    pub static func over(c: check.Checker*, entry: ast.Node*, debug: bool, diagnostic: bool) -> NativeBackend!:
        var lowerer = try lower.Lowerer.create(c, entry)
        lowerer.diagnostic = diagnostic
        return NativeBackend(lowerer = lowerer, debug = debug, dump_ir = false, opt_level = 3, opt_count = 0xFFFFFFFF, target = c.build_target)

    pub mutating func compile(mode: u32) -> str!:
        let t = self.target
        let has_generator = (t.arch == targets.Arch.arm64 and t.os == targets.Os.macos) or (t.arch == targets.Arch.x86_64 and t.os == targets.Os.linux)
        if not has_generator:
            error(unsupported_target, "the native backend emits arm64-macos and x86_64-linux; write the C for another target with --emit=c")
        self.lowerer.debug = self.debug
        self.lowerer.target = t
        try self.lowerer.program(mode)
        try inline.expand(&self.lowerer.program_unit)
        try optimise_functions(&self.lowerer.program_unit, self.opt_level, self.opt_count)
        try opt.optimise(&self.lowerer.program_unit)
        if self.dump_ir:
            return try irtext.render(&self.lowerer.program_unit)
        if t.arch == targets.Arch.x86_64:
            var generator = try x86_64.Generator.create(&self.lowerer.program_unit)
            generator.symbol_prefix = t.symbol_prefix
            generator.os = t.os
            try generator.generate()
            return generator.text()
        var generator = try arm64.Generator.create(&self.lowerer.program_unit)
        generator.symbol_prefix = t.symbol_prefix
        try generator.generate()
        return generator.text()

## The optimiser over the IR, function by function: slots into temporaries, the function
## into single-assignment form, the passes, then the phis back into copies for the
## generator. A naked function is its assembly; a function under `--debug` keeps its
## locals in their slots, where the frame descriptor says they are.
func optimise_functions(program: ir.Unit*, level: u32, count: u32) -> !:
    var i: usize = 0
    while i < program.functions.count and i < (usize)count:
        let f = &program.functions.items[i]
        i += 1
        if f.naked or f.debug or f.instrs.count == 0 or level == 0:
            continue
        # the passes' working memory is the heap's, returned as each pass finishes; the
        # driver's arena would keep every function's scratch until the build ends
        with memory.heap:
            var g = try cfg.Graph.over(f)
            if try ssa.promote(f):
                g.release()
                g = try cfg.Graph.over(f)
            var g2 = try ssa.construct(f, &g)
            g.release()
            if level < 2:
                try dessa.run(f, &g2)
                g2.release()
                continue
            var g3 = try gvn.run(f, &g2)
            g2.release()
            if level >= 3 and try load.run(f, &g3):
                # loads became copies, and phis joined some blocks: number again
                g3.release()
                g3 = try cfg.Graph.over(f)
                var g4 = try gvn.run(f, &g3)
                g3.release()
                g3 = g4
            try dessa.run(f, &g3)
            g3.release()
