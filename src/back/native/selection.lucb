#==============================================================================================
#
#   selection - Shared, local instruction-selection facts
#
#   DESCRIPTION:
#       Counting every use prevents a comparison needed elsewhere from being consumed by a
#       fused branch, or an address needed elsewhere by a fused load or store. The
#       generators ask these questions as they walk a function's IR.
#
#==============================================================================================

import back.ir.ir

# mark: Uses and entry ========================================================================

## The number of times each temporary is used, by index; a comparison used once may fuse.
pub func uses(f: ir.Function*) -> u32[]!:
    var counts = try alloc u32[f.temps.count + 1]
    for i in 0..<counts.length:
        counts[i] = 0
    for x in f.instrs.span():
        if x.op == ir.Op.dbg:
            continue
        mark(counts, x.a)
        mark(counts, x.b)
        let (start, count) = ir.argument_range(f, x)
        for k in 0..<count:
            mark(counts, f.args.get(start + k).value)
    return counts

func mark(counts: u32[], value: ir.Ref):
    if value.kind == ir.RefKind.temp:
        counts[value.index] += 1

## For each parameter, 1 + the index of the load at the function's entry that reads its
## slot (`ssa.promote` puts one there for a promoted parameter), when nothing else names
## that slot: the generator then moves the argument from where it arrives straight into
## the load's result, and neither stores it nor loads it back. 0 for every other.
pub func entry_loads(f: ir.Function*) -> u32[]!:
    var entry = try alloc u32[f.params.count + 1]
    for p in 0..<entry.length:
        entry[p] = 0
    if f.debug or f.symbols:
        return entry
    var named = try alloc u32[f.slots.count + 1]
    defer free(named)
    for s in 0..<named.length:
        named[s] = 0
    for x in f.instrs.span():
        note_slot(named, x.a)
        note_slot(named, x.b)
        let (start, count) = ir.argument_range(f, x)
        for k in 0..<count:
            note_slot(named, f.args.get(start + k).value)
    # the leading loads, each of a slot or through an address of one taken just before
    let counts = try uses(f)
    defer free(counts)
    var slot_of = try alloc u32[f.temps.count + 1]
    defer free(slot_of)
    for t in 0..<slot_of.length:
        slot_of[t] = 0
    for i in 0..<f.instrs.count:
        let x = f.instrs.get(i)
        if x.op == ir.Op.dbg:
            continue
        if x.op == ir.Op.addr and x.a.kind == ir.RefKind.slot and x.dst != 0:
            slot_of[(usize)x.dst] = x.a.index + 1
            continue
        if not ((u8)x.op >= (u8)ir.Op.loadsb and (u8)x.op <= (u8)ir.Op.loadd) or x.dst == 0:
            break
        var slot: u32 = 0
        if x.a.kind == ir.RefKind.slot:
            slot = x.a.index + 1
        elif x.a.kind == ir.RefKind.temp and counts[(usize)x.a.index] == 1:
            slot = slot_of[(usize)x.a.index]
        if slot == 0 or named[(usize)slot - 1] != 1:
            break
        for p in 0..<f.params.count:
            let param = f.params.get(p)
            if param.size == 0 and param.slot + 1 == slot and entry[p] == 0:
                entry[p] = u32(i + 1)
    return entry

func note_slot(named: u32[], value: ir.Ref):
    if value.kind == ir.RefKind.slot and (usize)value.index < named.length:
        named[(usize)value.index] += 1

# mark: Zero upper halves =====================================================================

## By index, the `w` temporaries whose register holds zeros above the low 32 bits wherever
## they are read. arm64 clears the upper half whenever an instruction writes a register's
## 32-bit view, as the generator does for a `w` operator, comparison, extension, and
## constant, and for a load that zero-fills; a copy of such a value keeps it. What may
## leave the upper half as it was is not: a parameter's load at the entry (the argument's
## own register may become the result: `entry`), a word loaded from a slot (the slot may
## be promoted to a register whose upper half a wider store wrote), a call's result, a
## narrowing copy of an `l`. The generator then emits no `extuw` of one that is already in
## its result's register.
pub func zero_extended(f: ir.Function*, entry: u32[]) -> bool[]!:
    let n = f.temps.count
    var clean = try alloc bool[n + 1]
    var defined = try alloc bool[n + 1]
    defer free(defined)
    var of_slot = try alloc bool[n + 1]
    defer free(of_slot)
    for t in 0..<clean.length:
        clean[t] = t != 0 and f.temp_class(u32(t)) == ir.Class.w
        defined[t] = false
        of_slot[t] = false
    var at_entry = try alloc bool[f.instrs.count + 1]
    defer free(at_entry)
    for i in 0..<at_entry.length:
        at_entry[i] = false
    for k in entry:
        if k != 0:
            at_entry[(usize)k - 1] = true
    for i in 0..<f.instrs.count:
        let x = f.instrs.get(i)
        if x.dst == 0 or (usize)x.dst > n:
            continue
        defined[(usize)x.dst] = true
        if x.op == ir.Op.addr and x.a.kind == ir.RefKind.slot:
            of_slot[(usize)x.dst] = true
        if not clean[(usize)x.dst]:
            continue
        var writes_word = false
        match x.op:
            .add, .sub, .mul, .sdiv, .udiv, .srem, .urem, .and_, .or_, .xor, .shl, .lshr, .ashr, .neg:
                writes_word = x.cls == ir.Class.w
            .ceq, .cne, .cslt, .csle, .csgt, .csge, .cult, .cule, .cugt, .cuge:
                writes_word = x.cls == ir.Class.w or x.cls == ir.Class.l
            .extsb, .extub, .extsh, .extuh:
                writes_word = true
            .loadsb, .loadub, .loadsh, .loaduh:
                writes_word = not at_entry[i]
            .loaduw:
                let through_slot = x.a.kind == ir.RefKind.slot or (x.a.kind == ir.RefKind.temp and (usize)x.a.index <= n and of_slot[(usize)x.a.index])
                writes_word = not at_entry[i] and not through_slot
            .copy:
                writes_word = x.a.kind == ir.RefKind.constant or (x.a.kind == ir.RefKind.temp and f.temp_class(x.a.index) == ir.Class.w)
            _:
                writes_word = false
        if not writes_word:
            clean[(usize)x.dst] = false
    for t in 1..<clean.length:
        if not defined[t]:
            clean[t] = false
    # a copy of a value that may be dirty is too, round the loops until nothing changes
    var changed = true
    while changed:
        changed = false
        for x in f.instrs.span():
            if x.op == ir.Op.copy and x.dst != 0 and (usize)x.dst <= n and clean[(usize)x.dst] and x.a.kind == ir.RefKind.temp and not clean[(usize)x.a.index]:
                clean[(usize)x.dst] = false
                changed = true
    return clean

# mark: Fusions ===============================================================================

## Send every jump to a label that shares its place with others (labels in a row, with
## only `dbg` between) to the first of the run, so a generator falling into the run finds
## its target next (`label_at`) and leaves out the jump.
pub func canonical_labels(f: ir.Function*) -> !:
    if f.labels == 0:
        return
    var first = try alloc u32[(usize)f.labels + 1]
    defer free(first)
    for k in 0..<first.length:
        first[k] = u32(k)
    var run: u32 = 0
    var changed = false
    for x in f.instrs.span():
        if x.op == ir.Op.label:
            if run == 0:
                run = x.extra
            elif (usize)x.extra < first.length:
                first[(usize)x.extra] = run
                changed = true
        elif x.op != ir.Op.dbg:
            run = 0
    if not changed:
        return
    for i in 0..<f.instrs.count:
        var x = f.instrs.get(i)
        if x.op == ir.Op.jmp or x.op == ir.Op.switch_:
            x.extra = first[(usize)x.extra] if (usize)x.extra < first.length else x.extra
        elif x.op == ir.Op.jnz:
            x.extra = first[(usize)x.extra] if (usize)x.extra < first.length else x.extra
            x.extra2 = first[(usize)x.extra2] if (usize)x.extra2 < first.length else x.extra2
        else:
            continue
        f.instrs.set(i, x)
    for k in 0..<f.jump_labels.count:
        let label = f.jump_labels.get(k)
        if (usize)label < first.length:
            f.jump_labels.set(k, first[(usize)label])

## By label, whether a jump after it goes back to it: a loop's head, which a generator
## aligns so the loop's body does not straddle more fetch blocks than it must.
pub func loop_heads(f: ir.Function*) -> bool[]!:
    var heads = try alloc bool[(usize)f.labels + 1]
    for k in 0..<heads.length:
        heads[k] = false
    var placed = try alloc bool[(usize)f.labels + 1]
    defer free(placed)
    for k in 0..<placed.length:
        placed[k] = false
    for x in f.instrs.span():
        if x.op == ir.Op.label and (usize)x.extra < placed.length:
            placed[(usize)x.extra] = true
        elif x.op == ir.Op.jmp and (usize)x.extra < placed.length and placed[(usize)x.extra]:
            heads[(usize)x.extra] = true
        elif x.op == ir.Op.jnz:
            if (usize)x.extra < placed.length and placed[(usize)x.extra]:
                heads[(usize)x.extra] = true
            if (usize)x.extra2 < placed.length and placed[(usize)x.extra2]:
                heads[(usize)x.extra2] = true
    return heads

## By label, for a loop's head that only tests whether to go round (the label, then a
## comparison and the branch it fuses with): 1 + the comparison's index; 0 for any other.
## A jump to such a head tests it itself instead (the loop is rotated), so a round takes
## one branch rather than two. Each temporary keeps one register throughout, so the
## comparison reads the same values at the jump; a head where the dynamic area settles, or
## a build a debugger reads, keeps its jumps.
pub func rotations(f: ir.Function*, heads: bool[], counts: u32[], floats: bool) -> u32[]!:
    var tests = try alloc u32[heads.length]
    for k in 0..<tests.length:
        tests[k] = 0
    if f.debug or f.symbols or f.dynamic_levels != 0:
        return tests
    for k in 0..<f.instrs.count:
        let x = f.instrs.get(k)
        if x.op == ir.Op.label and (usize)x.extra < heads.length and heads[(usize)x.extra] and branch(f, k + 1, counts, floats):
            tests[(usize)x.extra] = (u32)k + 2
    return tests

## After `rotations`: a rotated loop goes round from its body's first label, which is then
## the one aligned, not the head it enters by once.
pub func rotate_heads(f: ir.Function*, heads: bool[], tests: u32[]):
    for k in 0..<tests.length:
        if tests[k] != 0:
            let body = f.instrs.get((usize)tests[k]).extra
            heads[k] = false
            if (usize)body < heads.length:
                heads[(usize)body] = true

## The label of the instruction at `at`, or 0 when it is not a label.
pub func label_at(f: ir.Function*, at: usize) -> u32:
    if at < f.instrs.count:
        let x = f.instrs.get(at)
        if x.op == ir.Op.label:
            return x.extra
    return 0

## Whether the instruction at `at` is a comparison whose only use is the branch right
## after it, so the two fuse into one conditional jump; of floats too when the generator
## `floats` branches on their flags.
pub func branch(f: ir.Function*, at: usize, counts: u32[], floats: bool = false) -> bool:
    if f.debug or at + 1 >= f.instrs.count:
        return false
    let x = f.instrs.get(at)
    let next = f.instrs.get(at + 1)
    let fuses = x.cls == ir.Class.w or x.cls == ir.Class.l or (floats and ir.is_float_class(x.cls))
    return ir.is_comparison(x.op) and fuses and x.dst != 0 and counts[x.dst] == 1 and next.op == ir.Op.jnz and next.a.kind == ir.RefKind.temp and next.a.index == x.dst

## When the instruction at `at` adds a constant (-256 to 32760) to an address and its only
## use is as the address of the load or store right after it: the base and the constant,
## which the access then addresses itself (`[base, #constant]`) while the base is still in
## its register. A half-precision access, and a build a debugger reads, keep the two apart.
pub func offset_access(f: ir.Function*, at: usize, counts: u32[]) -> (ir.Ref, i64)?:
    if f.debug or f.symbols or at + 1 >= f.instrs.count:
        return none
    let x = f.instrs.get(at)
    if x.op != ir.Op.add or x.cls != ir.Class.l or x.dst == 0 or counts[x.dst] != 1:
        return none
    var base = x.a
    var step = x.b
    if step.kind != ir.RefKind.constant:
        base = x.b
        step = x.a
    if step.kind != ir.RefKind.constant or base.kind != ir.RefKind.temp or step.value < -256 or step.value > 32760:
        return none
    let next = f.instrs.get(at + 1)
    let through = ir.temp_ref(x.dst)
    if next.op == ir.Op.loadhf or next.op == ir.Op.storehf:
        return none
    let loads = (u8)next.op >= (u8)ir.Op.loadsb and (u8)next.op <= (u8)ir.Op.loadd and same_temp(next.a, through)
    let stores = (u8)next.op >= (u8)ir.Op.storeb and (u8)next.op <= (u8)ir.Op.stored and same_temp(next.b, through) and not same_temp(next.a, through)
    if not loads and not stores:
        return none
    return (base, step.value)

## An index scaled by a power of two and added to a base, the sum the address of the load
## or store right after, each used once: `a[i]` over `u32`s (`mul i, 4`, `add base`,
## `loaduw`). The base, the index, and the shift, which is 0 or the access's own width, as
## arm64's register-offset addressing takes it (`ldr w0, [x1, x2, lsl #2]`).
pub func scaled_access(f: ir.Function*, at: usize, counts: u32[]) -> (ir.Ref, ir.Ref, u32)?:
    if f.debug or f.symbols or at + 2 >= f.instrs.count:
        return none
    let scale = f.instrs.get(at)
    if scale.cls != ir.Class.l or scale.dst == 0 or counts[scale.dst] != 1 or scale.b.kind != ir.RefKind.constant or scale.a.kind != ir.RefKind.temp:
        return none
    var shift: u32 = 0
    if scale.op == ir.Op.mul:
        let factor = scale.b.value
        if factor <= 0 or (factor & (factor - 1)) != 0:
            return none
        var rest = factor
        while rest > 1:
            rest >>= 1
            shift += 1
    elif scale.op == ir.Op.shl:
        if scale.b.value < 0 or scale.b.value > 3:
            return none
        shift = (u32)scale.b.value
    else:
        return none
    let sum = f.instrs.get(at + 1)
    if sum.op != ir.Op.add or sum.cls != ir.Class.l or sum.dst == 0 or counts[sum.dst] != 1:
        return none
    var base = sum.b
    if not same_temp(sum.a, ir.temp_ref(scale.dst)):
        if not same_temp(sum.b, ir.temp_ref(scale.dst)):
            return none
        base = sum.a
    if base.kind != ir.RefKind.temp or same_temp(base, ir.temp_ref(scale.dst)):
        return none
    let access = f.instrs.get(at + 2)
    if access.op == ir.Op.loadhf or access.op == ir.Op.storehf:
        return none
    let through = ir.temp_ref(sum.dst)
    let loads = (u8)access.op >= (u8)ir.Op.loadsb and (u8)access.op <= (u8)ir.Op.loadd and same_temp(access.a, through)
    let stores = (u8)access.op >= (u8)ir.Op.storeb and (u8)access.op <= (u8)ir.Op.stored and same_temp(access.b, through) and not same_temp(access.a, through)
    if not loads and not stores:
        return none
    if shift != 0 and ((u32)1 << shift) != access_bytes(access.op):
        return none
    return (base, scale.a, shift)

## Two registers added, the sum used once as the address of the load or store right after:
## `data[pos]` over bytes (`add base, pos`, `loadub`). The two, which arm64's register-offset
## addressing adds itself (`ldrb w0, [x1, x2]`).
pub func summed_access(f: ir.Function*, at: usize, counts: u32[]) -> (ir.Ref, ir.Ref)?:
    if f.debug or f.symbols or at + 1 >= f.instrs.count:
        return none
    let sum = f.instrs.get(at)
    if sum.op != ir.Op.add or sum.cls != ir.Class.l or sum.dst == 0 or counts[sum.dst] != 1:
        return none
    if sum.a.kind != ir.RefKind.temp or sum.b.kind != ir.RefKind.temp or f.temp_class(sum.a.index) != ir.Class.l or f.temp_class(sum.b.index) != ir.Class.l:
        return none
    let access = f.instrs.get(at + 1)
    if access.op == ir.Op.loadhf or access.op == ir.Op.storehf:
        return none
    let through = ir.temp_ref(sum.dst)
    let loads = (u8)access.op >= (u8)ir.Op.loadsb and (u8)access.op <= (u8)ir.Op.loadd and same_temp(access.a, through)
    let stores = (u8)access.op >= (u8)ir.Op.storeb and (u8)access.op <= (u8)ir.Op.stored and same_temp(access.b, through) and not same_temp(access.a, through)
    if not loads and not stores:
        return none
    return (sum.a, sum.b)

## A value shifted left by a constant (or multiplied by a power of two), used once, by the
## add right after it: `base + i * 8` (`shl i, 3`, `add base`). The other addend, the shifted value and the shift, which arm64's
## shifted-register add takes itself (`add x0, x1, x2, lsl #3`).
pub func shifted_add(f: ir.Function*, at: usize, counts: u32[]) -> (ir.Ref, ir.Ref, u32)?:
    if f.debug or f.symbols or at + 1 >= f.instrs.count:
        return none
    let shift = f.instrs.get(at)
    if (shift.op != ir.Op.shl and shift.op != ir.Op.mul) or (shift.cls != ir.Class.l and shift.cls != ir.Class.w) or shift.dst == 0 or counts[shift.dst] != 1:
        return none
    if shift.a.kind != ir.RefKind.temp or shift.b.kind != ir.RefKind.constant:
        return none
    # a multiply by 2^k is a shift by k
    var bits = shift.b.value
    if shift.op == ir.Op.mul:
        if bits <= 1 or (bits & (bits - 1)) != 0:
            return none
        var k: i64 = 0
        while bits > 1:
            bits >>= 1
            k += 1
        bits = k
    if bits < 0 or bits >= (64 if shift.cls == ir.Class.l else 32):
        return none
    let sum = f.instrs.get(at + 1)
    if sum.op != ir.Op.add or sum.cls != shift.cls:
        return none
    let through = ir.temp_ref(shift.dst)
    var other = sum.a
    if not same_temp(sum.b, through):
        if not same_temp(sum.a, through):
            return none
        other = sum.b
    if other.kind != ir.RefKind.temp or same_temp(other, through):
        return none
    return (other, shift.a, (u32)bits)

## The bytes a load or store moves.
func access_bytes(op: ir.Op) -> u32:
    match op:
        .loadsb, .loadub, .storeb: return 1
        .loadsh, .loaduh, .storeh: return 2
        .loadsw, .loaduw, .loads, .storew, .stores: return 4
        _: return 8

func same_temp(a: ir.Ref, b: ir.Ref) -> bool:
    return a.kind == ir.RefKind.temp and b.kind == ir.RefKind.temp and a.index == b.index

## The comparison that a fused branch inverts to when the fall-through is the taken side.
pub func inverse(op: ir.Op) -> ir.Op:
    match op:
        .ceq: return ir.Op.cne
        .cne: return ir.Op.ceq
        .cslt: return ir.Op.csge
        .csle: return ir.Op.csgt
        .csgt: return ir.Op.csle
        .csge: return ir.Op.cslt
        .cult: return ir.Op.cuge
        .cule: return ir.Op.cugt
        .cugt: return ir.Op.cule
        _: return ir.Op.cult
