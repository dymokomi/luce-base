#==============================================================================================
#
#   object - How arm64 code loads an address, on Mach-O and ELF
#
#   DESCRIPTION:
#       A symbol's or a local label's address through its page, a library symbol's through
#       the GOT, and a thread-local's through the descriptor (Mach-O) or the thread pointer
#       (ELF). Everything else about the object format is the shared `objects.Format`.
#
#==============================================================================================

import back.native.objects
import support.buffer

## `adrp` and `add` to the address of a symbol or a local label in `reg`.
pub func page_address(object_format: const objects.Format*, out: buffer.Buffer*, reg: str, name: str, is_symbol: bool) -> !:
    try line(out, "adrp ")
    try out.put(reg)
    try out.put(", ")
    try put_name(object_format, out, name, is_symbol)
    if object_format.apple:
        try out.put("@PAGE")
    try line(out, "add ")
    try out.put(reg)
    try out.put(", ")
    try out.put(reg)
    try out.put(", ")
    if object_format.apple:
        try put_name(object_format, out, name, is_symbol)
        try out.put("@PAGEOFF")
    else:
        try out.put(":lo12:")
        try put_name(object_format, out, name, is_symbol)

## `name`, behind the symbol prefix when it is a symbol rather than a local label.
func put_name(object_format: const objects.Format*, out: buffer.Buffer*, name: str, is_symbol: bool) -> !:
    if is_symbol:
        try object_format.symbol(out, name)
    else:
        try out.put(name)

## The address of a function or another image's data through the GOT, so a symbol
## defined in a linked shared library resolves.
pub func got_address(object_format: const objects.Format*, out: buffer.Buffer*, reg: str, name: str) -> !:
    try line(out, "adrp ")
    try out.put(reg)
    try out.put(", ")
    if object_format.apple:
        try object_format.symbol(out, name)
        try out.put("@GOTPAGE")
    else:
        try out.put(":got:")
        try object_format.symbol(out, name)
    try line(out, "ldr ")
    try out.put(reg)
    try out.put(", [")
    try out.put(reg)
    try out.put(", ")
    if object_format.apple:
        try object_format.symbol(out, name)
        try out.put("@GOTPAGEOFF]")
    else:
        try out.put(":got_lo12:")
        try object_format.symbol(out, name)
        try out.put("]")

## The address of a thread-local into x0, x16 clobbered: Mach-O's descriptor and its
## accessor, or ELF's initial-exec model, the thread pointer plus the offset the
## linker writes into the GOT.
pub func thread_address(object_format: const objects.Format*, out: buffer.Buffer*, name: str) -> !:
    if object_format.apple:
        try line(out, "adrp x0, ")
        try object_format.symbol(out, name)
        try out.put("@TLVPPAGE")
        try line(out, "ldr x0, [x0, ")
        try object_format.symbol(out, name)
        try out.put("@TLVPPAGEOFF]")
        try line(out, "ldr x16, [x0]")
        try line(out, "blr x16")
        return
    try line(out, "adrp x0, :gottprel:")
    try object_format.symbol(out, name)
    try line(out, "ldr x0, [x0, :gottprel_lo12:")
    try object_format.symbol(out, name)
    try out.put("]")
    try line(out, "mrs x16, tpidr_el0")
    try line(out, "add x0, x16, x0")

func line(out: buffer.Buffer*, text: str) -> !:
    try out.put("\n    ")
    try out.put(text)
