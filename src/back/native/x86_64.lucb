#==============================================================================================
#
#   x86_64 - The x86_64 code generator
#
#   DESCRIPTION:
#       Turns an `ir.Unit` into assembly text for the GNU assembler, in the AT&T syntax the
#       C backend's inline assembly also uses: ELF sections, unprefixed symbols, rip-relative
#       addressing with the GOT and the PLT for what another image defines (so the output
#       links as position-independent code), thread-locals through the initial-exec model,
#       and calls under the System V convention (base.md §19.5): integers in rdi, rsi, rdx,
#       rcx, r8, r9, floats in xmm0-xmm7, an aggregate of up to sixteen bytes split into
#       eightbytes that each take an integer or an SSE register by what they hold, larger
#       ones copied onto the stack, results in rax/rdx and xmm0/xmm1 the same way or through
#       a hidden pointer, variadic calls with the SSE register count in al.
#
#       The shape is the arm64 generator's: a frame slot for every temporary and stack slot
#       below rbp, the most-used slots promoted into callee-saved registers, temporaries
#       given the rest by linear scan. The convention has no callee-saved SSE registers, so
#       floats stay in the frame between instructions. Half floats convert through the F16C
#       instructions and compute in single precision, rounding once to a half, which is what
#       the C compiler does for `_Float16` on this target.
#
#==============================================================================================

import back.native.dwarf
import back.native.frame
import back.native.selection
import back.ir.ir
import back.target as build_target
import memory
import support.buffer

pub let failed: ErrorCode = ErrorCode.package(21)


## One argument's placement for a call: in registers, one per eightbyte, or on the stack.
struct Placement:
    ## 0 = registers, 2 = stack
    var where: u8
    ## bit k set when eightbyte k takes an SSE register
    var sse: u8
    var first_int: u32
    var first_float: u32
    var words: u32
    var stack_offset: u32

pub struct Generator:
    pub var dw: dwarf.Emitter*?
    var out: buffer.Buffer
    ## What precedes a C symbol in this target's assembler: nothing on Linux (§19.5).
    pub var symbol_prefix: str
    ## The target's operating system decides the section names and the initialiser section.
    pub var os: build_target.Os
    ## The instruction-set level (§19.5): which forms the generator may emit.
    pub var level: u32
    var program_unit: ir.Unit*
    var f: ir.Function*
    var index: usize
    ## The instruction being emitted, for an asm block to see the operands around it.
    var at: usize
    ## Below x86-64-v3 there is no F16C: halves convert through the unit's own routines,
    ## emitted once at its end when a function needed them.
    var half_routines: bool
    ## Callee-saved registers an asm block names, pushed before it and popped after its
    ## outputs are read; `pending` is how many.
    var saved: str[8]
    var pending: usize
    ## The frame and the callee-saved registers: what every generator decides the same way.
    var fr: frame.Frame
    ## `--debug`: the frame descriptors, gathered while each function's frame is known.
    var descriptors: buffer.Buffer
    ## Register allocation: for each temporary, the callee-saved register it lives in
    ## The callee-saved register code a promoted frame slot lives in, 0 when it stays in the

    pub static func create(program_unit: ir.Unit*) -> Generator!:
        return Generator(symbol_prefix = "", os = build_target.Os.linux, level = 1, out = try buffer.Buffer.create(262144), program_unit = program_unit, f = program_unit.functions.span().data, index = 0,
                         at = 0, saved = ["", "", "", "", "", "", "", ""], pending = 0, half_routines = false,
                         fr = try frame.Frame.create(frame.Registers(ints = 5, floats = 0, keep_ints = 2, keep_floats = 0, scratch_ints = 0, scratch_floats = 4)), descriptors = try buffer.Buffer.create(4096))

    # -- output ---------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        try self.out.put(text)

    mutating func line(text: str) -> !:
        try self.out.put("\n    ")
        try self.out.put(text)

    mutating func line2(a: str, b: str) -> !:
        try self.line(a)
        try self.put(b)

    mutating func line3(a: str, b: str, c: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)

    mutating func line4(a: str, b: str, c: str, d: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)
        try self.put(d)

    mutating func line5(a: str, b: str, c: str, d: str, e: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)
        try self.put(d)
        try self.put(e)

    mutating func put_u64(v: u64) -> !:
        try self.out.put_u64(v)

    mutating func put_i64(v: i64) -> !:
        try self.out.put_i64(v)

    mutating func symbol(name: str) -> !:
        try self.out.put(self.symbol_prefix)
        try self.out.put(name)

    ## `.L<function>_<label>`: local to the object, as the assembler treats `.L` names.
    mutating func label_name(n: u32) -> !:
        try self.out.put(".L")
        try self.out.put_u64((u64)self.index)
        try self.out.put("_")
        try self.out.put_u64((u64)n)

    mutating func text_label(n: u32) -> !:
        try self.out.put(".Ltext_")
        try self.out.put_u64((u64)n)

    pub func text() -> str:
        return self.out.view()

    # -- registers, immediates, and the frame ---------------------------------------------

    ## `value` into an integer register: `movl` for a 32-bit name, `movq` when the value
    ## fits a sign-extended immediate, `movabsq` otherwise.
    mutating func load_immediate(reg: str, value: i64) -> !:
        if is_narrow(reg):
            try self.line("movl $")
            try self.put_u64((u64)value & 4294967295)
            try self.put(", ")
            try self.put(reg)
            return
        if value >= -2147483648 and value <= 2147483647:
            try self.line("movq $")
        else:
            try self.line("movabsq $")
        try self.put_i64(value)
        try self.put(", ")
        try self.put(reg)

    ## `-offset(%rbp)`: the home `offset` bytes below the frame pointer.
    mutating func frame_operand(offset: u64) -> !:
        if self.os == build_target.Os.windows:
            try self.put_u64(self.fr.size - offset)
        else:
            try self.put("-")
            try self.put_u64(offset)
        try self.put("(%rbp)")

    ## The move that carries a register of class `cls` to or from memory.
    func move_of(cls: ir.Class) -> str:
        if cls == ir.Class.v:
            return "movdqu "
        if cls == ir.Class.w:
            return "movl "
        if cls == ir.Class.l:
            return "movq "
        if cls == ir.Class.d:
            return "movsd "
        return "movss "

    mutating func frame_store(reg: str, cls: ir.Class, offset: u64) -> !:
        try self.line3(self.move_of(cls), reg, ", ")
        try self.frame_operand(offset)

    mutating func frame_load(reg: str, cls: ir.Class, offset: u64) -> !:
        try self.line(self.move_of(cls))
        try self.frame_operand(offset)
        try self.put(", ")
        try self.put(reg)

    ## `reg = rbp - offset`.
    mutating func frame_address(reg: str, offset: u64) -> !:
        try self.line("leaq ")
        try self.frame_operand(offset)
        try self.put(", ")
        try self.put(reg)

    func temp_home(t: u32) -> u64:
        return self.fr.temp_home(t)

    func slot_home(s: u32) -> u64:
        return self.fr.slot_home(s)

    ## The scratch register of class `cls` numbered `n` (0, 1, 2): rax, rcx, rdx for the
    ## integers, xmm8, xmm9, xmm10 for the floats; r10 and r11 hold addresses.
    func reg(cls: ir.Class, n: u32) -> str:
        if cls == ir.Class.w:
            return "%eax" if n == 0 else ("%ecx" if n == 1 else "%edx")
        if cls == ir.Class.l:
            return "%rax" if n == 0 else ("%rcx" if n == 1 else "%rdx")
        return "%xmm8" if n == 0 else ("%xmm9" if n == 1 else "%xmm10")

    ## The register holding `r` as class `cls` when `r` is a temporary living in one and the
    ## class is an integer one, else `scratch` after loading it there.
    mutating func source(r: ir.Ref, cls: ir.Class, scratch: str) -> str!:
        if r.kind == ir.RefKind.temp:
            let code = self.fr.temp_regs.get((usize)r.index - 1)
            if code != 0 and self.fr.float_code(code) == not is_int_class(cls):
                return class_name(code, cls)
        try self.operand(scratch, cls, r)
        return scratch

    ## The register to compute temporary `dst` into: its own when it lives in one and the
    ## class is an integer one, else `scratch`, which `finish` then stores.
    func target(dst: u32, cls: ir.Class, scratch: str) -> str:
        if dst == 0:
            return scratch
        let code = self.fr.temp_regs.get((usize)dst - 1)
        if code != 0 and self.fr.float_code(code) == not is_int_class(cls):
            return class_name(code, cls)
        return scratch

    ## After a result landed in `reg`: nothing when that is the temporary's own register.
    mutating func finish(dst: u32, cls: ir.Class, reg: str) -> !:
        if dst == 0:
            return
        let code = self.fr.temp_regs.get((usize)dst - 1)
        if code != 0 and class_name(code, cls) == reg:
            return
        try self.store_temp(reg, cls, dst)

    ## Load temporary `t` into `reg` as class `cls`: a move when it lives in a register,
    ## else from its home. An integer register read as a float moves its bits over.
    mutating func load_temp(reg: str, cls: ir.Class, t: u32) -> !:
        let code = self.fr.temp_regs.get((usize)t - 1)
        if code != 0:
            let home = class_name(code, cls)
            if home != reg:
                try self.register_move(reg, home, cls, code)
            return
        try self.frame_load(reg, cls, self.temp_home(t))

    mutating func store_temp(reg: str, cls: ir.Class, t: u32) -> !:
        let code = self.fr.temp_regs.get((usize)t - 1)
        if code != 0:
            let home = class_name(code, cls)
            if home != reg:
                try self.register_move(home, reg, cls, code)
            return
        try self.frame_store(reg, cls, self.temp_home(t))

    ## `to = from` as class `cls` between registers, one of which is the home of a temporary
    ## in register `code`: integers move as words, floats and vectors with the SSE moves,
    ## and a float read as an integer word or the reverse moves its bits across.
    mutating func register_move(target_reg: str, from_reg: str, cls: ir.Class, code: u8) -> !:
        let to_xmm = target_reg.bytes[1] == 'x'
        let from_xmm = from_reg.bytes[1] == 'x'
        if to_xmm and from_xmm:
            try self.line4("movdqa " if cls == ir.Class.v else ("movaps " if cls == ir.Class.s else "movapd "), from_reg, ", ", target_reg)
        elif not to_xmm and not from_xmm:
            try self.line4("movl " if cls == ir.Class.w else "movq ", from_reg, ", ", target_reg)
        else:
            try self.line4("movd " if cls == ir.Class.w or cls == ir.Class.s or cls == ir.Class.h else "movq ", from_reg, ", ", target_reg)
        discard(code)

    ## An operand into a register of class `cls`.
    mutating func operand(reg: str, cls: ir.Class, r: ir.Ref) -> !:
        if r.kind == ir.RefKind.temp:
            try self.load_temp(reg, cls, r.index)
            return
        if r.kind == ir.RefKind.constant:
            if ir.is_float_class(cls):
                if cls == ir.Class.d:
                    try self.load_immediate("%rax", r.value)
                    try self.line3("movq %rax, ", reg, "")
                else:
                    try self.load_immediate("%eax", r.value)
                    try self.line3("movd %eax, ", reg, "")
                return
            try self.load_immediate(reg, r.value)
            return
        try self.address_operand(wide_name(reg), r)

    ## The address a slot, global, function, or text refers to, into a 64-bit register.
    mutating func address_operand(reg: str, r: ir.Ref) -> !:
        if r.kind == ir.RefKind.slot:
            try self.frame_address(reg, self.slot_home(r.index))
        elif r.kind == ir.RefKind.global and r.value == 0:
            try self.line("leaq ")
            try self.symbol(r.name)
            try self.put("(%rip), ")
            try self.put(reg)
        elif r.kind == ir.RefKind.global or r.kind == ir.RefKind.function:
            # a function's address, or another image's data (`import_ref`), goes through the
            # GOT, so a symbol defined in a linked shared object resolves
            try self.line("leaq " if self.os == build_target.Os.windows else "movq ")
            try self.symbol(r.name)
            try self.put("(%rip), " if self.os == build_target.Os.windows else "@GOTPCREL(%rip), ")
            try self.put(reg)
        elif r.kind == ir.RefKind.text:
            try self.line("leaq ")
            try self.text_label(r.index)
            try self.put("(%rip), ")
            try self.put(reg)
        elif r.kind == ir.RefKind.temp:
            try self.load_temp(reg, ir.Class.l, r.index)
        elif r.kind == ir.RefKind.constant:
            try self.load_immediate(reg, r.value)
        else:
            try self.line3("movq $0, ", reg, "")

    # mark: Functions ==========================================================================

    ## Copy `size` bytes from (%r10) to (%r11) with plain loads and stores: 16 at a time
    ## through an SSE register, then 8, 4, 2, 1. Unaligned access is fine on this target.
    mutating func inline_copy(size: u64) -> !:
        var done: u64 = 0
        while size - done >= 16:
            try self.offset_move("movups ", done, "(%r10), %xmm8")
            try self.line("movups %xmm8, ")
            try self.put_u64(done)
            try self.put("(%r11)")
            done += 16
        let widths: u64[4] = [8, 4, 2, 1]
        let loads: str[4] = ["movq ", "movl ", "movzwl ", "movzbl "]
        let load_regs: str[4] = ["(%r10), %rax", "(%r10), %eax", "(%r10), %eax", "(%r10), %eax"]
        let stores: str[4] = ["movq %rax, ", "movl %eax, ", "movw %ax, ", "movb %al, "]
        var k: usize = 0
        while k < 4:
            if size - done >= widths[k]:
                try self.offset_move(loads[k], done, load_regs[k])
                try self.line(stores[k])
                try self.put_u64(done)
                try self.put("(%r11)")
                done += widths[k]
            k += 1

    ## Zero `size` bytes at (%r11) the same way.
    mutating func inline_zero(size: u64) -> !:
        var done: u64 = 0
        if size >= 16:
            try self.line("pxor %xmm8, %xmm8")
        while size - done >= 16:
            try self.line("movups %xmm8, ")
            try self.put_u64(done)
            try self.put("(%r11)")
            done += 16
        let widths: u64[4] = [8, 4, 2, 1]
        let stores: str[4] = ["movq $0, ", "movl $0, ", "movw $0, ", "movb $0, "]
        var k: usize = 0
        while k < 4:
            if size - done >= widths[k]:
                try self.line(stores[k])
                try self.put_u64(done)
                try self.put("(%r11)")
                done += widths[k]
            k += 1

    ## `mnemonic` + offset + `rest`: one line of a copy.
    mutating func offset_move(mnemonic: str, offset: u64, rest: str) -> !:
        try self.line(mnemonic)
        try self.put_u64(offset)
        try self.put(rest)

    ## The promoted slot an address reference reaches, 1-based, or 0.
    func promoted_address(r: ir.Ref) -> u32:
        let k = self.fr.slot_of(r)
        if k == 0 or self.fr.slot_regs.get((usize)k - 1) == 0:
            return 0
        return k

    ## A load from a promoted slot: the register, extended as the load would extend from
    ## memory, since a narrow store leaves the register's upper bits as they were.
    mutating func load_promoted(op: ir.Op, k: u32, d: str) -> !:
        let code = (usize)self.fr.slot_regs.get((usize)k - 1)
        let q = q_names[code]
        let l = l_names[code]
        match op:
            .loadl:
                if d != q:
                    try self.line4("movq ", q, ", ", d)
            .loaduw:
                if d != l:
                    try self.line4("movl ", l, ", ", d)
            .loadsw: try self.line4("movslq ", l, ", ", d)
            .loadub: try self.line4("movzbl ", b_names[code], ", ", d)
            .loadsb: try self.line4("movsbl ", b_names[code], ", ", d)
            .loaduh: try self.line4("movzwl ", w_names[code], ", ", d)
            .loadsh: try self.line4("movswl ", w_names[code], ", ", d)
            _:
                error(failed, "a float load from a promoted slot")

    ## A store into a promoted slot: the value's register `v` moves in.
    mutating func store_promoted(op: ir.Op, k: u32, v: str) -> !:
        let code = (usize)self.fr.slot_regs.get((usize)k - 1)
        match op:
            .storel:
                if v != q_names[code]:
                    try self.line4("movq ", v, ", ", q_names[code])
            .storew:
                if v != l_names[code]:
                    try self.line4("movl ", v, ", ", l_names[code])
            .storeh: try self.line4("movw ", word_name(v), ", ", w_names[code])
            .storeb: try self.line4("movb ", byte_name(v), ", ", b_names[code])
            _:
                error(failed, "a float store into a promoted slot")

    ## `.weak` for a weak symbol (§9.8); ELF has no directive for `used`, which only matters
    ## to a linker that discards sections, so it is left to the section's own flags.
    mutating func linkage_directives(name: str, weak: bool, used: bool) -> !:
        if weak and self.os != build_target.Os.windows:
            try self.put("    .weak ")
            try self.symbol(name)
            try self.put("\n")
        discard(used)

    ## Back to the text section after a function placed in a named one.
    mutating func leave_section() -> !:
        if self.f.section.length > 0 or (self.os == build_target.Os.windows and self.f.weak):
            try self.put("\n    .text\n")

    mutating func function(index: usize) -> !:
        self.index = index
        if let dw = self.dw:
            try dw.entry(&self.out)
        self.f = &self.program_unit.functions.items[index]
        try self.fr.plan(self.f)
        try self.fr.layout(self.f, 176 if self.os == build_target.Os.windows else 0, self.f.has_result and self.in_memory(self.f.result_size, self.f.result_shape))
        if self.os == build_target.Os.windows and self.f.weak:
            try self.put("\n    .section .text$")
            try self.symbol(self.f.name)
            try self.put(",\"xr\"")
        elif self.f.section.length > 0:
            try self.put("\n    .section ")
            try self.put(build_target.section_name(self.f.section, true, self.os))
            try self.put(",\"xr\"" if self.os == build_target.Os.windows else ",\"ax\",@progbits")
        try self.put("\n    .p2align 4\n")
        try self.put("    .globl ")
        try self.symbol(self.f.name)
        if self.os != build_target.Os.windows:
            try self.put("\n    .type ")
            try self.symbol(self.f.name)
            try self.put(", @function")
        try self.put("\n")
        try self.linkage_directives(self.f.name, self.f.weak, self.f.used)
        try self.symbol(self.f.name)
        try self.put(":")
        if self.f.naked:
            # the body is asm blocks only (§9.8): no frame, no prologue, nothing after
            var k: usize = 0
            while k < self.f.instrs.count:
                self.at = k
                try self.instruction(self.f.instrs.get(k))
                k += 1
            try self.leave_section()
            return
        if self.dw != none:
            try self.line(".cfi_startproc")
        if self.os == build_target.Os.windows:
            try self.line(".seh_proc ")
            try self.symbol(self.f.name)
        try self.line("pushq %rbp")
        if self.os == build_target.Os.windows:
            try self.line(".seh_pushreg %rbp")
        if self.dw != none:
            try self.line(".cfi_def_cfa_offset 16")
            try self.line(".cfi_offset 6, -16")
        if self.os != build_target.Os.windows:
            try self.line("movq %rsp, %rbp")
        if self.dw != none:
            try self.line(".cfi_def_cfa_register 6")
        if self.os == build_target.Os.windows and self.fr.size >= 4096:
            try self.load_immediate("%rax", (i64)self.fr.size)
            try self.line("call ___chkstk_ms")
        if self.fr.size > 0:
            try self.line("subq $")
            try self.put_u64(self.fr.size)
            try self.put(", %rsp")
            if self.os == build_target.Os.windows:
                try self.line(".seh_stackalloc ")
                try self.put_u64(self.fr.size)
        if self.os == build_target.Os.windows:
            try self.line("movq %rsp, %rbp")
            try self.line(".seh_setframe %rbp, 0")
        if self.f.has_result and self.in_memory(self.f.result_size, self.f.result_shape):
            try self.line("movq %rcx, " if self.os == build_target.Os.windows else "movq %rdi, ")
            try self.frame_operand(self.fr.indirect_home)
        try self.save_callee_saved()
        if self.os == build_target.Os.windows:
            try self.line(".seh_endprologue")
        try self.receive_params()
        var uses = try selection.uses(self.f)
        defer free(uses)
        var i: usize = 0
        while i < self.f.instrs.count:
            self.at = i
            if let dw = self.dw:
                try dw.mark(&self.out, self.f, index, i)
            if selection.branch(self.f, i, uses):
                let branch = self.f.instrs.get(i + 1)
                var comparison = self.f.instrs.get(i)
                let next = selection.label_at(self.f, i + 2)
                if next == branch.extra:
                    comparison.op = selection.inverse(comparison.op)
                try self.comparison(comparison, branch, next)
                i += 2
                continue
            try self.instruction(self.f.instrs.get(i), selection.label_at(self.f, i + 1))
            i += 1
        if let dw = self.dw:
            try dw.mark(&self.out, self.f, index, i)
            if self.f.debug:
                try self.put("\nLdw_end_")
                try self.put_u64((u64)index)
                try self.put(":\n")
            try self.line(".cfi_endproc")
            try dw.function(self.f, &self.fr, index)
        if self.os == build_target.Os.windows:
            try self.line(".seh_endproc")
        try self.put("\n")
        if self.f.debug:
            try self.describe_frame()
        try self.leave_section()

    ## `lbd_<name>`: the function's name and source, then each named local's name, type
    ## spelling, distance below the frame pointer, and size; every text is a `str`.
    mutating func describe_frame() -> !:
        var d = &self.descriptors
        try d.put("    .globl ")
        try d.put(self.symbol_prefix)
        try d.put("lbd_")
        try d.put(self.f.name)
        try d.put("\n")
        try d.put(self.symbol_prefix)
        try d.put("lbd_")
        try d.put(self.f.name)
        try d.put(":\n")
        try self.describe_text(self.f.name)
        try self.describe_text(self.f.source)
        try d.put("    .quad ")
        try d.put_u64((u64)self.f.locals.count)
        try d.put("\n")
        var i: usize = 0
        while i < self.f.locals.count:
            let described = self.f.locals.get(i)
            try self.describe_text(described.name)
            try self.describe_text(described.kind)
            try d.put("    .quad ")
            try d.put_u64(self.slot_home(described.slot))
            try d.put(", ")
            try d.put_u64((u64)described.size)
            try d.put("\n")
            i += 1

    mutating func describe_text(text: str) -> !:
        let index = try self.program_unit.text(text)
        var d = &self.descriptors
        try d.put("    .quad .Ltext_")
        try d.put_u64((u64)index)
        try d.put(", ")
        try d.put_u64((u64)text.length)
        try d.put("\n")

    # mark: Eightbytes =========================================================================

    ## Classify an argument or result of `size` bytes: bit k of the answer is set when
    ## eightbyte k takes an SSE register. A scalar is its own class; an aggregate carries the
    ## lowerer's classification of its first sixteen bytes.
    ## Which of an argument's first two eightbytes take SSE registers (System V §3.2.3):
    ## bit k is set when a float leaf covers eightbyte k and no integer leaf touches it.
    ## A scalar is its own class; an aggregate without a shape is opaque bytes, INTEGER.
    ## Whether an aggregate of `size` bytes with `shape` is passed and returned in memory
    ## (System V §3.2.3): over sixteen bytes, or holding a field that is not aligned to its
    ## own size, which a packed record has and which the ABI classes MEMORY at any size.
    func in_memory(size: u32, shape: u32) -> bool:
        if self.os == build_target.Os.windows:
            return size != 0 and size != 1 and size != 2 and size != 4 and size != 8
        if size > 16:
            return true
        if size == 0 or shape == 0:
            return false
        return has_unaligned_leaf(self.program_unit.leaves_of(shape))

    func sse_of(cls: ir.Class, size: u32, shape: u32) -> u8:
        if size == 0:
            return 1 if ir.is_float_class(cls) else 0
        if shape == 0 or self.os == build_target.Os.windows:
            return 0
        var words: u8 = 3 if size > 8 else 1
        for leaf in self.program_unit.leaves_of(shape):
            if ir.is_float_class(leaf.cls):
                continue
            var k = (u64)leaf.offset // 8
            let last = ((u64)leaf.offset + (u64)leaf.size - 1) // 8
            while k <= last and k < 2:
                words = words & ~(u8)(1 << k)
                k += 1
        return words

    ## Exactly `width` bytes (1..8) at `offset(base)` into the 64-bit register `reg`, zero
    ## above; `%r11` helps with the odd widths.
    mutating func load_bytes(reg: str, base: str, offset: u64, width: u64) -> !:
        let l = narrow_name(reg)
        if width == 8:
            try self.offset_move("movq ", offset, "(")
            try self.put(base)
            try self.put("), ")
            try self.put(reg)
            return
        if width == 4 or width == 2 or width == 1:
            try self.offset_move("movl " if width == 4 else ("movzwl " if width == 2 else "movzbl "), offset, "(")
            try self.put(base)
            try self.put("), ")
            try self.put(l)
            return
        # 3, 5, 6, 7: the low part, then the rest shifted into place
        let low: u64 = 4 if width > 4 else 2
        try self.load_bytes("%r11", base, offset + low, width - low)
        try self.load_bytes(reg, base, offset, low)
        try self.line("shlq $")
        try self.put_u64(low * 8)
        try self.put(", %r11")
        try self.line3("orq %r11, ", reg, "")

    ## Exactly `width` bytes of the 64-bit register `reg` to `offset(base)`; the register is
    ## consumed.
    mutating func store_bytes(reg: str, base: str, offset: u64, width: u64) -> !:
        if width == 8 or width == 4 or width == 2 or width == 1:
            try self.line(store_word_mnemonic(width))
            try self.put(register_of_width(reg, width))
            try self.put(", ")
            try self.put_u64(offset)
            try self.put("(")
            try self.put(base)
            try self.put(")")
            return
        let low: u64 = 4 if width > 4 else 2
        try self.store_bytes(reg, base, offset, low)
        try self.line("shrq $")
        try self.put_u64(low * 8)
        try self.put(", ")
        try self.put(reg)
        try self.store_bytes(reg, base, offset + low, width - low)

    ## Eightbyte `k` of an aggregate of `size` bytes at (%r10), into `reg`: an integer
    ## register, or an SSE one through rax.
    mutating func load_eightbyte(reg: str, k: u32, size: u32, sse: bool) -> !:
        let offset = (u64)k * 8
        let width = (u64)size - offset if (u64)size - offset < 8 else 8
        if sse:
            if width == 8 or width == 4:
                # A preceding INTEGER result may already be in rax. Loading an SSE
                # eightbyte must not overwrite that other half of a mixed return.
                try self.offset_move("movq " if width == 8 else "movd ", offset, "(%r10), ")
                try self.put(reg)
            else:
                try self.line("movq %rax, %xmm9")
                try self.load_bytes("%rax", "%r10", offset, width)
                try self.line3("movq %rax, ", reg, "")
                try self.line("movq %xmm9, %rax")
        else:
            try self.load_bytes(reg, "%r10", offset, width)

    ## Eightbyte `k` of an aggregate of `size` bytes, from `reg` to (%r10).
    mutating func store_eightbyte(reg: str, k: u32, size: u32, sse: bool) -> !:
        let offset = (u64)k * 8
        let width = (u64)size - offset if (u64)size - offset < 8 else 8
        if sse:
            # rax may hold the INTEGER half of a mixed SSE/INTEGER return.
            # Store common widths directly; use non-ABI scratch for short tails.
            if width == 8 or width == 4:
                try self.line3("movq " if width == 8 else "movd ", reg, ", ")
                try self.put_u64(offset)
                try self.put("(%r10)")
            else:
                try self.line3("movq ", reg, ", %r11")
                try self.store_bytes("%r11", "%r10", offset, width)
        else:
            try self.store_bytes(reg, "%r10", offset, width)

    ## Store the incoming arguments into their slots.
    mutating func receive_params() -> !:
        if self.os == build_target.Os.windows:
            try self.receive_windows()
            return
        var next_int: u32 = 1 if self.f.has_result and self.in_memory(self.f.result_size, self.f.result_shape) else 0
        var next_float: u32 = 0
        var stack_offset: u64 = 16
        var i: usize = 0
        while i < self.f.params.count:
            let p = self.f.params.get(i)
            let home = self.slot_home(p.slot)
            if p.size == 0:
                let code = (usize)self.fr.slot_regs.get((usize)p.slot)
                if ir.is_float_class(p.cls):
                    if next_float < 8:
                        if p.cls == ir.Class.h:
                            try self.line2("movd ", float_argument_names[(usize)next_float])
                            try self.put(", %eax")
                            try self.line("movw %ax, ")
                            try self.frame_operand(home)
                        else:
                            try self.frame_store(float_argument_names[(usize)next_float], p.cls, home)
                        next_float += 1
                    else:
                        try self.stack_param_load("%rax", stack_offset)
                        try self.line(store_word_mnemonic(2 if p.cls == ir.Class.h else (4 if p.cls == ir.Class.s else 8)))
                        try self.put(register_of_width("%rax", 2 if p.cls == ir.Class.h else (4 if p.cls == ir.Class.s else 8)))
                        try self.put(", ")
                        try self.frame_operand(home)
                        stack_offset += 8
                elif next_int < 6:
                    let source_name = argument_names[(usize)next_int] if p.cls == ir.Class.l else narrow_name(argument_names[(usize)next_int])
                    if code != 0:
                        try self.line4("movq " if p.cls == ir.Class.l else "movl ", source_name, ", ", class_name((u8)code, p.cls))
                    else:
                        try self.frame_store(source_name, p.cls, home)
                    next_int += 1
                else:
                    try self.stack_param_load("%rax", stack_offset)
                    if code != 0:
                        try self.line4("movq " if p.cls == ir.Class.l else "movl ", "%rax" if p.cls == ir.Class.l else "%eax", ", ", class_name((u8)code, p.cls))
                    else:
                        try self.frame_store("%rax" if p.cls == ir.Class.l else "%eax", p.cls, home)
                    stack_offset += 8
            else:
                let sse = self.sse_of(p.cls, p.size, p.shape)
                let words: u32 = 2 if p.size > 8 else 1
                let sse_count = count_bits(sse)
                let int_count = words - sse_count
                if not self.in_memory(p.size, p.shape) and next_int + int_count <= 6 and next_float + sse_count <= 8:
                    try self.frame_address("%r10", home)
                    var k: u32 = 0
                    while k < words:
                        if (sse & (u8)(1 << k)) != 0:
                            try self.store_eightbyte(float_argument_names[(usize)next_float], k, p.size, true)
                            next_float += 1
                        else:
                            try self.store_eightbyte(argument_names[(usize)next_int], k, p.size, false)
                            next_int += 1
                        k += 1
                else:
                    # copied from the caller's stack area in a second pass, after every
                    # register is safely stored
                    stack_offset += round_up((u64)p.size, 8)
            i += 1
        stack_offset = 16
        next_int = 1 if self.f.has_result and self.in_memory(self.f.result_size, self.f.result_shape) else 0
        next_float = 0
        i = 0
        while i < self.f.params.count:
            let p = self.f.params.get(i)
            if p.size == 0:
                if ir.is_float_class(p.cls):
                    if next_float < 8:
                        next_float += 1
                    else:
                        stack_offset += 8
                elif next_int < 6:
                    next_int += 1
                else:
                    stack_offset += 8
            else:
                let sse = self.sse_of(p.cls, p.size, p.shape)
                let words: u32 = 2 if p.size > 8 else 1
                let sse_count = count_bits(sse)
                let int_count = words - sse_count
                if not self.in_memory(p.size, p.shape) and next_int + int_count <= 6 and next_float + sse_count <= 8:
                    next_int += int_count
                    next_float += sse_count
                else:
                    try self.line("leaq ")
                    try self.put_u64(stack_offset)
                    try self.put("(%rbp), %r10")
                    try self.frame_address("%r11", self.slot_home(p.slot))
                    try self.copy_r10_to_r11((u64)p.size)
                    stack_offset += round_up((u64)p.size, 8)
            i += 1

    mutating func stack_param_load(reg: str, offset: u64) -> !:
        try self.line("movq ")
        try self.put_u64(offset + (self.fr.size if self.os == build_target.Os.windows else 0))
        try self.put("(%rbp), ")
        try self.put(reg)

    ## `size` bytes from (%r10) to (%r11): inline up to 128, else `memcpy`.
    mutating func copy_r10_to_r11(size: u64) -> !:
        if size <= 128:
            try self.inline_copy(size)
            return
        try self.line("movq %r11, %rdi")
        try self.line("movq %r10, %rsi")
        try self.load_immediate("%rdx", (i64)size)
        try self.call_symbol("memcpy")

    mutating func call_symbol(name: str) -> !:
        if self.os == build_target.Os.windows:
            # Generator helpers use at most three integer arguments in SysV scratch names.
            try self.line("movq %rdx, %r8")
            try self.line("movq %rsi, %rdx")
            try self.line("movq %rdi, %rcx")
            try self.line("subq $32, %rsp")
        try self.line("call ")
        try self.symbol(name)
        if self.os == build_target.Os.windows:
            try self.line("addq $32, %rsp")
        else:
            try self.put("@PLT")

    # mark: Instructions =======================================================================

    mutating func instruction(n: ir.Instr, next_label: u32 = 0) -> !:
        match n.op:
            .label:
                try self.put("\n")
                try self.label_name(n.extra)
                try self.put(":")
            .jmp:
                if n.extra == next_label:
                    return
                try self.line("jmp ")
                try self.label_name(n.extra)
            .jnz:
                let cls = ir.Class.l if n.cls == ir.Class.l else ir.Class.w
                let c = try self.source(n.a, cls, self.reg(cls, 0))
                try self.line5("testq " if cls == ir.Class.l else "testl ", c, ", ", c, "")
                try self.line("jne ")
                try self.label_name(n.extra)
                try self.line("jmp ")
                try self.label_name(n.extra2)
            .ret:
                try self.return_value(n)
            .copy:
                if n.cls == ir.Class.v:
                    let value = try self.source(n.a, ir.Class.v, "%xmm8")
                    let d = self.target(n.dst, ir.Class.v, "%xmm8")
                    if value != d:
                        try self.line4("movdqa ", value, ", ", d)
                    try self.finish(n.dst, ir.Class.v, d)
                    return
                let v = try self.source(n.a, n.cls, self.reg(n.cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                if v != d:
                    try self.line4(register_move(n.cls), v, ", ", d)
                try self.finish(n.dst, n.cls, d)
            .add, .sub, .mul, .sdiv, .udiv, .srem, .urem, .and_, .or_, .xor, .shl, .lshr, .ashr:
                if ir.is_float_class(n.cls):
                    try self.float_arithmetic(n)
                else:
                    try self.arithmetic(n)
            .neg:
                try self.negate(n)
            .ceq, .cne, .cslt, .csle, .csgt, .csge, .cult, .cule, .cugt, .cuge:
                if ir.is_float_class(n.cls):
                    try self.float_comparison(n)
                else:
                    try self.comparison(n)
            .loadsb, .loadub, .loadsh, .loaduh, .loadsw, .loaduw, .loadl, .loads, .loadd, .loadhf:
                let lc = load_class(n.op)
                let d = self.target(n.dst, lc, self.reg(lc, 0))
                let from_slot = self.promoted_address(n.a)
                if from_slot != 0:
                    try self.load_promoted(n.op, from_slot, d)
                else:
                    try self.address_operand("%r10", n.a)
                    if n.op == ir.Op.loadhf:
                        try self.line("movzwl (%r10), %eax")
                        try self.line3("movd %eax, ", d, "")
                    else:
                        try self.line4(load_mnemonic(n.op), "(%r10), ", d, "")
                try self.finish(n.dst, lc, d)
            .storeb, .storeh, .storew, .storel, .stores, .stored, .storehf:
                let cls = store_class(n.op)
                let v = try self.source(n.a, cls, self.reg(cls, 0))
                let to_slot = self.promoted_address(n.b)
                if to_slot != 0:
                    try self.store_promoted(n.op, to_slot, v)
                else:
                    try self.address_operand("%r10", n.b)
                    if n.op == ir.Op.storehf:
                        try self.line3("movd ", v, ", %eax")
                        try self.line("movw %ax, (%r10)")
                    elif n.op == ir.Op.storeb:
                        try self.line3("movb ", byte_name(v), ", (%r10)")
                    elif n.op == ir.Op.storeh:
                        try self.line3("movw ", word_name(v), ", (%r10)")
                    else:
                        try self.line3(store_mnemonic(n.op), v, ", (%r10)")
            .frame:
                let d = self.target(n.dst, ir.Class.l, "%rax")
                if self.os == build_target.Os.windows:
                    try self.frame_address(d, 0)
                else:
                    try self.line3("movq %rbp, ", d, "")
                try self.finish(n.dst, ir.Class.l, d)
            .extsb, .extub, .extsh, .extuh, .extsw, .extuw:
                let v = try self.source(n.a, ir.Class.w, "%eax")
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.extend_from(n.op, n.cls, v, d)
                try self.finish(n.dst, n.cls, d)
            .exth, .exts, .truncs, .truncd:
                try self.float_convert(n)
            .stosi, .stoui, .dtosi, .dtoui:
                try self.float_to_int(n)
            .swtof, .uwtof, .sltof, .ultof:
                try self.int_to_float(n)
            .cast:
                # bits move between an integer and a float of the same width
                let other = cast_partner(n.cls)
                let v = try self.source(n.a, other, self.reg(other, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line4("movq " if n.cls == ir.Class.d or n.cls == ir.Class.l else "movd ", v, ", ", d)
                try self.finish(n.dst, n.cls, d)
            .addr:
                if self.fr.promoted_slot(n.dst) == 0:
                    let d = self.target(n.dst, ir.Class.l, "%rax")
                    try self.address_operand(d, n.a)
                    try self.finish(n.dst, ir.Class.l, d)
            .addr_tls:
                # the initial-exec model: the thread pointer plus the variable's offset in
                # the static thread block, which the linker writes into the GOT
                if self.os == build_target.Os.windows:
                    try self.line("movl _tls_index(%rip), %eax")
                    try self.line("movq %gs:88, %r11")
                    try self.line("movq (%r11,%rax,8), %rax")
                    try self.line("leaq ")
                    try self.symbol(n.a.name)
                    try self.put("@SECREL32(%rax), %rax")
                else:
                    try self.line("movq %fs:0, %rax")
                    try self.line("addq ")
                    try self.symbol(n.a.name)
                    try self.put("@GOTTPOFF(%rip), %rax")
                try self.store_temp("%rax", ir.Class.l, n.dst)
            .blit:
                if n.extra <= 128:
                    try self.address_operand("%r10", n.b)
                    try self.address_operand("%r11", n.a)
                    try self.inline_copy((u64)n.extra)
                else:
                    try self.address_operand("%rdi", n.a)
                    try self.address_operand("%rsi", n.b)
                    try self.load_immediate("%rdx", (i64)n.extra)
                    try self.call_symbol("memcpy")
            .zero:
                if n.extra <= 128:
                    try self.address_operand("%r11", n.a)
                    try self.inline_zero((u64)n.extra)
                else:
                    try self.address_operand("%rdi", n.a)
                    try self.line("xorl %esi, %esi")
                    try self.load_immediate("%rdx", (i64)n.extra)
                    try self.call_symbol("memset")
            .fill:
                try self.address_operand("%rdi", n.a)
                try self.load_immediate("%esi", n.b.value)
                try self.load_immediate("%rdx", (i64)n.extra)
                try self.call_symbol("memset")
            .call:
                try self.call(n)
            .trap_:
                if n.b.kind == ir.RefKind.text:
                    # the position first, then the reason (§11.5)
                    try self.address_operand("%rdi", n.b)
                    try self.address_operand("%rsi", n.a)
                    try self.call_symbol(self.program_unit.trap_at_function)
                else:
                    try self.address_operand("%rdi", n.a)
                    try self.call_symbol(self.program_unit.trap_function)
            .bounds:
                let a = try self.source(n.a, ir.Class.l, "%rax")
                let b = try self.source(n.b, ir.Class.l, "%rcx")
                try self.line4("cmpq ", b, ", ", a)
                try self.line("jb 1f")
                try self.trap_text("index out of bounds", n.extra2)
                try self.put("\n1:")
            .addo, .subo, .mulo:
                try self.checked(n)
            .asm_:
                try self.inline_asm(n)
            .set_reg:
                # move an input operand into the exact register the asm block names
                let reg = with_percent(self.program_unit.texts.get((usize)n.b.index).bytes)
                try self.operand(reg, n.cls, n.a)
            .get_reg:
                # the outputs of an asm block are stored by `inline_asm`, which follows the
                # block's operands on both sides
                discard(n.cls)
            .atomic_load:
                # every aligned load is acquire on this target; the fence is for sequential
                # consistency against stores, which `atomic_store` supplies with `xchg`
                let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
                try self.address_operand("%r10", n.a)
                try self.line4(zero_extending_load(n.extra), "(%r10), ", self.reg(cls, 0), "")
                try self.store_temp(self.reg(cls, 0), cls, n.dst)
            .atomic_store:
                let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
                try self.operand(self.reg(cls, 0), cls, n.a)
                try self.address_operand("%r10", n.b)
                try self.line("xchg" if n.extra2 >= 5 else "mov")
                try self.put(width_suffix(n.extra))
                try self.put(" ")
                try self.put(register_of_width("%rax", (u64)n.extra))
                try self.put(", (%r10)")
            .atomic_add, .atomic_sub, .atomic_or, .atomic_and_not, .atomic_xor, .atomic_swap, .atomic_max, .atomic_min:
                try self.read_modify_write(n)
            .atomic_cas:
                try self.compare_and_swap(n)
            .fence:
                try self.line("mfence")
            .loadv, .storev, .vadd, .vsub, .vmul, .vdiv, .vand, .vor, .vxor, .vneg, .vnot, .vaddw, .vsubw, .vmulw, .vaddo, .vsubo, .vadds, .vsubs, .vshl, .vshr, .vsplat:
                try self.vector(n)
            _:
                error(failed, "an instruction the x86_64 generator does not know")

    ## `d = a op b` on the integer classes: the value into `d`, then the two-operand form.
    mutating func arithmetic(n: ir.Instr) -> !:
        let cls = n.cls
        let suffix = "q" if cls == ir.Class.l else "l"
        if n.op == ir.Op.sdiv or n.op == ir.Op.udiv or n.op == ir.Op.srem or n.op == ir.Op.urem:
            # the dividend in rax (and rdx), the divisor anywhere else
            let b = try self.source(n.b, cls, self.reg(cls, 1))
            try self.operand(self.reg(cls, 0), cls, n.a)
            if n.op == ir.Op.sdiv or n.op == ir.Op.srem:
                try self.line("cqto" if cls == ir.Class.l else "cltd")
                try self.line3("idiv", suffix, " ")
            else:
                try self.line("xorl %edx, %edx")
                try self.line3("div", suffix, " ")
            try self.put(b)
            let quotient = self.reg(cls, 0) if n.op == ir.Op.sdiv or n.op == ir.Op.udiv else self.reg(cls, 2)
            let d = self.target(n.dst, cls, self.reg(cls, 0))
            if d != quotient:
                try self.line4("mov", suffix, " ", quotient)
                try self.put(", ")
                try self.put(d)
            try self.finish(n.dst, cls, d)
            return
        if n.op == ir.Op.shl or n.op == ir.Op.lshr or n.op == ir.Op.ashr:
            # the count lives in cl
            try self.operand(self.reg(cls, 1), cls, n.b)
            let a = try self.source(n.a, cls, self.reg(cls, 0))
            let d = self.target(n.dst, cls, self.reg(cls, 0))
            if a != d:
                try self.line4("mov", suffix, " ", a)
                try self.put(", ")
                try self.put(d)
            try self.line("shl" if n.op == ir.Op.shl else ("shr" if n.op == ir.Op.lshr else "sar"))
            try self.put(suffix)
            try self.put(" %cl, ")
            try self.put(d)
            try self.finish(n.dst, cls, d)
            return
        let a = try self.source(n.a, cls, self.reg(cls, 0))
        var b = try self.source(n.b, cls, self.reg(cls, 1))
        let d = self.target(n.dst, cls, self.reg(cls, 0))
        # A dying RHS may share the destination. Preserve it before installing the
        # LHS: x86's destructive two-operand form must not turn a+b into a+a.
        if b == d and a != d:
            try self.line4("mov", suffix, " ", b)
            try self.put(", ")
            try self.put(self.reg(cls, 1))
            b = self.reg(cls, 1)
        if a != d:
            try self.line4("mov", suffix, " ", a)
            try self.put(", ")
            try self.put(d)
        var mnemonic = "add"
        match n.op:
            .add: mnemonic = "add"
            .sub: mnemonic = "sub"
            .mul: mnemonic = "imul"
            .and_: mnemonic = "and"
            .or_: mnemonic = "or"
            .xor: mnemonic = "xor"
            _: mnemonic = "add"
        try self.line4(mnemonic, suffix, " ", b)
        try self.put(", ")
        try self.put(d)
        try self.finish(n.dst, cls, d)

    ## Float arithmetic: singles and doubles directly, halves through single precision.
    mutating func float_arithmetic(n: ir.Instr) -> !:
        let cls = n.cls
        let a = try self.source(n.a, cls, self.reg(cls, 0))
        let b = try self.source(n.b, cls, self.reg(cls, 1))
        let d = self.reg(cls, 0)
        if cls == ir.Class.h:
            if a != d:
                try self.line4("movaps ", a, ", ", d)
            try self.widen_half(d)
            if b != self.reg(cls, 1):
                try self.line4("movaps ", b, ", ", self.reg(cls, 1))
            try self.widen_half(self.reg(cls, 1))
        elif a != d:
            try self.line4("movaps ", a, ", ", d)
        var mnemonic = "add"
        match n.op:
            .add: mnemonic = "add"
            .sub: mnemonic = "sub"
            .mul: mnemonic = "mul"
            .sdiv: mnemonic = "div"
            _: mnemonic = "add"
        try self.line(mnemonic)
        try self.put("sd " if cls == ir.Class.d else "ss ")
        try self.put(self.reg(cls, 1) if cls == ir.Class.h else b)
        try self.put(", ")
        try self.put(d)
        if cls == ir.Class.h:
            try self.round_to_half(d)
        try self.finish(n.dst, cls, d)

    ## The single in `reg` rounded to a half in its low sixteen bits, zero above, so that a
    ## reinterpretation of the bits as an integer reads the half alone: F16C from
    ## x86-64-v3, the unit's own routine below it.
    mutating func round_to_half(reg: str) -> !:
        try self.line3("movd ", reg, ", %eax")
        if self.level >= 3:
            try self.line4("vcvtps2ph $0, ", reg, ", ", reg)
            try self.line3("movd ", reg, ", %eax")
            try self.line("movzwl %ax, %eax")
        else:
            self.half_routines = true
            try self.line("call .Llb_single_to_half")
        try self.line3("movd %eax, ", reg, "")

    ## The half in the low sixteen bits of `reg` widened to a single, in place.
    mutating func widen_half(reg: str) -> !:
        if self.level >= 3:
            try self.line4("vcvtph2ps ", reg, ", ", reg)
            return
        self.half_routines = true
        try self.line3("movd ", reg, ", %eax")
        try self.line("call .Llb_half_to_single")
        try self.line3("movd %eax, ", reg, "")

    mutating func negate(n: ir.Instr) -> !:
        let cls = n.cls
        let v = try self.source(n.a, cls, self.reg(cls, 0))
        let d = self.target(n.dst, cls, self.reg(cls, 0))
        if cls == ir.Class.w or cls == ir.Class.l:
            if v != d:
                try self.line4("movq " if cls == ir.Class.l else "movl ", v, ", ", d)
            try self.line3("negq " if cls == ir.Class.l else "negl ", d, "")
        elif cls == ir.Class.d:
            try self.line3("movq ", v, ", %rax")
            try self.line("btcq $63, %rax")
            try self.line3("movq %rax, ", d, "")
        else:
            try self.line3("movd ", v, ", %eax")
            try self.line("xorl $32768, %eax" if cls == ir.Class.h else "xorl $2147483648, %eax")
            try self.line3("movd %eax, ", d, "")
        try self.finish(n.dst, cls, d)

    mutating func comparison(n: ir.Instr, branch: ir.Instr? = none, next_label: u32 = 0) -> !:
        let cls = n.cls
        let a = try self.source(n.a, cls, self.reg(cls, 0))
        let b = try self.source(n.b, cls, self.reg(cls, 1))
        try self.line4("cmpq " if cls == ir.Class.l else "cmpl ", b, ", ", a)
        var cond = "e"
        match n.op:
            .ceq: cond = "e"
            .cne: cond = "ne"
            .cslt: cond = "l"
            .csle: cond = "le"
            .csgt: cond = "g"
            .csge: cond = "ge"
            .cult: cond = "b"
            .cule: cond = "be"
            .cugt: cond = "a"
            .cuge: cond = "ae"
            _: cond = "e"
        if let jump = branch:
            try self.line("j")
            try self.put(cond)
            try self.put(" ")
            try self.label_name(jump.extra2 if next_label == jump.extra else jump.extra)
            if next_label != jump.extra and next_label != jump.extra2:
                try self.line("jmp ")
                try self.label_name(jump.extra2)
            return
        try self.line3("set", cond, " %al")
        let d = self.target(n.dst, ir.Class.w, "%eax")
        try self.line3("movzbl %al, ", d, "")
        try self.finish(n.dst, ir.Class.w, d)

    ## Float comparison: `ucomis` orders the second operand against the first and leaves the
    ## unordered case with every flag set, so `<` and `<=` swap operands to use the
    ## above-conditions, which an unordered pair fails, and equality also tests parity.
    mutating func float_comparison(n: ir.Instr) -> !:
        let cls = n.cls
        var a = try self.source(n.a, cls, self.reg(cls, 0))
        var b = try self.source(n.b, cls, self.reg(cls, 1))
        if cls == ir.Class.h:
            if a != self.reg(cls, 0):
                try self.line4("movaps ", a, ", ", self.reg(cls, 0))
            if b != self.reg(cls, 1):
                try self.line4("movaps ", b, ", ", self.reg(cls, 1))
            a = self.reg(cls, 0)
            b = self.reg(cls, 1)
            try self.widen_half(a)
            try self.widen_half(b)
        let mnemonic = "ucomisd " if cls == ir.Class.d else "ucomiss "
        match n.op:
            .cslt:
                try self.line4(mnemonic, a, ", ", b)
                try self.line("seta %al")
            .csle:
                try self.line4(mnemonic, a, ", ", b)
                try self.line("setae %al")
            .csgt:
                try self.line4(mnemonic, b, ", ", a)
                try self.line("seta %al")
            .csge:
                try self.line4(mnemonic, b, ", ", a)
                try self.line("setae %al")
            .ceq:
                try self.line4(mnemonic, b, ", ", a)
                try self.line("sete %al")
                try self.line("setnp %cl")
                try self.line("andb %cl, %al")
            _:
                try self.line4(mnemonic, b, ", ", a)
                try self.line("setne %al")
                try self.line("setp %cl")
                try self.line("orb %cl, %al")
        let d = self.target(n.dst, ir.Class.w, "%eax")
        try self.line3("movzbl %al, ", d, "")
        try self.finish(n.dst, ir.Class.w, d)

    ## `op` applied to the 32-bit view `v` of a value, into `d` of class `cls`.
    mutating func extend_from(op: ir.Op, cls: ir.Class, v: str, d: str) -> !:
        let to = "q " if cls == ir.Class.l else "l "
        match op:
            .extsb: try self.line4("movsb", to, byte_name(v), ", ")
            .extub: try self.line4("movzb", to, byte_name(v), ", ")
            .extsh: try self.line4("movsw", to, word_name(v), ", ")
            .extuh: try self.line4("movzw", to, word_name(v), ", ")
            .extsw:
                if cls == ir.Class.l:
                    try self.line3("movslq ", v, ", ")
                else:
                    try self.line3("movl ", v, ", ")
            _:
                # zero-extension of a word: writing the 32-bit view clears the upper half
                try self.line3("movl ", v, ", ")
                try self.put(narrow_name(d))
                return
        try self.put(d)

    ## Conversions between float widths: `exth` a half up, `exts` a single up, `truncs` a
    ## single down to a half, `truncd` a double down.
    mutating func float_convert(n: ir.Instr) -> !:
        let src = float_source_class(n.op)
        let v = try self.source(n.a, src, self.reg(src, 0))
        let d = self.reg(n.cls, 0)
        match n.op:
            .exth:
                if v != d:
                    try self.line4("movaps ", v, ", ", d)
                try self.widen_half(d)
                if n.cls == ir.Class.d:
                    try self.line4("cvtss2sd ", d, ", ", d)
            .exts:
                try self.line4("cvtss2sd ", v, ", ", d)
            .truncs:
                if v != d:
                    try self.line4("movaps ", v, ", ", d)
                try self.round_to_half(d)
            _:
                try self.line4("cvtsd2ss ", v, ", ", d)
                if n.cls == ir.Class.h:
                    try self.round_to_half(d)
        try self.finish(n.dst, n.cls, d)

    ## A float to an integer, truncating: signed through the conversion instruction; an
    ## unsigned word through the 64-bit conversion; an unsigned long by taking 2^63 off
    ## first when the value reaches it.
    mutating func float_to_int(n: ir.Instr) -> !:
        let src = ir.Class.s if n.op == ir.Op.stosi or n.op == ir.Op.stoui else ir.Class.d
        let v = try self.source(n.a, src, self.reg(src, 0))
        let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
        let convert = "cvttsd2si " if src == ir.Class.d else "cvttss2si "
        if n.op == ir.Op.stosi or n.op == ir.Op.dtosi:
            try self.line4(convert, v, ", ", d)
        elif n.cls == ir.Class.w:
            try self.line4(convert, v, ", ", wide_name(d))
        else:
            let work = self.reg(src, 2)
            let bound = self.reg(src, 1)
            if v != work:
                try self.line4("movaps ", v, ", ", work)
            if src == ir.Class.d:
                try self.load_immediate("%rax", 4890909195324358656)
                try self.line3("movq %rax, ", bound, "")
                try self.line4("ucomisd ", bound, ", ", work)
            else:
                try self.load_immediate("%eax", 1593835520)
                try self.line3("movd %eax, ", bound, "")
                try self.line4("ucomiss ", bound, ", ", work)
            try self.line("jae 1f")
            try self.line4(convert, work, ", ", d)
            try self.line("jmp 2f")
            try self.put("\n1:")
            try self.line4("subsd " if src == ir.Class.d else "subss ", bound, ", ", work)
            try self.line4(convert, work, ", ", d)
            try self.line3("btcq $63, ", d, "")
            try self.put("\n2:")
        try self.finish(n.dst, n.cls, d)

    ## An integer to a float: signed through the conversion instruction at the integer's
    ## width; an unsigned word as a long; an unsigned long halved when its top bit is set,
    ## keeping the low bit for the rounding, then doubled.
    mutating func int_to_float(n: ir.Instr) -> !:
        let src = ir.Class.w if n.op == ir.Op.swtof or n.op == ir.Op.uwtof else ir.Class.l
        let v = try self.source(n.a, src, self.reg(src, 0))
        let d = self.reg(n.cls, 0)
        let single = n.cls != ir.Class.d
        let convert = "cvtsi2ss" if single else "cvtsi2sd"
        if n.op == ir.Op.swtof:
            try self.line4(convert, "l ", v, ", ")
            try self.put(d)
        elif n.op == ir.Op.sltof:
            try self.line4(convert, "q ", v, ", ")
            try self.put(d)
        elif n.op == ir.Op.uwtof:
            try self.line3("movl ", v, ", %eax")
            try self.line3(convert, "q %rax, ", d)
        else:
            try self.line3("movq ", v, ", %rcx")
            try self.line("testq %rcx, %rcx")
            try self.line("js 1f")
            try self.line3(convert, "q %rcx, ", d)
            try self.line("jmp 2f")
            try self.put("\n1:")
            try self.line("movq %rcx, %rax")
            try self.line("shrq $1, %rax")
            try self.line("andl $1, %ecx")
            try self.line("orq %rcx, %rax")
            try self.line3(convert, "q %rax, ", d)
            try self.line4("addss " if single else "addsd ", d, ", ", d)
            try self.put("\n2:")
        if n.cls == ir.Class.h:
            try self.round_to_half(d)
        try self.finish(n.dst, n.cls, d)

    ## Checked add, subtract, and multiply: trap on overflow of the class width.
    # -- vectors (§5.12) ------------------------------------------------------------------

    ## A vector instruction on SSE2: the operands come from their homes into xmm8 and xmm9,
    ## the result computes into xmm8 (xmm10 for a checked form) and goes to its home. An
    ## eight-byte vector is the low half of the register, moved as a quadword; the upper
    ## lanes then hold zeros, which no instruction here reads.
    mutating func vector(n: ir.Instr) -> !:
        let shape = n.extra
        let bytes = ir.vector_bytes(shape)
        let bits = ir.lane_bits(shape)
        let signed = ir.lanes_signed(shape)
        if bytes == 16:
            if n.op == ir.Op.loadv:
                try self.address_operand("%r10", n.a)
                let d = self.target(n.dst, ir.Class.v, "%xmm8")
                try self.line3("movdqu (%r10), ", d, "")
                try self.finish(n.dst, ir.Class.v, d)
                return
            if n.op == ir.Op.storev:
                let value = try self.source(n.a, ir.Class.v, "%xmm8")
                try self.address_operand("%r10", n.b)
                try self.line3("movdqu ", value, ", (%r10)")
                return
            if n.op == ir.Op.vadd or n.op == ir.Op.vsub or n.op == ir.Op.vmul or n.op == ir.Op.vdiv or n.op == ir.Op.vand or n.op == ir.Op.vor or n.op == ir.Op.vxor or n.op == ir.Op.vaddw or n.op == ir.Op.vsubw or n.op == ir.Op.vmulw:
                let a = try self.source(n.a, ir.Class.v, "%xmm8")
                let b = try self.source(n.b, ir.Class.v, "%xmm9")
                var d = self.target(n.dst, ir.Class.v, "%xmm8")
                # SSE uses a destructive destination. Preserve a distinct right
                # operand when the allocator gave its register to the result.
                if d == b and d != a:
                    d = "%xmm8"
                if a != d:
                    try self.line4("movdqa ", a, ", ", d)
                let mnemonic = "pmulld" if n.op == ir.Op.vmulw and bits == 32 else vector_mnemonic(n.op, shape)
                try self.line4(mnemonic, " ", b, ", ")
                try self.put(d)
                try self.finish(n.dst, ir.Class.v, d)
                return
        match n.op:
            .loadv:
                try self.address_operand("%r10", n.a)
                try self.line3(vector_move(bytes), "(%r10), ", "%xmm8")
                try self.vector_result(n.dst, "%xmm8", bytes)
            .storev:
                try self.vector_source(n.a, "%xmm8", bytes)
                try self.address_operand("%r10", n.b)
                try self.line3(vector_move(bytes), "%xmm8, ", "(%r10)")
            .vsplat:
                try self.splat(n, shape)
                try self.vector_result(n.dst, "%xmm8", bytes)
            .vneg:
                # the sign bit of every lane flipped
                try self.vector_source(n.a, "%xmm8", bytes)
                try self.line3("xorps ", ".Lvsign64(%rip)" if bits == 64 else ".Lvsign32(%rip)", ", %xmm8")
                try self.vector_result(n.dst, "%xmm8", bytes)
            .vnot:
                try self.vector_source(n.a, "%xmm8", bytes)
                try self.line("pcmpeqd %xmm9, %xmm9")
                try self.line("pxor %xmm9, %xmm8")
                try self.vector_result(n.dst, "%xmm8", bytes)
            .vshl, .vshr:
                # the count, one scalar, in xmm9's low quadword
                try self.vector_source(n.a, "%xmm8", bytes)
                try self.operand("%rax", ir.Class.l, n.b)
                try self.line("movq %rax, %xmm9")
                var mnemonic = "psllw"
                if n.op == ir.Op.vshl:
                    mnemonic = "psllw" if bits == 16 else ("pslld" if bits == 32 else "psllq")
                elif signed:
                    mnemonic = "psraw" if bits == 16 else "psrad"
                else:
                    mnemonic = "psrlw" if bits == 16 else ("psrld" if bits == 32 else "psrlq")
                try self.line3(mnemonic, " %xmm9, ", "%xmm8")
                try self.vector_result(n.dst, "%xmm8", bytes)
            .vaddo, .vsubo:
                try self.checked_lanes(n, shape)
            _:
                try self.vector_source(n.a, "%xmm8", bytes)
                try self.vector_source(n.b, "%xmm9", bytes)
                if n.op == ir.Op.vmulw and bits == 32:
                    # x86-64-v2: the doubleword multiply of SSE4.1
                    try self.line("pmulld %xmm9, %xmm8")
                else:
                    try self.line3(vector_mnemonic(n.op, shape), " %xmm9, ", "%xmm8")
                try self.vector_result(n.dst, "%xmm8", bytes)

    ## `vaddo`/`vsubo`: the wrapping result in xmm10; a lane that overflowed traps. Bytes
    ## and halfwords compare the wrapping result with the saturating one; doublewords read
    ## the sign of the overflow test, `(a ^ r) & (b ^ r)` for an add, `(a ^ b) & (a ^ r)`
    ## for a subtract, or the unsigned order of the operands through a sign flip.
    mutating func checked_lanes(n: ir.Instr, shape: u32) -> !:
        let bytes = ir.vector_bytes(shape)
        let bits = ir.lane_bits(shape)
        let signed = ir.lanes_signed(shape)
        let add = n.op == ir.Op.vaddo
        try self.vector_source(n.a, "%xmm8", bytes)
        try self.vector_source(n.b, "%xmm9", bytes)
        try self.line("movdqa %xmm8, %xmm10")
        try self.line3(lane_mnemonic("padd" if add else "psub", bits), " %xmm9, ", "%xmm10")
        if bits <= 16:
            let sat = ("padds" if signed else "paddus") if add else ("psubs" if signed else "psubus")
            try self.line3(lane_mnemonic(sat, bits), " %xmm9, ", "%xmm8")
            try self.line("pcmpeqb %xmm10, %xmm8")
            try self.line("pmovmskb %xmm8, %eax")
            if bytes == 16:
                try self.line("cmpl $65535, %eax")
            else:
                try self.line("andl $255, %eax")
                try self.line("cmpl $255, %eax")
            try self.line("je 1f")
        elif signed:
            # xmm8 = a, xmm9 = b, xmm10 = r: the overflow test's sign bits
            try self.line("movdqa %xmm8, %xmm11")
            if add:
                try self.line("pxor %xmm10, %xmm11")
                try self.line("pxor %xmm10, %xmm9")
                try self.line("pand %xmm9, %xmm11")
            else:
                try self.line("pxor %xmm9, %xmm11")
                try self.line("pxor %xmm10, %xmm8")
                try self.line("pand %xmm8, %xmm11")
            try self.line("pmovmskb %xmm11, %eax")
            try self.line("andl $34952, %eax" if bytes == 16 else "andl $136, %eax")
            try self.line("je 1f")
        else:
            # unsigned: an add overflowed where r < a, a subtract where a < b
            try self.line("movdqa .Lvsign32(%rip), %xmm11")
            try self.line("pxor %xmm11, %xmm8")
            if add:
                try self.line("pxor %xmm10, %xmm11")
                try self.line("pcmpgtd %xmm11, %xmm8")
            else:
                try self.line("pxor %xmm9, %xmm11")
                try self.line("pcmpgtd %xmm8, %xmm11")
                try self.line("movdqa %xmm11, %xmm8")
            try self.line("pmovmskb %xmm8, %eax")
            try self.line("andl $65535, %eax" if bytes == 16 else "andl $255, %eax")
            try self.line("je 1f")
        try self.trap_text("integer overflow", n.extra2)
        try self.put("\n1:")
        try self.vector_result(n.dst, "%xmm10", bytes)

    ## `T[N](x)`: the scalar into every lane of xmm8.
    mutating func splat(n: ir.Instr, shape: u32) -> !:
        let bits = ir.lane_bits(shape)
        if ir.lanes_float(shape):
            if bits == 64:
                try self.operand("%xmm8", ir.Class.d, n.a)
                try self.line("unpcklpd %xmm8, %xmm8")
            else:
                try self.operand("%xmm8", ir.Class.s, n.a)
                try self.line("shufps $0, %xmm8, %xmm8")
            return
        if bits == 64:
            try self.operand("%rax", ir.Class.l, n.a)
            try self.line("movq %rax, %xmm8")
            try self.line("punpcklqdq %xmm8, %xmm8")
            return
        try self.operand("%eax", ir.Class.w, n.a)
        try self.line("movd %eax, %xmm8")
        if bits == 8:
            try self.line("punpcklbw %xmm8, %xmm8")
        if bits <= 16:
            try self.line("punpcklwd %xmm8, %xmm8")
        try self.line("pshufd $0, %xmm8, %xmm8")

    ## A vector temporary into `reg`: from the register it lives in, else from its home.
    mutating func vector_source(r: ir.Ref, reg: str, bytes: u32) -> !:
        let code = self.fr.temp_regs.get((usize)r.index - 1)
        if code != 0:
            try self.line4("movdqa ", class_name(code, ir.Class.v), ", ", reg)
            return
        try self.line(vector_move(bytes))
        try self.frame_operand(self.temp_home(r.index))
        try self.put(", ")
        try self.put(reg)

    ## `reg` into vector temporary `dst`, where it lives.
    mutating func vector_result(dst: u32, reg: str, bytes: u32) -> !:
        if dst == 0:
            return
        let code = self.fr.temp_regs.get((usize)dst - 1)
        if code != 0:
            try self.line4("movdqa ", reg, ", ", class_name(code, ir.Class.v))
            return
        try self.line3(vector_move(bytes), reg, ", ")
        try self.frame_operand(self.temp_home(dst))

    mutating func checked(n: ir.Instr) -> !:
        let signed = n.extra == 1
        let cls = n.cls
        let suffix = "q" if cls == ir.Class.l else "l"
        let a = self.reg(cls, 0)
        let b = self.reg(cls, 1)
        try self.operand(a, cls, n.a)
        try self.operand(b, cls, n.b)
        if n.op == ir.Op.mulo:
            if signed:
                try self.line5("imul", suffix, " ", b, ", ")
                try self.put(a)
                try self.line("jno 1f")
            else:
                try self.line4("mul", suffix, " ", b)
                try self.line("jnc 1f")
        else:
            try self.line5("add" if n.op == ir.Op.addo else "sub", suffix, " ", b, ", ")
            try self.put(a)
            try self.line("jno 1f" if signed else "jnc 1f")
        try self.trap_text("integer overflow", n.extra2)
        try self.put("\n1:")
        try self.store_temp(a, cls, n.dst)

    ## A trap with a fixed reason; `at`, when not zero, is the unit's text of the statement's
    ## position plus one, which the reporter names first (§11.5).
    mutating func trap_text(reason: str, at: u32) -> !:
        let index = try self.program_unit.text(reason)
        if at > 0:
            try self.address_operand("%rdi", ir.text_ref(at - 1))
            try self.address_operand("%rsi", ir.text_ref(index))
            try self.call_symbol(self.program_unit.trap_at_function)
            return
        try self.address_operand("%rdi", ir.text_ref(index))
        try self.call_symbol(self.program_unit.trap_function)

    ## An asm block, with its outputs. The callee-saved registers its operands name
    ## (`set_reg` before it, `get_reg` after it, a discarded output among them) are pushed
    ## first, since the block may write them while the allocator keeps values there. After
    ## the body, an output that lives in a pushed register is pushed as well, the saved
    ## registers are reloaded from the stack, and only then is every output stored, so the
    ## addresses of the output places, which may live in those registers, are sound.
    mutating func inline_asm(n: ir.Instr) -> !:
        let arch = self.program_unit.texts.get((usize)n.a.index).bytes
        if arch != "x86_64":
            return
        self.pending = 0
        var k = self.at
        while k > 0 and self.f.instrs.get(k - 1).op == ir.Op.set_reg:
            k -= 1
            try self.note_named(self.f.instrs.get(k))
        let first_output = self.at + 1
        var last = first_output
        while last < self.f.instrs.count and self.f.instrs.get(last).op == ir.Op.get_reg:
            try self.note_named(self.f.instrs.get(last))
            last += 1
        var s: usize = 0
        while s < self.pending:
            try self.line2("pushq ", self.saved[s])
            s += 1
        let body = self.program_unit.texts.get((usize)n.b.index).bytes
        try self.put("\n")
        try self.put(body)
        # the outputs that live in a saved register, pushed above the saves
        var values: usize = 0
        var value_index: usize[16] = ---
        k = first_output
        while k < last:
            let o = self.f.instrs.get(k)
            value_index[k - first_output] = 16
            if o.a.kind != ir.RefKind.none_:
                let reg = wide_name(with_percent(self.program_unit.texts.get((usize)o.b.index).bytes))
                if self.saved_index(reg) < self.pending:
                    try self.line2("pushq ", reg)
                    value_index[k - first_output] = values
                    values += 1
            k += 1
        s = 0
        while s < self.pending:
            try self.line("movq ")
            try self.put_u64((u64)(8 * (values + (self.pending - 1 - s))))
            try self.put("(%rsp), ")
            try self.put(self.saved[s])
            s += 1
        k = first_output
        while k < last:
            let o = self.f.instrs.get(k)
            if o.a.kind != ir.RefKind.none_:
                var reg = with_percent(self.program_unit.texts.get((usize)o.b.index).bytes)
                let j = value_index[k - first_output]
                if j < 16:
                    try self.line("movq ")
                    try self.put_u64((u64)(8 * (values - 1 - j)))
                    try self.put("(%rsp), %rax")
                    reg = "%rax" if o.cls == ir.Class.l else "%eax"
                try self.address_operand("%r10", o.a)
                try self.line3(self.move_of(o.cls), reg, ", (%r10)")
            k += 1
        if self.pending + values > 0:
            try self.line("addq $")
            try self.put_u64((u64)(8 * (self.pending + values)))
            try self.put(", %rsp")
        self.pending = 0

    ## Remember the register `operand` names when the allocator may keep a value in it.
    mutating func note_named(operand: ir.Instr) -> !:
        let reg = wide_name(with_percent(self.program_unit.texts.get((usize)operand.b.index).bytes))
        if self.saved_index(reg) < self.pending:
            return
        var c: usize = 1
        while c <= 5:
            if q_names[c] == reg and self.pending < 8:
                self.saved[self.pending] = reg
                self.pending += 1
                return
            c += 1

    ## Where `reg` sits among the saved registers, or `pending` when it does not.
    func saved_index(reg: str) -> usize:
        var s: usize = 0
        while s < self.pending:
            if self.saved[s] == reg:
                return s
            s += 1
        return self.pending

    ## Read-modify-write atomics: `xadd` and `xchg` for the ones the machine has, a
    ## compare-and-swap loop for the rest; the old value is the result.
    mutating func read_modify_write(n: ir.Instr) -> !:
        let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
        let width = (u64)n.extra
        let suffix = width_suffix(n.extra)
        let value = register_of_width("%rcx", width)
        let old = register_of_width("%rax", width)
        let fresh = register_of_width("%rdx", width)
        try self.operand(self.reg(cls, 1), cls, n.a)
        try self.address_operand("%r10", n.b)
        if n.op == ir.Op.atomic_add or n.op == ir.Op.atomic_sub:
            if n.op == ir.Op.atomic_sub:
                try self.line4("neg", suffix, " ", value)
            try self.line5("lock xadd", suffix, " ", value, ", (%r10)")
            try self.store_temp(self.reg(cls, 1), cls, n.dst)
            return
        if n.op == ir.Op.atomic_swap:
            try self.line5("xchg", suffix, " ", value, ", (%r10)")
            try self.store_temp(self.reg(cls, 1), cls, n.dst)
            return
        try self.line4(zero_extending_load(n.extra), "(%r10), ", self.reg(cls, 0), "")
        try self.put("\n1:")
        try self.line5("mov", suffix, " ", old, ", ")
        try self.put(fresh)
        match n.op:
            .atomic_or:
                try self.line5("or", suffix, " ", value, ", ")
                try self.put(fresh)
            .atomic_xor:
                try self.line5("xor", suffix, " ", value, ", ")
                try self.put(fresh)
            .atomic_and_not:
                try self.line4("not", suffix, " ", fresh)
                try self.line5("or", suffix, " ", value, ", ")
                try self.put(fresh)
                try self.line4("not", suffix, " ", fresh)
            .atomic_max:
                try self.line5("cmp", suffix, " ", value, ", ")
                try self.put(old)
                try self.line4("cmovl", suffix if cls == ir.Class.l else "l", " ", self.reg(cls, 1))
                try self.put(", ")
                try self.put(self.reg(cls, 2))
            .atomic_min:
                try self.line5("cmp", suffix, " ", value, ", ")
                try self.put(old)
                try self.line4("cmovg", suffix if cls == ir.Class.l else "l", " ", self.reg(cls, 1))
                try self.put(", ")
                try self.put(self.reg(cls, 2))
            _:
                discard(fresh.length)
        try self.line5("lock cmpxchg", suffix, " ", fresh, ", (%r10)")
        try self.line("jne 1b")
        try self.store_temp(self.reg(cls, 0), cls, n.dst)

    mutating func compare_and_swap(n: ir.Instr) -> !:
        let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
        let width = (u64)n.extra
        let expected = self.f.args.get((usize)n.b.value)
        let desired = self.f.args.get((usize)n.b.value + 1)
        try self.operand(self.reg(cls, 0), cls, expected.value)
        try self.operand(self.reg(cls, 1), cls, desired.value)
        try self.address_operand("%r10", n.a)
        try self.line5("lock cmpxchg", width_suffix(n.extra), " ", register_of_width("%rcx", width), ", (%r10)")
        try self.store_temp(self.reg(cls, 0), cls, n.dst)

    # mark: Calls ==============================================================================

    ## Preserve Windows' additional nonvolatile registers used by shared instruction code.
    mutating func windows_saved(restore: bool) -> !:
        let regs: str[12] = ["%rdi", "%rsi", "%xmm6", "%xmm7", "%xmm8", "%xmm9", "%xmm10", "%xmm11", "%xmm12", "%xmm13", "%xmm14", "%xmm15"]
        for i in 0..<12:
            let cls = ir.Class.l if i < 2 else ir.Class.v
            let offset = (i + 1) * 8 if i < 2 else (i - 1) * 16 + 16
            if restore:
                try self.frame_load(regs[i], cls, (u64)offset)
            else:
                try self.frame_store(regs[i], cls, (u64)offset)
                try self.line(".seh_savereg " if i < 2 else ".seh_savexmm ")
                try self.put(regs[i])
                try self.put(", ")
                try self.put_u64(self.fr.size - (u64)offset)

    mutating func receive_windows() -> !:
        let hidden: usize = 1 if self.f.has_result and self.in_memory(self.f.result_size, self.f.result_shape) else 0
        for i in 0..<4:
            try self.line3("movq ", windows_arguments[i], ", ")
            try self.put_u64(self.fr.size + (u64)(16 + i * 8))
            try self.put("(%rbp)")
        for i in 0..<self.f.params.count:
            let p = self.f.params.get(i)
            let ordinal = i + hidden
            if ordinal < 4 and p.size == 0 and ir.is_float_class(p.cls):
                try self.line3("movsd ", float_argument_names[ordinal], ", ")
                try self.put_u64(self.fr.size + (u64)(16 + ordinal * 8))
                try self.put("(%rbp)")
        for i in 0..<self.f.params.count:
            let p = self.f.params.get(i)
            let home = self.slot_home(p.slot)
            let ordinal = i + hidden
            if p.size == 0:
                try self.stack_param_load("%rax", (u64)(16 + ordinal * 8))
                if ir.is_float_class(p.cls):
                    let width: u64 = 2 if p.cls == ir.Class.h else (4 if p.cls == ir.Class.s else 8)
                    try self.line2(store_word_mnemonic(width), register_of_width("%rax", width))
                    try self.put(", ")
                    try self.frame_operand(home)
                else:
                    let code = self.fr.slot_regs.get((usize)p.slot)
                    if code != 0:
                        try self.line4("movq " if p.cls == ir.Class.l else "movl ", "%rax" if p.cls == ir.Class.l else "%eax", ", ", class_name((u8)code, p.cls))
                    else:
                        try self.frame_store("%rax" if p.cls == ir.Class.l else "%eax", p.cls, home)
            elif self.in_memory(p.size, p.shape):
                try self.stack_param_load("%r10", (u64)(16 + ordinal * 8))
                try self.frame_address("%r11", home)
                try self.copy_r10_to_r11((u64)p.size)
            else:
                try self.stack_param_load("%rax", (u64)(16 + ordinal * 8))
                try self.frame_address("%r10", home)
                try self.store_bytes("%rax", "%r10", 0, (u64)p.size)

    mutating func call_windows(n: ir.Instr) -> !:
        let info = self.f.calls.get((usize)n.extra)
        let hidden = info.has_result and self.in_memory(info.result_size, info.result_shape)
        let first: u64 = 1 if hidden else 0
        let count = (u64)info.args_count + first
        let slots = round_up((count if count > 4 else 4) * 8, 16)
        var area = slots
        for i in 0..<info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            if self.in_memory(a.size, a.shape):
                area += round_up((u64)a.size, 16)
        if area >= 4096:
            try self.load_immediate("%rax", (i64)area)
            try self.line("call ___chkstk_ms")
        try self.line("subq $")
        try self.put_u64(area)
        try self.put(", %rsp")
        var copy_offset = slots
        for i in 0..<info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            let offset = ((u64)i + first) * 8
            if a.size == 0:
                if ir.is_float_class(a.cls):
                    try self.operand("%xmm0", a.cls, a.value)
                    try self.line("movq %xmm0, %rax")
                else:
                    try self.operand("%rax" if a.cls == ir.Class.l else "%eax", a.cls, a.value)
            elif self.in_memory(a.size, a.shape):
                try self.address_operand("%r10", a.value)
                try self.line("leaq ")
                try self.put_u64(copy_offset)
                try self.put("(%rsp), %r11")
                try self.copy_r10_to_r11((u64)a.size)
                try self.line("leaq ")
                try self.put_u64(copy_offset)
                try self.put("(%rsp), %rax")
                copy_offset += round_up((u64)a.size, 16)
            else:
                try self.address_operand("%r10", a.value)
                try self.load_bytes("%rax", "%r10", 0, (u64)a.size)
            try self.line("movq %rax, ")
            try self.put_u64(offset)
            try self.put("(%rsp)")
        if hidden:
            try self.frame_address("%rax", self.slot_home(info.result_slot))
            try self.line("movq %rax, (%rsp)")
        for i in 0..<(count if count < 4 else 4):
            try self.line("movq ")
            try self.put_u64(i * 8)
            try self.put("(%rsp), ")
            try self.put(windows_arguments[i])
            if i >= first:
                let a = self.f.args.get((usize)((u64)info.args_start + i - first))
                if a.size == 0 and ir.is_float_class(a.cls):
                    try self.line4("movq ", windows_arguments[i], ", ", float_argument_names[i])
        if n.a.kind == ir.RefKind.temp or n.a.kind == ir.RefKind.constant:
            try self.operand("%r11", ir.Class.l, n.a)
            try self.line("call *%r11")
        else:
            try self.line("call ")
            try self.symbol(n.a.name)
        try self.line("addq $")
        try self.put_u64(area)
        try self.put(", %rsp")
        if not info.has_result or hidden:
            return
        if info.result_size == 0:
            if ir.is_float_class(info.result_cls):
                try self.store_temp("%xmm0", info.result_cls, n.dst)
            else:
                try self.store_temp("%rax" if info.result_cls == ir.Class.l else "%eax", info.result_cls, n.dst)
        else:
            try self.frame_address("%r10", self.slot_home(info.result_slot))
            try self.store_bytes("%rax", "%r10", 0, (u64)info.result_size)

    ## Classify one argument under the System V convention, advancing the counters: every
    ## eightbyte of a small aggregate takes a register of its class, or the whole aggregate
    ## goes to the stack; a large one always does.
    func place(a: ir.Arg, next_int: u32*, next_float: u32*, stack: u32*) -> Placement:
        if a.size == 0:
            if ir.is_float_class(a.cls):
                if *next_float < 8:
                    let p = Placement(where = 0, sse = 1, first_int = 0, first_float = *next_float, words = 1, stack_offset = 0)
                    *next_float += 1
                    return p
            elif *next_int < 6:
                let p = Placement(where = 0, sse = 0, first_int = *next_int, first_float = 0, words = 1, stack_offset = 0)
                *next_int += 1
                return p
            let p = Placement(where = 2, sse = 0, first_int = 0, first_float = 0, words = 1, stack_offset = *stack)
            *stack += 8
            return p
        let sse = self.sse_of(a.cls, a.size, a.shape)
        let words: u32 = 2 if a.size > 8 else 1
        let sse_count = count_bits(sse)
        let int_count = words - sse_count
        if not self.in_memory(a.size, a.shape) and *next_int + int_count <= 6 and *next_float + sse_count <= 8:
            let p = Placement(where = 0, sse = sse, first_int = *next_int, first_float = *next_float, words = words, stack_offset = 0)
            *next_int += int_count
            *next_float += sse_count
            return p
        let start = round_up((u64)*stack, (u64)a.align if a.align > 8 else 8)
        let p = Placement(where = 2, sse = 0, first_int = 0, first_float = 0, words = words, stack_offset = (u32)start)
        *stack = (u32)(start + round_up((u64)a.size, 8))
        return p

    mutating func call(n: ir.Instr) -> !:
        if self.os == build_target.Os.windows:
            try self.call_windows(n)
            return
        let info = self.f.calls.get((usize)n.extra)
        let hidden = info.has_result and self.in_memory(info.result_size, info.result_shape)
        var next_int: u32 = 1 if hidden else 0
        var next_float: u32 = 0
        var stack: u32 = 0
        # one placement per argument, however many: from the build's arena
        var placements: Placement[]
        if info.args_count > 0:
            placements = try alloc Placement[(usize)info.args_count]
        var i: u32 = 0
        while i < info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            placements[i] = self.place(a, &next_int, &next_float, &stack)
            i += 1
        let area = round_up((u64)stack, 16)
        if area > 0:
            try self.line("subq $")
            try self.put_u64(area)
            try self.put(", %rsp")
        # stack arguments first, while every register is still free
        i = 0
        while i < info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 2:
                if a.size == 0:
                    let cls = ir.Class.l if a.cls == ir.Class.w or a.cls == ir.Class.l else a.cls
                    try self.operand(self.reg(cls, 0), cls, a.value)
                    try self.line3(self.move_of(cls), self.reg(cls, 0), ", ")
                    try self.put_u64((u64)p.stack_offset)
                    try self.put("(%rsp)")
                else:
                    try self.address_operand("%r10", a.value)
                    try self.line("leaq ")
                    try self.put_u64((u64)p.stack_offset)
                    try self.put("(%rsp), %r11")
                    try self.copy_r10_to_r11((u64)a.size)
            i += 1
        # float registers, then integer ones, so loading the latter disturbs nothing
        i = 0
        while i < info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 0 and p.sse != 0:
                if a.size == 0:
                    try self.operand(float_argument_names[(usize)p.first_float], a.cls, a.value)
                else:
                    try self.address_operand("%r10", a.value)
                    var k: u32 = 0
                    var f = p.first_float
                    while k < p.words:
                        if (p.sse & (u8)(1 << k)) != 0:
                            try self.load_eightbyte(float_argument_names[(usize)f], k, a.size, true)
                            f += 1
                        k += 1
            i += 1
        i = 0
        while i < info.args_count:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 0 and (p.sse == 0 or a.size > 0):
                if a.size == 0:
                    try self.operand(argument_names[(usize)p.first_int] if a.cls == ir.Class.l else narrow_name(argument_names[(usize)p.first_int]), a.cls, a.value)
                else:
                    try self.address_operand("%r10", a.value)
                    var k: u32 = 0
                    var g = p.first_int
                    while k < p.words:
                        if (p.sse & (u8)(1 << k)) == 0:
                            try self.load_eightbyte(argument_names[(usize)g], k, a.size, false)
                            g += 1
                        k += 1
            i += 1
        if hidden:
            try self.frame_address("%rdi", self.slot_home(info.result_slot))
        if n.a.kind == ir.RefKind.temp or n.a.kind == ir.RefKind.constant:
            # A constant propagated into an indirect call has no symbol name.
            try self.operand("%r11", ir.Class.l, n.a)
        if info.variadic:
            try self.load_immediate("%eax", (i64)next_float)
        if n.a.kind == ir.RefKind.temp or n.a.kind == ir.RefKind.constant:
            try self.line("call *%r11")
        else:
            try self.call_symbol(n.a.name)
        if area > 0:
            try self.line("addq $")
            try self.put_u64(area)
            try self.put(", %rsp")
        if not info.has_result:
            return
        if info.result_size == 0:
            if ir.is_float_class(info.result_cls):
                try self.store_temp("%xmm0", info.result_cls, n.dst)
            else:
                try self.store_temp("%rax" if info.result_cls == ir.Class.l else "%eax", info.result_cls, n.dst)
            return
        if hidden:
            return
        try self.frame_address("%r10", self.slot_home(info.result_slot))
        let sse = self.sse_of(info.result_cls, info.result_size, info.result_shape)
        try self.result_eightbytes(info.result_size, sse, true)

    ## The eightbytes of a small aggregate result between (%r10) and rax/rdx and xmm0/xmm1,
    ## `store` into the memory from the registers, else the reverse.
    mutating func result_eightbytes(size: u32, sse: u8, store: bool) -> !:
        let words: u32 = 2 if size > 8 else 1
        var next_int: u32 = 0
        var next_float: u32 = 0
        var k: u32 = 0
        while k < words:
            if (sse & (u8)(1 << k)) != 0:
                let reg = "%xmm0" if next_float == 0 else "%xmm1"
                next_float += 1
                if store:
                    try self.store_eightbyte(reg, k, size, true)
                else:
                    try self.load_eightbyte(reg, k, size, true)
            else:
                let reg = "%rax" if next_int == 0 else "%rdx"
                next_int += 1
                if store:
                    try self.store_eightbyte(reg, k, size, false)
                else:
                    try self.load_eightbyte(reg, k, size, false)
            k += 1

    mutating func return_value(n: ir.Instr) -> !:
        if self.f.has_result:
            if self.f.result_size == 0:
                if ir.is_float_class(self.f.result_cls):
                    try self.operand("%xmm0", self.f.result_cls, n.a)
                else:
                    try self.operand("%rax" if self.f.result_cls == ir.Class.l else "%eax", self.f.result_cls, n.a)
            elif not self.in_memory(self.f.result_size, self.f.result_shape):
                try self.address_operand("%r10", n.a)
                let sse = self.sse_of(self.f.result_cls, self.f.result_size, self.f.result_shape)
                try self.result_eightbytes(self.f.result_size, sse, false)
            else:
                try self.address_operand("%rsi", n.a)
                try self.line("movq ")
                try self.frame_operand(self.fr.indirect_home)
                try self.put(", %rdi")
                try self.load_immediate("%rdx", (i64)self.f.result_size)
                try self.call_symbol("memcpy")
                try self.line("movq ")
                try self.frame_operand(self.fr.indirect_home)
                try self.put(", %rax")
        try self.restore_callee_saved()
        if self.dw != none:
            try self.line(".cfi_remember_state")
        if self.os == build_target.Os.windows:
            try self.frame_address("%rsp", 0)
        else:
            try self.line("movq %rbp, %rsp")
        try self.line("popq %rbp")
        if self.dw != none:
            try self.line(".cfi_def_cfa 7, 8")
            try self.line(".cfi_restore 6")
        try self.line("ret")
        if self.dw != none:
            try self.line(".cfi_restore_state")

    mutating func save_callee_saved() -> !:
        if self.os == build_target.Os.windows:
            try self.windows_saved(false)
        var c: usize = 1
        while c <= 5:
            if (self.fr.used_mask & (u32)(1 << (u32)(c - 1))) != 0:
                try self.frame_store(q_names[c], ir.Class.l, self.fr.save_offset[c])
                if self.os == build_target.Os.windows:
                    try self.line3(".seh_savereg ", q_names[c], ", ")
                    try self.put_u64(self.fr.size - self.fr.save_offset[c])
                if self.dw != none:
                    try self.line(".cfi_offset ")
                    try self.put_u64(3 if c == 1 else (u64)c + 10)
                    try self.put(", -")
                    try self.put_u64(self.fr.save_offset[c] + 16)
            c += 1

    mutating func restore_callee_saved() -> !:
        if self.os == build_target.Os.windows:
            try self.windows_saved(true)
        var c: usize = 1
        while c <= 5:
            if (self.fr.used_mask & (u32)(1 << (u32)(c - 1))) != 0:
                try self.frame_load(q_names[c], ir.Class.l, self.fr.save_offset[c])
            c += 1

    # mark: The unit ===========================================================================

    pub mutating func generate() -> !:
        # Declare COFF weak references before emitting code. Weak definitions
        # receive individual sections so their fallback symbol has zero offset.
        if self.os == build_target.Os.windows:
            for global in self.program_unit.globals.span():
                if global.weak:
                    try self.put("    .weak ")
                    try self.symbol(global.name)
                    try self.put("\n")
            for function in self.program_unit.functions.span():
                if function.weak:
                    try self.put("    .weak ")
                    try self.symbol(function.name)
                    try self.put("\n")
        if let dw = self.dw:
            try dw.begin(&self.out)
        try self.put("    .text\n")
        var i: usize = 0
        while i < self.program_unit.functions.count:
            try self.function(i)
            i += 1
        # module-level asm blocks, verbatim, in the text section (§8.9)
        i = 0
        while i < self.program_unit.module_asm.count:
            try self.put("\n")
            try self.put(self.program_unit.module_asm.get(i).bytes)
            i += 1
        # the loader runs the unit's initialiser: ELF's `.init_array`, Mach-O's
        # `__mod_init_func` (§17.6)
        if self.program_unit.init_function.length > 0:
            if self.os == build_target.Os.macos:
                try self.put("\n    .section __DATA,__mod_init_func,mod_init_funcs\n    .p2align 3\n    .quad ")
            elif self.os == build_target.Os.windows:
                try self.put("\n    .section .CRT$XCU,\"dr\"\n    .p2align 3\n    .quad ")
            else:
                try self.put("\n    .section .init_array,\"aw\"\n    .p2align 3\n    .quad ")
            try self.symbol(self.program_unit.init_function)
            try self.put("\n    .text\n")
        # text literals, after the sign masks vector negation and unsigned lane checks read
        try self.put("\n    .section .rdata,\"dr\"" if self.os == build_target.Os.windows else "\n    .section .rodata")
        try self.put("\n    .p2align 4\n.Lvsign32:\n    .long 2147483648, 2147483648, 2147483648, 2147483648\n.Lvsign64:\n    .quad -9223372036854775808, -9223372036854775808\n")
        i = 0
        while i < self.program_unit.texts.count:
            try self.text_label(u32(i))
            try self.put(":\n    .asciz ")
            try self.c_string(self.program_unit.texts.get(i).bytes)
            try self.put("\n")
            i += 1
        # witness tables and frame descriptors hold addresses, which a position-independent
        # image relocates when it loads
        try self.put("\n    .section .rdata,\"dr\"\n    .p2align 3\n" if self.os == build_target.Os.windows else "\n    .section .data.rel.ro,\"aw\"\n    .p2align 3\n")
        i = 0
        while i < self.program_unit.tables.count:
            let t = self.program_unit.tables.get(i)
            try self.put("    .globl ")
            try self.symbol(t.name)
            try self.put("\n")
            try self.symbol(t.name)
            try self.put(":\n")
            var k: usize = 0
            while k < t.entries.count:
                let entry = t.entries.get(k)
                try self.put("    .quad ")
                if entry.length == 0:
                    try self.put("0")
                else:
                    try self.symbol(entry)
                try self.put("\n")
                k += 1
            i += 1
        if self.descriptors.used > 0:
            try self.put(self.descriptors.view())
        # globals
        i = 0
        while i < self.program_unit.globals.count:
            let g = self.program_unit.globals.get(i)
            let size = (u64)g.size if g.size > 0 else 1
            let align = log2((u64)g.align if g.align > 0 else 1)
            if g.weak and self.os == build_target.Os.windows:
                try self.put("\n    .section .data$")
                try self.symbol(g.name)
                try self.put(",\"dw\"\n")
            elif g.is_thread_local:
                try self.put("\n    .section .tls$LUCE,\"dw\"\n" if self.os == build_target.Os.windows else "\n    .section .tbss,\"awT\",@nobits\n")
            elif g.section.length > 0:
                try self.put("\n    .section ")
                try self.put(build_target.section_name(g.section, false, self.os))
                try self.put(",\"dw\"\n" if self.os == build_target.Os.windows else ",\"aw\"\n")
            else:
                try self.put("\n    .bss\n")
            try self.put("    .globl ")
            try self.symbol(g.name)
            if self.os != build_target.Os.windows:
                try self.put("\n    .type ")
                try self.symbol(g.name)
                try self.put(", @object")
            try self.put("\n")
            try self.linkage_directives(g.name, g.weak, g.used)
            try self.put("    .p2align ")
            try self.put_u64(align)
            try self.put("\n")
            try self.symbol(g.name)
            try self.put(":\n    .zero ")
            try self.put_u64(size)
            try self.put("\n")
            i += 1
        if self.half_routines:
            try self.put(half_routines_text)
        if self.os != build_target.Os.windows:
            try self.put("\n    .section .note.GNU-stack,\"\",@progbits\n")
        if let dw = self.dw:
            try dw.finish(&self.out)

    mutating func c_string(text: str) -> !:
        try self.put("\"")
        for b in text.bytes:
            if b == '\\' or b == '"':
                try self.put("\\")
                try self.out.put_byte(b)
            elif b == '\n':
                try self.put("\\n")
            elif b == '\t':
                try self.put("\\t")
            elif b < 32 or b >= 127:
                try self.put("\\")
                try self.out.put_byte('0' + (b >> 6))
                try self.out.put_byte('0' + ((b >> 3) & 7))
                try self.out.put_byte('0' + (b & 7))
            else:
                try self.out.put_byte(b)
        try self.put("\"")

# mark: Helpers ================================================================================
let windows_arguments: str[4] = ["%rcx", "%rdx", "%r8", "%r9"]

## The callee-saved registers the allocator hands out, codes 1..5, in their four widths.
## Register codes: 1–5 the callee-saved rbx and r12–r15; 6–9 the caller-saved xmm12–xmm15,
## which nothing else here touches, for floats and vectors that cross no call.
let q_names: str[10] = ["", "%rbx", "%r12", "%r13", "%r14", "%r15", "%xmm12", "%xmm13", "%xmm14", "%xmm15"]
let l_names: str[10] = ["", "%ebx", "%r12d", "%r13d", "%r14d", "%r15d", "%xmm12", "%xmm13", "%xmm14", "%xmm15"]
let w_names: str[10] = ["", "%bx", "%r12w", "%r13w", "%r14w", "%r15w", "%xmm12", "%xmm13", "%xmm14", "%xmm15"]
let b_names: str[10] = ["", "%bl", "%r12b", "%r13b", "%r14b", "%r15b", "%xmm12", "%xmm13", "%xmm14", "%xmm15"]

## Every integer register this generator names, in its four widths, for the views.
let all_q: str[14] = ["%rax", "%rcx", "%rdx", "%rbx", "%rsi", "%rdi", "%r8", "%r9", "%r10", "%r11", "%r12", "%r13", "%r14", "%r15"]
let all_l: str[14] = ["%eax", "%ecx", "%edx", "%ebx", "%esi", "%edi", "%r8d", "%r9d", "%r10d", "%r11d", "%r12d", "%r13d", "%r14d", "%r15d"]
let all_w: str[14] = ["%ax", "%cx", "%dx", "%bx", "%si", "%di", "%r8w", "%r9w", "%r10w", "%r11w", "%r12w", "%r13w", "%r14w", "%r15w"]
let all_b: str[14] = ["%al", "%cl", "%dl", "%bl", "%sil", "%dil", "%r8b", "%r9b", "%r10b", "%r11b", "%r12b", "%r13b", "%r14b", "%r15b"]

let argument_names: str[6] = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"]
let float_argument_names: str[8] = ["%xmm0", "%xmm1", "%xmm2", "%xmm3", "%xmm4", "%xmm5", "%xmm6", "%xmm7"]

## The index of `reg` among the integer registers, in any width, or 14.
func register_index(reg: str) -> usize:
    var k: usize = 0
    while k < 14:
        if all_q[k] == reg or all_l[k] == reg or all_w[k] == reg or all_b[k] == reg:
            return k
        k += 1
    return 14

func wide_name(reg: str) -> str:
    let k = register_index(reg)
    return all_q[k] if k < 14 else reg

func narrow_name(reg: str) -> str:
    let k = register_index(reg)
    return all_l[k] if k < 14 else reg

func word_name(reg: str) -> str:
    let k = register_index(reg)
    return all_w[k] if k < 14 else reg

func byte_name(reg: str) -> str:
    let k = register_index(reg)
    return all_b[k] if k < 14 else reg

## `reg` in the width of `width` bytes.
func register_of_width(reg: str, width: u64) -> str:
    if width == 8:
        return wide_name(reg)
    if width == 4:
        return narrow_name(reg)
    if width == 2:
        return word_name(reg)
    return byte_name(reg)

## Whether `reg` is a 32-bit name.
func is_narrow(reg: str) -> bool:
    let k = register_index(reg)
    return k < 14 and all_l[k] == reg

## Register code `code` viewed as class `cls`.
func class_name(code: u8, cls: ir.Class) -> str:
    if cls == ir.Class.w:
        return l_names[(usize)code]
    return q_names[(usize)code]

func is_int_class(c: ir.Class) -> bool:
    return c == ir.Class.w or c == ir.Class.l

## The register-to-register move of a class.
func register_move(cls: ir.Class) -> str:
    if cls == ir.Class.w:
        return "movl "
    if cls == ir.Class.l:
        return "movq "
    return "movaps "

func store_word_mnemonic(width: u64) -> str:
    if width == 8:
        return "movq "
    if width == 4:
        return "movl "
    if width == 2:
        return "movw "
    return "movb "

## The load that zero-extends `width` bytes into a register.
func zero_extending_load(width: u32) -> str:
    if width == 8:
        return "movq "
    if width == 4:
        return "movl "
    if width == 2:
        return "movzwl "
    return "movzbl "

func width_suffix(width: u32) -> str:
    if width == 1:
        return "b"
    if width == 2:
        return "w"
    if width == 4:
        return "l"
    return "q"

func count_bits(v: u8) -> u32:
    return (u32)(v & 1) + (u32)((v >> 1) & 1)

## A register name with its `%`, whether the source wrote one or not.
func with_percent(name: str) -> str:
    if name.length > 0 and name.bytes[0] == '%':
        return name
    var room: u8[32]
    let spelled = format(room, f"%{name}") catch failure:
        return name
    let copy = alloc u8[spelled.length] catch failure:
        return name
    memory.copy(copy, spelled.bytes, spelled.length)
    return (str)copy

## The class a float conversion reads: `exth` a half, `exts` and `truncs` a single, `truncd` a double.
func float_source_class(op: ir.Op) -> ir.Class:
    match op:
        .exth: return ir.Class.h
        .exts, .truncs: return ir.Class.s
        _: return ir.Class.d

## The class whose bits `cast` moves into `cls`: the integer as wide as a float, and back.
func cast_partner(cls: ir.Class) -> ir.Class:
    match cls:
        .h, .s: return ir.Class.w
        .d: return ir.Class.l
        .w: return ir.Class.s
        _: return ir.Class.d

## The class a load produces.
func load_class(op: ir.Op) -> ir.Class:
    match op:
        .loadsb, .loadub, .loadsh, .loaduh, .loaduw: return ir.Class.w
        .loadsw, .loadl: return ir.Class.l
        .loads: return ir.Class.s
        .loadhf: return ir.Class.h
        _: return ir.Class.d

func load_mnemonic(op: ir.Op) -> str:
    match op:
        .loadsb: return "movsbl "
        .loadub: return "movzbl "
        .loadsh: return "movswl "
        .loaduh: return "movzwl "
        .loadsw: return "movslq "
        .loaduw: return "movl "
        .loads: return "movss "
        .loadd: return "movsd "
        _: return "movq "

func store_mnemonic(op: ir.Op) -> str:
    match op:
        .storew: return "movl "
        .stores: return "movss "
        .stored: return "movsd "
        _: return "movq "

func store_class(op: ir.Op) -> ir.Class:
    match op:
        .storeb, .storeh, .storew: return ir.Class.w
        .stores: return ir.Class.s
        .stored: return ir.Class.d
        .storehf: return ir.Class.h
        _: return ir.Class.l

func round_up(value: u64, align: u64) -> u64:
    if align <= 1:
        return value
    return (value + align - 1) // align * align

func log2(value: u64) -> u64:
    var n: u64 = 0
    var v = value
    while v > 1:
        v = v // 2
        n += 1
    return n

## A leaf not aligned to its own size: a packed record's field, which makes the whole
## aggregate MEMORY class (System V §3.2.3).
func has_unaligned_leaf(leaves: const ir.Leaf[]) -> bool:
    for leaf in leaves:
        if leaf.size > 1 and (u64)leaf.offset % (u64)leaf.size != 0:
            return true
    return false

test "a packed aggregate with a misaligned field is MEMORY class at any size":
    var backing: u8[1048576]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var u = try ir.Unit.create()
        # { u8 tag; u64 value } packed: nine bytes, the u64 at offset 1
        let packed_start = u.leaves.count
        try u.leaves.push(ir.Leaf(offset = 0, size = 1, cls = ir.Class.w))
        try u.leaves.push(ir.Leaf(offset = 1, size = 8, cls = ir.Class.l))
        let packed = try u.shape_from(packed_start)
        # { u16 a; u32 b } packed: six bytes, the u32 at offset 2
        let small_start = u.leaves.count
        try u.leaves.push(ir.Leaf(offset = 0, size = 2, cls = ir.Class.w))
        try u.leaves.push(ir.Leaf(offset = 2, size = 4, cls = ir.Class.w))
        let small = try u.shape_from(small_start)
        # { u8 tag; u64 value } with padding: sixteen bytes, two INTEGER eightbytes
        let padded_start = u.leaves.count
        try u.leaves.push(ir.Leaf(offset = 0, size = 1, cls = ir.Class.w))
        try u.leaves.push(ir.Leaf(offset = 8, size = 8, cls = ir.Class.l))
        let padded = try u.shape_from(padded_start)
        # { f32 x; f32 y }: one SSE eightbyte
        let point_start = u.leaves.count
        try u.leaves.push(ir.Leaf(offset = 0, size = 4, cls = ir.Class.s))
        try u.leaves.push(ir.Leaf(offset = 4, size = 4, cls = ir.Class.s))
        let point = try u.shape_from(point_start)
        var g = try Generator.create(&u)
        assert(g.in_memory(9, packed))
        assert(g.in_memory(6, small))
        assert(not g.in_memory(16, padded))
        assert(not g.in_memory(8, point))
        assert(g.in_memory(24, 0))
        assert(not g.in_memory(0, 0))
        assert(g.sse_of(ir.Class.l, 8, point) == 1)
        assert(g.sse_of(ir.Class.l, 16, padded) == 0)
        var next_int: u32 = 0
        var next_float: u32 = 0
        var stack: u32 = 0
        let placed = g.place(ir.Arg(value = ir.none_ref(), cls = ir.Class.l, size = 9, align = 1, type_id = 0, shape = packed), &next_int, &next_float, &stack)
        assert(placed.where == 2)
        assert(next_int == 0)
        assert(stack == 16)
        let in_registers = g.place(ir.Arg(value = ir.none_ref(), cls = ir.Class.l, size = 16, align = 8, type_id = 0, shape = padded), &next_int, &next_float, &stack)
        assert(in_registers.where == 0)
        assert(next_int == 2)

test "immediates, views, and byte moves assemble":
    var backing: u8[1048576]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var u = try ir.Unit.create()
        var g = try Generator.create(&u)
        try g.load_immediate("%rax", 0)
        try g.load_immediate("%eax", -5)
        try g.load_immediate("%rax", 70000)
        try g.load_immediate("%rax", 4890909195324358656)
        try g.frame_address("%rax", 5000)
        try g.load_bytes("%rax", "%r10", 8, 3)
        try g.store_bytes("%rax", "%r10", 8, 7)
        let text = g.text()
        assert(text.length > 0)
        assert(narrow_name("%r12") == "%r12d")
        assert(byte_name("%rsi") == "%sil")
        assert(word_name("%eax") == "%ax")
        assert(wide_name("%ecx") == "%rcx")
        assert(register_of_width("%rdx", 1) == "%dl")
        assert(count_bits(3) == 2)
        assert(with_percent("rdi") == "%rdi")
        assert(with_percent("%xmm8") == "%xmm8")

## The move of a vector of `bytes` between memory and a register: unaligned, a quadword for
## the eight-byte form.
func vector_move(bytes: u32) -> str:
    return "movdqu " if bytes == 16 else "movq "

## `padd` on lanes of `bits`: `paddb`, `paddw`, `paddd`, `paddq`.
func lane_mnemonic(base: str, bits: u32) -> str:
    if base == "padd":
        return "paddb" if bits == 8 else ("paddw" if bits == 16 else ("paddd" if bits == 32 else "paddq"))
    if base == "psub":
        return "psubb" if bits == 8 else ("psubw" if bits == 16 else ("psubd" if bits == 32 else "psubq"))
    if base == "padds":
        return "paddsb" if bits == 8 else "paddsw"
    if base == "paddus":
        return "paddusb" if bits == 8 else "paddusw"
    if base == "psubs":
        return "psubsb" if bits == 8 else "psubsw"
    return "psubusb" if bits == 8 else "psubusw"

## The two-operand SSE2 instruction of a vector operation on lanes of `shape`.
func vector_mnemonic(op: ir.Op, shape: u32) -> str:
    let bits = ir.lane_bits(shape)
    let signed = ir.lanes_signed(shape)
    let wide = bits == 64
    match op:
        .vadd: return "addpd" if wide else "addps"
        .vsub: return "subpd" if wide else "subps"
        .vmul: return "mulpd" if wide else "mulps"
        .vdiv: return "divpd" if wide else "divps"
        .vand: return "pand"
        .vor: return "por"
        .vxor: return "pxor"
        .vaddw: return lane_mnemonic("padd", bits)
        .vsubw: return lane_mnemonic("psub", bits)
        .vmulw: return "pmullw"
        .vadds: return lane_mnemonic("padds" if signed else "paddus", bits)
        .vsubs: return lane_mnemonic("psubs" if signed else "psubus", bits)
        _: return "paddb"

## Half-float conversion without F16C, for levels below x86-64-v3: `eax` in, `eax` out,
## `ecx`, `edx`, `r10d`, and `r11d` clobbered, nothing on the stack but the return address.
## The single of a half: sign moved up, a normal half's exponent rebiased from 15 to 127, a
## subnormal's mantissa normalised by its top bit (`bsr`), infinity kept, NaN with the payload
## widened and made quiet, as the hardware conversion does. The half of a single, rounding to nearest even as the C compiler's `_Float16`
## does: NaN kept quiet with its payload narrowed, 65520 and above to infinity, a normal
## half from the rebiased exponent with the thirteen dropped bits deciding the rounding,
## a subnormal half from the mantissa with its implicit bit shifted right by the exponent's
## shortfall, and everything below 2^-25 to zero.
let half_routines_text: str = """
    .text
    .p2align 4
.Llb_half_to_single:
    movzwl %ax, %eax
    movl %eax, %edx
    andl $32768, %edx
    shll $16, %edx
    andl $32767, %eax
    cmpl $31744, %eax
    jae 2f
    testl $31744, %eax
    je 3f
    addl $114688, %eax
    shll $13, %eax
    orl %edx, %eax
    ret
2:
    andl $1023, %eax
    je 11f
    shll $13, %eax
    orl $2143289344, %eax
    orl %edx, %eax
    ret
11:
    movl $2139095040, %eax
    orl %edx, %eax
    ret
3:
    testl %eax, %eax
    jne 4f
    movl %edx, %eax
    ret
4:
    movl %eax, %r11d
    bsrl %eax, %ecx
    movl %ecx, %eax
    addl $103, %eax
    shll $23, %eax
    orl %edx, %eax
    negl %ecx
    addl $23, %ecx
    shll %cl, %r11d
    andl $8388607, %r11d
    orl %r11d, %eax
    ret
    .p2align 4
.Llb_single_to_half:
    movl %eax, %edx
    shrl $16, %edx
    andl $32768, %edx
    andl $2147483647, %eax
    cmpl $2139095040, %eax
    jb 2f
    movl %eax, %ecx
    andl $8388607, %ecx
    je 5f
    shrl $13, %ecx
    orl $512, %ecx
    orl $31744, %ecx
    movl %ecx, %eax
    orl %edx, %eax
    ret
5:
    movl $31744, %eax
    orl %edx, %eax
    ret
2:
    cmpl $1199566848, %eax
    jb 6f
    movl $31744, %eax
    orl %edx, %eax
    ret
6:
    cmpl $947912704, %eax
    jb 7f
    subl $939524096, %eax
    movl %eax, %ecx
    andl $8191, %ecx
    shrl $13, %eax
    cmpl $4096, %ecx
    jb 8f
    ja 9f
    testl $1, %eax
    je 8f
9:
    incl %eax
8:
    orl %edx, %eax
    ret
7:
    cmpl $855638016, %eax
    jb 10f
    movl %eax, %ecx
    shrl $23, %ecx
    andl $8388607, %eax
    orl $8388608, %eax
    movl %eax, %r11d
    negl %ecx
    addl $126, %ecx
    shrl %cl, %eax
    movl %eax, %r10d
    shll %cl, %r10d
    subl %r10d, %r11d
    decl %ecx
    movl $1, %r10d
    shll %cl, %r10d
    cmpl %r10d, %r11d
    jb 8b
    ja 9b
    testl $1, %eax
    je 8b
    jmp 9b
10:
    movl %edx, %eax
    ret
"""
