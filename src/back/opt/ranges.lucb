#==============================================================================================
#
#   ranges - Range facts about SSA values
#
#   DESCRIPTION:
#       Facts about immutable SSA values, scoped by dominance. A successful bounds check
#       supplies a fact just like a branch does. Unknown ranges retain checks; this pass
#       never derives a fact about a memory location from an earlier load. Facts are
#       chained by their left and by their right operand, so a query reads the facts about
#       its operands rather than every fact in scope: a function with thousands of checks
#       builds in time near linear in them.
#
#==============================================================================================

import back.ir.cfg
import back.ir.ir
import support.list

# mark: Facts and the search ==================================================================

enum Relation as u8:
    less = 1
    at_most = 2
    equal = 3

struct Fact:
    var relation: Relation
    var cls: ir.Class
    var left: ir.Ref
    var right: ir.Ref
    ## The fact before this one with the same left, and with the same right, operand
    ## bucket; 1-based, 0 ends the chain.
    var next_left: u32
    var next_right: u32

## Operands other than temporaries share this many buckets, by kind and value.
let shared_buckets: usize = 256

## A multiplication that has already completed without overflow. Its factors
## bound smaller products and row-major indexes without requiring a constant
## dimension. The result remains an immutable SSA value.
struct Product:
    var cls: ir.Class
    var left: ir.Ref
    var right: ir.Ref
    var value: ir.Ref

## One block of the dominator-tree walk: the block, how many of its children were
## visited, and the facts' and products' counts before the block added its own.
struct RangeVisit:
    var block: u32
    var child: usize
    var mark: usize
    var product_mark: usize

struct Search:
    var f: ir.Function*
    var g: cfg.Graph*
    var definitions: u32[]
    var facts: list.List[Fact]
    ## The newest fact whose left, and whose right, operand falls in each bucket: one per
    ## temporary, then `shared_buckets` for the rest; 1-based, 0 when there is none.
    var left_heads: u32[]
    var right_heads: u32[]
    var products: list.List[Product]
    var changed: bool = false

    ## The chain bucket of operand `r`: its own for a temporary, a shared one otherwise.
    func bucket(r: ir.Ref) -> usize:
        let temps = self.left_heads.length - shared_buckets
        if r.kind == ir.RefKind.temp and (usize)r.index < temps:
            return (usize)r.index
        let mixed = ((u64)r.value +% (u64)(u8)r.kind) *% 11400714819323198485
        return temps + (usize)(mixed >> 56)

    ## Drop the facts after the first `mark`, newest first, restoring the chains.
    mutating func truncate(mark: usize):
        while self.facts.count > mark:
            let fact = self.facts.get(self.facts.count - 1)
            self.left_heads[self.bucket(fact.left)] = fact.next_left
            self.right_heads[self.bucket(fact.right)] = fact.next_right
            self.facts.count -= 1

    ## Equalities are followed only to a bounded depth. Exhausting the search
    ## loses an optimization, never a check that would have been necessary.
    func equal(a: ir.Ref, b: ir.Ref, cls: ir.Class, depth: u32 = 0) -> bool:
        if same(a, b):
            return true
        if depth >= 3:
            return false
        var at = self.left_heads[self.bucket(a)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_left
            if fact.relation == Relation.equal and fact.cls == cls and same(a, fact.left) and self.equal(fact.right, b, cls, depth + 1):
                return true
        at = self.right_heads[self.bucket(a)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_right
            if fact.relation == Relation.equal and fact.cls == cls and same(a, fact.right) and self.equal(fact.left, b, cls, depth + 1):
                return true
        return false

    func upper(value: ir.Ref, cls: ir.Class, depth: u32 = 0) -> u64:
        let maximum = limit(cls)
        if value.kind == ir.RefKind.constant:
            return bits(value, cls)
        if depth >= 4:
            return maximum
        var result = maximum
        if value.kind == ir.RefKind.temp and self.definitions[value.index] != 0:
            let definition = self.f.instrs.get(self.definitions[value.index] - 1)
            if definition.op == ir.Op.extub:
                result = 255
            elif definition.op == ir.Op.extuh:
                result = 65535
            elif definition.op == ir.Op.extuw:
                result = self.upper(definition.a, ir.Class.w, depth + 1)
            elif definition.op == ir.Op.and_ and definition.b.kind == ir.RefKind.constant:
                result = bits(definition.b, cls)
        var at = self.left_heads[self.bucket(value)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_left
            if fact.cls == cls and same(value, fact.left):
                var bound = self.upper(fact.right, cls, depth + 1)
                if fact.relation == Relation.less and bound > 0:
                    bound -= 1
                if bound < result:
                    result = bound
        at = self.right_heads[self.bucket(value)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_right
            if fact.relation == Relation.equal and fact.cls == cls and same(value, fact.right):
                let bound = self.upper(fact.left, cls, depth + 1)
                if bound < result:
                    result = bound
        return result

    func at_most(a: ir.Ref, b: ir.Ref, cls: ir.Class, strict: bool, depth: u32 = 0) -> bool:
        if a.kind == ir.RefKind.constant and b.kind == ir.RefKind.constant:
            return bits(a, cls) < bits(b, cls) if strict else bits(a, cls) <= bits(b, cls)
        if not strict and self.equal(a, b, cls):
            return true
        if b.kind == ir.RefKind.constant:
            let high = self.upper(a, cls)
            if high < bits(b, cls) or (not strict and high == bits(b, cls)):
                return true
        if depth >= 3:
            return false
        if self.bounded_through(a, a, b, cls, strict, depth, 0):
            return true
        var at = self.right_heads[self.bucket(a)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_right
            if fact.relation == Relation.equal and fact.cls == cls and same(a, fact.right):
                if self.at_most(fact.left, b, cls, strict, depth + 1):
                    return true
        return false

    ## Whether a fact whose left is `x`, a value `equal` to `a` within three equalities
    ## (`hops` taken so far), bounds `a` by `b`: the facts `at_most` would find by asking
    ## `equal(a, fact.left)` of every fact, reached through the chains instead.
    func bounded_through(x: ir.Ref, a: ir.Ref, b: ir.Ref, cls: ir.Class, strict: bool, depth: u32, hops: u32) -> bool:
        var at = self.left_heads[self.bucket(x)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_left
            if fact.cls == cls and same(x, fact.left):
                if self.at_most(fact.right, b, cls, strict and fact.relation != Relation.less, depth + 1):
                    return true
        if hops >= 3:
            return false
        at = self.left_heads[self.bucket(x)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_left
            if fact.relation == Relation.equal and fact.cls == cls and same(x, fact.left) and self.bounded_through(fact.right, a, b, cls, strict, depth, hops + 1):
                return true
        at = self.right_heads[self.bucket(x)]
        while at != 0:
            let fact = self.facts.get((usize)at - 1)
            at = fact.next_right
            if fact.relation == Relation.equal and fact.cls == cls and same(x, fact.right) and self.bounded_through(fact.left, a, b, cls, strict, depth, hops + 1):
                return true
        return false

    mutating func add(relation: Relation, cls: ir.Class, left: ir.Ref, right: ir.Ref) -> !:
        if same(left, right):
            return
        let l = self.bucket(left)
        let r = self.bucket(right)
        try self.facts.push(Fact(relation = relation, cls = cls, left = left, right = right, next_left = self.left_heads[l], next_right = self.right_heads[r]))
        self.left_heads[l] = (u32)self.facts.count
        self.right_heads[r] = (u32)self.facts.count

    func product_fits(a: ir.Ref, b: ir.Ref, cls: ir.Class) -> bool:
        for product in self.products.span():
            if product.cls != cls:
                continue
            if (self.at_most(a, product.left, cls, false) and self.at_most(b, product.right, cls, false)) or (self.at_most(a, product.right, cls, false) and self.at_most(b, product.left, cls, false)):
                return true
        return false

    ## row * width + column < rows * width when row < rows and
    ## column < width. The checked product supplies the finite upper bound.
    func packed(a: ir.Ref, b: ir.Ref, product: Product) -> bool:
        if a.kind != ir.RefKind.temp or self.definitions[a.index] == 0:
            return false
        let multiply = self.f.instrs.get(self.definitions[a.index] - 1)
        if multiply.cls != product.cls or (multiply.op != ir.Op.mul and not (multiply.op == ir.Op.mulo and multiply.extra == 0)):
            return false
        return self.row(multiply.a, multiply.b, b, product.left, product.right, product.cls) or self.row(multiply.b, multiply.a, b, product.left, product.right, product.cls) or self.row(multiply.a, multiply.b, b, product.right, product.left, product.cls) or self.row(multiply.b, multiply.a, b, product.right, product.left, product.cls)

    func row(index: ir.Ref, stride: ir.Ref, column: ir.Ref, rows: ir.Ref, width: ir.Ref, cls: ir.Class) -> bool:
        return self.equal(stride, width, cls) and self.at_most(index, rows, cls, true) and self.at_most(column, width, cls, true)

    func sum_fits(a: ir.Ref, b: ir.Ref, cls: ir.Class) -> bool:
        for product in self.products.span():
            if product.cls == cls and (self.packed(a, b, product) or self.packed(b, a, product)):
                return true
        return false

    func packed_bound(index: ir.Ref, length: ir.Ref) -> bool:
        if index.kind != ir.RefKind.temp or self.definitions[index.index] == 0:
            return false
        let sum = self.f.instrs.get(self.definitions[index.index] - 1)
        if sum.cls != ir.Class.l or (sum.op != ir.Op.add and not (sum.op == ir.Op.addo and sum.extra == 0)):
            return false
        for product in self.products.span():
            if product.cls == ir.Class.l and self.equal(length, product.value, ir.Class.l) and (self.packed(sum.a, sum.b, product) or self.packed(sum.b, sum.a, product)):
                return true
        return false

    ## A single predecessor makes this incoming edge unavoidable. This excludes
    ## joins and loop headers whose backedges could bypass the tested condition.
    mutating func incoming(block: cfg.Block) -> !:
        if block.preds.count != 1:
            return
        let predecessor = self.g.blocks.get(block.preds.get(0))
        if predecessor.end <= predecessor.start:
            return
        let branch = self.f.instrs.get(predecessor.end - 1)
        if branch.op != ir.Op.jnz or branch.extra == branch.extra2 or branch.a.kind != ir.RefKind.temp:
            return
        let index = self.definitions[branch.a.index]
        if index == 0:
            return
        let comparison = self.f.instrs.get(index - 1)
        if comparison.cls != ir.Class.w and comparison.cls != ir.Class.l:
            return
        let yes = branch.extra == block.label
        let a = comparison.a
        let b = comparison.b
        match comparison.op:
            .cult: try self.add(Relation.less if yes else Relation.at_most, comparison.cls, a if yes else b, b if yes else a)
            .cule: try self.add(Relation.at_most if yes else Relation.less, comparison.cls, a if yes else b, b if yes else a)
            .cugt: try self.add(Relation.less if yes else Relation.at_most, comparison.cls, b if yes else a, a if yes else b)
            .cuge: try self.add(Relation.at_most if yes else Relation.less, comparison.cls, b if yes else a, a if yes else b)
            .ceq, .cne:
                if yes == (comparison.op == ir.Op.ceq):
                    try self.add(Relation.equal, comparison.cls, a, b)
            _: discard(0)

    ## Walk the dominator tree from block `root`: each block's facts hold in the blocks it
    ## dominates and are dropped after them. An explicit stack, not recursion, as in
    ## `gvn.number`: a long function is a long chain of blocks.
    mutating func visit(root: u32) -> !:
        var stack = try list.List[RangeVisit].create(64)
        defer stack.destroy()
        try stack.push(RangeVisit(block = root, child = 0, mark = self.facts.count, product_mark = self.products.count))
        try self.visit_block(root)
        while stack.count > 0:
            var top = stack.get(stack.count - 1)
            let block = self.g.blocks.get(top.block)
            if top.child < block.children.count:
                let child = block.children.get(top.child)
                top.child += 1
                stack.set(stack.count - 1, top)
                try stack.push(RangeVisit(block = child, child = 0, mark = self.facts.count, product_mark = self.products.count))
                try self.visit_block(child)
            else:
                self.truncate(top.mark)
                self.products.count = top.product_mark
                stack.count -= 1

    ## Take in block `index`'s incoming facts and its instructions' own, and drop the checks
    ## the facts make redundant.
    mutating func visit_block(index: u32) -> !:
        let block = self.g.blocks.get(index)
        try self.incoming(block)
        var at = block.start
        while at < block.end:
            var instruction = self.f.instrs.get(at)
            let checked_product = instruction.op == ir.Op.mulo and instruction.extra == 0
            if instruction.op == ir.Op.bounds:
                if self.at_most(instruction.a, instruction.b, ir.Class.l, true) or self.packed_bound(instruction.a, instruction.b):
                    # Keep graph instruction ranges stable until the walk ends.
                    instruction = ir.Instr(op = ir.Op.copy, cls = ir.Class.l, dst = 0, a = ir.none_ref(), b = ir.none_ref(), extra = 0, extra2 = 0, line = 0, file = 0, scope = 0, site = 0)
                    self.f.instrs.set(at, instruction)
                    self.changed = true
                else:
                    try self.add(Relation.less, ir.Class.l, instruction.a, instruction.b)
            elif (instruction.op == ir.Op.addo or instruction.op == ir.Op.subo or instruction.op == ir.Op.mulo) and instruction.extra == 0:
                let high_a = self.upper(instruction.a, instruction.cls)
                let high_b = self.upper(instruction.b, instruction.cls)
                let maximum = limit(instruction.cls)
                var safe = false
                var operation = ir.Op.add
                if instruction.op == ir.Op.addo:
                    safe = high_a <= maximum - high_b or self.sum_fits(instruction.a, instruction.b, instruction.cls)
                elif instruction.op == ir.Op.subo:
                    safe = self.at_most(instruction.b, instruction.a, instruction.cls, false)
                    operation = ir.Op.sub
                else:
                    safe = high_b == 0 or high_a <= maximum // high_b or self.product_fits(instruction.a, instruction.b, instruction.cls)
                    operation = ir.Op.mul
                if safe:
                    instruction.op = operation
                    instruction.extra = 0
                    instruction.extra2 = 0
                    self.f.instrs.set(at, instruction)
                    self.changed = true
            if checked_product:
                try self.products.push(Product(cls = instruction.cls, left = instruction.a, right = instruction.b, value = ir.temp_ref(instruction.dst)))
            at += 1

# mark: The pass ==============================================================================

## Run after value numbering/load forwarding, while temporaries still have one
## definition. The caller rebuilds its graph when instructions were removed.
pub func run(f: ir.Function*, g: cfg.Graph*) -> bool!:
    let buckets = f.temps.count + 1 + shared_buckets
    var search = Search(f = f, g = g, definitions = try alloc u32[f.temps.count + 1], facts = try list.List[Fact].create(32), left_heads = try alloc u32[buckets], right_heads = try alloc u32[buckets], products = try list.List[Product].create(8))
    defer free(search.definitions)
    defer free(search.left_heads)
    defer free(search.right_heads)
    for index in 0..<buckets:
        search.left_heads[index] = 0
        search.right_heads[index] = 0
    defer search.facts.destroy()
    defer search.products.destroy()
    for index in 0..<search.definitions.length:
        search.definitions[index] = 0
    for index in 0..<f.instrs.count:
        let instruction = f.instrs.get(index)
        if instruction.dst != 0:
            search.definitions[instruction.dst] = (u32)index + 1
    if g.count() > 0:
        try search.visit(0)
    if search.changed:
        var kept = try list.List[ir.Instr].create(f.instrs.count)
        for instruction in f.instrs.span():
            if instruction.op != ir.Op.copy or instruction.dst != 0:
                try kept.push(instruction)
        f.instrs.destroy()
        f.instrs = kept
    return search.changed

func same(a: ir.Ref, b: ir.Ref) -> bool:
    return a.kind == b.kind and a.index == b.index and a.value == b.value and a.name == b.name

func limit(cls: ir.Class) -> u64:
    return 4294967295 if cls == ir.Class.w else 18446744073709551615

func bits(value: ir.Ref, cls: ir.Class) -> u64:
    return (u64)(u32)value.value if cls == ir.Class.w else (u64)value.value
