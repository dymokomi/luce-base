#==============================================================================================
#
#   inline - Small functions expanded at their call sites, on the IR
#
#   DESCRIPTION:
#       After lowering and before a target sees the program, every call of a small function
#       of the program is replaced by the function's body: the arguments are stored into the
#       callee's parameter slots, which join the caller's frame, the body's temporaries,
#       slots, and labels are renumbered into the caller's, and each `ret` becomes a store
#       of the result and a jump to one exit label. The callee itself stays in the program for
#       the calls that are not expanded and for its address.
#
#       A function is small when its body has at most `small` instructions besides labels,
#       measured after its own calls were expanded: callees are visited before callers. A
#       function called from one place only is expanded there whatever its size up to
#       `once`, and a function expanded at every call, which nothing else names, is dropped
#       from the program. Not expanded: a variadic or naked function, one carrying inline
#       assembly, atomics, or the debugger's hooks, and a function calling itself. The
#       lowerer's discipline that a temporary is used in the block that assigned it is not
#       kept across an expansion, which the register allocator does not need: it scans live
#       ranges by instruction index and extends them across loop back-edges.
#
#==============================================================================================

import memory
import support.list
import back.ir.ir

## The most instructions, labels aside, a function may have to be expanded at every call,
## and the most one called from one place only may have: it is expanded there, and when
## nothing else names it, dropped. Larger callees were measured on the compiler itself:
## expanding bodies of up to 64 instructions at up to four calls each grew its code by a
## tenth and made it no faster.
let small: usize = 24
let once: usize = 256

## Expand the expandable calls of `program`: callees before callers, so that a function
## reaching the callers has its own calls opened out already and is measured as it will
## stand; then drop the functions that were expanded everywhere they were called.
pub func expand(program: ir.Unit*) -> !:
    var index = try Index.over(program)
    defer index.release()
    var census = try Census.over(program, &index)
    defer census.release()
    let order = try post_order(program, &index)
    defer free(order)
    for fi in order:
        try expand_in(program, &index, &census, fi)
    try drop_expanded(program, &index, &census)
    # Keep the inliner's call-count heuristics independent of optional standard
    # modules. Pruning first could turn shared helpers into larger caller bodies.
    try drop_unused_standard(program)

## Retain standard functions reachable from application code, initializers,
## witness tables, assembly, and explicit retention attributes. User/package
## functions keep their existing linkage. In particular, merely embedding the
## window module must not require AppKit in a console program or a Linux build.
## Function addresses are graph edges too: native callbacks remain callable.
func drop_unused_standard(program: ir.Unit*) -> !:
    var index = try Index.over(program)
    defer index.release()
    let count = program.functions.count
    let retained = try alloc bool[count + 1]
    defer free(retained)
    clear_flags(retained)
    var texts = try asm_texts_of(program)
    defer texts.destroy()
    var i: usize = 0
    while i < count:
        let f = &program.functions.items[i]
        retained[i] = not f.standard or f.exported or f.used or f.weak or f.naked or f.section.length > 0 or f.name == program.init_function or f.name == program.trap_function or f.name == program.trap_at_function or f.name == program.trap_two_at_function or named_in_asm(&texts, f.name)
        i += 1
    for table in program.tables.span():
        for name in table.entries.span():
            if let position = index.find(name):
                retained[position] = true
    let visited = try alloc bool[count + 1]
    defer free(visited)
    clear_flags(visited)
    var changed = true
    while changed:
        changed = false
        i = 0
        while i < count:
            if retained[i] and not visited[i]:
                visited[i] = true
                changed = true
                let f = &program.functions.items[i]
                for instruction in f.instrs.span():
                    note_reference(&index, retained, instruction.a)
                    note_reference(&index, retained, instruction.b)
                for argument in f.args.span():
                    note_reference(&index, retained, argument.value)
            i += 1
    var kept = try list.List[ir.Function].create(count)
    i = 0
    while i < count:
        var f = program.functions.get(i)
        if retained[i]:
            try kept.push(f)
        else:
            f.points.destroy()
            f.debug_scopes.destroy()
            f.locals.destroy()
            f.params.destroy()
            f.slots.destroy()
            f.instrs.destroy()
            f.args.destroy()
            f.calls.destroy()
            f.temps.destroy()
            f.phi_args.destroy()
        i += 1
    program.functions.destroy()
    program.functions = kept

## The functions in an order that puts every callee before its callers, cycles apart: a
## depth-first walk of the call graph from each function, finishing a function after the
## functions it calls.
func post_order(program: ir.Unit*, index: Index*) -> usize[]!:
    let n = program.functions.count
    var order = try alloc usize[n + 1]
    var state = try alloc u8[n + 1]
    defer free(state)
    var stack = try alloc usize[n + 1]
    defer free(stack)
    var cursor = try alloc usize[n + 1]
    defer free(cursor)
    memory.set(state, 0)
    var count: usize = 0
    var root: usize = 0
    while root < n:
        if state[root] != 0:
            root += 1
            continue
        var depth: usize = 1
        stack[0] = root
        cursor[0] = 0
        state[root] = 1
        while depth > 0:
            let fi = stack[depth - 1]
            let f = &program.functions.items[fi]
            var pushed = false
            while cursor[depth - 1] < f.instrs.count:
                let ins = f.instrs.get(cursor[depth - 1])
                cursor[depth - 1] += 1
                if ins.op == ir.Op.call and ins.a.kind == ir.RefKind.function:
                    if let gi = index.find(ins.a.name):
                        if state[gi] == 0:
                            state[gi] = 1
                            stack[depth] = gi
                            cursor[depth] = 0
                            depth += 1
                            pushed = true
                            break
            if not pushed:
                state[fi] = 2
                order[count] = fi
                count += 1
                depth -= 1
        root += 1
    return order[0..<count]

## Rebuild function `fi`'s instruction list with its expandable calls opened out. The
## expansions of one callee in one caller share the callee's slots: an expansion's slots
## are dead past its exit, so the next expansion may have them.
func expand_in(program: ir.Unit*, index: Index*, census: Census*, fi: usize) -> !:
    var f = &program.functions.items[fi]
    if f.debug or not has_expandable_call(program, index, census, fi):
        return
    var out = Sink(instrs = try list.List[ir.Instr].create(f.instrs.count + 64))
    var bases = try alloc u32[program.functions.count + 1]
    defer free(bases)
    var k: usize = 0
    while k < bases.length:
        bases[k] = no_slots
        k += 1
    var ix: usize = 0
    while ix < f.instrs.count:
        let n = f.instrs.get(ix)
        ix += 1
        if let gi = expandable_callee(program, index, census, fi, n):
            var expansion = Expansion.of(f, &program.functions.items[gi], n, bases[gi])
            try expansion.run(&out)
            bases[gi] = expansion.slot_base
            census.expanded[gi] = true
        else:
            try out.push(n)
    f.instrs.destroy()
    f.instrs = out.instrs
    census.sizes[fi] = unknown

## Whether any call of function `fi` can be expanded, so functions without one are left alone.
func has_expandable_call(program: ir.Unit*, index: Index*, census: Census*, fi: usize) -> bool:
    let f = &program.functions.items[fi]
    var ix: usize = 0
    while ix < f.instrs.count:
        if expandable_callee(program, index, census, fi, f.instrs.get(ix)) != none:
            return true
        ix += 1
    return false

## The index of the function that call `n` in function `fi` may be expanded with: a small
## function, or one this call alone reaches and nothing else names.
func expandable_callee(program: ir.Unit*, index: Index*, census: Census*, fi: usize, n: ir.Instr) -> usize?:
    if n.op != ir.Op.call or n.a.kind != ir.RefKind.function:
        return none
    let gi = index.find(n.a.name) else return none
    if gi == fi:
        return none
    let g = &program.functions.items[gi]
    let info = program.functions.items[fi].calls.get((usize)n.extra)
    if info.variadic or (usize)info.args_count != g.params.count:
        return none
    let size = try_size(census, program, gi) else return none
    if size <= small:
        return gi
    if size <= once and census.calls[gi] == 1 and not census.pinned[gi]:
        return gi
    return none

func try_size(census: Census*, program: ir.Unit*, gi: usize) -> usize?:
    return census.size_of(program, gi)

## How many instructions, labels aside, a function's body has; none when the body may not
## stand in for a call of it at all.
func body_size(g: ir.Function*) -> usize?:
    if g.variadic or g.naked or g.debug or g.instrs.count == 0:
        return none
    var count: usize = 0
    var ix: usize = 0
    while ix < g.instrs.count:
        let n = g.instrs.get(ix)
        ix += 1
        if n.op == ir.Op.label:
            continue
        if not is_expandable_op(n.op):
            return none
        count += 1
    return count

## Instructions an expansion knows how to renumber; the ones that reach outside the
## function's own temporaries, slots, and labels are left to a real call.
func is_expandable_op(op: ir.Op) -> bool:
    match op:
        .asm_, .set_reg, .get_reg, .frame, .fence, .fill, .atomic_load, .atomic_store, .atomic_add, .atomic_sub, .atomic_or, .atomic_and_not, .atomic_xor, .atomic_swap, .atomic_max, .atomic_min, .atomic_cas:
            return false
        _:
            return true

## Drop every function that was expanded at a call and that nothing names any more: not
## a call, not an address, not a witness table, not the object file.
func drop_expanded(program: ir.Unit*, index: Index*, census: Census*) -> !:
    var referenced = try alloc bool[program.functions.count + 1]
    defer free(referenced)
    clear_flags(referenced)
    var i: usize = 0
    while i < program.functions.count:
        let f = &program.functions.items[i]
        var ix: usize = 0
        while ix < f.instrs.count:
            let n = f.instrs.get(ix)
            ix += 1
            note_reference(index, referenced, n.a)
            note_reference(index, referenced, n.b)
        var k: usize = 0
        while k < f.args.count:
            note_reference(index, referenced, f.args.get(k).value)
            k += 1
        i += 1
    var kept = try list.List[ir.Function].create(program.functions.count)
    i = 0
    while i < program.functions.count:
        var f = program.functions.get(i)
        if census.expanded[i] and not census.pinned[i] and not referenced[i]:
            f.points.destroy()
            f.debug_scopes.destroy()
            f.locals.destroy()
            f.params.destroy()
            f.slots.destroy()
            f.instrs.destroy()
            f.args.destroy()
            f.calls.destroy()
            f.temps.destroy()
        else:
            try kept.push(f)
        i += 1
    program.functions.destroy()
    program.functions = kept

func clear_flags(flags: bool[]):
    var i: usize = 0
    while i < flags.length:
        flags[i] = false
        i += 1

func note_reference(index: Index*, referenced: bool[], r: ir.Ref):
    if r.kind != ir.RefKind.function:
        return
    if let gi = index.find(r.name):
        referenced[gi] = true

## No slots shared yet: the marker in `expand_in`'s table of slot bases.
let no_slots: u32 = 0xFFFFFFFF

# mark: The census =============================================================================

## What the program says of each function before any expansion: how many calls reach it,
## and whether it must stay whatever the calls say, because the object file, a witness
## table, an address taken, or assembly text names it.
struct Census:
    var calls: u32[]
    var pinned: bool[]
    var expanded: bool[]
    ## Each function's body size as last measured, `unknown` until it is; a function's size
    ## changes only when its own calls are expanded, which clears its entry.
    var sizes: u32[]

    static func over(program: ir.Unit*, index: Index*) -> Census!:
        let n = program.functions.count + 1
        var c = Census(calls = try alloc u32[n], pinned = try alloc bool[n], expanded = try alloc bool[n], sizes = try alloc u32[n])
        var z: usize = 0
        while z < n:
            c.calls[z] = 0
            c.sizes[z] = unknown
            z += 1
        clear_flags(c.pinned)
        clear_flags(c.expanded)
        var asm_texts = try asm_texts_of(program)
        defer asm_texts.destroy()
        var i: usize = 0
        while i < program.functions.count:
            let f = &program.functions.items[i]
            # the program's entry stays a function: a trace begins there
            if f.exported or f.used or f.weak or f.naked or f.section.length > 0 or f.name == program.init_function or f.name == program.trap_function or f.name == program.trap_at_function or f.name == program.trap_two_at_function or f.name == "lb_main":
                c.pinned[i] = true
            if named_in_asm(&asm_texts, f.name):
                c.pinned[i] = true
            var ix: usize = 0
            while ix < f.instrs.count:
                let ins = f.instrs.get(ix)
                ix += 1
                if ins.op == ir.Op.call and ins.a.kind == ir.RefKind.function:
                    if let gi = index.find(ins.a.name):
                        c.calls[gi] += 1
                else:
                    c.pin_named(index, ins.a)
                c.pin_named(index, ins.b)
            var k: usize = 0
            while k < f.args.count:
                c.pin_named(index, f.args.get(k).value)
                k += 1
            i += 1
        i = 0
        while i < program.tables.count:
            let table = program.tables.get(i)
            var e: usize = 0
            while e < table.entries.count:
                if let gi = index.find(table.entries.get(e)):
                    c.pinned[gi] = true
                e += 1
            i += 1
        return c

    func pin_named(index: Index*, r: ir.Ref):
        if r.kind != ir.RefKind.function:
            return
        if let gi = index.find(r.name):
            self.pinned[gi] = true

    ## The size of function `gi`'s body, measured once per shape of it.
    mutating func size_of(program: ir.Unit*, gi: usize) -> usize?:
        if self.sizes[gi] == unknown:
            if let measured = body_size(&program.functions.items[gi]):
                self.sizes[gi] = u32(measured)
            else:
                self.sizes[gi] = not_a_body
        if self.sizes[gi] == not_a_body:
            return none
        return (usize)self.sizes[gi]

    func release():
        free(self.calls)
        free(self.pinned)
        free(self.expanded)
        free(self.sizes)

## A body not measured yet, and one that may never stand in for a call.
let unknown: u32 = 0xFFFFFFFF
let not_a_body: u32 = 0xFFFFFFFE

## Every piece of assembly text in the program: the module-level blocks and the functions'.
func asm_texts_of(program: ir.Unit*) -> list.List[str]!:
    var texts = try list.List[str].create(8)
    var i: usize = 0
    while i < program.module_asm.count:
        try texts.push(program.module_asm.get(i).bytes)
        i += 1
    i = 0
    while i < program.functions.count:
        let f = &program.functions.items[i]
        var ix: usize = 0
        while ix < f.instrs.count:
            let ins = f.instrs.get(ix)
            ix += 1
            if ins.op == ir.Op.asm_ and ins.b.kind == ir.RefKind.text:
                try texts.push(program.texts.get((usize)ins.b.index).bytes)
        i += 1
    return texts

## Whether assembly text anywhere in the program spells `name`: a module-level block or a
## function's block may call or address a function of the program by its symbol.
func named_in_asm(texts: list.List[str]*, name: str) -> bool:
    var i: usize = 0
    while i < texts.count:
        if contains(texts.get(i), name):
            return true
        i += 1
    return false

func contains(text: str, name: str) -> bool:
    if name.length == 0 or name.length > text.length:
        return false
    var i: usize = 0
    while i + name.length <= text.length:
        if (str)text.bytes[i..<i + name.length] == name:
            return true
        i += 1
    return false

## The instruction list being built for a function.
struct Sink:
    var instrs: ir.Instrs

    mutating func push(n: ir.Instr) -> !:
        try self.instrs.push(n)

# mark: One expansion ==========================================================================

## The renumbering of one callee body into one caller, at one call.
struct Expansion:
    var f: ir.Function*
    var g: ir.Function*
    var call: ir.Instr
    var info: ir.CallInfo
    ## The caller's counts before the body joined it: what the body's numbers shift by.
    var slot_base: u32
    var temp_base: u32
    var label_base: u32
    ## Where the body's `ret` jumps to, and the slot a scalar result passes through.
    var exit_label: u32
    var result_slot: u32
    ## Whether the body's slots are an earlier expansion's, already in the caller's frame.
    var shares_slots: bool

    static func of(f: ir.Function*, g: ir.Function*, call: ir.Instr, shared: u32) -> Expansion:
        return Expansion(f = f, g = g, call = call, info = f.calls.get((usize)call.extra),
                         slot_base = u32(f.slots.count) if shared == no_slots else shared,
                         temp_base = u32(f.temps.count), label_base = f.labels, exit_label = 0, result_slot = 0,
                         shares_slots = shared != no_slots)

    mutating func run(out: Sink*) -> !:
        try self.join_frames()
        try self.bind_parameters(out)
        var ix: usize = 0
        while ix < self.g.instrs.count:
            try self.copy_instr(self.g.instrs.get(ix), out)
            ix += 1
        try out.push(ir.Instr(op = ir.Op.label, cls = ir.Class.l, dst = 0, a = ir.none_ref(), b = ir.none_ref(), extra = self.exit_label, extra2 = 0))
        try self.take_result(out)

    ## The callee's slots and temporaries join the caller's; its labels get fresh numbers,
    ## plus one for the exit; a scalar result gets a slot to cross the exit through.
    mutating func join_frames() -> !:
        var i: usize = 0
        while i < self.g.slots.count and not self.shares_slots:
            try self.f.slots.push(self.g.slots.get(i))
            i += 1
        i = 0
        while i < self.g.temps.count:
            try self.f.temps.push(self.g.temps.get(i))
            i += 1
        self.f.labels += self.g.labels
        self.exit_label = self.f.label()
        if self.info.has_result and self.info.result_size == 0:
            self.result_slot = try self.f.slot(8, 8)

    ## Each argument lands in its parameter's slot: a scalar by a store, a record by a copy.
    func bind_parameters(out: Sink*) -> !:
        var i: usize = 0
        while i < self.g.params.count:
            let p = self.g.params.get(i)
            let a = self.f.args.get((usize)self.info.args_start + i)
            let target = ir.slot_ref(self.slot_base + p.slot)
            if p.size == 0:
                try out.push(ir.Instr(op = store_op(p.cls), cls = ir.Class.l, dst = 0, a = a.value, b = target, extra = 0, extra2 = 0))
            else:
                try out.push(ir.Instr(op = ir.Op.blit, cls = ir.Class.l, dst = 0, a = target, b = a.value, extra = p.size, extra2 = 0))
            i += 1

    ## The caller's destination takes the result from its slot, after the exit label.
    func take_result(out: Sink*) -> !:
        if self.result_slot == 0 or self.call.dst == 0:
            return
        let cls = self.info.result_cls
        try out.push(ir.Instr(op = load_op(cls), cls = cls, dst = self.call.dst, a = ir.slot_ref(self.result_slot), b = ir.none_ref(), extra = 0, extra2 = 0))

    ## One instruction of the body, renumbered; `ret` becomes the result's store and the exit.
    mutating func copy_instr(n: ir.Instr, out: Sink*) -> !:
        var m = n
        if m.dst != 0:
            m.dst += self.temp_base
        m.a = self.renumber(m.a)
        m.b = self.renumber(m.b)
        match m.op:
            .label, .jmp:
                m.extra += self.label_base
            .jnz:
                m.extra += self.label_base
                m.extra2 += self.label_base
            .call:
                m.extra = try self.copy_call(m.extra)
            .ret:
                try self.leave(m.a, out)
                return
            _:
                discard(0)
        try out.push(m)

    ## A `ret a` of the body: the value goes to where the caller expects it, then the exit.
    func leave(value: ir.Ref, out: Sink*) -> !:
        if self.info.has_result:
            if self.info.result_size == 0:
                try out.push(ir.Instr(op = store_op(self.info.result_cls), cls = ir.Class.l, dst = 0, a = value, b = ir.slot_ref(self.result_slot), extra = 0, extra2 = 0))
            else:
                # a record result is built where the caller's call sequence would have put it
                try out.push(ir.Instr(op = ir.Op.blit, cls = ir.Class.l, dst = 0, a = ir.slot_ref(self.info.result_slot), b = value, extra = self.info.result_size, extra2 = 0))
        try out.push(ir.Instr(op = ir.Op.jmp, cls = ir.Class.l, dst = 0, a = ir.none_ref(), b = ir.none_ref(), extra = self.exit_label, extra2 = 0))

    ## A call inside the body: its description and arguments join the caller's lists.
    func copy_call(extra: u32) -> u32!:
        var info = self.g.calls.get((usize)extra)
        let start = u32(self.f.args.count)
        var k: u32 = 0
        while k < info.args_count:
            var a = self.g.args.get((usize)(info.args_start + k))
            a.value = self.renumber(a.value)
            try self.f.args.push(a)
            k += 1
        info.args_start = start
        if info.has_result and info.result_size > 0:
            info.result_slot += self.slot_base
        try self.f.calls.push(info)
        return u32(self.f.calls.count - 1)

    ## A reference of the body as the caller numbers it.
    func renumber(r: ir.Ref) -> ir.Ref:
        var out = r
        if r.kind == ir.RefKind.temp:
            out.index += self.temp_base
        elif r.kind == ir.RefKind.slot:
            out.index += self.slot_base
        return out

## The store and load that move a scalar of class `cls` through an eight-byte slot.
func store_op(cls: ir.Class) -> ir.Op:
    match cls:
        .w: return ir.Op.storew
        .l: return ir.Op.storel
        .s: return ir.Op.stores
        .h: return ir.Op.storehf
        _: return ir.Op.stored

func load_op(cls: ir.Class) -> ir.Op:
    match cls:
        .w: return ir.Op.loaduw
        .l: return ir.Op.loadl
        .s: return ir.Op.loads
        .h: return ir.Op.loadhf
        _: return ir.Op.loadd

# mark: Finding functions by name ==============================================================

## The program's functions by symbol, in an open-addressing table of index + 1 (0 is empty).
struct Index:
    var buckets: u32[]
    var program: ir.Unit*

    static func over(program: ir.Unit*) -> Index!:
        var room: usize = 64
        while room < program.functions.count * 2:
            room *= 2
        var index = Index(buckets = try alloc u32[room], program = program)
        var i: usize = 0
        while i < room:
            index.buckets[i] = 0
            i += 1
        i = 0
        while i < program.functions.count:
            var at = (usize)hash_text(program.functions.items[i].name) & (room - 1)
            while index.buckets[at] != 0:
                at = (at + 1) & (room - 1)
            index.buckets[at] = u32(i) + 1
            i += 1
        return index

    func find(name: str) -> usize?:
        let mask = self.buckets.length - 1
        var at = (usize)hash_text(name) & mask
        while self.buckets[at] != 0:
            let i = (usize)self.buckets[at] - 1
            if self.program.functions.items[i].name == name:
                return i
            at = (at + 1) & mask
        return none

    func release():
        free(self.buckets)

func hash_text(text: str) -> u64:
    var h: u64 = 0xcbf29ce484222325
    for byte in text.bytes:
        h = (h ^ (u64)byte) *% 0x100000001b3
    return h
