#==============================================================================================
#
#   emit - The C backend
#
#   DESCRIPTION:
#       Turns a checked program into one C translation unit over the runtime in `runtime`
#       (base.md §19). Every function body is streamed into a buffer as it is walked; the
#       typedefs, prototypes, globals, and witness tables it turned out to need are written
#       afterwards, ahead of the bodies, so nothing is ever generated twice.
#
#       Generic code is monomorphised here (§13): a call to a generic function or a use of a
#       generic type registers an instance, and instances are emitted from a worklist until
#       none are left, each with its arguments substituted into every type the body names.
#       The standard modules keep no bodies; their declarations are mapped onto the runtime
#       (§16.6), the same contract the seed's backend used, so one runtime serves both.
#
#       Values change representation only where the checker allowed a conversion: a pointer
#       becomes an interface view, an array a span, a value its optional, text a byte span.
#       `value` writes an expression as the type its context wants, and every site that
#       may convert goes through it.
#
#==============================================================================================

import c
import back.names
import front.ast
import sema.check
import sema.types
import support.buffer
import support.list

pub let backend: ErrorCode = ErrorCode.package(12)

## A tree node held in a list, and one that may be absent.
type NodeRef = ast.Node*
type MaybeNode = ast.Node*?

# mark: Instances and scopes ===================================================================

## One monomorphised function or record: a declaration with concrete type arguments.
struct Instance:
    var decl: ast.Node*
    var args: u32[]
    ## For a method of a generic record: the record and its arguments.
    var owner: ast.Node*?
    var owner_args: u32[]
    var done: bool

## A witness table the program needs: one record viewed as one interface.
struct Witness:
    var record: u32
    var iface: u32

## One lexical scope while emitting a body: the deferred calls registered in it,
## whether it is a loop (and its label), and whether it restored an allocator.
struct Scope:
    var defer_base: usize
    var loop: bool
    var label: str
    var restore_alloc: bool
    var alloc_save: u32

## The buffer `put` writes to.
let to_out: u8 = 0
let to_body: u8 = 1
let to_globals: u8 = 2
let to_protos: u8 = 3

# mark: The emitter ============================================================================

pub struct Emitter:
    var c: check.Checker*
    var out: buffer.Buffer
    var body: buffer.Buffer
    var globals: buffer.Buffer
    var protos: buffer.Buffer
    var target: u8
    var indent: u32
    var counter: u32
    ## Program modules in dependency order; the prelude is never emitted.
    var modules: list.List[NodeRef]
    var entry: ast.Node*
    var funcs: list.List[Instance]
    var records: list.List[Instance]
    ## Type ids whose typedef is needed, and those already written.
    var needed: list.List[u32]
    var defined: list.List[u32]
    var decls_done: list.List[NodeRef]
    var tests: list.List[NodeRef]
    var vtables: list.List[Witness]
    ## Emission context: the function, its instance arguments, its owner's.
    var current_fn: ast.Node*?
    var fn_decl: ast.Node*?
    var fn_args: u32[]
    var owner_decl: ast.Node*?
    var owner_args: u32[]
    var scopes: list.List[Scope]
    var defers: list.List[NodeRef]
    var catch_var: u32
    var catch_done: u32
    var catch_payload: u32
    var match_result: u32
    var in_catch: bool
    var src_file: str
    var wrote_writer: bool
    ## The format buffer temporary a `Display` field writes into, while emitting its call.
    var sink_prefix: str
    var sink_index: u32

    pub static func create(c: check.Checker*, entry: ast.Node*) -> Emitter!:
        return Emitter(c = c, out = try buffer.Buffer.create(65536), body = try buffer.Buffer.create(262144),
                       globals = try buffer.Buffer.create(4096), protos = try buffer.Buffer.create(16384), target = to_body, indent = 0, counter = 0,
                       modules = try list.List[NodeRef].create(16), entry = entry,
                       funcs = try list.List[Instance].create(64), records = try list.List[Instance].create(64),
                       needed = try list.List[u32].create(256), defined = try list.List[u32].create(256),
                       decls_done = try list.List[NodeRef].create(64), tests = try list.List[NodeRef].create(32),
                       vtables = try list.List[Witness].create(16),
                       current_fn = none, fn_decl = none, fn_args = try types.no_args(), owner_decl = none,
                       owner_args = try types.no_args(), scopes = try list.List[Scope].create(64),
                       defers = try list.List[NodeRef].create(64), catch_var = 0, catch_done = 0,
                       catch_payload = 0, match_result = 0, in_catch = false, src_file = entry.text, wrote_writer = false,
                       sink_prefix = "", sink_index = 0)

    # -- output ---------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        if self.target == to_body:
            try self.body.put(text)
        elif self.target == to_out:
            try self.out.put(text)
        elif self.target == to_protos:
            try self.protos.put(text)
        else:
            try self.globals.put(text)

    mutating func put_u64(value: u64) -> !:
        if self.target == to_body:
            try self.body.put_u64(value)
        elif self.target == to_out:
            try self.out.put_u64(value)
        elif self.target == to_protos:
            try self.protos.put_u64(value)
        else:
            try self.globals.put_u64(value)

    mutating func put_i64(value: i64) -> !:
        if self.target == to_body:
            try self.body.put_i64(value)
        elif self.target == to_out:
            try self.out.put_i64(value)
        elif self.target == to_protos:
            try self.protos.put_i64(value)
        else:
            try self.globals.put_i64(value)

    mutating func put_byte(byte: u8) -> !:
        if self.target == to_body:
            try self.body.put_byte(byte)
        elif self.target == to_out:
            try self.out.put_byte(byte)
        elif self.target == to_protos:
            try self.protos.put_byte(byte)
        else:
            try self.globals.put_byte(byte)

    mutating func pad_to_column() -> !:
        var i: u32 = 0
        while i < self.indent:
            try self.put("    ")
            i += 1

    ## Start a new line at the current indentation and write `text`.
    mutating func line(text: str) -> !:
        try self.put("\n")
        try self.pad_to_column()
        try self.put(text)

    ## A fresh number for a temporary.
    mutating func tmp() -> u32:
        self.counter += 1
        return self.counter

    ## `_lb_<prefix><n>`.
    mutating func put_tmp(prefix: str, n: u32) -> !:
        try self.put("_lb_")
        try self.put(prefix)
        try self.put_u64((u64)n)

    ## A C string literal for `text`.
    mutating func put_c_string(text: str) -> !:
        try self.put_byte('"')
        for b in text.bytes:
            if b == '\\' or b == '"':
                try self.put_byte('\\')
                try self.put_byte(b)
            elif b == '\n':
                try self.put("\\n")
            elif b == '\t':
                try self.put("\\t")
            elif b == '\r':
                try self.put("\\r")
            elif b == 0:
                try self.put("\\000")
            elif b < 32 or b >= 127:
                try self.put("\\")
                try self.put_byte('0' + (b >> 6))
                try self.put_byte('0' + ((b >> 3) & 7))
                try self.put_byte('0' + (b & 7))
            else:
                try self.put_byte(b)
        try self.put_byte('"')

    ## `((lb_str){"...", n})`.
    mutating func put_str_literal(text: str) -> !:
        try self.put("((lb_str){")
        try self.put_c_string(text)
        try self.put(", ")
        try self.put_u64((u64)text.length)
        try self.put("})")

    # mark: Types ==============================================================================

    ## A type of the body being emitted, with the instance's arguments substituted.
    mutating func map(id: u32) -> u32!:
        var t = id
        if let o = self.owner_decl:
            if self.owner_args.length > 0:
                t = try self.c.substitute(t, o, self.owner_args)
        if let f = self.fn_decl:
            if self.fn_args.length > 0:
                t = try self.c.substitute(t, f, self.fn_args)
        return t

    ## The mapped type of an expression node.
    mutating func ty(e: ast.Node*) -> u32!:
        return try self.map(e.type_id)

    func kind(id: u32) -> types.Kind:
        return self.c.table.kind(id)

    func elem(id: u32) -> u32:
        return self.c.table.get(id).elem

    func is_int(id: u32) -> bool:
        return self.c.table.is_integer(id)

    func is_signed(id: u32) -> bool:
        return self.c.table.is_signed(id)

    func is_float(id: u32) -> bool:
        return self.c.table.is_float(id)

    func is_ptr(id: u32) -> bool:
        return self.kind(id) == types.Kind.pointer

    func is_span(id: u32) -> bool:
        return self.kind(id) == types.Kind.span

    func is_array(id: u32) -> bool:
        return self.kind(id) == types.Kind.array

    func is_opt(id: u32) -> bool:
        return self.kind(id) == types.Kind.optional

    func is_fail(id: u32) -> bool:
        return self.kind(id) == types.Kind.fallible

    func is_tuple(id: u32) -> bool:
        return self.kind(id) == types.Kind.tuple

    func is_func(id: u32) -> bool:
        return self.kind(id) == types.Kind.func_

    func is_iface(id: u32) -> bool:
        return self.kind(id) == types.Kind.interface_

    func is_atomic(id: u32) -> bool:
        return self.kind(id) == types.Kind.atomic

    ## An optional whose payload is a pointer is the pointer itself (§5.8).
    func is_nullable_ptr(id: u32) -> bool:
        return self.c.table.is_nullable_pointer(id)

    ## A tagged optional carries a `present` flag beside its value.
    func is_tagged_opt(id: u32) -> bool:
        return self.is_opt(id) and not self.c.table.is_nullable_pointer(id)

    func is_int_enum(id: u32) -> bool:
        if self.kind(id) != types.Kind.enum_:
            return false
        let d = self.c.table.get(id).decl else return false
        return d.ty != none

    func is_record(id: u32) -> bool:
        let k = self.kind(id)
        return k == types.Kind.struct_ or k == types.Kind.union_ or (k == types.Kind.enum_ and not self.is_int_enum(id))

    ## The integer type behind an integer-backed enum.
    func enum_backing(id: u32) -> u32:
        let d = self.c.table.get(id).decl else return types.i32_id
        let backing = d.ty else return types.i32_id
        return backing.type_id

    func bits(id: u32) -> u32:
        if self.is_int_enum(id):
            return self.c.table.bits(self.enum_backing(id))
        return self.c.table.bits(id)

    ## Signedness for the checked arithmetic helpers.
    func signed_of(id: u32) -> bool:
        if self.is_int_enum(id):
            return self.is_signed(self.enum_backing(id))
        return self.is_signed(id)

    func decl_of(id: u32) -> ast.Node*?:
        return self.c.table.get(id).decl

    # -- spelling -------------------------------------------------------------------------

    ## The C type of `id`, which must be concrete.
    mutating func put_type(id: u32) -> !:
        if types.is_distinct_c(id):
            return try self.put(c_spelling(id))
        let t = self.c.table.get(id)
        match t.kind:
            .unit_, .never_, .void_:
                try self.put("void")
            .bool_:
                try self.put("bool")
            .i8_:
                try self.put("int8_t")
            .i16_:
                try self.put("int16_t")
            .i32_:
                try self.put("int32_t")
            .i64_:
                try self.put("int64_t")
            .isize_:
                try self.put("intptr_t")
            .u8_:
                try self.put("uint8_t")
            .u16_:
                try self.put("uint16_t")
            .u32_:
                try self.put("uint32_t")
            .u64_:
                try self.put("uint64_t")
            .usize_:
                try self.put("size_t")
            .f32_:
                try self.put("float")
            .f64_:
                try self.put("double")
            .char_:
                try self.put("uint32_t")
            .str_, .fmt_:
                try self.put("lb_str")
            .cstr_:
                try self.put("const char*")
            .error_code:
                try self.put("uint32_t")
            .error_value:
                try self.put("lb_error")
            .untyped_int:
                try self.put("int64_t")
            .untyped_float:
                try self.put("double")
            .atomic:
                try self.put("_Atomic(")
                try self.put_type(t.elem)
                try self.put(")")
            .pointer:
                if t.elem == types.void_id:
                    try self.put("const void*" if t.is_const else "void*")
                    return
                if t.is_const:
                    try self.put("const ")
                if t.is_volatile:
                    try self.put("volatile ")
                if self.is_record(t.elem):
                    try self.put("union " if self.kind(t.elem) == types.Kind.union_ else "struct ")
                try self.put_type(t.elem)
                try self.put("*")
            .span:
                try self.put("lb_cspan" if t.is_const else "lb_span")
            .array, .tuple, .func_:
                try self.note(id)
                try self.put_mangled_name(id)
            .optional:
                if self.c.table.has_null_niche(t.elem):
                    try self.put_type(t.elem)
                else:
                    try self.note(id)
                    try self.put_mangled_name(id)
            .fallible:
                if t.elem == types.unit_id or t.elem == types.never_id:
                    try self.put("lb_r_unit")
                else:
                    try self.note(id)
                    try self.put_mangled_name(id)
            .interface_:
                try self.put("lb_iface")
            .struct_, .union_, .enum_:
                if self.is_int_enum(id):
                    try self.put_type(self.enum_backing(id))
                    return
                try self.note(id)
                try self.put_record_name(id)
            .param:
                error(backend, "a generic parameter reached the backend")
            _:
                try self.put("void")

    ## The module a top-level declaration belongs to, by name.
    func module_name(d: ast.Node*) -> str:
        return names.module_of(d)

    ## `lb_module_Name` or `lb_module_Name__args` for a record type.
    mutating func put_record_name(id: u32) -> !:
        let t = self.c.table.get(id)
        let d = t.decl else return try self.put("void")
        if d.kind == ast.Kind.extern_struct or d.kind == ast.Kind.extern_union or d.kind == ast.Kind.extern_type:
            try self.put(d.text)
            return
        try self.put("lb_")
        try self.put(self.module_name(d))
        try self.put("_")
        try self.put(d.text)
        var i: usize = 0
        while i < t.args.length:
            try self.put("__")
            try self.put_mangled(t.args[i])
            i += 1

    ## The typedef name of an array, tuple, function, optional, or result type.
    mutating func put_mangled_name(id: u32) -> !:
        let k = self.kind(id)
        if k == types.Kind.array:
            try self.put("lb_a_")
        elif k == types.Kind.tuple:
            try self.put("lb_t_")
        elif k == types.Kind.func_:
            try self.put("lb_fn_")
        elif k == types.Kind.optional:
            try self.put("lb_o_")
        elif k == types.Kind.fallible:
            try self.put("lb_r_")
        try self.put_mangled(self.elem(id) if k == types.Kind.optional or k == types.Kind.fallible else id)

    ## A spelling of a type made of identifier characters only, unique per type.
    mutating func put_mangled(id: u32) -> !:
        let t = self.c.table.get(id)
        if types.is_distinct_c(id):
            # `c.long`, `c.va_list`: the `c` module's types spell their dot as an underscore
            for byte in t.name.bytes:
                try self.put_byte('_' if byte == '.' else byte)
            return
        match t.kind:
            .pointer:
                try self.put_mangled(t.elem)
                try self.put("_cptr" if t.is_const else "_ptr")
            .span:
                try self.put_mangled(t.elem)
                try self.put("_cspan" if t.is_const else "_span")
            .array:
                try self.put_mangled(t.elem)
                try self.put("_arr")
                try self.put_u64(t.length)
            .optional:
                try self.put_mangled(t.elem)
                try self.put("_opt")
            .fallible:
                try self.put_mangled(t.elem)
                try self.put("_res")
            .atomic:
                try self.put_mangled(t.elem)
                try self.put("_atomic")
            .tuple:
                try self.put("tup")
                var i: usize = 0
                while i < t.args.length:
                    try self.put("_")
                    try self.put_mangled(t.args[i])
                    i += 1
                try self.put("_end")
            .func_:
                try self.put("fn")
                var i: usize = 0
                while i < t.args.length:
                    try self.put("_")
                    try self.put_mangled(t.args[i])
                    i += 1
                try self.put("_to_")
                try self.put_mangled(t.elem)
            .struct_, .union_, .enum_, .interface_:
                let d = t.decl else return try self.put("X")
                try self.put(self.module_name(d))
                try self.put("_")
                try self.put(d.text)
                var i: usize = 0
                while i < t.args.length:
                    try self.put("__")
                    try self.put_mangled(t.args[i])
                    i += 1
            _:
                # `c.str` spells its dot as an underscore
                for byte in t.name.bytes:
                    try self.put_byte('_' if byte == '.' else byte)

    ## Remember that `id` needs a typedef, and register record instances.
    mutating func note(id: u32) -> !:
        if contains_id(self.needed.span(), id):
            return
        try self.needed.push(id)
        let t = self.c.table.get(id)
        if (t.kind == types.Kind.struct_ or t.kind == types.Kind.enum_ or t.kind == types.Kind.union_) and t.args.length > 0:
            let d = t.decl else return
            try self.add_record(d, t.args)

    ## Register a generic record instance and the instances of its methods.
    mutating func add_record(d: ast.Node*, args: u32[]) -> !:
        var i: usize = 0
        while i < self.records.count:
            let r = self.records.get(i)
            if r.decl == d and same_args(r.args, args):
                return
            i += 1
        try self.records.push(Instance(decl = d, args = args, owner = none, owner_args = try types.no_args(), done = false))
        var member = d.body
        while let m = member:
            if m.kind == ast.Kind.func_ and check.generic_params_of(m) == none:
                try self.add_func(m, try types.no_args(), d, args)
            member = m.next

    ## Register a function instance; returns its index.
    mutating func add_func(f: ast.Node*, args: u32[], owner: ast.Node*?, owner_args: u32[]) -> usize!:
        var i: usize = 0
        while i < self.funcs.count:
            # through a pointer: the scan must not copy a record per step
            let r = &self.funcs.items[i]
            if r.decl == f and same_args(r.args, args) and r.owner == owner and same_args(r.owner_args, owner_args):
                return i
            i += 1
        try self.funcs.push(Instance(decl = f, args = args, owner = owner, owner_args = owner_args, done = false))
        return self.funcs.count - 1

    # mark: Names ==============================================================================

    ## `lb_name`, with a trailing underscore when the name is one the runtime uses.
    mutating func put_ident(name: str) -> !:
        try self.put("lb_")
        try self.put(name)
        if names.is_runtime_name(name):
            try self.put("_")

    ## The C name of a function or method instance.
    mutating func put_func_name(f: ast.Node*, args: u32[], owner: ast.Node*?, owner_args: u32[]) -> !:
        if f.kind == ast.Kind.extern_func:
            try self.put(names.c_symbol(f))
            return
        if f.has(ast.flag_export):
            if let o = owner:
                try self.put(o.text)
                try self.put("_")
            try self.put(f.text)
            return
        try self.put("lb_")
        if let o = owner:
            try self.put(self.module_name(o))
            try self.put("_")
            try self.put(o.text)
            var i: usize = 0
            while i < owner_args.length:
                try self.put("__")
                try self.put_mangled(owner_args[i])
                i += 1
            try self.put("_")
        elif f.text == "main" or f.text == "answer":
            # the entry points keep the names the shims call
            if f.text == "answer" and f.has(ast.flag_fallible):
                try self.put("answer_impl")
            else:
                try self.put(f.text)
            return
        else:
            try self.put(self.module_name(f))
            try self.put("_")
        try self.put(f.text)
        var i: usize = 0
        while i < args.length:
            try self.put("__")
            try self.put_mangled(args[i])
            i += 1

    ## `lb_module_name` for a top-level `let` or `var`.
    mutating func put_global_name(d: ast.Node*) -> !:
        if d.kind == ast.Kind.extern_var:
            try self.put(d.text)
            return
        try self.put("lb_")
        try self.put(self.module_name(d))
        try self.put("_")
        try self.put(d.text)

    ## The C name of the function the emission context is inside.
    mutating func put_current_name() -> !:
        let f = self.current_fn else return try self.put("lb_unknown")
        if f.kind == ast.Kind.test_:
            try self.put("lb_test_")
            let index = try self.test_index(f)
            try self.put_u64((u64)index)
            return
        try self.put_func_name(f, self.fn_args, self.owner_decl, self.owner_args)

    mutating func test_index(t: ast.Node*) -> usize!:
        var i: usize = 0
        while i < self.tests.count:
            if self.tests.get(i) == t:
                return i
            i += 1
        try self.tests.push(t)
        return self.tests.count - 1

    ## The C result type of a function declaration (or test) in the current context.
    mutating func put_result_type(f: ast.Node*) -> !:
        if f.kind == ast.Kind.test_:
            try self.put("lb_r_unit")
            return
        let ft = self.c.table.get(try self.map(f.type_id))
        if f.has(ast.flag_fallible):
            try self.put_type(ft.elem)
            return
        if ft.elem == types.unit_id or ft.elem == types.never_id:
            try self.put("void")
            return
        try self.put_type(ft.elem)

    ## The unwrapped result type of the current function.
    mutating func result_payload() -> u32!:
        let f = self.current_fn else return types.unit_id
        if f.kind == ast.Kind.test_:
            return types.unit_id
        let ft = self.c.table.get(try self.map(f.type_id))
        if f.has(ast.flag_fallible):
            return self.elem(ft.elem)
        return ft.elem

    func fn_fallible() -> bool:
        let f = self.current_fn else return false
        return f.kind == ast.Kind.test_ or f.has(ast.flag_fallible)

    # mark: Definitions ========================================================================

    ## Write a typedef for `id` after everything it holds by value.
    mutating func define_type(id: u32) -> !:
        if contains_id(self.defined.span(), id):
            return
        let t = self.c.table.get(id)
        match t.kind:
            .pointer, .span, .atomic:
                # only the pointee's name is needed; records are forward-declared
                if not self.is_record(t.elem) or self.is_int_enum(t.elem):
                    try self.define_type(t.elem)
                try self.defined.push(id)
            .array:
                try self.define_type(t.elem)
                try self.defined.push(id)
                try self.line("typedef struct ")
                try self.put_mangled_name(id)
                try self.put(" { ")
                try self.put_type(t.elem)
                try self.put(" d[")
                try self.put_u64(t.length)
                try self.put("]; } ")
                try self.put_mangled_name(id)
                try self.put(";")
            .optional:
                try self.define_type(t.elem)
                try self.defined.push(id)
                if self.c.table.has_null_niche(t.elem):
                    return
                try self.line("LB_OPT(")
                try self.put_type(t.elem)
                try self.put(", ")
                try self.put_mangled_name(id)
                try self.put(");")
            .fallible:
                try self.define_type(t.elem)
                try self.defined.push(id)
                if t.elem == types.unit_id or t.elem == types.never_id:
                    return
                try self.line("LB_RES(")
                try self.put_type(t.elem)
                try self.put(", ")
                try self.put_mangled_name(id)
                try self.put(");")
            .tuple:
                var i: usize = 0
                while i < t.args.length:
                    try self.define_type(t.args[i])
                    i += 1
                try self.defined.push(id)
                try self.line("typedef struct ")
                try self.put_mangled_name(id)
                try self.put(" {")
                i = 0
                while i < t.args.length:
                    try self.put(" ")
                    try self.put_type(t.args[i])
                    try self.put(" a")
                    try self.put_u64((u64)i)
                    try self.put(";")
                    i += 1
                try self.put(" } ")
                try self.put_mangled_name(id)
                try self.put(";")
            .func_:
                var i: usize = 0
                while i < t.args.length:
                    try self.define_type(t.args[i])
                    i += 1
                try self.define_type(t.elem)
                try self.defined.push(id)
                try self.line("typedef ")
                if t.elem == types.unit_id or t.elem == types.never_id:
                    try self.put("void")
                else:
                    try self.put_type(t.elem)
                try self.put(" (*")
                try self.put_mangled_name(id)
                try self.put(")(")
                if t.args.length == 0:
                    try self.put("void")
                i = 0
                while i < t.args.length:
                    if i > 0:
                        try self.put(", ")
                    try self.put_type(t.args[i])
                    i += 1
                try self.put(");")
            .struct_, .union_, .enum_:
                try self.defined.push(id)
                if self.is_int_enum(id):
                    return
                let d = t.decl else return
                if t.args.length > 0:
                    try self.define_record(d, t.args, id)
                else:
                    try self.define_decl(d)
            _:
                try self.defined.push(id)

    ## A non-generic record, once, after its by-value members.
    mutating func define_decl(d: ast.Node*) -> !:
        var i: usize = 0
        while i < self.decls_done.count:
            if self.decls_done.get(i) == d:
                return
            i += 1
        try self.decls_done.push(d)
        if check.generic_params_of(d) != none:
            return
        if d.kind == ast.Kind.enum_ and d.ty != none:
            return
        try self.define_record(d, try types.no_args(), d.type_id)

    ## Write the C definition of a record declaration with `args` substituted.
    mutating func define_record(d: ast.Node*, args: u32[], id: u32) -> !:
        let saved_owner = self.owner_decl
        let saved_args = self.owner_args
        self.owner_decl = d
        self.owner_args = args
        # members held by value come first
        var member = d.body
        while let m = member:
            if m.kind == ast.Kind.field:
                try self.define_type(try self.map(m.type_id))
            elif m.kind == ast.Kind.enum_case:
                var p = m.body
                while let q = p:
                    try self.define_type(try self.map(q.type_id))
                    p = q.next
            member = m.next
        if d.kind == ast.Kind.struct_ or d.kind == ast.Kind.extern_struct:
            try self.line("typedef struct")
            if d.has(ast.flag_packed):
                try self.put(" __attribute__((packed))")
            if let layout = d.right:
                if layout.kind == ast.Kind.literal:
                    try self.put(" __attribute__((aligned(")
                    try self.put(layout.text)
                    try self.put(")))")
            try self.put(" ")
            try self.put_record_name(id)
            try self.put(" {")
            self.indent += 1
            var any = false
            member = d.body
            while let m = member:
                if m.kind == ast.Kind.field:
                    any = true
                    try self.line("")
                    try self.put_type(try self.map(m.type_id))
                    try self.put(" ")
                    try self.put(m.text)
                    if let al = m.right:
                        if al.kind == ast.Kind.literal:
                            try self.put(" __attribute__((aligned(")
                            try self.put(al.text)
                            try self.put(")))")
                    try self.put(";")
                member = m.next
            if not any:
                try self.line("int unused;")
            self.indent -= 1
            try self.line("} ")
            try self.put_record_name(id)
            try self.put(";")
        elif d.kind == ast.Kind.union_ or d.kind == ast.Kind.extern_union:
            try self.line("typedef union ")
            try self.put_record_name(id)
            try self.put(" {")
            self.indent += 1
            var any = false
            member = d.body
            while let m = member:
                if m.kind == ast.Kind.field:
                    any = true
                    try self.line("")
                    try self.put_type(try self.map(m.type_id))
                    try self.put(" ")
                    try self.put(m.text)
                    try self.put(";")
                member = m.next
            if not any:
                try self.line("int unused;")
            self.indent -= 1
            try self.line("} ")
            try self.put_record_name(id)
            try self.put(";")
        elif d.kind == ast.Kind.enum_:
            try self.line("typedef struct ")
            try self.put_record_name(id)
            try self.put(" {")
            self.indent += 1
            try self.line("int32_t tag;")
            var any_payload = false
            member = d.body
            while let m = member:
                if m.kind == ast.Kind.enum_case and m.body != none:
                    any_payload = true
                member = m.next
            if any_payload:
                try self.line("union {")
                self.indent += 1
                member = d.body
                while let m = member:
                    if m.kind == ast.Kind.enum_case and m.body != none:
                        try self.line("struct {")
                        self.indent += 1
                        var p = m.body
                        while let q = p:
                            try self.line("")
                            try self.put_type(try self.map(q.type_id))
                            try self.put(" ")
                            try self.put(q.text)
                            try self.put(";")
                            p = q.next
                        self.indent -= 1
                        try self.line("} ")
                        try self.put(m.text)
                        try self.put(";")
                    member = m.next
                self.indent -= 1
                try self.line("} u;")
            self.indent -= 1
            try self.line("} ")
            try self.put_record_name(id)
            try self.put(";")
        self.owner_decl = saved_owner
        self.owner_args = saved_args

    ## `typedef struct X X;` for every record the program defines.
    mutating func forward_declarations() -> !:
        var i: usize = 0
        while i < self.modules.count:
            var cursor = self.modules.get(i).body
            while let d = cursor:
                if check.generic_params_of(d) == none:
                    if d.kind == ast.Kind.struct_ or d.kind == ast.Kind.extern_struct:
                        try self.forward_one(d, d.type_id, "struct")
                    elif d.kind == ast.Kind.union_ or d.kind == ast.Kind.extern_union:
                        try self.forward_one(d, d.type_id, "union")
                    elif d.kind == ast.Kind.enum_ and d.ty == none:
                        try self.forward_one(d, d.type_id, "struct")
                cursor = d.next
            i += 1
        i = 0
        while i < self.records.count:
            let r = self.records.get(i)
            let id = try self.c.table.nominal(self.c.table.kind(r.decl.type_id), r.decl, r.args)
            if r.decl.kind == ast.Kind.enum_ and r.decl.ty != none:
                i += 1
                continue
            try self.forward_one(r.decl, id, "union" if r.decl.kind == ast.Kind.union_ else "struct")
            i += 1

    mutating func forward_one(d: ast.Node*, id: u32, tag: str) -> !:
        if d.kind == ast.Kind.extern_struct or d.kind == ast.Kind.extern_union:
            return
        try self.line("typedef ")
        try self.put(tag)
        try self.put(" ")
        try self.put_record_name(id)
        try self.put(" ")
        try self.put_record_name(id)
        try self.put(";")

    ## Every typedef the bodies needed, in dependency order.
    mutating func type_definitions() -> !:
        try self.line("LB_RES(size_t, lb_r_usize);")
        let usize_res = try self.c.table.fallible(types.usize_id)
        try self.defined.push(usize_res)
        var i: usize = 0
        while i < self.modules.count:
            var cursor = self.modules.get(i).body
            while let d = cursor:
                if d.kind == ast.Kind.struct_ or d.kind == ast.Kind.extern_struct or d.kind == ast.Kind.union_ or d.kind == ast.Kind.extern_union or d.kind == ast.Kind.enum_:
                    if check.generic_params_of(d) == none:
                        try self.define_type(d.type_id)
                cursor = d.next
            i += 1
        # `needed` grows while records define their members; loop until it is drained
        var n: usize = 0
        while n < self.needed.count:
            try self.define_type(self.needed.get(n))
            n += 1

    # mark: Functions ==========================================================================

    ## The signature of a function or method instance; `define` opens the body.
    ## The attributes of §9.8 as one `__attribute__` prefix. `inline` is advice this backend
    ## leaves to the C compiler; a section name is passed as spelled.
    mutating func attribute_prefix(d: ast.Node*, is_func: bool) -> !:
        var first = true
        var cursor = d.attrs
        while let a = cursor:
            let word = a.text
            let skip = word == "inline" or (not is_func and (word == "noinline" or word == "cold" or word == "naked"))
            if not skip:
                try self.put("__attribute__((" if first else ", ")
                first = false
                if word == "section":
                    try self.put("section(")
                    if let name = a.left:
                        try self.put(name.text)
                    try self.put(")")
                else:
                    try self.put(word)
            cursor = a.next
        if not first:
            try self.put(")) ")

    mutating func signature(f: ast.Node*, define: bool) -> !:
        try self.line("")
        if f.kind == ast.Kind.test_:
            try self.put("lb_r_unit lb_test_")
            let index = try self.test_index(f)
            try self.put_u64((u64)index)
            try self.put("(void)")
        else:
            try self.attribute_prefix(f, true)
            try self.put_result_type(f)
            try self.put(" ")
            try self.put_func_name(f, self.fn_args, self.owner_decl, self.owner_args)
            try self.put("(")
            var first = true
            if let o = self.owner_decl:
                if not f.has(ast.flag_static):
                    let oid = try self.map(o.type_id)
                    if f.has(ast.flag_mutating) or f.text == "init":
                        try self.put_type(oid)
                    else:
                        try self.put("const ")
                        try self.put_type(oid)
                    try self.put("* self")
                    first = false
            var cursor = f.right
            while let p = cursor:
                if not first:
                    try self.put(", ")
                first = false
                try self.put_type(try self.map(p.type_id))
                try self.put(" ")
                try self.put_ident(p.text)
                cursor = p.next
            if first:
                try self.put("void")
            try self.put(")")
        if not define:
            try self.put(";")
            return
        try self.put(" {")

    ## Emit one function instance into the body buffer.
    mutating func function(inst: Instance) -> !:
        let f = inst.decl
        let saved_fn = self.current_fn
        let saved_decl = self.fn_decl
        let saved_args = self.fn_args
        let saved_owner = self.owner_decl
        let saved_owner_args = self.owner_args
        self.current_fn = f
        self.fn_decl = f
        self.fn_args = inst.args
        self.owner_decl = inst.owner
        self.owner_args = inst.owner_args
        self.target = to_body
        try self.signature(f, true)
        self.indent += 1
        # the result type must exist as a typedef
        if f.kind != ast.Kind.test_:
            let ft = self.c.table.get(try self.map(f.type_id))
            if f.has(ast.flag_fallible):
                try self.note_if_typedef(ft.elem)
            else:
                try self.note_if_typedef(ft.elem)
        let base = self.scopes.count
        try self.push_scope(false, "")
        let naked = ast.has_attribute(f, "naked")
        if naked:
            try self.naked_body(f)
        elif let body = f.body:
            var cursor = body.body
            while let s = cursor:
                try self.stmt(s)
                cursor = s.next
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        if naked:
            discard(0)
        elif self.fn_fallible() and (try self.result_payload()) == types.unit_id:
            try self.line("return ((lb_r_unit){ .failed = false });")
        elif (try self.result_payload()) != types.unit_id and (try self.result_payload()) != types.never_id:
            try self.line("lb_trap(\"unreachable\");")
        elif (try self.result_payload()) == types.never_id:
            try self.line("lb_trap(\"unreachable\");")
        self.indent -= 1
        try self.line("}")
        discard(base)
        self.current_fn = saved_fn
        self.fn_decl = saved_decl
        self.fn_args = saved_args
        self.owner_decl = saved_owner
        self.owner_args = saved_owner_args

    ## Composite types spelled only inside bodies still need their typedefs.
    mutating func note_if_typedef(id: u32) -> !:
        let k = self.kind(id)
        if k == types.Kind.array or k == types.Kind.tuple or k == types.Kind.func_ or k == types.Kind.optional or k == types.Kind.fallible or k == types.Kind.struct_ or k == types.Kind.enum_ or k == types.Kind.union_:
            try self.note(id)

    # -- scopes and cleanup ---------------------------------------------------------------

    mutating func push_scope(loop: bool, label: str) -> !:
        try self.scopes.push(Scope(defer_base = self.defers.count, loop = loop, label = label, restore_alloc = false, alloc_save = 0))

    mutating func pop_scope():
        let sc = self.scopes.get(self.scopes.count - 1)
        self.defers.count = sc.defer_base
        self.scopes.count -= 1

    ## Run the deferred calls of scope `index` (last registered first) and
    ## restore its allocator; `failing` includes the `errdefer` calls.
    mutating func unwind(index: usize, failing: bool) -> !:
        let sc = self.scopes.get(index)
        let end = self.defers.count if index + 1 >= self.scopes.count else self.scopes.get(index + 1).defer_base
        var i = end
        while i > sc.defer_base:
            i -= 1
            let d = self.defers.get(i)
            if d.kind == ast.Kind.errdefer_ and not failing:
                continue
            let call = d.left else continue
            if call.kind == ast.Kind.free_:
                try self.free_stmt(call)
            else:
                try self.line("(void)(")
                try self.expr(call)
                try self.put(");")
        if sc.restore_alloc:
            try self.line("lb_memory_allocator = ")
            try self.put_tmp("as", sc.alloc_save)
            try self.put(";")

    ## Unwind every scope from the innermost down to `from`, for an exit.
    mutating func unwind_from(start: usize, failing: bool) -> !:
        var i = self.scopes.count
        while i > start:
            i -= 1
            try self.unwind(i, failing)

    func any_cleanup() -> bool:
        if self.defers.count > 0:
            return true
        var i: usize = 0
        while i < self.scopes.count:
            if self.scopes.get(i).restore_alloc:
                return true
            i += 1
        return false

    ## The innermost loop scope, or the one with `label`.
    func loop_scope(label: str) -> usize:
        var i = self.scopes.count
        while i > 0:
            i -= 1
            let sc = self.scopes.get(i)
            if sc.loop and (label.length == 0 or sc.label == label):
                return i
        return 0

    # mark: Statements =========================================================================

    mutating func block(b: ast.Node*) -> !:
        try self.line("{")
        self.indent += 1
        try self.push_scope(false, "")
        var cursor = b.body
        while let s = cursor:
            try self.stmt(s)
            cursor = s.next
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        self.indent -= 1
        try self.line("}")

    mutating func stmt(s: ast.Node*) -> !:
        match s.kind:
            .block:
                try self.block(s)
            .let_, .var_:
                try self.binding(s)
            .assign:
                try self.assign(s)
            .if_:
                try self.if_stmt(s)
            .while_:
                try self.while_stmt(s)
            .for_:
                try self.for_stmt(s)
            .match_:
                try self.match_stmt(s, 0)
            .return_:
                try self.return_stmt(s)
            .break_, .continue_:
                try self.jump(s)
            .defer_, .errdefer_:
                try self.defers.push(s)
            .recover_:
                try self.recover_stmt(s)
            .free_:
                try self.free_stmt(s)
            .with_:
                try self.with_stmt(s)
            .expr_stmt:
                let e = s.left else return
                if is_error_call(e):
                    try self.error_return(e)
                else:
                    try self.line("(void)(")
                    try self.expr(e)
                    try self.put(");")
            .asm_:
                try self.asm_stmt(s)
            _:
                try self.line("/* unsupported statement */")

    ## `let`/`var`, with a name or a tuple of names.
    mutating func binding(s: ast.Node*) -> !:
        if s.body != none:
            let init = s.left else return
            let tt = try self.ty(init)
            let n = self.tmp()
            try self.line("")
            try self.put_type(tt)
            try self.put(" ")
            try self.put_tmp("tu", n)
            try self.put(" = ")
            try self.value(init, tt)
            try self.put(";")
            var i: u64 = 0
            var cursor = s.body
            while let name = cursor:
                if name.text != "_":
                    try self.line("")
                    try self.put_type(try self.map(name.type_id))
                    try self.put(" ")
                    try self.put_ident(name.text)
                    try self.put(" __attribute__((unused)) = ")
                    try self.put_tmp("tu", n)
                    try self.put(".a")
                    try self.put_u64(i)
                    try self.put(";")
                i += 1
                cursor = name.next
            return
        let t = try self.map(s.type_id)
        try self.line("")
        try self.put_type(t)
        try self.put(" ")
        try self.put_ident(s.text)
        try self.put(" __attribute__((unused))")
        if s.has(ast.flag_uninit):
            try self.put(";")
            return
        try self.put(" = ")
        if let init = s.left:
            try self.value(init, t)
        else:
            try self.zero_value(t)
        try self.put(";")

    ## The zero value of a type as a C initialiser.
    mutating func zero_value(t: u32) -> !:
        let k = self.kind(t)
        if t == types.bool_id:
            try self.put("false")
        elif self.is_int(t) or self.is_float(t) or t == types.char_id or self.is_int_enum(t) or t == types.error_code_id:
            try self.put("0")
        elif k == types.Kind.pointer or k == types.Kind.func_ or t == types.cstr_id:
            try self.put("((void*)0)")
        elif self.is_nullable_ptr(t):
            try self.put("((void*)0)")
        elif k == types.Kind.atomic:
            try self.zero_value(self.elem(t))
        else:
            try self.put("{0}")

    mutating func assign(s: ast.Node*) -> !:
        let place = s.left else return
        let value = s.right else return
        # `memory.allocator = x` sets the current allocator
        if place.kind == ast.Kind.member and place.text == "allocator":
            if let owner = place.left:
                if self.kind(owner.type_id) == types.Kind.module:
                    try self.line("lb_memory_allocator = ")
                    try self.allocator_view(value)
                    try self.put(";")
                    return
        let pt = try self.ty(place)
        if s.text == "=":
            try self.line("")
            try self.place(place)
            try self.put(" = ")
            try self.value(value, pt)
            try self.put(";")
            return
        let op = (str)s.text.bytes[..<s.text.length - 1]
        if self.is_atomic(pt):
            try self.line("")
            try self.place(place)
            try self.put(" ")
            try self.put(op)
            try self.put("= ")
            try self.value(value, self.elem(pt))
            try self.put(";")
            return
        if op == "&" or op == "|" or op == "^":
            try self.line("")
            try self.place(place)
            try self.put(" = ")
            try self.place(place)
            try self.put(" ")
            try self.put(op)
            try self.put(" (")
            try self.value(value, pt)
            try self.put(");")
            return
        if self.is_float(pt) and (op == "+" or op == "-" or op == "*" or op == "/"):
            try self.line("")
            try self.place(place)
            try self.put(" ")
            try self.put(op)
            try self.put("= ")
            try self.value(value, pt)
            try self.put(";")
            return
        try self.line("")
        try self.place(place)
        try self.put(" = ")
        try self.checked_op(helper_name(op), pt, place, value)
        try self.put(";")

    ## `lb_add_s(a, b, bits)` cast back to the type; `a` and `b` are expressions.
    mutating func checked_op(helper: str, t: u32, l: ast.Node*, r: ast.Node*) -> !:
        try self.put("(")
        try self.put_type(t)
        try self.put(")(lb_")
        try self.put(helper)
        try self.put("_s(" if self.signed_of(t) else "_u(")
        try self.word(t, l)
        try self.put(", ")
        try self.word(t, r)
        try self.put(", ")
        try self.put_u64((u64)self.bits(t))
        try self.put("))")

    ## An operand widened to the helper's 64-bit word.
    mutating func word(t: u32, e: ast.Node*) -> !:
        try self.put("(int64_t)(" if self.signed_of(t) else "(uint64_t)(")
        try self.value(e, t)
        try self.put(")")

    # -- branches and loops ---------------------------------------------------------------

    ## The `let name = optional` of an `if let` or `while let`: declares the
    ## temporary and returns after the condition text has been written.
    mutating func if_let_head(s: ast.Node*, n: u32) -> !:
        let binding = s.left else return
        let init = binding.left else return
        let ot = try self.ty(init)
        try self.line("")
        try self.put_type(ot)
        try self.put(" ")
        try self.put_tmp("o", n)
        try self.put(" = ")
        try self.value(init, ot)
        try self.put(";")

    mutating func if_let_bind(s: ast.Node*, n: u32) -> !:
        let binding = s.left else return
        let init = binding.left else return
        let ot = try self.ty(init)
        try self.line("")
        try self.put_type(self.elem(ot))
        try self.put(" ")
        try self.put_ident(binding.text)
        try self.put(" __attribute__((unused)) = ")
        try self.put_tmp("o", n)
        if self.is_tagged_opt(ot):
            try self.put(".value")
        try self.put(";")

    mutating func if_let_test(s: ast.Node*, n: u32) -> !:
        let binding = s.left else return
        let init = binding.left else return
        let ot = try self.ty(init)
        if self.is_tagged_opt(ot):
            try self.put_tmp("o", n)
            try self.put(".present")
        else:
            try self.put_tmp("o", n)
            try self.put(" != ((void*)0)")

    mutating func if_stmt(s: ast.Node*) -> !:
        if s.has(ast.flag_if_let):
            let n = self.tmp()
            try self.if_let_head(s, n)
            try self.line("if (")
            try self.if_let_test(s, n)
            try self.put(") {")
            self.indent += 1
            try self.if_let_bind(s, n)
            if let body = s.body:
                try self.block(body)
            self.indent -= 1
            try self.line("}")
        else:
            let cond = s.left else return
            try self.line("if (!!(")
            try self.value(cond, types.bool_id)
            try self.put(")) ")
            if let body = s.body:
                try self.block(body)
        let rest = s.right else return
        try self.line("else ")
        if rest.kind == ast.Kind.if_:
            # `elif let` declares a temporary, which needs its own block
            let braces = rest.has(ast.flag_if_let)
            if braces:
                try self.put("{")
                self.indent += 1
            try self.if_stmt(rest)
            if braces:
                self.indent -= 1
                try self.line("}")
        else:
            try self.block(rest)

    mutating func while_stmt(s: ast.Node*) -> !:
        try self.push_scope(true, s.text)
        if s.has(ast.flag_if_let):
            let n = self.tmp()
            try self.line("while (1) {")
            self.indent += 1
            try self.if_let_head(s, n)
            try self.line("if (!(")
            try self.if_let_test(s, n)
            try self.put(")) break;")
            try self.if_let_bind(s, n)
        else:
            let cond = s.left else return
            try self.line("while (!!(")
            try self.value(cond, types.bool_id)
            try self.put(")) {")
            self.indent += 1
        if let body = s.body:
            try self.block(body)
        if s.text.length > 0:
            try self.line("__attribute__((unused)) lb_cont_")
            try self.put(s.text)
            try self.put(": ;")
        self.indent -= 1
        try self.line("}")
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        if s.text.length > 0:
            try self.line("__attribute__((unused)) lb_brk_")
            try self.put(s.text)
            try self.put(": ;")

    mutating func for_stmt(s: ast.Node*) -> !:
        let binding = s.left else return
        let seq = s.right else return
        try self.push_scope(true, s.text)
        if seq.kind == ast.Kind.binary and (seq.text == "..<" or seq.text == "..="):
            let lo = seq.left else return
            let hi = seq.right else return
            let t = try self.map(binding.type_id)
            try self.line("for (")
            try self.put_type(t)
            try self.put(" ")
            try self.put_ident(binding.text)
            try self.put(" __attribute__((unused)) = (")
            try self.put_type(t)
            try self.put(")(")
            try self.value(lo, t)
            try self.put("); ")
            try self.put_ident(binding.text)
            try self.put(" <= (" if seq.text == "..=" else " < (")
            try self.put_type(t)
            try self.put(")(")
            try self.value(hi, t)
            try self.put("); ")
            try self.put_ident(binding.text)
            try self.put("++) {")
        else:
            let it = try self.ty(seq)
            let n = self.tmp()
            try self.line("")
            try self.put_type(it)
            try self.put(" ")
            try self.put_tmp("seq", n)
            try self.put(" = ")
            try self.value(seq, it)
            try self.put(";")
            try self.line("for (size_t ")
            try self.put_tmp("i", n)
            try self.put(" = 0; ")
            try self.put_tmp("i", n)
            try self.put(" < ")
            if self.is_array(it):
                try self.put_u64(self.c.table.get(it).length)
            else:
                try self.put_tmp("seq", n)
                try self.put(".length")
            try self.put("; ")
            try self.put_tmp("i", n)
            try self.put("++) {")
            self.indent += 1
            # the element, by value or by pointer, or the tuple members
            if binding.body != none:
                let et = try self.map(binding.type_id) if binding.type_id != 0 else self.elem(it)
                var i: u64 = 0
                var cursor = binding.body
                while let name = cursor:
                    if name.text != "_":
                        try self.line("")
                        try self.put_type(try self.map(name.type_id))
                        try self.put(" ")
                        try self.put_ident(name.text)
                        try self.put(" __attribute__((unused)) = ")
                        try self.element_of(it, n)
                        try self.put(".a")
                        try self.put_u64(i)
                        try self.put(";")
                    i += 1
                    cursor = name.next
                discard(et)
            else:
                try self.line("")
                try self.put_type(try self.map(binding.type_id))
                try self.put(" ")
                try self.put_ident(binding.text)
                try self.put(" __attribute__((unused)) = ")
                if s.has(ast.flag_by_pointer):
                    try self.put("&(")
                    try self.element_of(it, n)
                    try self.put(")")
                else:
                    try self.element_of(it, n)
                try self.put(";")
            self.indent -= 1
        self.indent += 1
        if let body = s.body:
            try self.block(body)
        if s.text.length > 0:
            try self.line("__attribute__((unused)) lb_cont_")
            try self.put(s.text)
            try self.put(": ;")
        self.indent -= 1
        try self.line("}")
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        if s.text.length > 0:
            try self.line("__attribute__((unused)) lb_brk_")
            try self.put(s.text)
            try self.put(": ;")

    ## Element `i` of the sequence temporary `n`: an array, a span, or text.
    mutating func element_of(it: u32, n: u32) -> !:
        if self.is_array(it):
            try self.put_tmp("seq", n)
            try self.put(".d[")
            try self.put_tmp("i", n)
            try self.put("]")
        elif it == types.str_id:
            try self.put("((const unsigned char*)")
            try self.put_tmp("seq", n)
            try self.put(".data)[")
            try self.put_tmp("i", n)
            try self.put("]")
        else:
            try self.put("((")
            if self.c.table.get(it).is_const:
                try self.put("const ")
            try self.put_type(self.elem(it))
            try self.put("*)")
            try self.put_tmp("seq", n)
            try self.put(".data)[")
            try self.put_tmp("i", n)
            try self.put("]")

    mutating func jump(s: ast.Node*) -> !:
        let target = self.loop_scope(s.text)
        try self.unwind_from(target + 1, false)
        if s.text.length == 0:
            try self.line("break;" if s.kind == ast.Kind.break_ else "continue;")
            return
        try self.line("goto ")
        try self.put("lb_brk_" if s.kind == ast.Kind.break_ else "lb_cont_")
        try self.put(s.text)
        try self.put(";")

    # -- returns, recovery, cleanup -------------------------------------------------------

    ## `return` with the deferred calls of every scope run first.
    mutating func return_stmt(s: ast.Node*) -> !:
        if let v = s.left:
            if is_trap_call(v):
                try self.line("")
                try self.expr(v)
                try self.put(";")
                return
            if is_error_call(v):
                try self.error_return(v)
                return
            if never_valued(v):
                try self.line("(void)(")
                try self.expr(v)
                try self.put("); __builtin_unreachable();")
                return
            let want = try self.result_payload()
            if want == types.unit_id or want == types.never_id:
                try self.line("(void)(")
                try self.expr(v)
                try self.put(");")
                try self.unwind_from(0, false)
                try self.line("return ((lb_r_unit){ .failed = false });" if self.fn_fallible() else "return;")
                return
            let n = self.tmp()
            try self.line("")
            try self.put_type(want)
            try self.put(" ")
            try self.put_tmp("ret", n)
            try self.put(" = ")
            try self.value(v, want)
            try self.put(";")
            try self.unwind_from(0, false)
            try self.line("return ")
            if self.fn_fallible():
                try self.put("((")
                try self.put_result_type(self.current_fn else return)
                try self.put("){ .value = ")
                try self.put_tmp("ret", n)
                try self.put(", .failed = false })")
            else:
                try self.put_tmp("ret", n)
            try self.put(";")
            return
        try self.unwind_from(0, false)
        try self.line("return ((lb_r_unit){ .failed = false });" if self.fn_fallible() else "return;")

    ## `error(code, message)` as a statement: the failing result leaves the function.
    mutating func error_return(e: ast.Node*) -> !:
        if self.in_catch:
            # inside a handler the error replaces the handled one and leaves the function
            let n = self.tmp()
            try self.line("")
            try self.put_result_type(self.current_fn else return)
            try self.put(" ")
            try self.put_tmp("err", n)
            try self.put(" = ")
            try self.error_value(e)
            try self.put(";")
            try self.unwind_from(0, true)
            try self.line("return ")
            try self.put_tmp("err", n)
            try self.put(";")
            return
        let n = self.tmp()
        try self.line("")
        try self.put_result_type(self.current_fn else return)
        try self.put(" ")
        try self.put_tmp("err", n)
        try self.put(" = ")
        try self.error_value(e)
        try self.put(";")
        try self.unwind_from(0, true)
        try self.line("return ")
        try self.put_tmp("err", n)
        try self.put(";")

    ## The failing result value of the current function for `error(code, message)`.
    mutating func error_value(e: ast.Node*) -> !:
        let first = e.body else return
        let code = first.left else return
        let second = first.next else return
        let message = second.left else return
        try self.put("((")
        try self.put_result_type(self.current_fn else return)
        try self.put("){ .error = { .code = (int32_t)(")
        try self.value(code, types.error_code_id)
        try self.put("), .message = ")
        try self.value(message, types.str_id)
        try self.put(" }, .failed = true })")

    mutating func recover_stmt(s: ast.Node*) -> !:
        let v = s.left else return
        let vt = try self.ty(v)
        if self.catch_var != 0:
            if vt == types.unit_id or vt == types.never_id or self.catch_result() == types.unit_id:
                try self.line("(void)(")
                try self.expr(v)
                try self.put(");")
            else:
                try self.line("")
                try self.put_tmp("v", self.catch_var)
                try self.put(" = ")
                try self.value(v, self.catch_result())
                try self.put(";")
            try self.line("goto ")
            try self.put_tmp("cd", self.catch_done)
            try self.put(";")
            return
        try self.line("/* recover outside a handler */")

    mutating func catch_result() -> u32:
        return self.catch_payload

    mutating func free_stmt(s: ast.Node*) -> !:
        let v = s.left else return
        let t = try self.ty(v)
        if self.is_ptr(t):
            try self.line("lb_release_call(")
            try self.allocator_of(s.right)
            try self.put(", (lb_span){ (void*)(")
            try self.expr(v)
            try self.put("), sizeof(")
            try self.put_type(self.elem(t))
            try self.put(") });")
            return
        if self.is_span(t):
            let n = self.tmp()
            try self.line("{ lb_span ")
            try self.put_tmp("s", n)
            try self.put(" = ")
            try self.expr(v)
            try self.put("; lb_release_call(")
            try self.allocator_of(s.right)
            try self.put(", (lb_span){ (void*)(")
            try self.put_tmp("s", n)
            try self.put(".data), ")
            try self.put_tmp("s", n)
            try self.put(".length * sizeof(")
            try self.put_type(self.elem(t))
            try self.put(") }); }")
            return
        try self.line("(void)(")
        try self.expr(v)
        try self.put(");")

    mutating func with_stmt(s: ast.Node*) -> !:
        let a = s.left else return
        let n = self.tmp()
        try self.line("{")
        self.indent += 1
        try self.line("lb_iface ")
        try self.put_tmp("as", n)
        try self.put(" = lb_memory_allocator;")
        try self.line("lb_memory_allocator = ")
        try self.allocator_view(a)
        try self.put(";")
        try self.push_scope(false, "")
        var sc = self.scopes.get(self.scopes.count - 1)
        sc.restore_alloc = true
        sc.alloc_save = n
        self.scopes.set(self.scopes.count - 1, sc)
        if let body = s.body:
            try self.block(body)
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        self.indent -= 1
        try self.line("}")

    ## Inline assembly (§8.9): `in`/`out`/`inout` operands in named registers.
    mutating func asm_stmt(s: ast.Node*) -> !:
        if s.text == "arm64":
            try self.line("#if defined(__aarch64__)")
        elif s.text == "x86_64":
            try self.line("#if defined(__x86_64__)")
        else:
            try self.line("#if 0")
        try self.line("{")
        self.indent += 1
        var outs = try buffer.Buffer.create(64)
        var ins = try buffer.Buffer.create(64)
        var clobbers = try buffer.Buffer.create(64)
        var stores = try buffer.Buffer.create(64)
        try clobbers.put("\"memory\"")
        var operand = s.right
        while let o = operand:
            if o.text == "options":
                operand = o.next
                continue
            var place = ""
            if let p = o.body:
                let b = p.text.bytes
                if b.length >= 2 and b[0] == '"':
                    place = (str)b[1..<b.length - 1]
            let is_out = o.text == "out" or o.text == "inout"
            let is_in = o.text == "in" or o.text == "inout"
            let v = o.left else return
            if is_out and v.kind == ast.Kind.name and v.text == "_":
                if place.length > 0:
                    try clobbers.put(", \"")
                    try clobbers.put(place)
                    try clobbers.put("\"")
                operand = o.next
                continue
            let n = self.tmp()
            var vt = try self.ty(v)
            if vt == types.unit_id:
                vt = types.i64_id
            try self.line("")
            if place.length > 0 and place != "reg":
                try self.put("register ")
            try self.put_type(vt)
            try self.put(" ")
            try self.put_tmp("as", n)
            if place.length > 0 and place != "reg":
                try self.put(" asm(\"")
                try self.put(place)
                try self.put("\")")
            if is_in:
                try self.put(" = ")
                try self.value(v, vt)
            try self.put(";")
            # a `reg` operand whose expression is a name is a named operand, `[name]`, which the
            # text reaches as `{name}` (§8.9)
            var label = ""
            if (place == "reg" or place.length == 0) and v.kind == ast.Kind.name:
                label = v.text
            if is_out:
                if outs.used > 0:
                    try outs.put(", ")
                try put_asm_label(&outs, label)
                try outs.put("\"+r\"(" if is_in else "\"=r\"(")
                try outs.put("_lb_as")
                try outs.put_u64((u64)n)
                try outs.put(")")
                try stores.put_u64((u64)n)
                try stores.put(" ")
            elif is_in:
                if ins.used > 0:
                    try ins.put(", ")
                try put_asm_label(&ins, label)
                try ins.put("\"r\"(_lb_as")
                try ins.put_u64((u64)n)
                try ins.put(")")
            operand = o.next
        try self.line("asm volatile(\"")
        try self.asm_lines(s.body, true)
        try self.put("\" : ")
        try self.put(outs.view())
        try self.put(" : ")
        try self.put(ins.view())
        try self.put(" : ")
        try self.put(clobbers.view())
        try self.put(");")
        # write the outputs back to their places
        operand = s.right
        var stored = stores.view().bytes
        var pos: usize = 0
        while let o = operand:
            let is_out = o.text == "out" or o.text == "inout"
            if o.text != "options" and is_out:
                let v = o.left else return
                if not (v.kind == ast.Kind.name and v.text == "_"):
                    var digits: usize = pos
                    while digits < stored.length and stored[digits] != ' ':
                        digits += 1
                    try self.line("")
                    try self.place(v)
                    try self.put(" = _lb_as")
                    try self.put((str)stored[pos..<digits])
                    try self.put(";")
                    pos = digits + 1
            operand = o.next
        self.indent -= 1
        try self.line("}")
        try self.line("#endif")

    # mark: Expressions ========================================================================

    ## Write `e` as a value of type `want`, converting where the checker allowed
    ## it: a pointer to an interface view, an array to a span, a value into its
    ## optional, text into a byte span, a function into its fallible shape.
    mutating func value(e: ast.Node*, want: u32) -> !:
        let have = try self.ty(e)
        if want == types.none_id or have == want or have == types.never_id or have == types.error_id:
            try self.expr(e)
            return
        let w = self.c.table.get(want)
        let h = self.c.table.get(have)
        # `none`
        if e.kind == ast.Kind.literal and e.text == "none":
            try self.none_of(want)
            return
        if w.kind == types.Kind.interface_ and h.kind == types.Kind.pointer:
            try self.iface_view(e, h.elem, want)
            return
        if w.kind == types.Kind.interface_ and h.kind == types.Kind.interface_:
            try self.expr(e)
            return
        if w.kind == types.Kind.optional:
            if self.c.table.has_null_niche(w.elem):
                # `T*`, `c.str`, or a function into its nullable form: the same word (§5.3)
                try self.expr(e)
                return
            if h.kind == types.Kind.optional:
                try self.expr(e)
                return
            try self.put("((")
            try self.put_type(want)
            try self.put("){ .value = ")
            try self.value(e, w.elem)
            try self.put(", .present = true })")
            return
        if w.kind == types.Kind.span:
            if h.kind == types.Kind.array:
                try self.put("((")
                try self.put_type(want)
                try self.put("){")
                try self.array_data(e)
                try self.put(", ")
                try self.put_u64(h.length)
                try self.put("ULL})")
                return
            if have == types.str_id or have == types.fmt_id:
                try self.text_as_bytes(e)
                return
            try self.expr(e)
            return
        if want == types.cstr_id and have == types.str_id:
            if e.kind == ast.Kind.literal:
                try self.put_c_string(check.decode_text(e.text))
                return
            try self.put("(")
            try self.expr(e)
            try self.put(".data)")
            return
        if want == types.fmt_id and have == types.str_id:
            try self.expr(e)
            return
        if w.kind == types.Kind.atomic:
            try self.value(e, w.elem)
            return
        if h.kind == types.Kind.atomic:
            try self.put("atomic_load(&(")
            try self.expr(e)
            try self.put("))")
            return
        if w.kind == types.Kind.func_ and h.kind == types.Kind.func_ and w.elem != h.elem:
            # a plain function where a fallible one is wanted: the thunk wraps its result
            try self.thunk(e, have, want)
            return
        if self.is_int(want) and (self.is_int(have) or have == types.untyped_int_id):
            try self.put("(")
            try self.put_type(want)
            try self.put(")(")
            try self.expr(e)
            try self.put(")")
            return
        if self.is_float(want) and (have == types.untyped_int_id or have == types.untyped_float_id or self.is_float(have)):
            try self.put("(")
            try self.put_type(want)
            try self.put(")(")
            try self.expr(e)
            try self.put(")")
            return
        try self.expr(e)

    ## The absent value of an optional type.
    mutating func none_of(t: u32) -> !:
        if self.is_nullable_ptr(t) or self.is_ptr(t) or self.is_func(t):
            try self.put("((void*)0)")
            return
        if self.is_opt(t):
            try self.put("((")
            try self.put_type(t)
            try self.put("){ .present = false })")
            return
        try self.put("{0}")

    ## `((lb_iface){ &(FormatSink){ &buffer }, &table })`: the sink over the buffer being built.
    mutating func format_sink_view() -> !:
        let sink_type = self.c.standard_type("io", "FormatSink")
        let writer = self.c.standard_type("io", "Writer")
        try self.note(sink_type)
        try self.put("((lb_iface){ (void*)&(")
        try self.put_record_name(sink_type)
        # the runtime's `lb_fmtbuf` and core's `FormatBuffer` are one layout, data, capacity, used
        try self.put("){ (")
        try self.put_record_name(self.c.standard_type("core", "FormatBuffer"))
        try self.put("*)&")
        try self.put_tmp(self.sink_prefix, self.sink_index)
        try self.put(" }, &lb_vt_")
        try self.put_mangled(sink_type)
        try self.put("_Writer })")
        try self.note_vtable(sink_type, writer)

    ## `((lb_iface){ pointer, &vtable })` for a struct pointer used as a view.
    mutating func iface_view(e: ast.Node*, target: u32, iface: u32) -> !:
        let d = self.decl_of(target) else return try self.expr(e)
        let i = self.decl_of(iface) else return try self.expr(e)
        try self.put("((lb_iface){ (void*)(")
        try self.expr(e)
        try self.put("), &lb_vt_")
        try self.put_mangled(target)
        try self.put("_")
        try self.put(i.text)
        try self.put(" })")
        try self.note_vtable(target, iface)
        discard(d)

    ## The data pointer of an array-typed expression.
    mutating func array_data(e: ast.Node*) -> !:
        if e.kind == ast.Kind.name or e.kind == ast.Kind.member or e.kind == ast.Kind.index or e.kind == ast.Kind.self_:
            try self.place(e)
            try self.put(".d")
            return
        let n = self.tmp()
        try self.put("({ ")
        try self.put_type(try self.ty(e))
        try self.put(" ")
        try self.put_tmp("ad", n)
        try self.put(" = ")
        try self.expr(e)
        try self.put("; ")
        try self.put_tmp("ad", n)
        try self.put(".d; })")

    ## `str` or `fmt` as `lb_cspan`.
    mutating func text_as_bytes(e: ast.Node*) -> !:
        let n = self.tmp()
        try self.put("({ lb_str ")
        try self.put_tmp("tb", n)
        try self.put(" = ")
        try self.expr(e)
        try self.put("; (lb_cspan){ (void*)(")
        try self.put_tmp("tb", n)
        try self.put(".data), ")
        try self.put_tmp("tb", n)
        try self.put(".length }; })")

    ## A wrapper that lifts a plain function to a fallible function type.
    mutating func thunk(e: ast.Node*, have: u32, want: u32) -> !:
        try self.put("((")
        try self.put_type(want)
        try self.put(")(void*)")
        try self.expr(e)
        try self.put(")")
        discard(have)

    ## An expression by its own type.
    mutating func expr(e: ast.Node*) -> !:
        match e.kind:
            .literal:
                try self.literal(e)
            .name:
                try self.name(e)
            .self_:
                try self.put("(*self)")
            .unit_:
                try self.put("((void)0)")
            .group:
                let inner = e.left else return
                try self.put("(")
                try self.expr(inner)
                try self.put(")")
            .unary:
                try self.unary(e)
            .binary:
                try self.binary(e)
            .conditional:
                let cond = e.ty else return
                let l = e.left else return
                let r = e.right else return
                let t = try self.ty(e)
                try self.put("(")
                try self.value(cond, types.bool_id)
                try self.put(" ? ")
                try self.value(l, t)
                try self.put(" : ")
                try self.value(r, t)
                try self.put(")")
            .call:
                try self.call(e)
            .member:
                try self.member(e)
            .index:
                try self.index(e)
            .slice:
                try self.slice(e)
            .tuple:
                let t = try self.ty(e)
                let tt = self.c.table.get(t)
                try self.put("((")
                try self.put_type(t)
                try self.put("){")
                var i: usize = 0
                var cursor = e.body
                while let m = cursor:
                    if i > 0:
                        try self.put(", ")
                    try self.value(m, tt.args[i] if i < tt.args.length else types.none_id)
                    i += 1
                    cursor = m.next
                try self.put("})")
            .array_lit:
                let t = try self.ty(e)
                try self.put("((")
                try self.put_type(t)
                try self.put("){{")
                var first = true
                var cursor = e.body
                while let m = cursor:
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.value(m, self.elem(t))
                    cursor = m.next
                try self.put("}})")
            .lambda:
                let d = e.resolved else return
                try self.func_value(e, d)
            .else_:
                try self.else_expr(e)
            .catch_:
                try self.catch_expr(e)
            .cast:
                let inner = e.left else return
                try self.conversion(inner, try self.ty(e), false)
            .case_value:
                try self.enum_value(e)
            .formatted:
                try self.formatted_value(e)
            .new_:
                try self.new_expr(e)
            .alloc_:
                try self.alloc_expr(e)
            .span_make:
                let first = e.body else return
                let p = first.left else return
                let second = first.next else return
                let count = second.left else return
                try self.put("((lb_span){(void*)(")
                try self.expr(p)
                try self.put("), (size_t)(")
                try self.expr(count)
                try self.put(")})")
            .match_expr:
                try self.match_expr(e)
            .return_:
                # `else return x`: leaves the function from inside an expression
                try self.return_in_expr(e)
            .break_:
                let target = self.loop_scope(e.text)
                try self.unwind_from(target + 1, false)
                if e.text.length == 0:
                    try self.put("break")
                else:
                    try self.put("goto lb_brk_")
                    try self.put(e.text)
            .continue_:
                let target = self.loop_scope(e.text)
                try self.unwind_from(target + 1, false)
                if e.text.length == 0:
                    try self.put("continue")
                else:
                    try self.put("goto lb_cont_")
                    try self.put(e.text)
            _:
                try self.put("/* unsupported expression */ 0")

    ## A `return` inside an expression, written as statements in a brace block.
    mutating func return_in_expr(e: ast.Node*) -> !:
        try self.put("{")
        self.indent += 1
        try self.return_stmt(e)
        self.indent -= 1
        try self.line("}")

    # -- literals and names ---------------------------------------------------------------

    mutating func literal(e: ast.Node*) -> !:
        let t = try self.ty(e)
        if e.text == "true" or e.text == "false":
            try self.put(e.text)
            return
        if e.text == "none":
            try self.none_of(t)
            return
        let b = e.text.bytes
        if b[0] == '\'':
            try self.put_u64((u64)check.decode_char(e.text))
            try self.put("u")
            return
        if b[0] == '"' or b[0] == 'r':
            let text = check.decode_text(e.text)
            if t == types.cstr_id:
                try self.put_c_string(text)
                return
            try self.put_str_literal(text)
            return
        if b[0] == 'b':
            let bytes = check.decode_text(e.text)
            try self.put("((lb_cspan){(void*)")
            try self.put_c_string(bytes)
            try self.put(", ")
            try self.put_u64((u64)bytes.length)
            try self.put("})")
            return
        if check.is_float_text(e.text):
            try self.put(strip_underscores(e.text))
            if t == types.f32_id:
                try self.put("f")
            return
        let value = try check.decode_integer(e.text)
        if self.is_float(t):
            try self.put_u64(value)
            try self.put(".0")
            return
        if self.is_int(t) and not self.is_signed(t) or t == types.error_code_id:
            try self.put_u64(value)
            try self.put("ULL")
            return
        if value == 9223372036854775808:
            try self.put("(int64_t)(1ULL << 63)")
            return
        try self.put_u64(value)
        try self.put("LL")

    mutating func name(e: ast.Node*) -> !:
        if e.has(ast.flag_format_sink):
            try self.format_sink_view()
            return
        if let d = e.resolved:
            if d.kind == ast.Kind.enum_case:
                try self.enum_value(e)
                return
            if d.kind == ast.Kind.func_ or d.kind == ast.Kind.extern_func:
                try self.func_value(e, d)
                return
            if d.kind == ast.Kind.extern_var or d.kind == ast.Kind.global or d.kind == ast.Kind.constant:
                try self.put_global_name(d)
                return
        try self.put_ident(e.text)

    ## A function used as a value: its instance's C name.
    mutating func func_value(e: ast.Node*, d: ast.Node*) -> !:
        if d.kind == ast.Kind.extern_func:
            try self.put(names.c_symbol(d))
            return
        var args = try types.no_args()
        if let t = e.ty:
            args = try self.type_args(t)
        if check.generic_params_of(d) != none or args.length > 0:
            discard(try self.add_func(d, args, none, try types.no_args()))
        else:
            discard(try self.add_func(d, args, none, try types.no_args()))
        try self.put_func_name(d, args, none, try types.no_args())

    ## The concrete type arguments recorded on a call or name.
    mutating func type_args(holder: ast.Node*) -> u32[]!:
        let n = ast.count(holder.body)
        if n == 0:
            return try types.no_args()
        var args = try alloc u32[n]
        var i: usize = 0
        var cursor = holder.body
        while let a = cursor:
            args[i] = try self.map(a.type_id)
            i += 1
            cursor = a.next
        return args

    ## An enum case value: the integer, or the tagged record with its payload.
    mutating func enum_value(e: ast.Node*) -> !:
        let c = e.resolved else return try self.put("0")
        let t = try self.ty(e)
        let d = self.decl_of(t) else return try self.put("0")
        if self.is_int_enum(t):
            try self.put("((")
            try self.put_type(t)
            try self.put(")")
            try self.put_u64(case_int(d, c))
            try self.put("u)")
            return
        try self.put("((")
        try self.put_type(t)
        try self.put("){ .tag = ")
        try self.put_u64((u64)case_tag(d, c))
        if e.body != none and c.body != none:
            try self.put(", .u.")
            try self.put(c.text)
            try self.put(" = {")
            var param = c.body
            var arg = e.body
            var first = true
            while let p = param:
                let a = arg else break
                let v = a.left else break
                if not first:
                    try self.put(", ")
                first = false
                try self.put(".")
                try self.put(p.text)
                try self.put(" = ")
                try self.value(v, try self.map(p.type_id))
                param = p.next
                arg = a.next
            try self.put("}")
        try self.put(" })")

    # -- places ---------------------------------------------------------------------------

    ## An assignable location.
    mutating func place(e: ast.Node*) -> !:
        match e.kind:
            .self_:
                try self.put("(*self)")
            .group:
                let inner = e.left else return
                try self.place(inner)
            .unary:
                let inner = e.left else return
                try self.put("(*(")
                try self.expr(inner)
                try self.put("))")
            .member:
                try self.member(e)
            .index:
                try self.index(e)
            _:
                try self.expr(e)

    ## `&e`: the address of a place, or of a temporary for a value.
    mutating func address(e: ast.Node*) -> !:
        if e.kind == ast.Kind.self_:
            try self.put("self")
            return
        if e.kind == ast.Kind.group:
            let inner = e.left else return
            try self.address(inner)
            return
        if e.kind == ast.Kind.name and self.is_array(try self.ty(e)):
            try self.put_ident(e.text)
            try self.put(".d")
            return
        if e.kind == ast.Kind.name or e.kind == ast.Kind.member or e.kind == ast.Kind.index:
            try self.put("&(")
            try self.place(e)
            try self.put(")")
            return
        if e.kind == ast.Kind.unary and e.text == "*":
            let inner = e.left else return
            try self.expr(inner)
            return
        let n = self.tmp()
        try self.put("({ ")
        try self.put_type(try self.ty(e))
        try self.put(" ")
        try self.put_tmp("ad", n)
        try self.put(" = ")
        try self.expr(e)
        try self.put("; &")
        try self.put_tmp("ad", n)
        try self.put("; })")

    # -- operators ------------------------------------------------------------------------

    mutating func unary(e: ast.Node*) -> !:
        let inner = e.left else return
        if e.text == "try":
            try self.try_expr(e)
            return
        if e.text == "not":
            try self.put("(!")
            try self.value(inner, types.bool_id)
            try self.put(")")
            return
        if e.text == "&":
            try self.address(inner)
            return
        if e.text == "*":
            try self.put("(*(")
            try self.expr(inner)
            try self.put("))")
            return
        if e.text == "+":
            try self.expr(inner)
            return
        let t = try self.ty(e)
        if self.is_float(t):
            try self.put("(-(")
            try self.expr(inner)
            try self.put("))")
            return
        if e.text == "~":
            if self.is_int(t) and not self.is_signed(t):
                try self.put("((")
                try self.put_type(t)
                try self.put(")lb_not_u((uint64_t)(")
                try self.expr(inner)
                try self.put("), ")
                try self.put_u64((u64)self.bits(t))
                try self.put("))")
                return
            try self.put("((")
            try self.put_type(t)
            try self.put(")~(")
            try self.expr(inner)
            try self.put("))")
            return
        if e.text == "-%":
            try self.put("((")
            try self.put_type(t)
            try self.put(")")
            try self.put("lb_negw_s(" if self.signed_of(t) else "lb_negw_u(")
            try self.word(t, inner)
            try self.put(", ")
            try self.put_u64((u64)self.bits(t))
            try self.put("))")
            return
        # `-literal` is one constant, not a checked negation: `-128` is a valid `i8`
        if inner.kind == ast.Kind.literal and self.c.table.is_integer(t):
            let v = check.decode_integer(inner.text) catch failure:
                recover 0
            if v == 9223372036854775808:
                try self.put("((int64_t)(1ULL << 63))")
                return
            if v <= 9223372036854775807:
                try self.put("((")
                try self.put_type(t)
                try self.put(")(-")
                try self.put_u64(v)
                try self.put("LL))")
                return
        try self.put("((")
        try self.put_type(t)
        try self.put(")lb_neg_s((int64_t)(")
        try self.expr(inner)
        try self.put("), ")
        try self.put_u64((u64)self.bits(t))
        try self.put("))")

    mutating func binary(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let op = e.text
        if op == "and" or op == "or":
            try self.put("(")
            try self.value(l, types.bool_id)
            try self.put(" && " if op == "and" else " || ")
            try self.value(r, types.bool_id)
            try self.put(")")
            return
        let lt = try self.ty(l)
        let rt = try self.ty(r)
        let t = try self.ty(e)
        # the operand type: the typed side, or the result
        var ot = lt
        if lt == types.untyped_int_id or lt == types.untyped_float_id or lt == types.none_id:
            ot = rt
        if ot == types.untyped_int_id or ot == types.none_id:
            ot = types.i64_id
        elif ot == types.untyped_float_id:
            ot = types.f64_id
        if op == "==" or op == "!=":
            try self.equality(l, lt, r, rt, ot, op == "!=")
            return
        if op == "<" or op == "<=" or op == ">" or op == ">=":
            if ot == types.str_id:
                try self.put("(lb_str_compare(")
                try self.expr(l)
                try self.put(", ")
                try self.expr(r)
                try self.put(") ")
                try self.put(op)
                try self.put(" 0)")
                return
            try self.put("(((")
            try self.put_type(ot)
            try self.put(")(")
            try self.value(l, ot)
            try self.put(")) ")
            try self.put(op)
            try self.put(" ((")
            try self.put_type(ot)
            try self.put(")(")
            try self.value(r, ot)
            try self.put(")))")
            return
        if self.is_ptr(ot):
            try self.put("(")
            try self.expr(l)
            if op == "-" and self.is_ptr(rt):
                try self.put(" - ")
                try self.expr(r)
                try self.put(")")
                return
            try self.put(" ")
            try self.put(op)
            try self.put(" (ptrdiff_t)(")
            try self.expr(r)
            try self.put("))")
            return
        if self.is_float(ot):
            try self.put("(")
            try self.value(l, ot)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.value(r, ot)
            try self.put(")")
            return
        if op == "&" or op == "|" or op == "^":
            try self.put("((")
            try self.put_type(ot)
            try self.put(")(")
            try self.value(l, ot)
            try self.put(" ")
            try self.put(op)
            try self.put(" ")
            try self.value(r, ot)
            try self.put("))")
            return
        if op == "+?" or op == "-?" or op == "*?":
            let n = self.tmp()
            let et = self.elem(t)
            try self.put("({ ")
            try self.put("int64_t " if self.signed_of(et) else "uint64_t ")
            try self.put_tmp("qo", n)
            try self.put("; ")
            try self.put_type(t)
            try self.put(" ")
            try self.put_tmp("qr", n)
            try self.put("; ")
            try self.put_tmp("qr", n)
            try self.put(".present = lb_")
            try self.put("qadd" if op == "+?" else ("qsub" if op == "-?" else "qmul"))
            try self.put("_s(" if self.signed_of(et) else "_u(")
            try self.word(et, l)
            try self.put(", ")
            try self.word(et, r)
            try self.put(", ")
            try self.put_u64((u64)self.bits(et))
            try self.put(", &")
            try self.put_tmp("qo", n)
            try self.put("); ")
            try self.put_tmp("qr", n)
            try self.put(".value = (")
            try self.put_type(et)
            try self.put(")(")
            try self.put_tmp("qo", n)
            try self.put("); ")
            try self.put_tmp("qr", n)
            try self.put("; })")
            return
        try self.checked_op(helper_name(op), ot, l, r)

    ## `==` and `!=` over scalars, text, pointers, and tagged optionals.
    mutating func equality(l: ast.Node*, lt: u32, r: ast.Node*, rt: u32, ot: u32, negate: bool) -> !:
        let l_none = l.kind == ast.Kind.literal and l.text == "none"
        let r_none = r.kind == ast.Kind.literal and r.text == "none"
        let tagged = self.is_tagged_opt(lt) or self.is_tagged_opt(rt)
        if negate:
            try self.put("(!")
        if tagged:
            let n = self.tmp()
            if l_none or r_none:
                let side = r if l_none else l
                try self.put("({ ")
                try self.put_type(rt if l_none else lt)
                try self.put(" ")
                try self.put_tmp("on", n)
                try self.put(" = ")
                try self.expr(side)
                try self.put("; !")
                try self.put_tmp("on", n)
                try self.put(".present; })")
            else:
                let vt = lt if self.is_tagged_opt(lt) else rt
                try self.put("({ ")
                try self.put_type(vt)
                try self.put(" ")
                try self.put_tmp("oa", n)
                try self.put(" = ")
                try self.value(l, vt)
                try self.put("; ")
                try self.put_type(vt)
                try self.put(" ")
                try self.put_tmp("ob", n)
                try self.put(" = ")
                try self.value(r, vt)
                try self.put("; (")
                try self.put_tmp("oa", n)
                try self.put(".present == ")
                try self.put_tmp("ob", n)
                try self.put(".present) && (!")
                try self.put_tmp("oa", n)
                try self.put(".present || ")
                try self.put_tmp("oa", n)
                try self.put(".value == ")
                try self.put_tmp("ob", n)
                try self.put(".value); })")
        elif ot == types.str_id or ot == types.fmt_id:
            let n = self.tmp()
            try self.put("({ lb_str ")
            try self.put_tmp("sa", n)
            try self.put(" = ")
            try self.expr(l)
            try self.put("; lb_str ")
            try self.put_tmp("sb", n)
            try self.put(" = ")
            try self.expr(r)
            try self.put("; (")
            try self.put_tmp("sa", n)
            try self.put(".length == ")
            try self.put_tmp("sb", n)
            try self.put(".length && (")
            try self.put_tmp("sa", n)
            try self.put(".length == 0 || memcmp(")
            try self.put_tmp("sa", n)
            try self.put(".data, ")
            try self.put_tmp("sb", n)
            try self.put(".data, ")
            try self.put_tmp("sa", n)
            try self.put(".length) == 0)); })")
        elif self.is_record(ot) or self.is_tuple(ot) or self.is_array(ot):
            let n = self.tmp()
            try self.put("({ ")
            try self.put_type(ot)
            try self.put(" ")
            try self.put_tmp("ea", n)
            try self.put(" = ")
            try self.value(l, ot)
            try self.put("; ")
            try self.put_type(ot)
            try self.put(" ")
            try self.put_tmp("eb", n)
            try self.put(" = ")
            try self.value(r, ot)
            try self.put("; memcmp(&")
            try self.put_tmp("ea", n)
            try self.put(", &")
            try self.put_tmp("eb", n)
            try self.put(", sizeof(")
            try self.put_tmp("ea", n)
            try self.put(")) == 0; })")
        else:
            try self.put("(")
            if l_none:
                try self.put("((void*)0)")
            else:
                try self.value(l, ot)
            try self.put(" == ")
            if r_none:
                try self.put("((void*)0)")
            else:
                try self.value(r, ot)
            try self.put(")")
        if negate:
            try self.put(")")

    # -- conversions ----------------------------------------------------------------------

    ## `(T)x` (C cast, `checked` false) and `T(x)` (checked, `checked` true).
    mutating func conversion(src: ast.Node*, dest: u32, checked: bool) -> !:
        let st = try self.ty(src)
        let s = self.c.table.get(st)
        if dest == types.str_id and (st == types.cstr_id or ((s.kind == types.Kind.span or s.kind == types.Kind.array) and s.elem == types.u8_id)):
            try self.str_conversion(src, checked)
            return
        if dest == types.cstr_id and st == types.str_id:
            try self.put("(")
            try self.expr(src)
            try self.put(".data)")
            return
        if st == types.cstr_id and dest == types.str_id:
            try self.str_conversion(src, checked)
            return
        if self.is_int_enum(dest):
            if checked:
                try self.enum_check(dest, src)
                return
            try self.put("((")
            try self.put_type(dest)
            try self.put(")(")
            try self.expr(src)
            try self.put("))")
            return
        if self.is_int_enum(st) and self.is_int(dest):
            try self.put("((")
            try self.put_type(dest)
            try self.put(")(")
            try self.expr(src)
            try self.put("))")
            return
        let mode = "0" if checked else "1"
        if self.is_float(st) and self.is_int(dest):
            try self.put("((")
            try self.put_type(dest)
            try self.put(")")
            try self.put("lb_f_to_s((double)(" if self.is_signed(dest) else "lb_f_to_u((double)(")
            try self.expr(src)
            try self.put("), ")
            try self.put_u64((u64)self.bits(dest))
            try self.put(", ")
            try self.put(mode)
            try self.put("))")
            return
        if (self.is_int(st) or st == types.untyped_int_id) and self.is_float(dest):
            let signed = st == types.untyped_int_id or self.is_signed(st)
            if dest == types.f32_id:
                try self.put("(float)")
            try self.put("lb_to_f(")
            try self.put("(int64_t)(" if signed else "(uint64_t)(")
            try self.expr(src)
            try self.put("), ")
            try self.put("1" if signed else "0")
            try self.put(")")
            return
        if (self.is_float(st) or st == types.untyped_float_id) and self.is_float(dest):
            try self.put("((")
            try self.put_type(dest)
            try self.put(")(")
            try self.expr(src)
            try self.put("))")
            return
        let s_word = self.is_int(st) or st == types.char_id or st == types.bool_id or st == types.untyped_int_id
        let d_word = self.is_int(dest) or dest == types.char_id
        if s_word and d_word:
            let fb = 32 if st == types.char_id else (64 if st == types.untyped_int_id or st == types.bool_id else self.bits(st))
            let tb = 32 if dest == types.char_id else self.bits(dest)
            let fs = st != types.char_id and st != types.bool_id and (st == types.untyped_int_id or self.is_signed(st))
            let ts = dest != types.char_id and self.is_signed(dest)
            try self.put("((")
            try self.put_type(dest)
            try self.put(")")
            try self.put("lb_conv_s(" if fs else "lb_conv_u(")
            try self.put("(int64_t)(" if fs else "(uint64_t)(")
            try self.expr(src)
            try self.put("), ")
            try self.put_u64((u64)fb)
            try self.put(", ")
            try self.put("1" if fs else "0")
            try self.put(", ")
            try self.put_u64((u64)tb)
            try self.put(", ")
            try self.put("1" if ts else "0")
            try self.put(", ")
            try self.put(mode)
            try self.put("))")
            return
        # pointers, spans, and everything else C converts by itself
        try self.put("((")
        try self.put_type(dest)
        try self.put(")(")
        try self.expr(src)
        try self.put("))")

    ## `Kind(n)`: trap unless `n` is a declared case.
    mutating func enum_check(dest: u32, src: ast.Node*) -> !:
        let d = self.decl_of(dest) else return try self.expr(src)
        let n = self.tmp()
        try self.put("({ ")
        try self.put_type(dest)
        try self.put(" ")
        try self.put_tmp("ev", n)
        try self.put(" = (")
        try self.put_type(dest)
        try self.put(")(")
        try self.expr(src)
        try self.put("); if (!(")
        var first = true
        var cursor = d.body
        while let c = cursor:
            if c.kind == ast.Kind.enum_case:
                if not first:
                    try self.put(" || ")
                first = false
                try self.put_tmp("ev", n)
                try self.put(" == ")
                try self.put_u64(case_int(d, c))
                try self.put("u")
            cursor = c.next
        if first:
            try self.put("0")
        try self.put(")) lb_trap(\"invalid enum value\"); ")
        try self.put_tmp("ev", n)
        try self.put("; })")

    ## `(str)bytes` and `str(bytes)`: a view, checked for UTF-8 when `checked`.
    mutating func str_conversion(src: ast.Node*, checked: bool) -> !:
        let st = try self.ty(src)
        let n = self.tmp()
        try self.put("({ ")
        if st == types.cstr_id:
            try self.put("const char* ")
            try self.put_tmp("sb", n)
            try self.put(" = ")
            try self.expr(src)
            try self.put("; size_t ")
            try self.put_tmp("sl", n)
            try self.put(" = ")
            try self.put_tmp("sb", n)
            try self.put(" == NULL ? 0 : strlen(")
            try self.put_tmp("sb", n)
            try self.put("); ")
        elif self.is_array(st):
            try self.put_type(st)
            try self.put(" ")
            try self.put_tmp("sc", n)
            try self.put(" = ")
            try self.expr(src)
            try self.put("; const char* ")
            try self.put_tmp("sb", n)
            try self.put(" = (const char*)")
            try self.put_tmp("sc", n)
            try self.put(".d; size_t ")
            try self.put_tmp("sl", n)
            try self.put(" = ")
            try self.put_u64(self.c.table.get(st).length)
            try self.put("ULL; ")
        else:
            try self.put("lb_span ")
            try self.put_tmp("sc", n)
            try self.put(" = ")
            try self.expr(src)
            try self.put("; const char* ")
            try self.put_tmp("sb", n)
            try self.put(" = (const char*)")
            try self.put_tmp("sc", n)
            try self.put(".data; size_t ")
            try self.put_tmp("sl", n)
            try self.put(" = ")
            try self.put_tmp("sc", n)
            try self.put(".length; ")
        if not checked:
            try self.put("(lb_str){ ")
            try self.put_tmp("sb", n)
            try self.put(", ")
            try self.put_tmp("sl", n)
            try self.put(" }; })")
            return
        let res = try self.c.table.fallible(types.str_id)
        try self.note(res)
        try self.put("lb_r_str ")
        try self.put_tmp("sr", n)
        try self.put("; if (!lb_utf8_ok(")
        try self.put_tmp("sb", n)
        try self.put(", ")
        try self.put_tmp("sl", n)
        try self.put(")) { ")
        try self.put_tmp("sr", n)
        try self.put(".failed = true; ")
        try self.put_tmp("sr", n)
        try self.put(".error = (lb_error){ .code = LB_INVALID_UTF8, .message = (lb_str){\"invalid_utf8\", 12} }; } else { ")
        try self.put_tmp("sr", n)
        try self.put(".failed = false; ")
        try self.put_tmp("sr", n)
        try self.put(".value = (lb_str){ ")
        try self.put_tmp("sb", n)
        try self.put(", ")
        try self.put_tmp("sl", n)
        try self.put(" }; } ")
        try self.put_tmp("sr", n)
        try self.put("; })")

    # -- members, indexing, slicing -------------------------------------------------------

    mutating func member(e: ast.Node*) -> !:
        let owner = e.left else return
        if let d = e.resolved:
            if d.kind == ast.Kind.enum_case:
                try self.enum_value(e)
                return
            if d.kind == ast.Kind.func_ or d.kind == ast.Kind.extern_func:
                try self.method_value(e, owner, d)
                return
            if d.kind == ast.Kind.constant or d.kind == ast.Kind.global or d.kind == ast.Kind.extern_var:
                try self.put_global_name(d)
                return
        let ot = try self.ty(owner)
        if self.kind(ot) == types.Kind.module:
            try self.module_member(e, ot)
            return
        let raw = self.elem(ot) if self.is_ptr(ot) else ot
        let through_ptr = self.is_ptr(ot)
        if e.text == "length" and (raw == types.str_id or self.is_span(raw)):
            try self.put("(")
            try self.expr(owner)
            try self.put("->length)" if through_ptr else ".length)")
            return
        if e.text == "length" and self.is_array(raw):
            try self.put_u64(self.c.table.get(raw).length)
            try self.put("ULL")
            return
        if e.text == "data" and (raw == types.str_id or self.is_span(raw)):
            try self.put("((")
            try self.put_type(try self.ty(e))
            try self.put(")(")
            try self.expr(owner)
            try self.put("->data))" if through_ptr else ".data))")
            return
        if e.text == "bytes" and raw == types.str_id:
            try self.put("((lb_cspan){(void*)(")
            try self.expr(owner)
            try self.put("->data), " if through_ptr else ".data), ")
            try self.expr(owner)
            try self.put("->length})" if through_ptr else ".length})")
            return
        if raw == types.error_value_id:
            try self.put("(")
            try self.expr(owner)
            try self.put("->" if through_ptr else ".")
            try self.put(e.text)
            try self.put(")")
            return
        if owner.kind == ast.Kind.self_:
            try self.put("self->")
            try self.put(e.text)
            return
        if through_ptr:
            try self.put("(")
            try self.expr(owner)
            try self.put(")->")
            try self.put(e.text)
            return
        try self.expr(owner)
        try self.put(".")
        try self.put(e.text)

    ## `luce.file`, `luce.line`, `luce.function`, `luce.location`, and a module's constants.
    mutating func module_member(e: ast.Node*, module_type: u32) -> !:
        let m = self.decl_of(module_type) else return try self.put("0")
        if m.text == "luce":
            if e.text == "location":
                try self.location_value(e)
            elif e.text == "file":
                try self.put_str_literal(self.src_file)
            elif e.text == "line":
                try self.put_u64((u64)e.line)
                try self.put("u")
            else:
                try self.function_name_literal()
            return
        try self.put_ident(e.text)

    mutating func location_value(e: ast.Node*) -> !:
        try self.put("((lb_io_Location){ .file = ")
        try self.put_str_literal(self.src_file)
        try self.put(", .line = ")
        try self.put_u64((u64)e.line)
        try self.put("u, .function = ")
        try self.function_name_literal()
        try self.put(" })")

    mutating func function_name_literal() -> !:
        let f = self.current_fn else return try self.put_str_literal("")
        try self.put_str_literal(f.text)

    mutating func index(e: ast.Node*) -> !:
        let owner = e.left else return
        let i = e.body else return
        let ot = try self.ty(owner)
        if self.is_array(ot):
            try self.put("((")
            try self.expr(owner)
            try self.put(").d[(lb_check_index((uint64_t)(")
            try self.expr(i)
            try self.put("), ")
            try self.put_u64(self.c.table.get(ot).length)
            try self.put("ULL), ")
            try self.expr(i)
            try self.put(")])")
            return
        if self.is_span(ot):
            try self.put("(((")
            try self.put_type(self.elem(ot))
            try self.put("*)")
            try self.expr(owner)
            try self.put(".data)[(lb_check_index((uint64_t)(")
            try self.expr(i)
            try self.put("), ")
            try self.expr(owner)
            try self.put(".length), ")
            try self.expr(i)
            try self.put(")])")
            return
        if self.is_ptr(ot):
            let inner = self.elem(ot)
            if self.is_array(inner):
                try self.put("((")
                try self.expr(owner)
                try self.put(")->d[(lb_check_index((uint64_t)(")
                try self.expr(i)
                try self.put("), ")
                try self.put_u64(self.c.table.get(inner).length)
                try self.put("ULL), ")
                try self.expr(i)
                try self.put(")])")
                return
            try self.put("((")
            try self.expr(owner)
            try self.put(")[")
            try self.expr(i)
            try self.put("])")
            return
        try self.put("0")

    mutating func slice(e: ast.Node*) -> !:
        let owner = e.left else return
        let ot = try self.ty(owner)
        let n = self.tmp()
        let result = try self.ty(e)
        try self.put("({ ")
        if self.is_array(ot):
            # read through `const`, since the array may sit behind a `const` pointer; the
            # span's data pointer casts it away below, as the checker allowed
            try self.put("const ")
            try self.put_type(ot)
            try self.put("* ")
            try self.put_tmp("sp", n)
            try self.put(" = &(")
            try self.place(owner)
            try self.put("); size_t ")
            try self.put_tmp("sn", n)
            try self.put(" = ")
            try self.put_u64(self.c.table.get(ot).length)
            try self.put("ULL; ")
            try self.put_type(self.elem(ot))
            try self.put("* ")
            try self.put_tmp("sd", n)
            try self.put(" = (")
            try self.put_type(self.elem(ot))
            try self.put("*)(")
            try self.put_tmp("sp", n)
            try self.put("->d); ")
        else:
            try self.put("lb_span ")
            try self.put_tmp("sv", n)
            try self.put(" = ")
            try self.expr(owner)
            try self.put("; size_t ")
            try self.put_tmp("sn", n)
            try self.put(" = ")
            try self.put_tmp("sv", n)
            try self.put(".length; ")
            try self.put_type(self.elem(ot))
            try self.put("* ")
            try self.put_tmp("sd", n)
            try self.put(" = (")
            try self.put_type(self.elem(ot))
            try self.put("*)")
            try self.put_tmp("sv", n)
            try self.put(".data; ")
        try self.put("size_t ")
        try self.put_tmp("ss", n)
        try self.put(" = ")
        if let start = e.body:
            try self.put("(size_t)(")
            try self.value(start, types.usize_id)
            try self.put(")")
        else:
            try self.put("0")
        try self.put("; size_t ")
        try self.put_tmp("se", n)
        try self.put(" = ")
        if let end = e.right:
            try self.put("(size_t)(")
            try self.value(end, types.usize_id)
            try self.put(")")
        else:
            try self.put_tmp("sn", n)
        try self.put("; lb_check_index(")
        try self.put_tmp("ss", n)
        try self.put(", ")
        try self.put_tmp("sn", n)
        try self.put(" + 1); lb_check_index(")
        try self.put_tmp("se", n)
        try self.put(", ")
        try self.put_tmp("sn", n)
        try self.put(" + 1); if (")
        try self.put_tmp("ss", n)
        try self.put(" > ")
        try self.put_tmp("se", n)
        try self.put(") lb_trap(\"index out of bounds\"); (")
        try self.put_type(result)
        try self.put("){ (void*)(")
        try self.put_tmp("sd", n)
        try self.put(" + ")
        try self.put_tmp("ss", n)
        try self.put("), ")
        try self.put_tmp("se", n)
        try self.put(" - ")
        try self.put_tmp("ss", n)
        try self.put(" }; })")

    # -- failure and absence --------------------------------------------------------------

    ## `try x`: the value, or the caller's failure returned with cleanup run.
    mutating func try_expr(e: ast.Node*) -> !:
        let inner = e.left else return
        let ft = try self.ty(inner)
        let payload = self.elem(ft)
        let n = self.tmp()
        try self.put("({ ")
        try self.put_type(ft)
        try self.put(" ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.expr(inner)
        try self.put("; if (")
        try self.put_tmp("r", n)
        try self.put(".failed) {")
        self.indent += 1
        try self.unwind_from(0, true)
        try self.line("return ")
        if self.fn_fallible():
            try self.put("((")
            try self.put_result_type(self.current_fn else return)
            try self.put("){ .error = ")
            try self.put_tmp("r", n)
            try self.put(".error, .failed = true })")
        else:
            try self.put_tmp("r", n)
        try self.put(";")
        self.indent -= 1
        try self.line("} ")
        if payload == types.unit_id or payload == types.never_id:
            try self.put("(void)0; })")
        else:
            try self.put_tmp("r", n)
            try self.put(".value; })")

    ## `x else y`: the payload of an optional or fallible, or the alternative.
    mutating func else_expr(e: ast.Node*) -> !:
        let l = e.left else return
        let r = e.right else return
        let lt = try self.ty(l)
        let payload = self.elem(lt)
        let n = self.tmp()
        let leaves = r.kind == ast.Kind.return_ or r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_ or is_error_call(r) or is_trap_call(r) or r.type_id == types.never_id
        try self.put("({ ")
        try self.put_type(lt)
        try self.put(" ")
        try self.put_tmp("o", n)
        try self.put(" = ")
        try self.expr(l)
        try self.put("; ")
        var present_test = "present"
        if self.is_fail(lt):
            try self.put("if (")
            try self.put_tmp("o", n)
            try self.put(".failed) ")
        elif self.is_tagged_opt(lt):
            try self.put("if (!")
            try self.put_tmp("o", n)
            try self.put(".present) ")
        else:
            try self.put("if (")
            try self.put_tmp("o", n)
            try self.put(" == ((void*)0)) ")
        if leaves:
            try self.put("{")
            self.indent += 1
            if is_error_call(r):
                try self.error_return(r)
            elif r.kind == ast.Kind.return_:
                try self.return_stmt(r)
            elif r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
                try self.jump(r)
            else:
                try self.line("(void)(")
                try self.expr(r)
                try self.put(");")
            self.indent -= 1
            try self.line("} ")
        else:
            try self.put("{ ")
            if payload != types.unit_id:
                try self.put_tmp("o", n)
                if self.is_fail(lt):
                    try self.put(".value = ")
                elif self.is_tagged_opt(lt):
                    try self.put(".value = ")
                else:
                    try self.put(" = ")
                try self.value(r, payload)
                try self.put("; ")
            else:
                try self.put("(void)(")
                try self.expr(r)
                try self.put("); ")
            try self.put("} ")
        if payload == types.unit_id or payload == types.never_id:
            try self.put("(void)0; })")
        else:
            try self.put_tmp("o", n)
            if self.is_fail(lt) or self.is_tagged_opt(lt):
                try self.put(".value; })")
            else:
                try self.put("; })")
        discard(present_test)

    ## `x catch name:` with its handler as statements.
    mutating func catch_expr(e: ast.Node*) -> !:
        let l = e.left else return
        let body = e.body else return
        let ft = try self.ty(l)
        let payload = self.elem(ft)
        let n = self.tmp()
        let saved_var = self.catch_var
        let saved_done = self.catch_done
        let saved_payload = self.catch_payload
        let saved_in = self.in_catch
        try self.put("({ ")
        try self.put_type(ft)
        try self.put(" ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.expr(l)
        try self.put("; ")
        if payload != types.unit_id and payload != types.never_id:
            try self.put_type(payload)
        else:
            try self.put("int")
        try self.put(" ")
        try self.put_tmp("v", n)
        try self.put(" = {0}; if (")
        try self.put_tmp("r", n)
        try self.put(".failed) {")
        self.indent += 1
        if e.text.length > 0:
            try self.line("lb_error ")
            try self.put_ident(e.text)
            try self.put(" __attribute__((unused)) = ")
            try self.put_tmp("r", n)
            try self.put(".error;")
        self.catch_var = n
        self.catch_done = n
        self.catch_payload = payload
        self.in_catch = true
        try self.block(body)
        self.catch_var = saved_var
        self.catch_done = saved_done
        self.catch_payload = saved_payload
        self.in_catch = saved_in
        try self.line("__attribute__((unused)) ")
        try self.put_tmp("cd", n)
        try self.put(": ;")
        self.indent -= 1
        try self.line("} else { ")
        if payload != types.unit_id and payload != types.never_id:
            try self.put_tmp("v", n)
            try self.put(" = ")
            try self.put_tmp("r", n)
            try self.put(".value; ")
        try self.put("} ")
        try self.put_tmp("v", n)
        try self.put("; })")

    # -- match ----------------------------------------------------------------------------

    ## `match` as a statement (`dest` 0) or filling the expression temporary `dest`.
    mutating func match_stmt(m: ast.Node*, dest: u32) -> !:
        let scrutinee = m.left else return
        let st = try self.ty(scrutinee)
        let n = self.tmp()
        try self.line("")
        try self.put_type(st)
        try self.put(" ")
        try self.put_tmp("m", n)
        try self.put(" = ")
        try self.value(scrutinee, st)
        try self.put(";")
        if self.is_int(st) or self.is_int_enum(st) or st == types.bool_id or st == types.char_id:
            try self.line("switch ((int64_t)(")
            try self.put_tmp("m", n)
            try self.put(")) {")
            self.indent += 1
            var arm = m.body
            while let a = arm:
                var pattern = a.left
                while let p = pattern:
                    if p.has(ast.flag_wildcard):
                        try self.line("default:")
                    elif let v = p.left:
                        if let c = v.resolved:
                            if c.kind == ast.Kind.enum_case:
                                let d = self.decl_of(st) else return
                                try self.line("case ")
                                try self.put_u64(case_int(d, c))
                                try self.put("LL:")
                                pattern = p.next
                                continue
                        if let hi = p.right:
                            try self.line("case ")
                            try self.value(v, st)
                            try self.put(" ... ")
                            if p.text == "..<":
                                try self.put("(")
                                try self.value(hi, st)
                                try self.put(" - 1)")
                            else:
                                try self.value(hi, st)
                            try self.put(":")
                        else:
                            try self.line("case ")
                            try self.value(v, st)
                            try self.put(":")
                    pattern = p.next
                try self.arm_body(a, dest, n, true)
                arm = a.next
            self.indent -= 1
            try self.line("}")
            return
        if self.kind(st) == types.Kind.enum_:
            let d = self.decl_of(st) else return
            try self.line("switch ((int)(")
            try self.put_tmp("m", n)
            try self.put(".tag)) {")
            self.indent += 1
            var arm = m.body
            while let a = arm:
                var pattern = a.left
                var payload_pattern: ast.Node*? = none
                while let p = pattern:
                    if p.has(ast.flag_wildcard):
                        try self.line("default:")
                    elif let v = p.left:
                        if let c = v.resolved:
                            try self.line("case ")
                            try self.put_u64((u64)case_tag(d, c))
                            try self.put(":")
                            if v.body != none:
                                payload_pattern = p
                    pattern = p.next
                try self.line("{")
                self.indent += 1
                if let p = payload_pattern:
                    if let v = p.left:
                        if let c = v.resolved:
                            var name = v.body
                            var param = c.body
                            while let nm = name:
                                let q = param else break
                                if nm.text != "_":
                                    try self.line("")
                                    try self.put_type(try self.map(nm.type_id))
                                    try self.put(" ")
                                    try self.put_ident(nm.text)
                                    try self.put(" __attribute__((unused)) = ")
                                    try self.put_tmp("m", n)
                                    try self.put(".u.")
                                    try self.put(c.text)
                                    try self.put(".")
                                    try self.put(q.text)
                                    try self.put(";")
                                name = nm.next
                                param = q.next
                try self.arm_body(a, dest, n, false)
                if a.right == none:
                    try self.line("break;")
                self.indent -= 1
                try self.line("}")
                arm = a.next
            self.indent -= 1
            try self.line("}")
            return
        # text, pointers, and everything else: a chain of tests
        var first = true
        var arm = m.body
        while let a = arm:
            try self.line("")
            if not first:
                try self.put("else ")
            first = false
            try self.put("if (")
            var any = false
            var pattern = a.left
            while let p = pattern:
                if any:
                    try self.put(" || ")
                any = true
                if p.has(ast.flag_wildcard):
                    try self.put("1")
                elif let v = p.left:
                    try self.put("(")
                    if st == types.str_id:
                        let k = self.tmp()
                        try self.put("({ lb_str ")
                        try self.put_tmp("sb", k)
                        try self.put(" = ")
                        try self.value(v, st)
                        try self.put("; ")
                        try self.put_tmp("m", n)
                        try self.put(".length == ")
                        try self.put_tmp("sb", k)
                        try self.put(".length && (")
                        try self.put_tmp("m", n)
                        try self.put(".length == 0 || memcmp(")
                        try self.put_tmp("m", n)
                        try self.put(".data, ")
                        try self.put_tmp("sb", k)
                        try self.put(".data, ")
                        try self.put_tmp("m", n)
                        try self.put(".length) == 0); })")
                    else:
                        try self.put_tmp("m", n)
                        try self.put(" == ")
                        try self.value(v, st)
                    try self.put(")")
                pattern = p.next
            if not any:
                try self.put("0")
            try self.put(") {")
            self.indent += 1
            try self.arm_body(a, dest, n, false)
            self.indent -= 1
            try self.line("}")
            arm = a.next

    ## The body of one arm, with its guard; `in_switch` adds the `break`.
    mutating func arm_body(a: ast.Node*, dest: u32, n: u32, in_switch: bool) -> !:
        if in_switch:
            try self.line("{")
            self.indent += 1
        if let guard = a.right:
            try self.line("if (!!(")
            try self.value(guard, types.bool_id)
            try self.put(")) {")
            self.indent += 1
        if dest != 0:
            let body = a.body else return
            try self.line("")
            try self.put_tmp("mr", dest)
            try self.put(" = ")
            try self.value(body, self.match_result)
            try self.put(";")
        elif let body = a.body:
            try self.block(body)
        if a.right != none:
            if in_switch:
                try self.line("break;")
            self.indent -= 1
            try self.line("}")
        elif in_switch:
            try self.line("break;")
        if in_switch:
            self.indent -= 1
            try self.line("}")
        discard(n)

    mutating func match_expr(m: ast.Node*) -> !:
        let t = try self.ty(m)
        let n = self.tmp()
        let saved = self.match_result
        self.match_result = t
        try self.put("({")
        self.indent += 1
        try self.line("")
        try self.put_type(t)
        try self.put(" ")
        try self.put_tmp("mr", n)
        try self.put(" = {0};")
        try self.match_stmt(m, n)
        try self.line("")
        try self.put_tmp("mr", n)
        try self.put(";")
        self.indent -= 1
        try self.line("})")
        self.match_result = saved

    # mark: Calls ==============================================================================

    mutating func call(e: ast.Node*) -> !:
        let callee = e.left else return
        # core functions
        if callee.kind == ast.Kind.name and callee.resolved == none and check.scalar_id(callee.text) == types.none_id:
            try self.intrinsic(e, callee.text)
            return
        # `T(x)` conversions and constructions
        if callee.has(ast.flag_type_ref):
            try self.construct_or_convert(e, callee)
            return
        if callee.kind == ast.Kind.member:
            try self.member_call(e, callee)
            return
        if let d = e.resolved:
            if d.kind == ast.Kind.func_ or d.kind == ast.Kind.extern_func:
                try self.direct_call(e, d, none, try types.no_args())
                return
        # a function value
        try self.put("(")
        try self.expr(callee)
        try self.put(")(")
        try self.arguments(e.body, try self.ty(callee), none, try types.no_args())
        try self.put(")")

    ## The arguments of a call, each converted to its parameter type.
    mutating func arguments(args: ast.Node*?, fn: u32, decl: ast.Node*?, decl_args: u32[]) -> !:
        let f = self.c.table.get(fn)
        var i: usize = 0
        var cursor = args
        var first = true
        # named arguments are matched to parameters by the declaration
        if let d = decl:
            var pi: usize = 0
            var param = d.right
            while let p = param:
                if not first:
                    try self.put(", ")
                first = false
                var given: ast.Node*? = none
                var position: usize = 0
                var a = args
                while let arg = a:
                    if arg.text.length > 0:
                        if arg.text == p.text:
                            given = arg
                    else:
                        if position == pi:
                            given = arg
                        position += 1
                    a = arg.next
                let want = f.args[pi] if pi < f.args.length else types.none_id
                if let g = given:
                    let v = g.left else return
                    try self.argument_value(v, want)
                elif let default = p.left:
                    try self.value(default, want)
                else:
                    try self.put("0")
                pi += 1
                param = p.next
            if f.variadic:
                # extra arguments after the declared ones
                var position: usize = 0
                var a = args
                while let arg = a:
                    if arg.text.length == 0:
                        if position >= pi:
                            try self.put(", ")
                            let v = arg.left else return
                            try self.variadic_value(v)
                        position += 1
                    a = arg.next
            discard(decl_args)
            return
        while let a = cursor:
            if not first:
                try self.put(", ")
            first = false
            let v = a.left else return
            try self.argument_value(v, f.args[i] if i < f.args.length else types.none_id)
            i += 1
            cursor = a.next

    ## An argument: its parameter's type, with text passed as bytes where wanted.
    mutating func argument_value(v: ast.Node*, want: u32) -> !:
        let have = try self.ty(v)
        if want != types.none_id and self.is_span(want) and self.elem(want) == types.u8_id and (have == types.str_id or have == types.fmt_id):
            if v.kind == ast.Kind.formatted:
                try self.formatted_bytes(v)
            else:
                try self.text_as_bytes(v)
            return
        if want == types.cstr_id and have == types.str_id:
            try self.value(v, want)
            return
        try self.value(v, want)

    ## A variadic C argument: text becomes a C string, integers promote as C does.
    mutating func variadic_value(v: ast.Node*) -> !:
        let have = try self.ty(v)
        if have == types.str_id and v.kind == ast.Kind.literal:
            try self.put_c_string(check.decode_text(v.text))
            return
        if have == types.str_id:
            try self.put("(")
            try self.expr(v)
            try self.put(".data)")
            return
        try self.expr(v)

    ## A call of a known function or method instance.
    mutating func direct_call(e: ast.Node*, d: ast.Node*, owner: ast.Node*?, owner_args: u32[]) -> !:
        var args = try types.no_args()
        if let t = e.ty:
            args = try self.type_args(t)
        var fn = try self.map(d.type_id)
        if let o = owner:
            fn = try self.c.substitute(fn, o, owner_args)
        if args.length > 0:
            fn = try self.c.substitute(fn, d, args)
        if d.kind == ast.Kind.func_:
            discard(try self.add_func(d, args, owner, owner_args))
        if d.kind == ast.Kind.extern_func and has_out_params(d):
            try self.extern_out_call(e, d, fn)
            return
        try self.put_func_name(d, args, owner, owner_args)
        try self.put("(")
        try self.arguments(e.body, fn, d, args)
        try self.put(")")
        if d.kind == ast.Kind.extern_func:
            # a bare pointer result must not be null (§17.1)
            let rt = self.c.table.get(fn).elem
            if self.is_ptr(rt):
                discard(rt)

    ## `({ int32_t o0; double r = frexp(x, &o0); (tuple){ r, o0 }; })`: an extern's `out`
    ## parameters are locals passed by address and answered after the declared result (§17.1).
    mutating func extern_out_call(e: ast.Node*, d: ast.Node*, fn: u32) -> !:
        let n = self.tmp()
        let declared = declared_result(d)
        try self.put("({ ")
        var outs: u32 = 0
        var param = d.right
        while let p = param:
            if p.has(ast.flag_out):
                try self.put_type(p.type_id)
                try self.put(" ")
                try self.put_out_local(n, outs)
                try self.put("; ")
                outs += 1
            param = p.next
        if declared != types.unit_id:
            try self.put_type(declared)
            try self.put(" ")
            try self.put_tmp("or", n)
            try self.put(" = ")
        try self.put(names.c_symbol(d))
        try self.put("(")
        try self.arguments_with_outs(e.body, fn, d, n)
        try self.put("); ")
        let answered = self.c.table.get(fn).elem
        if self.kind(answered) == types.Kind.tuple:
            try self.put("((")
            try self.put_type(answered)
            try self.put("){ ")
            var first = true
            if declared != types.unit_id:
                try self.put_tmp("or", n)
                first = false
            var k: u32 = 0
            while k < outs:
                if not first:
                    try self.put(", ")
                first = false
                try self.put_out_local(n, k)
                k += 1
            try self.put(" }); })")
        elif declared != types.unit_id:
            try self.put_tmp("or", n)
            try self.put("; })")
        else:
            try self.put_out_local(n, 0)
            try self.put("; })")

    ## `_lb_oN_k`: the local an `out` parameter is written through.
    mutating func put_out_local(n: u32, k: u32) -> !:
        try self.put_tmp("o", n)
        try self.put("_")
        try self.put_u64((u64)k)

    ## The arguments of an extern call whose `out` parameters take the address of a local.
    mutating func arguments_with_outs(args: ast.Node*?, fn: u32, d: ast.Node*, n: u32) -> !:
        let f = self.c.table.get(fn)
        var first = true
        var pi: usize = 0
        var outs: u32 = 0
        var cursor = args
        var param = d.right
        while let p = param:
            if not first:
                try self.put(", ")
            first = false
            if p.has(ast.flag_out):
                try self.put("&")
                try self.put_out_local(n, outs)
                outs += 1
            else:
                let a = cursor else return error(backend, "an extern call is short of arguments")
                let v = a.left else return
                try self.argument_value(v, f.args[pi] if pi < f.args.length else types.none_id)
                pi += 1
                cursor = a.next
            param = p.next

    ## `x.method(args)`, `Type.static(args)`, `module.func(args)`, and the builtin
    ## methods of the standard records.
    mutating func member_call(e: ast.Node*, callee: ast.Node*) -> !:
        let receiver = callee.left else return
        let rt_raw = try self.ty(receiver)
        # module functions and constructions
        if self.kind(rt_raw) == types.Kind.module:
            let m = self.decl_of(rt_raw) else return
            let d = e.resolved else return try self.put("0")
            if d.has(ast.flag_builtin) and (m.text == "atomic" or m.text == "c"):
                try self.std_call(e, m.text, callee.text, d)
                return
            try self.direct_call(e, d, none, try types.no_args())
            return
        # a static method or a payload case through the type
        if receiver.has(ast.flag_type_ref):
            if let c = callee.resolved:
                if c.kind == ast.Kind.enum_case:
                    try self.enum_value(e)
                    return
            if let d = callee.resolved:
                let t = self.c.table.get(rt_raw)
                try self.direct_call(e, d, t.decl, t.args)
                return
            if rt_raw == types.error_code_id:
                let first = e.body else return
                let v = first.left else return
                try self.put("((uint32_t)(")
                try self.expr(v)
                try self.put("))")
                return
            if self.is_float(rt_raw) and callee.text == "bits":
                # a bit cast, which is a constant expression when the bits are
                let first = e.body else return
                let v = first.left else return
                try self.put("__builtin_bit_cast(float, (uint32_t)(" if rt_raw == types.f32_id else "__builtin_bit_cast(double, (uint64_t)(")
                try self.expr(v)
                try self.put("))")
                return
            try self.put("0")
            return
        let rt = self.elem(rt_raw) if self.is_ptr(rt_raw) else rt_raw
        # atomics
        if self.is_atomic(rt):
            try self.atomic_call(e, callee, receiver, rt, self.is_ptr(rt_raw))
            return
        # builtin members of spans and floats
        if callee.has(ast.flag_static) and callee.resolved == none:
            try self.builtin_method(e, callee, receiver, rt)
            return
        let method = callee.resolved else return try self.put("0")
        if method.kind == ast.Kind.field:
            # `holder.callback(args)`: a field of function type, called through its value
            try self.put("(")
            try self.expr(callee)
            try self.put(")(")
            try self.arguments(e.body, try self.ty(callee), none, try types.no_args())
            try self.put(")")
            return
        # interface views dispatch through the table
        if self.is_iface(rt):
            let n = self.tmp()
            let fn = try self.map(method.type_id)
            let i = self.decl_of(rt) else return
            try self.put("({ lb_iface ")
            try self.put_tmp("if", n)
            try self.put(" = ")
            try self.expr(receiver)
            try self.put("; ((lb_vt_")
            try self.put(i.text)
            try self.put("*)")
            try self.put_tmp("if", n)
            try self.put(".vtable)->")
            try self.put(method.text)
            try self.put("(")
            try self.put_tmp("if", n)
            try self.put(".data")
            if e.body != none:
                try self.put(", ")
                try self.arguments(e.body, fn, method, try types.no_args())
            try self.put("); })")
            return
        # a method on a generic parameter's constraint resolves to the concrete type's method
        let t = self.c.table.get(rt)
        if t.decl == none and method.text == "compare":
            # `T: Comparable` at a number, `char`, or `str`: the builtin ordering (§14.4)
            try self.builtin_method(e, callee, receiver, rt)
            return
        var owner = t.decl
        var owner_args = t.args
        var impl = method
        if let od = owner:
            if let found = check.find_member(od, method.text, ast.Kind.func_):
                impl = found
        var fn = try self.map(impl.type_id)
        if let o = owner:
            fn = try self.c.substitute(fn, o, owner_args)
        var args = try types.no_args()
        if let ta = e.ty:
            args = try self.type_args(ta)
        if args.length > 0:
            fn = try self.c.substitute(fn, impl, args)
        discard(try self.add_func(impl, args, owner, owner_args))
        # a value receiver, `Flags.a.name()` or a call's result, is held in a temporary
        let by_value = not impl.has(ast.flag_static) and not self.is_ptr(rt_raw) and not ast.is_place_expression(receiver)
        if by_value:
            try self.put("({ ")
            try self.put_type(rt)
            try self.put(" _lb_rc = ")
            try self.value(receiver, rt)
            try self.put("; ")
        try self.put_func_name(impl, args, owner, owner_args)
        try self.put("(")
        if not impl.has(ast.flag_static):
            if self.is_ptr(rt_raw):
                try self.expr(receiver)
            elif by_value:
                try self.put("&_lb_rc")
            else:
                try self.address(receiver)
            if e.body != none or impl.right != none:
                try self.put(", ")
        try self.arguments(e.body, fn, impl, args)
        try self.put(")")
        if by_value:
            try self.put("; })")

    ## A method named without a call: a function value of the instance.
    mutating func method_value(e: ast.Node*, owner: ast.Node*, d: ast.Node*) -> !:
        let ot = try self.ty(owner)
        if self.kind(ot) == types.Kind.module or d.kind == ast.Kind.extern_func:
            try self.func_value(e, d)
            return
        let t = self.c.table.get(self.elem(ot) if self.is_ptr(ot) else ot)
        discard(try self.add_func(d, try types.no_args(), t.decl, t.args))
        try self.put_func_name(d, try types.no_args(), t.decl, t.args)

    ## `first()`, `last()`, `indexed()` on spans; `bits()` on floats.
    ## `a.compare(b)` on a number, `char`, or `str`: negative, zero, or positive (§14.4).
    mutating func compare_call(e: ast.Node*, receiver: ast.Node*, rt: u32) -> !:
        let first = e.body else return
        let other = first.left else return
        if rt == types.str_id:
            try self.put("((int64_t)lb_str_compare(")
            try self.value(receiver, rt)
            try self.put(", ")
            try self.value(other, rt)
            try self.put("))")
            return
        try self.put("({ ")
        try self.put_type(rt)
        try self.put(" _lb_ca = ")
        try self.value(receiver, rt)
        try self.put("; ")
        try self.put_type(rt)
        try self.put(" _lb_cb = ")
        try self.value(other, rt)
        try self.put("; (_lb_ca < _lb_cb) ? (int64_t)-1 : ((_lb_ca > _lb_cb) ? (int64_t)1 : (int64_t)0); })")

    ## The raw lines of an `asm` block as C string text; extended asm doubles `%`.
    mutating func asm_lines(lines: ast.Node*?, extended: bool) -> !:
        var cursor = lines
        while let l = cursor:
            var in_name = false
            for b in l.text.bytes:
                if b == '{' and extended:
                    # `{name}` is the named operand `%[name]`
                    try self.put("%[")
                    in_name = true
                elif b == '}' and in_name:
                    try self.put("]")
                    in_name = false
                elif b == '%' and extended:
                    try self.put("%%")
                elif b == '"':
                    try self.put("\\\"")
                elif b == '\\':
                    try self.put("\\\\")
                elif b == '\n':
                    try self.put("\\n")
                else:
                    try self.put_byte(b)
            try self.put("\\n")
            cursor = l.next

    ## A module-level `asm arm64:` block (§8.9): the lines verbatim at file scope.
    mutating func module_asm(d: ast.Node*) -> !:
        try self.line("#if defined(__aarch64__)")
        try self.line("__asm__(\"")
        try self.asm_lines(d.body, false)
        try self.put("\");")
        try self.line("#endif")

    ## A `naked func` body: its asm blocks and nothing else, since C admits no other
    ## statement in a naked function (§9.8).
    mutating func naked_body(f: ast.Node*) -> !:
        let body = f.body else return
        var cursor = body.body
        while let s = cursor:
            if s.kind == ast.Kind.asm_ and s.text == "arm64":
                try self.line("__asm__ volatile(\"")
                try self.asm_lines(s.body, false)
                try self.put("\");")
            cursor = s.next

    mutating func builtin_method(e: ast.Node*, callee: ast.Node*, receiver: ast.Node*, rt: u32) -> !:
        if callee.text == "compare":
            try self.compare_call(e, receiver, rt)
            return
        let n = self.tmp()
        if callee.text == "bits":
            try self.put("({ ")
            try self.put_type(rt)
            try self.put(" ")
            try self.put_tmp("fv", n)
            try self.put(" = ")
            try self.expr(receiver)
            try self.put("; ")
            try self.put("uint32_t " if rt == types.f32_id else "uint64_t ")
            try self.put_tmp("fb", n)
            try self.put("; memcpy(&")
            try self.put_tmp("fb", n)
            try self.put(", &")
            try self.put_tmp("fv", n)
            try self.put(", sizeof(")
            try self.put_tmp("fb", n)
            try self.put(")); ")
            try self.put_tmp("fb", n)
            try self.put("; })")
            return
        let result = try self.ty(e)
        try self.put("({ ")
        try self.put_type(rt)
        try self.put(" ")
        try self.put_tmp("sq", n)
        try self.put(" = ")
        try self.expr(receiver)
        try self.put("; ")
        let et = self.elem(rt)
        if callee.text == "indexed":
            # a span of (index, element) pairs built in the current allocator
            let pair = self.elem(result)
            try self.put_block_type()
            try self.put(" ")
            try self.put_tmp("ix", n)
            try self.put(" = lb_alloc_call(lb_memory_allocator, sizeof(")
            try self.put_type(pair)
            try self.put(") * ")
            try self.put_tmp("sq", n)
            try self.put(".length, _Alignof(")
            try self.put_type(pair)
            try self.put(")); if (")
            try self.put_tmp("sq", n)
            try self.put(".length != 0 && !")
            try self.put_tmp("ix", n)
            try self.put(".present) lb_trap(\"memory.exhausted\"); ")
            try self.put_type(pair)
            try self.put("* ")
            try self.put_tmp("ip", n)
            try self.put(" = (")
            try self.put_type(pair)
            try self.put("*)")
            try self.put_tmp("ix", n)
            try self.put(".value.data; for (size_t _i = 0; _i < ")
            try self.put_tmp("sq", n)
            try self.put(".length; _i++) { ")
            try self.put_tmp("ip", n)
            try self.put("[_i].a0 = _i; ")
            try self.put_tmp("ip", n)
            try self.put("[_i].a1 = ((")
            try self.put_type(et)
            try self.put("*)")
            try self.put_tmp("sq", n)
            try self.put(".data)[_i]; } (")
            try self.put_type(result)
            try self.put("){ (void*)")
            try self.put_tmp("ip", n)
            try self.put(", ")
            try self.put_tmp("sq", n)
            try self.put(".length }; })")
            return
        # first / last
        try self.put_type(result)
        try self.put(" ")
        try self.put_tmp("fo", n)
        try self.put("; if (")
        try self.put_tmp("sq", n)
        try self.put(".length == 0) { ")
        try self.put_tmp("fo", n)
        try self.put(" = ")
        try self.none_of(result)
        try self.put("; } else { ")
        if self.is_tagged_opt(result):
            try self.put_tmp("fo", n)
            try self.put(".present = true; ")
            try self.put_tmp("fo", n)
            try self.put(".value = ")
        else:
            try self.put_tmp("fo", n)
            try self.put(" = ")
        try self.put("((")
        try self.put_type(et)
        try self.put("*)")
        try self.put_tmp("sq", n)
        try self.put(".data)[")
        if callee.text == "last":
            try self.put_tmp("sq", n)
            try self.put(".length - 1")
        else:
            try self.put("0")
        try self.put("]; } ")
        try self.put_tmp("fo", n)
        try self.put("; })")

    # -- constructions and conversions ----------------------------------------------------

    ## `Name(...)`: a struct value, an `init` call, or a checked scalar conversion.
    mutating func construct_or_convert(e: ast.Node*, callee: ast.Node*) -> !:
        let target = try self.ty(e)
        let payload = self.elem(target) if self.is_fail(target) else target
        if let init = e.resolved:
            if init.kind == ast.Kind.func_ and init.text == "init":
                try self.init_call(e, init, payload)
                return
        if self.kind(payload) == types.Kind.struct_:
            try self.constructor(e, payload)
            return
        if target == types.str_id or (self.is_fail(target) and payload == types.str_id):
            let first = e.body else return
            let v = first.left else return
            try self.str_conversion(v, self.is_fail(target))
            return
        let first = e.body else return
        let v = first.left else return
        try self.conversion(v, target, true)
        discard(callee)

    ## `(lb_Name){ .field = value, ... }` with defaults for what was omitted.
    mutating func constructor(e: ast.Node*, id: u32) -> !:
        let d = self.decl_of(id) else return try self.put("{0}")
        let t = self.c.table.get(id)
        try self.put("((")
        try self.put_type(id)
        try self.put("){")
        var first = true
        var position: usize = 0
        var field = d.body
        while let f = field:
            if f.kind != ast.Kind.field:
                field = f.next
                continue
            var given: ast.Node*? = none
            var pos: usize = 0
            var a = e.body
            while let arg = a:
                if arg.text.length > 0:
                    if arg.text == f.text:
                        given = arg
                else:
                    if pos == position:
                        given = arg
                    pos += 1
                a = arg.next
            let want = try self.c.substitute(f.type_id, d, t.args)
            if let g = given:
                let v = g.left else return
                if not first:
                    try self.put(", ")
                first = false
                try self.put(".")
                try self.put(f.text)
                try self.put(" = ")
                try self.value(v, try self.map(want))
            elif let default = f.left:
                if not first:
                    try self.put(", ")
                first = false
                try self.put(".")
                try self.put(f.text)
                try self.put(" = ")
                try self.value(default, try self.map(want))
            position += 1
            field = f.next
        if first:
            try self.put("0")
        try self.put("})")

    ## A struct with its own `init`: zero the value, run `init`, yield the value or its failure.
    mutating func init_call(e: ast.Node*, init: ast.Node*, id: u32) -> !:
        let t = self.c.table.get(id)
        let n = self.tmp()
        var fn = try self.map(init.type_id)
        if let o = t.decl:
            fn = try self.c.substitute(fn, o, t.args)
        discard(try self.add_func(init, try types.no_args(), t.decl, t.args))
        try self.put("({ ")
        try self.put_type(id)
        try self.put(" ")
        try self.put_tmp("iv", n)
        try self.put(" = {0}; ")
        if init.has(ast.flag_fallible):
            try self.put("lb_r_unit ")
            try self.put_tmp("ir", n)
            try self.put(" = ")
        try self.put_func_name(init, try types.no_args(), t.decl, t.args)
        try self.put("(&")
        try self.put_tmp("iv", n)
        if e.body != none:
            try self.put(", ")
            try self.arguments(e.body, fn, init, try types.no_args())
        try self.put("); ")
        if init.has(ast.flag_fallible):
            let res = try self.c.table.fallible(id)
            try self.note(res)
            try self.put_type(res)
            try self.put(" ")
            try self.put_tmp("io", n)
            try self.put("; if (")
            try self.put_tmp("ir", n)
            try self.put(".failed) { ")
            try self.put_tmp("io", n)
            try self.put(".failed = true; ")
            try self.put_tmp("io", n)
            try self.put(".error = ")
            try self.put_tmp("ir", n)
            try self.put(".error; } else { ")
            try self.put_tmp("io", n)
            try self.put(".failed = false; ")
            try self.put_tmp("io", n)
            try self.put(".value = ")
            try self.put_tmp("iv", n)
            try self.put("; } ")
            try self.put_tmp("io", n)
            try self.put("; })")
            return
        try self.put_tmp("iv", n)
        try self.put("; })")

    # -- core functions -------------------------------------------------------------------

    mutating func intrinsic(e: ast.Node*, name: str) -> !:
        let first = e.body
        var arg: ast.Node*? = none
        var second: ast.Node*? = none
        if let f = first:
            arg = f.left
            if let s = f.next:
                second = s.left
        if name == "print":
            let v = arg else return
            if v.kind == ast.Kind.formatted and not displays_a_field(v):
                try self.print_formatted(v)
                return
            try self.put("lb_print_str(")
            try self.expr(v)
            try self.put(")")
            return
        if name == "format":
            let buf = arg else return
            let msg = second else return
            try self.format_call(buf, msg)
            return
        if name == "assert":
            let cond = arg else return
            try self.put("((void)((")
            try self.value(cond, types.bool_id)
            try self.put(") ? 0 : (lb_trap(")
            if let msg = second:
                try self.put("(")
                try self.expr(msg)
                try self.put(").data")
            else:
                try self.put("\"assert failed\"")
            try self.put("), 0)))")
            return
        if name == "trap":
            try self.put("lb_trap(")
            if let msg = arg:
                if (try self.ty(msg)) == types.fmt_id:
                    try self.put("(")
                    try self.expr(msg)
                    try self.put(").data")
                else:
                    try self.put("(")
                    try self.expr(msg)
                    try self.put(").data")
            else:
                try self.put("\"trap\"")
            try self.put(")")
            return
        if name == "error":
            # as an expression (in `else error(...)`): the function leaves
            try self.put("{")
            self.indent += 1
            try self.error_return(e)
            self.indent -= 1
            try self.line("}")
            return
        if name == "discard":
            let v = arg else return
            try self.put("((void)(")
            try self.expr(v)
            try self.put("))")
            return
        if name == "hash":
            let v = arg else return
            try self.hash_of(try self.ty(v), v)
            return
        if name == "hex" or name == "bin":
            let v = arg else return
            try self.put("lb_show_hex(" if name == "hex" else "lb_show_bin(")
            try self.put("(uint64_t)(")
            try self.expr(v)
            try self.put("))")
            return
        if name == "pad":
            let v = arg else return
            let w = second else return
            let n = self.tmp()
            try self.put("({ char ")
            try self.put_tmp("pbuf", n)
            try self.put("[256]; lb_fmtbuf ")
            try self.put_tmp("pb", n)
            try self.put(" = { ")
            try self.put_tmp("pbuf", n)
            try self.put(", 256, 0 }; (void)")
            try self.display(n, "pb", v)
            try self.put("; lb_show_pad(lb_fmtbuf_finish(&")
            try self.put_tmp("pb", n)
            try self.put("), (size_t)(")
            try self.value(w, types.usize_id)
            try self.put(")); })")
            return
        if name == "sizeof" or name == "alignof":
            let v = arg else return
            let t = try self.map(v.type_id)
            try self.put("((size_t)sizeof(" if name == "sizeof" else "((size_t)_Alignof(")
            try self.put_type(t)
            try self.put("))")
            return
        if name == "offsetof":
            let tv = arg else return
            let fv = second else return
            try self.put("((size_t)offsetof(")
            try self.put_type(try self.map(tv.type_id))
            try self.put(", ")
            try self.put(fv.text)
            try self.put("))")
            return
        try self.put("0")

    # mark: Standard modules ===================================================================

    ## The standard calls no Base body can express: `atomic.fence` and the C streams.
    mutating func std_call(e: ast.Node*, module: str, name: str, d: ast.Node*) -> !:
        if module == "atomic" and name == "fence":
            let first = e.body else return try self.put("((void)0)")
            let order = first.left else return try self.put("((void)0)")
            if order.text == "signal":
                try self.put("({ __asm__ volatile(\"\" ::: \"memory\"); (void)0; })")
                return
            try self.put("(atomic_thread_fence(")
            try self.memory_order(order)
            try self.put("))")
            return
        if module == "c" and (name == "stdin" or name == "stdout" or name == "stderr"):
            try self.put("((void*)")
            try self.put(name)
            try self.put(")")
            return
        try self.direct_call(e, d, none, try types.no_args())

    mutating func receiver_address(receiver: ast.Node*, through_ptr: bool) -> !:
        if through_ptr:
            try self.expr(receiver)
        else:
            try self.address(receiver)

    ## `atomic.Ordering` case to a C memory order.
    mutating func memory_order(e: ast.Node*) -> !:
        var name = e.text
        if e.kind == ast.Kind.member:
            name = e.text
        if name == "relaxed":
            try self.put("memory_order_relaxed")
        elif name == "acquire":
            try self.put("memory_order_acquire")
        elif name == "release":
            try self.put("memory_order_release")
        elif name == "acq_rel":
            try self.put("memory_order_acq_rel")
        else:
            try self.put("memory_order_seq_cst")

    ## The operations of `@T` (§15.1).
    mutating func atomic_call(e: ast.Node*, callee: ast.Node*, receiver: ast.Node*, rt: u32, through_ptr: bool) -> !:
        let name = callee.text
        let et = self.elem(rt)
        var args: MaybeNode[5]
        var count: usize = 0
        var cursor = e.body
        while let a = cursor:
            if count < 5:
                args[count] = a.left
            count += 1
            cursor = a.next
        let n = self.tmp()
        if name == "load":
            try self.put("((")
            try self.put_type(et)
            try self.put(")atomic_load_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", ")
            if let o = args[0]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put("))")
            return
        if name == "store":
            let v = args[0] else return
            try self.put("(atomic_store_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(v, et)
            try self.put("), ")
            if let o = args[1]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put("), (void)0)")
            return
        if name == "wait":
            let v = args[0] else return
            try self.put("({ while (atomic_load_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", memory_order_seq_cst) == (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(v, et)
            try self.put(")) { lb_pause(); } (void)0; })")
            return
        if name == "wake":
            let v = args[0] else return
            try self.put("((void)(")
            try self.expr(v)
            try self.put("))")
            return
        if name == "cas":
            let expected = args[0] else return
            let desired = args[1] else return
            let result = try self.ty(e)
            try self.put("({ ")
            try self.put_type(et)
            try self.put(" ")
            try self.put_tmp("ce", n)
            try self.put(" = (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(expected, et)
            try self.put("); bool ")
            try self.put_tmp("co", n)
            try self.put("; if (")
            if let weak_flag = args[4]:
                try self.value(weak_flag, types.bool_id)
            else:
                try self.put("0")
            try self.put(") { ")
            try self.put_tmp("co", n)
            try self.put(" = atomic_compare_exchange_weak_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", &")
            try self.put_tmp("ce", n)
            try self.put(", (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(desired, et)
            try self.put("), ")
            if let o = args[2]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put(", ")
            if let o = args[3]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put("); } else { ")
            try self.put_tmp("co", n)
            try self.put(" = atomic_compare_exchange_strong_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", &")
            try self.put_tmp("ce", n)
            try self.put(", (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(desired, et)
            try self.put("), ")
            if let o = args[2]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put(", ")
            if let o = args[3]:
                try self.memory_order(o)
            else:
                try self.put("memory_order_seq_cst")
            try self.put("); } (")
            try self.put_type(result)
            try self.put("){ ")
            try self.put_tmp("co", n)
            try self.put(", ")
            try self.put_tmp("ce", n)
            try self.put(" }; })")
            return
        let v = args[0] else return
        if name == "max" or name == "min":
            try self.put("({ ")
            try self.put_type(et)
            try self.put(" ")
            try self.put_tmp("mo", n)
            try self.put(" = atomic_load_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", memory_order_seq_cst); ")
            try self.put_type(et)
            try self.put(" ")
            try self.put_tmp("mn", n)
            try self.put(" = (")
            try self.put_type(et)
            try self.put(")(")
            try self.value(v, et)
            try self.put("); for (;;) { ")
            try self.put_type(et)
            try self.put(" _w = (")
            try self.put_tmp("mo", n)
            try self.put(" >= " if name == "max" else " <= ")
            try self.put_tmp("mn", n)
            try self.put(") ? ")
            try self.put_tmp("mo", n)
            try self.put(" : ")
            try self.put_tmp("mn", n)
            try self.put("; if (atomic_compare_exchange_weak_explicit(")
            try self.receiver_address(receiver, through_ptr)
            try self.put(", &")
            try self.put_tmp("mo", n)
            try self.put(", _w, memory_order_seq_cst, memory_order_seq_cst)) break; } ")
            try self.put_tmp("mo", n)
            try self.put("; })")
            return
        try self.put("((")
        try self.put_type(et)
        try self.put(")")
        if name == "sub":
            try self.put("atomic_fetch_sub_explicit(")
        elif name == "set":
            try self.put("atomic_fetch_or_explicit(")
        elif name == "clear":
            try self.put("atomic_fetch_and_explicit(")
        elif name == "flip":
            try self.put("atomic_fetch_xor_explicit(")
        elif name == "swap":
            try self.put("atomic_exchange_explicit(")
        else:
            try self.put("atomic_fetch_add_explicit(")
        try self.receiver_address(receiver, through_ptr)
        try self.put(", (")
        try self.put_type(et)
        try self.put(")(")
        if name == "clear":
            try self.put("~(")
            try self.value(v, et)
            try self.put(")")
        else:
            try self.value(v, et)
        try self.put("), ")
        if let o = args[1]:
            try self.memory_order(o)
        else:
            try self.put("memory_order_seq_cst")
        try self.put("))")

    # mark: Memory =============================================================================

    ## The allocator view for `in x` and `with x`, or the current allocator.
    mutating func allocator_of(e: ast.Node*?) -> !:
        let a = e else return try self.put("lb_memory_allocator")
        try self.allocator_view(a)

    mutating func allocator_view(e: ast.Node*) -> !:
        let t = try self.ty(e)
        if self.is_iface(t):
            try self.expr(e)
            return
        let target = self.elem(t) if self.is_ptr(t) else t
        if self.is_ptr(t):
            try self.iface_view(e, target, try self.allocator_iface())
            return
        # a `var` record: take its address
        let i = self.decl_of(try self.allocator_iface()) else return try self.expr(e)
        try self.put("((lb_iface){ (void*)(&(")
        try self.place(e)
        try self.put(")), &lb_vt_")
        try self.put_mangled(target)
        try self.put("_")
        try self.put(i.text)
        try self.put(" })")
        try self.note_vtable(target, try self.allocator_iface())

    ## The `Allocator` interface type from the prelude.
    mutating func allocator_iface() -> u32!:
        let mi = self.c.find_module("memory") else return types.none_id
        let m = self.c.modules.get(mi).tree
        let d = check.find_decl(m, "Allocator") else return types.none_id
        return d.type_id

    ## The failing result for exhaustion.
    mutating func exhausted(result: u32) -> !:
        try self.put("((")
        try self.put_type(result)
        try self.put("){ .error = { .code = LB_MEMORY_EXHAUSTED, .message = (lb_str){\"memory.exhausted\", 16} }, .failed = true })")

    mutating func new_expr(e: ast.Node*) -> !:
        let t = e.ty else return
        let result = try self.ty(e)
        let payload = self.elem(result)
        try self.note(result)
        let n = self.tmp()
        try self.put("({ lb_iface ")
        try self.put_tmp("a", n)
        try self.put(" = ")
        try self.allocator_of(e.right)
        try self.put("; ")
        if self.is_span(payload):
            let count = t.right else return
            try self.counted_allocation(n, payload, count, result, true)
            return
        let et = self.elem(payload)
        try self.put_block_type()
        try self.put(" ")
        try self.put_tmp("ao", n)
        try self.put(" = lb_alloc_call(")
        try self.put_tmp("a", n)
        try self.put(", sizeof(")
        try self.put_type(et)
        try self.put("), _Alignof(")
        try self.put_type(et)
        try self.put(")); ")
        try self.put_type(result)
        try self.put(" ")
        try self.put_tmp("r", n)
        try self.put("; if (!")
        try self.put_tmp("ao", n)
        try self.put(".present) { ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.exhausted(result)
        try self.put("; } else { ")
        try self.put_type(et)
        try self.put("* ")
        try self.put_tmp("p", n)
        try self.put(" = (")
        try self.put_type(et)
        try self.put("*)")
        try self.put_tmp("ao", n)
        try self.put(".value.data; ")
        if let body = e.body:
            if body.kind == ast.Kind.case_value:
                try self.put("*")
                try self.put_tmp("p", n)
                try self.put(" = ")
                try self.enum_value(body)
                try self.put("; ")
            elif let init = e.resolved:
                if init.kind == ast.Kind.func_ and init.text == "init":
                    try self.put("*")
                    try self.put_tmp("p", n)
                    try self.put(" = ")
                    try self.init_call(e, init, et)
                    try self.put("; ")
                else:
                    try self.put("*")
                    try self.put_tmp("p", n)
                    try self.put(" = ")
                    try self.constructor(e, et)
                    try self.put("; ")
            else:
                try self.put("*")
                try self.put_tmp("p", n)
                try self.put(" = ")
                try self.constructor(e, et)
                try self.put("; ")
        else:
            try self.put("memset(")
            try self.put_tmp("p", n)
            try self.put(", 0, sizeof(")
            try self.put_type(et)
            try self.put(")); ")
        try self.put_tmp("r", n)
        try self.put(".value = ")
        try self.put_tmp("p", n)
        try self.put("; ")
        try self.put_tmp("r", n)
        try self.put(".failed = false; } ")
        try self.put_tmp("r", n)
        try self.put("; })")

    ## `count` elements of a span payload, zeroed when `zero`; closes the statement expression.
    mutating func counted_allocation(n: u32, payload: u32, count: ast.Node*, result: u32, zero: bool) -> !:
        let et = self.elem(payload)
        try self.put("size_t ")
        try self.put_tmp("n", n)
        try self.put(" = (size_t)(")
        try self.value(count, types.usize_id)
        try self.put("); ")
        try self.put_type(result)
        try self.put(" ")
        try self.put_tmp("r", n)
        try self.put("; if (")
        try self.put_tmp("n", n)
        try self.put(" != 0 && sizeof(")
        try self.put_type(et)
        try self.put(") > ((size_t)-1) / ")
        try self.put_tmp("n", n)
        try self.put(") { ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.exhausted(result)
        try self.put("; } else { size_t ")
        try self.put_tmp("bytes", n)
        try self.put(" = sizeof(")
        try self.put_type(et)
        try self.put(") * ")
        try self.put_tmp("n", n)
        try self.put("; ")
        try self.put_block_type()
        try self.put(" ")
        try self.put_tmp("ao", n)
        try self.put(" = lb_alloc_call(")
        try self.put_tmp("a", n)
        try self.put(", ")
        try self.put_tmp("bytes", n)
        try self.put(", _Alignof(")
        try self.put_type(et)
        try self.put(")); if (")
        try self.put_tmp("bytes", n)
        try self.put(" != 0 && !")
        try self.put_tmp("ao", n)
        try self.put(".present) { ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.exhausted(result)
        try self.put("; } else { ")
        if zero:
            try self.put("if (")
            try self.put_tmp("ao", n)
            try self.put(".value.data != NULL) memset(")
            try self.put_tmp("ao", n)
            try self.put(".value.data, 0, ")
            try self.put_tmp("bytes", n)
            try self.put("); ")
        try self.put_tmp("r", n)
        try self.put(".value.data = ")
        try self.put_tmp("ao", n)
        try self.put(".value.data; ")
        try self.put_tmp("r", n)
        try self.put(".value.length = ")
        try self.put_tmp("n", n)
        try self.put("; ")
        try self.put_tmp("r", n)
        try self.put(".failed = false; } } ")
        try self.put_tmp("r", n)
        try self.put("; })")

    mutating func alloc_expr(e: ast.Node*) -> !:
        let result = try self.ty(e)
        let payload = self.elem(result)
        try self.note(result)
        let n = self.tmp()
        try self.put("({ lb_iface ")
        try self.put_tmp("a", n)
        try self.put(" = ")
        try self.allocator_of(e.right)
        try self.put("; ")
        if let t = e.ty:
            let count = t.right else return
            try self.counted_allocation(n, payload, count, result, false)
            return
        let first = e.body else return
        let size = first.left else return
        let second = first.next else return
        let align = second.left else return
        try self.put("size_t ")
        try self.put_tmp("sz", n)
        try self.put(" = (size_t)(")
        try self.value(size, types.usize_id)
        try self.put("); size_t ")
        try self.put_tmp("al", n)
        try self.put(" = (size_t)(")
        try self.value(align, types.usize_id)
        try self.put("); ")
        try self.put_block_type()
        try self.put(" ")
        try self.put_tmp("ao", n)
        try self.put(" = lb_alloc_call(")
        try self.put_tmp("a", n)
        try self.put(", ")
        try self.put_tmp("sz", n)
        try self.put(", ")
        try self.put_tmp("al", n)
        try self.put("); ")
        try self.put_type(result)
        try self.put(" ")
        try self.put_tmp("r", n)
        try self.put("; if (")
        try self.put_tmp("sz", n)
        try self.put(" != 0 && !")
        try self.put_tmp("ao", n)
        try self.put(".present) { ")
        try self.put_tmp("r", n)
        try self.put(" = ")
        try self.exhausted(result)
        try self.put("; } else { ")
        try self.put_tmp("r", n)
        try self.put(".value = ")
        try self.put_tmp("ao", n)
        try self.put(".value; ")
        try self.put_tmp("r", n)
        try self.put(".failed = false; } ")
        try self.put_tmp("r", n)
        try self.put("; })")

    # mark: Text ===============================================================================

    ## Append one value to the format buffer temporary `prefix n`.
    mutating func display(n: u32, prefix: str, v: ast.Node*) -> !:
        if v.has(ast.flag_format_sink):
            # `value.display(__sink)`: the sink is this buffer
            let saved_prefix = self.sink_prefix
            let saved_index = self.sink_index
            self.sink_prefix = prefix
            self.sink_index = n
            try self.expr(v)
            self.sink_prefix = saved_prefix
            self.sink_index = saved_index
            return
        let t = try self.ty(v)
        if t == types.bool_id:
            try self.put("lb_fmtbuf_bool(&")
            try self.put_tmp(prefix, n)
            try self.put(", ")
            try self.expr(v)
            try self.put(")")
            return
        if t == types.str_id or t == types.fmt_id:
            let k = self.tmp()
            try self.put("({ lb_str ")
            try self.put_tmp("ds", k)
            try self.put(" = ")
            try self.expr(v)
            try self.put("; lb_fmtbuf_put(&")
            try self.put_tmp(prefix, n)
            try self.put(", ")
            try self.put_tmp("ds", k)
            try self.put(".data, ")
            try self.put_tmp("ds", k)
            try self.put(".length); })")
            return
        if self.is_float(t) or t == types.untyped_float_id:
            try self.put("lb_fmtbuf_f64(&")
            try self.put_tmp(prefix, n)
            try self.put(", (double)(")
            try self.expr(v)
            try self.put("))")
            return
        if self.is_ptr(t):
            try self.put("lb_fmtbuf_u64(&")
            try self.put_tmp(prefix, n)
            try self.put(", (uint64_t)(uintptr_t)(")
            try self.expr(v)
            try self.put("))")
            return
        if (self.is_int(t) and not self.is_signed(t)) or t == types.char_id or (self.is_int_enum(t) and not self.signed_of(t)) or t == types.error_code_id:
            try self.put("lb_fmtbuf_u64(&")
            try self.put_tmp(prefix, n)
            try self.put(", (uint64_t)(")
            try self.expr(v)
            try self.put("))")
            return
        try self.put("lb_fmtbuf_i64(&")
        try self.put_tmp(prefix, n)
        try self.put(", (int64_t)(")
        try self.expr(v)
        try self.put("))")

    ## The pieces of a formatted string appended to buffer `prefix n`.
    mutating func pieces(n: u32, prefix: str, f: ast.Node*) -> !:
        var part = f.body
        while let p = part:
            if p.kind == ast.Kind.format_text:
                let text = unescape_braces(check.decode_text(p.text))
                try self.put("(void)lb_fmtbuf_put(&")
                try self.put_tmp(prefix, n)
                try self.put(", ")
                try self.put_c_string(text)
                try self.put(", ")
                try self.put_u64((u64)text.length)
                try self.put("); ")
            elif p.kind == ast.Kind.format_field:
                let v = p.left else return
                try self.put("(void)")
                try self.display(n, prefix, v)
                try self.put("; ")
            part = p.next

    ## A formatted string as an `lb_str` in a stack buffer.
    mutating func formatted_value(f: ast.Node*) -> !:
        let n = self.tmp()
        try self.put("({ char ")
        try self.put_tmp("fb", n)
        try self.put("[1024]; lb_fmtbuf ")
        try self.put_tmp("ff", n)
        try self.put(" = { ")
        try self.put_tmp("fb", n)
        try self.put(", 1024, 0 }; ")
        try self.pieces(n, "ff", f)
        try self.put("lb_fmtbuf_finish(&")
        try self.put_tmp("ff", n)
        try self.put("); })")

    ## A formatted string as `lb_cspan` for a `Writer`.
    mutating func formatted_bytes(f: ast.Node*) -> !:
        let n = self.tmp()
        try self.put("({ char ")
        try self.put_tmp("wb", n)
        try self.put("[1024]; lb_fmtbuf ")
        try self.put_tmp("wf", n)
        try self.put(" = { ")
        try self.put_tmp("wb", n)
        try self.put(", 1024, 0 }; ")
        try self.pieces(n, "wf", f)
        try self.put("(lb_cspan){ (void*)(")
        try self.put_tmp("wf", n)
        try self.put(".data), ")
        try self.put_tmp("wf", n)
        try self.put(".used }; })")

    ## `print(f"...")` straight to standard output.
    mutating func print_formatted(f: ast.Node*) -> !:
        try self.put("({ ")
        var part = f.body
        while let p = part:
            if p.kind == ast.Kind.format_text:
                let text = unescape_braces(check.decode_text(p.text))
                try self.put("fwrite(")
                try self.put_c_string(text)
                try self.put(", 1, ")
                try self.put_u64((u64)text.length)
                try self.put(", stdout); ")
            elif p.kind == ast.Kind.format_field:
                let v = p.left else return
                let t = try self.ty(v)
                if t == types.bool_id:
                    try self.put("fputs((")
                    try self.expr(v)
                    try self.put(") ? \"true\" : \"false\", stdout); ")
                elif t == types.str_id or t == types.fmt_id:
                    let k = self.tmp()
                    try self.put("{ lb_str ")
                    try self.put_tmp("ps", k)
                    try self.put(" = ")
                    try self.expr(v)
                    try self.put("; fwrite(")
                    try self.put_tmp("ps", k)
                    try self.put(".data, 1, ")
                    try self.put_tmp("ps", k)
                    try self.put(".length, stdout); } ")
                elif self.is_float(t) or t == types.untyped_float_id:
                    try self.put("fprintf(stdout, \"%g\", (double)(")
                    try self.expr(v)
                    try self.put(")); ")
                elif (self.is_int(t) and not self.is_signed(t)) or t == types.char_id or self.is_ptr(t) or t == types.error_code_id:
                    try self.put("fprintf(stdout, \"%llu\", (unsigned long long)(")
                    try self.expr(v)
                    try self.put(")); ")
                else:
                    try self.put("fprintf(stdout, \"%lld\", (long long)(")
                    try self.expr(v)
                    try self.put(")); ")
            part = p.next
        try self.put("fputc('\\n', stdout); (void)0; })")

    ## `format(buffer, text)` into the caller's bytes, yielding `str!`.
    mutating func format_call(buf: ast.Node*, msg: ast.Node*) -> !:
        let n = self.tmp()
        let res = try self.c.table.fallible(types.str_id)
        try self.note(res)
        try self.put("({ lb_span ")
        try self.put_tmp("ds", n)
        try self.put(" = ")
        try self.value(buf, try self.c.table.span(types.u8_id, false))
        try self.put("; lb_fmtbuf ")
        try self.put_tmp("fb", n)
        try self.put(" = { (char*)")
        try self.put_tmp("ds", n)
        try self.put(".data, ")
        try self.put_tmp("ds", n)
        try self.put(".length, 0 }; ")
        if msg.kind == ast.Kind.formatted:
            try self.pieces(n, "fb", msg)
        else:
            try self.put("(void)")
            try self.display(n, "fb", msg)
            try self.put("; ")
        try self.put("lb_r_str ")
        try self.put_tmp("out", n)
        try self.put("; if (")
        try self.put_tmp("fb", n)
        try self.put(".used > ")
        try self.put_tmp("fb", n)
        try self.put(".cap) { ")
        try self.put_tmp("out", n)
        try self.put(" = ((lb_r_str){ .error = { .code = LB_MEMORY_EXHAUSTED, .message = (lb_str){\"memory.exhausted\", 16} }, .failed = true }); } else { ")
        try self.put_tmp("out", n)
        try self.put(" = ((lb_r_str){ .value = lb_fmtbuf_finish(&")
        try self.put_tmp("fb", n)
        try self.put("), .failed = false }); } ")
        try self.put_tmp("out", n)
        try self.put("; })")

    ## `hash(value)` (§7.4) over the runtime's mixer.
    mutating func hash_of(t: u32, v: ast.Node*) -> !:
        if t == types.str_id:
            let n = self.tmp()
            try self.put("({ lb_str ")
            try self.put_tmp("hs", n)
            try self.put(" = ")
            try self.expr(v)
            try self.put("; lb_hash_bytes(lb_hash_seed(), ")
            try self.put_tmp("hs", n)
            try self.put(".data, ")
            try self.put_tmp("hs", n)
            try self.put(".length); })")
            return
        if t == types.bool_id:
            try self.put("lb_hash_mix(lb_hash_seed(), (uint64_t)((")
            try self.expr(v)
            try self.put(") ? 1 : 0))")
            return
        if self.is_float(t):
            let n = self.tmp()
            try self.put("({ ")
            try self.put_type(t)
            try self.put(" ")
            try self.put_tmp("hf", n)
            try self.put(" = ")
            try self.expr(v)
            try self.put("; uint64_t ")
            try self.put_tmp("hb", n)
            try self.put(" = 0; memcpy(&")
            try self.put_tmp("hb", n)
            try self.put(", &")
            try self.put_tmp("hf", n)
            try self.put(", sizeof(")
            try self.put_tmp("hf", n)
            try self.put(")); lb_hash_mix(lb_hash_seed(), ")
            try self.put_tmp("hb", n)
            try self.put("); })")
            return
        if self.is_ptr(t) or t == types.cstr_id:
            try self.put("lb_hash_mix(lb_hash_seed(), (uint64_t)(uintptr_t)(")
            try self.expr(v)
            try self.put("))")
            return
        if self.is_record(t) or self.is_tuple(t) or self.is_array(t) or self.is_opt(t):
            let n = self.tmp()
            try self.put("({ ")
            try self.put_type(t)
            try self.put(" ")
            try self.put_tmp("hv", n)
            try self.put(" = ")
            try self.expr(v)
            try self.put("; lb_hash_bytes(lb_hash_seed(), &")
            try self.put_tmp("hv", n)
            try self.put(", sizeof(")
            try self.put_tmp("hv", n)
            try self.put(")); })")
            return
        try self.put("lb_hash_mix(lb_hash_seed(), (uint64_t)(")
        try self.expr(v)
        try self.put("))")

    # mark: Interfaces =========================================================================

    ## Remember that a witness table for `record` as `iface` is needed.
    mutating func note_vtable(record: u32, iface: u32) -> !:
        var i: usize = 0
        while i < self.vtables.count:
            let v = self.vtables.get(i)
            if v.record == record and v.iface == iface:
                return
            i += 1
        try self.vtables.push(Witness(record = record, iface = iface))
        try self.note(record)
        # the methods the table points at must be emitted
        let d = self.decl_of(record) else return
        let t = self.c.table.get(record)
        let i_decl = self.decl_of(iface) else return
        var req = i_decl.body
        while let r = req:
            if let m = check.find_member(d, r.text, ast.Kind.func_):
                discard(try self.add_func(m, try types.no_args(), d, t.args))
            req = r.next

    ## `typedef struct lb_vt_Name { ... } lb_vt_Name;` for a user interface.
    mutating func interface_typedef(d: ast.Node*) -> !:
        try self.line("typedef struct lb_vt_")
        try self.put(d.text)
        try self.put(" {")
        self.indent += 1
        var m = d.body
        while let f = m:
            if f.kind == ast.Kind.func_:
                try self.line("")
                try self.put_result_type(f)
                try self.put(" (*")
                try self.put(f.text)
                try self.put(")(void* self")
                var p = f.right
                while let q = p:
                    try self.put(", ")
                    try self.put_type(try self.map(q.type_id))
                    p = q.next
                try self.put(");")
            m = f.next
        self.indent -= 1
        try self.line("} lb_vt_")
        try self.put(d.text)
        try self.put(";")

    ## The witness table of one record for one interface.
    mutating func vtable(w: Witness) -> !:
        let d = self.decl_of(w.record) else return
        let i = self.decl_of(w.iface) else return
        let t = self.c.table.get(w.record)
        try self.line("static const lb_vt_")
        try self.put(i.text)
        try self.put(" lb_vt_")
        try self.put_mangled(w.record)
        try self.put("_")
        try self.put(i.text)
        try self.put(" __attribute__((unused)) = {")
        self.indent += 1
        var req = i.body
        while let r = req:
            if r.kind == ast.Kind.func_:
                try self.line(".")
                try self.put(r.text)
                try self.put(" = (")
                try self.put_result_type(r)
                try self.put(" (*)(void*")
                var p = r.right
                while let q = p:
                    try self.put(", ")
                    try self.put_type(try self.map(q.type_id))
                    p = q.next
                try self.put("))")
                if let m = check.find_member(d, r.text, ast.Kind.func_):
                    try self.put_func_name(m, try types.no_args(), d, t.args)
                else:
                    try self.put("NULL")
                try self.put(",")
            req = r.next
        self.indent -= 1
        try self.line("};")

    ## The type an allocator answers: `u8[]?`.
    mutating func put_block_type() -> !:
        let block = try self.c.table.optional(try self.c.table.span(types.u8_id, false))
        try self.put_type(block)

    ## The calls `new`, `alloc`, `free`, and `grow` make on an allocator view.
    mutating func allocator_glue() -> !:
        let block = try self.c.table.optional(try self.c.table.span(types.u8_id, false))
        try self.line("static inline __attribute__((unused)) ")
        try self.put_type(block)
        try self.put(" lb_alloc_call(lb_iface a, size_t size, size_t alignment) { if (a.vtable == NULL) lb_trap(\"memory.unset\"); return ((const lb_vt_Allocator*)a.vtable)->allocate(a.data, size, alignment); }")
        try self.line("static inline bool __attribute__((unused)) lb_resize_call(lb_iface a, lb_span block, size_t size) { if (a.vtable == NULL) lb_trap(\"memory.unset\"); return ((const lb_vt_Allocator*)a.vtable)->resize(a.data, block, size); }")
        try self.line("static inline void __attribute__((unused)) lb_release_call(lb_iface a, lb_span block) { if (a.vtable == NULL) return; ((const lb_vt_Allocator*)a.vtable)->release(a.data, block); }")

    # mark: Program ============================================================================

    ## Emit the whole program: every non-generic function of every program module,
    ## then the instances they needed, then the header those bodies need.
    ## `mode` is 0 for a program, 1 for the test runner, 2 for an `answer()` program.
    pub mutating func program(mode: u32) -> !:
        # every module, the standard ones included: their bodies are Base too
        var i: usize = 0
        while i < self.c.modules.count:
            try self.modules.push(self.c.modules.get(i).tree)
            i += 1
        # globals first, into their own buffer
        self.target = to_globals
        i = 0
        while i < self.modules.count:
            var cursor = self.modules.get(i).body
            while let d = cursor:
                if d.kind == ast.Kind.global or d.kind == ast.Kind.constant:
                    try self.global(d)
                elif d.kind == ast.Kind.asm_ and d.text == "arm64":
                    try self.module_asm(d)
                cursor = d.next
            i += 1
        self.target = to_body
        i = 0
        while i < self.modules.count:
            var cursor = self.modules.get(i).body
            while let d = cursor:
                if d.kind == ast.Kind.func_ and check.generic_params_of(d) == none:
                    discard(try self.add_func(d, try types.no_args(), none, try types.no_args()))
                elif (d.kind == ast.Kind.struct_ or d.kind == ast.Kind.enum_ or d.kind == ast.Kind.union_) and check.generic_params_of(d) == none:
                    var member = d.body
                    while let m = member:
                        if m.kind == ast.Kind.func_ and check.generic_params_of(m) == none:
                            discard(try self.add_func(m, try types.no_args(), d, try types.no_args()))
                        member = m.next
                    # every implemented interface needs its table, except a generic one,
                    # `Iterator[T]`, which `for` consumes statically and nothing views
                    var listed = d.ty if d.kind != ast.Kind.enum_ else d.right
                    while let l = listed:
                        if let iface = self.decl_of(l.type_id):
                            if check.generic_params_of(iface) == none:
                                try self.note_vtable(d.type_id, l.type_id)
                        listed = l.next
                elif d.kind == ast.Kind.test_ and mode == 1:
                    discard(try self.test_index(d))
                cursor = d.next
            i += 1
        # bodies, until the worklist is drained: a body may need new instances
        var next: usize = 0
        var tests_done: usize = 0
        while next < self.funcs.count or tests_done < self.tests.count:
            while next < self.funcs.count:
                var inst = self.funcs.get(next)
                if not inst.done:
                    inst.done = true
                    self.funcs.set(next, inst)
                    try self.function(inst)
                next += 1
            while tests_done < self.tests.count and next >= self.funcs.count:
                try self.test_body(self.tests.get(tests_done))
                tests_done += 1
        # the prototypes first, so the types they spell are noted before the typedefs
        self.target = to_protos
        try self.prototypes()
        # the header: prologue, types, prototypes, globals, tables
        self.target = to_out
        try self.prologue()
        try self.forward_declarations()
        try self.type_definitions()
        try self.out.put(self.protos.view())
        try self.line("")
        try self.out.put(self.globals.view())
        try self.tables()
        try self.line("")
        try self.out.put_bytes(self.body.bytes())
        try self.line("")
        if mode == 1:
            try self.test_runner()
        elif mode == 2:
            try self.answer_shim()
        else:
            let main_fn = check.find_decl(self.entry, "main") else return
            try self.main_shim(main_fn)

    mutating func prologue() -> !:
        try self.put("/* generated by luce-base */\n")
        try self.put("#include \"lucb_rt.h\"\n")
        try self.put("#include <stdarg.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdatomic.h>\n")

    ## Prototypes of every function instance and extern, and the interface tables' types.
    mutating func prototypes() -> !:
        var i: usize = 0
        while i < self.modules.count:
            var cursor = self.modules.get(i).body
            while let d = cursor:
                if d.kind == ast.Kind.extern_func:
                    try self.extern_prototype(d)
                elif d.kind == ast.Kind.extern_var:
                    try self.line("extern ")
                    try self.put_type(d.type_id)
                    try self.put(" ")
                    try self.put(d.text)
                    try self.put(";")
                elif d.kind == ast.Kind.interface_ and check.generic_params_of(d) == none:
                    # a generic interface, `Iterator[T]`, is consumed statically by `for` and
                    # never viewed, so it has no table of its own
                    try self.interface_typedef(d)
                    if d.text == "Allocator" and d.has(ast.flag_builtin):
                        try self.allocator_glue()
                cursor = d.next
            i += 1
        i = 0
        while i < self.funcs.count:
            let inst = self.funcs.get(i)
            self.fn_decl = inst.decl
            self.fn_args = inst.args
            self.owner_decl = inst.owner
            self.owner_args = inst.owner_args
            try self.signature(inst.decl, false)
            i += 1
        self.fn_decl = none
        self.fn_args = try types.no_args()
        self.owner_decl = none
        self.owner_args = try types.no_args()
        i = 0
        while i < self.tests.count:
            try self.line("lb_r_unit lb_test_")
            try self.put_u64((u64)i)
            try self.put("(void);")
            i += 1

    mutating func extern_prototype(d: ast.Node*) -> !:
        # the C library's own functions come from the headers the prologue includes;
        # some of them are macros there, so they are never redeclared
        if declared_by_headers(names.c_symbol(d)):
            return
        try self.line("extern ")
        let ft = self.c.table.get(d.type_id)
        let result = declared_result(d) if has_out_params(d) else ft.elem
        if result == types.unit_id:
            try self.put("void")
        else:
            try self.put_type(result)
        try self.put(" ")
        try self.put(names.c_symbol(d))
        try self.put("(")
        var first = true
        if has_out_params(d):
            # the declared parameters in C's order, an `out` one as a pointer
            var param = d.right
            while let p = param:
                if not p.has(ast.flag_variadic):
                    if not first:
                        try self.put(", ")
                    first = false
                    try self.put_type(p.type_id)
                    if p.has(ast.flag_out):
                        try self.put("*")
                param = p.next
        var i: usize = 0
        while i < ft.args.length and not has_out_params(d):
            if not first:
                try self.put(", ")
            first = false
            try self.put_type(ft.args[i])
            i += 1
        if ft.variadic:
            if not first:
                try self.put(", ")
            try self.put("...")
            first = false
        if first:
            try self.put("void")
        try self.put(");")

    ## A top-level `let` or `var` as a C global.
    mutating func global(d: ast.Node*) -> !:
        try self.line("")
        try self.attribute_prefix(d, false)
        if d.has(ast.flag_thread_local):
            try self.put("_Thread_local ")
        let t = d.type_id
        try self.put_type(t)
        try self.put(" ")
        try self.put_global_name(d)
        if d.has(ast.flag_uninit):
            try self.put(";")
            return
        try self.put(" = ")
        if let init = d.left:
            try self.value(init, t)
        else:
            try self.zero_value(t)
        try self.put(";")

    ## Every witness table the program needs.
    mutating func tables() -> !:
        var i: usize = 0
        while i < self.vtables.count:
            try self.vtable(self.vtables.get(i))
            i += 1

    mutating func test_body(t: ast.Node*) -> !:
        let saved_fn = self.current_fn
        self.current_fn = t
        self.fn_decl = none
        self.fn_args = try types.no_args()
        self.owner_decl = none
        self.owner_args = try types.no_args()
        self.target = to_body
        try self.signature(t, true)
        self.indent += 1
        try self.push_scope(false, "")
        if let body = t.body:
            var cursor = body.body
            while let s = cursor:
                try self.stmt(s)
                cursor = s.next
        try self.unwind(self.scopes.count - 1, false)
        self.pop_scope()
        try self.line("return ((lb_r_unit){ .failed = false });")
        self.indent -= 1
        try self.line("}")
        self.current_fn = saved_fn

    ## `main` for a program with `main(arguments)`: the C strings become `str` or `c.str` items.
    mutating func main_shim(f: ast.Node*) -> !:
        let ft = self.c.table.get(f.type_id)
        var cstr_args = false
        if ft.args.length > 0:
            cstr_args = self.elem(ft.args[0]) == types.cstr_id
        try self.line("int main(int argc, char** argv) {")
        try self.line("    lb_memory_startup();")
        if cstr_args:
            try self.line("    lb_span args = { (void*)argv, (size_t)argc };")
        else:
            try self.line("    lb_str* items = (lb_str*)malloc((size_t)argc * sizeof(lb_str));")
            try self.line("    if (items == NULL) { return 1; }")
            try self.line("    for (int i = 0; i < argc; i++) { size_t n = 0; while (argv[i][n]) n++; lb_check_utf8(argv[i], n); items[i].data = argv[i]; items[i].length = n; }")
            try self.line("    lb_span args = { items, (size_t)argc };")
        # `main()` may also take no arguments at all
        let call = "lb_main(args)" if ft.args.length > 0 else "lb_main()"
        if ft.args.length == 0:
            try self.line("    (void)args;")
        if f.has(ast.flag_fallible):
            try self.line("    lb_r_i32 r = ")
            try self.put(call)
            try self.put(";")
            try self.line("    if (r.failed) { fprintf(stderr, \"error %d: %.*s\\n\", r.error.code, (int)r.error.message.length, r.error.message.data); return 1; }")
            try self.line("    return (int)r.value;")
        else:
            try self.line("    return (int)")
            try self.put(call)
            try self.put(";")
        try self.line("}")

    ## `lb_answer` for the seed's `answer()` convention, then `start.c` calls it; a
    ## plain `answer` already carries that name.
    mutating func answer_shim() -> !:
        let f = check.find_decl(self.entry, "answer") else return
        if not f.has(ast.flag_fallible):
            return
        try self.line("int64_t lb_answer(void) {")
        try self.line("    lb_r_i64 r = lb_answer_impl();")
        try self.line("    if (r.failed) { fprintf(stderr, \"error %d: %.*s\\n\", r.error.code, (int)r.error.message.length, r.error.message.data); exit(1); }")
        try self.line("    return r.value;")
        try self.line("}")

    ## A `main` that runs every test in order and reports.
    mutating func test_runner() -> !:
        try self.line("int main(void) {")
        try self.line("    lb_memory_startup();")
        try self.line("    int failed = 0;")
        var i: usize = 0
        while i < self.tests.count:
            let t = self.tests.get(i)
            try self.line("    { lb_testing_begin(")
            try self.put_u64((u64)i)
            try self.put("); lb_r_unit r = lb_test_")
            try self.put_u64((u64)i)
            try self.put("(); lb_testing_end(); if (r.failed) { failed++; fprintf(stdout, \"FAIL  %s\\n      error: %.*s\\n\", ")
            try self.put_c_string(check.decode_text(t.text))
            try self.put(", (int)r.error.message.length, r.error.message.data); } else { fprintf(stdout, \"ok    %s\\n\", ")
            try self.put_c_string(check.decode_text(t.text))
            try self.put("); } }")
            i += 1
        try self.line("    fprintf(stdout, \"%d passed\\n\", ")
        try self.put_u64((u64)self.tests.count)
        try self.put(" - failed);")
        try self.line("    return failed == 0 ? 0 : 1;")
        try self.line("}")

    ## The generated C, once `program` has run.
    pub func text() -> str:
        return self.out.view()

# mark: Helpers ================================================================================

## The runtime helper behind an arithmetic operator.
## `[name] ` before a constraint: the named operand form of GNU extended asm.
func put_asm_label(out: buffer.Buffer*, label: str) -> !:
    if label.length == 0:
        return
    try out.put("[")
    try out.put(label)
    try out.put("] ")

## Whether an extern declares `out` parameters (§17.1).
func has_out_params(d: ast.Node*) -> bool:
    var cursor = d.right
    while let p = cursor:
        if p.has(ast.flag_out):
            return true
        cursor = p.next
    return false

## The result an extern declared, apart from its `out` values: the result type node's type.
func declared_result(d: ast.Node*) -> u32:
    let r = d.ty else return types.unit_id
    return r.type_id

## Whether a formatted string has a field that writes itself (§14.4): such a string is built
## in a buffer rather than written piece by piece.
func displays_a_field(f: ast.Node*) -> bool:
    var part = f.body
    while let p = part:
        if p.kind == ast.Kind.format_field and p.has(ast.flag_format_sink):
            return true
        part = p.next
    return false

## The C spelling of one of the `c` module's distinct types (base.md §5.2).
func c_spelling(id: u32) -> str:
    if id == types.c_char_id: return "char"
    if id == types.c_long_id: return "long"
    if id == types.c_ulong_id: return "unsigned long"
    if id == types.c_wchar_id: return "wchar_t"
    return "va_list"

func helper_name(op: str) -> str:
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    if op == "//":
        return "div"
    if op == "%":
        return "mod"
    if op == "+%":
        return "addw"
    if op == "-%":
        return "subw"
    if op == "*%":
        return "mulw"
    if op == "+|":
        return "adds"
    if op == "-|":
        return "subs"
    if op == "*|":
        return "muls"
    if op == "<<":
        return "shl"
    if op == ">>":
        return "shr"
    return "add"

## `error(...)` as an expression statement or a return.
func is_error_call(e: ast.Node*) -> bool:
    if e.kind != ast.Kind.call:
        return false
    let callee = e.left else return false
    return callee.kind == ast.Kind.name and callee.text == "error" and callee.resolved == none

func is_trap_call(e: ast.Node*) -> bool:
    if e.kind != ast.Kind.call:
        return false
    let callee = e.left else return false
    return callee.kind == ast.Kind.name and callee.text == "trap" and callee.resolved == none

## A value that never arrives: `never`, or `try` on a `never!` call.
func never_valued(e: ast.Node*) -> bool:
    if e.type_id == types.never_id:
        return true
    if e.kind == ast.Kind.unary and e.text == "try":
        let inner = e.left else return false
        return inner.type_id != 0 and false
    return false

## The integer value of an integer-backed enum case: written, or the previous plus one.
func case_int(d: ast.Node*, target: ast.Node*) -> u64:
    var next: u64 = 0
    var cursor = d.body
    while let c = cursor:
        if c.kind == ast.Kind.enum_case:
            var v = next
            if let written = c.left:
                if written.kind == ast.Kind.literal:
                    v = check.decode_integer(written.text) catch failure:
                        recover next
            if c == target:
                return v
            next = v + 1
        cursor = c.next
    return 0

## The tag of a payload enum case: its position among the cases.
func case_tag(d: ast.Node*, target: ast.Node*) -> u32:
    var i: u32 = 0
    var cursor = d.body
    while let c = cursor:
        if c.kind == ast.Kind.enum_case:
            if c == target:
                return i
            i += 1
        cursor = c.next
    return 0

## A float literal without its digit separators.
func strip_underscores(text: str) -> str:
    var any = false
    for b in text.bytes:
        if b == '_':
            any = true
    if not any:
        return text
    return text

## `{{` and `}}` in a formatted piece are one brace each.
func unescape_braces(text: str) -> str:
    let b = text.bytes
    var any = false
    var i: usize = 0
    while i + 1 < b.length:
        if (b[i] == '{' and b[i + 1] == '{') or (b[i] == '}' and b[i + 1] == '}'):
            any = true
        i += 1
    if not any:
        return text
    let out = alloc u8[b.length] catch failure:
        trap("out of memory")
    var n: usize = 0
    i = 0
    while i < b.length:
        out[n] = b[i]
        n += 1
        if i + 1 < b.length and ((b[i] == '{' and b[i + 1] == '{') or (b[i] == '}' and b[i + 1] == '}')):
            i += 1
        i += 1
    return (str)out[..<n]

## Functions of stdio.h, stdlib.h, and string.h, which the generated C includes.
func declared_by_headers(symbol: str) -> bool:
    let known: str[32] = ["memcpy", "memmove", "memset", "memcmp", "strlen", "malloc", "free", "realloc", "calloc", "exit", "abort", "fwrite", "fread", "fputs", "fflush", "fdopen", "fopen", "fclose", "posix_memalign", "snprintf",
                          "getenv", "setenv", "unsetenv", "putenv", "atoi", "strtol", "strcmp", "strncmp", "strchr", "strstr", "printf", "fprintf"]
    for n in known:
        if n == symbol:
            return true
    return false

func contains_id(ids: const u32[], id: u32) -> bool:
    for x in ids:
        if x == id:
            return true
    return false

func same_args(a: const u32[], b: const u32[]) -> bool:
    if a.length != b.length:
        return false
    var i: usize = 0
    while i < a.length:
        if a[i] != b[i]:
            return false
        i += 1
    return true
