#==============================================================================================
#
#   arm64 - The arm64-macos code generator
#
#   DESCRIPTION:
#       Turns an `ir.Unit` into assembly text for the system assembler: Mach-O sections,
#       underscore-prefixed symbols, `adrp`/`add` addressing, thread-locals through the
#       `TLVP` descriptors, and calls under the Apple arm64 convention (base.md §19.5):
#       integers in x0-x7, floats in d0-d7, aggregates up to sixteen bytes in registers,
#       larger ones by address, homogeneous float aggregates in d registers, results the
#       same way with x8 for the large ones, variadic arguments on the stack.
#
#       Every temporary lives in a frame slot: an instruction loads its operands into
#       scratch registers, computes, and stores the result. That is the -O0 shape, chosen
#       so that the backend is right before it is fast; a register allocator over the same
#       instructions is the next step and changes nothing here but the operand code.
#
#==============================================================================================

import back.ir
import memory
import support.buffer
import support.list

pub let failed: ErrorCode = ErrorCode.package(15)

## Where a temporary or slot lives: an offset below the frame pointer.
struct FrameHome:
    var offset: u64

## One argument's placement for a call.
struct ArgPlacement:
    ## 0 = integer registers, 1 = float registers, 2 = stack, 3 = by reference in an integer register
    var where: u8
    var first: u32
    var count: u32
    var stack_offset: u32

pub struct Generator:
    var out: buffer.Buffer
    var program_unit: ir.Unit*
    var f: ir.Function*
    var index: usize
    var temp_homes: list.List[FrameHome]
    var slot_homes: list.List[FrameHome]
    var frame: u64
    ## The frame slot holding x8 (the indirect result address) when the function returns a large aggregate.
    var indirect_home: u64
    var text_count: usize
    ## `--debug`: the frame descriptors, gathered while each function's frame is known.
    var descriptors: buffer.Buffer
    ## Register allocation: for each temporary, the callee-saved register it lives in
    ## (1..10 for x19..x28), or 0 when it is spilled to its frame home.
    var temp_regs: list.List[u8]
    ## The callee-saved register code a promoted frame slot lives in, 0 when it stays in the
    ## frame; and, per temporary, 1 + the slot whose address it holds, 0 otherwise.
    var slot_regs: list.List[u8]
    var temp_slot: list.List[u32]
    ## Bit c-1 is set when register code c is used (1..10 = x19..x28, 11..18 = d8..d15);
    ## `save_offset[c]` is where that register is spilled on entry.
    var used_mask: u32
    var save_offset: u64[19]
    ## How far sp is below the frame's bottom while a call sequence has moved it; frame
    ## operands relative to sp add it back.
    var sp_shift: u64

    pub static func create(program_unit: ir.Unit*) -> Generator!:
        return Generator(out = try buffer.Buffer.create(262144), program_unit = program_unit, f = program_unit.functions.span().data, index = 0,
                         temp_homes = try list.List[FrameHome].create(256), slot_homes = try list.List[FrameHome].create(64),
                         frame = 0, indirect_home = 0, text_count = 0, descriptors = try buffer.Buffer.create(4096),
                         temp_regs = try list.List[u8].create(256), slot_regs = try list.List[u8].create(64), temp_slot = try list.List[u32].create(256), used_mask = 0)

    # -- output ---------------------------------------------------------------------------

    mutating func put(text: str) -> !:
        try self.out.put(text)

    mutating func line(text: str) -> !:
        try self.out.put("\n    ")
        try self.out.put(text)

    mutating func put_u64(v: u64) -> !:
        try self.out.put_u64(v)

    mutating func put_i64(v: i64) -> !:
        try self.out.put_i64(v)

    ## `_name`
    mutating func symbol(name: str) -> !:
        try self.out.put("_")
        try self.out.put(name)

    mutating func label_name(n: u32) -> !:
        try self.out.put("L")
        try self.out.put_u64((u64)self.index)
        try self.out.put("_")
        try self.out.put_u64((u64)n)

    mutating func text_label(n: u32) -> !:
        try self.out.put("l_text_")
        try self.out.put_u64((u64)n)

    pub func text() -> str:
        return self.out.view()

    # -- registers and immediates ---------------------------------------------------------

    ## `movz`/`movk` for any 64-bit value.
    mutating func load_immediate(reg: str, value: i64) -> !:
        let bits = (u64)value
        if bits == 0:
            try self.line("mov ")
            try self.put(reg)
            try self.put(", #0")
            return
        # a negative number is shorter with movn
        if value < 0 and value >= -65536:
            try self.line("movn ")
            try self.put(reg)
            try self.put(", #")
            try self.put_u64((u64)(-1 - value))
            return
        var first = true
        var shift: u64 = 0
        while shift < 64:
            let piece = (bits >> shift) & 65535
            if piece != 0 or (first and shift == 48):
                try self.line("movz " if first else "movk ")
                try self.put(reg)
                try self.put(", #")
                try self.put_u64(piece)
                if shift > 0:
                    try self.put(", lsl #")
                    try self.put_u64(shift)
                first = false
            shift += 16

    ## The memory operand `[sp, #n]` for the frame home `offset` bytes below x29, for an
    ## access of `width` bytes: the scaled unsigned form reaches 4095 units of the width.
    ## The frame is laid out before any instruction is emitted, so `frame` is known.
    func frame_fits(offset: u64, width: u64) -> bool:
        if offset > self.frame:
            return false
        let n = self.frame - offset + self.sp_shift
        return n % width == 0 and n // width <= 4095

    mutating func frame_operand(offset: u64) -> !:
        try self.put("[sp, #")
        try self.put_u64(self.frame - offset + self.sp_shift)
        try self.put("]")

    ## `reg` stored to or loaded from the frame home `offset`: through sp when the offset
    ## reaches, else through an address in x16.
    ## A half register stores through its single view, so its home's whole word is written
    ## and a reinterpretation as an integer reads zeros above the half.
    mutating func frame_store(reg: str, offset: u64) -> !:
        let spelled = single_view(reg)
        if self.frame_fits(offset, access_width_of(spelled)):
            try self.line3("str ", spelled, ", ")
            try self.frame_operand(offset)
            return
        try self.frame_address("x16", offset)
        try self.line3("str ", spelled, ", [x16]")

    mutating func frame_load(reg: str, offset: u64) -> !:
        if self.frame_fits(offset, access_width_of(reg)):
            try self.line3("ldr ", reg, ", ")
            try self.frame_operand(offset)
            return
        try self.frame_address("x16", offset)
        try self.line3("ldr ", reg, ", [x16]")

    ## `reg = x29 - offset`.
    mutating func frame_address(reg: str, offset: u64) -> !:
        if offset <= 4095:
            try self.line("sub ")
            try self.put(reg)
            try self.put(", x29, #")
            try self.put_u64(offset)
            return
        try self.load_immediate("x16", (i64)offset)
        try self.line("sub ")
        try self.put(reg)
        try self.put(", x29, x16")

    func temp_home(t: u32) -> u64:
        return self.temp_homes.get((usize)t - 1).offset

    func slot_home(s: u32) -> u64:
        return self.slot_homes.get((usize)s).offset

    ## The register name of class `cls` for scratch number `n` (0, 1, 2).
    func reg(cls: ir.Class, n: u32) -> str:
        if cls == ir.Class.w:
            return "w9" if n == 0 else ("w10" if n == 1 else "w11")
        if cls == ir.Class.l:
            return "x9" if n == 0 else ("x10" if n == 1 else "x11")
        if cls == ir.Class.s:
            return "s16" if n == 0 else ("s17" if n == 1 else "s18")
        if cls == ir.Class.h:
            return "h16" if n == 0 else ("h17" if n == 1 else "h18")
        return "d16" if n == 0 else ("d17" if n == 1 else "d18")

    func xreg(n: u32) -> str:
        return "x9" if n == 0 else ("x10" if n == 1 else "x11")

    ## Load a temporary into `reg`: a register move when it lives in one, else from its home.
    ## A float register moves with `fmov`, an integer one with `mov`; the width follows `reg`.
    ## The register holding `r` as class `cls` when `r` is a temporary living in one of the
    ## right kind, else `scratch` after loading it there. Instructions then read operands
    ## where they are rather than through a scratch register.
    mutating func source(r: ir.Ref, cls: ir.Class, scratch: str) -> str!:
        if r.kind == ir.RefKind.temp:
            let code = self.temp_regs.get((usize)r.index - 1)
            if code != 0 and (code >= 11) == ir.is_float_class(cls):
                return class_name(code, cls)
        try self.operand(scratch, cls, r)
        return scratch

    ## The register to compute temporary `dst` into: its own when it lives in one of the
    ## right kind, else `scratch`, which `finish` then stores.
    func target(dst: u32, cls: ir.Class, scratch: str) -> str:
        if dst == 0:
            return scratch
        let code = self.temp_regs.get((usize)dst - 1)
        if code != 0 and (code >= 11) == ir.is_float_class(cls):
            return class_name(code, cls)
        return scratch

    ## After a result landed in `reg`: nothing when that is the temporary's own register.
    mutating func finish(dst: u32, cls: ir.Class, reg: str) -> !:
        if dst == 0:
            return
        let code = self.temp_regs.get((usize)dst - 1)
        if code != 0 and class_name(code, cls) == reg:
            return
        try self.store_temp(reg, dst)

    mutating func load_temp(reg: str, cls: ir.Class, t: u32) -> !:
        let code = self.temp_regs.get((usize)t - 1)
        if code != 0:
            let home = register_view(reg, code)
            if home != reg:
                try self.line("fmov " if code >= 11 else "mov ")
                try self.put(reg)
                try self.put(", ")
                try self.put(home)
            return
        try self.frame_load(reg, self.temp_home(t))

    mutating func store_temp(reg: str, t: u32) -> !:
        let code = self.temp_regs.get((usize)t - 1)
        if code != 0:
            let home = register_view(reg, code)
            if home != reg:
                try self.line("fmov " if code >= 11 else "mov ")
                try self.put(home)
                try self.put(", ")
                try self.put(reg)
            return
        try self.frame_store(reg, self.temp_home(t))

    ## An operand into a scratch register of class `cls`.
    mutating func operand(reg: str, cls: ir.Class, r: ir.Ref) -> !:
        if r.kind == ir.RefKind.temp:
            let tc = self.f.temp_class(r.index)
            if tc == cls or (is_int_class(tc) and is_int_class(cls)):
                try self.load_temp(reg, cls, r.index)
                return
            # a float temporary read as an integer word or the reverse: reinterpret the home's bytes
            try self.load_temp(reg, cls, r.index)
            return
        if r.kind == ir.RefKind.constant:
            if ir.is_float_class(cls):
                try self.load_immediate("x16", r.value)
                try self.line("fmov ")
                try self.put(reg)
                try self.put(", ")
                try self.put("x16" if cls == ir.Class.d else "w16")
                return
            try self.load_immediate(self.as_x(reg), r.value)
            return
        try self.address_operand(self.as_x(reg), r)

    ## `w9` -> `x9`; a 64-bit immediate load wants the wide name.
    func as_x(reg: str) -> str:
        let b = reg.bytes
        if b[0] == 'w':
            if reg == "w9":
                return "x9"
            if reg == "w10":
                return "x10"
            if reg == "w11":
                return "x11"
            if reg == "w16":
                return "x16"
            if reg == "w0":
                return "x0"
            if reg == "w1":
                return "x1"
            if reg == "w2":
                return "x2"
        return reg

    ## The address a slot, global, function, or text refers to, into an x register.
    mutating func address_operand(reg: str, r: ir.Ref) -> !:
        if r.kind == ir.RefKind.slot:
            try self.frame_address(reg, self.slot_home(r.index))
        elif r.kind == ir.RefKind.global:
            try self.line("adrp ")
            try self.put(reg)
            try self.put(", ")
            try self.symbol(r.name)
            try self.put("@PAGE")
            try self.line("add ")
            try self.put(reg)
            try self.put(", ")
            try self.put(reg)
            try self.put(", ")
            try self.symbol(r.name)
            try self.put("@PAGEOFF")
        elif r.kind == ir.RefKind.function:
            # a function's address goes through the GOT, so a symbol defined in a linked
            # dylib (an extern C function used as a pointer, like `objc_msgSend`) resolves
            try self.line("adrp ")
            try self.put(reg)
            try self.put(", ")
            try self.symbol(r.name)
            try self.put("@GOTPAGE")
            try self.line("ldr ")
            try self.put(reg)
            try self.put(", [")
            try self.put(reg)
            try self.put(", ")
            try self.symbol(r.name)
            try self.put("@GOTPAGEOFF]")
        elif r.kind == ir.RefKind.text:
            try self.line("adrp ")
            try self.put(reg)
            try self.put(", ")
            try self.text_label(r.index)
            try self.put("@PAGE")
            try self.line("add ")
            try self.put(reg)
            try self.put(", ")
            try self.put(reg)
            try self.put(", ")
            try self.text_label(r.index)
            try self.put("@PAGEOFF")
        elif r.kind == ir.RefKind.temp:
            try self.load_temp(reg, ir.Class.l, r.index)
        elif r.kind == ir.RefKind.constant:
            try self.load_immediate(reg, r.value)
        else:
            try self.line("mov ")
            try self.put(reg)
            try self.put(", #0")

    # mark: Functions ==========================================================================

    ## Lay out the frame: the indirect result, the callee-saved save area, slots, and a
    ## home for each spilled temporary, all below x29.
    mutating func layout() -> !:
        self.temp_homes.count = 0
        self.slot_homes.count = 0
        var offset: u64 = 16
        # the indirect result address, when the function returns a large aggregate
        if self.f.has_result and self.f.result_size > 16 and not (self.f.result_float_only):
            offset = arm_round_up(offset, 8) + 8
            self.indirect_home = offset
        # one word for each callee-saved register the allocator used
        var c: usize = 1
        while c <= 18:
            if (self.used_mask & (u32)(1 << (u32)(c - 1))) != 0:
                offset = arm_round_up(offset + 8, 8)
                self.save_offset[c] = offset
            else:
                self.save_offset[c] = 0
            c += 1
        var i: usize = 0
        while i < self.f.slots.count:
            let s = self.f.slots.get(i)
            let size = (u64)s.size if s.size > 0 else 1
            offset = arm_round_up(offset + size, (u64)s.align if s.align > 0 else 1)
            try self.slot_homes.push(FrameHome(offset = offset))
            i += 1
        i = 0
        while i < self.f.temps.count:
            if self.temp_regs.get(i) == 0:
                offset = arm_round_up(offset + 8, 8)
                try self.temp_homes.push(FrameHome(offset = offset))
            else:
                try self.temp_homes.push(FrameHome(offset = 0))
            i += 1
        self.frame = arm_round_up(offset, 16)

    ## Assign block-local integer temporaries to callee-saved registers by linear scan,
    ## spilling the longest-lived when they run out (base.md §19.1: temps never cross a block,
    ## and callee-saved registers survive the calls a block may contain).
    ## The slot an address temporary stands for, 1-based, or 0. Only meaningful after
    ## `promote`, and only for slots that were promoted.
    func promoted_slot(t: u32) -> u32:
        if (usize)t > self.temp_slot.count:
            return 0
        let k = self.temp_slot.get((usize)t - 1)
        if k == 0 or self.slot_regs.get((usize)k - 1) == 0:
            return 0
        return k

    ## Which frame slots live in registers (§19.3 codegen): a slot of 1, 2, 4, or 8 bytes whose
    ## address is taken only to load or store that many bytes at once, in one register class.
    ## The most-used ones take the first `ints` integer and `floats` float callee-saved
    ## registers; the rest stay with the temporaries. Frame descriptors need the frame, so
    ## `--debug` promotes nothing.
    mutating func promote(ints: u8, floats: u8) -> !:
        self.slot_regs.count = 0
        self.temp_slot.count = 0
        let ns = self.f.slots.count
        let nt = self.f.temps.count
        var i: usize = 0
        while i < ns:
            try self.slot_regs.push(0)
            i += 1
        i = 0
        while i < nt:
            try self.temp_slot.push(0)
            i += 1
        if self.f.debug or ns == 0:
            return
        # 1 = integer, 2 = float, 3 = unfit
        var kind = try alloc u8[ns] in memory.heap
        defer free(kind) in memory.heap
        var uses = try alloc u32[ns] in memory.heap
        defer free(uses) in memory.heap
        i = 0
        while i < ns:
            let sz = self.f.slots.get(i).size
            kind[i] = 0 if sz == 1 or sz == 2 or sz == 4 or sz == 8 else 3
            uses[i] = 0
            i += 1
        # which temporaries hold a slot's address
        var ix: usize = 0
        while ix < self.f.instrs.count:
            let n = self.f.instrs.get(ix)
            if n.op == ir.Op.addr and n.a.kind == ir.RefKind.slot and n.dst > 0:
                self.temp_slot.set((usize)n.dst - 1, n.a.index + 1)
            ix += 1
        # every use of such a temporary, or of a slot directly, must be a whole-slot load or store
        ix = 0
        while ix < self.f.instrs.count:
            let n = self.f.instrs.get(ix)
            let is_load = n.op == ir.Op.loadsb or n.op == ir.Op.loadub or n.op == ir.Op.loadsh or n.op == ir.Op.loaduh or n.op == ir.Op.loadsw or n.op == ir.Op.loaduw or n.op == ir.Op.loadl or n.op == ir.Op.loads or n.op == ir.Op.loadd or n.op == ir.Op.loadhf
            let is_store = n.op == ir.Op.storeb or n.op == ir.Op.storeh or n.op == ir.Op.storew or n.op == ir.Op.storel or n.op == ir.Op.stores or n.op == ir.Op.stored or n.op == ir.Op.storehf
            if is_load:
                self.note_access(self.slot_of(n.a), access_width(n.op), is_float_load(n.op), kind, uses)
            elif is_store:
                self.note_access(self.slot_of(n.b), access_width(n.op), is_float_store(n.op), kind, uses)
                let v = self.slot_of(n.a)
                if v != 0:
                    kind[(usize)v - 1] = 3
            elif n.op == ir.Op.addr:
                let inner = self.slot_of(n.a)
                if inner != 0 and n.a.kind == ir.RefKind.temp:
                    kind[(usize)inner - 1] = 3
            elif n.op == ir.Op.call:
                let info = self.f.calls.get((usize)n.extra)
                # an aggregate result is written into its slot by the call sequence itself
                if info.has_result and info.result_size > 0 and (usize)info.result_slot < ns:
                    kind[(usize)info.result_slot] = 3
                var a: u32 = 0
                while a < info.args_count:
                    let v = self.slot_of(self.f.args.get((usize)(info.args_start + a)).value)
                    if v != 0:
                        kind[(usize)v - 1] = 3
                    a += 1
            else:
                let va = self.slot_of(n.a)
                if va != 0:
                    kind[(usize)va - 1] = 3
                let vb = self.slot_of(n.b)
                if vb != 0:
                    kind[(usize)vb - 1] = 3
            ix += 1
        # the most-used fit slots take the registers, up to the budget of each class
        var int_code: u8 = 1
        var float_code: u8 = 11
        while true:
            var best: usize = ns
            var best_uses: u32 = 0
            i = 0
            while i < ns:
                if self.slot_regs.get(i) == 0 and (kind[i] == 1 or kind[i] == 2) and uses[i] >= 2 and uses[i] > best_uses:
                    best = i
                    best_uses = uses[i]
                i += 1
            if best == ns:
                break
            if kind[best] == 1:
                if int_code > ints:
                    kind[best] = 3
                    continue
                self.slot_regs.set(best, int_code)
                self.used_mask = self.used_mask | (u32)(1 << (u32)(int_code - 1))
                int_code += 1
            else:
                if float_code > 10 + floats:
                    kind[best] = 3
                    continue
                self.slot_regs.set(best, float_code)
                self.used_mask = self.used_mask | (u32)(1 << (u32)(float_code - 1))
                float_code += 1

    ## The slot a reference stands for, 1-based: a slot reference itself, or a temporary that
    ## holds a slot's address; 0 otherwise.
    func slot_of(r: ir.Ref) -> u32:
        if r.kind == ir.RefKind.slot:
            return r.index + 1
        if r.kind == ir.RefKind.temp and (usize)r.index <= self.temp_slot.count:
            return self.temp_slot.get((usize)r.index - 1)
        return 0

    ## One load or store of `width` bytes through slot `k` (1-based): it fits when the width
    ## is the slot's and the class agrees with every other access.
    func note_access(k: u32, width: u32, float: bool, kind: u8[], uses: u32[]):
        if k == 0:
            return
        let i = (usize)k - 1
        if kind[i] == 3:
            return
        if self.f.slots.get(i).size != width:
            kind[i] = 3
            return
        let want: u8 = 2 if float else 1
        if kind[i] == 0:
            kind[i] = want
        elif kind[i] != want:
            kind[i] = 3
            return
        uses[i] += 1

    ## Where each temporary is defined and last used, by instruction index. A temporary
    ## defined before a loop and used inside it is live across the back-edge: its last use is
    ## pushed to the loop's bottom. A jump or branch to an earlier label is a back-edge, and one
    ## forward pass is enough: an inner loop's back-edge comes before its outer loop's, so an
    ## extension across the inner loop is already in place when the outer one is considered.
    mutating func live_ranges(def_at: u32[], last_use: u32[]) -> !:
        let n = self.f.temps.count
        var i: usize = 0
        while i < n:
            def_at[i] = 0
            last_use[i] = 0
            i += 1
        # the instruction index each label sits at, for finding loop back-edges
        var label_pos = try alloc u32[(usize)self.f.labels + 1] in memory.heap
        defer free(label_pos) in memory.heap
        var ix: usize = 0
        while ix < self.f.instrs.count:
            let instr = self.f.instrs.get(ix)
            if instr.op == ir.Op.label and instr.extra <= self.f.labels:
                label_pos[(usize)instr.extra] = u32(ix)
            if instr.dst > 0 and (usize)instr.dst <= n:
                def_at[(usize)instr.dst - 1] = u32(ix)
            self.note_use(instr.a, last_use, u32(ix))
            self.note_use(instr.b, last_use, u32(ix))
            if instr.op == ir.Op.call:
                let info = self.f.calls.get((usize)instr.extra)
                var k: u32 = 0
                while k < info.args_count:
                    self.note_use(self.f.args.get((usize)(info.args_start + k)).value, last_use, u32(ix))
                    k += 1
            ix += 1
        ix = 0
        while ix < self.f.instrs.count:
            let instr = self.f.instrs.get(ix)
            if instr.op == ir.Op.jmp or instr.op == ir.Op.jnz:
                let targets: u32[2] = [instr.extra, instr.extra2 if instr.op == ir.Op.jnz else instr.extra]
                var w: usize = 0
                while w < 2:
                    let target = targets[w]
                    w += 1
                    if target == 0 or target > self.f.labels:
                        continue
                    let t = label_pos[(usize)target]
                    if t >= u32(ix):
                        continue
                    var i2: usize = 0
                    while i2 < n:
                        if def_at[i2] < t and last_use[i2] >= t and last_use[i2] < u32(ix):
                            last_use[i2] = u32(ix)
                        i2 += 1
            ix += 1

    ## The most temporaries of each register class live at one point: what the temporaries
    ## could use of the callee-saved registers, so the promoted slots may take the rest.
    mutating func pressure(def_at: u32[], last_use: u32[]) -> (u32, u32)!:
        let n = self.f.temps.count
        let m = self.f.instrs.count + 2
        var delta_int = try alloc i32[m] in memory.heap
        defer free(delta_int) in memory.heap
        var delta_float = try alloc i32[m] in memory.heap
        defer free(delta_float) in memory.heap
        var k: usize = 0
        while k < m:
            delta_int[k] = 0
            delta_float[k] = 0
            k += 1
        var i: usize = 0
        while i < n:
            if last_use[i] > def_at[i]:
                let c = self.f.temp_class(u32(i + 1))
                if ir.is_float_class(c):
                    delta_float[(usize)def_at[i]] += 1
                    delta_float[(usize)last_use[i] + 1] -= 1
                elif c == ir.Class.w or c == ir.Class.l:
                    delta_int[(usize)def_at[i]] += 1
                    delta_int[(usize)last_use[i] + 1] -= 1
            i += 1
        var ints: i32 = 0
        var floats: i32 = 0
        var live_int: i32 = 0
        var live_float: i32 = 0
        k = 0
        while k < m:
            live_int += delta_int[k]
            live_float += delta_float[k]
            if live_int > ints:
                ints = live_int
            if live_float > floats:
                floats = live_float
            k += 1
        return ((u32)ints, (u32)floats)

    ## Give each temporary a callee-saved register by linear scan over its live range, from
    ## `live_ranges`; when a class's pool is full, the temporary living longest is spilled.
    mutating func allocate(def_at: u32[], last_use: u32[]) -> !:
        self.temp_regs.count = 0
        let n = self.f.temps.count
        var i: usize = 0
        while i < n:
            try self.temp_regs.push(0)
            i += 1
        # the promoted slots' registers are already in the mask; the temporaries add theirs
        self.used_mask = 0
        var ps: usize = 0
        while ps < self.slot_regs.count:
            let code = self.slot_regs.get(ps)
            if code != 0:
                self.used_mask = self.used_mask | (u32)(1 << (u32)(code - 1))
            ps += 1
        if n == 0:
            return
        var eligible = try alloc bool[n] in memory.heap
        defer free(eligible) in memory.heap
        i = 0
        while i < n:
            let c = self.f.temp_class(u32(i + 1))
            eligible[i] = (c == ir.Class.w or c == ir.Class.l or ir.is_float_class(c)) and self.promoted_slot(u32(i + 1)) == 0
            i += 1
        # two register pools, integer codes 1..10 (x19..x28) and float codes 11..18 (d8..d15)
        var reg_temp: u32[19] = ---
        var c: usize = 0
        while c <= 18:
            reg_temp[c] = 0
            c += 1
        # a register holding a promoted slot is taken for the whole function
        var pk: usize = 0
        while pk < self.slot_regs.count:
            let code = self.slot_regs.get(pk)
            if code != 0:
                reg_temp[(usize)code] = held
            pk += 1
        var ix: usize = 0
        while ix < self.f.instrs.count:
            c = 1
            while c <= 18:
                let t = reg_temp[c]
                if t != 0 and t != held and last_use[(usize)t - 1] < u32(ix):
                    reg_temp[c] = 0
                c += 1
            let instr = self.f.instrs.get(ix)
            let d = (usize)instr.dst
            if d > 0 and d <= n and eligible[d - 1] and def_at[d - 1] == u32(ix) and last_use[d - 1] > u32(ix):
                let tc = self.f.temp_class(instr.dst)
                let is_float = ir.is_float_class(tc)
                let low: usize = 11 if is_float else 1
                let high: usize = 18 if is_float else 10
                var chosen: usize = 0
                c = low
                while c <= high:
                    if reg_temp[c] == 0:
                        chosen = c
                        break
                    c += 1
                if chosen == 0:
                    var far_c: usize = 0
                    var far_use = last_use[d - 1]
                    c = low
                    while c <= high:
                        let t = reg_temp[c]
                        if t != 0 and t != held and last_use[(usize)t - 1] > far_use:
                            far_use = last_use[(usize)t - 1]
                            far_c = c
                        c += 1
                    if far_c != 0:
                        self.temp_regs.set((usize)reg_temp[far_c] - 1, 0)
                        chosen = far_c
                if chosen != 0:
                    reg_temp[chosen] = instr.dst
                    self.temp_regs.set(d - 1, (u8)chosen)
                    self.used_mask = self.used_mask | (u32)(1 << (u32)(chosen - 1))
            ix += 1

    ## Copy `size` bytes from [x10] to [x11] with plain loads and stores: 16 at a time, then
    ## 8, 4, 2, 1. The addresses are records in frames or fields, so unaligned access is fine
    ## on arm64; a copy of up to 128 bytes is cheaper inline than as a call.
    mutating func inline_copy(size: u64) -> !:
        var done: u64 = 0
        while size - done >= 16:
            try self.pair_move("ldp x12, x13, [x10, #", done)
            try self.pair_move("stp x12, x13, [x11, #", done)
            done += 16
        let widths: u64[4] = [8, 4, 2, 1]
        let loads: str[4] = ["ldr x12", "ldr w12", "ldrh w12", "ldrb w12"]
        let stores: str[4] = ["str x12", "str w12", "strh w12", "strb w12"]
        var k: usize = 0
        while k < 4:
            if size - done >= widths[k]:
                try self.pair_move(loads[k], done, ", [x10, #")
                try self.pair_move(stores[k], done, ", [x11, #")
                done += widths[k]
            k += 1

    ## Zero `size` bytes at [x11] the same way.
    mutating func inline_zero(size: u64) -> !:
        var done: u64 = 0
        while size - done >= 16:
            try self.pair_move("stp xzr, xzr, [x11, #", done)
            done += 16
        let widths: u64[4] = [8, 4, 2, 1]
        let stores: str[4] = ["str xzr", "str wzr", "strh wzr", "strb wzr"]
        var k: usize = 0
        while k < 4:
            if size - done >= widths[k]:
                try self.pair_move(stores[k], done, ", [x11, #")
                done += widths[k]
            k += 1

    ## `mnemonic` + `middle` + offset + `]`: one line of a copy.
    mutating func pair_move(mnemonic: str, offset: u64, middle: str = "") -> !:
        try self.line(mnemonic)
        try self.put(middle)
        try self.put_u64(offset)
        try self.put("]")

    ## The promoted slot an address reference reaches, 1-based, or 0.
    func promoted_address(r: ir.Ref) -> u32:
        let k = self.slot_of(r)
        if k == 0 or self.slot_regs.get((usize)k - 1) == 0:
            return 0
        return k

    ## A load from a promoted slot: the register, extended as the load would extend from
    ## memory, since a narrow store leaves the register's upper bits as they were.
    mutating func load_promoted(op: ir.Op, k: u32, d: str) -> !:
        let code = (usize)self.slot_regs.get((usize)k - 1)
        let xs = x_names[code]
        let ws = w_names[code]
        match op:
            .loadhf:
                if d != h_names[code]:
                    try self.line4("fmov ", d, ", ", h_names[code])
            .loadl:
                if d != xs:
                    try self.line4("mov ", d, ", ", xs)
            .loaduw:
                if d != ws:
                    try self.line4("mov ", d, ", ", ws)
            .loadsw: try self.line4("sxtw ", d, ", ", ws)
            .loadub: try self.line5("and ", d, ", ", ws, ", #0xff")
            .loadsb: try self.line4("sxtb ", d, ", ", ws)
            .loaduh: try self.line5("and ", d, ", ", ws, ", #0xffff")
            .loadsh: try self.line4("sxth ", d, ", ", ws)
            .loads:
                if d != ws:
                    try self.line4("fmov ", d, ", ", ws)
            _:
                if d != xs:
                    try self.line4("fmov ", d, ", ", xs)

    ## A store into a promoted slot: the value's register `v` moves in.
    mutating func store_promoted(op: ir.Op, k: u32, v: str) -> !:
        let code = (usize)self.slot_regs.get((usize)k - 1)
        match op:
            .storel:
                if v != x_names[code]:
                    try self.line4("mov ", x_names[code], ", ", v)
            .stores:
                if v != w_names[code]:
                    try self.line4("fmov ", w_names[code], ", ", v)
            .storehf:
                if v != h_names[code]:
                    try self.line4("fmov ", h_names[code], ", ", v)
            .stored:
                if v != x_names[code]:
                    try self.line4("fmov ", x_names[code], ", ", v)
            _:
                if v != w_names[code]:
                    try self.line4("mov ", w_names[code], ", ", v)

    mutating func line2(a: str, b: str) -> !:
        try self.line(a)
        try self.put(b)

    mutating func line3(a: str, b: str, c: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)

    mutating func line4(a: str, b: str, c: str, d: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)
        try self.put(d)

    mutating func line5(a: str, b: str, c: str, d: str, e: str) -> !:
        try self.line(a)
        try self.put(b)
        try self.put(c)
        try self.put(d)
        try self.put(e)

    ## `.weak_definition` and `.no_dead_strip` for a symbol with those attributes (§9.8).
    mutating func linkage_directives(name: str, weak: bool, used: bool) -> !:
        if weak:
            try self.put("    .weak_definition ")
            try self.symbol(name)
            try self.put("\n")
        if used:
            try self.put("    .no_dead_strip ")
            try self.symbol(name)
            try self.put("\n")

    ## Back to the text section after a function placed in a named one.
    mutating func leave_section() -> !:
        if self.f.section.length > 0:
            try self.put("\n    .section __TEXT,__text,regular,pure_instructions\n")

    ## A temporary reference used at instruction `ix` extends its live range.
    func note_use(r: ir.Ref, last_use: u32[], ix: u32):
        if r.kind == ir.RefKind.temp and (usize)r.index <= last_use.length:
            if last_use[(usize)r.index - 1] < ix:
                last_use[(usize)r.index - 1] = ix

    ## Split the callee-saved registers between promoted slots and temporaries: the
    ## temporaries keep as many as they can use at once, up to four of each class, and the
    ## most-used frame slots take the rest of the ten integer and eight float registers.
    mutating func plan_registers() -> !:
        let nt = self.f.temps.count
        var def_at = try alloc u32[nt if nt > 0 else 1] in memory.heap
        defer free(def_at) in memory.heap
        var last_use = try alloc u32[nt if nt > 0 else 1] in memory.heap
        defer free(last_use) in memory.heap
        try self.live_ranges(def_at, last_use)
        let (ints, floats) = try self.pressure(def_at, last_use)
        try self.promote(slot_budget(ints, 10), slot_budget(floats, 8))
        try self.allocate(def_at, last_use)

    mutating func function(index: usize) -> !:
        self.index = index
        self.f = &self.program_unit.functions.items[index]
        try self.plan_registers()
        try self.layout()
        if self.f.section.length > 0:
            try self.put("\n    .section ")
            try self.put(self.f.section)
        try self.put("\n    .p2align 2\n")
        try self.put("    .globl ")
        try self.symbol(self.f.name)
        try self.put("\n")
        try self.linkage_directives(self.f.name, self.f.weak, self.f.used)
        try self.symbol(self.f.name)
        try self.put(":")
        if self.f.naked:
            # the body is asm blocks only (§9.8): no frame, no prologue, nothing after
            var k: usize = 0
            while k < self.f.instrs.count:
                try self.instruction(self.f.instrs.get(k))
                k += 1
            try self.leave_section()
            return
        try self.line("stp x29, x30, [sp, #-16]!")
        try self.line("mov x29, sp")
        if self.frame <= 4095:
            try self.line("sub sp, sp, #")
            try self.put_u64(self.frame)
        else:
            try self.load_immediate("x16", (i64)self.frame)
            try self.line("sub sp, sp, x16")
        if self.f.has_result and self.f.result_size > 16 and not self.f.result_float_only:
            try self.frame_address("x16", self.indirect_home)
            try self.line("str x8, [x16]")
        try self.save_callee_saved()
        try self.receive_params()
        var i: usize = 0
        while i < self.f.instrs.count:
            try self.instruction(self.f.instrs.get(i))
            i += 1
        try self.put("\n")
        if self.f.debug:
            try self.describe_frame()

    ## `lbd_<name>`: the function's name and source, then each named local's name, type
    ## spelling, distance below the frame pointer, and size; every text is a `str`.
    mutating func describe_frame() -> !:
        var d = &self.descriptors
        try d.put("    .globl _lbd_")
        try d.put(self.f.name)
        try d.put("\n_lbd_")
        try d.put(self.f.name)
        try d.put(":\n")
        try self.describe_text(self.f.name)
        try self.describe_text(self.f.source)
        try d.put("    .quad ")
        try d.put_u64((u64)self.f.locals.count)
        try d.put("\n")
        var i: usize = 0
        while i < self.f.locals.count:
            let local = self.f.locals.get(i)
            try self.describe_text(local.name)
            try self.describe_text(local.kind)
            try d.put("    .quad ")
            try d.put_u64(self.slot_home(local.slot))
            try d.put(", ")
            try d.put_u64((u64)local.size)
            try d.put("\n")
            i += 1

    mutating func describe_text(text: str) -> !:
        let index = try self.program_unit.text(text)
        var d = &self.descriptors
        try d.put("    .quad l_text_")
        try d.put_u64((u64)index)
        try d.put(", ")
        try d.put_u64((u64)text.length)
        try d.put("\n")

    ## Store the incoming arguments into their slots.
    mutating func receive_params() -> !:
        var next_int: u32 = 0
        var next_float: u32 = 0
        var stack_offset: u64 = 16
        var i: usize = 0
        while i < self.f.params.count:
            let p = self.f.params.get(i)
            let home = self.slot_home(p.slot)
            if p.size == 0:
                # a scalar; a promoted slot takes the value in its register
                let code = (usize)self.slot_regs.get((usize)p.slot)
                if ir.is_float_class(p.cls):
                    if next_float < 8:
                        if code != 0:
                            try self.line("fmov ")
                            try self.put(class_name((u8)code, p.cls))
                            try self.put(", ")
                        else:
                            try self.frame_address("x16", home)
                            try self.line("str ")
                        try self.put(float_letter(p.cls))
                        try self.put_u64((u64)next_float)
                        if code == 0:
                            try self.put(", [x16]")
                        next_float += 1
                    else:
                        try self.line("ldr x9, [x29, #")
                        try self.put_u64(stack_offset)
                        try self.put("]")
                        if code != 0:
                            try self.line3("fmov ", x_names[code], ", x9")
                        else:
                            try self.frame_address("x16", home)
                            try self.line("str x9, [x16]")
                        stack_offset += 8
                elif next_int < 8:
                    if code != 0:
                        try self.line("mov ")
                        try self.put(w_names[code] if p.cls == ir.Class.w else x_names[code])
                        try self.put(", ")
                        try self.put("w" if p.cls == ir.Class.w else "x")
                        try self.put_u64((u64)next_int)
                    else:
                        try self.frame_address("x16", home)
                        try self.line("str w" if p.cls == ir.Class.w else "str x")
                        try self.put_u64((u64)next_int)
                        try self.put(", [x16]")
                    next_int += 1
                else:
                    try self.line("ldr x9, [x29, #")
                    try self.put_u64(stack_offset)
                    try self.put("]")
                    if code != 0:
                        try self.line3("mov ", w_names[code] if p.cls == ir.Class.w else x_names[code], ", w9" if p.cls == ir.Class.w else ", x9")
                    else:
                        try self.frame_address("x16", home)
                        try self.line("str w9, [x16]" if p.cls == ir.Class.w else "str x9, [x16]")
                    stack_offset += 8
            elif p.is_float_only and next_float + p.float_count <= 8:
                # a homogeneous float aggregate in d or s registers
                let each = (u64)p.size // (u64)p.float_count
                var k: u32 = 0
                while k < p.float_count:
                    try self.frame_address("x16", home)
                    try self.line("str ")
                    try self.put(float_letter_of(each))
                    try self.put_u64((u64)(next_float + k))
                    try self.put(", [x16, #")
                    try self.put_u64((u64)k * each)
                    try self.put("]")
                    k += 1
                next_float += p.float_count
            elif p.size <= 16:
                let words = (p.size + 7) // 8
                if next_int + words <= 8:
                    try self.frame_address("x16", home)
                    try self.line("str x")
                    try self.put_u64((u64)next_int)
                    try self.put(", [x16]")
                    if words == 2:
                        try self.line("str x")
                        try self.put_u64((u64)next_int + 1)
                        try self.put(", [x16, #8]")
                    next_int += words
                else:
                    next_int = 8
                    var k: u32 = 0
                    while k < words:
                        try self.line("ldr x9, [x29, #")
                        try self.put_u64(stack_offset)
                        try self.put("]")
                        try self.frame_address("x16", home)
                        try self.line("str x9, [x16, #")
                        try self.put_u64((u64)k * 8)
                        try self.put("]")
                        stack_offset += 8
                        k += 1
            else:
                # by reference: keep the address in the slot for now; the bytes are
                # copied in a second pass, after every register is safely stored
                if next_int < 8:
                    try self.frame_address("x16", home)
                    try self.line("str x")
                    try self.put_u64((u64)next_int)
                    try self.put(", [x16]")
                    next_int += 1
                else:
                    try self.line("ldr x9, [x29, #")
                    try self.put_u64(stack_offset)
                    try self.put("]")
                    try self.frame_address("x16", home)
                    try self.line("str x9, [x16]")
                    stack_offset += 8
            i += 1
        i = 0
        while i < self.f.params.count:
            let p = self.f.params.get(i)
            if p.size > 16 and not (p.is_float_only and p.float_count <= 8):
                let home = self.slot_home(p.slot)
                try self.frame_address("x0", home)
                try self.line("ldr x1, [x0]")
                try self.load_immediate("x2", (i64)p.size)
                try self.line("bl _memcpy")
            i += 1

    # mark: Instructions =======================================================================

    mutating func instruction(n: ir.Instr) -> !:
        match n.op:
            .label:
                try self.put("\n")
                try self.label_name(n.extra)
                try self.put(":")
            .jmp:
                try self.line("b ")
                try self.label_name(n.extra)
            .jnz:
                let c = try self.source(n.a, ir.Class.w, "w9")
                try self.line("cbnz ")
                try self.put(c)
                try self.put(", ")
                try self.label_name(n.extra)
                try self.line("b ")
                try self.label_name(n.extra2)
            .ret:
                try self.return_value(n)
            .copy:
                let v = try self.source(n.a, n.cls, self.reg(n.cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                if v != d:
                    try self.line("fmov " if ir.is_float_class(n.cls) else "mov ")
                    try self.put(d)
                    try self.put(", ")
                    try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .add, .sub, .mul, .sdiv, .udiv, .srem, .urem, .and_, .or_, .xor, .shl, .lshr, .ashr:
                try self.arithmetic(n)
            .neg:
                let v = try self.source(n.a, n.cls, self.reg(n.cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line("fneg " if ir.is_float_class(n.cls) else "neg ")
                try self.put(d)
                try self.put(", ")
                try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .ceq, .cne, .cslt, .csle, .csgt, .csge, .cult, .cule, .cugt, .cuge:
                try self.comparison(n)
            .loadsb, .loadub, .loadsh, .loaduh, .loadsw, .loaduw, .loadl, .loads, .loadd, .loadhf:
                let lc = load_class(n.op)
                let d = self.target(n.dst, lc, load_register(n.op))
                let from_slot = self.promoted_address(n.a)
                if from_slot != 0:
                    try self.load_promoted(n.op, from_slot, d)
                else:
                    try self.address_operand("x9", n.a)
                    try self.line(load_mnemonic(n.op))
                    try self.put(" ")
                    try self.put(d)
                    try self.put(", [x9]")
                try self.finish(n.dst, lc, d)
            .storeb, .storeh, .storew, .storel, .stores, .stored, .storehf:
                let cls = store_class(n.op)
                let v = try self.source(n.a, cls, self.reg(cls, 0))
                let to_slot = self.promoted_address(n.b)
                if to_slot != 0:
                    try self.store_promoted(n.op, to_slot, v)
                else:
                    try self.address_operand("x10", n.b)
                    try self.line(store_mnemonic(n.op))
                    try self.put(" ")
                    try self.put(v)
                    try self.put(", [x10]")
            .frame:
                let d = self.target(n.dst, ir.Class.l, "x9")
                try self.line("mov ")
                try self.put(d)
                try self.put(", x29")
                try self.finish(n.dst, ir.Class.l, d)
            .extsb, .extub, .extsh, .extuh, .extsw, .extuw:
                let v = try self.source(n.a, ir.Class.w, "w9")
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.extend_from(n.op, v, d)
                try self.finish(n.dst, n.cls, d)
            .exth, .exts, .truncs, .truncd:
                let src_cls = float_source_class(n.op)
                let v = try self.source(n.a, src_cls, self.reg(src_cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line3("fcvt ", d, ", ")
                try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .stosi, .stoui, .dtosi, .dtoui:
                let src_cls = ir.Class.s if n.op == ir.Op.stosi or n.op == ir.Op.stoui else ir.Class.d
                let v = try self.source(n.a, src_cls, self.reg(src_cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line3("fcvtzs " if n.op == ir.Op.stosi or n.op == ir.Op.dtosi else "fcvtzu ", d, ", ")
                try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .swtof, .uwtof, .sltof, .ultof:
                let src_cls = ir.Class.w if n.op == ir.Op.swtof or n.op == ir.Op.uwtof else ir.Class.l
                let v = try self.source(n.a, src_cls, self.reg(src_cls, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line3("scvtf " if n.op == ir.Op.swtof or n.op == ir.Op.sltof else "ucvtf ", d, ", ")
                try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .cast:
                # bits move between an integer and a float of the same width
                let other = cast_partner(n.cls)
                let v = try self.source(n.a, other, self.reg(other, 0))
                let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
                try self.line3("fmov ", d, ", ")
                try self.put(v)
                try self.finish(n.dst, n.cls, d)
            .addr:
                if self.promoted_slot(n.dst) == 0:
                    let d = self.target(n.dst, ir.Class.l, "x9")
                    try self.address_operand(d, n.a)
                    try self.finish(n.dst, ir.Class.l, d)
            .addr_tls:
                try self.line("adrp x0, ")
                try self.symbol(n.a.name)
                try self.put("@TLVPPAGE")
                try self.line("ldr x0, [x0, ")
                try self.symbol(n.a.name)
                try self.put("@TLVPPAGEOFF]")
                try self.line("ldr x16, [x0]")
                try self.line("blr x16")
                try self.store_temp("x0", n.dst)
            .blit:
                if n.extra <= 128:
                    # a record copy: loads and stores in place of a call
                    try self.address_operand("x10", n.b)
                    try self.address_operand("x11", n.a)
                    try self.inline_copy((u64)n.extra)
                else:
                    try self.address_operand("x0", n.a)
                    try self.address_operand("x1", n.b)
                    try self.load_immediate("x2", (i64)n.extra)
                    try self.line("bl _memcpy")
            .zero:
                if n.extra <= 128:
                    try self.address_operand("x11", n.a)
                    try self.inline_zero((u64)n.extra)
                else:
                    try self.address_operand("x0", n.a)
                    try self.line("mov x1, #0")
                    try self.load_immediate("x2", (i64)n.extra)
                    try self.line("bl _memset")
            .fill:
                try self.address_operand("x0", n.a)
                try self.load_immediate("x1", n.b.value)
                try self.load_immediate("x2", (i64)n.extra)
                try self.line("bl _memset")
            .call:
                try self.call(n)
            .trap_:
                try self.address_operand("x0", n.a)
                try self.line("bl _lb_core_trap")
            .bounds:
                let a = try self.source(n.a, ir.Class.l, "x9")
                let b = try self.source(n.b, ir.Class.l, "x10")
                try self.line3("cmp ", a, ", ")
                try self.put(b)
                try self.line("b.lo 1f")
                try self.trap_text("index out of bounds")
                try self.put("\n1:")
            .addo, .subo, .mulo:
                try self.checked(n)
            .asm_:
                try self.inline_asm(n)
            .set_reg:
                # move an input operand into the exact register the asm block names
                let reg = self.program_unit.texts.get((usize)n.b.index).bytes
                try self.operand(reg, n.cls, n.a)
            .get_reg:
                # store the register the asm block left back into the output place
                let reg = self.program_unit.texts.get((usize)n.b.index).bytes
                try self.address_operand("x16", n.a)
                try self.line(store_mnemonic_for(n.cls))
                try self.put(" ")
                try self.put(reg)
                try self.put(", [x16]")
            .atomic_load:
                try self.address_operand("x9", n.a)
                try self.line("ldar" if n.extra2 >= 2 else "ldr")
                try self.put(width_suffix(n.extra))
                try self.put(" ")
                try self.put(self.reg(ir.Class.w if n.extra <= 4 else ir.Class.l, 0))
                try self.put(", [x9]")
                try self.store_temp(self.reg(n.cls, 0), n.dst)
            .atomic_store:
                let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
                try self.operand(self.reg(cls, 0), cls, n.a)
                try self.address_operand("x10", n.b)
                try self.line("stlr" if n.extra2 >= 3 else "str")
                try self.put(width_suffix(n.extra))
                try self.put(" ")
                try self.put(self.reg(cls, 0))
                try self.put(", [x10]")
            .atomic_add, .atomic_sub, .atomic_or, .atomic_and_not, .atomic_xor, .atomic_swap, .atomic_max, .atomic_min:
                try self.read_modify_write(n)
            .atomic_cas:
                try self.compare_and_swap(n)
            .fence:
                try self.line("dmb ish")
            _:
                error(failed, "an instruction the arm64 generator does not know")

    mutating func arithmetic(n: ir.Instr) -> !:
        let a = try self.source(n.a, n.cls, self.reg(n.cls, 0))
        let b = try self.source(n.b, n.cls, self.reg(n.cls, 1))
        let d = self.target(n.dst, n.cls, self.reg(n.cls, 0))
        let is_float = ir.is_float_class(n.cls)
        var mnemonic = "add"
        match n.op:
            .add: mnemonic = "fadd" if is_float else "add"
            .sub: mnemonic = "fsub" if is_float else "sub"
            .mul: mnemonic = "fmul" if is_float else "mul"
            .sdiv: mnemonic = "fdiv" if is_float else "sdiv"
            .udiv: mnemonic = "udiv"
            .and_: mnemonic = "and"
            .or_: mnemonic = "orr"
            .xor: mnemonic = "eor"
            .shl: mnemonic = "lsl"
            .lshr: mnemonic = "lsr"
            .ashr: mnemonic = "asr"
            .srem, .urem:
                try self.line("sdiv " if n.op == ir.Op.srem else "udiv ")
                try self.put(self.reg(n.cls, 2))
                try self.put(", ")
                try self.put(a)
                try self.put(", ")
                try self.put(b)
                try self.line("msub ")
                try self.put(d)
                try self.put(", ")
                try self.put(self.reg(n.cls, 2))
                try self.put(", ")
                try self.put(b)
                try self.put(", ")
                try self.put(a)
                try self.finish(n.dst, n.cls, d)
                return
            _: mnemonic = "add"
        try self.line(mnemonic)
        try self.put(" ")
        try self.put(d)
        try self.put(", ")
        try self.put(a)
        try self.put(", ")
        try self.put(b)
        try self.finish(n.dst, n.cls, d)

    mutating func comparison(n: ir.Instr) -> !:
        let a = try self.source(n.a, n.cls, self.reg(n.cls, 0))
        let b = try self.source(n.b, n.cls, self.reg(n.cls, 1))
        let is_float = ir.is_float_class(n.cls)
        try self.line("fcmp " if is_float else "cmp ")
        try self.put(a)
        try self.put(", ")
        try self.put(b)
        var cond = "eq"
        match n.op:
            .ceq: cond = "eq"
            .cne: cond = "ne"
            .cslt: cond = "mi" if is_float else "lt"
            .csle: cond = "ls" if is_float else "le"
            .csgt: cond = "gt"
            .csge: cond = "ge"
            .cult: cond = "lo"
            .cule: cond = "ls"
            .cugt: cond = "hi"
            .cuge: cond = "hs"
            _: cond = "eq"
        let d = self.target(n.dst, ir.Class.w, "w9")
        try self.line3("cset ", d, ", ")
        try self.put(cond)
        try self.finish(n.dst, ir.Class.w, d)

    ## `op` applied to the 32-bit view `v` of a value, into `d`.
    mutating func extend_from(op: ir.Op, v: str, d: str) -> !:
        match op:
            .extsb: try self.line4("sxtb ", d, ", ", v)
            .extub: try self.line5("and ", d, ", ", v, ", #255")
            .extsh: try self.line4("sxth ", d, ", ", v)
            .extuh: try self.line5("and ", d, ", ", v, ", #65535")
            .extsw: try self.line4("sxtw ", d, ", ", v)
            _:
                # zero-extension of a word: writing the 32-bit view clears the upper half
                let dw = narrow_name(d)
                if dw != v:
                    try self.line4("mov ", dw, ", ", v)

    ## Checked add, subtract, and multiply: trap on overflow of the class width.
    mutating func checked(n: ir.Instr) -> !:
        let signed = n.extra == 1
        let a = self.reg(n.cls, 0)
        let b = self.reg(n.cls, 1)
        try self.operand(a, n.cls, n.a)
        try self.operand(b, n.cls, n.b)
        if n.op == ir.Op.mulo:
            if n.cls == ir.Class.w:
                # multiply at 64 bits and check the range
                if signed:
                    try self.line("sxtw x9, w9")
                    try self.line("sxtw x10, w10")
                    try self.line("mul x9, x9, x10")
                    try self.line("cmp x9, w9, sxtw")
                else:
                    try self.line("mov w9, w9")
                    try self.line("mov w10, w10")
                    try self.line("mul x9, x9, x10")
                    try self.line("cmp x9, w9, uxtw")
                try self.line("b.eq 1f")
            else:
                if signed:
                    try self.line("smulh x11, x9, x10")
                    try self.line("mul x9, x9, x10")
                    try self.line("cmp x11, x9, asr #63")
                    try self.line("b.eq 1f")
                else:
                    try self.line("umulh x11, x9, x10")
                    try self.line("mul x9, x9, x10")
                    try self.line("cbz x11, 1f")
            try self.trap_text("integer overflow")
            try self.put("\n1:")
            try self.store_temp(a, n.dst)
            return
        let add = n.op == ir.Op.addo
        try self.line("adds " if add else "subs ")
        try self.put(a)
        try self.put(", ")
        try self.put(a)
        try self.put(", ")
        try self.put(b)
        if signed:
            try self.line("b.vc 1f")
        elif add:
            try self.line("b.cc 1f")
        else:
            try self.line("b.cs 1f")
        try self.trap_text("integer overflow")
        try self.put("\n1:")
        try self.store_temp(a, n.dst)

    mutating func trap_text(reason: str) -> !:
        let index = try self.program_unit.text(reason)
        try self.address_operand("x0", ir.text_ref(index))
        try self.line("bl _lb_core_trap")

    mutating func inline_asm(n: ir.Instr) -> !:
        let arch = self.program_unit.texts.get((usize)n.a.index).bytes
        if arch != "arm64":
            return
        let body = self.program_unit.texts.get((usize)n.b.index).bytes
        try self.put("\n")
        try self.put(body)

    mutating func read_modify_write(n: ir.Instr) -> !:
        let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
        let value = self.reg(cls, 1)
        try self.operand(value, cls, n.a)
        try self.address_operand("x12", n.b)
        let acquire = n.extra2 == 2 or n.extra2 == 4 or n.extra2 == 5
        let release = n.extra2 >= 3
        try self.put("\n1:")
        try self.line("ldaxr" if acquire else "ldxr")
        try self.put(width_suffix(n.extra))
        try self.put(" ")
        try self.put(self.reg(cls, 0))
        try self.put(", [x12]")
        let old = self.reg(cls, 0)
        let fresh = self.reg(cls, 2)
        match n.op:
            .atomic_add:
                try self.line("add ")
            .atomic_sub:
                try self.line("sub ")
            .atomic_or:
                try self.line("orr ")
            .atomic_and_not:
                try self.line("bic ")
            .atomic_xor:
                try self.line("eor ")
            .atomic_swap:
                try self.line("mov ")
            .atomic_max:
                try self.line("cmp ")
                try self.put(old)
                try self.put(", ")
                try self.put(value)
                try self.line("csel ")
                try self.put(fresh)
                try self.put(", ")
                try self.put(old)
                try self.put(", ")
                try self.put(value)
                try self.put(", ge")
            .atomic_min:
                try self.line("cmp ")
                try self.put(old)
                try self.put(", ")
                try self.put(value)
                try self.line("csel ")
                try self.put(fresh)
                try self.put(", ")
                try self.put(old)
                try self.put(", ")
                try self.put(value)
                try self.put(", le")
            _:
                try self.line("mov ")
        if n.op != ir.Op.atomic_max and n.op != ir.Op.atomic_min:
            try self.put(fresh)
            try self.put(", ")
            if n.op != ir.Op.atomic_swap:
                try self.put(old)
                try self.put(", ")
            try self.put(value)
        try self.line("stlxr" if release else "stxr")
        try self.put(width_suffix(n.extra))
        try self.put(" w13, ")
        try self.put(fresh)
        try self.put(", [x12]")
        try self.line("cbnz w13, 1b")
        try self.store_temp(old, n.dst)

    mutating func compare_and_swap(n: ir.Instr) -> !:
        let cls = ir.Class.w if n.extra <= 4 else ir.Class.l
        let expected = self.f.args.get((usize)n.b.value)
        let desired = self.f.args.get((usize)n.b.value + 1)
        try self.operand(self.reg(cls, 1), cls, expected.value)
        try self.operand(self.reg(cls, 2), cls, desired.value)
        try self.address_operand("x12", n.a)
        try self.put("\n1:")
        try self.line("ldaxr")
        try self.put(width_suffix(n.extra))
        try self.put(" ")
        try self.put(self.reg(cls, 0))
        try self.put(", [x12]")
        try self.line("cmp ")
        try self.put(self.reg(cls, 0))
        try self.put(", ")
        try self.put(self.reg(cls, 1))
        try self.line("b.ne 2f")
        try self.line("stlxr")
        try self.put(width_suffix(n.extra))
        try self.put(" w13, ")
        try self.put(self.reg(cls, 2))
        try self.put(", [x12]")
        try self.line("cbnz w13, 1b")
        try self.put("\n2:")
        try self.line("clrex")
        try self.store_temp(self.reg(cls, 0), n.dst)

    # mark: Calls ==============================================================================

    ## Classify one argument under the Apple convention, advancing the counters.
    func place(a: ir.Arg, next_int: u32*, next_float: u32*, stack: u32*) -> ArgPlacement:
        if a.size == 0:
            if ir.is_float_class(a.cls):
                if *next_float < 8:
                    let p = ArgPlacement(where = 1, first = *next_float, count = 1, stack_offset = 0)
                    *next_float += 1
                    return p
                let p = ArgPlacement(where = 2, first = 0, count = 1, stack_offset = *stack)
                *stack += 8
                return p
            if *next_int < 8:
                let p = ArgPlacement(where = 0, first = *next_int, count = 1, stack_offset = 0)
                *next_int += 1
                return p
            let p = ArgPlacement(where = 2, first = 0, count = 1, stack_offset = *stack)
            *stack += 8
            return p
        if a.is_float_only and *next_float + a.float_count <= 8:
            let p = ArgPlacement(where = 1, first = *next_float, count = a.float_count, stack_offset = 0)
            *next_float += a.float_count
            return p
        if a.size <= 16:
            let words = (a.size + 7) // 8
            if *next_int + words <= 8:
                let p = ArgPlacement(where = 0, first = *next_int, count = words, stack_offset = 0)
                *next_int += words
                return p
            *next_int = 8
            let p = ArgPlacement(where = 2, first = 0, count = words, stack_offset = *stack)
            *stack += words * 8
            return p
        if *next_int < 8:
            let p = ArgPlacement(where = 3, first = *next_int, count = 1, stack_offset = 0)
            *next_int += 1
            return p
        let p = ArgPlacement(where = 2, first = 0, count = 1, stack_offset = *stack)
        *stack += 8
        return p

    mutating func call(n: ir.Instr) -> !:
        let info = self.f.calls.get((usize)n.extra)
        # first pass: sizes of the stack area
        var next_int: u32 = 0
        var next_float: u32 = 0
        var stack: u32 = 0
        var placements: ArgPlacement[32] = ---
        var i: u32 = 0
        while i < info.args_count and i < 32:
            let a = self.f.args.get((usize)(info.args_start + i))
            if info.variadic and i >= info.fixed_count:
                # Apple passes every variadic argument on the stack, eight bytes each
                placements[i] = ArgPlacement(where = 2, first = 0, count = 1, stack_offset = stack)
                stack += 8
            else:
                placements[i] = self.place(a, &next_int, &next_float, &stack)
            i += 1
        let area = (u64)arm_round_up((u64)stack, 16)
        if area > 0:
            try self.load_immediate("x16", (i64)area)
            try self.line("sub sp, sp, x16")
            self.sp_shift += area
        # the callee's address first, kept in a slot-free register the arguments do not touch
        var through_register = false
        if n.a.kind == ir.RefKind.temp:
            through_register = true
            try self.load_temp("x17", ir.Class.l, n.a.index)
            try self.line("str x17, [sp, #-16]!")
            self.sp_shift += 16
        # stack arguments
        i = 0
        while i < info.args_count and i < 32:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 2:
                let base_offset = (u64)p.stack_offset + (16 if through_register else 0)
                if a.size == 0:
                    try self.operand(self.reg(a.cls, 0), a.cls, a.value)
                    try self.line("str ")
                    try self.put(self.wide(a.cls, 0))
                    try self.put(", [sp, #")
                    try self.put_u64(base_offset)
                    try self.put("]")
                elif a.size <= 16:
                    try self.address_operand("x9", a.value)
                    try self.line("ldr x10, [x9]")
                    try self.line("str x10, [sp, #")
                    try self.put_u64(base_offset)
                    try self.put("]")
                    if a.size > 8:
                        try self.line("ldr x10, [x9, #8]")
                        try self.line("str x10, [sp, #")
                        try self.put_u64(base_offset + 8)
                        try self.put("]")
                else:
                    try self.address_operand("x9", a.value)
                    try self.line("str x9, [sp, #")
                    try self.put_u64(base_offset)
                    try self.put("]")
            i += 1
        # register arguments, floats first so integer scratch stays free
        i = 0
        while i < info.args_count and i < 32:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 1:
                if a.size == 0:
                    try self.operand(self.reg(a.cls, 0), a.cls, a.value)
                    try self.line("fmov ")
                    try self.put(float_letter(a.cls))
                    try self.put_u64((u64)p.first)
                    try self.put(", ")
                    try self.put(self.reg(a.cls, 0))
                else:
                    try self.address_operand("x9", a.value)
                    let each = (u64)a.size // (u64)a.float_count
                    var k: u32 = 0
                    while k < p.count:
                        try self.line("ldr ")
                        try self.put(float_letter_of(each))
                        try self.put_u64((u64)(p.first + k))
                        try self.put(", [x9, #")
                        try self.put_u64((u64)k * each)
                        try self.put("]")
                        k += 1
            i += 1
        i = 0
        while i < info.args_count and i < 32:
            let a = self.f.args.get((usize)(info.args_start + i))
            let p = placements[i]
            if p.where == 0:
                if a.size == 0:
                    try self.operand(arg_register(p.first), ir.Class.l, a.value)
                else:
                    try self.address_operand("x9", a.value)
                    try self.line("ldr x")
                    try self.put_u64((u64)p.first)
                    try self.put(", [x9]")
                    if p.count == 2:
                        try self.line("ldr x" if a.size > 12 else "ldr w")
                        try self.put_u64((u64)p.first + 1)
                        try self.put(", [x9, #8]")
            elif p.where == 3:
                try self.address_operand("x9", a.value)
                try self.line("mov x")
                try self.put_u64((u64)p.first)
                try self.put(", x9")
            i += 1
        # a large aggregate result arrives through x8
        if info.has_result and info.result_size > 16 and not info.result_float_only:
            try self.frame_address("x8", self.slot_home(info.result_slot))
        if through_register:
            try self.line("ldr x17, [sp], #16")
            self.sp_shift -= 16
            try self.line("blr x17")
        else:
            try self.line("bl ")
            try self.symbol(n.a.name)
        if area > 0:
            try self.load_immediate("x16", (i64)area)
            try self.line("add sp, sp, x16")
            self.sp_shift -= area
        # the result
        if not info.has_result:
            return
        if info.result_size == 0:
            if info.result_cls == ir.Class.s:
                try self.store_temp("s0", n.dst)
            elif info.result_cls == ir.Class.h:
                try self.store_temp("h0", n.dst)
            elif info.result_cls == ir.Class.d:
                try self.store_temp("d0", n.dst)
            elif info.result_cls == ir.Class.w:
                try self.store_temp("w0", n.dst)
            else:
                try self.store_temp("x0", n.dst)
            return
        let home = self.slot_home(info.result_slot)
        if info.result_float_only:
            let each = (u64)info.result_size // (u64)info.result_float_count
            var k: u32 = 0
            while k < info.result_float_count:
                try self.frame_address("x16", home)
                try self.line("str ")
                try self.put(float_letter_of(each))
                try self.put_u64((u64)k)
                try self.put(", [x16, #")
                try self.put_u64((u64)k * each)
                try self.put("]")
                k += 1
            return
        if info.result_size <= 16:
            # the second word is stored only as far as the value reaches, so a slot of
            # twelve bytes does not lose its neighbour
            try self.frame_address("x16", home)
            try self.line("str x0, [x16]")
            if info.result_size > 12:
                try self.line("str x1, [x16, #8]")
            elif info.result_size > 8:
                try self.line("str w1, [x16, #8]")

    ## The wide name of a class's first scratch register for a stack store.
    func wide(cls: ir.Class, n: u32) -> str:
        if cls == ir.Class.w:
            return "x9" if n == 0 else "x10"
        if cls == ir.Class.s or cls == ir.Class.h:
            return "d16" if n == 0 else "d17"
        return self.reg(cls, n)

    mutating func return_value(n: ir.Instr) -> !:
        if self.f.has_result:
            if self.f.result_size == 0:
                if self.f.result_cls == ir.Class.s:
                    try self.operand("s16", ir.Class.s, n.a)
                    try self.line("fmov s0, s16")
                elif self.f.result_cls == ir.Class.h:
                    try self.operand("h16", ir.Class.h, n.a)
                    try self.line("fmov h0, h16")
                elif self.f.result_cls == ir.Class.d:
                    try self.operand("d16", ir.Class.d, n.a)
                    try self.line("fmov d0, d16")
                else:
                    try self.operand("x9", ir.Class.l, n.a)
                    try self.line("mov x0, x9")
            elif self.f.result_float_only:
                try self.address_operand("x9", n.a)
                let each = (u64)self.f.result_size // (u64)self.f.result_float_count
                var k: u32 = 0
                while k < self.f.result_float_count:
                    try self.line("ldr ")
                    try self.put(float_letter_of(each))
                    try self.put_u64((u64)k)
                    try self.put(", [x9, #")
                    try self.put_u64((u64)k * each)
                    try self.put("]")
                    k += 1
            elif self.f.result_size <= 16:
                try self.address_operand("x9", n.a)
                try self.line("ldr x0, [x9]")
                if self.f.result_size > 12:
                    try self.line("ldr x1, [x9, #8]")
                elif self.f.result_size > 8:
                    try self.line("ldr w1, [x9, #8]")
            else:
                try self.address_operand("x1", n.a)
                try self.frame_address("x16", self.indirect_home)
                try self.line("ldr x0, [x16]")
                try self.load_immediate("x2", (i64)self.f.result_size)
                try self.line("bl _memcpy")
                try self.frame_address("x16", self.indirect_home)
                try self.line("ldr x0, [x16]")
        try self.restore_callee_saved()
        try self.line("mov sp, x29")
        try self.line("ldp x29, x30, [sp], #16")
        try self.line("ret")

    ## Save every callee-saved register the allocator used, on entry.
    mutating func save_callee_saved() -> !:
        var c: usize = 1
        while c <= 18:
            if (self.used_mask & (u32)(1 << (u32)(c - 1))) != 0:
                try self.frame_store(save_name(c), self.save_offset[c])
            c += 1

    ## Restore them before returning; the result already sits in x0/x1/d0.
    mutating func restore_callee_saved() -> !:
        var c: usize = 1
        while c <= 18:
            if (self.used_mask & (u32)(1 << (u32)(c - 1))) != 0:
                try self.frame_load(save_name(c), self.save_offset[c])
            c += 1

    # mark: The unit ===========================================================================

    pub mutating func generate() -> !:
        try self.put("    .section __TEXT,__text,regular,pure_instructions\n")
        var i: usize = 0
        while i < self.program_unit.functions.count:
            try self.function(i)
            i += 1
        # module-level asm blocks, verbatim, in the text section (§8.9)
        i = 0
        while i < self.program_unit.module_asm.count:
            try self.put("\n")
            try self.put(self.program_unit.module_asm.get(i).bytes)
            i += 1
        # text literals
        try self.put("\n    .section __TEXT,__cstring,cstring_literals\n")
        i = 0
        while i < self.program_unit.texts.count:
            try self.text_label(u32(i))
            try self.put(":\n    .asciz ")
            try self.c_string(self.program_unit.texts.get(i).bytes)
            try self.put("\n")
            i += 1
        # witness tables
        try self.put("\n    .section __DATA,__const\n    .p2align 3\n")
        i = 0
        while i < self.program_unit.tables.count:
            let t = self.program_unit.tables.get(i)
            try self.put("    .globl ")
            try self.symbol(t.name)
            try self.put("\n")
            try self.symbol(t.name)
            try self.put(":\n")
            var k: usize = 0
            while k < t.entries.count:
                let entry = t.entries.get(k)
                try self.put("    .quad ")
                if entry.length == 0:
                    try self.put("0")
                else:
                    try self.symbol(entry)
                try self.put("\n")
                k += 1
            i += 1
        # frame descriptors, when `--debug` asked for them
        if self.descriptors.used > 0:
            try self.put(self.descriptors.view())
        # globals
        i = 0
        while i < self.program_unit.globals.count:
            let g = self.program_unit.globals.get(i)
            if g.is_thread_local:
                try self.put("\n    .section __DATA,__thread_bss,thread_local_zerofill\n    .p2align 4\n")
                try self.symbol(g.name)
                try self.put("$tlv$init:\n    .space ")
                try self.put_u64((u64)g.size if g.size > 0 else 1)
                try self.put("\n    .section __DATA,__thread_vars,thread_local_variables\n    .globl ")
                try self.symbol(g.name)
                try self.put("\n")
                try self.symbol(g.name)
                try self.put(":\n    .quad __tlv_bootstrap\n    .quad 0\n    .quad ")
                try self.symbol(g.name)
                try self.put("$tlv$init\n")
            elif g.section.length > 0:
                # a named section: laid out as zeroed space where the program asked
                try self.put("\n    .section ")
                try self.put(g.section)
                try self.put("\n    .p2align ")
                try self.put_u64(log2((u64)g.align if g.align > 0 else 1))
                try self.put("\n    .globl ")
                try self.symbol(g.name)
                try self.put("\n")
                try self.linkage_directives(g.name, g.weak, g.used)
                try self.symbol(g.name)
                try self.put(":\n    .space ")
                try self.put_u64((u64)g.size if g.size > 0 else 1)
                try self.put("\n")
            else:
                try self.put("    .globl ")
                try self.symbol(g.name)
                try self.put("\n")
                try self.linkage_directives(g.name, g.weak, g.used)
                try self.put("    .zerofill __DATA,__bss,")
                try self.symbol(g.name)
                try self.put(",")
                try self.put_u64((u64)g.size if g.size > 0 else 1)
                try self.put(",")
                try self.put_u64(log2((u64)g.align if g.align > 0 else 1))
                try self.put("\n")
            i += 1
        try self.put("\n")

    mutating func c_string(text: str) -> !:
        try self.put("\"")
        for b in text.bytes:
            if b == '\\' or b == '"':
                try self.put("\\")
                try self.out.put_byte(b)
            elif b == '\n':
                try self.put("\\n")
            elif b == '\t':
                try self.put("\\t")
            elif b < 32 or b >= 127:
                try self.put("\\")
                try self.out.put_byte('0' + (b >> 6))
                try self.out.put_byte('0' + ((b >> 3) & 7))
                try self.out.put_byte('0' + (b & 7))
            else:
                try self.out.put_byte(b)
        try self.put("\"")

# mark: Helpers ================================================================================

## How many of a class's `pool` callee-saved registers the promoted slots may take when the
## temporaries need `pressure` at once: the temporaries keep up to four.
func slot_budget(pressure: u32, pool: u32) -> u8:
    return (u8)(pool - (pressure if pressure < 4 else 4))

## The callee-saved registers the allocator hands out: codes 1..10 are x19..x28, codes
## 11..18 are d8..d15, viewed as w/s where a narrower access asks for it.
let x_names: str[19] = ["", "x19", "x20", "x21", "x22", "x23", "x24", "x25", "x26", "x27", "x28", "d8", "d9", "d10", "d11", "d12", "d13", "d14", "d15"]
let w_names: str[19] = ["", "w19", "w20", "w21", "w22", "w23", "w24", "w25", "w26", "w27", "w28", "s8", "s9", "s10", "s11", "s12", "s13", "s14", "s15"]
let h_names: str[19] = ["", "w19", "w20", "w21", "w22", "w23", "w24", "w25", "w26", "w27", "w28", "h8", "h9", "h10", "h11", "h12", "h13", "h14", "h15"]

## The 8-byte name used to spill and reload a register on entry and exit.
func save_name(code: usize) -> str:
    return x_names[code]

## The bytes a load or store of register `reg` moves: 4 for `w` and `s` names, 8 otherwise.
func access_width_of(reg: str) -> u64:
    let first = reg.bytes[0]
    if first == 'h':
        return 2
    return 4 if first == 'w' or first == 's' else 8

## The single-precision view of a half scratch or result register, else the register itself.
func single_view(reg: str) -> str:
    if reg == "h0":
        return "s0"
    if reg == "h16":
        return "s16"
    if reg == "h17":
        return "s17"
    if reg == "h18":
        return "s18"
    return reg

## The register letter of a float class: `h`, `s`, or `d`.
func float_letter(cls: ir.Class) -> str:
    if cls == ir.Class.h:
        return "h"
    return "s" if cls == ir.Class.s else "d"

## The register letter of a float `size` bytes wide: a homogeneous aggregate's members.
func float_letter_of(size: u64) -> str:
    if size == 2:
        return "h"
    return "s" if size == 4 else "d"

## The class a float conversion reads: `exth` a half, `exts` and `truncs` a single, `truncd` a double.
func float_source_class(op: ir.Op) -> ir.Class:
    match op:
        .exth: return ir.Class.h
        .exts, .truncs: return ir.Class.s
        _: return ir.Class.d

## The class whose bits `cast` moves into `cls`: the integer as wide as a float, and back.
func cast_partner(cls: ir.Class) -> ir.Class:
    match cls:
        .h, .s: return ir.Class.w
        .d: return ir.Class.l
        .w: return ir.Class.s
        _: return ir.Class.d

func is_float_load(op: ir.Op) -> bool:
    return op == ir.Op.loads or op == ir.Op.loadd or op == ir.Op.loadhf

func is_float_store(op: ir.Op) -> bool:
    return op == ir.Op.stores or op == ir.Op.stored or op == ir.Op.storehf

let argument_names: str[8] = ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7"]

## The integer argument register `n` of the calling convention.
func arg_register(n: u32) -> str:
    return argument_names[(usize)n]

## Register code `code` viewed as class `cls`: `w`/`s` names for the narrow classes, `h` for a half.
func class_name(code: u8, cls: ir.Class) -> str:
    if cls == ir.Class.h:
        return h_names[(usize)code]
    if cls == ir.Class.w or cls == ir.Class.s:
        return w_names[(usize)code]
    return x_names[(usize)code]

## Register `code` in the form of `reg`: the narrow view for a `w` or `s` register, the half
## view for an `h` one, else the wide one.
func register_view(reg: str, code: u8) -> str:
    let letter = reg.bytes[0]
    if letter == 'h':
        return h_names[(usize)code]
    if letter == 'w' or letter == 's':
        return w_names[(usize)code]
    return x_names[(usize)code]

## `x21` -> `w21`, `x9` -> `w9`: the 32-bit view of an integer register.
func narrow_name(reg: str) -> str:
    if reg.bytes[0] != 'x':
        return reg
    var k: usize = 1
    while k <= 10:
        if x_names[k] == reg:
            return w_names[k]
        k += 1
    if reg == "x9":
        return "w9"
    if reg == "x10":
        return "w10"
    if reg == "x11":
        return "w11"
    return reg

## The class a load produces.
func load_class(op: ir.Op) -> ir.Class:
    match op:
        .loadsb, .loadub, .loadsh, .loaduh, .loaduw: return ir.Class.w
        .loadsw, .loadl: return ir.Class.l
        .loads: return ir.Class.s
        .loadhf: return ir.Class.h
        _: return ir.Class.d

## The store that writes a register of class `c` (an asm output back to its place).
## The bytes a load or store moves.
func access_width(op: ir.Op) -> u32:
    match op:
        .loadsb, .loadub, .storeb: return 1
        .loadsh, .loaduh, .storeh, .loadhf, .storehf: return 2
        .loadsw, .loaduw, .loads, .storew, .stores: return 4
        _: return 8

## A register-pool entry standing for "held by a promoted slot for the whole function".
let held: u32 = 4294967295

func store_mnemonic_for(c: ir.Class) -> str:
    return "str"

func is_int_class(c: ir.Class) -> bool:
    return c == ir.Class.w or c == ir.Class.l

func load_mnemonic(op: ir.Op) -> str:
    match op:
        .loadsb: return "ldrsb"
        .loadub: return "ldrb"
        .loadsh: return "ldrsh"
        .loaduh: return "ldrh"
        .loadsw: return "ldrsw"
        _: return "ldr"

func load_register(op: ir.Op) -> str:
    match op:
        .loadsb, .loadub, .loadsh, .loaduh, .loaduw: return "w9"
        .loadsw, .loadl: return "x9"
        .loads: return "s16"
        .loadhf: return "h16"
        _: return "d16"

func store_mnemonic(op: ir.Op) -> str:
    match op:
        .storeb: return "strb"
        .storeh: return "strh"
        _: return "str"

func store_class(op: ir.Op) -> ir.Class:
    match op:
        .storeb, .storeh, .storew: return ir.Class.w
        .stores: return ir.Class.s
        .stored: return ir.Class.d
        .storehf: return ir.Class.h
        _: return ir.Class.l

func width_suffix(width: u32) -> str:
    if width == 1:
        return "b"
    if width == 2:
        return "h"
    return ""

func arm_round_up(value: u64, align: u64) -> u64:
    if align <= 1:
        return value
    return (value + align - 1) // align * align

func log2(value: u64) -> u64:
    var n: u64 = 0
    var v = value
    while v > 1:
        v = v // 2
        n += 1
    return n

test "immediates and frame addresses assemble":
    var backing: u8[1048576]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var u = try ir.Unit.create()
        var g = try Generator.create(&u)
        try g.load_immediate("x9", 0)
        try g.load_immediate("x9", 70000)
        try g.load_immediate("x9", -5)
        try g.frame_address("x9", 5000)
        let text = g.text()
        assert(text.length > 0)
