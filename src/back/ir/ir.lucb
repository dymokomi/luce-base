#==============================================================================================
#
#   ir - The intermediate representation of the native backend
#
#   DESCRIPTION:
#       A small machine-neutral form between the checked tree and a target (base.md §19.1),
#       in the spirit of QBE: instructions over typed temporaries in four classes, `w` (32-bit
#       integer), `l` (64-bit integer or address), `s`, and `d`; stack slots for everything
#       that has an address; calls that carry enough about each argument for a target to
#       classify it. Aggregates never live in temporaries; they live in memory and are
#       moved by `blit`.
#
#       Temporaries are assigned once and used within the block that assigned them. A value
#       that must cross a block, the result of a conditional or a `match` expression, goes
#       through a slot. That keeps register allocation a per-block affair, with no dataflow
#       across the control flow graph.
#
#==============================================================================================

import memory
import support.list

# mark: Classes and references =================================================================

## The register class of a temporary.
pub enum Class as u8:
    w = 1
    l = 2
    s = 3
    d = 4
    ## a half-precision float, in the low half of a `v` register
    h = 5
    ## a vector of eight or sixteen bytes (§5.12), in a vector register; its lane shape is
    ## on the instruction (`lanes`)
    v = 6

## Whether `cls` lives in the float registers.
## The ten comparisons: their result is a word whatever they compare.
pub func is_comparison(op: Op) -> bool:
    return (u8)op >= (u8)Op.ceq and (u8)op <= (u8)Op.cuge

## Whether `cls` is a float or half-precision register class.
pub func is_float_class(cls: Class) -> bool:
    return cls == Class.s or cls == Class.d or cls == Class.h

## Whether `cls` is a vector register class.
pub func is_vector_class(cls: Class) -> bool:
    return cls == Class.v

## The lane shape of a vector instruction, in its `extra`: the lanes' width in bits, how
## many, and whether they are floats and signed. A vector is `lane_bits * lane_count / 8`
## bytes: eight or sixteen.
pub func lanes(bits: u32, count: u32, is_float: bool, signed: bool) -> u32:
    return bits | (count << 8) | ((1 if is_float else 0) << 16) | ((1 if signed else 0) << 17)

## The lanes' width in bits, from a vector shape.
pub func lane_bits(shape: u32) -> u32:
    return shape & 0xFF

## How many lanes a vector shape has.
pub func lane_count(shape: u32) -> u32:
    return (shape >> 8) & 0xFF

## Whether a vector shape's lanes are floats.
pub func lanes_float(shape: u32) -> bool:
    return (shape & (1 << 16)) != 0

## Whether a vector shape's lanes are signed.
pub func lanes_signed(shape: u32) -> bool:
    return (shape & (1 << 17)) != 0

## The total byte width of a vector shape, eight or sixteen.
pub func vector_bytes(shape: u32) -> u32:
    return lane_bits(shape) * lane_count(shape) // 8

## Whether `op` ends a basic block: control leaves through it, or never returns.
pub func is_terminator(op: Op) -> bool:
    return op == Op.jmp or op == Op.jnz or op == Op.switch_ or op == Op.ret or op == Op.trap_

## Whether `op` computes on vectors (§5.12), lane shape in `extra`.
pub func is_vector_op(op: Op) -> bool:
    return (u8)op >= (u8)Op.loadv and (u8)op <= (u8)Op.vsplat

## What an operand refers to.
pub enum RefKind as u8:
    none_ = 0
    temp = 1
    constant = 2
    slot = 3
    global = 4
    function = 5
    text = 6

## An operand: a temporary, a constant, the address of a slot, global, function, or text.
pub struct Ref:
    ## What the operand refers to.
    pub var kind: RefKind
    ## The temporary, slot, or text index; unused for the rest.
    pub var index: u32
    ## A constant's value, or 1 marking an imported global.
    pub var value: i64
    ## The symbol of a global or function; the bytes of a text literal.
    pub var name: str

## No operand.
pub func none_ref() -> Ref:
    return Ref(kind = RefKind.none_, index = 0, value = 0, name = "")

## The temporary numbered `index`.
pub func temp_ref(index: u32) -> Ref:
    return Ref(kind = RefKind.temp, index = index, value = 0, name = "")

## The integer constant `value`.
pub func const_ref(value: i64) -> Ref:
    return Ref(kind = RefKind.constant, index = 0, value = value, name = "")

## The address of slot `index`.
pub func slot_ref(index: u32) -> Ref:
    return Ref(kind = RefKind.slot, index = index, value = 0, name = "")

## The address of the global named `name`.
pub func global_ref(name: str) -> Ref:
    return Ref(kind = RefKind.global, index = 0, value = 0, name = name)

## A data symbol another image defines, `__stderrp` or an `extern var`: reached through the
## GOT, since a direct page address to a dylib's data does not link.
pub func import_ref(name: str) -> Ref:
    return Ref(kind = RefKind.global, index = 0, value = 1, name = name)

## The address of the function named `name`.
pub func function_ref(name: str) -> Ref:
    return Ref(kind = RefKind.function, index = 0, value = 0, name = name)

## The address of text literal `index`.
pub func text_ref(index: u32) -> Ref:
    return Ref(kind = RefKind.text, index = index, value = 0, name = "")

# mark: Instructions ===========================================================================
pub enum Op as u8:
    ## `dst = a`
    copy = 1
    ## integer and float arithmetic on the class of `dst`
    add = 10
    sub = 11
    mul = 12
    sdiv = 13
    udiv = 14
    srem = 15
    urem = 16
    and_ = 17
    or_ = 18
    xor = 19
    shl = 20
    lshr = 21
    ashr = 22
    neg = 23
    ## comparisons: `dst` is `w`, 1 or 0; the class on the instruction is the operands'
    ceq = 30
    cne = 31
    cslt = 32
    csle = 33
    csgt = 34
    csge = 35
    cult = 36
    cule = 37
    cugt = 38
    cuge = 39
    ## loads: `a` is an address; the width and extension are in the op
    loadsb = 40
    loadub = 41
    loadsh = 42
    loaduh = 43
    loadsw = 44
    loaduw = 45
    loadl = 46
    loads = 47
    loadd = 48
    ## `dst = load [a]`, a half float
    loadhf = 49
    ## stores: `a` is the value, `b` the address
    storeb = 50
    storeh = 51
    storew = 52
    storel = 53
    stores = 54
    stored = 55
    ## `store a -> [b]`, a half float
    storehf = 56
    ## conversions between classes
    extsb = 60
    extub = 61
    extsh = 62
    extuh = 63
    extsw = 64
    extuw = 65
    exts = 66
    truncd = 67
    stosi = 68
    stoui = 69
    dtosi = 70
    dtoui = 71
    swtof = 72
    uwtof = 73
    sltof = 74
    ultof = 75
    cast = 76
    ## a half to the single or double `cls`; a single to a half
    exth = 77
    truncs = 78
    ## `dst = address of a` (a slot, global, function, or text)
    addr = 80
    ## `blit a <- b, extra bytes`: copy memory
    blit = 81
    ## `zero a, extra bytes`
    zero = 82
    ## `fill a, extra bytes` with the byte constant `b`: the diagnostic profile's pattern
    fill = 83
    ## `call`: `a` is the callee, arguments follow in the function's argument list
    call = 90
    ## `dst = phi` at a block's head: the value from each predecessor, in `phi_args` from
    ## `extra` for `extra2` entries. Only the optimiser's passes see phis: `dessa` turns
    ## them into copies before a generator does.
    phi = 91
    ## control: `label extra`, `jmp extra`, `jnz a, extra (then), value (else)`, `ret [a]`
    label = 100
    jmp = 101
    jnz = 102
    ret = 103
    ## `trap a` where `a` names the reason text
    trap_ = 104
    ## `check a < b` else trap "index out of bounds"
    bounds = 105
    ## `switch a, extra (default), table extra2`: a jump through table `extra2` of the
    ## function's `jump_tables` to the label of entry `a - low`, computed at the class of the
    ## instruction; to `extra` when that is not below the table's `count` (unsigned)
    switch_ = 106
    ## `arith` variants that trap on overflow: `dst = a op b` with the op in `extra`
    addo = 110
    subo = 111
    mulo = 112
    ## `addr_tls`: `dst = address of the thread-local global a`
    addr_tls = 113
    ## `asm a, b`: architecture text `a`, raw lines `b`, no operands
    asm_ = 114
    ## atomics: `extra` is the width in bytes, `extra2` the C memory order;
    ## `atomic_load dst <- [a]`, `atomic_store a -> [b]`, read-modify-write `dst = old; [b] op= a`,
    ## `atomic_cas dst = old; expected and desired are args from index b.value`
    atomic_load = 120
    atomic_store = 121
    atomic_add = 122
    atomic_sub = 123
    atomic_or = 124
    atomic_and_not = 125
    atomic_xor = 126
    atomic_swap = 127
    atomic_max = 128
    atomic_min = 129
    atomic_cas = 130
    ## `fence a`: a full fence with the C memory order in `a`
    fence = 131
    ## Vectors (§5.12): the lanes compute exactly as the scalar operators would, and a
    ## checked lane's overflow traps. `loadv`/`storev` move the shape's bytes; `vshl`/`vshr`
    ## take a scalar count in `b`, already checked against the lane width; `vsplat` takes a
    ## scalar of the lane's class in `a`.
    loadv = 140
    storev = 141
    vadd = 142
    vsub = 143
    vmul = 144
    vdiv = 145
    vand = 146
    vor = 147
    vxor = 148
    vneg = 149
    vnot = 150
    vaddw = 151
    vsubw = 152
    vmulw = 153
    vaddo = 154
    vsubo = 155
    vadds = 156
    vsubs = 157
    vshl = 158
    vshr = 159
    vsplat = 160
    ## `--release --debug`: from here, named local `extra` (an index into `locals`) holds
    ## `a`, a temporary or a constant, until the next `dbg` of it or the end of the
    ## temporary's life; no code, no use of `a` (`ssa.promote` places them, the DWARF
    ## emitter reads them)
    dbg = 161
    ## `fma dst = a * b + c`, rounded once (`mul_add`, §7.2): `c` is the argument at index
    ## `extra2`; `extra` is a vector's lane shape and 0 for a scalar of class `cls`
    fma = 162
    ## The frame pointer of the running function, for the debugger.
    frame = 200
    ## Inline assembly operands: `set_reg a -> named register b` before an `asm` block,
    ## `get_reg [a] <- named register b` after it; `cls` is the width.
    set_reg = 210
    get_reg = 211

## The instructions of a function, as it holds them and as the inliner rebuilds them.
pub type Instrs = list.List[Instr]

## One instruction. `dst` is 0 when there is none. `extra` carries a label, a
## byte count, or a call's argument range.
pub struct Instr:
    ## The operation.
    pub var op: Op
    ## The class of `dst` and of the operation.
    pub var cls: Class
    ## The result temporary, 0 for none.
    pub var dst: u32
    ## The first operand.
    pub var a: Ref
    ## The second operand.
    pub var b: Ref
    ## A label, a byte count, or a call's argument range.
    pub var extra: u32
    ## A branch's else label, or a second count.
    pub var extra2: u32
    ## The source line and file (an index into the unit's `files`, 1-based, 0 for none)
    ## the instruction came from, for the line table of an optimised build (`--release
    ## --debug`); the passes carry them with the instruction.
    pub var line: u32
    ## The file the line refers to, an index into the unit's `files`.
    pub var file: u32
    ## The lexical scope (an index into the function's `debug_scopes`, 0 for the function's
    ## own) the instruction came from; the passes carry it, and a build with symbols
    ## describes each scope's locals over the addresses its instructions reach.
    pub var scope: u32
    ## The inlined subroutine (an index into the function's `sites`, 1-based, 0 for the
    ## function's own body) the instruction came from, the same way.
    pub var site: u32

## One scalar member of an aggregate, wherever it lies: what a calling convention reads to
## classify the aggregate. A union's members overlap; padding has no leaf.
pub struct Leaf:
    ## The member's byte offset in the aggregate.
    pub var offset: u32
    ## The member's size in bytes.
    pub var size: u8
    ## The member's register class.
    pub var cls: Class

## An aggregate's leaves, as a range of the unit's `leaves`; shape 0 is no shape, the
## aggregate is passed in memory whatever the convention.
pub struct Shape:
    ## The first leaf's index in the unit's `leaves`.
    pub var start: u32
    ## How many leaves the shape has.
    pub var count: u32

## One argument of a call: the operand, its class, and for an aggregate its byte size,
## alignment, and shape (0 size means a scalar). The convention is the target's: the IR
## says what the value is made of, and the generator decides where it goes.
pub struct Arg:
    ## The argument operand.
    pub var value: Ref
    ## The argument's register class.
    pub var cls: Class
    ## The aggregate's byte size, 0 for a scalar.
    pub var size: u32
    ## The aggregate's alignment.
    pub var align: u32
    ## The argument's type.
    pub var type_id: u32
    ## The aggregate's shape (1-based), 0 for none.
    pub var shape: u32
    ## Scalar storage width before register promotion; zero uses the IR class width.
    ## Apple arm64 packs fixed stack arguments using this width, even for i8/u16.
    pub var scalar_width: u32

## A call's result: a scalar class, or an aggregate written to `slot` of `size` bytes.
pub struct CallInfo:
    ## The first argument's index in the function's `args`.
    pub var args_start: u32
    ## How many arguments the call passes.
    pub var args_count: u32
    ## How many arguments are fixed, before any variadic tail.
    pub var fixed_count: u32
    ## Whether the call is variadic.
    pub var variadic: bool
    ## The result's register class.
    pub var result_cls: Class
    ## Whether the call returns a value.
    pub var has_result: bool
    ## The result's byte size, 0 for a scalar.
    pub var result_size: u32
    ## The result's alignment.
    pub var result_align: u32
    ## The result's type.
    pub var result_type: u32
    ## The slot an aggregate result is written into.
    pub var result_slot: u32
    ## The result aggregate's shape (1-based), 0 for none.
    pub var result_shape: u32

## The jump table of a `switch`: its labels are `jump_labels[start ..< start + count]`,
## entry `k` for the value `low + k`.
pub struct Table:
    ## The value of the first entry.
    pub var low: i64
    ## The first label's index in the function's `jump_labels`.
    pub var start: u32
    ## How many entries the table has.
    pub var count: u32

## A stack slot: `size` bytes at `align`.
pub struct Slot:
    ## The slot's size in bytes.
    pub var size: u32
    ## The slot's alignment.
    pub var align: u32

## A parameter as the function receives it.
pub struct Param:
    ## The parameter's register class.
    pub var cls: Class
    ## The parameter's byte size, 0 for a scalar.
    pub var size: u32
    ## The parameter's alignment.
    pub var align: u32
    ## The parameter's type.
    pub var type_id: u32
    ## The slot the parameter is stored into on entry.
    pub var slot: u32
    ## The parameter aggregate's shape (1-based), 0 for none.
    pub var shape: u32
    ## The scalar storage width before promotion; 0 uses the class width.
    pub var scalar_width: u32
    ## Whether the scalar parameter is signed.
    pub var scalar_signed: bool

# mark: Functions and the unit ================================================================

## One incoming value of a phi: what the block whose label is `pred` supplies.
pub struct PhiArg:
    ## The value this predecessor supplies.
    pub var value: Ref
    ## The predecessor block's label.
    pub var pred: u32

## A named local as the debugger sees it (`--debug`): its slot, its type's spelling.
pub struct LocalInfo:
    ## The local's name.
    pub var name: str
    ## The slot the local lives in.
    pub var slot: u32
    ## The local's type, spelled for the debugger.
    pub var kind: str
    ## The local's byte size.
    pub var size: u32
    ## The local's type.
    pub var type_id: u32
    ## The line the local is declared on.
    pub var line: u32
    ## Whether the local is a parameter.
    pub var parameter: bool
    ## The lexical scope the local belongs to.
    pub var scope: usize
    ## The inlined subroutine the local belongs to (`Instr.site`), 0 for the function's own.
    pub var site: u32

## A statement boundary the in-program debugger stops at (`--debug`).
pub struct DebugPoint:
    ## The instruction index the statement begins at.
    pub var instruction: usize
    ## The statement's source file.
    pub var file: str
    ## The statement's line.
    pub var line: u32
    ## The statement's column.
    pub var column: u32

## A lexical scope (`--debug`), for the locals visible within it.
pub struct DebugScope:
    ## The enclosing scope's index, 0 for the function's own.
    pub var parent: usize
    ## The instruction index the scope opens at.
    pub var start: usize
    ## The instruction index the scope closes at.
    pub var end: usize
    ## The inlined subroutine the scope belongs to (`Instr.site`), 0 for the function's own.
    pub var site: u32

## A call a build with symbols opened out (`opt/inline.lucb`): the callee, for its abstract
## description, and where the call was, for the inlined subroutine's own.
pub struct InlineSite:
    ## The callee's name.
    pub var name: str
    ## The callee's source file.
    pub var source: str
    ## The line the callee is declared on.
    pub var line: u32
    ## The callee's result type.
    pub var result_type: u32
    ## The line and file (`Instr.file`) of the call.
    pub var call_line: u32
    ## The file of the call, 0 for the caller's own source.
    pub var call_file: u32
    ## The caller's scope the call was in.
    pub var scope: u32
    ## The site the call itself was in, 0 for the caller's own body.
    pub var parent: u32

## One lowered function: its instructions, slots and temporaries, with the metadata the generators and the debugger need.
pub struct Function:
    ## The function's symbol.
    pub var name: str
    ## Whether the function has C linkage (§9.8).
    pub var exported: bool
    ## Optional standard modules must not impose link dependencies on every program.
    pub var standard: bool
    ## `--debug`: the source file, and every named local for the frame's descriptor.
    pub var debug: bool
    ## `--release --debug`: DWARF for the optimised function, lines on every instruction,
    ## the named locals pinned to their slots; no hooks, no descriptor.
    pub var symbols: bool
    ## The position `emit` stamps on each instruction.
    pub var at_line: u32
    ## The file `emit` stamps on each instruction.
    pub var at_file: u32
    ## The scope the lowerer is in, stamped on each instruction it emits (`Instr.scope`).
    pub var at_scope: u32
    ## The function's source file.
    pub var source: str
    ## The function's source-level name.
    pub var source_name: str
    ## The line the function is declared on.
    pub var source_line: u32
    ## The statement boundaries, for the in-program debugger.
    pub var points: list.List[DebugPoint]
    ## The lexical scopes.
    pub var debug_scopes: list.List[DebugScope]
    ## The calls the inliner opened out in a build with symbols, 1-based by `Instr.site`.
    pub var sites: list.List[InlineSite]
    ## The named locals.
    pub var locals: list.List[LocalInfo]
    ## The parameters as received.
    pub var params: list.List[Param]
    ## The stack slots.
    pub var slots: list.List[Slot]
    ## The instructions, in order.
    pub var instrs: list.List[Instr]
    ## The call arguments and atomic operands, pooled.
    pub var args: list.List[Arg]
    ## The call descriptions, indexed by `Instr.extra`.
    pub var calls: list.List[CallInfo]
    ## The class of each temporary, by index.
    pub var temps: list.List[Class]
    ## The phi arguments, pooled.
    pub var phi_args: list.List[PhiArg]
    ## The jump tables of the `switch` instructions, indexed by `Instr.extra2`.
    pub var jump_tables: list.List[Table]
    ## The jump tables' labels, pooled.
    pub var jump_labels: list.List[u32]
    ## How many labels have been handed out.
    pub var labels: u32
    ## Whether the function returns a value.
    pub var has_result: bool
    ## The result's register class.
    pub var result_cls: Class
    ## The result's byte size, 0 for a scalar.
    pub var result_size: u32
    ## The result's alignment.
    pub var result_align: u32
    ## The result's type.
    pub var result_type: u32
    ## The result aggregate's shape (1-based), 0 for none.
    pub var result_shape: u32
    ## Whether the function is variadic.
    pub var variadic: bool
    ## The attributes of §9.8 that reach the object file.
    pub var naked: bool
    ## Whether the symbol is weak (§9.8).
    pub var weak: bool
    ## Whether the symbol is retained even if unreferenced (§9.8).
    pub var used: bool
    ## The section the function is placed in, empty for the default.
    pub var section: str
    ## `noinline`: the body stands in for no call of it (§9.8).
    pub var noinline: bool
    ## `inline`: the body stands in for every call of it that can be expanded, whatever its
    ## size up to `opt/inline`'s `forced` (§9.8).
    pub var always_inline: bool = false

    ## An empty function named `name`.
    pub static func create(name: str) -> Function!:
        return Function(name = name, exported = false, debug = false, symbols = false, at_line = 0, at_file = 0, at_scope = 0, source = "", source_name = name, source_line = 1, points = try list.List[DebugPoint].create(0), debug_scopes = try list.List[DebugScope].create(0), sites = try list.List[InlineSite].create(0), locals = try list.List[LocalInfo].create(8),
                        params = try list.List[Param].create(8),
                        slots = try list.List[Slot].create(32), instrs = try list.List[Instr].create(256),
                        args = try list.List[Arg].create(32), calls = try list.List[CallInfo].create(16),
                        temps = try list.List[Class].create(128), phi_args = try list.List[PhiArg].create(16), jump_tables = try list.List[Table].create(0), jump_labels = try list.List[u32].create(0), labels = 0, has_result = false,
                        result_cls = Class.l, result_size = 0, result_align = 0, result_type = 0,
                        result_shape = 0, variadic = false)

    ## A fresh temporary of class `cls`; its 1-based number.
    pub mutating func temp(cls: Class) -> u32!:
        try self.temps.push(cls)
        return u32(self.temps.count)

    ## The class of temporary `index`.
    pub func temp_class(index: u32) -> Class:
        return self.temps.get((usize)index - 1)

    ## A fresh slot of `wanted` bytes at `align`; its index.
    pub mutating func slot(wanted: u32, align: u32) -> u32!:
        # an aggregate that travels in two registers lands as two words
        let size = 16 if wanted > 8 and wanted < 16 else wanted
        try self.slots.push(Slot(size = size if size > 0 else 1, align = align if align > 0 else 1))
        return u32(self.slots.count - 1)

    ## A fresh label number.
    pub mutating func label() -> u32:
        self.labels += 1
        return self.labels

    ## Append an instruction, stamping the current source position on it.
    pub mutating func emit(op: Op, cls: Class, dst: u32, a: Ref, b: Ref, extra: u32) -> !:
        try self.instrs.push(Instr(op = op, cls = cls, dst = dst, a = a, b = b, extra = extra, extra2 = 0, line = self.at_line, file = self.at_file, scope = self.at_scope, site = 0))

    ## `dst = op a, b` with a fresh temporary.
    ## `dst = a op b` at class `cls`; a comparison compares at `cls` and answers a word.
    pub mutating func binary(op: Op, cls: Class, a: Ref, b: Ref) -> Ref!:
        let t = try self.temp(Class.w if is_comparison(op) else cls)
        try self.emit(op, cls, t, a, b, 0)
        return temp_ref(t)

    ## `dst = op a` at class `cls`, into a fresh temporary.
    pub mutating func unary(op: Op, cls: Class, a: Ref) -> Ref!:
        let t = try self.temp(cls)
        try self.emit(op, cls, t, a, none_ref(), 0)
        return temp_ref(t)

    ## Mark where label `label` lands.
    pub mutating func place_label(label: u32) -> !:
        try self.emit(Op.label, Class.l, 0, none_ref(), none_ref(), label)

    ## An unconditional jump to `label`.
    pub mutating func jump(label: u32) -> !:
        try self.emit(Op.jmp, Class.l, 0, none_ref(), none_ref(), label)

    ## Branch on `condition` being nonzero, tested at its own width: a pointer's low word
    ## may be zero while the pointer is not.
    pub mutating func branch(condition: Ref, then_label: u32, else_label: u32) -> !:
        var cls = Class.l
        if condition.kind == RefKind.temp and (usize)condition.index <= self.temps.count:
            cls = self.temps.get((usize)condition.index - 1)
        try self.instrs.push(Instr(op = Op.jnz, cls = cls, dst = 0, a = condition, b = none_ref(), extra = then_label, extra2 = else_label, line = 0, file = 0, scope = 0, site = 0))

    ## Jump to `labels[value - low]`, or to `default` when `value - low`, at class `cls`, is
    ## not below the number of labels (compared unsigned).
    pub mutating func switch(value: Ref, cls: Class, low: i64, labels: u32[], default: u32) -> !:
        try self.jump_tables.push(Table(low = low, start = u32(self.jump_labels.count), count = u32(labels.length)))
        for label in labels:
            try self.jump_labels.push(label)
        try self.instrs.push(Instr(op = Op.switch_, cls = cls, dst = 0, a = value, b = none_ref(), extra = default, extra2 = u32(self.jump_tables.count - 1), line = self.at_line, file = self.at_file, scope = self.at_scope, site = 0))

    ## The labels of jump table `index`.
    pub func table_targets(index: u32) -> u32[]:
        let t = self.jump_tables.get((usize)index)
        return self.jump_labels.span()[(usize)t.start..<(usize)(t.start + t.count)]

    ## Load through `address` with `op`, into a fresh temporary.
    pub mutating func load(op: Op, cls: Class, address: Ref) -> Ref!:
        let t = try self.temp(cls)
        try self.emit(op, cls, t, address, none_ref(), 0)
        return temp_ref(t)

    ## Store `value` through `address` with `op`.
    pub mutating func store(op: Op, value: Ref, address: Ref) -> !:
        try self.emit(op, Class.l, 0, value, address, 0)

    ## The address of what `r` refers to, in a fresh temporary.
    pub mutating func address_of(r: Ref) -> Ref!:
        let t = try self.temp(Class.l)
        try self.emit(Op.addr, Class.l, t, r, none_ref(), 0)
        return temp_ref(t)

    ## Copy `size` bytes from `source` to `target`.
    pub mutating func copy_bytes(target: Ref, source: Ref, size: u32) -> !:
        try self.emit(Op.blit, Class.l, 0, target, source, size)

    ## Zero `size` bytes at `target`.
    pub mutating func zero_bytes(target: Ref, size: u32) -> !:
        try self.emit(Op.zero, Class.l, 0, target, none_ref(), size)

## A text literal of the unit, emitted once with a NUL after it.
pub struct Text:
    ## The literal's bytes.
    pub var bytes: str

## Data for a global: its symbol, its size, its alignment, and whether it is thread-local.
pub struct Global:
    ## The global's symbol.
    pub var name: str
    ## Whether it belongs to a standard module.
    pub var standard: bool
    ## The global's byte size.
    pub var size: u32
    ## The global's alignment.
    pub var align: u32
    ## Whether it is thread-local.
    pub var is_thread_local: bool
    ## Whether it has C linkage.
    pub var exported: bool
    ## Whether the symbol is weak.
    pub var weak: bool
    ## Whether it is retained even if unreferenced.
    pub var used: bool
    ## The section it is placed in, empty for the default.
    pub var section: str
    ## `linked`: another object defines the storage; the program only refers to it.
    pub var external: bool
    ## A standard global's initialiser, a function of its own that `lb_init_globals`
    ## calls, so the pruner keeps it with the global; empty for the rest.
    pub var init_function: str = ""

## A witness table: the symbol and the functions it points at, in requirement order.
pub struct WitnessTable:
    ## The table's symbol.
    pub var name: str
    ## The function symbols, in requirement order.
    pub var entries: list.List[str]

## The whole program as the target sees it.
pub struct Unit:
    ## The program's functions.
    pub var functions: list.List[Function]
    ## The source files instructions name by index (`Instr.file`), 1-based.
    pub var files: list.List[str]
    ## The program's globals.
    pub var globals: list.List[Global]
    ## The program's text literals.
    pub var texts: list.List[Text]
    ## The witness tables.
    pub var tables: list.List[WitnessTable]
    ## Module-level `asm` blocks for this target, verbatim (§8.9).
    pub var module_asm: list.List[Text]
    ## The shapes of the aggregates passed and returned, and their leaves.
    pub var shapes: list.List[Shape]
    ## The aggregate members, referenced by shapes.
    pub var leaves: list.List[Leaf]
    ## The function the loader runs when the image is loaded, empty when there is none:
    ## a library's initialiser (§17.6). The generator places it in its object format's
    ## initialiser section.
    pub var init_function: str
    ## The function a `trap` or a failed `bounds` calls with the reason's text: named here
    ## so the generators spell no symbol of the program, and the inliner keeps it.
    pub var trap_function: str
    ## The same with the position first (§11.5): `trap_at(position, reason)` and, for an
    ## assertion whose message is computed, `trap_two_at(position, reason, detail)`.
    pub var trap_at_function: str
    ## The function for an assertion whose message is computed (`trap_two_at`).
    pub var trap_two_at_function: str

    ## An empty unit.
    pub static func create() -> Unit!:
        return Unit(functions = try list.List[Function].create(64), files = try list.List[str].create(8), globals = try list.List[Global].create(32),
                    texts = try list.List[Text].create(64), tables = try list.List[WitnessTable].create(16),
                    module_asm = try list.List[Text].create(4), shapes = try list.List[Shape].create(64), leaves = try list.List[Leaf].create(256),
                    init_function = "", trap_function = "", trap_at_function = "", trap_two_at_function = "")

    ## The index of a source file in `files`, adding it when new; 1-based.
    pub mutating func file_index(path: str) -> u32!:
        var i: usize = 0
        while i < self.files.count:
            if self.files.get(i) == path:
                return u32(i + 1)
            i += 1
        try self.files.push(path)
        return u32(self.files.count)

    ## The index of a text literal, adding it when new.
    ## The leaves of shape `shape` (1-based), empty for 0.
    pub func leaves_of(shape: u32) -> Leaf[]:
        if shape == 0 or (usize)shape > self.shapes.count:
            return self.leaves.span()[..<0]
        let s = self.shapes.get((usize)shape - 1)
        return self.leaves.span()[(usize)s.start..<(usize)(s.start + s.count)]

    ## Record a shape from the leaves pushed since `start`; its 1-based index.
    pub mutating func shape_from(start: usize) -> u32!:
        try self.shapes.push(Shape(start = u32(start), count = u32(self.leaves.count - start)))
        return u32(self.shapes.count)

    ## The index of text literal `bytes`, adding it when new.
    pub mutating func text(bytes: str) -> u32!:
        var i: usize = 0
        while i < self.texts.count:
            if self.texts.get(i).bytes == bytes:
                return u32(i)
            i += 1
        try self.texts.push(Text(bytes = bytes))
        return u32(self.texts.count - 1)

## The arguments an instruction reads from the function's argument list, as a start and a
## count: a call's, the expected and desired values of `atomic_cas`, and the addend of
## `fma`, which sit there too. Every pass that walks a call's arguments walks these, so a cas's operands are
## renamed, resolved, counted live, and kept out of promoted slots like any other use.
pub func argument_range(f: Function*, x: Instr) -> (u32, u32):
    if x.op == Op.call:
        let info = f.calls.get((usize)x.extra)
        return (info.args_start, info.args_count)
    if x.op == Op.atomic_cas:
        return ((u32)x.b.value, 2)
    if x.op == Op.fma:
        return (x.extra2, 1)
    return (0, 0)

## The class a scalar of `size` bytes uses; floats are chosen by the caller.
pub func class_of_size(size: u64) -> Class:
    return Class.l if size > 4 else Class.w

## The load op for a scalar of a size and signedness, or a float.
pub func load_op(size: u64, signed: bool, is_float: bool) -> Op:
    if is_float:
        return Op.loadhf if size == 2 else (Op.loads if size == 4 else Op.loadd)
    if size == 1:
        return Op.loadsb if signed else Op.loadub
    if size == 2:
        return Op.loadsh if signed else Op.loaduh
    if size == 4:
        return Op.loadsw if signed else Op.loaduw
    return Op.loadl

## The store op for a scalar of a size, or a float.
pub func store_op(size: u64, is_float: bool) -> Op:
    if is_float:
        return Op.storehf if size == 2 else (Op.stores if size == 4 else Op.stored)
    if size == 1:
        return Op.storeb
    if size == 2:
        return Op.storeh
    if size == 4:
        return Op.storew
    return Op.storel

test "a function collects temporaries, slots, and instructions":
    var backing: u8[262144]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var f = try Function.create("f")
        let a = try f.binary(Op.add, Class.l, const_ref(1), const_ref(2))
        let s = try f.slot(8, 8)
        try f.store(Op.storel, a, slot_ref(s))
        let back = try f.load(Op.loadl, Class.l, slot_ref(s))
        assert(f.instrs.count == 3)
        assert(f.temps.count == 2)
        assert(back.index == 2)
        var u = try Unit.create()
        assert((try u.text("hi")) == 0)
        assert((try u.text("hi")) == 0)
        assert((try u.text("yo")) == 1)
