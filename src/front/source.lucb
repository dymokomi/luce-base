#==============================================================================================
#
#   source - Source text and positions
#
#   DESCRIPTION:
#       The bytes of one file, the encoding gate of base.md §3.1, and line/column positions
#       for diagnostics. A `Source` never owns its bytes; the caller's allocator does, so a
#       whole compilation can live in one arena.
#
#==============================================================================================

import c
import files

pub let bad_encoding: ErrorCode = ErrorCode.package(1)
pub let unreadable: ErrorCode = ErrorCode.package(2)

pub struct Source:
    pub var path: str
    pub var bytes: const u8[]

    ## Load a file into the current allocator and check it is UTF-8 without NUL.
    pub static func load(path: c.str) -> Source!:
        let data = try files.read(path)
        return try Source.over((str)path, data)

    ## Adopt bytes already in memory (tests, and the driver's own strings). A byte-order
    ## mark at byte zero is dropped (§3.1); the text must be UTF-8 free of controls.
    pub static func over(path: str, data: const u8[]) -> Source!:
        let body = data[3..] if has_bom(data) else data
        try refuse_controls(body)
        discard(str(body) catch:
            error(bad_encoding, "invalid UTF-8 in source"))
        return Source(path = path, bytes = body)

    ## One-based line and column of a byte offset, counting columns in bytes.
    pub func position(offset: usize) -> (u32, u32):
        var line: u32 = 1
        var column: u32 = 1
        var i: usize = 0
        while i < offset and i < self.bytes.length:
            if self.bytes[i] == '\n':
                line += 1
                column = 1
            else:
                column += 1
            i += 1
        return (line, column)

    pub func text(start: usize, end: usize) -> str:
        return (str)self.bytes[start..<end]

## The UTF-8 byte-order mark, accepted only at byte zero.
func has_bom(data: const u8[]) -> bool:
    return data.length >= 3 and data[0] == 0xEF and data[1] == 0xBB and data[2] == 0xBF

## NUL, a byte-order mark past byte zero, and the Unicode bidirectional format
## characters (U+202A to U+202E and U+2066 to U+2069) are refused in source (§3.1).
func refuse_controls(data: const u8[]) -> !:
    var i: usize = 0
    while i < data.length:
        let b = data[i]
        if b == 0:
            error(bad_encoding, "NUL byte in source")
        if b == 0xEF and i + 2 < data.length and data[i + 1] == 0xBB and data[i + 2] == 0xBF:
            error(bad_encoding, "a byte-order mark is accepted only at byte zero")
        if b == 0xE2 and i + 2 < data.length:
            let second = data[i + 1]
            let third = data[i + 2]
            let embedding = second == 0x80 and third >= 0xAA and third <= 0xAE
            let isolate = second == 0x81 and third >= 0xA6 and third <= 0xA9
            if embedding or isolate:
                error(bad_encoding, "bidirectional format characters are not allowed in source")
        i += 1

test "a byte-order mark is dropped at byte zero and refused elsewhere":
    let bom: u8[6] = [0xEF, 0xBB, 0xBF, 'a', 'b', 'c']
    let src = Source.over("t", bom) catch failure:
        recover Source(path = "", bytes = "".bytes)
    assert(src.bytes.length == 3)
    let inside: u8[5] = ['a', 0xEF, 0xBB, 0xBF, 'b']
    var refused = false
    discard(Source.over("t", inside) catch failure:
        refused = true
        recover Source(path = "", bytes = "".bytes))
    assert(refused)

test "a bidirectional control is refused":
    let text: u8[5] = ['a', 0xE2, 0x80, 0xAE, 'b']
    var refused = false
    discard(Source.over("t", text) catch failure:
        refused = true
        recover Source(path = "", bytes = "".bytes))
    assert(refused)

test "position counts lines and columns":
    let src = Source.over("t", "ab\ncd".bytes) catch failure:
        recover Source(path = "", bytes = "".bytes)
    let (line, column) = src.position(4)
    assert(line == 2)
    assert(column == 2)

test "NUL is refused":
    var raw: u8[3] = [97, 0, 98]
    var refused = false
    discard(Source.over("t", raw) catch failure:
        refused = failure.code == bad_encoding
        recover Source(path = "", bytes = "".bytes))
    assert(refused)
