#==============================================================================================
#
#   parser - Recursive descent over the token buffer
#
#   DESCRIPTION:
#       The grammar of base.md §21, one function per production, with the expression
#       precedence ladder of §7.10. A `(T)x` cast is recognised only when the parenthesised
#       text is cast-shaped (§7.5), and a `[` after a name holds type arguments only when it
#       is followed by `(` or `.`. The first syntax error stops the parse and carries its line
#       and column.
#
#==============================================================================================

import c
import front.ast
import front.lexer
import front.source
import front.token
import memory

pub let syntax: ErrorCode = ErrorCode.package(7)
pub let too_deep: ErrorCode = ErrorCode.package(8)

let max_nest: u32 = 200

pub struct Parser:
    var src: source.Source
    var tokens: token.Token[]
    var count: usize
    var pos: usize
    var scratch: u8[]
    var nest: u32
    ## The standard modules declare the core names they define (§3.5).
    pub var allow_core_names: bool

    ## Lex the whole source into the current allocator.
    pub static func over(src: source.Source, scratch: u8[]) -> Parser!:
        var lx = lexer.Lexer.over(src)
        var buffer = try alloc token.Token[256]
        var n: usize = 0
        while true:
            # a lexing error is reported where the lexer stopped
            let t = lx.next() catch failure:
                let (line, column) = lx.position()
                let half = scratch.length // 2
                let message = try format(scratch[..<half], f"{line}:{column}: {failure.message}")
                error(failure.code, message)
            if n == buffer.length:
                let grown = try alloc token.Token[buffer.length * 2]
                memory.copy(grown, buffer, n)
                free(buffer)
                buffer = grown
            buffer[n] = t
            n += 1
            if t.kind == token.Kind.eof:
                break
        return Parser(src = src, tokens = buffer, count = n, pos = 0, scratch = scratch, nest = 0)

    # -- the token cursor ------------------------------------------------------------------

    func cur() -> token.Token:
        return self.tokens[self.pos]

    func peek(ahead: usize) -> token.Token:
        let i = self.pos + ahead
        if i >= self.count:
            return self.tokens[self.count - 1]
        return self.tokens[i]

    pub func scratch_length() -> usize:
        return self.scratch.length

    pub func text_of(t: token.Token) -> str:
        return self.src.text(t.start, t.end)

    pub func at(kind: token.Kind) -> bool:
        return self.cur().kind == kind

    pub func at_op(spelling: str) -> bool:
        let t = self.cur()
        return t.kind == token.Kind.operator and self.text_of(t) == spelling

    pub func at_kw(word: str) -> bool:
        let t = self.cur()
        return t.kind == token.Kind.keyword and self.text_of(t) == word

    func at_name(word: str) -> bool:
        let t = self.cur()
        return t.kind == token.Kind.name and self.text_of(t) == word

    func peek_op(ahead: usize, spelling: str) -> bool:
        let t = self.peek(ahead)
        return t.kind == token.Kind.operator and self.text_of(t) == spelling

    pub mutating func take() -> token.Token:
        let t = self.cur()
        if self.pos + 1 < self.count:
            self.pos += 1
        return t

    pub mutating func eat_op(spelling: str) -> bool:
        if self.at_op(spelling):
            discard(self.take())
            return true
        return false

    mutating func eat_kw(word: str) -> bool:
        if self.at_kw(word):
            discard(self.take())
            return true
        return false

    ## The message lives in the first half of `scratch`; `what` may live in the second.
    pub func fail(what: str) -> ast.Node*!:
        let t = self.cur()
        let half = self.scratch.length // 2
        let message = try format(self.scratch[..<half], f"{self.src.path}:{t.line}:{t.column}: {what}")
        error(syntax, message)

    func spelled(prefix: str, spelling: str) -> str!:
        let half = self.scratch.length // 2
        return try format(self.scratch[half..], f"{prefix}`{spelling}`")

    mutating func expect_op(spelling: str) -> !:
        if not self.eat_op(spelling):
            discard(try self.fail(try self.spelled("expected ", spelling)))

    mutating func expect_kw(word: str) -> !:
        if not self.eat_kw(word):
            discard(try self.fail(try self.spelled("expected ", word)))

    mutating func expect_newline() -> !:
        if self.at(token.Kind.newline):
            discard(self.take())
            return
        if self.at(token.Kind.eof) or self.at(token.Kind.dedent):
            return
        # a `catch` suite or a same-line suite has already consumed the line end
        if self.pos > 0:
            let prev = self.tokens[self.pos - 1].kind
            if prev == token.Kind.newline or prev == token.Kind.dedent:
                return
        # `discard(x catch f: recover 0)`: the enclosing bracket ends the suite
        if self.at_op(")") or self.at_op("]") or self.at_op("}"):
            return
        discard(try self.fail("expected the end of the line"))

    pub mutating func expect_name() -> str!:
        if not self.at(token.Kind.name):
            discard(try self.fail("expected a name"))
        let word = self.text_of(self.take())
        if token.is_core_name(word) and not self.allow_core_names:
            discard(try self.fail("this name belongs to the language; a declaration cannot take it (§3.5)"))
        return word

    ## After `.`, a reserved word is an ordinary name; a declaration never takes one.
    mutating func expect_member_name() -> str!:
        if not self.at(token.Kind.name) and not self.at(token.Kind.keyword):
            discard(try self.fail("expected a member name"))
        return self.text_of(self.take())

    func at_member_name(ahead: usize) -> bool:
        let k = self.peek(ahead).kind
        return k == token.Kind.name or k == token.Kind.keyword

    mutating func skip_newlines():
        while self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
            discard(self.take())

    func node(kind: ast.Kind, text: str) -> ast.Node*!:
        let t = self.cur()
        return try ast.Node.make(kind, text, t.start, t.line)

    ## A node made of the current token: its text and its position, then consumed.
    mutating func taken(kind: ast.Kind) -> ast.Node*!:
        let t = self.take()
        return try ast.Node.make(kind, self.text_of(t), t.start, t.line)

    mutating func enter() -> !:
        self.nest += 1
        if self.nest > max_nest:
            discard(try self.fail("nesting is too deep"))

    mutating func leave():
        self.nest -= 1

    # -- module and declarations ----------------------------------------------------------

    pub mutating func parse_module() -> ast.Node*!:
        let module = try self.node(ast.Kind.module, self.src.path)
        var tail: ast.Node*? = none
        self.skip_newlines()
        while not self.at(token.Kind.eof):
            let d = try self.parse_top_decl()
            ast.append(&module.body, &tail, d)
            self.skip_newlines()
        return module

    mutating func parse_top_decl() -> ast.Node*!:
        if self.at_kw("import") or self.at_kw("from"):
            return try self.parse_import()
        if self.at_kw("test"):
            return try self.parse_test()
        if self.at_name("assert"):
            let n = try self.node(ast.Kind.assert_, "")
            discard(self.take())
            n.body = try self.parse_arguments()
            try self.expect_newline()
            return n
        if self.at_kw("asm") and self.peek(1).kind == token.Kind.name and self.peek_op(2, ":"):
            return try self.parse_asm()
        var flags: u32 = 0
        if self.eat_kw("pub"):
            flags |= ast.flag_pub
        if self.eat_kw("export"):
            flags |= ast.flag_export
        if self.at_kw("extern"):
            let d = try self.parse_extern()
            d.flags |= flags
            return d
        return try self.parse_decl(flags)

    ## A declaration after its visibility: constant, global, alias, function, or a type.
    mutating func parse_decl(visibility: u32) -> ast.Node*!:
        var flags = visibility
        if self.eat_kw("thread_local"):
            flags |= ast.flag_thread_local
            if not self.at_kw("var"):
                return try self.fail("`thread_local` declares a `var` (§6.3)")
        let attributes = try self.parse_attributes()
        if self.at_kw("let"):
            if attributes != none or flags != visibility:
                return try self.fail("an attribute goes before `func` or a top-level `var` (§9.8)")
            let n = try self.node(ast.Kind.constant, "")
            discard(self.take())
            n.text = try self.expect_name()
            if self.eat_op(":"):
                n.ty = try self.parse_type()
            try self.expect_op("=")
            n.left = try self.parse_expression()
            try self.expect_newline()
            n.flags |= flags
            return n
        if self.at_kw("var"):
            let n = try self.node(ast.Kind.global, "")
            discard(self.take())
            n.text = try self.expect_name()
            try self.expect_op(":")
            n.ty = try self.parse_type()
            if self.eat_op("="):
                if self.eat_op("---"):
                    n.flags |= ast.flag_uninit
                else:
                    n.left = try self.parse_expression()
            try self.expect_newline()
            n.flags |= flags
            n.attrs = attributes
            return n
        if self.at_kw("type"):
            let n = try self.node(ast.Kind.type_alias, "")
            discard(self.take())
            n.text = try self.expect_name()
            try self.expect_op("=")
            n.ty = try self.parse_type()
            try self.expect_newline()
            n.flags |= flags
            return n
        var layout: ast.Node*? = none
        if self.at_name("packed"):
            discard(self.take())
            flags |= ast.flag_packed
        elif self.at_name("align") and self.peek_op(1, "("):
            discard(self.take())
            try self.expect_op("(")
            layout = try self.parse_expression()
            try self.expect_op(")")
        if self.at_kw("struct"):
            let n = try self.parse_struct(false)
            n.flags |= flags
            n.right = layout
            return n
        if self.at_kw("enum"):
            let n = try self.parse_enum()
            n.flags |= flags
            return n
        if self.at_kw("union"):
            let n = try self.parse_union(false)
            n.flags |= flags
            return n
        if self.at_kw("interface"):
            let n = try self.parse_interface()
            n.flags |= flags
            return n
        if self.at_kw("static") or self.at_kw("mutating") or self.at_kw("func"):
            let n = try self.parse_func()
            n.flags |= flags
            n.attrs = attributes
            return n
        if self.at_name("class"):
            return try self.fail("`class` belongs to full Luce; Base declares a `struct`")
        return try self.fail("expected a declaration")

    mutating func parse_attributes() -> ast.Node*?!:
        var list: ast.Node*? = none
        var tail: ast.Node*? = none
        while self.at(token.Kind.name):
            let word = self.text_of(self.cur())
            if word == "inline" or word == "noinline" or word == "cold" or word == "naked" or word == "weak" or word == "used" or word == "section":
                let a = try self.node(ast.Kind.attribute, word)
                discard(self.take())
                if word == "section":
                    try self.expect_op("(")
                    a.left = try self.parse_primary()
                    try self.expect_op(")")
                ast.append(&list, &tail, a)
            else:
                break
        return list

    mutating func parse_import() -> ast.Node*!:
        if self.eat_kw("from"):
            let n = try self.node(ast.Kind.from_import, "")
            n.text = try self.parse_module_path()
            try self.expect_kw("import")
            var tail: ast.Node*? = none
            while true:
                let item = try self.node(ast.Kind.name, "")
                item.text = try self.expect_name()
                ast.append(&n.body, &tail, item)
                if not self.eat_op(","):
                    break
            try self.expect_newline()
            return n
        let n = try self.node(ast.Kind.import_, "")
        try self.expect_kw("import")
        n.text = try self.parse_module_path()
        if self.eat_kw("as"):
            let alias = try self.node(ast.Kind.name, "")
            alias.text = try self.expect_name()
            n.left = alias
        try self.expect_newline()
        return n

    mutating func parse_module_path() -> str!:
        let first = self.cur()
        if first.kind != token.Kind.name:
            discard(try self.fail("expected a module path"))
        var last = self.take()
        while self.at_op(".") and self.peek(1).kind == token.Kind.name:
            discard(self.take())
            last = self.take()
        return self.src.text(first.start, last.end)

    mutating func parse_func() -> ast.Node*!:
        let n = try self.node(ast.Kind.func_, "")
        if self.eat_kw("static"):
            n.flags |= ast.flag_static
        if self.eat_kw("mutating"):
            n.flags |= ast.flag_mutating
        try self.expect_kw("func")
        n.text = try self.expect_name()
        if self.at_op("[") :
            n.left = try self.parse_generic_params()
        n.body = try self.parse_params()
        try self.parse_result(n)
        try self.expect_op(":")
        let body = try self.parse_suite()
        # params live in `right`; the suite in `body`
        n.right = n.body
        n.body = body
        return n

    ## A function signature line inside an interface.
    mutating func parse_func_sig() -> ast.Node*!:
        let n = try self.node(ast.Kind.func_, "")
        if self.eat_kw("mutating"):
            n.flags |= ast.flag_mutating
        try self.expect_kw("func")
        n.text = try self.expect_name()
        if self.at_op("["):
            n.left = try self.parse_generic_params()
        n.right = try self.parse_params()
        try self.parse_result(n)
        try self.expect_newline()
        return n

    mutating func parse_result(n: ast.Node*) -> !:
        if self.eat_op("->"):
            if self.eat_op("!"):
                n.flags |= ast.flag_fallible
                return
            n.ty = try self.parse_type()

    mutating func parse_generic_params() -> ast.Node*!:
        let list = try self.node(ast.Kind.generic_param, "")
        try self.expect_op("[")
        var tail: ast.Node*? = none
        while not self.at_op("]"):
            let p = try self.node(ast.Kind.generic_param, "")
            p.text = try self.expect_name()
            if self.eat_op(":"):
                var btail: ast.Node*? = none
                while true:
                    let bound = try self.parse_type()
                    ast.append(&p.body, &btail, bound)
                    if not self.eat_op("&"):
                        break
            ast.append(&list.body, &tail, p)
            if not self.eat_op(","):
                break
        try self.expect_op("]")
        return list

    mutating func parse_params() -> ast.Node*?!:
        try self.expect_op("(")
        var list: ast.Node*? = none
        var tail: ast.Node*? = none
        while not self.at_op(")"):
            let p = try self.node(ast.Kind.param, "")
            if self.at_name("out") and self.peek(1).kind == token.Kind.name and self.peek_op(2, ":"):
                discard(self.take())
                p.flags |= ast.flag_out
            p.text = try self.expect_name()
            try self.expect_op(":")
            if self.at_name("noalias"):
                discard(self.take())
                p.flags |= ast.flag_noalias
            p.ty = try self.parse_type()
            if self.eat_op("="):
                p.left = try self.parse_expression()
            ast.append(&list, &tail, p)
            if not self.eat_op(","):
                break
        try self.expect_op(")")
        return list

    ## `: A, B` before a type's body (§14.1): the first colon opens the interface list, or
    ## the body when a newline follows it; a list ends with the body's own colon. Both
    ## colons are consumed here.
    mutating func parse_conformance() -> ast.Node*?!:
        try self.expect_op(":")
        if self.at(token.Kind.newline):
            return none
        var list: ast.Node*? = none
        var tail: ast.Node*? = none
        while true:
            let i = try self.parse_type()
            ast.append(&list, &tail, i)
            if not self.eat_op(","):
                break
        try self.expect_op(":")
        return list

    ## `struct Name[T]: A, B:` and the members; `extern struct` has fields only.
    mutating func parse_struct(is_extern: bool) -> ast.Node*!:
        let n = try self.node(ast.Kind.extern_struct if is_extern else ast.Kind.struct_, "")
        try self.expect_kw("struct")
        n.text = try self.expect_name()
        if self.at_op("["):
            n.left = try self.parse_generic_params()
        n.ty = try self.parse_conformance()
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            let m = try self.parse_member(is_extern)
            ast.append(&n.body, &tail, m)
        discard(self.take())
        return n

    mutating func expect_indent() -> !:
        if not self.at(token.Kind.indent):
            discard(try self.fail("expected an indented block"))
        discard(self.take())

    ## A field or a method inside a struct, enum, or union.
    mutating func parse_member(fields_only: bool) -> ast.Node*!:
        var flags: u32 = 0
        if self.eat_kw("pub"):
            flags |= ast.flag_pub
        if self.eat_kw("export"):
            flags |= ast.flag_export
        if not fields_only and (self.at_kw("static") or self.at_kw("mutating") or self.at_kw("func")):
            let f = try self.parse_func()
            f.flags |= flags
            return f
        let field = try self.node(ast.Kind.field, "")
        if self.at_name("align") and self.peek_op(1, "("):
            discard(self.take())
            try self.expect_op("(")
            field.right = try self.parse_expression()
            try self.expect_op(")")
        if self.eat_kw("var"):
            flags |= 0
        elif self.eat_kw("let"):
            flags |= ast.flag_const
        elif not fields_only:
            discard(try self.fail("expected `var`, `let`, or `func`"))
        field.text = try self.expect_name()
        try self.expect_op(":")
        field.ty = try self.parse_type()
        if self.eat_op("="):
            field.left = try self.parse_expression()
        try self.expect_newline()
        field.flags |= flags
        return field

    mutating func parse_enum() -> ast.Node*!:
        let n = try self.node(ast.Kind.enum_, "")
        try self.expect_kw("enum")
        n.text = try self.expect_name()
        if self.at_op("["):
            n.left = try self.parse_generic_params()
        if self.eat_kw("as"):
            n.ty = try self.parse_type()
        n.right = try self.parse_conformance()
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            let method_ahead = self.at_kw("pub") or self.at_kw("static") or self.at_kw("mutating") or (self.at_kw("func") and self.peek(1).kind == token.Kind.name)
            if method_ahead:
                let m = try self.parse_member(false)
                ast.append(&n.body, &tail, m)
                continue
            let case_node = try self.node(ast.Kind.enum_case, "")
            case_node.text = try self.expect_name()
            if self.at_op("("):
                case_node.body = try self.parse_params()
            elif self.eat_op("="):
                case_node.left = try self.parse_expression()
            try self.expect_newline()
            ast.append(&n.body, &tail, case_node)
        discard(self.take())
        return n

    mutating func parse_union(is_extern: bool) -> ast.Node*!:
        let n = try self.node(ast.Kind.extern_union if is_extern else ast.Kind.union_, "")
        try self.expect_kw("union")
        n.text = try self.expect_name()
        try self.expect_op(":")
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            if not is_extern and (self.at_kw("pub") or self.at_kw("static") or self.at_kw("mutating") or self.at_kw("func")):
                let m = try self.parse_member(false)
                ast.append(&n.body, &tail, m)
                continue
            let member = try self.node(ast.Kind.field, "")
            member.text = try self.expect_name()
            try self.expect_op(":")
            member.ty = try self.parse_type()
            try self.expect_newline()
            ast.append(&n.body, &tail, member)
        discard(self.take())
        return n

    mutating func parse_interface() -> ast.Node*!:
        let n = try self.node(ast.Kind.interface_, "")
        try self.expect_kw("interface")
        n.text = try self.expect_name()
        if self.at_op("["):
            n.left = try self.parse_generic_params()
        try self.expect_op(":")
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            let sig = try self.parse_func_sig()
            ast.append(&n.body, &tail, sig)
        discard(self.take())
        return n

    mutating func parse_test() -> ast.Node*!:
        let n = try self.node(ast.Kind.test_, "")
        try self.expect_kw("test")
        if not self.at(token.Kind.text):
            discard(try self.fail("a test needs a title"))
        n.text = self.text_of(self.take())
        try self.expect_op(":")
        n.body = try self.parse_suite()
        return n

    mutating func parse_extern() -> ast.Node*!:
        try self.expect_kw("extern")
        if self.at_kw("type"):
            let n = try self.node(ast.Kind.extern_type, "")
            discard(self.take())
            n.text = try self.expect_name()
            if self.eat_op("="):
                n.ty = try self.parse_type()
            try self.expect_newline()
            return n
        if self.at_kw("var"):
            let n = try self.node(ast.Kind.extern_var, "")
            discard(self.take())
            n.text = try self.expect_name()
            try self.expect_op(":")
            n.ty = try self.parse_type()
            try self.expect_newline()
            return n
        if self.at_kw("struct") or self.at_name("packed") or (self.at_name("align") and self.peek_op(1, "(")):
            var flags: u32 = 0
            var layout: ast.Node*? = none
            if self.at_name("packed"):
                discard(self.take())
                flags |= ast.flag_packed
            elif self.at_name("align"):
                discard(self.take())
                try self.expect_op("(")
                layout = try self.parse_expression()
                try self.expect_op(")")
            let n = try self.parse_struct(true)
            n.flags |= flags
            n.right = layout
            return n
        if self.at_kw("union"):
            return try self.parse_union(true)
        let n = try self.node(ast.Kind.extern_func, "")
        if self.at_name("blocking"):
            discard(self.take())
            n.flags |= ast.flag_blocking
        try self.expect_kw("func")
        n.text = try self.expect_name()
        if self.eat_kw("as"):
            if not self.at(token.Kind.text):
                discard(try self.fail("expected the C symbol as a string"))
            n.left = try self.taken(ast.Kind.literal)
        try self.expect_op("(")
        var tail: ast.Node*? = none
        while not self.at_op(")"):
            if self.eat_op("..."):
                n.flags |= ast.flag_variadic
                break
            let p = try self.node(ast.Kind.param, "")
            if self.at_name("out"):
                discard(self.take())
                p.flags |= ast.flag_out
            p.text = try self.expect_name()
            try self.expect_op(":")
            p.ty = try self.parse_type()
            ast.append(&n.right, &tail, p)
            if not self.eat_op(","):
                break
        try self.expect_op(")")
        try self.parse_result(n)
        try self.expect_newline()
        return n

    ## `asm ARCH:` with raw lines, at module level or as a statement.
    mutating func parse_asm() -> ast.Node*!:
        let n = try self.node(ast.Kind.asm_, "")
        try self.expect_kw("asm")
        n.text = try self.expect_name()
        if self.eat_op("("):
            var tail: ast.Node*? = none
            while not self.at_op(")"):
                let operand = try self.node(ast.Kind.argument, "")
                operand.text = self.text_of(self.take())     # in / out / inout / options
                try self.expect_op("(")
                var ptail: ast.Node*? = none
                while not self.at_op(")"):
                    let place = try self.taken(ast.Kind.literal)
                    ast.append(&operand.body, &ptail, place)
                    if not self.eat_op(","):
                        break
                try self.expect_op(")")
                if operand.text != "options":
                    if self.at_name("_"):
                        operand.left = try self.taken(ast.Kind.name)
                    else:
                        operand.left = try self.parse_expression()
                ast.append(&n.right, &tail, operand)
                if not self.eat_op(","):
                    break
            try self.expect_op(")")
        try self.expect_op(":")
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while self.at(token.Kind.raw_line):
            let line = try self.taken(ast.Kind.literal)
            ast.append(&n.body, &tail, line)
        if not self.at(token.Kind.dedent):
            discard(try self.fail("an asm suite holds raw lines only"))
        discard(self.take())
        return n

    # -- statements -----------------------------------------------------------------------

    ## `:` was consumed; a same-line simple statement or an indented block.
    mutating func parse_suite() -> ast.Node*!:
        let block = try self.node(ast.Kind.block, "")
        var tail: ast.Node*? = none
        if not self.at(token.Kind.newline):
            if self.at_compound_statement():
                return try self.fail("a same-line suite cannot contain a compound statement (§3.2)")
            let s = try self.parse_simple_statement()
            ast.append(&block.body, &tail, s)
            return block
        discard(self.take())
        try self.expect_indent()
        try self.enter()
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            let s = try self.parse_statement()
            ast.append(&block.body, &tail, s)
        if self.at(token.Kind.dedent):
            discard(self.take())
        self.leave()
        return block

    ## `if`, `while`, `for`, `match`, `with`, `asm`: what a same-line suite may not hold.
    func at_compound_statement() -> bool:
        return self.at_kw("if") or self.at_kw("while") or self.at_kw("for") or self.at_kw("match") or self.at_kw("with") or self.at_kw("asm")

    mutating func parse_statement() -> ast.Node*!:
        if self.at_kw("if"):
            return try self.parse_if()
        if self.at_kw("while"):
            return try self.parse_while("")
        if self.at_kw("for"):
            return try self.parse_for("")
        if self.at_kw("match"):
            return try self.parse_match(false)
        if self.at_kw("with"):
            let n = try self.node(ast.Kind.with_, "")
            discard(self.take())
            n.left = try self.parse_expression()
            try self.expect_op(":")
            n.body = try self.parse_suite()
            return n
        if self.at_kw("asm"):
            return try self.parse_asm()
        if self.at(token.Kind.name) and self.peek_op(1, ":"):
            let label = self.text_of(self.take())
            discard(self.take())
            if self.at_kw("while"):
                return try self.parse_while(label)
            if self.at_kw("for"):
                return try self.parse_for(label)
            discard(try self.fail("a label must be followed by a loop"))
        return try self.parse_simple_statement()

    mutating func parse_simple_statement() -> ast.Node*!:
        if self.at_name("spawn"):
            return try self.fail("`spawn` belongs to full Luce; Base starts a thread through the `thread` module")
        if self.at_kw("let") or self.at_kw("var"):
            return try self.parse_binding()
        if self.at_kw("break") or self.at_kw("continue"):
            let is_break = self.at_kw("break")
            let n = try self.node(ast.Kind.break_ if is_break else ast.Kind.continue_, "")
            discard(self.take())
            if self.at(token.Kind.name):
                n.text = self.text_of(self.take())
            try self.expect_newline()
            return n
        if self.at_kw("return"):
            let n = try self.node(ast.Kind.return_, "")
            discard(self.take())
            if not self.at(token.Kind.newline) and not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
                n.left = try self.parse_expression()
            try self.expect_newline()
            return n
        if self.at_kw("defer") or self.at_kw("errdefer"):
            let is_defer = self.at_kw("defer")
            let n = try self.node(ast.Kind.defer_ if is_defer else ast.Kind.errdefer_, "")
            discard(self.take())
            if self.at_kw("free"):
                n.left = try self.parse_free()
                return n
            let call = try self.parse_expression()
            n.left = call
            if call.kind != ast.Kind.catch_:
                try self.expect_newline()
            return n
        if self.at_kw("recover"):
            let n = try self.node(ast.Kind.recover_, "")
            discard(self.take())
            n.left = try self.parse_expression()
            try self.expect_newline()
            return n
        if self.at_kw("free"):
            return try self.parse_free()
        let e = try self.parse_expression()
        if self.at(token.Kind.operator) and self.is_assign_op(self.text_of(self.cur())):
            let n = try self.taken(ast.Kind.assign)
            n.left = e
            n.right = try self.parse_expression()
            try self.expect_newline()
            return n
        let n = try self.node(ast.Kind.expr_stmt, "")
        n.left = e
        if e.kind != ast.Kind.catch_:
            try self.expect_newline()
        return n

    func is_assign_op(spelling: str) -> bool:
        let ops: str[18] = ["=", "+=", "-=", "*=", "/=", "//=", "%=", "+%=", "-%=", "*%=", "+|=", "-|=", "*|=", "&=", "|=", "^=", "<<=", ">>="]
        for op in ops:
            if op == spelling:
                return true
        return false

    mutating func parse_free() -> ast.Node*!:
        let n = try self.node(ast.Kind.free_, "")
        try self.expect_kw("free")
        try self.expect_op("(")
        n.left = try self.parse_expression()
        try self.expect_op(")")
        if self.eat_kw("in"):
            n.right = try self.parse_else()    # a `catch` after the allocator handles the allocation
        try self.expect_newline()
        return n

    ## `let`/`var` with a name or a tuple pattern, a type, and an initialiser or `---`.
    mutating func parse_binding() -> ast.Node*!:
        let is_let = self.at_kw("let")
        let n = try self.node(ast.Kind.let_ if is_let else ast.Kind.var_, "")
        discard(self.take())
        if self.eat_op("("):
            var tail: ast.Node*? = none
            while not self.at_op(")"):
                let name = try self.node(ast.Kind.name, "")
                name.text = try self.expect_name()
                ast.append(&n.body, &tail, name)
                if not self.eat_op(","):
                    break
            try self.expect_op(")")
        else:
            n.text = try self.expect_name()
        if self.eat_op(":"):
            n.ty = try self.parse_type()
        if self.eat_op("="):
            if self.eat_op("---"):
                n.flags |= ast.flag_uninit
            else:
                n.left = try self.parse_expression()
        elif is_let:
            discard(try self.fail("a let binding requires an initialiser"))
        try self.expect_newline()
        return n

    ## `expression` or `let NAME = expression` after if/while/elif.
    mutating func parse_condition(n: ast.Node*) -> !:
        if self.eat_kw("let"):
            n.flags |= ast.flag_if_let
            let binding = try self.node(ast.Kind.let_, "")
            binding.text = try self.expect_name()
            try self.expect_op("=")
            binding.left = try self.parse_expression()
            n.left = binding
            return
        n.left = try self.parse_expression()

    mutating func parse_if() -> ast.Node*!:
        let n = try self.node(ast.Kind.if_, "")
        discard(self.take())
        try self.parse_condition(n)
        try self.expect_op(":")
        n.body = try self.parse_suite()
        if self.at_kw("elif"):
            let rest = try self.parse_if()       # `elif` reads as a nested if
            n.right = rest
        elif self.eat_kw("else"):
            try self.expect_op(":")
            n.right = try self.parse_suite()
        return n

    mutating func parse_while(label: str) -> ast.Node*!:
        let n = try self.node(ast.Kind.while_, label)
        try self.expect_kw("while")
        try self.parse_condition(n)
        try self.expect_op(":")
        n.body = try self.parse_suite()
        return n

    mutating func parse_for(label: str) -> ast.Node*!:
        let n = try self.node(ast.Kind.for_, label)
        try self.expect_kw("for")
        let binding = try self.node(ast.Kind.let_, "")
        if self.eat_op("("):
            var tail: ast.Node*? = none
            while not self.at_op(")"):
                let name = try self.node(ast.Kind.name, "")
                name.text = try self.expect_name()
                ast.append(&binding.body, &tail, name)
                if not self.eat_op(","):
                    break
            try self.expect_op(")")
        else:
            binding.text = try self.expect_name()
            if self.eat_op(":"):
                binding.ty = try self.parse_type()
        n.left = binding
        try self.expect_kw("in")
        if self.eat_op("&"):
            n.flags |= ast.flag_by_pointer
        n.right = try self.parse_expression()
        try self.expect_op(":")
        n.body = try self.parse_suite()
        return n

    ## `match` as a statement (arms with `:` suites) or an expression (arms with `=>`).
    mutating func parse_match(is_expr: bool) -> ast.Node*!:
        let n = try self.node(ast.Kind.match_expr if is_expr else ast.Kind.match_, "")
        try self.expect_kw("match")
        n.left = try self.parse_expression()
        try self.expect_op(":")
        try self.expect_newline()
        try self.expect_indent()
        var tail: ast.Node*? = none
        while not self.at(token.Kind.dedent) and not self.at(token.Kind.eof):
            if self.at(token.Kind.newline) or self.at(token.Kind.doc_comment):
                discard(self.take())
                continue
            let arm = try self.node(ast.Kind.match_arm, "")
            var ptail: ast.Node*? = none
            while true:
                let p = try self.parse_pattern()
                ast.append(&arm.left, &ptail, p)
                if not self.eat_op(","):
                    break
            if self.eat_kw("if"):
                arm.right = try self.parse_expression()
            if is_expr:
                try self.expect_op("=>")
                arm.body = try self.parse_expression()
                try self.expect_newline()
            else:
                try self.expect_op(":")
                arm.body = try self.parse_suite()
            ast.append(&n.body, &tail, arm)
        discard(self.take())
        return n

    mutating func parse_pattern() -> ast.Node*!:
        let p = try self.node(ast.Kind.pattern, "")
        if self.at_name("_"):
            discard(self.take())
            p.flags |= ast.flag_wildcard
            return p
        if self.eat_op("."):
            let value = try self.node(ast.Kind.case_value, "")
            value.text = try self.expect_member_name()
            if self.eat_op("("):
                var tail: ast.Node*? = none
                while not self.at_op(")"):
                    let b = try self.taken(ast.Kind.name)
                    ast.append(&value.body, &tail, b)
                    if not self.eat_op(","):
                        break
                try self.expect_op(")")
            p.left = value
            return p
        p.left = try self.parse_pattern_literal()
        if self.at_op("..<") or self.at_op("..="):
            p.text = self.text_of(self.take())
            p.right = try self.parse_pattern_literal()
        return p

    mutating func parse_pattern_literal() -> ast.Node*!:
        if self.at_op("-"):
            let neg = try self.taken(ast.Kind.unary)
            neg.left = try self.parse_primary()
            return neg
        return try self.parse_primary()

    # -- expressions ----------------------------------------------------------------------

    pub mutating func parse_expression() -> ast.Node*!:
        try self.enter()
        var e = try self.parse_else()
        if self.at_kw("catch"):
            let handler = try self.node(ast.Kind.catch_, "")
            discard(self.take())
            if self.at(token.Kind.name):
                handler.text = self.text_of(self.take())
            try self.expect_op(":")
            handler.left = e
            handler.body = try self.parse_suite()
            e = handler
        self.leave()
        return e

    mutating func parse_else() -> ast.Node*!:
        let e = try self.parse_conditional()
        if self.at_kw("else"):
            let n = try self.node(ast.Kind.else_, "")
            discard(self.take())
            n.left = e
            if self.at_kw("return") or self.at_kw("break") or self.at_kw("continue"):
                n.right = try self.parse_simple_exit()
            else:
                n.right = try self.parse_else()
            return n
        return e

    ## `else return x`, `else break`: an exit inside an expression.
    mutating func parse_simple_exit() -> ast.Node*!:
        if self.at_kw("return"):
            let n = try self.node(ast.Kind.return_, "")
            discard(self.take())
            if not self.at(token.Kind.newline) and not self.at(token.Kind.dedent) and not self.at(token.Kind.eof) and not self.at_op(")"):
                n.left = try self.parse_expression()
            return n
        let is_break = self.at_kw("break")
        let n = try self.node(ast.Kind.break_ if is_break else ast.Kind.continue_, "")
        discard(self.take())
        if self.at(token.Kind.name):
            n.text = self.text_of(self.take())
        return n

    mutating func parse_conditional() -> ast.Node*!:
        let value = try self.parse_binary(0)
        if self.at_kw("if"):
            let n = try self.node(ast.Kind.conditional, "")
            discard(self.take())
            n.left = value
            n.ty = try self.parse_binary(0)
            try self.expect_kw("else")
            n.right = try self.parse_conditional()
            return n
        return value

    ## Precedence levels, lowest first: or, and, comparison, range, |, ^, &, shifts, additive, multiplicative.
    func level_of(t: token.Token) -> u32:
        if t.kind == token.Kind.keyword:
            let w = self.text_of(t)
            if w == "or":
                return 1
            if w == "and":
                return 2
            return 0
        if t.kind != token.Kind.operator:
            return 0
        let s = self.text_of(t)
        if s == "==" or s == "!=" or s == "<" or s == "<=" or s == ">" or s == ">=":
            return 3
        if s == "..<" or s == "..=":
            return 4
        if s == "|":
            return 5
        if s == "^":
            return 6
        if s == "&":
            return 7
        if s == "<<" or s == ">>":
            return 8
        if s == "+" or s == "-" or s == "+%" or s == "-%" or s == "+|" or s == "-|" or s == "+?" or s == "-?":
            return 9
        if s == "*" or s == "/" or s == "//" or s == "%" or s == "*%" or s == "*|" or s == "*?":
            return 10
        return 0

    mutating func parse_binary(min_level: u32) -> ast.Node*!:
        var left = try self.parse_unary()
        while true:
            let t = self.cur()
            let level = self.level_of(t)
            if level == 0 or level <= min_level:
                break
            let n = try self.taken(ast.Kind.binary)
            n.left = left
            # comparison and range do not chain (§7.3)
            n.right = try self.parse_binary(level if level != 3 and level != 4 else level)
            left = n
            if level == 3 or level == 4:
                if self.level_of(self.cur()) == level:
                    discard(try self.fail("comparisons do not chain; use `and`"))
        return left

    mutating func parse_unary() -> ast.Node*!:
        if self.at_kw("try") or self.at_kw("not"):
            let n = try self.taken(ast.Kind.unary)
            n.left = try self.parse_unary()
            return n
        if self.at_op("-") or self.at_op("-%") or self.at_op("~") or self.at_op("*") or self.at_op("&") or self.at_op("+"):
            let n = try self.taken(ast.Kind.unary)
            n.left = try self.parse_unary()
            return n
        if self.at_op("(") and self.looks_like_cast():
            let n = try self.node(ast.Kind.cast, "")
            discard(self.take())
            n.ty = try self.parse_type()
            try self.expect_op(")")
            n.left = try self.parse_unary()
            return n
        return try self.parse_postfix()

    ## `(T)x`: the parenthesised text names a type and is followed by an operand (§7.5).
    func looks_like_cast() -> bool:
        # `(func(A, B) -> R)expr`: a function-pointer cast (§7.5), the way `objc_msgSend`
        # is called with one C symbol and many shapes
        let first = self.peek(1)
        if first.kind == token.Kind.keyword and self.text_of(first) == "func":
            var depth: usize = 1
            var j: usize = 1
            while depth > 0 and j < 512:
                let tk = self.peek(j)
                if tk.kind == token.Kind.eof:
                    return false
                if tk.kind == token.Kind.operator:
                    let s = self.text_of(tk)
                    if s == "(":
                        depth += 1
                    elif s == ")":
                        depth -= 1
                        if depth == 0:
                            break
                j += 1
            return self.cast_operand_follows(j + 1)
        var i: usize = 1
        var t = self.peek(i)
        if t.kind == token.Kind.operator and self.text_of(t) == "@":
            i += 1
            t = self.peek(i)
        while t.kind == token.Kind.keyword and (self.text_of(t) == "const" or self.text_of(t) == "volatile"):
            i += 1
            t = self.peek(i)
        if t.kind != token.Kind.name:
            return false
        let head = self.text_of(t)
        var typed = self.is_type_word(head)
        i += 1
        t = self.peek(i)
        while t.kind == token.Kind.operator:
            let s = self.text_of(t)
            if s == "." and self.peek(i + 1).kind == token.Kind.name:
                typed = typed or self.is_type_word(self.text_of(self.peek(i + 1))) or head == "c"
                i += 2
            elif s == "*" or s == "?" or s == "*?":
                typed = true
                i += 1
            elif s == "[" and self.peek_op(i + 1, "]"):
                typed = true
                i += 2
            else:
                break
            t = self.peek(i)
        if not (t.kind == token.Kind.operator and self.text_of(t) == ")"):
            return false
        if not typed:
            return false
        return self.cast_operand_follows(i + 1)

    ## What follows a cast's `)` must begin an operand for it to be a cast.
    func cast_operand_follows(at: usize) -> bool:
        let after = self.peek(at)
        if after.kind == token.Kind.name or after.kind == token.Kind.integer or after.kind == token.Kind.float or after.kind == token.Kind.character or after.kind == token.Kind.text or after.kind == token.Kind.format_start:
            return true
        if after.kind == token.Kind.keyword:
            let w = self.text_of(after)
            return w == "self" or w == "try" or w == "not" or w == "true" or w == "false"
        if after.kind == token.Kind.operator:
            let s = self.text_of(after)
            return s == "(" or s == "&" or s == "*" or s == "~" or s == "["
        return false

    func is_type_word(word: str) -> bool:
        let core: str[20] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "isize", "f16", "f32", "f64", "bool", "char", "str", "fmt", "unit", "never", "void"]
        for core_name in core:
            if core_name == word:
                return true
        let b = word.bytes
        return b.length > 0 and b[0] >= 'A' and b[0] <= 'Z'

    mutating func parse_postfix() -> ast.Node*!:
        var e = try self.parse_primary()
        while true:
            if self.at_op(".") and self.at_member_name(1):
                discard(self.take())
                let m = try self.taken(ast.Kind.member)
                m.left = e
                e = m
            elif self.at_op("("):
                let call = try self.node(ast.Kind.call, "")
                call.left = e
                if e.kind == ast.Kind.name and (e.text == "sizeof" or e.text == "alignof" or e.text == "offsetof") and self.type_argument_ahead():
                    call.body = try self.parse_type_argument()
                else:
                    call.body = try self.parse_arguments()
                e = call
            elif self.at_op("[") and self.looks_like_type_args():
                let args = try self.parse_type_args()
                if self.at_op("("):
                    let call = try self.node(ast.Kind.call, "")
                    call.left = e
                    call.ty = args
                    call.body = try self.parse_arguments()
                    e = call
                else:
                    e.ty = args                  # `Map[str, u32].create(...)`
            elif self.at_op("["):
                discard(self.take())
                if self.eat_op("..<"):
                    let s = try self.node(ast.Kind.slice, "")
                    s.left = e
                    s.right = try self.parse_expression()
                    try self.expect_op("]")
                    e = s
                    continue
                let index = try self.parse_expression()
                if index.kind == ast.Kind.binary and index.text == "..<":
                    # `[start..<end]` reads as a range expression; it is a slice
                    let s = try self.node(ast.Kind.slice, "")
                    s.left = e
                    s.body = index.left
                    s.right = index.right
                    s.start = index.start
                    try self.expect_op("]")
                    e = s
                    continue
                if self.at_op("..<") or self.at_op(".."):
                    let s = try self.node(ast.Kind.slice, "")
                    s.left = e
                    s.body = index
                    if self.text_of(self.take()) == "..<":
                        s.right = try self.parse_expression()
                    try self.expect_op("]")
                    e = s
                    continue
                let ix = try self.node(ast.Kind.index, "")
                ix.left = e
                ix.body = index
                try self.expect_op("]")
                e = ix
            else:
                break
        return e

    ## `name[T](...)`: a bracket after a name holding types and followed by `(`.
    func looks_like_type_args() -> bool:
        var i: usize = 1
        var depth: u32 = 1
        while depth > 0:
            let t = self.peek(i)
            if t.kind == token.Kind.eof or t.kind == token.Kind.newline:
                return false
            if t.kind == token.Kind.operator:
                let s = self.text_of(t)
                if s == "[":
                    depth += 1
                elif s == "]":
                    depth -= 1
            i += 1
        let first = self.peek(1)
        if first.kind != token.Kind.name:
            return false
        # `module.Type` counts as a type word too
        let qualified = self.peek_op(2, ".") and self.peek(3).kind == token.Kind.name and self.is_type_word(self.text_of(self.peek(3)))
        if not self.is_type_word(self.text_of(first)) and not qualified:
            return false
        return self.peek_op(i, "(") or self.peek_op(i, ".")

    mutating func parse_type_args() -> ast.Node*!:
        let list = try self.node(ast.Kind.type_, "")
        try self.expect_op("[")
        var tail: ast.Node*? = none
        while not self.at_op("]"):
            let t = try self.parse_type()
            ast.append(&list.body, &tail, t)
            if not self.eat_op(","):
                break
        try self.expect_op("]")
        return list

    ## Whether `sizeof(` is followed by a type rather than an expression: a type word,
    ## `module.Type`, a parenthesised type, or `func`, `const`, `volatile` (§5.11).
    func type_argument_ahead() -> bool:
        let t = self.peek(1)
        if t.kind == token.Kind.operator and self.text_of(t) == "@":
            return true
        if t.kind == token.Kind.operator and self.text_of(t) == "(":
            let inner = self.peek(2)
            return inner.kind == token.Kind.name and self.is_type_word(self.text_of(inner))
        if t.kind == token.Kind.keyword:
            let w = self.text_of(t)
            return w == "func" or w == "const" or w == "volatile"
        return t.kind == token.Kind.name and (self.is_type_word(self.text_of(t)) or self.qualified_type_ahead(1))

    ## Whether `(` opens a parenthesised type: a type word, `func`, `const`, or `volatile`.
    func paren_type_ahead() -> bool:
        let inner = self.peek(1)
        if inner.kind == token.Kind.keyword:
            let w = self.text_of(inner)
            return w == "func" or w == "const" or w == "volatile"
        return inner.kind == token.Kind.name and (self.is_type_word(self.text_of(inner)) or self.qualified_type_ahead(1))

    ## `(Type)` or `(Type, field)`: the first argument is a type, the rest are expressions.
    mutating func parse_type_argument() -> ast.Node*?!:
        try self.expect_op("(")
        let first = try self.node(ast.Kind.argument, "")
        first.left = try self.parse_type()
        var list: ast.Node*? = first
        var tail: ast.Node*? = first
        while self.eat_op(","):
            let more = try self.node(ast.Kind.argument, "")
            more.left = try self.parse_expression()
            ast.append(&list, &tail, more)
        try self.expect_op(")")
        return list

    mutating func parse_arguments() -> ast.Node*?!:
        try self.expect_op("(")
        var list: ast.Node*? = none
        var tail: ast.Node*? = none
        while not self.at_op(")"):
            let a = try self.node(ast.Kind.argument, "")
            if self.at(token.Kind.name) and self.peek_op(1, "=") :
                a.text = self.text_of(self.take())
                discard(self.take())
            a.left = try self.parse_expression()
            ast.append(&list, &tail, a)
            if not self.eat_op(","):
                break
        try self.expect_op(")")
        return list

    mutating func parse_primary() -> ast.Node*!:
        let t = self.cur()
        if t.kind == token.Kind.integer or t.kind == token.Kind.float or t.kind == token.Kind.character or t.kind == token.Kind.text or t.kind == token.Kind.bytes or t.kind == token.Kind.raw:
            return try self.taken(ast.Kind.literal)
        if t.kind == token.Kind.format_start:
            return try self.parse_formatted()
        if t.kind == token.Kind.keyword:
            let w = self.text_of(t)
            if w == "true" or w == "false" or w == "none":
                return try self.taken(ast.Kind.literal)
            if w == "self":
                discard(self.take())
                return try self.node(ast.Kind.self_, "self")
            if w == "match":
                return try self.parse_match(true)
            if w == "new":
                return try self.parse_new()
            if w == "alloc":
                return try self.parse_alloc()
            discard(try self.fail("expected an expression"))
        if t.kind == token.Kind.name:
            if self.looks_like_span_constructor():
                let s = try self.node(ast.Kind.span_make, "")
                s.ty = try self.parse_type()
                s.body = try self.parse_arguments()
                return s
            return try self.taken(ast.Kind.name)
        if t.kind == token.Kind.operator:
            let s = self.text_of(t)
            if s == ".":
                discard(self.take())
                let value = try self.node(ast.Kind.case_value, "")
                value.text = try self.expect_member_name()
                if self.at_op("("):
                    value.body = try self.parse_arguments()
                return value
            if s == "[":
                let a = try self.node(ast.Kind.array_lit, "")
                discard(self.take())
                var tail: ast.Node*? = none
                while not self.at_op("]"):
                    let e = try self.parse_expression()
                    ast.append(&a.body, &tail, e)
                    if not self.eat_op(","):
                        break
                try self.expect_op("]")
                return a
            if s == "(":
                if self.looks_like_lambda():
                    return try self.parse_lambda()
                discard(self.take())
                if self.eat_op(")"):
                    return try self.node(ast.Kind.unit_, "")
                let first = try self.parse_expression()
                if self.at_op(","):
                    let tuple = try self.node(ast.Kind.tuple, "")
                    var tail: ast.Node*? = none
                    ast.append(&tuple.body, &tail, first)
                    while self.eat_op(","):
                        if self.at_op(")"):
                            break
                        let e = try self.parse_expression()
                        ast.append(&tuple.body, &tail, e)
                    try self.expect_op(")")
                    return tuple
                try self.expect_op(")")
                let g = try self.node(ast.Kind.group, "")
                g.left = first
                return g
        return try self.fail("expected an expression")

    ## `u8[](pointer, count)`: a type, `[]`, then arguments.
    func looks_like_span_constructor() -> bool:
        var i: usize = 1
        while self.peek_op(i, ".") and self.peek(i + 1).kind == token.Kind.name:
            i += 2
        return self.peek_op(i, "[") and self.peek_op(i + 1, "]") and self.peek_op(i + 2, "(")

    ## `(a, b) => body` or `() => body`: a parenthesised list followed by `=>`.
    func looks_like_lambda() -> bool:
        var i: usize = 1
        var depth: u32 = 1
        while depth > 0:
            let t = self.peek(i)
            if t.kind == token.Kind.eof:
                return false
            if t.kind == token.Kind.operator:
                let s = self.text_of(t)
                if s == "(":
                    depth += 1
                elif s == ")":
                    depth -= 1
            i += 1
        return self.peek_op(i, "=>")

    mutating func parse_lambda() -> ast.Node*!:
        let n = try self.node(ast.Kind.lambda, "")
        try self.expect_op("(")
        var tail: ast.Node*? = none
        while not self.at_op(")"):
            let p = try self.node(ast.Kind.param, "")
            p.text = try self.expect_name()
            if self.eat_op(":"):
                p.ty = try self.parse_type()
            ast.append(&n.right, &tail, p)
            if not self.eat_op(","):
                break
        try self.expect_op(")")
        try self.expect_op("=>")
        n.body = try self.parse_expression()
        return n

    mutating func parse_formatted() -> ast.Node*!:
        let n = try self.node(ast.Kind.formatted, "")
        discard(self.take())
        var tail: ast.Node*? = none
        while not self.at(token.Kind.format_end):
            if self.at(token.Kind.format_text):
                let part = try self.taken(ast.Kind.format_text)
                ast.append(&n.body, &tail, part)
            elif self.eat_op("{"):
                let field = try self.node(ast.Kind.format_field, "")
                field.left = try self.parse_expression()
                try self.expect_op("}")
                ast.append(&n.body, &tail, field)
            else:
                discard(try self.fail("expected formatted string text or a field"))
        discard(self.take())
        return n

    ## `new T(args)`, `new T[n]`, `new Kind.case(args)`, `new T`, with `in allocator`.
    mutating func parse_new() -> ast.Node*!:
        let n = try self.node(ast.Kind.new_, "")
        try self.expect_kw("new")
        n.ty = try self.parse_type()
        if self.at_op("("):
            n.body = try self.parse_arguments()
        elif self.eat_op("."):
            let value = try self.node(ast.Kind.case_value, "")
            value.text = try self.expect_member_name()
            if self.at_op("("):
                value.body = try self.parse_arguments()
            n.body = value
        if self.eat_kw("in"):
            n.right = try self.parse_else()    # a `catch` after the allocator handles the allocation
        return n

    mutating func parse_alloc() -> ast.Node*!:
        let n = try self.node(ast.Kind.alloc_, "")
        try self.expect_kw("alloc")
        # `alloc (T)[n]` parenthesises a type; `alloc(size, alignment)` opens on an expression
        if self.at_op("(") and not self.paren_type_ahead():
            n.body = try self.parse_arguments()
        else:
            n.ty = try self.parse_type()
        if self.eat_kw("in"):
            n.right = try self.parse_else()    # a `catch` after the allocator handles the allocation
        return n

    # -- types ----------------------------------------------------------------------------

    pub mutating func parse_type() -> ast.Node*!:
        var flags: u32 = 0
        # `@` marks the whole type, suffixes included: `@Node*?` is an atomic nullable pointer
        let atomic = self.eat_op("@")
        while self.at_kw("const") or self.at_kw("volatile"):
            if self.eat_kw("const"):
                flags |= ast.flag_const
            else:
                discard(self.take())
                flags |= ast.flag_volatile
        var t = try self.parse_type_core()
        t.flags |= flags
        var pointee = false
        while true:
            if self.at_op("*") or self.at_op("*?"):
                let nullable = self.at_op("*?")
                discard(self.take())
                pointee = true
                let p = try self.node(ast.Kind.type_, "*")
                p.flags |= ast.flag_star
                p.left = t
                t = p
                if nullable:
                    let o = try self.node(ast.Kind.type_, "?")
                    o.flags |= ast.flag_optional
                    o.left = t
                    t = o
            elif self.at_op("[") and self.array_suffix_ahead():
                discard(self.take())
                let s = try self.node(ast.Kind.type_, "[")
                s.left = t
                if self.eat_op("]"):
                    s.flags |= ast.flag_span
                else:
                    s.flags |= ast.flag_array
                    s.right = try self.parse_expression()
                    try self.expect_op("]")
                t = s
            else:
                break
        if (flags & ast.flag_volatile) != 0 and not pointee:
            return try self.fail("`volatile` qualifies a pointee: write `volatile T*` (§15.2)")
        if self.eat_op("?"):
            let o = try self.node(ast.Kind.type_, "?")
            o.flags |= ast.flag_optional
            o.left = t
            t = o
        if atomic:
            t.flags |= ast.flag_atomic
        if self.eat_op("!"):
            let f = try self.node(ast.Kind.type_, "!")
            f.flags |= ast.flag_fallible
            f.left = t
            t = f
        return t

    ## `[` after a type: an array or span suffix unless it holds type arguments.
    func array_suffix_ahead() -> bool:
        let t = self.peek(1)
        if t.kind == token.Kind.operator and self.text_of(t) == "]":
            return true
        if t.kind == token.Kind.integer or t.kind == token.Kind.keyword:
            return true
        if t.kind == token.Kind.operator and self.text_of(t) == "(":
            return true
        if t.kind == token.Kind.name:
            let w = self.text_of(t)
            if w == "sizeof" or w == "alignof":
                return true
            # `List[ir.Instr]`: a module-qualified type is a type argument, not a length
            return not self.is_type_word(w) and not self.qualified_type_ahead(1)
        return false

    ## Whether the tokens from `ahead` spell `module.Type`.
    func qualified_type_ahead(ahead: usize) -> bool:
        return self.peek(ahead).kind == token.Kind.name and self.peek_op(ahead + 1, ".") and self.peek(ahead + 2).kind == token.Kind.name and self.is_type_word(self.text_of(self.peek(ahead + 2)))

    mutating func parse_type_core() -> ast.Node*!:
        if self.eat_kw("func"):
            let t = try self.node(ast.Kind.type_, "func")
            t.flags |= ast.flag_func_type
            try self.expect_op("(")
            var tail: ast.Node*? = none
            while not self.at_op(")"):
                let p = try self.parse_type()
                ast.append(&t.body, &tail, p)
                if not self.eat_op(","):
                    break
            try self.expect_op(")")
            try self.expect_op("->")
            t.left = try self.parse_type()
            return t
        if self.at_name("void"):
            let t = try self.node(ast.Kind.type_, "void")
            discard(self.take())
            t.flags |= ast.flag_void
            return t
        if self.eat_op("("):
            let first = try self.parse_type()
            if self.eat_op(","):
                let tuple = try self.node(ast.Kind.type_, "tuple")
                tuple.flags |= ast.flag_tuple_type
                var tail: ast.Node*? = none
                ast.append(&tuple.body, &tail, first)
                while not self.at_op(")"):
                    let next = try self.parse_type()
                    ast.append(&tuple.body, &tail, next)
                    if not self.eat_op(","):
                        break
                try self.expect_op(")")
                return tuple
            try self.expect_op(")")
            let g = try self.node(ast.Kind.type_, "(")
            g.left = first
            return g
        if not self.at(token.Kind.name):
            discard(try self.fail("expected a type"))
        let first = self.take()
        var last = first
        while self.at_op(".") and self.peek(1).kind == token.Kind.name and (self.is_type_word(self.text_of(self.peek(1))) or self.text_of(first) == "c"):
            discard(self.take())
            last = self.take()
        let t = try self.node(ast.Kind.type_, self.src.text(first.start, last.end))
        if self.at_op("[") and not self.array_suffix_ahead():
            t.body = (try self.parse_type_args()).body
        return t

# mark: Entry point and tests =================================================================

## Parse `text` as a module in the current allocator.
pub func parse_text(text: str, scratch: u8[]) -> ast.Node*!:
    let src = try source.Source.over("test", text.bytes)
    var p = try Parser.over(src, scratch)
    return try p.parse_module()

test "a function with a body":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let m = try parse_text("pub func add(a: i64, b: i64 = 2) -> i64:\n    return a + b\n", scratch)
        assert(ast.count(m.body) == 1)
        let f = m.body else return
        assert(f.kind == ast.Kind.func_)
        assert(f.has(ast.flag_pub))
        assert(ast.count(f.right) == 2)
        let block = f.body else return
        assert(ast.count(block.body) == 1)

test "struct, enum, and union declarations":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let text = "struct P: A:\n    var x: i64\n    func get() -> i64: return self.x\nenum K as u8:\n    a = 1\n    b(v: i64)\nunion U:\n    i: i64\n    f: f64\n"
        let m = try parse_text(text, scratch)
        assert(ast.count(m.body) == 3)
        let s = m.body else return
        assert(s.kind == ast.Kind.struct_)
        assert(ast.count(s.body) == 2)

test "expression precedence and casts":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let m = try parse_text("let v = (u8)x + 2 * 3 == 8 and not y\n", scratch)
        let content = m.body else return
        let e = content.left else return
        assert(e.kind == ast.Kind.binary)
        assert(e.text == "and")
        let l = e.left else return
        assert(l.text == "==")
        let sum = l.left else return
        assert(sum.text == "+")
        let cast = sum.left else return
        assert(cast.kind == ast.Kind.cast)

test "statements and layout":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let text = "func f() -> !:\n    var i: usize = 0\n    outer: while i < 3:\n        if let v = g(i):\n            i += 1\n        elif i == 2:\n            break outer\n        else:\n            continue\n    for (k, x) in items.indexed():\n        defer free(x)\n    match k:\n        .a, .b(v): return\n        1..<3 if k > 0: pass_()\n        _: trap()\n    let r = risky() catch failure:\n        recover 0\n"
        let m = try parse_text(text, scratch)
        let f = m.body else return
        let block = f.body else return
        assert(ast.count(block.body) == 5)

test "types":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let m = try parse_text("var a: const u8[]?\nvar b: func(i64, Node*?) -> unit\nvar c: (i64, str)\nvar d: Map[str, u32]\nvar e: @u32\n", scratch)
        assert(ast.count(m.body) == 5)
        let a = m.body else return
        let at = a.ty else return
        assert(at.has(ast.flag_optional))

test "a syntax error names its position":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    var where = ""
    with arena:
        let result = parse_text("func f(:\n", scratch) catch failure:
            where = failure.message
            recover try ast.Node.make(ast.Kind.unit_, "", 0, 0)
        discard(result)
    assert(where == "test:1:8: expected a name")

test "uninitialised var":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let m = try parse_text("func f():\n    var a: i64 = ---\n", scratch)
        let f = m.body else return
        let block = f.body else return
        let v = block.body else return
        assert(v.has(ast.flag_uninit))

test "dash operator token":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let src = try source.Source.over("t", "= ---".bytes)
        var p = try Parser.over(src, scratch)
        assert(p.count == 3)
        let t1 = p.tokens[1]
        assert(t1.kind == token.Kind.operator)
        assert(t1.end - t1.start == 3)
        assert(p.text_of(t1) == "---")
        assert(p.at_op("="))
        assert(p.eat_op("="))
        assert(p.at_op("---"))
        assert(p.eat_op("---"))
        assert(p.at(token.Kind.eof))
