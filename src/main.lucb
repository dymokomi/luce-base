#==============================================================================================
#
#   main - The luce-base command
#
#   DESCRIPTION:
#       `lex FILE` prints one token per line; `parse FILE` prints the syntax tree; `check
#       FILE` reports the first semantic error or nothing. Each command reads the file into
#       one arena and runs the stages in order.
#
#==============================================================================================

import back.arm64
import front.ast
import sema.check
import back.emit
import front.lexer
import back.lower
import front.parser
import support.runtime
import front.source
import front.token

let version: str = "0.1"

func usage(out: Writer) -> !:
    try out.write("usage: luce-base lex FILE\n       luce-base parse FILE\n       luce-base check FILE\n       luce-base build FILE [-o OUT] [--release] [--emit=c] [--native] [--debug] [--emit=asm]\n       luce-base test FILE [--native]\n       luce-base --version\n")

# mark: Building ===============================================================================

## What a build was asked for.
struct Options:
    var output: str
    var release: bool
    var emit_c: bool
    var run_tests: bool
    var native: bool
    var debug: bool

## Check FILE and its imports, then generate C for the whole program.
func generate(path: cstr, mode: u32) -> str!:
    var c = try check.Checker.create(scratch_of())
    try c.add_prelude()
    try c.load(path)
    try c.check_program()
    let entry = c.modules.get(c.modules.count - 1).tree
    var actual = mode
    if mode == 0 and check.find_decl(entry, "main") == none:
        if check.find_decl(entry, "answer") == none:
            error(build_failed, "this module has no `main` to build a program from; `check` it, or `test` it")
        actual = 2
    used_mode = actual
    if native_backend:
        var l = try lower.Lowerer.create(&c, entry)
        l.debug = debug_backend
        try l.program(actual)
        var g = try arm64.Generator.create(&l.program_unit)
        try g.generate()
        return g.text()
    var e = try emit.Emitter.create(&c, entry)
    try e.program(actual)
    return e.text()

## The backend the current command chose: C through the host compiler, or arm64 assembly.
var native_backend: bool
## `--debug`: the native backend describes every frame and calls the `debug` module.
var debug_backend: bool

var scratch_bytes: u8[4096]
## The mode the last `generate` settled on: 2 means an `answer()` program that links `start.c`.
var used_mode: u32

func scratch_of() -> u8[]:
    return scratch_bytes

## Turn the generated text into `exe` in a scratch directory: assembly through the
## host assembler and linker, C through the host C compiler.
func compile(text: str, exe: str, release: bool, with_start: bool) -> !:
    let mktemp_args: cstr[2] = ["-d", "/tmp/luce-base.XXXXXX"]
    let made = try process.run("mktemp", mktemp_args)
    let (status, dir_text, unused_err) = made
    discard(unused_err.length)
    if status != 0:
        error(build_failed, "could not create a scratch directory")
    # the scratch names must end in NUL for the C library; `format` appends one
    var names: u8[4096]
    let dir = try format(names[3072..], f"{trim(dir_text)}")
    defer remove_tree((cstr)dir)
    if native_backend:
        try assemble_and_link(dir, names[..<3072], text, exe)
        return
    let gen_path = try format(names[..<512], f"{dir}/gen.s" if native_backend else f"{dir}/gen.c")
    let header_path = try format(names[512..<1024], f"{dir}/lucb_rt.h")
    let runtime_path = try format(names[1024..<1536], f"{dir}/lucb_rt.c")
    let start_path = try format(names[1536..<2048], f"{dir}/start.c")
    let err_path = try format(names[2048..<2560], f"{dir}/cc.err")
    try files.write((cstr)gen_path, text.bytes)
    try files.write((cstr)header_path, runtime.header.bytes)
    try files.write((cstr)runtime_path, runtime.source.bytes)
    if with_start:
        try files.write((cstr)start_path, runtime.start.bytes)
    var include = try format(names[2560..<3072], f"-I{dir}")
    var cc_args: cstr[12] = ---
    cc_args[0] = "-std=gnu11"
    cc_args[1] = "-Wall"
    cc_args[2] = "-Werror"
    cc_args[3] = "-O2" if release and not native_backend else "-O0"
    cc_args[4] = (cstr)include
    cc_args[5] = (cstr)gen_path
    cc_args[6] = (cstr)runtime_path
    cc_args[7] = (cstr)start_path if with_start else "-fno-common"
    cc_args[8] = "-lm"
    cc_args[9] = "-pthread"
    cc_args[10] = "-o"
    cc_args[11] = (cstr)exe
    let result = try process.run("cc", cc_args)
    let (cc_status, cc_out, cc_err) = result
    discard(cc_out.length)
    if cc_status != 0:
        let out = io.stderr()
        try out.write(cc_err)
        error(build_failed, "the C compiler rejected the generated code")
    discard(err_path)

## `as` over the assembly, then `ld` against the system library found through `xcrun`.
func assemble_and_link(dir: str, names: u8[], text: str, exe: str) -> !:
    let asm_path = try format(names[..<512], f"{dir}/gen.s")
    let object_path = try format(names[512..<1024], f"{dir}/gen.o")
    try files.write((cstr)asm_path, text.bytes)
    var as_args: cstr[3] = ---
    as_args[0] = "-o"
    as_args[1] = (cstr)object_path
    as_args[2] = (cstr)asm_path
    let assembled = try process.run("as", as_args)
    let (as_status, as_out, as_err) = assembled
    discard(as_out.length)
    if as_status != 0:
        try io.stderr().write(as_err)
        error(build_failed, "the assembler rejected the generated code")
    let sdk_args: cstr[1] = ["--show-sdk-path"]
    let found = try process.run("xcrun", sdk_args)
    let (sdk_status, sdk_out, sdk_err) = found
    discard(sdk_err.length)
    if sdk_status != 0:
        error(build_failed, "xcrun could not find the SDK")
    let sdk = try format(names[1024..<2048], f"{trim(sdk_out)}")
    var ld_args: cstr[8] = ---
    ld_args[0] = "-arch"
    ld_args[1] = "arm64"
    ld_args[2] = "-syslibroot"
    ld_args[3] = (cstr)sdk
    ld_args[4] = "-lSystem"
    ld_args[5] = "-o"
    ld_args[6] = (cstr)exe
    ld_args[7] = (cstr)object_path
    let linked = try process.run("ld", ld_args)
    let (ld_status, ld_out, ld_err) = linked
    discard(ld_out.length)
    if ld_status != 0:
        try io.stderr().write(ld_err)
        error(build_failed, "the linker rejected the generated code")

## `build FILE`: check, generate, compile.
func build_file(path: cstr, options: Options) -> !:
    let backing = try alloc u8[arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = FixedBuffer.over(backing)
    with arena:
        native_backend = options.native
        debug_backend = options.debug and options.native
        let text = try generate(path, 1 if options.run_tests else 0)
        if options.emit_c:
            if options.output.length > 0:
                try files.write((cstr)options.output, text.bytes)
            else:
                try io.stdout().write(text)
            return
        var exe = options.output
        if exe.length == 0:
            exe = "a.out"
        try compile(text, exe, options.release, used_mode == 2 and not native_backend)

## `test FILE`: build the test runner into a scratch file and run it.
func test_file(path: cstr, native: bool) -> i32!:
    let backing = try alloc u8[arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = FixedBuffer.over(backing)
    with arena:
        native_backend = native
        let text = try generate(path, 1)
        let mktemp_args: cstr[1] = ["/tmp/luce-base-test.XXXXXX"]
        let made = try process.run("mktemp", mktemp_args)
        let (status, exe_text, unused_err) = made
        discard(unused_err.length)
        if status != 0:
            error(build_failed, "could not create a scratch file")
        var exe_name: u8[512]
        let exe = try format(exe_name, f"{trim(exe_text)}")
        # the scratch file goes whether the build or the run fails
        defer remove_file((cstr)exe)
        try compile(text, exe, false, false)
        var run_args: cstr[1] = ---
        run_args[0] = (cstr)exe
        let ran = try process.run((cstr)exe, run_args)
        let (code, out, err) = ran
        try io.stdout().write(out)
        try io.stderr().write(err)
        return code

func remove_file(path: cstr):
    remove_path("-f", path)

func remove_tree(path: cstr):
    remove_path("-rf", path)

func remove_path(flag: cstr, path: cstr):
    var rm_args: cstr[2] = ---
    rm_args[0] = flag
    rm_args[1] = path
    let ran = process.run("rm", rm_args) catch:
        return
    let (code, out, err) = ran
    discard(code)
    discard(out.length)
    discard(err.length)

pub let build_failed: ErrorCode = ErrorCode.package(13)

## Text without its trailing newline.
func trim(text: str) -> str:
    var end = text.length
    let b = text.bytes
    while end > 0 and (b[end - 1] == '\n' or b[end - 1] == ' '):
        end -= 1
    return (str)b[..<end]

## Check FILE and the modules it imports from its directory; silence means success.
func check_file(path: cstr) -> !:
    let backing = try alloc u8[arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = FixedBuffer.over(backing)
    var scratch: u8[4096]
    with arena:
        var c = try check.Checker.create(scratch)
        try c.add_prelude()
        try c.load(path)
        try c.check_program()

## Trees and tokens live in one arena taken from the process heap; nothing is
## freed until the command ends.
let arena_size: usize = 536870912

func parse_file(path: cstr, out: Writer) -> !:
    let backing = try alloc u8[arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = FixedBuffer.over(backing)
    var scratch: u8[4096]
    with arena:
        let src = try source.Source.load(path)
        var p = try parser.Parser.over(src, scratch)
        let module = try p.parse_module()
        try ast.dump(out, module, 0)

func lex_file(path: cstr, out: Writer) -> !:
    let backing = try alloc u8[arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = FixedBuffer.over(backing)
    with arena:
        let src = try source.Source.load(path)
        var lx = lexer.Lexer.over(src)
        while true:
            let t = try lx.next()
            if t.kind == token.Kind.eof:
                break
            if t.kind == token.Kind.newline or t.kind == token.Kind.indent or t.kind == token.Kind.dedent:
                try out.write(f"{t.line}:{t.column} {t.label()}\n")
            else:
                try out.write(f"{t.line}:{t.column} {t.label()} {lx.text(t)}\n")

pub func main(arguments: cstr[]) -> i32!:
    let out = io.stdout()
    if arguments.length < 2:
        try usage(io.stderr())
        return 2
    let command = (str)arguments[1]
    if command == "--version":
        try out.write(f"luce-base {version}\n")
        return 0
    if command == "parse" and arguments.length == 3:
        parse_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "build" and arguments.length >= 3:
        var options = Options(output = "", release = false, emit_c = false, run_tests = false, native = false, debug = false)
        var i: usize = 3
        while i < arguments.length:
            let a = (str)arguments[i]
            if a == "-o" and i + 1 < arguments.length:
                options.output = (str)arguments[i + 1]
                i += 1
            elif a == "--release":
                options.release = true
            elif a == "--emit=c" or a == "--emit=asm":
                options.emit_c = true
            elif a == "--native":
                options.native = true
            elif a == "--debug":
                options.debug = true
            else:
                try io.stderr().write(f"luce-base: unexpected argument `{a}`\n")
                return 2
            i += 1
        build_file(arguments[2], options) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "test" and (arguments.length == 3 or (arguments.length == 4 and (str)arguments[3] == "--native")):
        let code = test_file(arguments[2], arguments.length == 4) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            recover 1
        return code
    if command == "check" and arguments.length == 3:
        check_file(arguments[2]) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "lex" and arguments.length == 3:
        lex_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    try usage(io.stderr())
    return 2
