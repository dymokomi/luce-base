#==============================================================================================
#
#   main - The luce-base command
#
#   DESCRIPTION:
#       `lex FILE` prints one token per line; `parse FILE` prints the syntax tree; `check
#       FILE` reports the first semantic error or nothing. Each command reads the file into
#       one arena and runs the stages in order.
#
#==============================================================================================

import c
import back.backend
import back.header
import back.names
import support.manifest
import files
import front.ast
import front.lexer
import front.parser
import front.source
import front.token
import io
import memory
import process
import sema.check
import support.buffer
import support.runtime

let version: str = "0.1"

func usage(out: io.Writer) -> !:
    try out.write("usage: luce-base lex FILE\n       luce-base parse FILE\n       luce-base check FILE\n       luce-base build FILE [-o OUT] [--release] [--emit=c] [--native] [--debug] [--emit=asm] [--lib] [--freestanding] [--target] [--profile diagnostic] [-W] [-lNAME] [-LDIR] [-framework NAME]\n       luce-base test FILE [--native]\n       luce-base --version\n")

# mark: Building ===============================================================================

## What a build was asked for.
struct Options:
    var output: str
    var release: bool
    var emit_c: bool
    var run_tests: bool
    var native: bool
    var debug: bool
    ## `--lib`: a library and its header rather than a program (§17.6).
    var library: bool
    ## `--freestanding`: no startup shim; the program's own `_start` is the entry (§19.4).
    var freestanding: bool
    ## `--target` with no name: list the targets and the asm architectures the program covers.
    var list_targets: bool
    ## `--profile diagnostic`: filled `---` storage and a quarantining allocator (§19.4).
    var diagnostic: bool
    ## `-lNAME` and `-LDIR`: libraries to link and where to find them.
    var libraries: (c.str?)[16]
    var library_count: usize
    var library_dirs: (c.str?)[8]
    var library_dir_count: usize
    ## `-framework NAME`: an Apple framework to link.
    var frameworks: (c.str?)[16]
    var framework_count: usize

## Element `k` of a link-flag list; an empty slot reads as empty text. A `c.str` has no zero
## value (§6.1), so the lists hold `c.str?`.
func at(list: (c.str?)[], k: usize) -> c.str:
    return list[k] else (c.str)""

## Whether `text` begins with `prefix`. The compiler's own sources stay within the seed's
## modules, so this is written here rather than taken from `strings`.
func starts_with(text: str, prefix: str) -> bool:
    if text.length < prefix.length:
        return false
    var i: usize = 0
    while i < prefix.length:
        if text.bytes[i] != prefix.bytes[i]:
            return false
        i += 1
    return true

## Whether `flag` is among the arguments.
func has_argument(arguments: c.str[], flag: str) -> bool:
    for a in arguments:
        if (str)a == flag:
            return true
    return false

## `-W`: the checker's warnings go to standard error (§19.6); without it they are silent.
var show_warnings: bool = false

func report_warnings(checker: check.Checker*) -> !:
    if not show_warnings:
        return
    var i: usize = 0
    while i < checker.warnings.count:
        try io.stderr().write(f"luce-base: {checker.warnings.get(i)}\n")
        i += 1

## Check FILE and its imports, then generate C for the whole program.
func generate(path: c.str, mode: u32) -> str!:
    var checker = try checked(path)
    let entry = checker.modules.get(checker.modules.count - 1).tree
    var actual = mode
    if mode == 4 and check.find_decl(entry, "_start") == none:
        error(build_failed, "a freestanding program supplies `export naked func _start` (§19.4)")
    if mode == 0 and check.find_decl(entry, "main") == none:
        if check.find_decl(entry, "answer") == none:
            error(build_failed, "this module has no `main` to build a program from; `check` it, or `test` it")
        actual = 2
    used_mode = actual
    return try translate(&checker, entry, actual)

## `--lib`: the program as a library with no entry, and the header of its exports (§17.6).
func generate_library(path: c.str) -> (str, str)!:
    var checker = try checked(path)
    let entry = checker.modules.get(checker.modules.count - 1).tree
    used_mode = 3
    let code = try translate(&checker, entry, 3)
    var text = try buffer.Buffer.create(4096)
    try header.write(&checker, &text)
    return (code, try names.keep(&text))

## The program at `path`, checked, with its warnings reported.
func checked(path: c.str) -> check.Checker!:
    let m = try manifest.load((str)path)
    package = m
    names.export_prefix = m.symbol_prefix
    var checker = try check.Checker.create(scratch_of())
    checker.package_name = m.name
    try checker.add_prelude()
    try checker.load(path)
    try checker.check_program()
    try report_warnings(&checker)
    return checker

## The checked program through the backend the command chose.
func translate(checker: check.Checker*, entry: ast.Node*, mode: u32) -> str!:
    if native_backend:
        var native = try backend.NativeBackend.over(checker, entry, debug_backend, diagnostic_profile)
        let target: backend.Backend = &native
        return try target.compile(mode)
    var host_c = try backend.CBackend.over(checker, entry, diagnostic_profile)
    let target: backend.Backend = &host_c
    return try target.compile(mode)

## The backend the current command chose: C through the host compiler, or arm64 assembly.
var native_backend: bool
## `--debug`: the native backend describes every frame and calls the `debug` module.
var debug_backend: bool
## `--freestanding`: the program's own `_start` is the entry, and no shim is linked (§19.4).
var freestanding: bool
## `--profile diagnostic`: filled `---` storage and a quarantining allocator (§19.4).
var diagnostic_profile: bool
## The manifest of the package being built (§16.4): its native inputs reach the build.
var package: manifest.Manifest
## `-lNAME`, `-LDIR`, and `-framework NAME` of the current build, for the link step.
var link_libraries: (c.str?)[16]
var link_library_count: usize
var link_dirs: (c.str?)[8]
var link_dir_count: usize
var link_frameworks: (c.str?)[16]
var link_framework_count: usize

var scratch_bytes: u8[4096]
## The mode the last `generate` settled on: 2 means an `answer()` program that links `start.c`.
var used_mode: u32

func scratch_of() -> u8[]:
    return scratch_bytes

## Turn the generated text into `exe` in a scratch directory: assembly through the
## host assembler and linker, C through the host C compiler.
func compile(text: str, exe: str, release: bool, with_start: bool) -> !:
    let mktemp_args: c.str[2] = ["-d", "/tmp/luce-base.XXXXXX"]
    let made = try process.run("mktemp", mktemp_args)
    let (status, dir_text, unused_err) = made
    discard(unused_err.length)
    if status != 0:
        error(build_failed, "could not create a scratch directory")
    # the scratch names must end in NUL for the C library; `format` appends one
    var name_bytes: u8[4096]
    let dir = try format(name_bytes[3072..], f"{trim(dir_text)}")
    defer remove_tree((c.str)dir)
    if native_backend:
        try assemble_and_link(dir, name_bytes[..<3072], text, exe)
        return
    let gen_path = try format(name_bytes[..<512], f"{dir}/gen.s" if native_backend else f"{dir}/gen.c")
    let header_path = try format(name_bytes[512..<1024], f"{dir}/lucb_rt.h")
    let runtime_path = try format(name_bytes[1024..<1536], f"{dir}/lucb_rt.c")
    let start_path = try format(name_bytes[1536..<2048], f"{dir}/start.c")
    let err_path = try format(name_bytes[2048..<2560], f"{dir}/cc.err")
    try files.write((c.str)gen_path, text.bytes)
    try files.write((c.str)header_path, runtime.header.bytes)
    try files.write((c.str)runtime_path, runtime.source.bytes)
    if with_start:
        try files.write((c.str)start_path, runtime.start.bytes)
    var include = try format(name_bytes[2560..<3072], f"-I{dir}")
    var cc_args: c.str[40] = ---
    cc_args[0] = "-std=gnu11"
    cc_args[1] = "-Wall"
    cc_args[2] = "-Werror"
    cc_args[3] = "-O2" if release and not native_backend else "-O0"
    cc_args[4] = (c.str)include
    cc_args[5] = (c.str)gen_path
    cc_args[6] = (c.str)runtime_path
    cc_args[7] = (c.str)start_path if with_start else "-fno-common"
    cc_args[8] = "-lm"
    cc_args[9] = "-pthread"
    cc_args[10] = "-o"
    cc_args[11] = (c.str)exe
    var n: usize = 12
    var flag_bytes: u8[2048]
    var used: usize = 0
    var k: usize = 0
    # the manifest's C sources, under the package root (§17.4)
    var source_bytes: u8[2048]
    var source_used: usize = 0
    k = 0
    while k < package.sources.length and n < cc_args.length:
        let path = try format(source_bytes[source_used..], f"{package.root}{(str)package.sources[k]}")
        source_used += path.length + 1
        cc_args[n] = (c.str)path
        n += 1
        k += 1
    k = 0
    while k < package.libraries.length and n < cc_args.length:
        let flag = try format(flag_bytes[used..], f"-l{(str)package.libraries[k]}")
        used += flag.length + 1
        cc_args[n] = (c.str)flag
        n += 1
        k += 1
    k = 0
    while k < package.link_search.length and n < cc_args.length:
        let flag = try format(flag_bytes[used..], f"-L{(str)package.link_search[k]}")
        used += flag.length + 1
        cc_args[n] = (c.str)flag
        n += 1
        k += 1
    k = 0
    while k < package.frameworks.length and n + 1 < cc_args.length:
        cc_args[n] = "-framework"
        cc_args[n + 1] = package.frameworks[k]
        n += 2
        k += 1
    k = 0
    while k < link_dir_count and n + 2 < cc_args.length:
        let flag = try format(flag_bytes[used..], f"-L{(str)at(link_dirs, k)}")
        used += flag.length + 1
        cc_args[n] = (c.str)flag
        let path = try format(flag_bytes[used..], f"-Wl,-rpath,{(str)at(link_dirs, k)}")
        used += path.length + 1
        cc_args[n + 1] = (c.str)path
        n += 2
        k += 1
    k = 0
    while k < link_library_count and n < cc_args.length:
        let flag = try format(flag_bytes[used..], f"-l{(str)at(link_libraries, k)}")
        used += flag.length + 1
        cc_args[n] = (c.str)flag
        n += 1
        k += 1
    k = 0
    while k < link_framework_count and n + 1 < cc_args.length:
        cc_args[n] = "-framework"
        cc_args[n + 1] = at(link_frameworks, k)
        n += 2
        k += 1
    let result = try process.run("cc", cc_args[..<n])
    let (cc_status, cc_out, cc_err) = result
    discard(cc_out.length)
    if cc_status != 0:
        let out = io.stderr()
        try out.write(cc_err)
        error(build_failed, "the C compiler rejected the generated code")
    discard(err_path)

## `as` over the assembly, then `ld` against the system library found through `xcrun`.
func assemble_and_link(dir: str, name_bytes: u8[], text: str, exe: str) -> !:
    let asm_path = try format(name_bytes[..<512], f"{dir}/gen.s")
    let object_path = try format(name_bytes[512..<1024], f"{dir}/gen.o")
    try files.write((c.str)asm_path, text.bytes)
    var as_args: c.str[3] = ---
    as_args[0] = "-o"
    as_args[1] = (c.str)object_path
    as_args[2] = (c.str)asm_path
    let assembled = try process.run("as", as_args)
    let (as_status, as_out, as_err) = assembled
    discard(as_out.length)
    if as_status != 0:
        try io.stderr().write(as_err)
        error(build_failed, "the assembler rejected the generated code")
    let sdk_args: c.str[1] = ["--show-sdk-path"]
    let found = try process.run("xcrun", sdk_args)
    let (sdk_status, sdk_out, sdk_err) = found
    discard(sdk_err.length)
    if sdk_status != 0:
        error(build_failed, "xcrun could not find the SDK")
    let sdk = try format(name_bytes[1024..<2048], f"{trim(sdk_out)}")
    var ld_args: c.str[40] = ---
    ld_args[0] = "-arch"
    ld_args[1] = "arm64"
    ld_args[2] = "-syslibroot"
    ld_args[3] = (c.str)sdk
    ld_args[4] = "-lSystem"
    ld_args[5] = "-o"
    ld_args[6] = (c.str)exe
    ld_args[7] = (c.str)object_path
    var n: usize = 8
    if freestanding:
        # the exported `_start` is the entry; its assembler label carries the C underscore
        ld_args[n] = "-e"
        ld_args[n + 1] = "__start"
        n += 2
    # the manifest's C sources (§17.4), each compiled to an object beside the assembly
    var object_bytes: u8[2048]
    var object_used: usize = 0
    var s: usize = 0
    while s < package.sources.length and n < ld_args.length:
        let source_path = try format(object_bytes[object_used..], f"{package.root}{(str)package.sources[s]}")
        object_used += source_path.length + 1
        let compiled = try format(object_bytes[object_used..], f"{dir}/source{s}.o")
        object_used += compiled.length + 1
        var cc_args: c.str[6] = ["-std=gnu11", "-c", (c.str)source_path, "-O2", "-o", (c.str)compiled]
        try run_tool("cc", cc_args, "the C compiler rejected a source the manifest names")
        ld_args[n] = (c.str)compiled
        n += 1
        s += 1
    s = 0
    while s < package.libraries.length and n < ld_args.length:
        let flag = try format(object_bytes[object_used..], f"-l{(str)package.libraries[s]}")
        object_used += flag.length + 1
        ld_args[n] = (c.str)flag
        n += 1
        s += 1
    s = 0
    while s < package.link_search.length and n + 1 < ld_args.length:
        ld_args[n] = "-L"
        ld_args[n + 1] = package.link_search[s]
        n += 2
        s += 1
    s = 0
    while s < package.frameworks.length and n + 1 < ld_args.length:
        ld_args[n] = "-framework"
        ld_args[n + 1] = package.frameworks[s]
        n += 2
        s += 1
    var flag_bytes: u8[2048]
    var used: usize = 0
    var k: usize = 0
    while k < link_dir_count and n + 4 < ld_args.length:
        ld_args[n] = "-L"
        ld_args[n + 1] = at(link_dirs, k)
        ld_args[n + 2] = "-rpath"
        ld_args[n + 3] = at(link_dirs, k)
        n += 4
        k += 1
    k = 0
    while k < link_library_count and n < ld_args.length:
        let flag = try format(flag_bytes[used..], f"-l{(str)at(link_libraries, k)}")
        used += flag.length + 1
        ld_args[n] = (c.str)flag
        n += 1
        k += 1
    k = 0
    while k < link_framework_count and n + 1 < ld_args.length:
        ld_args[n] = "-framework"
        ld_args[n + 1] = at(link_frameworks, k)
        n += 2
        k += 1
    let linked = try process.run("ld", ld_args[..<n])
    let (ld_status, ld_out, ld_err) = linked
    discard(ld_out.length)
    if ld_status != 0:
        try io.stderr().write(ld_err)
        error(build_failed, "the linker rejected the generated code")

## `build FILE`: check, generate, compile.
func build_file(path: c.str, options: Options) -> !:
    let backing = try reserve_arena()
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        native_backend = options.native
        debug_backend = options.debug and options.native
        link_library_count = options.library_count
        link_dir_count = options.library_dir_count
        var k: usize = 0
        while k < options.library_count:
            link_libraries[k] = options.libraries[k]
            k += 1
        k = 0
        while k < options.library_dir_count:
            link_dirs[k] = options.library_dirs[k]
            k += 1
        link_framework_count = options.framework_count
        k = 0
        while k < options.framework_count:
            link_frameworks[k] = options.frameworks[k]
            k += 1
        if options.list_targets:
            try list_targets(path)
            return
        if options.library:
            let (code, header_text) = try generate_library(path)
            try build_library(code, header_text, options.output if options.output.length > 0 else "library")
            return
        if options.freestanding and not options.native:
            error(build_failed, "a freestanding program is built natively: add `--native`")
        freestanding = options.freestanding
        diagnostic_profile = options.diagnostic
        let text = try generate(path, 4 if options.freestanding else (1 if options.run_tests else 0))
        if options.emit_c:
            if options.output.length > 0:
                try files.write((c.str)options.output, text.bytes)
            else:
                try io.stdout().write(text)
            return
        var exe = options.output
        if exe.length == 0:
            exe = "a.out"
        try compile(text, exe, options.release, used_mode == 2 and not native_backend)

## `--target` with no name (§19.6): the targets of §19.5, then the asm architectures the
## program's own modules carry blocks for; the one this compiler builds is marked.
func list_targets(path: c.str) -> !:
    var checker = try checked(path)
    let out = io.stdout()
    try out.write("targets: x86_64-linux x86_64-macos x86_64-windows arm64-linux arm64-macos (built here) wasm32\n")
    var wrote_any = false
    var i: usize = 0
    while i < checker.modules.count:
        let m = checker.modules.get(i)
        if not m.is_prelude:
            var cursor = m.tree.body
            while let d = cursor:
                if d.kind == ast.Kind.asm_ or asm_architecture_of(d).length > 0:
                    let arch = d.text if d.kind == ast.Kind.asm_ else asm_architecture_of(d)
                    if not wrote_any:
                        try out.write("asm architectures covered:")
                        wrote_any = true
                    try out.write(f" {arch}")
                cursor = d.next
        i += 1
    if wrote_any:
        try out.write("\n")
    else:
        try out.write("asm architectures covered: none\n")

## The architecture of the first asm block inside a function, or empty text.
func asm_architecture_of(d: ast.Node*) -> str:
    if d.kind != ast.Kind.func_:
        return ""
    let body = d.body else return ""
    var cursor = body.body
    while let s = cursor:
        if s.kind == ast.Kind.asm_:
            return s.text
        cursor = s.next
    return ""

## `--lib`: `NAME.a` from the generated code (and the C runtime when the code is C), and
## `NAME.h` with the exported surface (§17.6).
func build_library(code: str, header_text: str, name: str) -> !:
    let mktemp_args: c.str[2] = ["-d", "/tmp/luce-base.XXXXXX"]
    let made = try process.run("mktemp", mktemp_args)
    let (status, dir_text, unused_err) = made
    discard(unused_err.length)
    if status != 0:
        error(build_failed, "could not create a scratch directory")
    var names_bytes: u8[4096]
    let dir = try format(names_bytes[3072..], f"{trim(dir_text)}")
    defer remove_tree((c.str)dir)
    let archive = try format(names_bytes[2048..<2560], f"{name}.a")
    let header_path = try format(names_bytes[2560..<3072], f"{name}.h")
    let object_path = try format(names_bytes[..<512], f"{dir}/gen.o")
    if native_backend:
        let asm_path = try format(names_bytes[512..<1024], f"{dir}/gen.s")
        try files.write((c.str)asm_path, code.bytes)
        var as_args: c.str[3] = ["-o", (c.str)object_path, (c.str)asm_path]
        try run_tool("as", as_args, "the assembler rejected the generated code")
        var ar_args: c.str[3] = ["rcs", (c.str)archive, (c.str)object_path]
        try run_tool("ar", ar_args, "the archiver failed")
    else:
        let gen_path = try format(names_bytes[512..<1024], f"{dir}/gen.c")
        let rt_header = try format(names_bytes[1024..<1536], f"{dir}/lucb_rt.h")
        let rt_source = try format(names_bytes[1536..<2048], f"{dir}/lucb_rt.c")
        try files.write((c.str)gen_path, code.bytes)
        try files.write((c.str)rt_header, runtime.header.bytes)
        try files.write((c.str)rt_source, runtime.source.bytes)
        var include_bytes: u8[600]
        let include = try format(include_bytes, f"-I{dir}")
        var rt_object_bytes: u8[600]
        let rt_object = try format(rt_object_bytes, f"{dir}/rt.o")
        var gen_args: c.str[9] = ["-std=gnu11", "-Wall", "-Werror", "-O2", (c.str)include, "-c", (c.str)gen_path, "-o", (c.str)object_path]
        try run_tool("cc", gen_args, "the C compiler rejected the generated code")
        var rt_args: c.str[9] = ["-std=gnu11", "-Wall", "-Werror", "-O2", (c.str)include, "-c", (c.str)rt_source, "-o", (c.str)rt_object]
        try run_tool("cc", rt_args, "the C compiler rejected the runtime")
        var ar_args: c.str[4] = ["rcs", (c.str)archive, (c.str)object_path, (c.str)rt_object]
        try run_tool("ar", ar_args, "the archiver failed")
    try files.write((c.str)header_path, header_text.bytes)

## Run a build tool; its standard error is shown when it fails.
func run_tool(program: c.str, arguments: c.str[], what: str) -> !:
    let ran = try process.run(program, arguments)
    let (status, out, err) = ran
    discard(out.length)
    if status != 0:
        try io.stderr().write(err)
        error(build_failed, what)

## `test FILE`: build the test runner into a scratch file and run it.
func test_file(path: c.str, native: bool) -> i32!:
    let backing = try reserve_arena()
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        native_backend = native
        let text = try generate(path, 1)
        let mktemp_args: c.str[1] = ["/tmp/luce-base-test.XXXXXX"]
        let made = try process.run("mktemp", mktemp_args)
        let (status, exe_text, unused_err) = made
        discard(unused_err.length)
        if status != 0:
            error(build_failed, "could not create a scratch file")
        var exe_name: u8[512]
        let exe = try format(exe_name, f"{trim(exe_text)}")
        # the scratch file goes whether the build or the run fails
        defer remove_file((c.str)exe)
        try compile(text, exe, false, false)
        var run_args: c.str[1] = ---
        run_args[0] = (c.str)exe
        let ran = try process.run((c.str)exe, run_args)
        let (code, out, err) = ran
        try io.stdout().write(out)
        try io.stderr().write(err)
        return code

func remove_file(path: c.str):
    remove_path("-f", path)

func remove_tree(path: c.str):
    remove_path("-rf", path)

func remove_path(flag: c.str, path: c.str):
    var rm_args: c.str[2] = ---
    rm_args[0] = flag
    rm_args[1] = path
    let ran = process.run("rm", rm_args) catch:
        return
    let (code, out, err) = ran
    discard(code)
    discard(out.length)
    discard(err.length)

pub let build_failed: ErrorCode = ErrorCode.package(13)

## Text without its trailing newline.
func trim(text: str) -> str:
    var end = text.length
    let b = text.bytes
    while end > 0 and (b[end - 1] == '\n' or b[end - 1] == ' '):
        end -= 1
    return (str)b[..<end]

## Check FILE and the modules it imports from its directory; silence means success.
func check_file(path: c.str) -> !:
    let backing = try reserve_arena()
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[4096]
    with arena:
        var checker = try check.Checker.create(scratch)
        try checker.add_prelude()
        try checker.load(path)
        try checker.check_program()
        try report_warnings(&checker)

## Trees and tokens live in one arena taken from the process heap; nothing is
## freed until the command ends.
let arena_size: usize = 536870912

## The command's arena: the full size, or a smaller one when the machine cannot spare it,
## since a small program needs far less than the compiler itself.
func reserve_arena() -> u8[]!:
    var size = arena_size
    while size >= 33554432:
        if let backing = memory.heap.allocate(size, 16):
            if size < arena_size:
                try io.stderr().write(f"luce-base: note: the machine spared {size // 1048576} MB for the arena\n")
            return backing
        size = size // 2
    error(memory.exhausted, "no room for the compiler's arena")

func parse_file(path: c.str, out: io.Writer) -> !:
    let backing = try reserve_arena()
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[4096]
    with arena:
        let src = try source.Source.load(path)
        var p = try parser.Parser.over(src, scratch)
        let module = try p.parse_module()
        try ast.dump(out, module, 0)

func lex_file(path: c.str, out: io.Writer) -> !:
    let backing = try reserve_arena()
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        let src = try source.Source.load(path)
        var lx = lexer.Lexer.over(src)
        while true:
            let t = try lx.next()
            if t.kind == token.Kind.eof:
                break
            if t.kind == token.Kind.newline or t.kind == token.Kind.indent or t.kind == token.Kind.dedent:
                try out.write(f"{t.line}:{t.column} {t.label()}\n")
            else:
                try out.write(f"{t.line}:{t.column} {t.label()} {lx.text(t)}\n")

pub func main(arguments: c.str[]) -> i32!:
    let out = io.stdout()
    if arguments.length < 2:
        try usage(io.stderr())
        return 2
    let command = (str)arguments[1]
    # `-W` may appear on any command and is not one of its arguments
    var positional = arguments.length
    for a in arguments:
        if (str)a == "-W":
            show_warnings = true
            positional -= 1
    if command == "--version":
        try out.write(f"luce-base {version}\n")
        return 0
    if command == "parse" and positional == 3:
        parse_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "build" and positional >= 3:
        var options: Options = ---
        options.output = ""
        options.release = false
        options.emit_c = false
        options.run_tests = false
        options.native = false
        options.debug = false
        options.library = false
        options.freestanding = false
        options.list_targets = false
        options.diagnostic = false
        options.library_count = 0
        options.library_dir_count = 0
        options.framework_count = 0
        var i: usize = 3
        while i < arguments.length:
            let a = (str)arguments[i]
            if a == "-o" and i + 1 < arguments.length:
                options.output = (str)arguments[i + 1]
                i += 1
            elif a == "--release":
                options.release = true
            elif a == "--emit=c" or a == "--emit=asm":
                options.emit_c = true
            elif a == "--native":
                options.native = true
            elif a == "--lib":
                options.library = true
            elif a == "--freestanding":
                options.freestanding = true
            elif a == "--target":
                options.list_targets = true
            elif a == "--profile" and i + 1 < arguments.length:
                let profile = (str)arguments[i + 1]
                if profile == "diagnostic":
                    options.diagnostic = true
                elif profile != "default":
                    try io.stderr().write(f"luce-base: unknown profile `{profile}`; the profiles are `default` and `diagnostic`\n")
                    return 2
                i += 1
            elif a == "--debug":
                options.debug = true
            elif a == "-W":
                show_warnings = true
            elif starts_with(a, "-l") and a.length > 2 and options.library_count < options.libraries.length:
                options.libraries[options.library_count] = (c.str)(str)a.bytes[2..]
                options.library_count += 1
            elif starts_with(a, "-L") and a.length > 2 and options.library_dir_count < options.library_dirs.length:
                options.library_dirs[options.library_dir_count] = (c.str)(str)a.bytes[2..]
                options.library_dir_count += 1
            elif a == "-framework" and i + 1 < arguments.length and options.framework_count < options.frameworks.length:
                options.frameworks[options.framework_count] = arguments[i + 1]
                options.framework_count += 1
                i += 1
            else:
                try io.stderr().write(f"luce-base: unexpected argument `{a}`\n")
                return 2
            i += 1
        build_file(arguments[2], options) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "test" and (positional == 3 or (positional == 4 and has_argument(arguments, "--native"))):
        let code = test_file(arguments[2], has_argument(arguments, "--native")) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            recover 1
        return code
    if command == "check" and positional == 3:
        check_file(arguments[2]) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "lex" and positional == 3:
        lex_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    try usage(io.stderr())
    return 2
