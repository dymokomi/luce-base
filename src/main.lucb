## The luce-base command: `lex FILE` prints one token per line, `parse FILE`
## prints the syntax tree.

import ast
import lexer
import parser
import source
import token

let version: str = "0.1"

func usage(out: Writer) -> !:
    try out.write("usage: luce-base lex FILE\n       luce-base parse FILE\n       luce-base --version\n")

func parse_file(path: cstr, out: Writer) -> !:
    var backing: u8[4194304]
    var arena = FixedBuffer.over(backing)
    var scratch: u8[256]
    with arena:
        let src = try source.Source.load(path)
        var p = try parser.Parser.over(src, scratch)
        let module = try p.parse_module()
        try ast.dump(out, module, 0)

func lex_file(path: cstr, out: Writer) -> !:
    var backing: u8[1048576]
    var arena = FixedBuffer.over(backing)
    with arena:
        let src = try source.Source.load(path)
        var lx = lexer.Lexer.over(src)
        while true:
            let t = try lx.next()
            if t.kind == token.Kind.eof:
                break
            if t.kind == token.Kind.newline or t.kind == token.Kind.indent or t.kind == token.Kind.dedent:
                try out.write(f"{t.line}:{t.column} {t.label()}\n")
            else:
                try out.write(f"{t.line}:{t.column} {t.label()} {lx.text(t)}\n")

pub func main(arguments: cstr[]) -> i32!:
    let out = io.stdout()
    if arguments.length < 2:
        try usage(io.stderr())
        return 2
    let command = (str)arguments[1]
    if command == "--version":
        try out.write(f"luce-base {version}\n")
        return 0
    if command == "parse" and arguments.length == 3:
        parse_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    if command == "lex" and arguments.length == 3:
        lex_file(arguments[2], out) catch failure:
            try io.stderr().write(f"luce-base: {failure.message}\n")
            return 1
        return 0
    try usage(io.stderr())
    return 2
