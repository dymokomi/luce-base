#==============================================================================================
#
#   pieces - One program's assembly assembled in pieces, in parallel, then joined
#
#   DESCRIPTION:
#       The system assembler reads one file on one thread: luced-3d's 70 MB of assembly
#       took it ten seconds. Generated with `split`, the assembly names the labels functions
#       share as hidden symbols, names labels by what they label (`stable_names`), and
#       records where each function begins. So it is cut at function boundaries the
#       functions themselves choose, each piece with the text's opening and closing
#       directives, plus one piece for the rest (literals, tables, globals). A piece whose
#       text an earlier build assembled takes its object from the build cache; the others
#       are assembled on separate threads. All are joined with `ld -r` into the one object
#       the build links and caches, the same whichever pieces were reused.
#
#==============================================================================================

import back.parallel
import c
import files
import io
import memory
import support.cache
import support.host_tools
import support.list

# mark: Cutting and assembling ==============================================================

## Where pieces are cut. Past `least_bytes` of functions, a function whose tag
## (`stable_names`) is a multiple of `cut_every` starts the next piece, and one starts at
## least every `most_bytes`. A cut depends on the functions around it, not on its place
## in the program, so an edit moves the cuts near it only, and the other pieces keep
## their text, and their objects in the cache.
let least_bytes: usize = 524288
let cut_every: u64 = 256
let most_bytes: usize = 4194304

## Assemble `text` (generated with `split`; `starts`, `tags` and `ending` from its
## generator) into the object at `object`, in `dir`. `macho` joins with Apple's `ld -r`
## for `arch`. A piece whose text is in the build cache (`support.cache`) reuses its
## object; the others are assembled in parallel and kept there.
pub func assemble(dir: str, text: str, starts: const usize[], tags: const u64[], ending: usize, object: str, macho: bool, arch: str) -> !:
    let functions = starts.length - 1
    let rest = starts[functions]
    let prelude = (str)text.bytes[..<starts[0]]
    let closing = (str)text.bytes[ending..]
    with memory.heap:
        # piece k holds functions [cuts[k], cuts[k + 1]); the last piece is the rest
        var cuts = try list.List[usize].create(64)
        defer cuts.destroy()
        try cuts.push(0)
        var since = starts[0]
        for index in 1..<functions:
            let size = starts[index] - since
            if (size >= least_bytes and tags[index] % cut_every == 0) or size >= most_bytes:
                try cuts.push(index)
                since = starts[index]
        try cuts.push(functions)
        let made = cuts.count - 1
        var job = Assembling(dir = dir, sources = try alloc str[made + 1], objects = try alloc str[made + 1], pending = try alloc bool[made + 1], failures = try parallel.failures(made + 1))
        defer free(job.sources)
        defer free(job.objects)
        defer free(job.pending)
        defer free(job.failures)
        let keys = try alloc str[made + 1]
        defer free(keys)
        var reused: usize = 0
        for k in 0..<made + 1:
            var middle = (str)text.bytes[rest..]
            var ends = ""
            if k < made:
                let to_byte = starts[cuts.get(k + 1)] if cuts.get(k + 1) < functions else rest
                middle = (str)text.bytes[starts[cuts.get(k)]..<to_byte]
                ends = closing
            keys[k] = try cache.piece_key(prelude, middle, ends, arch)
            job.pending[k] = true
            if let kept = try cache.find(keys[k], "-p.o", true):
                job.objects[k] = kept
                job.pending[k] = false
                reused += 1
                continue
            # a piece is named by its key, as the cache names it, and relative to the
            # workspace the assembler runs in: an ELF object records the file it was
            # assembled from, and `ld` the name of each object it joins, so the program is
            # the same whichever pieces were assembled and which came from the cache
            var source_room = try alloc u8[keys[k].length + 8]
            job.sources[k] = try format(source_room, f"{keys[k]}.s")
            var object_room = try alloc u8[dir.length + keys[k].length + 8]
            job.objects[k] = try format(object_room, f"{dir}/{keys[k]}-p.o")
            var written_room = try alloc u8[dir.length + keys[k].length + 8]
            try write_piece(try format(written_room, f"{dir}/{keys[k]}.s"), prelude, middle, ends)
        try parallel.each(made + 1, assemble_task, (void*)&job)
        try parallel.check(job.failures)
        for k in 0..<made + 1:
            if job.pending[k]:
                cache.keep(keys[k], "-p.o", job.objects[k])
        if cache.report:
            try io.stderr().write(f"luce-base: {reused} of {made + 1} pieces from the cache\n")
        try join(dir, job.objects, object, macho, arch)

## `prelude`, `middle` and `closing` as one file at `path`.
func write_piece(path: str, prelude: str, middle: str, closing: str) -> !:
    with memory.heap:
        var whole = try alloc u8[prelude.length + middle.length + closing.length]
        defer free(whole)
        memory.copy(whole, prelude.bytes, prelude.length)
        memory.copy(whole[prelude.length..], middle.bytes, middle.length)
        memory.copy(whole[prelude.length + middle.length..], closing.bytes, closing.length)
        try files.write((c.str)path, whole)

# mark: The assembler threads ===============================================================

## What the threads assembling the pieces share.
struct Assembling:
    var dir: str
    var sources: str[]
    var objects: str[]
    ## Whether piece k is to be assembled, not taken from the cache.
    var pending: bool[]
    var failures: parallel.Failure[]

func assemble_task(context: void*?, index: usize):
    let job = (Assembling*)(context else return)
    with memory.heap:
        assemble_piece(job, index) catch failure:
            job.failures[index] = parallel.Failure(failed = true, code = failure.code, message = failure.message)

func assemble_piece(job: Assembling*, index: usize) -> !:
    if not job.pending[index]:
        return
    var arguments: c.str[3] = ["-o", (c.str)job.objects[index], (c.str)job.sources[index]]
    let (status, out, err) = try host_tools.run("as", arguments, job.dir)
    discard(out.length)
    if status != 0:
        try io.stderr().write(err)
        error(rejected, "the assembler rejected the generated code")

## The assembler rejected a piece, or the pieces could not be joined.
pub let rejected: ErrorCode = ErrorCode.package(43)

## Join `objects` into the relocatable object `object` with `ld -r`.
func join(dir: str, objects: const str[], object: str, macho: bool, arch: str) -> !:
    with memory.heap:
        var arguments = try alloc c.str[objects.length + 5]
        defer free(arguments)
        var n: usize = 0
        arguments[n] = "-r"
        n += 1
        if macho:
            arguments[n] = "-arch"
            arguments[n + 1] = (c.str)arch
            n += 2
        arguments[n] = "-o"
        arguments[n + 1] = (c.str)object
        n += 2
        for piece in objects:
            arguments[n] = (c.str)piece
            n += 1
        let (status, out, err) = try host_tools.run("ld", arguments[..<n], dir)
        discard(out.length)
        if status != 0:
            try io.stderr().write(err)
            error(rejected, "the linker could not join the assembled pieces")
