#==============================================================================================
#
#   name_table - Names to their indexes, by hash
#
#   DESCRIPTION:
#       An open-addressed table from a name to the index it was added with, for the passes
#       that would otherwise look a name up by walking a list: a large program has tens of
#       thousands of symbols, and a walk per reference is the square of that. The table
#       borrows the names; they must outlive it.
#
#==============================================================================================

import memory

## Names and the indexes they were added with.
pub struct NameTable:
    ## Slot keys; a slot is free when its index is 0.
    var names: str[]
    ## Each slot's index + 1, or 0 for a free slot.
    var indexes: u32[]
    var used: usize
    ## The allocator the slots were made with, which their growth and release go on using.
    var allocator: memory.Allocator

    ## A table with room for `expected` names before it grows.
    pub static func create(expected: usize) -> NameTable!:
        var size: usize = 16
        while size < expected * 2 + 2:
            size *= 2
        var table = NameTable(names = try alloc str[size], indexes = try alloc u32[size], used = 0, allocator = memory.allocator)
        for i in 0..<size:
            table.indexes[i] = 0
        return table

    ## The index `name` was added with, or `none`; the first, when it was added twice.
    pub func find(name: str) -> usize?:
        let mask = self.names.length - 1
        var slot = spread(name) & mask
        while self.indexes[slot] != 0:
            if self.names[slot] == name:
                return (usize)self.indexes[slot] - 1
            slot = (slot + 1) & mask
        return none

    ## Add `name` with `index`, unless the name is there already.
    pub mutating func add(name: str, index: usize) -> !:
        if self.find(name) != none:
            return
        if (self.used + 1) * 2 > self.names.length:
            try self.grow()
        self.place(name, u32(index + 1))
        self.used += 1

    ## Release the slots.
    pub mutating func destroy():
        free(self.names) in self.allocator
        free(self.indexes) in self.allocator

    mutating func place(name: str, stored: u32):
        let mask = self.names.length - 1
        var slot = spread(name) & mask
        while self.indexes[slot] != 0:
            slot = (slot + 1) & mask
        self.names[slot] = name
        self.indexes[slot] = stored

    mutating func grow() -> !:
        let old_names = self.names
        let old_indexes = self.indexes
        let size = old_names.length * 2
        self.names = try alloc str[size] in self.allocator
        self.indexes = try alloc u32[size] in self.allocator
        for i in 0..<size:
            self.indexes[i] = 0
        for i in 0..<old_names.length:
            if old_indexes[i] != 0:
                self.place(old_names[i], old_indexes[i])
        free(old_names) in self.allocator
        free(old_indexes) in self.allocator

## FNV-1a of `name`.
func spread(name: str) -> usize:
    var h: u64 = 14695981039346656037
    for b in name.bytes:
        h = (h ^ (u64)b) *% 1099511628211
    return (usize)h

test "names find the index they were added with, the first of two":
    var table = try NameTable.create(2)
    defer table.destroy()
    var views: str[40] = ---
    var rooms: u8[320] = ---
    for i in 0..<views.length:
        views[i] = try format(rooms[i * 8..<i * 8 + 8], f"n{i}")
        try table.add(views[i], i)
    try table.add(views[3], 99)
    for i in 0..<views.length:
        assert(table.find(views[i]) == i)
    assert(table.find("absent") == none)
