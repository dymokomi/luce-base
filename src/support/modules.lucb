#==============================================================================================
#
#   modules - Resolving public package modules
#
#   DESCRIPTION:
#       Manifests declare the source root and public exports; both compilers use this resolver,
#       and builds package its resolved files instead of depending on a staging directory
#       layout.
#
#==============================================================================================

import c
import files
import memory
import paths
import strings
import support.list
import support.manifest
# mark: Resolutions and packages ==============================================================

## A manifest or dependency layout is malformed.
pub let invalid: ErrorCode = ErrorCode.package(28)

## A resolved module: its name, its source file, and its package root.
pub struct Resolution:
    ## The module's name.
    pub let name: str
    ## The path to its source file.
    pub let path: str
    ## The package's source root.
    pub let root: str

struct Mapping:
    let name: str
    let value: str

struct Package:
    var name: str
    var root: str
    var source: str
    var dependencies: list.List[Mapping]
    var exports: list.List[Mapping]
    var module_packages: list.List[Mapping]

## Paths and manifest text live in the compiler's arena. Canonical file paths
## identify one module even if more than one public export names it.
pub func canonical(path: str) -> str!:
    let terminated = try strings.copy(path)
    defer strings.release(terminated)
    return try files.canonical((c.str)terminated)

func present(path: str) -> bool!:
    return files.exists((c.str)try strings.copy(path))

func contained(path: str, root: str) -> bool:
    return path == root or (strings.starts_with(path, root) and path.length > root.length and path.bytes[root.length] == '/')

func identifier(name: str) -> bool:
    if name.length == 0:
        return false
    var first = true
    for byte in name.bytes:
        if byte == '.':
            if first:
                return false
            first = true
        elif byte == '_' or (byte >= 'a' and byte <= 'z') or (byte >= 'A' and byte <= 'Z') or (not first and byte >= '0' and byte <= '9'):
            first = false
        else:
            return false
    return not first

## A package module setting's value, which is never empty.
func quoted(value: str) -> str!:
    if value.length == 0:
        error(invalid, "package module settings are quoted strings")
    return value

func mapping(entries: list.List[Mapping]*, name: str, value: str) -> !:
    if not identifier(name):
        error(invalid, "an import or export name must be a dotted module name")
    for previous in entries.span():
        if previous.name == name:
            error(invalid, "a package module setting is declared twice")
    try entries.push(Mapping(name, value))

func read_package(path: str) -> Package!:
    let root = try canonical(paths.directory(path))
    let contents = (str)try files.read((c.str)try strings.copy(path))
    var package = Package(name = "", root = root, source = "src",
                          dependencies = try list.List[Mapping].create(4), exports = try list.List[Mapping].create(4), module_packages = try list.List[Mapping].create(4))
    var named = false
    var sourced = false
    for setting in try manifest.settings(contents):
        let section = setting.section
        let key = setting.key
        if section != "[package]" and section != "[dependencies]" and section != "[exports]" and section != "[module_packages]":
            continue
        if section == "[package]" and key != "name" and key != "source":
            continue
        let value = try quoted(setting.value)
        if section == "[dependencies]":
            try mapping(&package.dependencies, key, value)
        elif section == "[module_packages]":
            if value.length == 0:
                error(invalid, "a compiled module needs a package identity")
            try mapping(&package.module_packages, key, value)
        elif section == "[exports]":
            if not identifier(value):
                error(invalid, "an export must name a module under the package source root")
            try mapping(&package.exports, key, value)
        elif key == "name":
            if named:
                error(invalid, "the package name is declared twice")
            named = true
            package.name = value
        elif key == "source":
            if sourced:
                error(invalid, "the package source root is declared twice")
            sourced = true
            package.source = value
    package.source = try paths.join(root, package.source)
    return package

## Where a dependency lives: its declared checkout path, or `.luc/deps/<name>` at the package
## root or the nearest directory above it, where luc unpacks registry packages. A package
## that itself sits under `.luc/deps/` came from the registry, so its own checkout paths are
## its author's and every dependency is looked up the same way.
func dependency_directory(package: Package, dependency: Mapping) -> str!:
    let synced = starts_with_text(dependency.value, ".luc/deps/") or contains_text(package.root, "/.luc/deps/")
    if not synced:
        return try paths.join(package.root, dependency.value)
    var relative = try paths.join(".luc/deps", dependency.name)
    var directory = package.root
    while true:
        let candidate = try paths.join(directory, relative)
        if try present(candidate):
            return candidate
        let parent = paths.directory(directory)
        if parent == directory or parent.length == 0:
            error(invalid, "a registry dependency is not synced; run luc sync")
        directory = parent

func starts_with_text(text: str, prefix: str) -> bool:
    if text.length < prefix.length:
        return false
    return (str)text.bytes[..<prefix.length] == prefix

func contains_text(text: str, part: str) -> bool:
    if part.length > text.length:
        return false
    var i: usize = 0
    while i + part.length <= text.length:
        if (str)text.bytes[i..<i + part.length] == part:
            return true
        i += 1
    return false

func enclosing(path: str) -> Package?!:
    var directory = paths.directory(path)
    while directory.length > 0:
        let candidate = try paths.join(directory, "package.prisma")
        if try present(candidate):
            return try read_package(candidate)
        let parent = paths.directory(directory)
        if parent == directory:
            break
        directory = parent
    return none

func source_file(root: str, name: str, base_only: bool) -> str?!:
    let relative = try alloc u8[name.length]
    for index in 0..<name.length:
        relative[index] = '/' if name.bytes[index] == '.' else name.bytes[index]
    let prefix = try paths.join(root, (str)relative)
    if not base_only:
        let luce = try strings.join([prefix, ".luc"], "")
        if try present(luce):
            return try canonical(luce)
    let base = try strings.join([prefix, ".lucb"], "")
    if try present(base):
        return try canonical(base)
    # a directory whose `ORDER` lists the module's fragments stands for the file
    let order = try strings.join([prefix, "/ORDER"], "")
    if try present(order):
        return try canonical(prefix)
    return none

func exported(package: Package, name: str, base_only: bool) -> Resolution?!:
    for item in package.exports.span():
        if item.name == name:
            let root = try canonical(package.source)
            let path = try source_file(root, item.value, base_only) else error(invalid, "an exported module does not exist")
            return Resolution(item.value, path, root)
    return none

# mark: Resolving imports =====================================================================

## A package export, from the owning package or an explicitly declared dependency.
## Competing exports are errors, including a dependency colliding with a local file.
pub func package_import(importer: str, name: str, base_only: bool = true) -> Resolution?!:
    if not identifier(name):
        error(invalid, "an import must name a dotted module")
    let input = try canonical(importer)
    let package = try enclosing(input) else return none
    var result = try exported(package, name, base_only)
    for dependency in package.dependencies.span():
        let path = try paths.join(try dependency_directory(package, dependency), "package.prisma")
        let other = try read_package(path)
        if other.name != dependency.name:
            error(invalid, "a dependency key must match its package name")
        if let found = try exported(other, name, base_only):
            if result != none:
                error(invalid, "more than one package exports this module name")
            result = found
    if result != none:
        if let local_file = try source_file(package.source, name, base_only):
            if local_file != (result else return none).path:
                error(invalid, "a package export conflicts with a local module")
    return result

## Public resolution for the Luce consumer. Within a package, module names start at
## its source root; outside one, resolution uses the caller-supplied source root.
pub func resolve(importer: str, source_root: str, name: str, base_only: bool = false) -> Resolution!:
    if let external = try package_import(importer, name, base_only):
        return external
    let input = try canonical(importer)
    var root = source_root
    var package_root = false
    if let package = try enclosing(input):
        if try present(package.source):
            let candidate = try canonical(package.source)
            if contained(input, candidate):
                root = candidate
                package_root = true
    root = try canonical(root)
    while true:
        if let path = try source_file(root, name, base_only):
            return Resolution(name, path, root)
        # A standalone Base module may import from an enclosing source directory,
        # as Base's compiler loader does. Package roots are explicit boundaries.
        let parent = paths.directory(root)
        if package_root or not base_only or parent == root or parent.length == 0:
            error(invalid, "the module is neither local nor a public package export")
        root = parent

## The module's canonical dotted name inside its own package source root.
pub func name_of(path: str) -> str!:
    if not (try present(path)):
        return paths.stem(path)
    let input = try canonical(path)
    if let package = try enclosing(input):
        if try present(package.source):
            let root = try canonical(package.source)
            if contained(input, root) and input.length > root.length:
                let relative = (str)input.bytes[root.length + 1..]
                let extension = paths.extension(relative)
                let size = relative.length - extension.length
                let name = try alloc u8[size]
                for index in 0..<size:
                    name[index] = '.' if relative.bytes[index] == '/' else relative.bytes[index]
                return (str)name
    return paths.stem(input)

## Source packaging records a native module's original package identity. Outside
## a compiled workspace, the nearest real package manifest owns its modules.
pub func package_of(path: str, module: str, fallback: str) -> str!:
    let input = try canonical(path)
    if let package = try enclosing(input):
        for entry in package.module_packages.span():
            if entry.name == module:
                return entry.value
        if package.name.length > 0:
            return package.name
    return fallback
