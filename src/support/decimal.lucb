## Decimal float literals to IEEE bits, correctly rounded (§4.3). A literal is a digit
## string D and a decimal exponent E, D * 10^E. With big integers Num and Den, Num = D * 10^E
## and Den = 1 for a non-negative E, else Num = D and Den = 10^-E, so that the value is
## Num / Den exactly. Scaling by a power of two, which only moves the binary exponent, puts
## the quotient in [2^(p+2), 2^(p+4)), p the width's precision; that quotient, its remainder
## as a sticky bit, and the exponent are then rounded once to the width, ties to even. A
## literal keeps at most 800 significant digits: every float and every midpoint between two
## floats has a decimal expansion shorter than that, so what follows can only decide a tie,
## which the sticky bit records.

## Big unsigned integers of up to 6144 bits, in 32-bit limbs, least significant first. The
## widest value here is Num scaled up to the length of Den = 10^1200, under 4100 bits.
struct Big:
    var limb: u32[192]
    ## Limbs in use; the last is not zero, or `used` is zero for zero.
    var used: usize

    static func of(value: u64) -> Big:
        var b: Big
        var v = value
        while v != 0:
            b.limb[b.used] = (u32)v
            b.used += 1
            v >>= 32
        return b

    func is_zero() -> bool:
        return self.used == 0

    ## `self * m + a`; false when the capacity is exceeded.
    mutating func mul_add(m: u32, a: u32) -> bool:
        var carry: u64 = (u64)a
        var i: usize = 0
        while i < self.used:
            let t = (u64)self.limb[i] * (u64)m + carry
            self.limb[i] = (u32)t
            carry = t >> 32
            i += 1
        if carry != 0:
            if self.used == self.limb.length:
                return false
            self.limb[self.used] = (u32)carry
            self.used += 1
        return true

    func bit_length() -> usize:
        if self.used == 0:
            return 0
        var top = self.limb[self.used - 1]
        var n: usize = 0
        while top != 0:
            n += 1
            top >>= 1
        return (self.used - 1) * 32 + n

    mutating func trim():
        while self.used > 0 and self.limb[self.used - 1] == 0:
            self.used -= 1

    mutating func shift_left(count: usize) -> bool:
        if count == 0 or self.used == 0:
            return true
        let words = count // 32
        let rest = (u64)(count % 32)
        if self.used + words + 1 > self.limb.length:
            return false
        var i = self.used
        while i > 0:
            i -= 1
            let t = (u64)self.limb[i] << rest
            self.limb[i + words + 1] |= (u32)(t >> 32)
            self.limb[i + words] = (u32)t
        var k: usize = 0
        while k < words:
            self.limb[k] = 0
            k += 1
        self.used += words + 1
        self.trim()
        return true

    mutating func shift_right_one():
        var i: usize = 0
        while i < self.used:
            let low: u32 = self.limb[i + 1] & 1 if i + 1 < self.used else 0
            self.limb[i] = (self.limb[i] >> 1) | (low << 31)
            i += 1
        self.trim()

    ## `self >= other`.
    func at_least(other: const Big*) -> bool:
        if self.used != other.used:
            return self.used > other.used
        var i = self.used
        while i > 0:
            i -= 1
            if self.limb[i] != other.limb[i]:
                return self.limb[i] > other.limb[i]
        return true

    ## `self -= other`, with `self >= other`.
    mutating func subtract(other: const Big*):
        var borrow: u64 = 0
        var i: usize = 0
        while i < self.used:
            let taken: u64 = (u64)other.limb[i] if i < other.used else 0
            let t = (u64)self.limb[i] -% taken -% borrow
            borrow = 1 if (u64)self.limb[i] < taken + borrow else 0
            self.limb[i] = (u32)t
            i += 1
        self.trim()

## One IEEE width.
struct Format:
    ## Significant bits, the hidden one included.
    var precision: u64
    ## Of the smallest normal.
    var min_exponent: i64
    ## Of the largest finite.
    var max_exponent: i64
    var exponent_bits: u64

    static func of(width: u32) -> Format?:
        if width == 64:
            return Format(precision = 53, min_exponent = -1022, max_exponent = 1023, exponent_bits = 11)
        if width == 32:
            return Format(precision = 24, min_exponent = -126, max_exponent = 127, exponent_bits = 8)
        if width == 16:
            return Format(precision = 11, min_exponent = -14, max_exponent = 15, exponent_bits = 5)
        return none

    func infinity() -> u64:
        let one: u64 = 1
        return ((one << self.exponent_bits) - 1) << (self.precision - 1)

let digit_cap: usize = 800

## The bits of `text` (digits, one optional point, an optional exponent, `_` separators,
## no sign and no suffix) as a float of `width` bits, 16, 32, or 64; `none` when the text
## is not such a literal.
pub func bits(text: str, width: u32) -> u64?:
    let f = Format.of(width) else return none
    let b = text.bytes
    # the significant digits, leading zeros dropped, and the exponent of the last one
    var digits: u8[800]
    var count: usize = 0
    var sticky = false
    # the decimal exponent of the digit after the last kept one
    var exponent: i64 = 0
    var seen_digit = false
    var seen_point = false
    var i: usize = 0
    while i < b.length and b[i] != 'e' and b[i] != 'E':
        let c = b[i]
        i += 1
        if c == '_':
            continue
        if c == '.':
            if seen_point:
                return none
            seen_point = true
            continue
        if c < '0' or c > '9':
            return none
        seen_digit = true
        if seen_point:
            exponent -= 1
        if count == 0 and c == '0':
            # a leading zero has no weight
            continue
        if count < digit_cap:
            digits[count] = c
            count += 1
        else:
            # beyond the cap the digit's weight moves into the exponent; its value only
            # matters for a tie
            exponent += 1
            if c != '0':
                sticky = true
    if not seen_digit:
        return none
    if i < b.length:
        # the `e`
        i += 1
        var negative = false
        if i < b.length and (b[i] == '+' or b[i] == '-'):
            negative = b[i] == '-'
            i += 1
        if i == b.length:
            return none
        var given: i64 = 0
        while i < b.length:
            let c = b[i]
            i += 1
            if c == '_':
                continue
            if c < '0' or c > '9':
                return none
            # any larger exponent is already an overflow or a zero
            if given < 100000:
                given = given * 10 + (i64)(c - '0')
        exponent += -given if negative else given
    if count == 0:
        return 0
    # trailing zeros carry no information: fold them into the exponent
    while count > 0 and digits[count - 1] == '0':
        count -= 1
        exponent += 1
    # the value is in [10^(count + exponent - 1), 10^(count + exponent)): past the largest
    # double it is an infinity, below half the smallest subnormal it is zero
    if (i64)count + exponent > 310:
        return f.infinity()
    if (i64)count + exponent < -400:
        return 0
    var num = Big.of(0)
    var k: usize = 0
    while k < count:
        if not num.mul_add(10, (u32)(digits[k] - '0')):
            return none
        k += 1
    var den = Big.of(1)
    var e = exponent
    while e > 0:
        if not num.mul_add(10, 0):
            return none
        e -= 1
    while e < 0:
        if not den.mul_add(10, 0):
            return none
        e += 1
    # scale so that the quotient has p + 3 or p + 4 bits
    let scale = (i64)den.bit_length() - (i64)num.bit_length() + (i64)f.precision + 3
    if scale >= 0:
        if not num.shift_left((usize)scale):
            return none
    elif not den.shift_left((usize)(-scale)):
        return none
    # restoring division: the quotient bit by bit, from its highest
    let top = num.bit_length() - den.bit_length()
    if not den.shift_left(top):
        return none
    var quotient: u64 = 0
    var j = top + 1
    while j > 0:
        j -= 1
        quotient <<= 1
        if num.at_least(&den):
            num.subtract(&den)
            quotient |= 1
        den.shift_right_one()
    if not num.is_zero():
        sticky = true
    # the value is quotient * 2^-scale, and more when sticky
    var length: u64 = 0
    var q = quotient
    while q != 0:
        length += 1
        q >>= 1
    # of the leading bit
    var exponent2 = (i64)length - 1 - scale
    if exponent2 > f.max_exponent:
        return f.infinity()
    var keep = (i64)f.precision
    if exponent2 < f.min_exponent:
        keep = (i64)f.precision - (f.min_exponent - exponent2)
    let one: u64 = 1
    if keep <= 0:
        # at most half the smallest subnormal: exactly half is a tie, and even is zero
        if keep == 0:
            let half = one << (length - 1)
            return 1 if quotient > half or (quotient == half and sticky) else 0
        return 0
    let shift = length - (u64)keep
    var kept = quotient >> shift
    let dropped = quotient & ((one << shift) - 1)
    let half = one << (shift - 1)
    if dropped > half or (dropped == half and (sticky or (kept & 1) != 0)):
        kept += 1
    let hidden = one << (f.precision - 1)
    if kept == hidden << 1:
        kept = hidden
        exponent2 += 1
        if exponent2 > f.max_exponent:
            return f.infinity()
    if exponent2 < f.min_exponent:
        # a subnormal's bits are its mantissa; one that rounded up to the hidden bit is the
        # smallest normal, whose bits are that same number
        return kept
    let bias = (one << (f.exponent_bits - 1)) - 1
    return (((u64)(exponent2 + (i64)bias)) << (f.precision - 1)) | (kept - hidden)

## Whether the literal is beyond the width's largest finite value, so that its rounding
## would be an infinity, which is not a literal (§4.3).
pub func overflows(text: str, width: u32) -> bool:
    let f = Format.of(width) else return false
    let value = bits(text, width) else return false
    return value == f.infinity()

func bits_of(text: str, width: u32) -> u64:
    let v = bits(text, width) else return ~(u64)0
    return v

test "decimal literals round once at every width":
    assert(bits_of("1e-10", 64) == 4457293557087583675)
    assert(bits_of("1e-10", 32) == 786163455)
    assert(bits_of("1e-10", 16) == 0)
    assert(bits_of("1e-20", 64) == 4307583784117748259)
    assert(bits_of("1e-20", 32) == 507307272)
    assert(bits_of("1e-20", 16) == 0)
    assert(bits_of("1e-100", 64) == 3110860544497550640)
    assert(bits_of("1e-100", 32) == 0)
    assert(bits_of("1e-100", 16) == 0)
    assert(bits_of("2.2250738585072014e-308", 64) == 4503599627370496)
    assert(bits_of("2.2250738585072014e-308", 32) == 0)
    assert(bits_of("2.2250738585072014e-308", 16) == 0)
    assert(bits_of("1.7976931348623157e308", 64) == 9218868437227405311)
    assert(bits_of("1.7976931348623157e308", 32) == 2139095040)
    assert(bits_of("1.7976931348623157e308", 16) == 31744)
    assert(bits_of("0.1", 64) == 4591870180066957722)
    assert(bits_of("0.1", 32) == 1036831949)
    assert(bits_of("0.1", 16) == 11878)
    assert(bits_of("0.29", 64) == 4598895795485655695)
    assert(bits_of("0.29", 32) == 1049918177)
    assert(bits_of("0.29", 16) == 13476)
    assert(bits_of("1.2345678901234567", 64) == 4608238818662570491)
    assert(bits_of("1.2345678901234567", 32) == 1067320914)
    assert(bits_of("1.2345678901234567", 16) == 15600)
    assert(bits_of("5e-324", 64) == 1)
    assert(bits_of("5e-324", 32) == 0)
    assert(bits_of("5e-324", 16) == 0)
    assert(bits_of("2.4703282292062327e-324", 64) == 0)
    assert(bits_of("2.4703282292062327e-324", 32) == 0)
    assert(bits_of("2.4703282292062327e-324", 16) == 0)
    assert(bits_of("2.4703282292062328e-324", 64) == 1)
    assert(bits_of("2.4703282292062328e-324", 32) == 0)
    assert(bits_of("2.4703282292062328e-324", 16) == 0)
    assert(bits_of("1.7976931348623158e308", 64) == 9218868437227405311)
    assert(bits_of("1.7976931348623158e308", 32) == 2139095040)
    assert(bits_of("1.7976931348623158e308", 16) == 31744)
    assert(bits_of("1.7976931348623159e308", 64) == 9218868437227405312)
    assert(bits_of("1.7976931348623159e308", 32) == 2139095040)
    assert(bits_of("1.7976931348623159e308", 16) == 31744)
    assert(bits_of("1e309", 64) == 9218868437227405312)
    assert(bits_of("1e309", 32) == 2139095040)
    assert(bits_of("1e309", 16) == 31744)
    assert(bits_of("1e-400", 64) == 0)
    assert(bits_of("1e-400", 32) == 0)
    assert(bits_of("1e-400", 16) == 0)
    assert(bits_of("9007199254740993", 64) == 4845873199050653696)
    assert(bits_of("9007199254740993", 32) == 1509949440)
    assert(bits_of("9007199254740993", 16) == 31744)
    assert(bits_of("9007199254740993.0000000000000000000001", 64) == 4845873199050653697)
    assert(bits_of("9007199254740993.0000000000000000000001", 32) == 1509949440)
    assert(bits_of("9007199254740993.0000000000000000000001", 16) == 31744)
    assert(bits_of("", 64) == 9218868437227405312)
    assert(bits_of("", 32) == 2139095040)
    assert(bits_of("", 16) == 31744)
    assert(bits_of("0.", 64) == 103904837566199265)
    assert(bits_of("0.", 32) == 0)
    assert(bits_of("0.", 16) == 0)
    assert(bits_of("65504", 64) == 4679235614791434240)
    assert(bits_of("65504", 32) == 1199562752)
    assert(bits_of("65504", 16) == 31743)
    assert(bits_of("65505", 64) == 4679235752230387712)
