    assert(bits_of("2050.0000000000000001", 32) == 1157636096)
    assert(bits_of("2050.0000000000000001", 16) == 26625)
    assert(bits_of("0.000000059604644775390625", 64) == 4499096027743125504)
    assert(bits_of("0.000000059604644775390625", 32) == 864026624)
    assert(bits_of("0.000000059604644775390625", 16) == 1)
    assert(bits_of("0.0000000298023223876953125", 64) == 4494592428115755008)
    assert(bits_of("0.0000000298023223876953125", 32) == 855638016)
    assert(bits_of("0.0000000298023223876953125", 16) == 0)
    assert(bits_of("0.00000002980232238769531250000001", 64) == 4494592428115755008)
    assert(bits_of("0.00000002980232238769531250000001", 32) == 855638016)
    assert(bits_of("0.00000002980232238769531250000001", 16) == 1)
    assert(bits_of("3.4028235e38", 64) == 5183643170655547384)
    assert(bits_of("3.4028235e38", 32) == 2139095039)
    assert(bits_of("3.4028235e38", 16) == 31744)
    assert(bits_of("3.4028236e38", 64) == 5183643170920245180)
    assert(bits_of("3.4028236e38", 32) == 2139095040)
    assert(bits_of("3.4028236e38", 16) == 31744)
    assert(bits_of("3.4028235677973366e38", 64) == 5183643170835005440)
    assert(bits_of("3.4028235677973366e38", 32) == 2139095039)
    assert(bits_of("3.4028235677973366e38", 16) == 31744)
    assert(bits_of("3.4028235677973367e38", 64) == 5183643170835005440)
    assert(bits_of("3.4028235677973367e38", 32) == 2139095040)
    assert(bits_of("3.4028235677973367e38", 16) == 31744)
    assert(bits_of("1.4e-45", 64) == 3936137728114922858)
    assert(bits_of("1.4e-45", 32) == 1)
    assert(bits_of("1.4e-45", 16) == 0)
    assert(bits_of("7.006492321624085e-46", 64) == 3931642474694443008)
    assert(bits_of("7.006492321624085e-46", 32) == 0)
    assert(bits_of("7.006492321624085e-46", 16) == 0)
    assert(bits_of("7.0064923216240854e-46", 64) == 3931642474694443008)
    assert(bits_of("7.0064923216240854e-46", 32) == 1)
