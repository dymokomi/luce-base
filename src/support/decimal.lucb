test "long digit strings decide ties, and the ends of the range":
    var past: u8[904]
    past[0] = '2'
    past[1] = '0'
    past[2] = '4'
    past[3] = '9'
    past[4] = '.'
    var i: usize = 5
    while i < 903:
        past[i] = '0'
        i += 1
    past[903] = '1'
    assert(bits_of((str)past[..<904], 16) == 26625)
    assert(bits_of((str)past[..<903], 16) == 26624)
    var huge: u8[5001]
    huge[0] = '1'
    i = 1
    while i < 5001:
        huge[i] = '0'
        i += 1
    assert(bits_of((str)huge[..<5001], 64) == 9218868437227405312)
    assert(bits_of("1e-99999999999999999999", 64) == 0)
    assert(bits_of("1e99999999999999999999", 32) == 2139095040)

test "what is not a literal is refused":
    let refused = ~(u64)0
    assert(bits_of("", 64) == refused)
    assert(bits_of(".", 64) == refused)
    assert(bits_of("1.2.3", 64) == refused)
    assert(bits_of("1e", 64) == refused)
    assert(bits_of("1e+", 64) == refused)
    assert(bits_of("1x", 64) == refused)
    assert(bits_of("1.5", 48) == refused)
    assert(bits_of("1_000.5", 64) == 4652011706887700480)
