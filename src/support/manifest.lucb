#==============================================================================================
#
#   manifest - The package manifest, `luce.toml`
#
#   DESCRIPTION:
#       A package has a `luce.toml` at its root (base.md §16.4). This reads the little of it
#       the compiler needs: `[package] name`, the identity of the package's error codes
#       (§11.3); `symbol_prefix`, what every exported symbol starts with (§17.6); and the
#       `[native]` inputs the build hands the C compiler and the linker (§17.4); and, for the
#       module resolver, the source root, the dependencies, the exports, and the compiled
#       modules' package identities (§16.4). The file is found upward from the entry file's
#       directory; a program without one is the package `app` with no inputs. `settings`
#       is the one line reader: every `key = value` line under its `[section]`, with either
#       TOML quoting, a trailing comment dropped, and any other line refused.
#
#==============================================================================================

import paths
import c
import platform
import files
import support.cache as cache
import memory

# mark: Settings ==============================================================================

## A manifest line or value is malformed.
pub let malformed: ErrorCode = ErrorCode.package(17)

## One `key = value` line of a manifest, under its section, the value unquoted.
pub struct Setting:
    ## The `[section]` header the setting falls under.
    pub var section: str
    ## The setting's key, trimmed.
    pub var key: str
    ## The setting's value, unquoted and trimmed.
    pub var value: str

## Every setting of the manifest `text`, in order.
pub func settings(text: str) -> Setting[]!:
    var out = try alloc Setting[count_lines(text) + 1]
    var count: usize = 0
    var section: str = ""
    var rest = text
    while rest.length > 0:
        let cut = find_byte(rest, '\n')
        let line = trim((str)rest.bytes[..<cut])
        rest = (str)rest.bytes[cut + 1..] if cut < rest.length else ""
        if line.length == 0 or line.bytes[0] == '#':
            continue
        if line.bytes[0] == '[':
            section = line
            continue
        let eq = find_byte(line, '=')
        if eq >= line.length:
            return error(malformed, "a manifest line is neither a section nor `key = value`")
        out[count] = Setting(section = section, key = trim((str)line.bytes[..<eq]), value = unquote(trim((str)line.bytes[eq + 1..])))
        count += 1
    return out[..<count]

func count_lines(text: str) -> usize:
    var n: usize = 0
    for b in text.bytes:
        if b == '\n':
            n += 1
    return n

# mark: Manifests =============================================================================

## What the manifest says; the lists hold NUL-terminated text, ready for a tool's arguments.
pub struct Manifest:
    ## The package's name.
    pub var name: str
    ## The directory holding `luce.toml`, with its trailing slash; empty when none was found.
    pub var root: str
    ## The prefix put before exported C symbols, or empty.
    pub var symbol_prefix: str
    ## The C source files to compile alongside the program, NUL-terminated.
    pub var sources: c.str[]
    ## The libraries to link, NUL-terminated.
    pub var libraries: c.str[]
    ## The directories to search for libraries, NUL-terminated.
    pub var link_search: c.str[]
    ## The macOS frameworks to link, NUL-terminated.
    pub var frameworks: c.str[]
    ## The pkg-config packages whose flags to add, NUL-terminated.
    pub var pkg_config: c.str[]

## The manifest of the package holding `entry_path`, or the default one.
pub func load(entry_path: str) -> Manifest!:
    var dir = directory_of(entry_path)
    while true:
        var buffer = try alloc u8[dir.length + 16]
        let candidate = try format(buffer, f"{dir}luce.toml")
        if let text = read_if_present((c.str)candidate):
            return try parse((str)text, dir)
        if dir.length == 0:
            return try parse("", "")
        dir = parent_of(dir)

## The bytes of the file at `path`, or `none` when there is no such file.
func read_if_present(path: c.str) -> u8[]?:
    let data = files.read(path) catch:
        return none
    cache.note_input((str)path, data)
    return data

## The manifest `text` describes, for the package rooted at `root`.
pub func parse(text: str, root: str) -> Manifest!:
    var m = Manifest(name = "app", root = root, symbol_prefix = "", sources = try no_items(), libraries = try no_items(),
                     link_search = try no_items(), frameworks = try no_items(), pkg_config = try no_items())
    for setting in try settings(text):
        let section = setting.section
        let key = setting.key
        let value = setting.value
        if section == "[package]":
            if key == "name":
                m.name = value
            elif key == "symbol_prefix":
                m.symbol_prefix = value
        elif section == "[native]":
            if key == "sources":
                m.sources = try items_of(value)
            elif key == "libraries":
                m.libraries = try items_of(value)
            elif key == "link_search":
                m.link_search = try items_of(value)
            elif key == "frameworks":
                m.frameworks = try items_of(value)
            elif key == "pkg_config":
                m.pkg_config = try items_of(value)
    return m

## `["a", "b"]` as its strings, each copied with a NUL after it; a bare string is one item.
func items_of(value: str) -> c.str[]!:
    var body = value
    if body.length >= 2 and body.bytes[0] == '[' and body.bytes[body.length - 1] == ']':
        body = (str)body.bytes[1..<body.length - 1]
    var out = try alloc c.str[body.length + 1]
    var count: usize = 0
    var at: usize = 0
    while at < body.length:
        while at < body.length and (body.bytes[at] == ' ' or body.bytes[at] == '\t'):
            at += 1
        if at == body.length or body.bytes[at] == '#':
            break
        let quote = body.bytes[at]
        if quote != '"' and quote != '\'':
            error(malformed, "native inputs must be quoted strings")
        at += 1
        let text = try alloc u8[body.length + 1]
        var used: usize = 0
        var ended = false
        while at < body.length:
            var byte = body.bytes[at]
            at += 1
            if byte == quote:
                ended = true
                break
            if byte == '\\' and quote == '"':
                if at == body.length:
                    error(malformed, "unterminated native input escape")
                byte = body.bytes[at]
                at += 1
                if byte == 'n':
                    byte = '\n'
                elif byte == 'r':
                    byte = '\r'
                elif byte == 't':
                    byte = '\t'
                elif byte != '"' and byte != '\\':
                    error(malformed, "unsupported native input escape")
            if byte == 0:
                error(malformed, "native inputs cannot contain NUL")
            text[used] = byte
            used += 1
        if not ended or used == 0:
            error(malformed, "native inputs must be nonempty terminated strings")
        text[used] = 0
        out[count] = (c.str)text.data
        count += 1
        while at < body.length and (body.bytes[at] == ' ' or body.bytes[at] == '\t'):
            at += 1
        if at < body.length:
            if body.bytes[at] != ',':
                error(malformed, "native input strings must be separated by commas")
            at += 1
    return out[..<count]

# mark: Text and paths ========================================================================

## A TOML string's text: `"basic"` or `'literal'`, with a trailing `# comment` dropped; a
## bare value stays as written.
pub func unquote(value: str) -> str:
    let b = value.bytes
    if b.length >= 2 and (b[0] == '"' or b[0] == '\''):
        var end: usize = 1
        while end < b.length and b[end] != b[0]:
            end += 1
        if end < b.length:
            return (str)b[1..<end]
    return value

## The index of `wanted` in `text`, or the length when absent.
func find_byte(text: str, wanted: u8) -> usize:
    var i: usize = 0
    for b in text.bytes:
        if b == wanted:
            return i
        i += 1
    return text.length

## `text` without the blanks at either end.
func trim(text: str) -> str:
    let b = text.bytes
    var start: usize = 0
    var end = b.length
    while start < end and (b[start] == ' ' or b[start] == '\t' or b[start] == '\r'):
        start += 1
    while end > start and (b[end - 1] == ' ' or b[end - 1] == '\t' or b[end - 1] == '\r'):
        end -= 1
    return (str)b[start..<end]

func no_items() -> c.str[]!:
    var none_at_all = try alloc c.str[1]
    return none_at_all[..<0]

## The directory part of a path, with its trailing slash; empty for a bare name.
pub func directory_of(path: str) -> str:
    let b = path.bytes
    var end: usize = 0
    var i: usize = 0
    while i < b.length:
        if paths.separator(b[i]):
            end = i + 1
        i += 1
    return (str)b[..<end]

## The directory above `dir`, with its trailing slash; empty at the top.
pub func parent_of(dir: str) -> str:
    if paths.root(dir).length == dir.length:
        return ""
    let b = dir.bytes
    if b.length == 0:
        return ""
    var end: usize = 0
    var i: usize = 0
    while i + 1 < b.length:
        if paths.separator(b[i]):
            end = i + 1
        i += 1
    return (str)b[..<end]

test "a manifest names the package, the prefix, and the native inputs":
    var backing: u8[8192]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        let m = try parse("# the package\n[package]\nname = \"widgets\"\nsymbol_prefix = \"wg_\"\n\n[native]\nsources = [\"vendor/a.c\", \"shims.c\"]\nlibraries = [\"m\"]\nframeworks = [\"Metal\"]\n", "pkg/")
        assert(m.name == "widgets")
        assert(m.symbol_prefix == "wg_")
        assert(m.root == "pkg/")
        assert(m.sources.length == 2)
        assert((str)m.sources[1] == "shims.c")
        assert(m.libraries.length == 1)
        assert(m.frameworks.length == 1)
        assert(m.pkg_config.length == 0)
        let none_at_all = try parse("", "")
        assert(none_at_all.name == "app")
        assert(none_at_all.sources.length == 0)

test "every setting is read under its section, with either quoting and no comment":
    var backing: u8[8192]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        let found = try settings("[package]\nname = 'w'  # the name\n\n[other]\nflag = \"on\"\n")
        assert(found.length == 2)
        assert(found[0].section == "[package]" and found[0].key == "name" and found[0].value == "w")
        assert(found[1].section == "[other]" and found[1].value == "on")
        let bad = settings("[package]\njust-a-flag\n") catch failure:
            recover found[..<0]
        assert(bad.length == 0)
