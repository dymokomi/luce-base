import c
import platform
from io import Writer

extern func socket(domain: i32, kind: i32, protocol: i32) -> i32
extern func bind(descriptor: i32, address: const SocketAddress*, length: u32) -> i32
extern func listen(descriptor: i32, backlog: i32) -> i32
extern func accept(descriptor: i32, address: SocketAddress*?, length: u32*?) -> i32
extern func connect(descriptor: i32, address: const SocketAddress*, length: u32) -> i32
extern func send(descriptor: i32, data: const void*, length: usize, flags: i32) -> isize
extern func recv(descriptor: i32, buffer: void*, length: usize, flags: i32) -> isize
extern func sendto(descriptor: i32, data: const void*, length: usize, flags: i32, address: const SocketAddress*, address_length: u32) -> isize
extern func recvfrom(descriptor: i32, buffer: void*, length: usize, flags: i32, address: SocketAddress*?, address_length: u32*?) -> isize
extern func close(descriptor: i32) -> i32
extern func setsockopt(descriptor: i32, level: i32, option: i32, value: const void*, length: u32) -> i32
extern func getsockname(descriptor: i32, address: SocketAddress*, length: u32*) -> i32
extern func getaddrinfo(host: c.str, service: c.str?, hints: const AddressInfo*?, result: AddressInfo*?*) -> i32
extern func freeaddrinfo(info: AddressInfo*)

## `sockaddr_in`: 16 bytes everywhere; macOS splits the first two into a length and a
## one-byte family, Linux keeps a two-byte family. `family_word` reads and writes it.
extern struct SocketAddress:
    head: u16
    port: u16
    address: u32
    zero: u8[8]

## The first two bytes of `sockaddr_in` as one little-endian word: on macOS the length
## byte (16) comes first and the family byte second, on Linux the family fills both.
func family_word(family: u8) -> u16:
    if platform.macos:
        return (u16)16 | ((u16)family << 8)
    return (u16)family

## `addrinfo`: macOS puts the canonical name before the address, Linux after it.
extern struct AddressInfo:
    flags: i32
    family: i32
    kind: i32
    protocol: i32
    address_length: u32
    fifth: void*?
    sixth: void*?
    next: AddressInfo*?

func info_address(info: AddressInfo*) -> SocketAddress*?:
    let raw = info.sixth if platform.macos else info.fifth
    let p = raw else return none
    return (SocketAddress*)p

let inet: i32 = 2
let stream: i32 = 1
let datagram: i32 = 2
## `SOL_SOCKET` and `SO_REUSEADDR`: 65535 and 4 on macOS, 1 and 2 on Linux.
let socket_level: i32 = 65535 if platform.macos else 1
let reuse_address: i32 = 4 if platform.macos else 2
## A write to a socket the peer closed answers an error, never the process's death:
## macOS marks the socket (`SO_NOSIGPIPE`, 4130), Linux marks the send (`MSG_NOSIGNAL`,
## 16384).
let no_sigpipe_option: i32 = 4130
let send_flags: i32 = 0 if platform.macos else 16384

pub let failed: ErrorCode = ErrorCode.package(9)
pub let closed: ErrorCode = ErrorCode.package(10)
pub let unknown_host: ErrorCode = ErrorCode.package(11)

## An IPv4 address and port, both in host order.
pub struct Address:
    pub var ip: u32
    pub var port: u16

    pub static func loopback(port: u16) -> Address:
        return Address(ip = 2130706433, port = port)

    pub static func any(port: u16) -> Address:
        return Address(ip = 0, port = port)

    func raw() -> SocketAddress:
        var zero: u8[8]
        return SocketAddress(head = family_word(2), port = swap16(self.port), address = swap32(self.ip), zero = zero)

    static func from_raw(raw: SocketAddress) -> Address:
        return Address(ip = swap32(raw.address), port = swap16(raw.port))

## Host to network byte order and back; the machine is little-endian.
func swap16(value: u16) -> u16:
    return (value << 8) | (value >> 8)

func swap32(value: u32) -> u32:
    return (value << 24) | ((value << 8) & 16711680) | ((value >> 8) & 65280) | (value >> 24)

## The first usable IPv4 stream address of `host`. Resolution may block in the OS.
## All resolver storage is released before returning, including malformed results.
pub func resolve(host: c.str, port: u16) -> Address!:
    var hints = AddressInfo(flags = 0, family = inet, kind = stream, protocol = 0, address_length = 0, fifth = none, sixth = none, next = none)
    var found: AddressInfo*? = none
    if getaddrinfo(host, none, &hints, &found) != 0:
        error(unknown_host, "unknown host")
    let info = found else error(unknown_host, "unknown host")
    defer freeaddrinfo(info)
    var current: AddressInfo*? = info
    while let entry = current:
        if entry.family == inet and entry.kind == stream and entry.address_length >= sizeof(SocketAddress):
            if let raw = info_address(entry):
                var address = Address.from_raw(*raw)
                address.port = port
                return address
        current = entry.next
    error(unknown_host, "the host has no usable IPv4 stream address")

## A bound TCP socket waiting for connections.
pub struct Listener:
    var descriptor: i32

    pub static func bind(address: Address) -> Listener!:
        let fd = socket(inet, stream, 0)
        if fd < 0:
            error(failed, "socket")
        var yes: i32 = 1
        discard(setsockopt(fd, socket_level, reuse_address, &yes, 4))
        let raw = address.raw()
        if bind(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "bind")
        if listen(fd, 16) != 0:
            discard(close(fd))
            error(failed, "listen")
        return Listener(descriptor = fd)

    ## The address the socket ended up with; a port of zero asked for any free one.
    pub func address() -> Address:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        discard(getsockname(self.descriptor, &raw, &length))
        return Address.from_raw(raw)

    pub func accept() -> Connection!:
        var fd = accept(self.descriptor, none, none)
        while fd < 0 and c.errno() == c.interrupted:
            fd = accept(self.descriptor, none, none)
        if fd < 0:
            error(failed, "accept")
        return Connection.over(fd)

    pub func close():
        discard(close(self.descriptor))

## One TCP connection; it is a `Writer`.
pub struct Connection: Writer:
    ## The socket, for callers that poll or pass it on.
    pub var descriptor: i32
    ## Whether the socket is marked against `SIGPIPE` (macOS); `write` marks it on first
    ## use, so a connection built any other way than `over` is guarded too.
    var guarded: bool

    pub static func connect(address: Address) -> Connection!:
        let fd = socket(inet, stream, 0)
        if fd < 0:
            error(failed, "socket")
        let raw = address.raw()
        if connect(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "connect")
        return Connection.over(fd)

    ## A connection over a socket the caller made (a `socketpair`, an inherited
    ## descriptor): the socket is marked so that a write after the peer closed fails
    ## instead of ending the process. Make the connection while the peer is still there:
    ## macOS refuses the mark on a socket whose peer has already gone, and a write on
    ## such a connection answers `closed` without sending.
    pub static func over(descriptor: i32) -> Connection:
        var connection = Connection(descriptor = descriptor, guarded = false)
        discard(connection.guard())
        return connection

    ## Whether a write cannot raise `SIGPIPE`. Linux asks with every `send`
    ## (`MSG_NOSIGNAL`); macOS marks the socket once (`SO_NOSIGPIPE`), and refuses the mark
    ## with `EINVAL` on a socket whose peer has disconnected.
    mutating func guard() -> bool:
        if self.guarded:
            return true
        if not platform.macos:
            self.guarded = true
            return true
        var yes: i32 = 1
        if setsockopt(self.descriptor, socket_level, no_sigpipe_option, &yes, 4) == 0:
            self.guarded = true
        return self.guarded

    ## Send every byte; a peer that closed is `closed`, never a signal.
    pub mutating func write(data: const u8[]) -> usize!:
        if not self.guard():
            error(closed, "the connection closed")
        var done: usize = 0
        while done < data.length:
            let n = send(self.descriptor, data[done..].data, data.length - done, send_flags)
            if n < 0 and c.errno() == c.interrupted:
                continue
            if n <= 0:
                error(closed, "the connection closed")
            done += (usize)n
        return done

    ## Receive what is available, up to the buffer; zero means the peer closed.
    pub func receive(buffer: u8[]) -> usize!:
        var n = recv(self.descriptor, buffer.data, buffer.length, 0)
        while n < 0 and c.errno() == c.interrupted:
            n = recv(self.descriptor, buffer.data, buffer.length, 0)
        if n < 0:
            error(closed, "the connection closed")
        return (usize)n

    pub func close():
        discard(close(self.descriptor))

## A UDP socket.
pub struct Datagram:
    var descriptor: i32

    pub static func bind(address: Address) -> Datagram!:
        let fd = socket(inet, datagram, 0)
        if fd < 0:
            error(failed, "socket")
        let raw = address.raw()
        if bind(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "bind")
        return Datagram(descriptor = fd)

    pub func address() -> Address:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        discard(getsockname(self.descriptor, &raw, &length))
        return Address.from_raw(raw)

    pub func send_to(data: const u8[], address: Address) -> !:
        let raw = address.raw()
        var n = sendto(self.descriptor, data.data, data.length, 0, &raw, 16)
        while n < 0 and c.errno() == c.interrupted:
            n = sendto(self.descriptor, data.data, data.length, 0, &raw, 16)
        if n < 0 or (usize)n != data.length:
            error(failed, "send")

    pub func receive_from(buffer: u8[]) -> (usize, Address)!:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        var n = recvfrom(self.descriptor, buffer.data, buffer.length, 0, &raw, &length)
        while n < 0 and c.errno() == c.interrupted:
            length = 16
            n = recvfrom(self.descriptor, buffer.data, buffer.length, 0, &raw, &length)
        if n < 0:
            error(failed, "receive")
        return ((usize)n, Address.from_raw(raw))

    pub func close():
        discard(close(self.descriptor))
