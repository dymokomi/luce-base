#==============================================================================================
#
#   platform - The target of the build and the program's package, as constants
#
#   DESCRIPTION:
#       Generated by the compiler from `--target` and the package's manifest (§19.5,
#       `Target.module_text`); this file is the placeholder the checker replaces when it
#       reads the library. `os` re-exports the target's constants for programs; the standard
#       library branches on them directly.
#
#==============================================================================================

## The target triple, such as `arm64-macos`.
pub let name: str = "arm64-macos"
## Whether the target operating system is macOS.
pub let macos: bool = true
## Whether the target operating system is Linux.
pub let linux: bool = false
## Whether the target operating system is Windows.
pub let windows: bool = false
## Whether the target is a POSIX system.
pub let posix: bool = true
## Whether the target architecture is arm64.
pub let arm64: bool = true
## Whether the target architecture is x86-64.
pub let x86_64: bool = false
## The width of a pointer on the target, in bits.
pub let pointer_bits: u32 = 64
## The instruction-set level the program is compiled for (§19.5): 1 is the family's baseline.
pub let cpu_level: u32 = 1
## The native socket ABI: pointer-sized on Windows, int on POSIX.
pub type SocketDescriptor = i32
## The package this program is built from, as its manifest names it; `app` outside any package.
pub let program: str = "app"
## That package's version, empty when its manifest gives none.
pub let program_version: str = ""
