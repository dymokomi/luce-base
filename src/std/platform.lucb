## The target of the build, as constants (§19.5): generated by the compiler from
## `--target` (`Target.module_text`); this placeholder is what the prelude embeds and the
## checker replaces. `os` re-exports these for programs; the standard library branches
## on them directly.
pub let name: str = "arm64-macos"
pub let macos: bool = true
pub let linux: bool = false
pub let windows: bool = false
pub let posix: bool = true
pub let arm64: bool = true
pub let x86_64: bool = false
pub let pointer_bits: u32 = 64
