import c
import core
import memory
import platform
extern func fwrite(data: const void*, size: usize, count: usize, stream: void*) -> usize
extern func fflush(stream: void*?) -> i32
extern func flockfile(stream: void*)
extern func funlockfile(stream: void*)
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize

## A borrowed byte source. A successful read returns at most the buffer length;
## zero for a nonempty buffer means EOF. Empty reads return zero without consuming
## input. Errors are distinct from EOF. The implementing object owns its lifetime.
pub interface Reader:
    mutating func read(buffer: u8[]) -> usize!

## A borrowed byte sink (§14.4). A write may accept fewer bytes than supplied;
## callers needing the whole payload use `write_all`. Empty writes return zero.
## A failure may follow earlier successful writes; the view never owns the sink.
pub interface Writer:
    mutating func write(data: const u8[]) -> usize!

pub let unexpected_eof: ErrorCode = ErrorCode.package(14)
pub let no_progress: ErrorCode = ErrorCode.package(15)
pub let invalid_count: ErrorCode = ErrorCode.package(16)
pub let invalid_buffer: ErrorCode = ErrorCode.package(17)

## Fill `buffer`, or fail at EOF or on a source error. Optional `transferred` is
## reset to zero on entry and updated after each successful read, including before
## a later failure. It must not overlap the buffer or the source's state. No call
## reaches the source for an empty buffer. The source remains borrowed and open.
pub func read_exact(source: Reader, buffer: u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < buffer.length:
        let count = try source.read(buffer[done..])
        if count > buffer.length - done:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            error(unexpected_eof, "the reader ended before the buffer was filled")
        done += count
        if let progress = transferred:
            *progress = done

## Write all bytes, preserving confirmed progress through `transferred` on error.
## The progress pointer must not overlap the data or sink state. A zero-length
## successful write on nonempty input fails with `no_progress` instead of spinning.
## This does not flush or close the borrowed sink. Empty input makes no sink call.
pub func write_all(destination: Writer, data: const u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < data.length:
        let count = try destination.write(data[done..])
        if count > data.length - done:
            error(invalid_count, "the writer returned more bytes than supplied")
        if count == 0:
            error(no_progress, "the writer accepted no bytes")
        done += count
        if let progress = transferred:
            *progress = done

## Copy at most `limit` bytes through caller-owned scratch storage; stop earlier
## at EOF. Reads never consume beyond the limit. `transferred` counts confirmed
## destination bytes, including before a failure; source consumption can be ahead
## by one scratch buffer if writing fails. Scratch and progress must not overlap
## either endpoint's state/data or each other. No allocation, flush or close occurs.
pub func copy_limit(source: Reader, destination: Writer, buffer: u8[], limit: usize, transferred: usize*? = none) -> usize!:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    if limit == 0:
        return 0
    if buffer.length == 0:
        error(invalid_buffer, "copying requires a nonempty scratch buffer")
    while done < limit:
        let available = limit - done
        let requested = buffer.length if buffer.length < available else available
        let count = try source.read(buffer[..<requested])
        if count > requested:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            break
        var written: usize = 0
        write_all(destination, buffer[..<count], &written) catch failure:
            if let progress = transferred:
                *progress = done + written
            error(failure.code, failure.message)
        done += written
        if let progress = transferred:
            *progress = done
    return done

## A cursor over borrowed bytes. Copying the reader copies its position, not its
## data. The backing storage must outlive the reader and every read using it.
pub struct SliceReader: Reader:
    var data: const u8[]
    var position: usize

    pub static func over(data: const u8[]) -> SliceReader:
        return SliceReader(data = data, position = 0)

    pub func remaining() -> usize:
        return self.data.length - self.position

    ## Copy up to the buffer length; zero means no bytes remain (or an empty read).
    pub mutating func read(buffer: u8[]) -> usize!:
        let left = self.remaining()
        let count = buffer.length if buffer.length < left else left
        memory.move(buffer, self.data[self.position..], count)
        self.position += count
        return count

## A writer into fixed borrowed storage. Copying it copies the cursor and aliases
## storage. Writes may be short; once full, a nonempty write fails with `full`.
pub struct SliceWriter: Writer:
    var data: u8[]
    var used: usize

    pub static func over(data: u8[]) -> SliceWriter:
        return SliceWriter(data = data, used = 0)

    ## View of confirmed written bytes, borrowed from the caller's storage.
    pub func written() -> const u8[]:
        return self.data[..<self.used]

    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let left = self.data.length - self.used
        if left == 0:
            error(full, "the destination buffer is full")
        let count = data.length if data.length < left else left
        memory.move(self.data[self.used..], data, count)
        self.used += count
        return count

## Buffered input over a borrowed source and nonempty caller-owned storage. Both
## must outlive this adapter. Storage must not overlap source state or read buffers.
## Construct with `over`; serialize access and do not use copied adapters together.
## Reads may prefetch beyond the requested bytes. The adapter never closes its source.
pub struct BufferedReader: Reader:
    var source: Reader
    var storage: u8[]
    var position: usize
    var used: usize

    pub static func over(source: Reader, storage: u8[]) -> BufferedReader!:
        if storage.length == 0:
            error(invalid_buffer, "buffered input requires nonempty storage")
        return BufferedReader(source = source, storage = storage, position = 0, used = 0)

    ## Unread bytes already fetched. No source operation occurs.
    pub func buffered() -> usize:
        return self.used - self.position

    ## Return buffered bytes first, otherwise perform one source read. Empty reads
    ## do not call the source. EOF is not cached, allowing a growing source to resume.
    pub mutating func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        if self.position == self.used:
            let count = try self.source.read(self.storage)
            if count > self.storage.length:
                error(invalid_count, "the reader returned more bytes than requested")
            self.position = 0
            self.used = count
        let available = self.buffered()
        let count = buffer.length if buffer.length < available else available
        memory.copy(buffer, self.storage[self.position..], count)
        self.position += count
        return count

## Buffered output over a borrowed sink and nonempty caller-owned storage. Both
## must outlive this adapter; storage must not overlap sink state or write input.
## Construct with `over`; serialize access and do not use copied adapters together.
## Explicitly flush before discarding the adapter. There is no implicit flush/close.
pub struct BufferedWriter: Writer:
    var destination: Writer
    var storage: u8[]
    var used: usize

    pub static func over(destination: Writer, storage: u8[]) -> BufferedWriter!:
        if storage.length == 0:
            error(invalid_buffer, "buffered output requires nonempty storage")
        return BufferedWriter(destination = destination, storage = storage, used = 0)

    ## Bytes accepted by this adapter but not yet confirmed by the destination.
    pub func buffered() -> usize:
        return self.used

    ## Drain this buffer, preserving the unconfirmed suffix if the sink fails.
    ## Retrying does not resend bytes confirmed by earlier successful sink writes.
    ## This neither flushes downstream buffers nor requests filesystem durability.
    pub mutating func flush() -> !:
        var written: usize = 0
        write_all(self.destination, self.storage[..<self.used], &written) catch failure:
            self.used -= written
            memory.move(self.storage, self.storage[written..], self.used)
            error(failure.code, failure.message)
        self.used = 0

    ## Accept up to the remaining capacity. A full buffer is drained before any
    ## new input is accepted; a failure accepts none of this call's input. Empty
    ## writes do not drain the buffer. Use write_all to accept an entire payload.
    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        if self.used == self.storage.length:
            try self.flush()
        let available = self.storage.length - self.used
        let count = data.length if data.length < available else available
        memory.copy(self.storage[self.used..], data, count)
        self.used += count
        return count

## A compile-time source position, the value of `luce.location`.
pub struct Location:
    pub var file: str
    pub var line: u32
    pub var function: str

pub let closed: ErrorCode = ErrorCode.package(3)

pub let failed: ErrorCode = ErrorCode.package(24)
pub let would_block: ErrorCode = ErrorCode.package(28)

## Borrowed standard output stream. Each nonempty write uses the existing libc
## stream and flushes only that stream, making completed output visible before a
## following print. The libc stream lock serializes each write with other libc
## users; concurrent direct descriptor writes may interleave. No stream is created
## or owned here. A write/flush failure can follow partial output.
pub struct File: Writer:
    var descriptor: i32

    func stream() -> void*!:
        if self.descriptor == 1:
            return c.stdout()
        if self.descriptor == 2:
            return c.stderr()
        error(closed, "the standard output stream is unavailable")

    ## Flush this C stream, without closing it or requesting filesystem durability.
    pub mutating func flush() -> !:
        let stream = try self.stream()
        if fflush(stream) != 0:
            error(closed, "the stream could not be flushed")

    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let stream = try self.stream()
        flockfile(stream)
        defer funlockfile(stream)
        let written = fwrite(data.data, 1, data.length, stream)
        let flushed = fflush(stream)
        if written != data.length or flushed != 0:
            error(closed, "the stream refused the bytes")
        return written

var out_file: File = File(descriptor = 1)
var err_file: File = File(descriptor = 2)

## Unbuffered input borrows descriptor zero. It retries interrupted calls, reports
## would-block separately, and never owns or closes the process's descriptor.
struct StandardInput: Reader:
    var descriptor: i32

    pub mutating func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        let requested = 1073741824 if buffer.length > 1073741824 else buffer.length
        while true:
            let count = c_read(self.descriptor, buffer.data, requested)
            if count >= 0:
                return (usize)count
            let number = c.errno()
            if number == c.interrupted:
                continue
            if number == (35 if platform.macos else 11):
                error(would_block, "standard input would block")
            if number == 9:
                error(closed, "standard input is closed")
            error(failed, "standard input could not be read")

var in_file: StandardInput = StandardInput(descriptor = 0)

## Borrowed unbuffered standard input. Reads may block; concurrent readers compete
## for bytes. Do not mix with buffered C stdin reads, which may have prefetched data.
pub func stdin() -> Reader:
    return &in_file

pub func stdout() -> Writer:
    return &out_file

pub func stderr() -> Writer:
    return &err_file

## Explicitly flush C stdout, including bytes written through C interop.
pub func flush_stdout() -> !:
    try out_file.flush()

## Explicitly flush C stderr, including bytes written through C interop.
pub func flush_stderr() -> !:
    try err_file.flush()

pub let full: ErrorCode = ErrorCode.package(4)

## The sink a formatted string offers a `Display` value (§14.4): it appends to the buffer
## the compiler is filling, and fails once that buffer is full, as `format` then does.
pub struct FormatSink: Writer:
    var buffer: core.FormatBuffer*

    pub mutating func write(data: const u8[]) -> usize!:
        if core.format_put(self.buffer, data.data, data.length) != 0:
            error(full, "the buffer is full")
        return data.length

## The process's directories (§16.6): `from io import path`, then `path.user()`. Each is
## a `str` view of environment storage the system owns, or fresh storage from the current
## allocator where one has to be built.
pub struct path:
    var unused: u8

    ## The user's home directory: `$HOME`.
    pub static func user() -> str!:
        let home = getenv("HOME") else error(io_path_failed, "no home directory")
        return (str)home

    pub static func home() -> str!:
        return try path.user()

    ## Where temporary files go: `$TMPDIR`, else `/tmp`.
    pub static func temp() -> str:
        let dir = getenv("TMPDIR") else return "/tmp"
        return (str)dir

    ## Where configuration lives: `$XDG_CONFIG_HOME`, else `$HOME/.config`.
    pub static func config() -> str!:
        if let set = getenv("XDG_CONFIG_HOME"):
            return (str)set
        let home = try path.user()
        let buffer = try alloc u8[home.length + 8]
        return try format(buffer, f"{home}/.config")

extern func getenv(name: c.str) -> c.str?
pub let io_path_failed: ErrorCode = ErrorCode.package(13)
