## Text operations over `str` views; what allocates says so and uses the current allocator,
## and says how the allocation is given back: `release` for a text made here, `free` for
## the borrowed-field arrays returned by split and split_by.

import c
import platform
import io
import memory

pub let invalid_separator: ErrorCode = ErrorCode.package(48)
pub let output_too_large: ErrorCode = ErrorCode.package(49)
pub let invalid_radix: ErrorCode = ErrorCode.package(50)
pub let invalid_number: ErrorCode = ErrorCode.package(51)
pub let number_out_of_range: ErrorCode = ErrorCode.package(52)
pub let conversion_failed: ErrorCode = ErrorCode.package(53)
