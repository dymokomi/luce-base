## Text operations over `str` views; what allocates says so and uses the current allocator,
## and says how the allocation is given back: `release` for a text made here, `free` for
## the array `split` answers.

import c
import io
import memory

pub func starts_with(text: str, prefix: str) -> bool:
    if prefix.length > text.length:
        return false
    return (str)text.bytes[..<prefix.length] == prefix

pub func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## The byte offset of the first `needle` in `text`.
pub func find(text: str, needle: str) -> usize?:
    if needle.length > text.length:
        return none
    var i: usize = 0
    while i + needle.length <= text.length:
        if (str)text.bytes[i..<i + needle.length] == needle:
            return i
        i += 1
    return none

## The byte offset of the last `byte` in `text`.
pub func last(text: str, byte: u8) -> usize?:
    var i = text.length
    while i > 0:
        i -= 1
        if text.bytes[i] == byte:
            return i
    return none

pub func contains(text: str, needle: str) -> bool:
    return find(text, needle) != none

func is_space(byte: u8) -> bool:
    return byte == ' ' or byte == '\\n' or byte == '\\t' or byte == '\\r'

## `text` without leading and trailing spaces, tabs, and line ends: a view.
pub func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    let b = text.bytes
    while start < end and is_space(b[start]):
        start += 1
    while end > start and is_space(b[end - 1]):
        end -= 1
    return (str)b[start..<end]

## `text` split at every `separator`, as views into it; the array is an allocation of the
## current allocator, given back with `free`.
pub func split(text: str, separator: u8) -> str[]!:
    var count: usize = 1
    for b in text.bytes:
        if b == separator:
            count += 1
    let parts = try alloc str[count]
    var n: usize = 0
    var start: usize = 0
    var i: usize = 0
    let b = text.bytes
    while i < b.length:
        if b[i] == separator:
            parts[n] = (str)b[start..<i]
            n += 1
            start = i + 1
        i += 1
    parts[n] = (str)b[start..]
    return parts

## The pieces joined with `separator` between them, NUL-terminated in the current
## allocator; `release` gives it back.
pub func join(pieces: const str[], separator: str) -> str!:
    var total: usize = 0
    var i: usize = 0
    while i < pieces.length:
        total = total +? pieces[i].length else error(memory.exhausted, "the joined text is too large")
        if i + 1 < pieces.length:
            total = total +? separator.length else error(memory.exhausted, "the joined text is too large")
        i += 1
    let out = try terminated_buffer(total)
    var n: usize = 0
    i = 0
    while i < pieces.length:
        memory.copy(out[n..], pieces[i].bytes, pieces[i].length)
        n += pieces[i].length
        if i + 1 < pieces.length:
            memory.copy(out[n..], separator.bytes, separator.length)
            n += separator.length
        i += 1
    out[n] = 0
    return (str)out[..<n]

## A copy of `text` in the current allocator, NUL-terminated so it may be a `c.str`;
## `release` gives it back.
pub func copy(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    memory.copy(out, text.bytes, text.length)
    out[text.length] = 0
    return (str)out[..<text.length]

## A decimal integer, with an optional sign; none when the text is not one.
pub func to_i64(text: str) -> i64?:
    let b = text.bytes
    if b.length == 0:
        return none
    var i: usize = 0
    var negative = false
    if b[0] == '-' or b[0] == '+':
        negative = b[0] == '-'
        i = 1
    if i >= b.length:
        return none
    # the value accumulates on the side of its sign, so the negative endpoint fits
    var value: i64 = 0
    while i < b.length:
        let byte = b[i]
        if byte < '0' or byte > '9':
            return none
        let digit = (i64)(byte - '0')
        let scaled = value *? 10 else return none
        value = (scaled -? digit if negative else scaled +? digit) else return none
        i += 1
    return value

## ASCII case folding; other bytes pass through. NUL-terminated in the current
## allocator; `release` gives the text back.
pub func to_upper(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b - 32 if b >= 'a' and b <= 'z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

pub func to_lower(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b + 32 if b >= 'A' and b <= 'Z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

## Give back a text `join`, `copy`, `to_upper`, or `to_lower` answered: the allocation is
## one byte longer than the text, its NUL.
pub func release(text: str):
    free(u8[]((u8*)text.bytes.data, text.length + 1))

## Allocate text storage including its terminator, reporting size overflow as the
## same fallible outcome as an allocation refusal. Callers initialize every byte.
func terminated_buffer(length: usize) -> u8[]!:
    let size = length +? 1 else error(memory.exhausted, "the text is too large")
    return try alloc u8[size]

## Text built piece by piece. The builder keeps the allocator that was current when it
## was created and grows in it, so it may cross `with` blocks and outlive them; `destroy`
## gives its bytes back to that allocator.
pub struct Builder: io.Writer:
    var data: u8[]
    var used: usize
    var owner: memory.Allocator

    pub static func create(capacity: usize) -> Builder!:
        return Builder(data = try alloc u8[capacity if capacity > 0 else 64], used = 0, owner = memory.allocator)

    ## Ensure room for this many additional bytes and the NUL terminator. Growth
    ## uses the original allocator and preserves the old text if allocation fails.
    ## Growth invalidates borrowed views; a destroyed builder reports io.closed.
    pub mutating func reserve(additional: usize) -> !:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        let total = self.used +? additional else error(memory.exhausted, "the builder size overflows")
        let required = total +? 1 else error(memory.exhausted, "the builder size overflows")
        if required <= self.data.length:
            return
        var capacity = self.data.length *? 2 else required
        if capacity < required:
            capacity = required
        with self.owner:
            self.data = try memory.grow(self.data, capacity)

    ## Append bytes, including a view into this builder's current text. Preserve a
    ## self-view's offset before growth, then rebase it if the allocation moves.
    ## Aliased input must be wholly inside the initialized text, not spare capacity.
    pub mutating func write(data: const u8[]) -> usize!:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        if data.length == 0:
            return 0
        let start = (usize)self.data.data
        let source = (usize)data.data
        var offset: usize? = none
        if source >= start and source - start < self.data.length:
            let relative = source - start
            if relative > self.used or data.length > self.used - relative:
                error(io.invalid_buffer, "the builder input is outside its initialized text")
            offset = relative
        try self.reserve(data.length)
        if let relative = offset:
            memory.move(self.data[self.used..], self.data[relative..], data.length)
        else:
            memory.move(self.data[self.used..], data, data.length)
        self.used += data.length
        return data.length

    pub mutating func put(text: str) -> !:
        discard(try self.write(text.bytes))

    ## The text so far, NUL-terminated in the buffer: a borrowed view, invalid after
    ## write, clear, growing reserve, or destroy. A destroyed builder has an empty view.
    pub mutating func view() -> str:
        if self.used < self.data.length:
            self.data[self.used] = 0
        return (str)self.data[..<self.used]

    pub mutating func clear():
        self.used = 0

    ## Shorten to a byte length without allocation. Reject lengths past the
    ## initialized text, preserving it on failure. This does not validate a UTF-8
    ## boundary. Previously borrowed views expire; a destroyed builder is closed.
    pub mutating func truncate(length: usize) -> !:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        if length > self.used:
            error(io.invalid_buffer, "truncation cannot extend the builder")
        self.used = length
        self.data[length] = 0

    ## Give the bytes back; the builder is empty and holds nothing.
    pub mutating func destroy():
        if self.data.length > 0:
            free(self.data) in self.owner
        var empty: u8[]
        self.data = empty
        self.used = 0
