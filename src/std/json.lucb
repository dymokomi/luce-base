## Structured JSON values own their UTF-8 encoding. Containers snapshot inserted
## values: later changes to a child do not mutate its parent or create ARC cycles.
## No API accepts unchecked JSON fragments. All growth is bounded and transactional.
import memory
import interop
import strings
import utf8
import math

pub let invalid: ErrorCode = ErrorCode.package(110)
pub let limit_exceeded: ErrorCode = ErrorCode.package(111)

struct Bytes:
    var storage: u8[]
    var used: usize

    mutating func reserve(count: usize, maximum: usize) -> !:
        if count > maximum:
            error(limit_exceeded, "JSON exceeds its configured byte limit")
        if count <= self.storage.length:
            return
        var capacity: usize = 64 if self.storage.length == 0 else self.storage.length
        while capacity < count:
            capacity = maximum if capacity > maximum // 2 else capacity * 2
        if capacity > maximum:
            capacity = maximum
        let data = try alloc u8[capacity] in memory.heap
        memory.copy(data, self.storage, self.used)
        if self.storage.length > 0:
            free(self.storage) in memory.heap
        self.storage = data

    mutating func append(data: const u8[], maximum: usize) -> !:
        let needed = self.used +? data.length else error(limit_exceeded, "JSON size overflow")
        try self.reserve(needed, maximum)
        memory.copy(self.storage[self.used..], data, data.length)
        self.used = needed

    func view() -> const u8[]:
        return self.storage[..<self.used]

    mutating func close():
        if self.storage.length > 0:
            free(self.storage) in memory.heap
        var empty: u8[]
        self.storage = empty
        self.used = 0

func quoted(value: str, output: Bytes*, maximum: usize) -> !:
    var decoder: utf8.Decoder
    for byte in value.bytes:
        discard(try decoder.push(byte))
    try decoder.finish()
    try output.append(b"\"", maximum)
    for byte in value.bytes:
        if byte == '"' or byte == '\\':
            let pair: u8[2] = ['\\', byte]
            try output.append(pair, maximum)
        elif byte < 32:
            let digits = "0123456789abcdef".bytes
            let escaped: u8[6] = ['\\', 'u', '0', '0', digits[(usize)(byte >> 4)], digits[(usize)(byte & 15)]]
            try output.append(escaped, maximum)
        else:
            let single: u8[1] = [byte]
            try output.append(single, maximum)
    try output.append(b"\"", maximum)

## Value() creates an object. Arrays and scalar values use the named constructors.
## Base copies borrow; an exported Value has normal shared interop ownership.
pub struct Value:
    var encoded: Bytes
    var keys: Bytes
    var container: u8 = '{'
    var count: usize
    var maximum: usize = 1048576

    pub func init(maximum_bytes: usize = 1048576) -> !:
        if maximum_bytes < 2 or maximum_bytes > 67108864:
            error(invalid, "JSON byte limit must be between 2 and 64 MiB")
        self.encoded = Bytes()
        self.keys = Bytes()
        self.container = '{'
        self.count = 0
        self.maximum = maximum_bytes
        try self.encoded.append(b"{}", self.maximum)

    static func own(native: Value*) -> interop.Reference[Value]!:
        return try interop.Reference[Value].adopt(native, value_type)

    pub static func array(maximum_bytes: usize = 1048576) -> interop.Reference[Value]!:
        let native = try new Value(maximum_bytes)
        native.container = '['
        native.encoded.storage[0] = '['
        native.encoded.storage[1] = ']'
        return try Value.own(native)

    static func scalar(data: str) -> interop.Reference[Value]!:
        let native = try new Value()
        native.encoded.used = 0
        native.container = 0
        native.encoded.append(data.bytes, native.maximum) catch failure:
            native.close()
            free(native)
            error(failure.code, failure.message)
        return try Value.own(native)

    pub static func text(value: str) -> interop.Reference[Value]!:
        var bytes: Bytes
        defer bytes.close()
        try quoted(value, &bytes, 1048576)
        return try Value.scalar((str)bytes.view())

    pub static func integer(value: i64) -> interop.Reference[Value]!:
        var buffer: u8[32]
        return try Value.scalar(try format(buffer, f"{value}"))

    pub static func number(value: f64) -> interop.Reference[Value]!:
        if not math.is_finite(value):
            error(invalid, "JSON numbers must be finite")
        var buffer: u8[64]
        return try Value.scalar(try strings.format_f64(value, buffer))

    pub static func boolean(value: bool) -> interop.Reference[Value]!:
        return try Value.scalar("true" if value else "false")

    pub static func null() -> interop.Reference[Value]!:
        return try Value.scalar("null")

    ## Borrowed until the next mutation or close; Luce copies the result.
    pub func encode() -> str:
        return (str)self.encoded.view()

    mutating func insert(name: str?, value: const Value*) -> !:
        if self.container == 0 or ((self.container == '{') != (name != none)):
            error(invalid, "JSON operation does not match the container type")
        var key: Bytes
        defer key.close()
        if let key_name = name:
            try quoted(key_name, &key, self.maximum)
            var start: usize = 0
            for index in 0..<self.keys.used:
                if self.keys.storage[index] == '\n':
                    if (str)self.keys.storage[start..<index] == (str)key.view():
                        error(invalid, "JSON object already contains this key")
                    start = index + 1
        var fragment: Bytes
        defer fragment.close()
        if self.count > 0:
            try fragment.append(b",", self.maximum)
        if name != none:
            try fragment.append(key.view(), self.maximum)
            try fragment.append(b":", self.maximum)
        try fragment.append(value.encoded.view(), self.maximum)
        let size = self.encoded.used +? fragment.used else error(limit_exceeded, "JSON size overflow")
        let key_end = self.keys.used +? key.used else error(limit_exceeded, "JSON key size overflow")
        let key_size = key_end +? 1 else error(limit_exceeded, "JSON key size overflow")
        # Reserve both before changing either logical value. The fragment also
        # permits inserting a snapshot of this container into itself safely.
        try self.encoded.reserve(size, self.maximum)
        if name != none:
            try self.keys.reserve(key_size, self.maximum)
        let end = self.encoded.used - 1
        memory.copy(self.encoded.storage[end..], fragment.view(), fragment.used)
        self.encoded.used = size
        self.encoded.storage[size - 1] = '}' if self.container == '{' else ']'
        if name != none:
            memory.copy(self.keys.storage[self.keys.used..], key.view(), key.used)
            self.keys.used += key.used
            self.keys.storage[self.keys.used] = '\n'
            self.keys.used += 1
        self.count += 1

    pub mutating func set(name: str, value: interop.Reference[Value]) -> !:
        try self.insert(name, try value.get())

    pub mutating func append(value: interop.Reference[Value]) -> !:
        try self.insert(none, try value.get())

    pub mutating func set_text(name: str, value: str) -> !:
        let child = try Value.text(value)
        defer child.release()
        try self.set(name, child)

    pub mutating func set_integer(name: str, value: i64) -> !:
        let child = try Value.integer(value)
        defer child.release()
        try self.set(name, child)

    pub mutating func set_number(name: str, value: f64) -> !:
        let child = try Value.number(value)
        defer child.release()
        try self.set(name, child)

    pub mutating func set_boolean(name: str, value: bool) -> !:
        let child = try Value.boolean(value)
        defer child.release()
        try self.set(name, child)

    pub mutating func close():
        self.encoded.close()
        self.keys.close()

pub let value_type: interop.Type[Value] = interop.Type[Value]("JSON value", Value.close, closeable = true)
