## Blocking socket I/O. Created and accepted sockets are close-on-exec. Linux
## sets that flag atomically; macOS requires a separate call, so applications
## must serialize socket creation/acceptance with concurrent fork/exec there.
## Adopting a caller-created descriptor also needs this coordination on either OS.
import c
import platform
import memory
import io
from io import Reader, Writer

extern func socket(domain: i32, kind: i32, protocol: i32) -> i32
extern func bind(descriptor: i32, address: const void*, length: u32) -> i32
extern func listen(descriptor: i32, backlog: i32) -> i32
extern func accept(descriptor: i32, address: void*?, length: u32*?) -> i32
extern func accept4(descriptor: i32, address: void*?, length: u32*?, flags: i32) -> i32
extern func fcntl(descriptor: i32, command: i32, ...) -> i32
extern func connect(descriptor: i32, address: const void*, length: u32) -> i32
extern func send(descriptor: i32, data: const void*, length: usize, flags: i32) -> isize
extern func recv(descriptor: i32, buffer: void*, length: usize, flags: i32) -> isize
extern func sendto(descriptor: i32, data: const void*, length: usize, flags: i32, address: const void*, address_length: u32) -> isize
extern func receive_message_macos as "recvmsg"(descriptor: i32, message: MacMessage*, flags: i32) -> isize
extern func receive_message_linux as "recvmsg"(descriptor: i32, message: LinuxMessage*, flags: i32) -> isize
extern func close(descriptor: i32) -> i32
extern func setsockopt(descriptor: i32, level: i32, option: i32, value: const void*, length: u32) -> i32
extern func getsockname(descriptor: i32, address: void*, length: u32*) -> i32
extern func getpeername(descriptor: i32, address: void*, length: u32*) -> i32
extern func shutdown(descriptor: i32, direction: i32) -> i32
extern func getaddrinfo(host: c.str, service: c.str?, hints: const AddressInfo*?, result: AddressInfo*?*) -> i32
extern func freeaddrinfo(info: AddressInfo*)

## `sockaddr_in`: 16 bytes everywhere; macOS splits the first two into a length and a
## one-byte family, Linux keeps a two-byte family. `family_word` reads and writes it.
extern struct NativeIpv4Address:
    head: u16
    port: u16
    address: u32
    zero: u8[8]

## sockaddr_in6 is 28 bytes on both native hosts. Flow information is left zero;
## the scope index is a host-order u32, while the port is network-order u16.
extern struct NativeIpv6Address:
    head: u16
    port: u16
    flow: u32
    address: u8[16]
    scope: u32

## Enough aligned storage for either supported IP sockaddr representation.
extern union NativeAddress:
    ipv4: NativeIpv4Address
    ipv6: NativeIpv6Address

extern struct ReceiveVector:
    data: u8*?
    length: usize

## Host msghdr layouts: macOS uses int for the vector count and socklen_t for
## control length; glibc uses size_t for both. Their flags offsets differ.
extern struct MacMessage:
    address: void*
    address_length: u32
    vectors: ReceiveVector*
    vector_count: i32
    control: void*?
    control_length: u32
    flags: i32

extern struct LinuxMessage:
    address: void*
    address_length: u32
    vectors: ReceiveVector*
    vector_count: usize
    control: void*?
    control_length: usize
    flags: i32

## The first two bytes of `sockaddr_in` as one little-endian word: on macOS the length
## byte (16) comes first and the family byte second, on Linux the family fills both.
func family_word(family: i32, length: u8) -> u16:
    if platform.macos:
        return (u16)length | ((u16)family << 8)
    return (u16)family

## `addrinfo`: macOS puts the canonical name before the address, Linux after it.
extern struct AddressInfo:
    flags: i32
    family: i32
    kind: i32
    protocol: i32
    address_length: u32
    fifth: void*?
    sixth: void*?
    next: AddressInfo*?

func info_address(info: AddressInfo*) -> void*?:
    return info.sixth if platform.macos else info.fifth

let inet: i32 = 2
let inet6: i32 = 30 if platform.macos else 10
let stream: i32 = 1
let datagram: i32 = 2
let socket_close_on_exec: i32 = 524288
let get_descriptor_flags: i32 = 1
let set_descriptor_flags: i32 = 2
let descriptor_close_on_exec: i32 = 1
## `SOL_SOCKET` and `SO_REUSEADDR`: 65535 and 4 on macOS, 1 and 2 on Linux.
let socket_level: i32 = 65535 if platform.macos else 1
let reuse_address_option: i32 = 4 if platform.macos else 2
## A write to a socket the peer closed answers an error, never the process's death:
## macOS marks the socket (`SO_NOSIGPIPE`, 4130), Linux marks the send (`MSG_NOSIGNAL`,
## 16384).
let ipv6_level: i32 = 41
let ipv6_only_option: i32 = 27 if platform.macos else 26
let no_sigpipe_option: i32 = 4130
let send_flags: i32 = 0 if platform.macos else 16384

pub let failed: ErrorCode = ErrorCode.package(9)
pub let closed: ErrorCode = ErrorCode.package(10)
pub let unknown_host: ErrorCode = ErrorCode.package(11)
pub let invalid_options: ErrorCode = ErrorCode.package(35)
pub let message_too_large: ErrorCode = ErrorCode.package(36)
