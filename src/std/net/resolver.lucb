## The first usable IPv4 or IPv6 stream endpoint in host resolver order. An
## explicit version restricts results. Resolution can block in the OS. Every
## resolver node is released, including on malformed or unusable results.
pub func resolve(host: c.str, port: u16, version: IpVersion? = none) -> SocketAddress!:
    var family: i32 = 0
    if let requested = version:
        if requested != IpVersion.ipv4 and requested != IpVersion.ipv6:
            error(invalid_options, "unknown resolver IP version")
        family = inet if requested == IpVersion.ipv4 else inet6
    var hints = AddressInfo(family = family, kind = stream)
    var found: AddressInfo*? = none
    if getaddrinfo(host, none, &hints, &found) != 0:
        error(unknown_host, "unknown host")
    let info = found else error(unknown_host, "unknown host")
    defer freeaddrinfo(info)
    var current: AddressInfo*? = info
    while let entry = current:
        let known = entry.family == inet or entry.family == inet6
        if known and entry.kind == stream and (family == 0 or entry.family == family):
            if let raw = info_address(entry):
                var usable = true
                var address = decode_address(raw, entry.address_length) catch failure:
                    discard(failure)
                    usable = false
                    recover SocketAddress()
                if usable:
                    let matches = (entry.family == inet and address.ip.kind == IpVersion.ipv4) or (entry.family == inet6 and address.ip.kind == IpVersion.ipv6)
                    if matches:
                        address.port = port
                        return address
        current = entry.next
    error(unknown_host, "the host has no usable stream address for the requested IP version")
