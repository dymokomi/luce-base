## Host option numbers stay private; public methods expose typed policies.
let nonblocking_flag: i32 = 4 if platform.macos else 2048
let receive_buffer_option: i32 = 4098 if platform.macos else 8
let send_buffer_option: i32 = 4097 if platform.macos else 7
let keepalive_option: i32 = 8 if platform.macos else 9

func socket_status_flags(descriptor: i32) -> i32!:
    var flags = fcntl(descriptor, 3)
    while flags < 0 and c.errno() == c.interrupted:
        flags = fcntl(descriptor, 3)
    if flags < 0:
        error(socket_error(c.errno()), "socket status flags could not be queried")
    return flags

func set_nonblocking(descriptor: i32, enabled: bool) -> !:
    let before = try socket_status_flags(descriptor)
    let after = before | nonblocking_flag if enabled else before & ~nonblocking_flag
    if after == before:
        return
    var result = fcntl(descriptor, 4, after)
    while result < 0 and c.errno() == c.interrupted:
        result = fcntl(descriptor, 4, after)
    if result < 0:
        error(socket_error(c.errno()), "socket nonblocking mode could not be changed")

func get_socket_integer(descriptor: i32, level: i32, option: i32) -> i32!:
    var value: i32 = 0
    var length: u32 = 4
    var result = getsockopt(descriptor, level, option, &value, &length)
    while result < 0 and c.errno() == c.interrupted:
        length = 4
        result = getsockopt(descriptor, level, option, &value, &length)
    if result != 0:
        error(socket_error(c.errno()), "the socket option could not be queried")
    if length != 4:
        error(failed, "the socket option has an invalid result layout")
    return value

func set_socket_buffer(descriptor: i32, option: i32, bytes: i32) -> !:
    if bytes <= 0:
        error(invalid_options, "a socket buffer size must be positive")
    try set_socket_integer(descriptor, socket_level, option, bytes)
