## Bound individual transfers below both supported hosts' signed syscall limits.
let transfer_limit: usize = 1073741824

func transfer_error(number: i32) -> ErrorCode:
    if number == (35 if platform.macos else 11):
        return io.would_block
    if number == 9 or number == 32 or number == (54 if platform.macos else 104) or number == (57 if platform.macos else 107):
        return closed
    return failed

## Shared ownership state for all socket kinds. Consume before close because an
## interrupted or failed close may already have released the descriptor for reuse.
struct SocketHandle:
    var value: i32?

    ## Linux sets close-on-exec atomically with creation. macOS requires a
    ## separate fcntl call; callers must serialize concurrent fork/exec there.
    static func create(kind: i32, version: IpVersion) -> SocketHandle!:
        let flags: i32 = 0 if platform.macos else socket_close_on_exec
        let family = inet if version == IpVersion.ipv4 else inet6
        let descriptor = socket(family, kind | flags, 0)
        if descriptor < 0:
            error(failed, "a socket could not be created")
        if platform.macos:
            return try SocketHandle.adopt(descriptor)
        return SocketHandle(value = descriptor)

    ## Ownership transfers on entry, including failure. Preserve existing
    ## descriptor flags and close once if setting close-on-exec fails.
    static func adopt(descriptor: i32) -> SocketHandle!:
        if descriptor < 0:
            error(closed, "the socket descriptor is invalid")
        var flags = fcntl(descriptor, get_descriptor_flags)
        while flags < 0 and c.errno() == c.interrupted:
            flags = fcntl(descriptor, get_descriptor_flags)
        if flags < 0:
            discard(close(descriptor))
            error(failed, "socket descriptor flags could not be queried")
        if (flags & descriptor_close_on_exec) == 0:
            var result = fcntl(descriptor, set_descriptor_flags, flags | descriptor_close_on_exec)
            while result < 0 and c.errno() == c.interrupted:
                result = fcntl(descriptor, set_descriptor_flags, flags | descriptor_close_on_exec)
            if result < 0:
                discard(close(descriptor))
                error(failed, "the socket could not be marked close-on-exec")
        return SocketHandle(value = descriptor)

    func require() -> i32!:
        let descriptor = self.value else error(closed, "the socket is closed")
        return descriptor

    mutating func close() -> !:
        let descriptor = self.value else return
        self.value = none
        if close(descriptor) != 0:
            error(failed, "the socket could not be closed")

    mutating func destroy():
        self.close() catch failure:
            discard(failure)

func socket_address(descriptor: i32, peer: bool = false) -> SocketAddress!:
    var raw: NativeAddress
    var length: u32 = 28
    var result = query_address(descriptor, &raw, &length, peer)
    while result < 0 and c.errno() == c.interrupted:
        length = 28
        result = query_address(descriptor, &raw, &length, peer)
    if result != 0:
        error(failed, "the socket address could not be queried")
    if length > 28:
        error(failed, "the socket address exceeds the supported IP storage")
    return try decode_address(&raw, length)

func query_address(descriptor: i32, address: void*, length: u32*, peer: bool) -> i32:
    if peer:
        return getpeername(descriptor, address, length)
    return getsockname(descriptor, address, length)

func set_socket_integer(descriptor: i32, level: i32, option: i32, value: i32) -> !:
    var result = setsockopt(descriptor, level, option, &value, 4)
    while result < 0 and c.errno() == c.interrupted:
        result = setsockopt(descriptor, level, option, &value, 4)
    if result != 0:
        error(failed, "the socket option could not be set")
