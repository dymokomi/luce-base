## The only dispatch boundary between portable ownership/policy and graphics
## implementations. Native payloads are opaque here; Metal types live in metal/.
## A Vulkan backend can own its instance/device/queues in its device payload and
## its VkSurfaceKHR/swapchain/synchronization in its surface payload. It must
## satisfy the same sRGB, lease, resize, completion, and skipped-frame contracts.
func select_backend(requested: Backend) -> Backend!:
    if platform.macos and platform.arm64:
        if requested == Backend.automatic or requested == Backend.metal:
            return Backend.metal
    error(unsupported, "the requested GPU backend is not implemented")

func backend_device_open(backend: Backend) -> void*!:
    if platform.macos and platform.arm64:
        if backend == Backend.metal:
            return (void*)try metal_device_open()
    error(unsupported, "the GPU backend is not implemented")

func backend_device_destroy(backend: Backend, native: void*):
    if platform.macos and platform.arm64:
        if backend == Backend.metal:
            metal_device_destroy((MetalDevice*)native)
            return
    trap("invalid GPU backend during device destruction")

func backend_surface_open(device: DeviceState*, host: window.Presentation) -> void*!:
    if platform.macos and platform.arm64:
        if device.backend == Backend.metal:
            return (void*)try metal_surface_open((MetalDevice*)device.native, host)
    error(unsupported, "the GPU backend is not implemented")

func backend_clear_present(device: DeviceState*, host: window.Presentation, native: void*, color: Color) -> PresentResult!:
    if platform.macos and platform.arm64:
        if device.backend == Backend.metal:
            return try metal_clear_present((MetalDevice*)device.native, host, (MetalSurface*)native, color)
    error(unsupported, "the GPU backend is not implemented")

func backend_surface_wait(device: DeviceState*, native: void*) -> !:
    if platform.macos and platform.arm64:
        if device.backend == Backend.metal:
            try metal_surface_wait((MetalSurface*)native)
            return
    error(unsupported, "the GPU backend is not implemented")

func backend_surface_destroy(device: DeviceState*, host: window.Presentation, native: void*):
    if platform.macos and platform.arm64:
        if device.backend == Backend.metal:
            metal_surface_destroy((MetalSurface*)native, host)
            return
    trap("invalid GPU backend during surface destruction")
