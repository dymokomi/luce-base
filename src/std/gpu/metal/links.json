    {
      "symbols": [
        "MTLCreateSystemDefaultDevice"
      ],
      "frameworks": [
        "Metal"
      ],
      "libraries": [
        "objc"
      ]
    },
    {
      "symbols": [
        "CGColorSpaceCreateWithName",
        "kCGColorSpaceSRGB"
      ],
      "frameworks": [
        "CoreGraphics",
        "QuartzCore"
      ]
    }
  ]
}
