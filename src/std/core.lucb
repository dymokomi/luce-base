#==============================================================================================
#
#   core - The compiler's runtime support
#
#   DESCRIPTION:
#       The runtime the compiler emits calls to: startup and thread identity, the `format` and
#       f-string buffer, integer and boolean formatting, hashing, and the checked, saturating
#       and converting integer arithmetic.
#
#==============================================================================================

from windows_abi import WideCharToMultiByte
import c
import platform
extern func set_binary_mode as "_setmode"(descriptor: i32, mode: i32) -> i32
extern func GetCurrentThreadId() -> u32
var initial_thread: u32

## Whether the caller is the process's initial thread.
pub func on_initial_thread() -> bool:
    if platform.windows:
        return initial_thread != 0 and GetCurrentThreadId() == initial_thread
    return false

## Standard streams carry language bytes, including LF, without CRT text translation.
pub func process_start():
    if platform.windows:
        initial_thread = GetCurrentThreadId()
        discard(set_binary_mode(0, 32768))
        discard(set_binary_mode(1, 32768))
        discard(set_binary_mode(2, 32768))

extern func posix_write as "write"(descriptor: i32, buffer: const void*, count: usize) -> isize
extern func windows_write as "_write"(descriptor: i32, buffer: const void*, count: u32) -> i32

func write(descriptor: i32, buffer: const void*, count: usize) -> isize:
    if platform.windows:
        return (isize)windows_write(descriptor, buffer, (u32)(count if count < 2147483647 else 2147483647))
    return posix_write(descriptor, buffer, count)

extern func c_exit as "exit"(code: i32) -> never
extern func malloc(size: usize) -> void*?
extern func memcpy(target: void*, source: const void*, count: usize) -> void*
extern func memcmp(a: const void*, b: const void*, count: usize) -> i32
extern func strlen(text: c.str) -> usize
extern func snprintf(buffer: void*, size: usize, format: c.str, ...) -> i32

## Stop the program with its reason on stderr (§8.7).
pub func trap(message: c.str) -> never:
    begin_crash_report()
    write_diagnostic("trap: ".bytes)
    write_diagnostic(((str)message).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## `trap: file:line:column: message`: a trap naming the statement it stopped at (§11.5).
pub func trap_at(position: c.str, message: c.str) -> never:
    diagnostic_location(position)
    write_diagnostic(((str)message).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Positioned diagnostic with NUL-terminated C strings. Base assertions use
## trap_detail_at so their message spans retain their explicit lengths.
pub func trap_two_at(position: c.str, message: c.str, detail: c.str) -> never:
    diagnostic_location(position)
    write_diagnostic(((str)message).bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(((str)detail).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Unpositioned diagnostic with NUL-terminated C strings.
pub func trap_two(message: c.str, detail: c.str) -> never:
    begin_crash_report()
    write_diagnostic("trap: ".bytes)
    write_diagnostic(((str)message).bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(((str)detail).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Fatal diagnostic for a Base string. Its explicit byte length permits slices,
## empty values and embedded NUL; no byte beyond the view is read.
pub func trap_text_at(position: c.str, message: str) -> never:
    diagnostic_location(position)
    write_diagnostic(message.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Assertion prefix plus a Base string detail, preserving the detail's length.
pub func trap_detail_at(position: c.str, message: c.str, detail: str) -> never:
    diagnostic_location(position)
    let prefix = (str)message
    write_diagnostic(prefix.bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(detail.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## A trap at a position given as Base text: how the value language's runtime stops.
pub func trap_located(position: str, message: str) -> never:
    begin_crash_report()
    write_diagnostic("trap: ".bytes)
    write_diagnostic(position.bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(message.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

func diagnostic_location(position: c.str):
    begin_crash_report()
    write_diagnostic("trap: ".bytes)
    let location = (str)position
    write_diagnostic(location.bytes)
    write_diagnostic(": ".bytes)

## Panic reporting cannot raise another language error. The diagnostic goes to
## stderr and, when crash reports are on, to the report as well.
func write_diagnostic(data: const u8[]):
    write_all(2, data)
    if crash_file >= 0:
        write_all(crash_file, data)

## Retry interruptions and short writes; stop on a terminal write failure or lack of progress.
func write_all(descriptor: i32, data: const u8[]):
    var written: usize = 0
    while written < data.length:
        let remaining = data.length - written
        let count = remaining if remaining < 1073741824 else 1073741824
        let result = write(descriptor, data[written..].data, count)
        if result < 0 and c.errno() == c.interrupted:
            continue
        if result <= 0:
            return
        written += (usize)result

# mark: Crash reports ==========================================================================

extern func posix_open as "open"(path: c.str, flags: i32, ...) -> i32
extern func windows_open as "_open"(path: c.str, flags: i32, ...) -> i32
extern func posix_close as "close"(descriptor: i32) -> i32
extern func windows_close as "_close"(descriptor: i32) -> i32
extern func backtrace(frames: void**, size: i32) -> i32
extern func backtrace_symbols_fd(frames: const void**, size: i32, descriptor: i32)
extern func c_quick_exit as "_exit"(code: i32) -> never

## Where a crash report goes, NUL-terminated, and what it starts with; empty when
## reports are off. `std.crash` fills them; a trap or fatal signal writes them.
var crash_path: u8[1024]
var crash_header: u8[1024]
var crash_header_length: usize = 0
var crash_file: i32 = -1

## Turn crash reports on: a trap from now on also writes `header` and the trap
## to the file at `path` (created then, replaced if present), with a native
## stack where the platform gives one. Paths or headers too long are cut.
pub func set_crash_report(path: str, header: str):
    let length = path.length if path.length < crash_path.length - 1 else crash_path.length - 1
    for index in 0..<length:
        crash_path[index] = path.bytes[index]
    crash_path[length] = 0
    let header_length = header.length if header.length < crash_header.length else crash_header.length
    for index in 0..<header_length:
        crash_header[index] = header.bytes[index]
    crash_header_length = header_length

## Whether crash reports are on.
pub func crash_reports_enabled() -> bool:
    return crash_path[0] != 0

## Open the report, if reports are on and it is not open yet, and write its header.
func begin_crash_report():
    if crash_file >= 0 or crash_path[0] == 0 or platform.wasm32:
        return
    let path = (c.str)&crash_path[0]
    if platform.windows:
        crash_file = windows_open(path, 1 | 256 | 512 | 32768, 420)
    elif platform.macos:
        crash_file = posix_open(path, 1 | 512 | 1024, 420)
    else:
        crash_file = posix_open(path, 1 | 64 | 512, 420)
    if crash_file >= 0:
        write_all(crash_file, crash_header[..<crash_header_length])

## Finish a trap: the stack into the report, close it, and exit.
func finish_trap() -> never:
    finish_crash_report()
    c_exit(1)

func finish_crash_report():
    if crash_file < 0:
        return
    write_all(crash_file, "\nstack:\n".bytes)
    # WASI has no backtrace.
    if platform.posix and not platform.wasm32:
        # Pointer-sized slots: the addresses backtrace fills in.
        var frames: usize[64]
        let depth = backtrace((void**)&frames[0], 64)
        if depth > 0:
            backtrace_symbols_fd((const void**)&frames[0], depth, crash_file)
    else:
        write_all(crash_file, "(not captured on this platform)\n".bytes)
    if platform.windows:
        discard(windows_close(crash_file))
    else:
        discard(posix_close(crash_file))
    crash_file = -1

## A fatal signal: report it as a trap would, then end with the signal's exit
## status. Only async-signal-safe calls are made from here on.
pub func report_fatal_signal(name: str, number: i32) -> never:
    begin_crash_report()
    write_diagnostic("trap: fatal signal ".bytes)
    write_diagnostic(name.bytes)
    write_diagnostic("\n".bytes)
    finish_crash_report()
    c_quick_exit(128 + number)

## The buffer `format` and f"..." fill: the bytes, their capacity, and the count used.
pub struct FormatBuffer:
    ## The buffer's bytes.
    pub var data: u8*
    ## The buffer's capacity in bytes.
    pub var capacity: usize
    ## The number of bytes used.
    pub var used: usize

## Append `count` bytes; 1 when they do not fit, and the buffer is then over capacity.
pub func format_put(b: FormatBuffer*, text: const void*?, count: usize) -> i32:
    if count > b.capacity or b.used > b.capacity - count:
        b.used = b.capacity +% 1
        return 1
    if let source = text:
        if count > 0:
            discard(memcpy(&b.data[b.used], source, count))
    b.used += count
    return 0

## Append the decimal `value` to `b`; the bytes written.
pub func format_u64(b: FormatBuffer*, value: u64) -> i32:
    var digits: u8[24] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[23] = 48
        n = 1
    while v != 0:
        n += 1
        digits[24 - n] = (u8)(48 + v % 10)
        v = v // 10
    return format_put(b, &digits[24 - n], n)

## Append the decimal `value` to `b`; the bytes written.
pub func format_i64(b: FormatBuffer*, value: i64) -> i32:
    if value < 0:
        let minus = "-"
        if format_put(b, minus.bytes.data, 1) != 0:
            return 1
        return format_u64(b, 0 -% (u64)value)
    return format_u64(b, (u64)value)

## `%g`, as the C library spells it, so both backends print one text.
pub func format_f64(b: FormatBuffer*, value: f64) -> i32:
    var text: u8[64] = ---
    let n = snprintf((void*)&text[0], 64, "%g", value)
    if n < 0:
        return 1
    return format_put(b, &text[0], (usize)n)

## Append `true` or `false` to `b`; the bytes written.
pub func format_bool(b: FormatBuffer*, value: bool) -> i32:
    let word = "true" if value else "false"
    return format_put(b, word.bytes.data, word.length)

## A `char` displays as itself, in UTF-8 (§14.4).
pub func format_char(b: FormatBuffer*, value: char) -> i32:
    let cp = u32(value)
    var out: u8[4]
    var n: usize = 0
    if cp < 0x80:
        out[0] = u8(cp)
        n = 1
    elif cp < 0x800:
        out[0] = u8(0xC0 | (cp >> 6))
        out[1] = u8(0x80 | (cp & 0x3F))
        n = 2
    elif cp < 0x10000:
        out[0] = u8(0xE0 | (cp >> 12))
        out[1] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[2] = u8(0x80 | (cp & 0x3F))
        n = 3
    else:
        out[0] = u8(0xF0 | (cp >> 18))
        out[1] = u8(0x80 | ((cp >> 12) & 0x3F))
        out[2] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[3] = u8(0x80 | (cp & 0x3F))
        n = 4
    return format_put(b, (const void*)&out, n)

## The text so far, NUL-terminated when there is room.
pub func format_finish(b: FormatBuffer*) -> str:
    if b.used < b.capacity:
        b.data[b.used] = 0
    if b.used > b.capacity:
        return ""
    return (str)u8[](b.data, b.used)

## `hex`, `bin`, and `pad` return text in one of four rotating thread-local slots of 255
## bytes each: the fifth call reuses the first's, and longer text is cut to 255 bytes.
local var show_bytes: u8[1024]
local var show_next: u32

func show_take(source: const u8*, count: usize) -> str:
    let slot = (usize)(show_next & 3) * 256
    show_next = show_next +% 1
    var n = count
    if n > 255:
        n = 255
    if n > 0:
        discard(memcpy(&show_bytes[slot], source, n))
    show_bytes[slot + n] = 0
    return (str)show_bytes[slot..<slot + n]

## `value` as a hexadecimal string.
pub func show_hex(value: u64) -> str:
    var digits: u8[16] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[15] = 48
        n = 1
    while v != 0:
        n += 1
        let d = (u8)(v & 15)
        digits[16 - n] = d + 48 if d < 10 else d + 87
        v = v >> 4
    return show_take(&digits[16 - n], n)

## `value` as a binary string.
pub func show_bin(value: u64) -> str:
    var digits: u8[64] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[63] = 48
        n = 1
    while v != 0:
        n += 1
        digits[64 - n] = 48 + (u8)(v & 1)
        v = v >> 1
    return show_take(&digits[64 - n], n)

## `inner` left-padded with spaces to `width`.
pub func show_pad(inner: str, width: usize) -> str:
    var n = inner.length
    if n >= width:
        return show_take(inner.bytes.data, n)
    var text: u8[256] = ---
    var pad = width - n
    if width > 255:
        if n > 255:
            n = 255
        pad = 255 - n
    for i in 0..<pad:
        text[i] = 32
    if n > 0:
        discard(memcpy(&text[pad], inner.bytes.data, n))
    return show_take(&text[0], pad + n)

## The startup shim's pieces: the argument vector as `str[]` (checked) or `c.str[]`.
pub func arguments(count: i32, vector: c.str*) -> str[]:
    let raw = raw_arguments(count, vector)
    let n = raw.length
    let block = malloc((n if n > 0 else 1) * sizeof(str)) else trap("memory.exhausted")
    let items = (str*)block
    var i: usize = 0
    while i < n:
        let text = (str)raw[i]
        if not utf8_ok(text.bytes.data, text.length):
            trap("invalid_utf8")
        items[i] = text
        i += 1
    return str[](items, n)

## The process's arguments as a span of C strings.
pub func raw_arguments(count: i32, vector: c.str*) -> c.str[]:
    if platform.windows:
        return windows_arguments()
    return c.str[](vector, (usize)count)

extern func GetCommandLineW() -> u16*
extern func CommandLineToArgvW(command: u16*, count: i32*) -> u16**?
extern func LocalFree(block: void*) -> void*?
extern func release_argument_block as "free"(block: void*)
extern func atexit(callback: func() -> unit) -> i32
var windows_argument_vector: c.str[]

func free_windows_arguments():
    for text in windows_argument_vector:
        release_argument_block((void*)text)
    release_argument_block((void*)windows_argument_vector.data)

## The wide command line preserves names the Windows ANSI code page cannot encode.
func windows_arguments() -> c.str[]:
    if platform.windows:
        if windows_argument_vector.length > 0:
            return windows_argument_vector
        var count: i32 = 0
        let wide = CommandLineToArgvW(GetCommandLineW(), &count) else trap("could not read the Windows command line")
        defer discard(LocalFree((void*)wide))
        let block = malloc((usize)count * sizeof(c.str)) else trap("memory.exhausted")
        let items = (c.str*)block
        for index in 0..<(usize)count:
            let size = WideCharToMultiByte(65001, 128, wide[index], -1, none, 0, none, none)
            if size <= 0: trap("the command line contains invalid UTF-16")
            let text = malloc((usize)size) else trap("memory.exhausted")
            if WideCharToMultiByte(65001, 128, wide[index], -1, (u8*)text, size, none, none) != size:
                trap("could not encode the command line as UTF-8")
            items[index] = (c.str)text
        windows_argument_vector = c.str[](items, (usize)count)
        if atexit(free_windows_arguments) != 0:
            trap("could not register command line cleanup")
        return windows_argument_vector
    return c.str[]((c.str*)0, 0)

## A failed `main`: its error on stderr, exit status 1.
pub func main_failed(code: i32, message: str) -> i32:
    var bytes: u8[1024] = ---
    let line = format(bytes, f"error {code}: {message}\n") catch:
        return 1
    discard(write(2, line.bytes.data, line.length))
    return 1

## The test runner's report line and its summary.
pub func test_report(name: str, failed: bool, message: str):
    var bytes: u8[1024] = ---
    let line = format(bytes, f"FAIL  {name}\n      error: {message}\n" if failed else f"ok    {name}\n") catch:
        return
    discard(write(1, line.bytes.data, line.length))

## Print a test run's tally; the process exit status.
pub func test_summary(total: i32, failed: i32) -> i32:
    var bytes: u8[64] = ---
    let line = format(bytes, f"{total - failed} passed\n") catch:
        return 1
    discard(write(1, line.bytes.data, line.length))
    return 0 if failed == 0 else 1

## `print`: the text and a newline on stdout; `answer()` programs print their number.
pub func print_str(text: str):
    discard(write(1, text.bytes.data, text.length))
    let newline = "\n"
    discard(write(1, newline.bytes.data, 1))

## Print `value` followed by a newline.
pub func print_i64(value: i64):
    var bytes: u8[32] = ---
    let all: u8[] = bytes
    var b = FormatBuffer(data = all.data, capacity = 32, used = 0)
    discard(format_i64(&b, value))
    discard(write(1, all.data, b.used))
    let newline = "\n"
    discard(write(1, newline.bytes.data, 1))

## Ordering of text: bytewise, then by length (§7.4).
pub func str_compare(a: str, b: str) -> i32:
    let n = a.length if a.length < b.length else b.length
    var order: i32 = 0
    if n > 0:
        order = memcmp(a.bytes.data, b.bytes.data, n)
    if order != 0:
        return -1 if order < 0 else 1
    if a.length < b.length:
        return -1
    return 1 if a.length > b.length else 0

## The scalar starting at byte `index` of `count` bytes of valid UTF-8, its width left in
## `width`: what `for character in text` steps by (§5.5).
pub func utf8_scalar(text: const u8*, count: usize, index: usize, width: usize*) -> char:
    let byte = text[index]
    var w: usize = 1
    var cp: u32 = (u32)byte
    if byte >= 240:
        w = 4
        cp = (u32)(byte & 7)
    elif byte >= 224:
        w = 3
        cp = (u32)(byte & 15)
    elif byte >= 192:
        w = 2
        cp = (u32)(byte & 31)
    if index + w > count:
        w = count - index
    var k: usize = 1
    while k < w:
        cp = (cp << 6) | (u32)(text[index + k] & 63)
        k += 1
    *width = w
    return char(cp)

## Whether `count` bytes are well-formed UTF-8: no overlong forms, no surrogates, nothing past U+10FFFF.
pub func utf8_ok(text: const u8*?, count: usize) -> bool:
    let s = text else return count == 0
    var i: usize = 0
    while i < count:
        let byte = s[i]
        var w: usize = 1
        var cp: u32 = 0
        if byte < 128:
            cp = (u32)byte
        elif (byte & 224) == 192:
            w = 2
            cp = (u32)(byte & 31)
        elif (byte & 240) == 224:
            w = 3
            cp = (u32)(byte & 15)
        elif (byte & 248) == 240:
            w = 4
            cp = (u32)(byte & 7)
        else:
            return false
        if i + w > count:
            return false
        var k: usize = 1
        while k < w:
            let x = s[i + k]
            if (x & 192) != 128:
                return false
            cp = (cp << 6) | (u32)(x & 63)
            k += 1
        if w == 2 and cp < 128:
            return false
        if w == 3 and cp < 2048:
            return false
        if w == 4 and cp < 65536:
            return false
        if cp >= 55296 and cp <= 57343:
            return false
        if cp > 1114111:
            return false
        i += w
    return true

## `hash`: a per-process seed and a multiplicative mixer (§7.4).
var hash_seed_value: u64
var hash_seeded: bool

## A per-process seed for the collection hashers.
# mark: Hashing ===============================================================================

## The process's per-run hash seed, chosen once from the address space.
pub func hash_seed() -> u64:
    if not hash_seeded:
        hash_seed_value = 11400714819323198485 ^ (u64)(usize)&hash_seed_value
        hash_seeded = true
    return hash_seed_value

## Mix `x` into the running hash `h`.
pub func hash_mix(h: u64, x: u64) -> u64:
    var r = h ^ x
    r = r *% 11400714819323198485
    r = r ^ (r >> 32)
    return r

## Mix `count` bytes at `data` into the running hash `h`.
pub func hash_bytes(h: u64, data: const void*?, count: usize) -> u64:
    var r = h
    if let p = data:
        let bytes = (const u8*)p
        var i: usize = 0
        while i < count:
            r = hash_mix(r, (u64)bytes[i])
            i += 1
    return hash_mix(r, (u64)count)

## Integer conversions between widths: `bits` of `value` as a 64-bit word.
func mask_of(bits: i32) -> u64:
    if bits >= 64:
        return 18446744073709551615
    return (1 << (u64)bits) - 1

func sign_extend(value: i64, bits: i32) -> i64:
    if bits >= 64:
        return value
    let m = mask_of(bits)
    let x = (u64)value & m
    if (x & (1 << (u64)(bits - 1))) != 0:
        return (i64)(x | ~m)
    return (i64)x

func zero_extend(value: u64, bits: i32) -> u64:
    return value & mask_of(bits)

func signed_min(bits: i32) -> i64:
    if bits >= 64:
        return -9223372036854775807 - 1
    return 0 -% (1 << (i64)(bits - 1))

func signed_max(bits: i32) -> i64:
    if bits >= 64:
        return 9223372036854775807
    return (1 << (i64)(bits - 1)) - 1

func fits_signed(value: i64, bits: i32) -> bool:
    return value >= signed_min(bits) and value <= signed_max(bits)

func fits_unsigned(value: u64, bits: i32) -> bool:
    return value <= mask_of(bits)

## The source of an integer conversion as a sign and a magnitude, so a `u64` above
## `i64.max` stays itself.
struct Magnitude:
    var negative: bool
    var bits: u64

func magnitude(value: u64, from_bits: i32, from_signed: i32) -> Magnitude:
    if from_signed != 0:
        let v = sign_extend((i64)value, from_bits)
        return Magnitude(negative = v < 0, bits = (u64)v)
    return Magnitude(negative = false, bits = zero_extend(value, from_bits))

## A checked conversion's result as bits: outside the destination's range traps (§7.5),
## naming the statement at `at`.
func checked_bits(m: Magnitude, to_bits: i32, to_signed: i32, at: c.str) -> u64:
    var bad = false
    if to_signed != 0:
        bad = (i64)m.bits < signed_min(to_bits) if m.negative else m.bits > (u64)signed_max(to_bits)
    else:
        bad = m.negative or not fits_unsigned(m.bits, to_bits)
    if bad:
        trap_at(at, "integer conversion out of range")
    return m.bits

## `T(x)` between integers (`mode` 0, checked) and `(T)x` (`mode` 1, truncating).
pub func conv_s(value: i64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32, at: c.str) -> i64:
    let m = magnitude((u64)value, from_bits, from_signed)
    if mode == 0:
        return (i64)checked_bits(m, to_bits, to_signed, at)
    let bits = m.bits & mask_of(to_bits)
    if to_signed != 0:
        return sign_extend((i64)bits, to_bits)
    return (i64)bits

## Convert an unsigned value between integer widths and signedness; `mode` chooses checked or wrapping.
pub func conv_u(value: u64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32, at: c.str) -> u64:
    let m = magnitude(value, from_bits, from_signed)
    if mode == 0:
        return checked_bits(m, to_bits, to_signed, at)
    return zero_extend(m.bits, to_bits)

## A `char` from an integer's bits: a scalar value, or a trap when checked (`mode` 0).
pub func to_char(value: u64, mode: i32, at: c.str) -> u64:
    let bad = value > 1114111 or (value >= 55296 and value <= 57343)
    if bad and mode == 0:
        trap_at(at, "integer conversion out of range")
    return value & 4294967295

func is_finite(value: f64) -> bool:
    return value - value == 0.0

## `2^(bits-1)` and `2^bits` as floats: exact, where `(f64)signed_max(64)` rounds up to `2^63`.
func float_bound_s(bits: i32) -> f64:
    return (f64)((u64)1 << (u64)(bits - 1))

func float_bound_u(bits: i32) -> f64:
    return float_bound_s(bits) * 2.0

## Float to integer: checked (`mode` 0) or saturating (`mode` 1); the cast inside is the target's own.
pub func f_to_s(value: f64, bits: i32, mode: i32, at: c.str) -> i64:
    let high = float_bound_s(bits)
    let low = 0.0 - high
    if mode == 0:
        if not is_finite(value) or value < low or value >= high:
            trap_at(at, "integer conversion out of range")
        return (i64)value
    if value != value:
        return 0
    if value <= low:
        return signed_min(bits)
    if value >= high:
        return signed_max(bits)
    return (i64)value

## Convert a float to an unsigned integer of `bits`; `mode` checks the range.
pub func f_to_u(value: f64, bits: i32, mode: i32, at: c.str) -> u64:
    let high = float_bound_u(bits)
    if mode == 0:
        if not is_finite(value) or value < 0.0 or value >= high:
            trap_at(at, "integer conversion out of range")
        return (u64)value
    if value != value or value < 0.0:
        return 0
    if value >= high:
        return mask_of(bits)
    return (u64)value

## Saturating arithmetic (`+|`, `-|`, `*|`) on `bits`-wide operands in 64-bit words.
func add_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ r) & (b ^ r)) < 0

func sub_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ b) & (a ^ r)) < 0

func mul_overflows_s(a: i64, b: i64) -> bool:
    if a == 0 or b == 0:
        return false
    if a == -1:
        return b == signed_min(64)
    if b == -1:
        return a == signed_min(64)
    return (a *% b) // b != a

## Saturating signed addition at `bits`.
# mark: Saturating and checked arithmetic =====================================================

## Saturating signed addition of `x` and `y` at `bits` bits.
pub func adds_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

## Saturating unsigned addition at `bits`.
pub func adds_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return mask_of(bits)
    return r

## Saturating signed subtraction at `bits`.
pub func subs_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

## Saturating unsigned subtraction at `bits`.
pub func subs_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return 0
    return a - b

## Saturating signed multiplication at `bits`.
pub func muls_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return signed_min(bits) if (a < 0) != (b < 0) else signed_max(bits)
    return a *% b

## Saturating unsigned multiplication at `bits`.
pub func muls_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return mask_of(bits)
    return zero_extend(a *% b, bits)

## Checked-to-optional arithmetic (`+?`, `-?`, `*?`): the result through `out`, whether it fit.
pub func qadd_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

## Checked unsigned addition through `out`; whether it fit.
pub func qadd_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return false
    *out = r
    return true

## Checked signed subtraction through `out`; whether it fit.
pub func qsub_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

## Checked unsigned subtraction through `out`; whether it fit.
pub func qsub_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return false
    *out = a - b
    return true

## Checked signed multiplication through `out`; whether it fit.
pub func qmul_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return false
    *out = a *% b
    return true

## Checked unsigned multiplication through `out`; whether it fit.
pub func qmul_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return false
    *out = a *% b
    return true

## Terminate the process through the minimal runtime layer.
pub func exit(code: i32) -> never:
    c_exit(code)
