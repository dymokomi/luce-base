## Checked ownership declarations for the public package description. Recognition
## uses the standard module's declaration identity, never a user type's short name.
import front.ast
import sema.check
import sema.types

pub struct Declaration:
    pub let descriptor: ast.Node*
    pub let dispose: ast.Node*
    pub let closeable: bool

pub func standard(checker: check.Checker*, id: u32, name: str) -> bool:
    let native = checker.table.get(id)
    let declaration = native.decl else return false
    for module in checker.modules.span():
        if module.is_prelude and module.name == "interop":
            return check.find_decl(module.tree, name) == declaration
    return false

## A carrier names its concrete owner independently of aliases and import spelling.
pub func reference(checker: check.Checker*, id: u32) -> u32?:
    let native = checker.table.get(id)
    if native.args.length == 1 and standard(checker, id, "Reference"):
        return native.args[0]
    return none

func argument(call: ast.Node*, name: str) -> ast.Node*?:
    var cursor = call.body
    while let parameter = cursor:
        if parameter.text == name:
            return parameter.left
        cursor = parameter.next
    return none

## There is exactly one public ownership declaration beside the concrete type.
## Its checked function types already guarantee disposal/trace ABI correctness.
pub func owned(checker: check.Checker*, id: u32) -> Declaration?!:
    let native = checker.table.get(id)
    if native.kind != types.Kind.struct_ or native.args.length != 0:
        return none
    let type_decl = native.decl else return none
    for module in checker.modules.span():
        if check.find_decl(module.tree, type_decl.text) != type_decl:
            continue
        var found: Declaration? = none
        var cursor = module.tree.body
        while let declaration = cursor:
            cursor = declaration.next
            if declaration.kind != ast.Kind.constant or not declaration.has(ast.flag_pub):
                continue
            let carrier = checker.table.get(declaration.type_id)
            if carrier.args.length != 1 or carrier.args[0] != id or not standard(checker, declaration.type_id, "Type"):
                continue
            if found != none:
                error(check.type_error, "a native type must have exactly one public interop.Type declaration")
            if not type_decl.has(ast.flag_pub):
                error(check.type_error, "a public interop.Type must describe a public struct")
            let value = declaration.left else error(check.type_error, "an interop.Type needs its constant constructor")
            if value.kind != ast.Kind.call:
                error(check.type_error, "declare native ownership with a direct constant interop.Type constructor")
            let cleanup = argument(value, "dispose") else error(check.type_error, "name the interop.Type disposal argument explicitly")
            let dispose = cleanup.resolved else error(check.type_error, "interop.Type disposal must name a concrete method or function")
            var closeable = false
            if let option = argument(value, "closeable"):
                closeable = checker.constant_bool(option) else error(check.type_error, "interop.Type closeable must be constant")
            if closeable:
                if check.find_decl(type_decl, dispose.text) != dispose or not dispose.has(ast.flag_pub) or not dispose.has(ast.flag_mutating) or dispose.right != none:
                    error(check.type_error, "closeable ownership requires a public mutating disposal method without parameters")
            found = Declaration(descriptor = declaration, dispose = dispose, closeable = closeable)
        return found
    return none
