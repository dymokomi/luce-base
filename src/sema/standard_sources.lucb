let text_41: str = r"""#==============================================================================================
#
#   connection - An owning registration token
#
#   DESCRIPTION:
#       Dropping its last reference disconnects; explicit disconnection stays queryable and
#       releases its signal-state edge at once.
#
#==============================================================================================

## Owning registration token. Dropping its last reference disconnects; explicit
## disconnection remains queryable and releases its signal-state edge immediately.
pub struct Connection:
    var state: ownership.Object*?
    let identifier: u64
    let remove: func(ownership.Object*, u64) -> unit
    let contains: func(ownership.Object*, u64) -> bool

    func init(state: ownership.Object*, identifier: u64,
              remove: func(ownership.Object*, u64) -> unit,
              contains: func(ownership.Object*, u64) -> bool):
        self.state = state
        self.identifier = identifier
        self.remove = remove
        self.contains = contains
        _ = ownership.retain(state)

    ## Remove the registration; idempotent.
    pub func disconnect():
        let state = self.state else return
        self.state = none
        self.remove(state, self.identifier)
        ownership.release(state)

    ## Whether the registration is still present.
    pub func is_connected() -> bool:
        let state = self.state else return false
        ownership.check_alive(state)
        return self.contains(state, self.identifier)

    func destroy():
        self.disconnect()

    func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        if let state = self.state:
            ownership.check_thread(state)
            visit(state, context)

## The interop type describing a `Connection`.
pub let connection_type: Type[Connection] = Type[Connection](name = "Connection",
                                                             dispose = Connection.destroy, trace = Connection.trace)
"""

## The text of `src/std/interop/signal.lucb`.
let text_42: str = r"""#==============================================================================================
#
#   signal - A native multicast signal
#
#   DESCRIPTION:
#       A retained signal that fans an argument out to every connected callback; connecting
#       yields a `Connection` token whose last reference disconnects.
#
#==============================================================================================

struct Subscription[A]:
    let identifier: u64
    let callback: Callback[A, unit]
    var next: Subscription[A]*?

struct Delivery[A]:
    let identifier: u64
    let callback: Callback[A, unit]

struct SignalState[A]:
    var header: ownership.Object
    var information: ownership.Info
    var allocator: memory.Allocator
    var first: Subscription[A]*?
    var last: Subscription[A]*?
    var serial: u64
    var count: usize
    var closed: bool

    static func contains(object: ownership.Object*, identifier: u64) -> bool:
        let state = (SignalState[A]*)object
        var cursor = state.first
        while let entry = cursor:
            if entry.identifier == identifier:
                return true
            cursor = entry.next
        return false

    static func remove(object: ownership.Object*, identifier: u64):
        let state = (SignalState[A]*)object
        var previous: Subscription[A]*? = none
        var cursor = state.first
        while let entry = cursor:
            if entry.identifier == identifier:
                if let before = previous:
                    before.next = entry.next
                else:
                    state.first = entry.next
                if state.last == entry:
                    state.last = previous
                state.count -= 1
                # Detach before releasing: callback destruction can reenter us.
                entry.callback.release()
                free(entry) in state.allocator
                return
            previous = entry
            cursor = entry.next

    static func close(object: ownership.Object*):
        let state = (SignalState[A]*)object
        state.closed = true
        var cursor = state.first
        state.first = none
        state.last = none
        state.count = 0
        while let entry = cursor:
            cursor = entry.next
            entry.callback.release()
            free(entry) in state.allocator

    static func trace(object: ownership.Object*, visit: func(ownership.Object*, void*) -> unit, context: void*):
        var cursor = ((SignalState[A]*)object).first
        while let entry = cursor:
            entry.callback.trace(visit, context)
            cursor = entry.next

## Ordered, thread-bound delivery. Base copies borrow this carrier; clone/release
## manage ownership. Package owners close their signal before releasing it.
# mark: The signal carrier =====================================================================

## A typed, connectable signal: an owned carrier its aliases share by reference count.
pub struct Signal[A]:
    let state: SignalState[A]*

    ## A custom allocator must outlive the signal and its connection aliases.
    pub func init(allocator: memory.Allocator? = none) -> !:
        let selected = allocator else memory.heap
        var information = ownership.Info(name = "signal", size = memory.size_of(SignalState[A]),
                                         finish = none, drop = SignalState[A].close, trace = SignalState[A].trace)
        let state = (SignalState[A]*)try ownership.reserve(&information, memory.size_of(SignalState[A]), selected)
        state.information = information
        state.header.info = &state.information
        state.allocator = selected
        self.state = state

    ## Another strong reference to the same signal.
    pub func clone() -> Signal[A]:
        _ = ownership.retain(&self.state.header)
        return self

    ## Drop this signal's edge.
    pub func release():
        ownership.release(&self.state.header)

    ## Close the signal; further connects and emits fail.
    pub func close():
        ownership.check_alive(&self.state.header)
        SignalState[A].close(&self.state.header)

    ## Whether the signal has been closed.
    pub func is_closed() -> bool:
        ownership.check_alive(&self.state.header)
        return self.state.closed

    ## Visit the signal state as a strong reference.
    pub func trace(visit: func(ownership.Object*, void*) -> unit, context: void*):
        ownership.check_thread(&self.state.header)
        visit(&self.state.header, context)

    ## Register `callback`, returning a `Connection` token.
    pub func connect(callback: Callback[A, unit]) -> Reference[Connection]!:
        ownership.check_alive(&self.state.header)
        ownership.check_alive(callback.owner)
        if self.state.closed:
            error(invalid, "a signal is closed")
        let identifier = self.state.serial +? 1 else error(invalid, "signal registration identities exhausted")
        var reservation = try Reservation[Connection](connection_type)
        errdefer reservation.cancel()
        let token = reservation.publish(try new Connection(&self.state.header, identifier,
                                                           SignalState[A].remove, SignalState[A].contains) in self.state.allocator, self.state.allocator)
        errdefer token.release()
        let entry = try new Subscription[A](identifier, callback.clone(), none) in self.state.allocator
        self.state.serial = identifier
        self.state.count += 1
        if let last = self.state.last:
            last.next = entry
        else:
            self.state.first = entry
        self.state.last = entry
        return token

    ## Deliver `argument` to every connected callback.
    pub func emit(argument: A) -> Outcome[unit]:
        _ = ownership.retain(&self.state.header)
        defer ownership.release(&self.state.header)
        if self.state.closed:
            return Outcome[unit].failure(invalid, Owned[str]("a signal is closed"))
        if self.state.count == 0:
            return Outcome[unit].success(Owned[unit](()))
        let snapshot = new Delivery[A][self.state.count] --- in self.state.allocator catch failure:
            return failed_outcome[unit](failure.code, failure.message)
        defer free(snapshot) in self.state.allocator
        var cursor = self.state.first
        var count: usize = 0
        while let entry = cursor:
            snapshot[count] = Delivery[A](entry.identifier, entry.callback.clone())
            count += 1
            cursor = entry.next
        defer release_deliveries[A](snapshot)
        for delivery in snapshot:
            if not SignalState[A].contains(&self.state.header, delivery.identifier):
                continue
            let result = delivery.callback.invoke(argument)
            if not result.is_success():
                return result
            result.release()
        return Outcome[unit].success(Owned[unit](()))

func release_deliveries[A](deliveries: const Delivery[A][]):
    for delivery in deliveries:
        delivery.callback.release()
"""

## The text of `src/std/interop/transfer.lucb`.
let text_43: str = r"""#==============================================================================================
#
#   transfer - Uniquely owned cross-thread messages
#
#   DESCRIPTION:
#       A `Packet` is a uniquely owned message outside either thread's ARC graph; a `Transfer`
#       is the deep-copy policy, and a `Reply` carries a worker's result or failure.
#
#==============================================================================================

## A uniquely owned message outside either thread's ARC graph. Copies borrow;
## passing a packet into a queue transfers its release obligation. Its disposer
## must work on either thread and must not access thread-bound owners/allocators.
pub struct Packet[T]:
    ## The message value.
    pub let value: T
    let storage: void*? = none
    let dispose: (func(void*) -> unit)? = none

    ## A packet owning `value`, released through `dispose`.
    pub func init(value: T, storage: void*? = none, dispose: (func(void*) -> unit)? = none):
        self.value = value
        self.storage = storage
        self.dispose = dispose

    ## Dispose the packet's storage.
    pub func release():
        if let storage = self.storage:
            (self.dispose else trap("a packet has storage without a disposer"))(storage)

## Deep-copy policy supplied by the native library for a wire value. All borrowed
## members must point into the returned packet or immutable process-lifetime data.
## A policy must never smuggle an ARC owner, checked view or callback across threads.
pub struct Transfer[T]:
    ## The library's deep-copy of a wire value into a packet.
    pub let copy: func(T) -> Packet[T]!

    ## For pointer-free scalar/record values only. Text/spans need a deep copy.
    pub static func plain() -> Transfer[T]:
        return Transfer[T](Transfer[T].copy_plain)

    static func copy_plain(value: T) -> Packet[T]!:
        return Packet[T](value)

struct PacketBytes:
    var bytes: u8[]

    static func drop(raw: void*):
        let storage = (PacketBytes*)raw
        free(storage.bytes) in memory.heap
        free(storage) in memory.heap

    static func copy(value: const u8[]) -> Packet[const u8[]]!:
        let bytes = try new u8[value.length] --- in memory.heap
        errdefer free(bytes) in memory.heap
        memory.copy(bytes, value, value.length)
        let storage = try new PacketBytes(bytes) in memory.heap
        return Packet[const u8[]](bytes, (void*)storage, PacketBytes.drop)

    static func text(value: str) -> Packet[str]!:
        let packet = try PacketBytes.copy(value.bytes)
        return Packet[str]((str)packet.value, packet.storage, packet.dispose)

## The deep-copy policy for `str`.
pub let text_transfer: Transfer[str] = Transfer[str](PacketBytes.text)
## The deep-copy policy for byte spans.
pub let bytes_transfer: Transfer[const u8[]] = Transfer[const u8[]](PacketBytes.copy)

## A reply owns its successful packet or its copied failure text. get borrows;
## release is required whether the caller handles success or failure.
pub struct Reply[T]:
    let result: Packet[T]?
    ## The failure code, or `package(0)` on success.
    pub let code: ErrorCode
    let message: Packet[str]?

    ## A successful reply carrying `value`.
    pub static func success(value: Packet[T]) -> Reply[T]:
        return Reply[T](value, no_error, none)

    ## A failed reply with `code` and a copied `message`.
    pub static func failure(code: ErrorCode, message: str) -> Reply[T]:
        let copy = text_transfer.copy(message) catch failure:
            return Reply[T](none, memory.exhausted, Packet[str]("out of memory copying a worker failure"))
        return Reply[T](none, code, copy)

    ## Whether the reply succeeded.
    pub func is_success() -> bool:
        return self.message == none

    ## The success value, or the failure as an error.
    pub func get() -> T!:
        if let message = self.message:
            error(self.code, message.value)
        return (self.result else trap("a worker reply has no result")).value

    ## Release the reply's owned value or message.
    pub func release():
        if let result = self.result:
            result.release()
        if let message = self.message:
            message.release()
"""

## The text of `src/std/interop/worker_entry.lucb`.
let text_44: str = r"""#==============================================================================================
#
#   worker_entry - A worker's factory and runtime hooks
#
#   DESCRIPTION:
#       A named factory that runs once on the new thread and returns its local handler, with no
#       retained source-thread state.
#
#==============================================================================================

## A named factory and its runtime hooks, with no retained source-thread state.
## The factory runs exactly once on the new thread and returns its local handler.
## Compilers supply the managed entry adapter; Base factories use native().
pub struct WorkerEntry[C, M, R]:
    ## The factory's context pointer, borrowed for the worker's life.
    pub let context: void*?
    ## Runs the factory on the new thread, yielding its handler or a failure.
    pub let open: func(void*?, C) -> Outcome[Callback[M, R]]
    ## The runtime hook run as the worker starts.
    pub let enter: func() -> unit
    ## The runtime hook run as the worker ends.
    pub let leave: func() -> unit

    ## A worker entry from a plain Base factory.
    pub static func native(factory: func(C) -> Outcome[Callback[M, R]]) -> WorkerEntry[C, M, R]:
        return WorkerEntry[C, M, R]((void*)factory, WorkerEntry[C, M, R].open_native,
                                    ownership.enter, ownership.finish_task)

    static func open_native(context: void*?, configuration: C) -> Outcome[Callback[M, R]]:
        let factory = (func(C) -> Outcome[Callback[M, R]])(context else trap("a worker has no factory"))
        return factory(configuration)

local var active_worker_cancellation: sync.Cancellation*? = none

## Native operations called by a worker use this signal for interruptible socket
## waits. The pointer is borrowed on this worker until its factory/handler returns;
## it must not be retained outside the worker's lifetime or reset by application code.
pub func worker_cancellation() -> sync.Cancellation*:
    return active_worker_cancellation else trap("this operation requires an application worker")
"""

## The text of `src/std/interop/worker_queue.lucb`.
let text_45: str = r"""#==============================================================================================
#
#   worker_queue - A worker's message queue
#
#   DESCRIPTION:
#       Queue storage protected by the worker's mutex; removing a value transfers ownership
#       before waking a producer, and disposal runs outside the lock.
#
#==============================================================================================

## Queue storage is protected by WorkerState's mutex. Removing a value transfers
## ownership before waking a producer; disposal runs outside the queue lock.
struct WorkerQueue[T]:
    var slots: (T?)[]
    var head: usize = 0
    var count: usize = 0

    func full() -> bool:
        return self.count == self.slots.length

    func push(value: T):
        assert(not self.full())
        self.slots[(self.head + self.count) % self.slots.length] = value
        self.count += 1

    func pop() -> T:
        assert(self.count > 0)
        let value = self.slots[self.head] else trap("an occupied worker slot is empty")
        self.slots[self.head] = none
        self.head = (self.head + 1) % self.slots.length
        self.count -= 1
        return value
"""

## The text of `src/std/interop/worker.lucb`.
let text_46: str = r"""#==============================================================================================
#
#   worker - A managed worker thread
#
#   DESCRIPTION:
#       A worker runs a factory-built handler on its own thread; messages are posted with
#       `send` and their replies delivered through the entry's callback.
#
#==============================================================================================

## The worker has been closed.
pub let worker_closed: ErrorCode = ErrorCode.package(104)
## The worker's queue is full.
pub let worker_busy: ErrorCode = ErrorCode.package(105)

struct WorkerState[C, M, R]:
    var mutex: sync.Mutex
    var changed: sync.Condition
    var cancellation: sync.Cancellation
    var ready: bool
    var done: bool
    var startup_error: Reply[unit]?
    var input: WorkerQueue[Packet[M]]
    var output: WorkerQueue[Reply[R]]
    let configuration: Packet[C]
    let entry: WorkerEntry[C, M, R]
    let message_transfer: Transfer[M]
    let result_transfer: Transfer[R]
    var thread: thread.Handle

    static func start(entry: WorkerEntry[C, M, R], configuration: C,
                      config_transfer: Transfer[C], message_transfer: Transfer[M], result_transfer: Transfer[R],
                      capacity: usize, stack: usize) -> WorkerState[C, M, R]*!:
        if capacity == 0:
            error(invalid, "a worker queue needs positive capacity")
        let config = try config_transfer.copy(configuration)
        errdefer config.release()
        let input = try new (Packet[M]?)[capacity] --- in memory.heap
        errdefer free(input) in memory.heap
        let output = try new (Reply[R]?)[capacity] --- in memory.heap
        errdefer free(output) in memory.heap
        let block = try new WorkerState[C, M, R][1] --- in memory.heap
        errdefer free(block) in memory.heap
        let state = &block[0]
        var mutex: sync.Mutex
        var changed: sync.Condition
        var cancellation: sync.Cancellation
        var worker_thread: thread.Handle
        *state = WorkerState[C, M, R](mutex, changed, cancellation, false, false, none,
                                      WorkerQueue[Packet[M]](input), WorkerQueue[Reply[R]](output), config,
                                      entry, message_transfer, result_transfer, worker_thread)
        state.thread = try thread.spawn(WorkerState[C, M, R].run, (void*)state, stack)
        return state

    static func run(raw: void*?):
        let state = (WorkerState[C, M, R]*)(raw else trap("a worker has no state"))
        state.entry.enter()
        active_worker_cancellation = &state.cancellation
        let opened = state.entry.open(state.entry.context, state.configuration.value)
        let handler = opened.get() catch failure:
            let saved = Reply[unit].failure(failure.code, failure.message)
            opened.release()
            state.configuration.release()
            state.mutex.lock()
            state.startup_error = saved
            state.ready = true
            state.changed.broadcast()
            state.mutex.unlock()
            WorkerState[C, M, R].finish(state)
            return
        # The Outcome owns the handler until this thread has finished delivery.
        state.configuration.release()
        state.mutex.lock()
        state.ready = true
        state.changed.broadcast()
        state.mutex.unlock()
        WorkerState[C, M, R].deliver(state, handler)
        opened.release()
        WorkerState[C, M, R].finish(state)

    static func finish(state: WorkerState[C, M, R]*):
        active_worker_cancellation = none
        state.entry.leave()
        state.mutex.lock()
        state.done = true
        state.changed.broadcast()
        state.mutex.unlock()

    static func deliver(state: WorkerState[C, M, R]*, handler: Callback[M, R]):
        while true:
            state.mutex.lock()
            while state.input.count == 0 and not state.cancellation.is_requested():
                state.changed.wait(&state.mutex)
            if state.cancellation.is_requested():
                state.mutex.unlock()
                return
            let message = state.input.pop()
            state.changed.broadcast()
            state.mutex.unlock()
            let result = handler.invoke(message.value)
            let reply = WorkerState[C, M, R].copy_reply(state, result)
            result.release()
            message.release()
            state.mutex.lock()
            while state.output.full() and not state.cancellation.is_requested():
                state.changed.wait(&state.mutex)
            if state.cancellation.is_requested():
                state.mutex.unlock()
                reply.release()
                return
            state.output.push(reply)
            state.changed.broadcast()
            state.mutex.unlock()

    ## Under the mutex: the queued reply first, or worker_closed once the worker has
    ## stopped; none while it runs with nothing queued.
    static func take_reply(state: WorkerState[C, M, R]*) -> Reply[R]?!:
        if state.cancellation.is_requested() or state.done:
            error(worker_closed, "the worker no longer produces replies")
        if state.output.count == 0:
            return none
        let result = state.output.pop()
        state.changed.broadcast()
        return result

    static func copy_reply(state: WorkerState[C, M, R]*, outcome: Outcome[R]) -> Reply[R]:
        let value = outcome.get() catch failure:
            return Reply[R].failure(failure.code, failure.message)
        let copy = state.result_transfer.copy(value) catch failure:
            return Reply[R].failure(failure.code, failure.message)
        return Reply[R].success(copy)

## A bounded persistent worker. This carrier is uniquely owned; Base copies borrow.
## send/receive/cancel may be called concurrently while the owner keeps it alive.
## close must run after those callers return; it cancels and joins before freeing.
## Luce libraries expose their own owned application-specific wrapper around it.
# mark: The worker handle ======================================================================

## A bounded persistent worker: a uniquely-owned handle over a thread, its queues and cancellation.
pub struct Worker[C, M, R]:
    var state: WorkerState[C, M, R]*?

    ## Start `entry` on a new worker thread with `configuration`, waiting until it is ready.
    pub func init(entry: WorkerEntry[C, M, R], configuration: C,
                  config_transfer: Transfer[C], message_transfer: Transfer[M], result_transfer: Transfer[R],
                  capacity: usize = 16, stack: usize = 0) -> !:
        let state = try WorkerState[C, M, R].start(entry, configuration, config_transfer,
                                                   message_transfer, result_transfer, capacity, stack)
        self.state = state
        state.mutex.lock()
        while not state.ready:
            state.changed.wait(&state.mutex)
        state.mutex.unlock()
        if let failure = state.startup_error:
            # Copy into the creator's temporary pool before joining/freeing state.
            # Native callers scope ownership.mark/drain around error consumption.
            let message = (failure.message else trap("a startup failure has no message")).value
            let saved = copy_text(message) catch exhausted:
                self.close()
                error(memory.exhausted, "out of memory copying a worker startup failure")
            let code = failure.code
            _ = ownership.pool_object(saved.owner else trap("copied text has no owner"))
            self.close()
            error(code, saved.value)

    ## Post `message` to the worker, blocking while its input queue is full.
    pub func send(message: M) -> !:
        try self.dispatch(message, true)

    ## Nonblocking backpressure: a full input queue returns worker_busy.
    pub func try_send(message: M) -> !:
        try self.dispatch(message, false)

    func dispatch(message: M, wait: bool) -> !:
        let state = self.state else error(worker_closed, "the worker is closed")
        let packet = try state.message_transfer.copy(message)
        errdefer packet.release()
        state.mutex.lock()
        defer state.mutex.unlock()
        while state.input.full() and not state.cancellation.is_requested() and not state.done:
            if not wait:
                error(worker_busy, "the worker input queue is full")
            state.changed.wait(&state.mutex)
        if state.cancellation.is_requested() or state.done:
            error(worker_closed, "the worker no longer accepts messages")
        state.input.push(packet)
        state.changed.broadcast()

    ## The next reply, waiting for it. Replies preserve accepted-message order.
    ## Cancellation is terminal: queued replies are discarded by close, and blocked
    ## receivers wake with worker_closed.
    pub func receive() -> Reply[R]!:
        let state = self.state else error(worker_closed, "the worker is closed")
        state.mutex.lock()
        defer state.mutex.unlock()
        while state.output.count == 0 and not state.cancellation.is_requested() and not state.done:
            state.changed.wait(&state.mutex)
        return try WorkerState[C, M, R].take_reply(state) else trap("a worker woke with no reply")

    ## The next reply if one is ready, none if not: a receive that never waits, for a
    ## caller that polls, as a UI frame does.
    pub func try_receive() -> Reply[R]?!:
        return try self.receive_within(0)

    ## The next reply, waiting at most about `milliseconds` for it; none when none came.
    pub func receive_within(milliseconds: u64) -> Reply[R]?!:
        let state = self.state else error(worker_closed, "the worker is closed")
        let deadline = time.now() + milliseconds * 1000000
        state.mutex.lock()
        defer state.mutex.unlock()
        while state.output.count == 0 and not state.cancellation.is_requested() and not state.done:
            let now = time.now()
            if now >= deadline:
                return none
            state.changed.wait_for(&state.mutex, (deadline - now + 999999) // 1000000)
        return try WorkerState[C, M, R].take_reply(state)

    ## Ask the worker to stop; cancellation is terminal and wakes blocked callers.
    pub func cancel():
        let state = self.state else return
        state.mutex.lock()
        state.cancellation.request()
        state.changed.broadcast()
        state.mutex.unlock()

    ## Cancel the worker, join its thread, drain its queues, and free it.
    pub func close():
        let state = self.state else return
        self.cancel()
        state.thread.join() catch failure:
            trap("a worker could not join its thread")
        self.state = none
        while state.input.count > 0:
            state.input.pop().release()
        while state.output.count > 0:
            state.output.pop().release()
        if let failure = state.startup_error:
            failure.release()
        free(state.input.slots) in memory.heap
        free(state.output.slots) in memory.heap
        free(u8[]((u8*)state, memory.size_of(WorkerState[C, M, R]))) in memory.heap
"""

## The text of `src/std/debug.lucb`.
let text_47: str = r"""#==============================================================================================
#
#   debug - The in-program source debugger's runtime
#
#   DESCRIPTION:
#       The hooks a `--debug` build calls on entry, exit and at each statement, and the
#       breakpoint console that reads frames by their described layout.
#
#==============================================================================================

import c
import memory
extern func getenv(name: c.str) -> c.str?
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func c_exit as "exit"(code: i32) -> never

## A frame as the compiler described it under `--debug`: the function's name and
## source, then `count` locals laid out after it, in this record's own layout.
struct Shape:
    var name: str
    var source: str
    var count: u64

struct Local:
    var name: str
    var kind: str
    var offset: u64
    var size: u64

struct Activation:
    var shape: Shape*?
    var frame: void*?
    var line: u32

struct Break:
    var file: str
    var line: u32

var activations: Activation[512]
var depth: usize
var checked: bool
var active: bool
var started: bool
var stepping: bool
var step_over: usize
var breaks: Break[32]
var break_count: usize
var names: u8[4096]
var names_used: usize
var line_bytes: u8[512]

## Called at every function entry and exit of a `--debug` build.
# mark: Debugger hooks ========================================================================

## Enter a described lexical scope for the in-program debugger.
pub func enter(shape: void*):
    if depth < activations.length:
        activations[depth] = Activation(shape = (Shape*)shape, frame = none, line = 0)
    depth += 1

## Pop the current activation from the debugger's shadow stack.
pub func leave():
    if depth > 0:
        depth -= 1

## Called before every statement: stop when a breakpoint, a step, or the start asks.
pub func at(shape: void*, line: u32, frame: void*):
    if not checked:
        checked = true
        active = getenv("LUCE_DEBUG") != none
    if not active or depth == 0 or depth > activations.length:
        return
    let top = depth - 1
    let s = (Shape*)shape
    activations[top] = Activation(shape = s, frame = frame, line = line)
    var stop = false
    if not started:
        started = true
        stop = true
    elif stepping:
        stop = true
    elif step_over > 0 and depth <= step_over:
        stop = true
    elif hits(s.source, line):
        stop = true
    if not stop:
        return
    stepping = false
    step_over = 0
    print(f"stopped at {s.source}:{line} in {s.name}")
    prompt(top)

func hits(file: str, line: u32) -> bool:
    var i: usize = 0
    while i < break_count:
        let b = breaks[i]
        if b.line == line and (b.file == file or ends_with(file, b.file)):
            return true
        i += 1
    return false

func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## Read commands until one lets the program run.
func prompt(top: usize):
    while true:
        let line = read_line() else return
        let command = first_word(line)
        let rest = trim((str)line.bytes[command.length..])
        if command == "r" or command == "run" or command == "c" or command == "continue":
            return
        if command == "s" or command == "step":
            stepping = true
            return
        if command == "n" or command == "next":
            step_over = depth
            return
        if command == "q" or command == "quit":
            print("quit")
            c_exit(0)
        if command == "b" or command == "break":
            add_break(rest)
        elif command == "p" or command == "print":
            show_named(top, rest)
        elif command == "locals":
            show_all(top)
        elif command == "bt" or command == "backtrace":
            backtrace()
        elif command.length == 0:
            continue
        else:
            print(f"unknown command `{command}`; commands: break FILE:LINE, run, step, next, print NAME, locals, backtrace, quit")

func add_break(spec: str):
    var colon: usize = spec.length
    var i = spec.length
    while i > 0:
        i -= 1
        if spec.bytes[i] == ':':
            colon = i
            break
    if colon == spec.length:
        print("break needs FILE:LINE")
        return
    let file = (str)spec.bytes[..<colon]
    let number = parse_line((str)spec.bytes[colon + 1..])
    if number == 0 or break_count == breaks.length or names_used + file.length > names.length:
        print("cannot set that breakpoint")
        return
    memory.copy(names[names_used..], file.bytes, file.length)
    let kept = (str)names[names_used..<names_used + file.length]
    names_used += file.length
    breaks[break_count] = Break(file = kept, line = number)
    break_count += 1
    print(f"breakpoint {break_count} at {file}:{number}")

func parse_line(text: str) -> u32:
    var value: u32 = 0
    for byte in text.bytes:
        if byte < '0' or byte > '9':
            return 0
        value = value * 10 + (u32)(byte - '0')
    return value

func backtrace():
    var i = depth
    var index: usize = 0
    while i > 0:
        i -= 1
        let a = activations[i]
        if let s = a.shape:
            print(f"#{index} {s.name} at {s.source}:{a.line}")
        index += 1

func show_all(top: usize):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        show(local_of(s, i), a.frame)
        i += 1

func show_named(top: usize, name: str):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        let described = local_of(s, i)
        if described.name == name:
            show(described, a.frame)
            return
        i += 1
    print(f"no local named `{name}`")

## The locals follow the shape, each `memory.size_of(Local)` bytes.
func local_of(s: Shape*, index: u64) -> Local*:
    let base = (usize)s + memory.size_of(Shape) + (usize)index * memory.size_of(Local)
    return (Local*)base

## A local's value read from the frame and shown by its type's spelling.
func show(described: Local*, frame: void*?):
    let f = frame else return
    let address = (void*)((usize)f - (usize)described.offset)
    let kind = described.kind
    if kind == "i64" or kind == "isize":
        print(f"{described.name}: {kind} = {memory.read[i64](address)}")
    elif kind == "i32":
        print(f"{described.name}: {kind} = {memory.read[i32](address)}")
    elif kind == "i16":
        print(f"{described.name}: {kind} = {memory.read[i16](address)}")
    elif kind == "i8":
        print(f"{described.name}: {kind} = {memory.read[i8](address)}")
    elif kind == "u64" or kind == "usize":
        print(f"{described.name}: {kind} = {memory.read[u64](address)}")
    elif kind == "u32" or kind == "char":
        print(f"{described.name}: {kind} = {memory.read[u32](address)}")
    elif kind == "u16":
        print(f"{described.name}: {kind} = {memory.read[u16](address)}")
    elif kind == "u8":
        print(f"{described.name}: {kind} = {memory.read[u8](address)}")
    elif kind == "bool":
        print(f"{described.name}: {kind} = {memory.read[bool](address)}")
    elif kind == "f64":
        print(f"{described.name}: {kind} = {memory.read[f64](address)}")
    elif kind == "f32":
        print(f"{described.name}: {kind} = {memory.read[f32](address)}")
    elif kind == "str":
        let text = memory.read[str](address)
        print(f"{described.name}: {kind} = \"{text}\"")
    elif kind == "c.str":
        let text = memory.read[c.str](address)
        print(f"{described.name}: {kind} = \"{(str)text}\"")
    elif ends_with(kind, "*") or ends_with(kind, "*?"):
        print(f"{described.name}: {kind} = 0x{memory.read[usize](address):x}")
    else:
        var shown: usize = (usize)described.size
        if shown > 32:
            shown = 32
        var text: u8[160]
        var used: usize = 0
        var i: usize = 0
        while i < shown:
            let byte = memory.read[u8]((void*)((usize)address + i))
            let digits = "0123456789abcdef".bytes
            text[used] = digits[(usize)(byte >> 4)]
            text[used + 1] = digits[(usize)(byte & 15)]
            text[used + 2] = ' '
            used += 3
            i += 1
        print(f"{described.name}: {kind} = {described.size} bytes {(str)text[..<used]}")

func first_word(line: str) -> str:
    var i: usize = 0
    while i < line.length and line.bytes[i] != ' ':
        i += 1
    return (str)line.bytes[..<i]

func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    while start < end and text.bytes[start] == ' ':
        start += 1
    while end > start and (text.bytes[end - 1] == ' ' or text.bytes[end - 1] == '\r'):
        end -= 1
    return (str)text.bytes[start..<end]

## One line from standard input, without its newline; none at the end of input.
func read_line() -> str?:
    var used: usize = 0
    while used < line_bytes.length:
        var byte: u8[1]
        let n = c_read(0, &byte[0], 1)
        if n <= 0:
            if used == 0:
                return none
            break
        if byte[0] == '\n':
            break
        line_bytes[used] = byte[0]
        used += 1
    return (str)line_bytes[..<used]
"""

# mark: By index ==============================================================================

## The text of fragment `index`, as `paths` names it.
pub func text(index: usize) -> str:
    match index:
        0: return text_0
        1: return text_1
        2: return text_2
        3: return text_3
        4: return text_4
        5: return text_5
        6: return text_6
        7: return text_7
        8: return text_8
        9: return text_9
        10: return text_10
        11: return text_11
        12: return text_12
        13: return text_13
        14: return text_14
        15: return text_15
        16: return text_16
        17: return text_17
        18: return text_18
        19: return text_19
        20: return text_20
        21: return text_21
        22: return text_22
        23: return text_23
        24: return text_24
        25: return text_25
        26: return text_26
        27: return text_27
        28: return text_28
        29: return text_29
        30: return text_30
        31: return text_31
        32: return text_32
        33: return text_33
        34: return text_34
        35: return text_35
        36: return text_36
        37: return text_37
        38: return text_38
        39: return text_39
        40: return text_40
        41: return text_41
        42: return text_42
        43: return text_43
        44: return text_44
