## The text of `src/std/float_text/ryu.lucb`.
let text_4: str = r"""#==============================================================================================
#
#   ryu - The shortest digits of a float (float_text)
#
#   DESCRIPTION:
#       Ryu's d2d and f2s over float_text's tables of powers of five: the fewest decimal
#       digits, and their power of ten, that read back as a finite nonzero f64 or f32.
#
#==============================================================================================

# mark: Ryu ====================================================================================

## Ryu's d2d: the shortest decimal digits * 10^exponent of a finite, nonzero f64, given its
## mantissa and exponent fields.
func shortest64(ieee_mantissa: u64, ieee_exponent: u32) -> (u64, i32):
    var e2: i32 = 0
    var m2: u64 = 0
    if ieee_exponent == 0:
        e2 = 1 - 1023 - 52 - 2
        m2 = ieee_mantissa
    else:
        e2 = (i32)ieee_exponent - 1023 - 52 - 2
        m2 = ((u64)1 << 52) | ieee_mantissa
    let accept_bounds = (m2 & 1) == 0
    let mv = 4 * m2
    let mm_shift: u64 = 1 if ieee_mantissa != 0 or ieee_exponent <= 1 else 0
    var vr: u64 = 0
    var vp: u64 = 0
    var vm: u64 = 0
    var e10: i32 = 0
    var vm_trailing_zeros = false
    var vr_trailing_zeros = false
    if e2 >= 0:
        let q = log10_pow2(e2) - (1 if e2 > 3 else 0)
        e10 = q
        let k = 125 + pow5_bits(q) - 1
        let i = -e2 + q + k
        let row = (usize)q * 2
        vr = mul_shift64(4 * m2, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        vp = mul_shift64(4 * m2 + 2, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        vm = mul_shift64(4 * m2 - 1 - mm_shift, pow5_inv_split[row], pow5_inv_split[row + 1], i)
        if q <= 21:
            if mv % 5 == 0:
                vr_trailing_zeros = pow5_factor(mv) >= (u32)q
            elif accept_bounds:
                vm_trailing_zeros = pow5_factor(mv - 1 - mm_shift) >= (u32)q
            elif pow5_factor(mv + 2) >= (u32)q:
                vp -= 1
    else:
        let q = log10_pow5(-e2) - (1 if -e2 > 1 else 0)
        e10 = q + e2
        let i = -e2 - q
        let k = pow5_bits(i) - 125
        let j = q - k
        let row = (usize)i * 2
        vr = mul_shift64(4 * m2, pow5_split[row], pow5_split[row + 1], j)
        vp = mul_shift64(4 * m2 + 2, pow5_split[row], pow5_split[row + 1], j)
        vm = mul_shift64(4 * m2 - 1 - mm_shift, pow5_split[row], pow5_split[row + 1], j)
        if q <= 1:
            vr_trailing_zeros = true
            if accept_bounds:
                vm_trailing_zeros = mm_shift == 1
            else:
                vp -= 1
        elif q < 63:
            vr_trailing_zeros = (mv & (((u64)1 << (u64)q) - 1)) == 0
    return trimmed(vr, vp, vm, e10, accept_bounds, vm_trailing_zeros, vr_trailing_zeros, 0)

## Ryu's digit removal, d2d's and f2s's alike: drop digits while the bounds still differ,
## then round on the last digit removed (`start_last`, the one f2s's bounds computation
## already dropped, or 0). Dropping two digits at once leaves their tens digit as the last.
func trimmed(start_vr: u64, start_vp: u64, start_vm: u64, e10: i32, accept_bounds: bool, start_vm_zeros: bool, start_vr_zeros: bool, start_last: u64) -> (u64, i32):
    var vr = start_vr
    var vp = start_vp
    var vm = start_vm
    var vm_trailing_zeros = start_vm_zeros
    var vr_trailing_zeros = start_vr_zeros
    var removed: i32 = 0
    var last_removed = start_last
    if vm_trailing_zeros or vr_trailing_zeros:
        while vp // 10 > vm // 10:
            vm_trailing_zeros = vm_trailing_zeros and vm % 10 == 0
            vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
            last_removed = vr % 10
            vr = vr // 10
            vp = vp // 10
            vm = vm // 10
            removed += 1
        if vm_trailing_zeros:
            while vm % 10 == 0:
                vr_trailing_zeros = vr_trailing_zeros and last_removed == 0
                last_removed = vr % 10
                vr = vr // 10
                vp = vp // 10
                vm = vm // 10
                removed += 1
        if vr_trailing_zeros and last_removed == 5 and vr % 2 == 0:
            last_removed = 4
        let up = (vr == vm and (not accept_bounds or not vm_trailing_zeros)) or last_removed >= 5
        return (vr + (1 if up else 0), e10 + removed)
    if vp // 100 > vm // 100:
        last_removed = (vr % 100) // 10
        vr = vr // 100
        vp = vp // 100
        vm = vm // 100
        removed += 2
    while vp // 10 > vm // 10:
        last_removed = vr % 10
        vr = vr // 10
        vp = vp // 10
        vm = vm // 10
        removed += 1
    return (vr + (1 if vr == vm or last_removed >= 5 else 0), e10 + removed)

## Ryu's f2s over the same tables: the shortest decimal digits * 10^exponent of a finite,
## nonzero f32.
func shortest32(ieee_mantissa: u32, ieee_exponent: u32) -> (u32, i32):
    var e2: i32 = 0
    var m2: u32 = 0
    if ieee_exponent == 0:
        e2 = 1 - 127 - 23 - 2
        m2 = ieee_mantissa
    else:
        e2 = (i32)ieee_exponent - 127 - 23 - 2
        m2 = ((u32)1 << 23) | ieee_mantissa
    let accept_bounds = (m2 & 1) == 0
    let mv = 4 * m2
    let mp = 4 * m2 + 2
    let mm_shift: u32 = 1 if ieee_mantissa != 0 or ieee_exponent <= 1 else 0
    let mm = 4 * m2 - 1 - mm_shift
    var vr: u32 = 0
    var vp: u32 = 0
    var vm: u32 = 0
    var e10: i32 = 0
    var vm_trailing_zeros = false
    var vr_trailing_zeros = false
    var last_removed: u32 = 0
    if e2 >= 0:
        let q = log10_pow2(e2)
        e10 = q
        let k = 61 + pow5_bits(q) - 1
        let i = -e2 + q + k
        vr = pow5_inv_div_pow2(mv, q, i)
        vp = pow5_inv_div_pow2(mp, q, i)
        vm = pow5_inv_div_pow2(mm, q, i)
        if q != 0 and (vp - 1) // 10 <= vm // 10:
            let l = 61 + pow5_bits(q - 1) - 1
            last_removed = pow5_inv_div_pow2(mv, q - 1, -e2 + q - 1 + l) % 10
        if q <= 9:
            if mv % 5 == 0:
                vr_trailing_zeros = pow5_factor((u64)mv) >= (u32)q
            elif accept_bounds:
                vm_trailing_zeros = pow5_factor((u64)mm) >= (u32)q
            elif pow5_factor((u64)mp) >= (u32)q:
                vp -= 1
    else:
        let q = log10_pow5(-e2)
        e10 = q + e2
        let i = -e2 - q
        let k = pow5_bits(i) - 61
        var j = q - k
        vr = pow5_div_pow2(mv, i, j)
        vp = pow5_div_pow2(mp, i, j)
        vm = pow5_div_pow2(mm, i, j)
        if q != 0 and (vp - 1) // 10 <= vm // 10:
            j = q - 1 - (pow5_bits(i + 1) - 61)
            last_removed = pow5_div_pow2(mv, i + 1, j) % 10
        if q <= 1:
            vr_trailing_zeros = true
            if accept_bounds:
                vm_trailing_zeros = mm_shift == 1
            else:
                vp -= 1
        elif q < 31:
            vr_trailing_zeros = (mv & (((u32)1 << (u32)(q - 1)) - 1)) == 0
    let (digits, exponent) = trimmed((u64)vr, (u64)vp, (u64)vm, e10, accept_bounds, vm_trailing_zeros, vr_trailing_zeros, (u64)last_removed)
    return (u32(digits), exponent)

## floor(log2(5^e)) + 1 for 0 <= e <= 3528.
inline func pow5_bits(e: i32) -> i32:
    return (i32)((((u32)e) * 1217359) >> 19) + 1

## floor(log10(2^e)) for 0 <= e <= 1650.
inline func log10_pow2(e: i32) -> i32:
    return (i32)((((u32)e) * 78913) >> 18)

## floor(log10(5^e)) for 0 <= e <= 2620.
inline func log10_pow5(e: i32) -> i32:
    return (i32)((((u32)e) * 732923) >> 20)

## How many times 5 divides `value` (nonzero).
func pow5_factor(value: u64) -> u32:
    var rest = value
    var count: u32 = 0
    while rest % 5 == 0:
        rest = rest // 5
        count += 1
    return count

## (m * (high:low)) >> j for Ryu's 125-bit multipliers.
inline func mul_shift64(m: u64, low: u64, high: u64, j: i32) -> u64:
    var b0_low: u64 = 0
    let b0_high = product(m, low, &b0_low)
    var b2_low: u64 = 0
    var b2_high = product(m, high, &b2_low)
    let sum_low = b2_low +% b0_high
    if sum_low < b2_low:
        b2_high += 1
    let shift = (u64)(j - 64)
    if shift == 0:
        return sum_low
    if shift >= 64:
        return b2_high >> (shift - 64)
    return (b2_high << (64 - shift)) | (sum_low >> shift)

inline func mul_shift32(m: u32, factor: u64, shift: i32) -> u32:
    let low = (u64)m * (factor & 0xFFFFFFFF)
    let high = (u64)m * (factor >> 32)
    let sum = (low >> 32) + high
    return (u32)(sum >> (u64)(shift - 32))

inline func pow5_inv_div_pow2(m: u32, q: i32, j: i32) -> u32:
    return mul_shift32(m, pow5_inv_split[(usize)q * 2 + 1] + 1, j)

inline func pow5_div_pow2(m: u32, i: i32, j: i32) -> u32:
    return mul_shift32(m, pow5_split[(usize)i * 2 + 1], j)

## The 128-bit product a * b: the high word, the low word stored in `low`. Ryu's
## multiplications and strings' float parsing (Lemire's) both take it.
pub inline func product(a: u64, b: u64, low: u64*) -> u64:
    let a0 = a & 0xFFFFFFFF
    let a1 = a >> 32
    let b0 = b & 0xFFFFFFFF
    let b1 = b >> 32
    let p00 = a0 * b0
    let p01 = a0 * b1
    let p10 = a1 * b0
    let p11 = a1 * b1
    let middle = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
    *low = (middle << 32) | (p00 & 0xFFFFFFFF)
    return p11 + (p01 >> 32) + (p10 >> 32) + (middle >> 32)
"""

## The text of `src/std/numerals.lucb`.
let text_5: str = r"""#==============================================================================================
#
#   numerals - Numbers and text laid out by a format specification
#
#   DESCRIPTION:
#       What a formatted string's `{value:spec}` field does (base.md §5.5), as Python's
#       `format` does it: the specification read as CPython's
#       parse_internal_render_format_spec reads it, a number laid out as calc_number_widths
#       and fill_number lay it out, and a float's digits made exactly and rounded half to
#       even, as David Gay's dtoa rounds them. The text goes to a `Sink` piece by piece, so
#       nothing is allocated and nothing bounds a field but the sink. The compiler reads a
#       field's specification with `read` and `misfit` and refuses one that does not fit;
#       the program lays the field out with `lay_integer`, `lay_float` or `lay_text`. It is
#       the one implementation: Luce lays out its fields and rounds `math.round` with it too,
#       wording a misfit in its own terms from `misfit_of` (luce src/support/number_text.lucb),
#       and the seed carries a copy of this file. It comes after `float_text` and before
#       `core`, and needs nothing else.
#
#==============================================================================================

import float_text

# mark: Specifications =========================================================================

## A specification read: `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`
## (§5.5). A part not written is `0`, `-1` or empty, so a default can still be told apart.
pub struct Spec:
    ## The fill scalar, as written; empty when none was.
    pub var fill: str
    ## `<`, `>`, `^` or `=`; 0 when none was written.
    pub var align: u8
    ## `+`, `-` or a space; 0 when none was written.
    pub var sign: u8
    ## `z`: a negative zero, after rounding, shows as zero.
    pub var no_negative_zero: bool
    ## `#`: the alternate form, a base's prefix or a point always kept.
    pub var alternate: bool
    ## `0` before the width: zeros fill a number after its sign.
    pub var zero: bool
    ## The least width in scalars; -1 when none was written.
    pub var width: i64
    ## `,` or `_` between groups of digits; 0 when none was written.
    pub var grouping: u8
    ## The digits after the point, or the scalars a text keeps; -1 when none was written.
    pub var precision: i64
    ## The type letter; 0 when none was written.
    pub var kind: u8

## A specification read from its text, and what is wrong with it: empty when nothing is.
pub struct Reading:
    ## The specification, meaningful when `problem` is empty.
    pub var spec: Spec
    ## Why the text is not a specification; empty when it is one.
    pub var problem: str

## What a field shows: an integer, a float, or text (a `str`, a `char`, a `bool`).
pub enum Category:
    integer
    floating
    text

func is_align(byte: u8) -> bool:
    return byte == '<' or byte == '>' or byte == '^' or byte == '='

## The byte length of the UTF-8 scalar starting with `lead`.
func scalar_bytes(lead: u8) -> usize:
    if lead < 0x80:
        return 1
    if lead < 0xE0:
        return 2
    if lead < 0xF0:
        return 3
    return 4

## The scalars of UTF-8 `text`.
pub func scalar_count(text: const u8[]) -> i64:
    var n: i64 = 0
    for b in text:
        if (b & 0xC0) != 0x80:
            n += 1
    return n

## Digits read from `at` as a width or a precision; how many there were, -1 when too many.
func read_count(b: const u8[], at: usize*, value: i64*) -> i64:
    var n: i64 = 0
    var total: i64 = 0
    while *at < b.length and b[*at] >= '0' and b[*at] <= '9':
        total = total * 10 + (i64)(b[*at] - '0')
        if total > 1000000000:
            return -1
        n += 1
        *at += 1
    *value = total
    return n

## Read `text` as CPython's parse_internal_render_format_spec reads a specification.
pub func read(text: str) -> Reading:
    var spec = Spec(fill = "", align = 0, sign = 0, no_negative_zero = false, alternate = false, zero = false, width = -1, grouping = 0, precision = -1, kind = 0)
    let b = text.bytes
    var at: usize = 0
    var first: usize = 0
    if b.length > 0:
        first = scalar_bytes(b[0])
    if b.length > first and is_align(b[first]):
        spec.fill = (str)b[..<first]
        spec.align = b[first]
        at = first + 1
    elif b.length > 0 and is_align(b[0]):
        spec.align = b[0]
        at = 1
    if at < b.length and (b[at] == '+' or b[at] == '-' or b[at] == ' '):
        spec.sign = b[at]
        at += 1
    if at < b.length and b[at] == 'z':
        spec.no_negative_zero = true
        at += 1
    if at < b.length and b[at] == '#':
        spec.alternate = true
        at += 1
    if spec.fill.length == 0 and at < b.length and b[at] == '0':
        spec.zero = true
        at += 1
    var width: i64 = 0
    let digits = read_count(b, &at, &width)
    if digits < 0:
        return Reading(spec = spec, problem = "its width is too large")
    if digits > 0:
        spec.width = width
    if at < b.length and (b[at] == ',' or b[at] == '_'):
        spec.grouping = b[at]
        at += 1
        if at < b.length and (b[at] == ',' or b[at] == '_'):
            return Reading(spec = spec, problem = "it groups digits with both `,` and `_`")
    if at < b.length and b[at] == '.':
        at += 1
        var precision: i64 = 0
        let n = read_count(b, &at, &precision)
        if n < 0:
            return Reading(spec = spec, problem = "its precision is too large")
        if n == 0:
            return Reading(spec = spec, problem = "a `.` is followed by the precision's digits")
        spec.precision = precision
    if b.length - at > 1:
        return Reading(spec = spec, problem = "it is not `[[fill]align][sign][z][#][0][width][grouping][.precision][type]`")
    if at < b.length:
        spec.kind = b[at]
    return Reading(spec = spec, problem = "")

## Why a specification does not fit a value of its category, for its caller to word.
pub enum Misfit:
    ## It fits.
    fits
    ## An integer with `e`, `f`, `g`, `%` or their upper cases.
    float_type_of_integer
    ## An integer with a type letter of no number.
    integer_type
    ## An integer with a precision.
    integer_precision
    ## An integer with `z`.
    integer_z
    ## A `c` with a sign.
    scalar_sign
    ## A `c` with `#`.
    scalar_alternate
    ## `,` with `b`, `o`, `x` or `X`.
    comma_grouping
    ## A `c` with `_`.
    scalar_grouping
    ## A float with a type letter of no float.
    float_type
    ## Text with a type letter other than `s`.
    text_type
    ## Text with a sign.
    text_sign
    ## Text with `z`.
    text_z
    ## Text with `#`.
    text_alternate
    ## Text aligned with `=`.
    text_after_sign
    ## Text with grouping.
    text_grouping

## Why `spec` does not fit a value of `category`, or `fits` (§5.5).
pub func misfit_of(spec: Spec, category: Category) -> Misfit:
    let k = spec.kind
    match category:
        .integer:
            if k == 'e' or k == 'E' or k == 'f' or k == 'F' or k == 'g' or k == 'G' or k == '%':
                return Misfit.float_type_of_integer
            if k != 0 and k != 'd' and k != 'b' and k != 'o' and k != 'x' and k != 'X' and k != 'c':
                return Misfit.integer_type
            if spec.precision >= 0:
                return Misfit.integer_precision
            if spec.no_negative_zero:
                return Misfit.integer_z
            if k == 'c' and spec.sign != 0:
                return Misfit.scalar_sign
            if k == 'c' and spec.alternate:
                return Misfit.scalar_alternate
            if spec.grouping == ',' and k != 0 and k != 'd':
                return Misfit.comma_grouping
            if spec.grouping == '_' and k == 'c':
                return Misfit.scalar_grouping
        .floating:
            if k != 0 and k != 'e' and k != 'E' and k != 'f' and k != 'F' and k != 'g' and k != 'G' and k != '%':
                return Misfit.float_type
        .text:
            if k != 0 and k != 's':
                return Misfit.text_type
            if spec.sign != 0:
                return Misfit.text_sign
            if spec.no_negative_zero:
                return Misfit.text_z
            if spec.alternate:
                return Misfit.text_alternate
            if spec.align == '=':
                return Misfit.text_after_sign
            if spec.grouping != 0:
                return Misfit.text_grouping
    return Misfit.fits

## What is wrong with `spec` for a value of `category`, in Base's terms: empty when it
## fits (§5.5).
pub func misfit(spec: Spec, category: Category) -> str:
    match misfit_of(spec, category):
        .fits:
            return ""
        .float_type_of_integer:
            return "its type letter formats a float; convert the integer with `f64(...)` first"
        .integer_type:
            return "an integer is formatted with `d`, `b`, `o`, `x`, `X` or `c`"
        .integer_precision:
            return "an integer takes no precision"
        .integer_z, .text_z:
            return "`z` belongs to a float"
        .scalar_sign:
            return "`c` takes no sign"
        .scalar_alternate:
            return "`c` takes no `#`"
        .comma_grouping:
            return "`,` groups decimal digits; `_` groups `b`, `o`, `x` and `X`"
        .scalar_grouping:
            return "`c` takes no grouping"
        .float_type:
            return "a float is formatted with `e`, `E`, `f`, `F`, `g`, `G` or `%`"
        .text_type:
            return "text is formatted with `s` or no type"
        .text_sign:
            return "a sign belongs to a number"
        .text_alternate:
            return "`#` belongs to a number"
        .text_after_sign:
            return "`=` aligns a number after its sign"
        .text_grouping:
            return "grouping belongs to a number"

## The fill and alignment a field uses: the written ones, else the defaults, a number to
## the right and text to the left, and `0` before the width filling with zeros after the
## sign (CPython's backwards-compatible special case).
func settle(spec: Spec, numeric: bool) -> Spec:
    var out = spec
    if spec.zero:
        out.fill = "0"
        if spec.align == 0 and numeric:
            out.align = '='
    if out.fill.length == 0:
        out.fill = " "
    if out.align == 0:
        out.align = '>' if numeric else '<'
    return out

## The settled specification of `specification`, which the compiler has read and fitted.
func settled(specification: str, numeric: bool) -> Spec:
    let reading = read(specification)
    if reading.problem.length > 0:
        trap("a formatted field's specification is not one; the compiler refuses it")
    return settle(reading.spec, numeric)

# mark: Output =================================================================================

## Where laid-out text goes: `write` appends `bytes` to `context`, answering false when
## they did not all fit, which ends the layout.
pub struct Sink:
    ## What the text is written into, handed to `write`.
    pub var context: void*
    ## Append the bytes; false when they did not all fit.
    pub var write: func(void*, const u8[]) -> bool

func put(sink: Sink, bytes: const u8[]) -> bool:
    let write = sink.write
    return bytes.length == 0 or write(sink.context, bytes)

func put_byte(sink: Sink, byte: u8) -> bool:
    let one: u8[1] = [byte]
    return put(sink, one)

## `text` `n` times.
func repeat(sink: Sink, text: str, n: i64) -> bool:
    var i: i64 = 0
    while i < n:
        if not put(sink, text.bytes):
            return false
        i += 1
    return true

## `text` with its lower-case letters in upper case when `upper`.
func put_cased(sink: Sink, text: const u8[], upper: bool) -> bool:
    if not upper:
        return put(sink, text)
    for c in text:
        if not put_byte(sink, c - 32 if c >= 'a' and c <= 'z' else c):
            return false
    return true

## Padding before and after `n` scalars to `width`, by the alignment (CPython's calc_padding).
func padding(n: i64, width: i64, align: u8) -> (i64, i64):
    let total = width if width > n else n
    var left: i64 = 0
    if align == '>':
        left = total - n
    elif align == '^':
        left = (total - n) // 2
    return (left, total - n - left)

func smaller(a: i64, b: i64) -> i64:
    return a if a < b else b

func larger(a: i64, b: i64) -> i64:
    return a if a > b else b

# mark: Digits =================================================================================

## Digits, a virtual `0` outside `[0, count)`: an integer's in its base, or the exact
## decimal digits of a float's magnitude, `0.d1d2d3... × 10^point`, at most 767 significant
## digits for any finite f64 and no trailing zero.
pub struct Decimal:
    ## The digits, as ASCII; the first `count` are meaningful.
    pub var digits: u8[800]
    ## How many digits there are; 0 is zero.
    pub var count: usize
    ## Where the point stands: before `digits[point]`, a negative `point` that many zeros
    ## earlier.
    pub var point: i64

    ## The digit at virtual index `i`.
    pub func at(i: i64) -> u8:
        return self.digits[(usize)i] if i >= 0 and i < (i64)self.count else '0'

## The digits of `magnitude` in `base` (2, 8, 10 or 16), lower case.
func integer_digits(magnitude: u64, base: u64) -> Decimal:
    var d: Decimal = ---
    var reversed: u8[64] = ---
    var n: usize = 0
    var v = magnitude
    while true:
        let digit = (u8)(v % base)
        reversed[n] = '0' + digit if digit < 10 else 'a' + digit - 10
        n += 1
        v = v // base
        if v == 0:
            break
    d.count = n
    d.point = (i64)n
    var i: usize = 0
    while i < n:
        d.digits[i] = reversed[n - 1 - i]
        i += 1
    return d

## The digits of |value|, finite: the significand times a power of two, made decimal in
## limbs of 10^9 exactly (multiplying by 2^k, or by 5^k for a negative exponent).
func exact(value: f64) -> Decimal:
    var d: Decimal = ---
    d.count = 0
    d.point = 0
    let bits = value.bits()
    let exponent_bits = (i64)((bits >> 52) & 0x7FF)
    var significand = bits & 0xFFFFFFFFFFFFF
    var exponent: i64 = -1074
    if exponent_bits != 0:
        significand = significand | 0x10000000000000
        exponent = exponent_bits - 1075
    if significand == 0:
        d.digits[0] = '0'
        d.count = 1
        d.point = 1
        return d
    var limbs: u64[100] = ---
    limbs[0] = significand % 1000000000
    limbs[1] = significand // 1000000000
    var used: usize = 2 if limbs[1] != 0 else 1
    if exponent >= 0:
        var left = exponent
        while left > 0:
            let shift = left if left < 30 else 30
            used = multiply(limbs, used, (u64)1 << (u64)shift)
            left -= shift
    else:
        var left = -exponent
        while left > 0:
            let step = left if left < 13 else 13
            var factor: u64 = 1
            for _ in 0..<step:
                factor *= 5
            used = multiply(limbs, used, factor)
            left -= step
    # the top limb without leading zeros, every other one as nine digits
    var top: u8[9] = ---
    var n: usize = 0
    var high = limbs[used - 1]
    while high > 0:
        top[n] = '0' + (u8)(high % 10)
        high = high // 10
        n += 1
    while n > 0:
        n -= 1
        d.digits[d.count] = top[n]
        d.count += 1
    var i = used - 1
    while i > 0:
        i -= 1
        var limb = limbs[i]
        var k: usize = 9
        while k > 0:
            k -= 1
            d.digits[d.count + k] = '0' + (u8)(limb % 10)
            limb = limb // 10
        d.count += 9
    d.point = (i64)d.count + (exponent if exponent < 0 else 0)
    trim_zeros(&d)
    return d

## `limbs[..<used] *= factor`, factor at most 2^30; the limbs now used.
func multiply(limbs: u64[], used: usize, factor: u64) -> usize:
    var carry: u64 = 0
    var i: usize = 0
    while i < used:
        let product = limbs[i] * factor + carry
        limbs[i] = product % 1000000000
        carry = product // 1000000000
        i += 1
    var n = used
    while carry > 0:
        limbs[n] = carry % 1000000000
        carry = carry // 1000000000
        n += 1
    return n

func trim_zeros(d: Decimal*):
    while d.count > 1 and d.digits[d.count - 1] == '0':
        d.count -= 1

## Keep the first `keep` digits, rounding half to even on the exact value; `keep` may be 0
## or less, which leaves zero (`count` 0) or one digit carried up.
func round_to(d: Decimal*, keep: i64):
    if keep >= (i64)d.count:
        return
    var up = false
    if keep >= 0:
        let next = d.digits[(usize)keep]
        var beyond = false
        var i = (usize)keep + 1
        while i < d.count:
            if d.digits[i] != '0':
                beyond = true
            i += 1
        let odd = keep > 0 and ((d.digits[(usize)keep - 1] - '0') % 2) == 1
        up = next > '5' or (next == '5' and (beyond or odd))
    if keep <= 0:
        d.count = 0
        if up:
            d.digits[0] = '1'
            d.count = 1
            d.point += 1
        return
    d.count = (usize)keep
    if up:
        var i = d.count
        var carried = true
        while carried and i > 0:
            i -= 1
            if d.digits[i] == '9':
                d.digits[i] = '0'
            else:
                d.digits[i] += 1
                carried = false
        if carried:
            # every kept digit was 9: one digit, a 1, a place higher
            d.digits[0] = '1'
            d.count = 1
            d.point += 1
    trim_zeros(d)
    if d.count == 1 and d.digits[0] == '0':
        d.count = 0

## The exact decimal digits of finite |value| rounded half to even to `places` after the
## point (before it, for a negative `places`), as dtoa's mode 3 makes them for Python's
## `round(x, places)`: no trailing zero, zero as `0` at point 1, and no digit at all, at
## point `-places`, when the rounding leaves nothing.
pub func decimal_places(value: f64, places: i64) -> Decimal:
    return digits_of(value, 3, places)

## dtoa's mode 2 (`n` significant digits) or mode 3 (`n` digits after the point, any sign)
## of a finite |value|: rounded half to even, no trailing zero, zero as `0` at point 1, and
## nothing left at point `-n` when mode 3 rounds it all away.
func digits_of(value: f64, mode: u8, n: i64) -> Decimal:
    var d = exact(value)
    if d.count == 1 and d.digits[0] == '0':
        return d
    if mode == 2:
        round_to(&d, n if n > 1 else 1)
    else:
        round_to(&d, d.point + n)
        if d.count == 0:
            d.point = -n
    return d

# mark: Numbers ================================================================================

## A number to lay out: its sign, a base's prefix, the digits `[first, last)` of `digits`
## with the point before index `point` (shown when `dot`), and what follows them, an
## exponent, `%`, or the scalar a `c` field names.
struct Number:
    var negative: bool
    var prefix: str
    var digits: Decimal
    var first: i64
    var point: i64
    var last: i64
    var dot: bool
    var rest: u8[8]
    var rest_length: usize

## The digits a group of `interval` with zeros reaching `least` scalars make, CPython's
## _PyUnicode_InsertThousandsGrouping: `n` digits, at least as many as reach `least` with a
## separator between each group; no groups when `interval` is 0.
func padded_digits(n: i64, least: i64, interval: i64) -> i64:
    var count = n if n > 0 else 1
    if interval == 0:
        return larger(count, least)
    while count + (count - 1) // interval < least:
        count += 1
    return count

## A number laid out as CPython's calc_number_widths and fill_number lay it out:
## `[padding] sign prefix [padding] grouped-digits [point] rest [padding]`. `spec` is settled.
func lay_number(sink: Sink, n: Number*, spec: Spec, upper: bool) -> bool:
    var sign: u8 = 0
    if spec.sign == '+':
        sign = '-' if n.negative else '+'
    elif spec.sign == ' ':
        sign = '-' if n.negative else ' '
    elif n.negative:
        sign = '-'
    let rest = n.rest[..<n.rest_length]
    let fraction = n.last - n.point if n.last > n.point else 0
    let fixed = (1 if sign != 0 else 0) + (i64)n.prefix.length + (1 if n.dot else 0) + fraction + scalar_count(rest)
    let least = spec.width - fixed if spec.fill == "0" and spec.align == '=' else 0
    let interval: i64 = 0 if spec.grouping == 0 else (4 if spec.kind == 'b' or spec.kind == 'o' or spec.kind == 'x' or spec.kind == 'X' else 3)
    let whole = n.point - n.first
    # a `c` field has no digits, only the scalar it names
    let count = padded_digits(whole, least, interval) if whole > 0 or n.rest_length == 0 or n.dot else 0
    let body = count + ((count - 1) // interval if interval > 0 and count > 0 else 0)
    let spare = spec.width - (fixed + body)
    var before: i64 = 0
    var between: i64 = 0
    var after: i64 = 0
    if spare > 0:
        if spec.align == '<':
            after = spare
        elif spec.align == '^':
            before = spare // 2
            after = spare - before
        elif spec.align == '=':
            between = spare
        else:
            before = spare
    if not repeat(sink, spec.fill, before):
        return false
    if sign != 0 and not put_byte(sink, sign):
        return false
    if not put_cased(sink, n.prefix.bytes, upper) or not repeat(sink, spec.fill, between):
        return false
    # the whole part's digits, the leftmost `count - whole` of them padding zeros
    var k: i64 = 0
    while k < count:
        if interval > 0 and k > 0 and (count - k) % interval == 0 and not put_byte(sink, spec.grouping):
            return false
        let digit = n.digits.at(n.point - count + k) if k >= count - whole else '0'
        if not put_byte(sink, digit - 32 if upper and digit >= 'a' and digit <= 'z' else digit):
            return false
        k += 1
    if n.dot and not put_byte(sink, '.'):
        return false
    var i = n.point
    while i < n.last:
        if not put_byte(sink, n.digits.at(i)):
            return false
        i += 1
    return put_cased(sink, rest, upper) and repeat(sink, spec.fill, after)

## A number with no digits yet: positive, no prefix, nothing after.
func number(digits: Decimal) -> Number:
    return Number(negative = false, prefix = "", digits = digits, first = 0, point = digits.point, last = digits.point, dot = false, rest = [0, 0, 0, 0, 0, 0, 0, 0], rest_length = 0)

## `bytes` after the digits of `n`.
func add_rest(n: Number*, bytes: const u8[]):
    for b in bytes:
        if n.rest_length < 8:
            n.rest[n.rest_length] = b
            n.rest_length += 1

## An integer field `{value:spec}`, its sign apart from its magnitude, laid out by
## `specification`. A `c` field of a number that names no Unicode scalar traps.
pub func lay_integer(sink: Sink, negative: bool, magnitude: u64, specification: str) -> bool:
    let spec = settled(specification, true)
    if spec.kind == 'c':
        if not is_scalar(negative, magnitude):
            trap("a `c` field's number names no Unicode scalar")
        var n = number(integer_digits(0, 10))
        n.first = n.point
        var buffer: u8[4]
        add_rest(&n, encode_scalar((u32)magnitude, buffer))
        return lay_number(sink, &n, spec, false)
    var base: u64 = 10
    var prefix = ""
    if spec.kind == 'b':
        base = 2
        prefix = "0b"
    elif spec.kind == 'o':
        base = 8
        prefix = "0o"
    elif spec.kind == 'x' or spec.kind == 'X':
        base = 16
        prefix = "0x"
    var n = number(integer_digits(magnitude, base))
    n.negative = negative
    if spec.alternate:
        n.prefix = prefix
    return lay_number(sink, &n, spec, spec.kind == 'X')

## Whether the integer of `negative` and `magnitude` names a Unicode scalar, as a `c`
## field's number must: from 0 to U+10FFFF, not a surrogate. A caller that must not trap
## asks before laying a `c` field out.
pub func is_scalar(negative: bool, magnitude: u64) -> bool:
    return not negative and magnitude <= 0x10FFFF and (magnitude < 0xD800 or magnitude > 0xDFFF)

## The UTF-8 of scalar `value` in `buffer`, which holds four bytes.
pub func encode_scalar(value: u32, buffer: u8[]) -> const u8[]:
    if value < 0x80:
        buffer[0] = (u8)value
        return buffer[..<1]
    if value < 0x800:
        buffer[0] = (u8)(0xC0 | (value >> 6))
        buffer[1] = (u8)(0x80 | (value & 0x3F))
        return buffer[..<2]
    if value < 0x10000:
        buffer[0] = (u8)(0xE0 | (value >> 12))
        buffer[1] = (u8)(0x80 | ((value >> 6) & 0x3F))
        buffer[2] = (u8)(0x80 | (value & 0x3F))
        return buffer[..<3]
    buffer[0] = (u8)(0xF0 | (value >> 18))
    buffer[1] = (u8)(0x80 | ((value >> 12) & 0x3F))
    buffer[2] = (u8)(0x80 | ((value >> 6) & 0x3F))
    buffer[3] = (u8)(0x80 | (value & 0x3F))
    return buffer[..<4]

# mark: Floats =================================================================================

## A float field `{value:spec}` laid out by `specification`; `single` when the
## value is an `f32` (or an `f16`), whose display is its own shortest digits. With neither a
## type nor a precision a field shows the value's display, where Python shows its repr.
pub func lay_float(sink: Sink, value: f64, single: bool, specification: str) -> bool:
    let spec = settled(specification, true)
    var x = value
    var kind = spec.kind
    var percent = false
    if kind == '%':
        x = x * 100.0
        kind = 'f'
        percent = true
    var n = number(integer_digits(0, 10))
    if kind == 0 and spec.precision < 0:
        displayed(&n, x, single, spec.no_negative_zero)
    else:
        short(&n, x, kind, spec.precision if spec.precision >= 0 else 6, spec.alternate, spec.no_negative_zero)
    if percent:
        add_rest(&n, "%".bytes)
    return lay_number(sink, &n, spec, kind == 'E' or kind == 'F' or kind == 'G')

## The display of `value` (§14.4) as a number to lay out: its digits up to the point, the
## point, and the rest (more digits, an exponent) as they are.
func displayed(n: Number*, value: f64, single: bool, no_negative_zero: bool):
    var shown: u8[40] = ---
    let length = float_text.display_f32((f32)value, shown) if single else float_text.display_f64(value, shown)
    var at: usize = 0
    if shown[0] == '-':
        n.negative = not (no_negative_zero and value == 0.0)
        at = 1
    var d: Decimal = ---
    d.count = 0
    while at < length and shown[at] >= '0' and shown[at] <= '9':
        d.digits[d.count] = shown[at]
        d.count += 1
        at += 1
    d.point = (i64)d.count
    if at < length and shown[at] == '.':
        at += 1
        while at < length and shown[at] >= '0' and shown[at] <= '9':
            d.digits[d.count] = shown[at]
            d.count += 1
            at += 1
        n.dot = true
    n.digits = d
    n.first = 0
    n.point = d.point
    n.last = (i64)d.count
    # `inf`, `nan` and an exponent follow the digits as they are
    add_rest(n, shown[at..<length])

## `e`, `f`, `g` (and the upper ones) of `value` with `precision`, as CPython's
## PyOS_double_to_string and format_float_short write them: `-` for a negative value,
## `inf` and `nan` for the specials.
func short(n: Number*, value: f64, kind: u8, precision: i64, alternate: bool, no_negative_zero: bool):
    let upper = kind == 'E' or kind == 'F' or kind == 'G'
    var code = kind + 32 if upper else kind
    var add_dot = false
    var p = precision
    if code == 0:
        # a precision without a type: `g`, a point always kept (CPython's 'r' with one)
        code = 'g'
        add_dot = true
    var negative = value < 0.0 or (value == 0.0 and (value.bits() >> 63) != 0)
    if value != value or infinite(value):
        n.negative = negative and value == value
        n.first = n.point
        add_rest(n, "nan".bytes if value != value else "inf".bytes)
        return
    var mode: u8 = 2
    if code == 'e':
        p += 1
    elif code == 'f':
        mode = 3
    elif p == 0:
        p = 1
    let d = digits_of(value, mode, p)
    if no_negative_zero and (d.count == 0 or (d.count == 1 and d.digits[0] == '0')):
        negative = false
    var point = d.point
    var end = (i64)d.count
    var use_exponent = false
    if code == 'e':
        use_exponent = true
        end = p
    elif code == 'f':
        end = point + p
    else:
        if point <= -4 or point > (p - 1 if add_dot else p):
            use_exponent = true
        if alternate:
            end = p
    var exponent: i64 = 0
    if use_exponent:
        exponent = point - 1
        point = 1
    let start = point - 1 if point <= 0 else 0
    if not use_exponent and add_dot:
        end = end if end > point else point + 1
    else:
        end = end if end > point else point
    n.negative = negative
    n.digits = d
    n.first = start
    n.point = point
    n.last = end
    n.dot = point < end or alternate
    if use_exponent:
        add_rest(n, "e".bytes)
        add_rest(n, "-".bytes if exponent < 0 else "+".bytes)
        let magnitude = (u64)(-exponent if exponent < 0 else exponent)
        let e = integer_digits(magnitude, 10)
        if magnitude < 10:
            add_rest(n, "0".bytes)
        add_rest(n, e.digits[..<e.count])

## Whether `x` is an infinity (a NaN is told apart by `x != x`).
func infinite(x: f64) -> bool:
    return x == x and ((x.bits() >> 52) & 0x7FF) == 0x7FF

# mark: Text ===================================================================================

## A text field `{value:spec}`, `shown` being its display, laid out by `specification`: precision keeps that many scalars, and the width pads it (CPython's
## format_string_internal).
pub func lay_text(sink: Sink, shown: str, specification: str) -> bool:
    let spec = settled(specification, false)
    var view = shown.bytes
    var n = scalar_count(view)
    if spec.precision >= 0 and n > spec.precision:
        view = scalar_prefix(view, spec.precision)
        n = spec.precision
    let (before, after) = padding(n, spec.width, spec.align)
    return repeat(sink, spec.fill, before) and put(sink, view) and repeat(sink, spec.fill, after)

## The first `n` scalars of `bytes`, viewing them.
func scalar_prefix(bytes: const u8[], n: i64) -> const u8[]:
    var seen: i64 = 0
    var i: usize = 0
    while i < bytes.length:
        if (bytes[i] & 0xC0) != 0x80:
            if seen == n:
                return bytes[..<i]
            seen += 1
        i += 1
    return bytes
"""

## The text of `src/std/core.lucb`.
let text_6: str = r"""#==============================================================================================
#
#   core - The compiler's runtime support
#
#   DESCRIPTION:
#       The runtime the compiler emits calls to: startup and thread identity, the `format` and
#       f-string buffer, integer and boolean formatting, hashing, and the checked, saturating
#       and converting integer arithmetic.
#
#==============================================================================================

from windows_abi import WideCharToMultiByte
import c
import float_text
import platform
import memory
import strings
extern func set_binary_mode as "_setmode"(descriptor: i32, mode: i32) -> i32
extern func GetCurrentThreadId() -> u32
var initial_thread: u32

## Whether the caller is the process's initial thread.
pub func on_initial_thread() -> bool:
    if platform.windows:
        return initial_thread != 0 and GetCurrentThreadId() == initial_thread
    return false

## Standard streams carry language bytes, including LF, without CRT text translation.
pub func process_start():
    if platform.windows:
        initial_thread = GetCurrentThreadId()
        _ = set_binary_mode(0, 32768)
        _ = set_binary_mode(1, 32768)
        _ = set_binary_mode(2, 32768)

extern func posix_write as "write"(descriptor: i32, buffer: const void*, count: usize) -> isize
extern func windows_write as "_write"(descriptor: i32, buffer: const void*, count: u32) -> i32

func write(descriptor: i32, buffer: const void*, count: usize) -> isize:
    if platform.windows:
        return (isize)windows_write(descriptor, buffer, (u32)(count if count < 2147483647 else 2147483647))
    return posix_write(descriptor, buffer, count)

extern func c_exit as "exit"(code: i32) -> never
extern func malloc(size: usize) -> void*?
extern func realloc(block: void*?, size: usize) -> void*?
extern func c_free as "free"(block: void*?)
extern func memcpy(target: void*, source: const void*, count: usize) -> void*
extern func memmove(target: void*, source: const void*, count: usize) -> void*
extern func memcmp(a: const void*, b: const void*, count: usize) -> i32
extern func strlen(text: c.str) -> usize

## Stop the program with its reason on stderr (§8.7).
pub func trap(message: c.str) -> never:
    begin_trap()
    write_diagnostic("trap: ".bytes)
    write_diagnostic(((str)message).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## `trap: file:line:column: message`: a trap naming the statement it stopped at (§11.5).
pub func trap_at(position: c.str, message: c.str) -> never:
    diagnostic_location(position)
    write_diagnostic(((str)message).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Positioned diagnostic with NUL-terminated C strings. Base assertions use
## trap_detail_at so their message spans retain their explicit lengths.
pub func trap_two_at(position: c.str, message: c.str, detail: c.str) -> never:
    diagnostic_location(position)
    write_diagnostic(((str)message).bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(((str)detail).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Unpositioned diagnostic with NUL-terminated C strings.
pub func trap_two(message: c.str, detail: c.str) -> never:
    begin_trap()
    write_diagnostic("trap: ".bytes)
    write_diagnostic(((str)message).bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(((str)detail).bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## Fatal diagnostic for a Base string. Its explicit byte length permits slices,
## empty values and embedded NUL; no byte beyond the view is read.
pub func trap_text_at(position: c.str, message: str) -> never:
    diagnostic_location(position)
    write_diagnostic(message.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## `trap(f"...")` streams its message (`stream_put`), so a message longer than a format
## buffer is whole: the location first, then the message to descriptor 2, then `trap_end`.
pub func trap_begin_at(position: c.str):
    diagnostic_location(position)

## The end of a streamed trap message, whose newline the stream wrote: the report, and
## the exit.
pub func trap_end() -> never:
    finish_trap()

## Assertion prefix plus a Base string detail, preserving the detail's length.
pub func trap_detail_at(position: c.str, message: c.str, detail: str) -> never:
    diagnostic_location(position)
    let prefix = (str)message
    write_diagnostic(prefix.bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(detail.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## A trap at a position given as Base text, none when it is empty: how the value
## language's runtime and its interpreter stop.
pub func trap_located(position: str, message: str) -> never:
    begin_trap()
    write_diagnostic("trap: ".bytes)
    if position.length > 0:
        write_diagnostic(position.bytes)
        write_diagnostic(": ".bytes)
    write_diagnostic(message.bytes)
    write_diagnostic("\n".bytes)
    finish_trap()

## `trap: file:line:column: `, or `trap: ` when the position is empty (a C build's code
## before its first statement).
func diagnostic_location(position: c.str):
    begin_trap()
    write_diagnostic("trap: ".bytes)
    let location = (str)position
    if location.length > 0:
        write_diagnostic(location.bytes)
        write_diagnostic(": ".bytes)

## Panic reporting cannot raise another language error. The diagnostic goes to
## stderr and, when crash reports are on, to the report as well.
func write_diagnostic(data: const u8[]):
    write_all(2, data)
    if crash_file >= 0:
        write_all(crash_file, data)

## Retry interruptions and short writes; stop on a terminal write failure or lack of progress.
func write_all(descriptor: i32, data: const u8[]):
    var written: usize = 0
    while written < data.length:
        let remaining = data.length - written
        let count = remaining if remaining < 1073741824 else 1073741824
        let result = write(descriptor, data[written..].data, count)
        if result < 0 and c.errno() == c.interrupted:
            continue
        if result <= 0:
            return
        written += (usize)result

# mark: Crash reports ==========================================================================

extern func posix_open as "open"(path: c.str, flags: i32, ...) -> i32
extern func windows_open as "_open"(path: c.str, flags: i32, ...) -> i32
extern func posix_close as "close"(descriptor: i32) -> i32
extern func windows_close as "_close"(descriptor: i32) -> i32
extern func backtrace(frames: void**, size: i32) -> i32
extern func backtrace_symbols_fd(frames: const void**, size: i32, descriptor: i32)
extern func RtlCaptureStackBackTrace(skip: u32, count: u32, frames: void**, hash: u32*?) -> u16
extern func GetModuleHandleExA(flags: u32, address: const void*, module: void**) -> i32
extern func GetModuleFileNameA(module: void*, name: u8*, size: u32) -> u32
extern func c_quick_exit as "_exit"(code: i32) -> never
extern func dladdr(address: const void*, info: DlInfo*) -> i32
extern func getcontext(context: void*) -> i32
extern func RtlLookupFunctionEntry(pc: u64, image_base: u64*, history: void*?) -> void*?
extern func RtlVirtualUnwind(kind: u32, image_base: u64, pc: u64, entry: void*, context: void*, handler_data: void**, establisher: u64*, pointers: void*?) -> void*?

## `Dl_info`: the module and nearest symbol `dladdr` finds for an address.
extern struct DlInfo:
    file: c.str?
    base: usize
    symbol: c.str?
    start: usize

## Where a crash report goes, NUL-terminated, and what it starts with; empty when
## reports are off. `std.crash` fills them; a trap or fatal signal writes them.
var crash_path: u8[1024]
var crash_header: u8[1024]
var crash_header_length: usize = 0
var crash_file: i32 = -1
## Set while a report walks frame pointers: a fault then is the walk's own, at a
## frame it could not read, and the report ends there.
var crash_walking: bool = false
## Where `getcontext` puts the registers of a trap on Linux: more than any
## `ucontext_t` needs, as words so it is aligned.
var crash_registers: usize[1024]
## A Windows fault's CONTEXT, copied so it can be unwound in place: 1232 bytes
## that must start on 16, with room to move them there.
var crash_windows_context: u8[1280]
## The interrupted context of the fatal signal being reported, when there is one.
var crash_context: const void*? = none
## Whether this process has written a report: a later trap, one in a crash handler,
## is added to it rather than replacing it.
var crash_reported: bool = false
## What runs once a report is written, before the process ends (`set_crash_handler`).
var crash_handler: (func(i32) -> unit)? = none

## Turn crash reports on: a trap from now on also writes `header` and the trap
## to the file at `path` (created then, replaced if present), with a native
## stack where the platform gives one. Paths or headers too long are cut.
pub func set_crash_report(path: str, header: str):
    let length = path.length if path.length < crash_path.length - 1 else crash_path.length - 1
    for index in 0..<length:
        crash_path[index] = path.bytes[index]
    crash_path[length] = 0
    let header_length = header.length if header.length < crash_header.length else crash_header.length
    for index in 0..<header_length:
        crash_header[index] = header.bytes[index]
    crash_header_length = header_length

## Whether crash reports are on.
pub func crash_reports_enabled() -> bool:
    return crash_path[0] != 0

## Run `handler` once a crash report is written, before the process ends: with 0 after
## a trap, on the thread that trapped, where the program may still do ordinary work;
## with the signal's number after a fatal signal, inside the signal handler, where only
## async-signal-safe calls are allowed. The process ends when the handler returns. A
## trap inside the handler is added to the report and runs the handler again.
pub func set_crash_handler(handler: (func(i32) -> unit)?):
    crash_handler = handler

## Open the report, if reports are on and it is not open yet, and write its header.
## The start of every trap and fatal signal: the running test, if any, named as failed
## (§16.5), then the crash report opened.
func begin_trap():
    if test_running.length > 0:
        write_all(1, "FAIL  ".bytes)
        write_all(1, test_running.bytes)
        write_all(1, "\n".bytes)
    begin_crash_report()

## The end of a trap or fatal signal inside a test: the test counted as failed and the
## tally of the tests run so far printed, since the run ends here (§16.5).
func end_trapped_test():
    if test_running.length == 0:
        return
    test_running = ""
    tests_failed += 1
    _ = test_summary()

func begin_crash_report():
    if crash_file >= 0 or crash_path[0] == 0:
        return
    let path = (c.str)&crash_path[0]
    # write, create, and truncate the first time; append after
    if platform.windows:
        crash_file = windows_open(path, 1 | 256 | (8 if crash_reported else 512) | 32768, 420)
    elif platform.macos:
        crash_file = posix_open(path, 1 | 512 | (8 if crash_reported else 1024), 420)
    else:
        crash_file = posix_open(path, 1 | 64 | (1024 if crash_reported else 512), 420)
    if crash_file < 0:
        return
    if crash_reported:
        write_all(crash_file, "\n(and while the program handled that crash)\n".bytes)
    else:
        write_all(crash_file, crash_header[..<crash_header_length])
    crash_reported = true

## Finish a trap: the stack into the report, close it, the crash handler, and exit.
func finish_trap() -> never:
    end_trapped_test()
    finish_crash_report(trap_registers())
    if let handler = crash_handler:
        handler(0)
    c_exit(1)

## Where a fault left the program: its instruction, its frame pointer and, on
## arm64, its link register; zeros where they are not known.
pub struct FaultRegisters:
    ## The faulting instruction.
    pub var pc: usize = 0
    ## The frame pointer at the fault: the start of the frame chain.
    pub var fp: usize = 0
    ## The link register (arm64): the caller of a function that made no frame.
    pub var lr: usize = 0

## Write the stack into the report and close it: walked from `at` when it has a
## frame pointer, else as the platform's own backtrace gives it.
func finish_crash_report(at: FaultRegisters):
    if crash_file < 0:
        return
    write_all(crash_file, "\nstack:\n".bytes)
    var unwound = false
    if platform.windows:
        if let context = crash_context:
            write_windows_unwound(crash_file, context)
            unwound = true
    if unwound:
        close_crash_report()
        return
    if at.fp != 0:
        write_walked_stack(crash_file, at)
    elif platform.posix:
        # Pointer-sized slots: the addresses backtrace fills in.
        var frames: usize[64]
        let depth = backtrace((void**)&frames[0], 64)
        if depth > 0:
            backtrace_symbols_fd((const void**)&frames[0], depth, crash_file)
    elif platform.windows:
        write_windows_stack(crash_file)
    close_crash_report()

func close_crash_report():
    if platform.windows:
        _ = windows_close(crash_file)
    else:
        _ = posix_close(crash_file)
    crash_file = -1

## A trap's own registers on Linux, where `backtrace` needs unwind tables the
## native backend leaves out of release builds; zeros elsewhere (macOS's
## backtrace follows frame pointers, Windows' the SEH tables).
func trap_registers() -> FaultRegisters:
    if platform.linux:
        if getcontext((void*)&crash_registers[0]) != 0:
            return FaultRegisters()
        return context_registers((const void*)&crash_registers[0])
    else:
        return FaultRegisters()

# mark: Walking frame pointers =================================================================

## The registers in a signal's `ucontext_t` (or `getcontext`'s), or in a Windows
## `CONTEXT` record. Offsets are each platform's C layout.
func context_registers(context: const void*) -> FaultRegisters:
    let base = (const u8*)context
    if platform.windows:
        return FaultRegisters(pc = word_at(base, 248), fp = word_at(base, 160))
    elif platform.linux and platform.x86_64:
        # uc_mcontext.gregs at 40: RIP is register 16, RBP 10.
        return FaultRegisters(pc = word_at(base, 168), fp = word_at(base, 120))
    elif platform.macos:
        # uc_mcontext is a pointer at 48, to the exception state (16 bytes) and the thread state.
        let machine = (const u8*)(const void*)word_at(base, 48)
        if platform.arm64:
            return FaultRegisters(pc = word_at(machine, 272), fp = word_at(machine, 248), lr = word_at(machine, 256))
        else:
            return FaultRegisters(pc = word_at(machine, 144), fp = word_at(machine, 64))
    else:
        return FaultRegisters()

func word_at(base: const u8*, offset: usize) -> usize:
    return ((const usize*)(const void*)(base + offset))[0]

## Every frame from `at`: the faulting instruction, the link register on arm64
## (a leaf keeps its caller there), then each saved return address up the
## chain of frame records, which the native backend keeps in every function.
## A record that does not climb the stack ends the walk; one that cannot be
## read faults, and `report_fatal_signal_in` ends the report there.
func write_walked_stack(file: i32, at: FaultRegisters):
    var frames: usize[64] = ---
    var depth: usize = 0
    if at.pc != 0:
        frames[0] = at.pc
        depth = 1
    # The link register is the caller only when the faulting function made no
    # frame of its own; otherwise it is a stale return inside it. Marked so.
    var link: usize = 64
    if at.lr != 0 and at.lr != at.pc:
        link = depth
        frames[depth] = at.lr
        depth += 1
    var frame = at.fp
    crash_walking = true
    while depth < 64 and frame != 0 and frame % 8 == 0:
        let record = (const usize*)(const void*)frame
        let caller = record[1]
        let next = record[0]
        if caller == 0:
            break
        if depth == 0 or caller != frames[depth - 1]:
            frames[depth] = caller
            depth += 1
        if next <= frame or next - frame > 16777216:
            break
        frame = next
    crash_walking = false
    for index in 0..<depth:
        write_frame(file, index, frames[index], index == link)

## Windows: unwind a copy of the fault's CONTEXT a frame at a time through the
## SEH tables the native backend emits (its frame pointer sits below each
## frame's locals, so there are no frame records to follow). A function with no
## table entry is a leaf, whose return address is at the stack pointer.
func write_windows_unwound(file: i32, context: const void*):
    if platform.windows:
        let start = (usize)(const void*)&crash_windows_context[0]
        let copy = &crash_windows_context[(16 - start % 16) % 16]
        _ = memcpy(copy, context, 1232)
        var frames: usize[64] = ---
        var depth: usize = 0
        crash_walking = true
        while depth < 64:
            let pc = word_at(copy, 248)
            let sp = word_at(copy, 152)
            if pc == 0:
                break
            frames[depth] = pc
            depth += 1
            var base: u64 = 0
            if let entry = RtlLookupFunctionEntry((u64)pc, &base, none):
                var data: void* = ---
                var establisher: u64 = 0
                _ = RtlVirtualUnwind(0, base, (u64)pc, entry, (void*)copy, &data, &establisher, none)
            else:
                put_word(copy, 248, ((const usize*)(const void*)sp)[0])
                put_word(copy, 152, sp + 8)
            if word_at(copy, 152) <= sp:
                break
        crash_walking = false
        for index in 0..<depth:
            write_frame(file, index, frames[index], false)

func put_word(base: u8*, offset: usize, value: usize):
    ((usize*)(void*)(base + offset))[0] = value

## One frame's line: its number, address, module and offset in it (for
## addr2line or atos), and the nearest symbol where the platform names one.
func write_frame(file: i32, index: usize, address: usize, link: bool):
    var line: u8[640] = ---
    var used: usize = 0
    line[0] = '#'
    used = put_decimal(line, 1, index)
    line[used] = ' '
    if link:
        used = put_text(line, used + 1, "lr")
        line[used] = ' '
    used = put_hex(line, used + 1, address)
    line[used] = ' '
    used += 1
    if platform.windows:
        used = put_windows_module(line, used, address)
    elif platform.posix:
        var info: DlInfo = ---
        info.file = none
        info.symbol = none
        if dladdr((const void*)address, &info) != 0:
            if let file_name = info.file:
                used = put_base_name(line, used, (str)file_name)
            line[used] = '+'
            used = put_hex(line, used + 1, address - info.base)
            if let symbol = info.symbol:
                line[used] = ' '
                used = put_text(line, used + 1, (str)symbol)
                line[used] = '+'
                used = put_hex(line, used + 1, address - info.start)
        else:
            line[used] = '?'
            used += 1
    line[used] = '\n'
    write_all(file, (const u8[])line[..<used + 1])

## The module holding `address` on Windows, as `name+0xoffset`, into `line` at `used`.
func put_windows_module(line: u8[], used: usize, address: usize) -> usize:
    if platform.windows:
        var module: void* = ---
        var name: u8[260] = ---
        # 4: from an address; 2: without changing the module's reference count
        if GetModuleHandleExA(6, (const void*)address, (void**)&module) == 0:
            line[used] = '?'
            return used + 1
        let length = GetModuleFileNameA(module, &name[0], 260)
        let at = put_base_name(line, used, (str)name[..<length])
        line[at] = '+'
        return put_hex(line, at + 1, address - (usize)module)
    else:
        return used

## The last component of `path` into `line` at `used`, cut to fit.
func put_base_name(line: u8[], used: usize, path: str) -> usize:
    var start: usize = 0
    for index in 0..<path.length:
        if path.bytes[index] == '/' or path.bytes[index] == '\\':
            start = index + 1
    return put_text(line, used, (str)path.bytes[start..])

## `text` into `line` at `used`, leaving room for what follows it.
func put_text(line: u8[], used: usize, text: str) -> usize:
    var at = used
    for byte in text.bytes:
        if at + 40 >= line.length:
            break
        line[at] = byte
        at += 1
    return at

## `value` in decimal into `line` at `used`; the new length.
func put_decimal(line: u8[], used: usize, value: usize) -> usize:
    var digits: u8[24] = ---
    var count: usize = 0
    var rest = value
    while true:
        digits[count] = (u8)('0' + (u8)(rest % 10))
        count += 1
        rest = rest // 10
        if rest == 0:
            break
    var at = used
    while count > 0:
        count -= 1
        line[at] = digits[count]
        at += 1
    return at

## The native stack on Windows, a frame a line as `module+0xoffset`, which a debugger or
## addr2line resolves against the build. Nothing here allocates.
func write_windows_stack(file: i32):
    # One branch on the platform around everything, which the C backend folds away
    # elsewhere: the Windows symbols then appear in no other platform's build.
    if platform.windows:
        write_all(file, "(the reporter's frames and Windows' exception dispatch come first; the fault is the\n first program frame after ntdll.dll. Offsets are from each module's load address;\n add the image base, 0x140000000 by default for a 64-bit program, for addr2line.)\n".bytes)
        var frames: usize[64]
        let depth = (usize)RtlCaptureStackBackTrace(0, 64, (void**)&frames[0], none)
        for index in 0..<depth:
            let address = frames[index]
            var line: u8[400] = ---
            var used: usize = 0
            var module: void* = ---
            var base: usize = 0
            var name: u8[260] = ---
            var length: u32 = 0
            # 4: from an address; 2: without changing the module's reference count
            if GetModuleHandleExA(6, (const void*)address, (void**)&module) != 0:
                base = (usize)module
                length = GetModuleFileNameA(module, &name[0], 260)
            var start: u32 = 0
            for at in 0..<length:
                if name[at] == '\\' or name[at] == '/': start = at + 1
            for at in start..<length:
                if used < 300:
                    line[used] = name[at]
                    used += 1
            if length == 0:
                line[used] = '?'
                used += 1
            line[used] = '+'
            used += 1
            used = put_hex(line, used, address - base)
            line[used] = '\n'
            used += 1
            write_all(file, (const u8[])line[..<used])

## `value` as `0x` and lowercase hex digits into `line` at `used`; the new length.
func put_hex(line: u8[], used: usize, value: usize) -> usize:
    var at = used
    line[at] = '0'
    line[at + 1] = 'x'
    at += 2
    var shift: usize = 60
    var started = false
    while true:
        let digit = (value >> shift) & 15
        if digit != 0 or started or shift == 0:
            started = true
            line[at] = "0123456789abcdef".bytes[digit]
            at += 1
        if shift == 0:
            break
        shift -= 4
    return at

## A fatal signal: report it as a trap would, then end with the signal's exit
## status. Only async-signal-safe calls are made from here on.
pub func report_fatal_signal(name: str, number: i32) -> never:
    report_fatal_signal_in(name, number, none)

## A fatal signal whose handler has the interrupted context (a POSIX
## `ucontext_t`, or a Windows `CONTEXT`): the stack is walked from where the
## fault happened rather than from the handler. A fault while the stack is
## walked ends the report at the frame that could not be read.
pub func report_fatal_signal_in(name: str, number: i32, context: const void*?) -> never:
    if crash_walking:
        crash_walking = false
        if crash_file >= 0:
            write_all(crash_file, "(the walk stopped at a frame it could not read)\n".bytes)
            close_crash_report()
        c_quick_exit(128 + number)
    begin_trap()
    write_diagnostic("trap: fatal signal ".bytes)
    write_diagnostic(name.bytes)
    write_diagnostic("\n".bytes)
    end_trapped_test()
    crash_context = context
    if let interrupted = context:
        finish_crash_report(context_registers(interrupted))
    else:
        finish_crash_report(FaultRegisters())
    if let handler = crash_handler:
        handler(number)
    c_quick_exit(128 + number)

## The buffer `format` and f"..." fill: the bytes, their capacity, and the count used.
pub struct FormatBuffer:
    ## The buffer's bytes.
    pub var data: u8*
    ## The buffer's capacity in bytes.
    pub var capacity: usize
    ## The number of bytes used.
    pub var used: usize
    ## What text past the capacity does: `format_fixed`, it is cut; `format_grows`, the
    ## text moves to the heap and goes on there; `format_grown`, it is on the heap.
    pub var growth: usize = 0

## A buffer of the caller's, as `format` fills: text past its capacity is cut.
pub let format_fixed: usize = 0
## A buffer the compiler made for a formatted argument (§5.5): it starts on the stack, moves
## to the heap when the text outgrows it, and is released once the call it feeds returns.
pub let format_grows: usize = 1
## A growing buffer whose text is on the heap, which `format_release` frees.
pub let format_grown: usize = 2

## Append `count` bytes; 1 when they do not fit: the bytes that fit are kept, and the buffer
## is then over capacity, which `format` reports and `format_finish` marks. A growing
## buffer makes room instead, and fails only when the heap has none.
pub func format_put(b: FormatBuffer*, text: const void*?, count: usize) -> i32:
    if b.used > b.capacity:
        return 1
    if count > b.capacity - b.used and not (b.growth != format_fixed and format_grow(b, b.used + count)):
        if let source = text:
            if b.capacity > b.used:
                _ = memcpy(&b.data[b.used], source, b.capacity - b.used)
        b.used = b.capacity +% 1
        return 1
    if let source = text:
        if count > 0:
            _ = memcpy(&b.data[b.used], source, count)
    b.used += count
    return 0

## Make room in a growing buffer for `need` bytes and the NUL `format_finish` puts after
## them, at least doubling it; false when the heap has no room.
func format_grow(b: FormatBuffer*, need: usize) -> bool:
    var size = b.capacity * 2
    if size <= need:
        size = need + 1
    if b.growth == format_grown:
        let moved = realloc(b.data, size) else return false
        b.data = (u8*)moved
    else:
        let fresh = malloc(size) else return false
        _ = memcpy(fresh, b.data, b.used)
        b.data = (u8*)fresh
        b.growth = format_grown
    b.capacity = size
    return true

## Free what a growing buffer took from the heap; its text is gone with it.
pub func format_release(b: FormatBuffer*):
    if b.growth == format_grown:
        c_free(b.data)
        b.growth = format_grows
        b.capacity = 0
        b.used = 0

## Append the decimal `value` to `b`; the bytes written.
pub func format_u64(b: FormatBuffer*, value: u64) -> i32:
    var digits: u8[24] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[23] = 48
        n = 1
    while v != 0:
        n += 1
        digits[24 - n] = (u8)(48 + v % 10)
        v = v // 10
    return format_put(b, &digits[24 - n], n)

## Append the decimal `value` to `b`; the bytes written.
pub func format_i64(b: FormatBuffer*, value: i64) -> i32:
    if value < 0:
        let minus = "-"
        if format_put(b, minus.bytes.data, 1) != 0:
            return 1
        return format_u64(b, 0 -% (u64)value)
    return format_u64(b, (u64)value)

## A float field (base.md §14): the shortest decimal that reads back as `value`, a `.0`
## after digits with no point (float_text.display_f64); both backends call this.
pub func format_f64(b: FormatBuffer*, value: f64) -> i32:
    var text: u8[40] = ---
    let n = float_text.display_f64(value, text[0..])
    return format_put(b, &text[0], n)

## format_f64 for an f32 (or an f16, widened): the f32's own shortest digits.
pub func format_f32(b: FormatBuffer*, value: f32) -> i32:
    var text: u8[40] = ---
    let n = float_text.display_f32(value, text[0..])
    return format_put(b, &text[0], n)

## Append `true` or `false` to `b`; the bytes written.
pub func format_bool(b: FormatBuffer*, value: bool) -> i32:
    let word = "true" if value else "false"
    return format_put(b, word.bytes.data, word.length)

## A `char` displays as itself, in UTF-8 (§14.4).
pub func format_char(b: FormatBuffer*, value: char) -> i32:
    let cp = u32(value)
    var out: u8[4]
    var n: usize = 0
    if cp < 0x80:
        out[0] = u8(cp)
        n = 1
    elif cp < 0x800:
        out[0] = u8(0xC0 | (cp >> 6))
        out[1] = u8(0x80 | (cp & 0x3F))
        n = 2
    elif cp < 0x10000:
        out[0] = u8(0xE0 | (cp >> 12))
        out[1] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[2] = u8(0x80 | (cp & 0x3F))
        n = 3
    else:
        out[0] = u8(0xF0 | (cp >> 18))
        out[1] = u8(0x80 | ((cp >> 12) & 0x3F))
        out[2] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[3] = u8(0x80 | (cp & 0x3F))
        n = 4
    return format_put(b, (const void*)&out, n)

## The text so far, NUL-terminated when there is room. Text over capacity is cut at a
## character boundary and ends in `...`, so a long f"..." is never silently empty.
pub func format_finish(b: FormatBuffer*) -> str:
    if b.used < b.capacity:
        b.data[b.used] = 0
    if b.used > b.capacity:
        if b.capacity < 3:
            return ""
        var end = b.capacity - 3
        while end > 0 and (b.data[end] & 0xC0) == 0x80:
            end -= 1
        b.data[end] = 46
        b.data[end + 1] = 46
        b.data[end + 2] = 46
        return (str)u8[](b.data, end + 3)
    return (str)u8[](b.data, b.used)

## The startup shim's pieces: the argument vector as `str[]` (checked) or `c.str[]`.
pub func arguments(count: i32, vector: c.str*) -> str[]:
    let raw = raw_arguments(count, vector)
    let n = raw.length
    let block = malloc((n if n > 0 else 1) * memory.size_of(str)) else trap("memory.exhausted")
    let items = (str*)block
    var i: usize = 0
    while i < n:
        let text = (str)raw[i]
        if not utf8_ok(text.bytes.data, text.length):
            trap("invalid_utf8")
        items[i] = text
        i += 1
    return str[](items, n)

## The process's arguments as a span of C strings.
pub func raw_arguments(count: i32, vector: c.str*) -> c.str[]:
    if platform.windows:
        return windows_arguments()
    return c.str[](vector, (usize)count)

extern func GetCommandLineW() -> u16*
extern func CommandLineToArgvW(command: u16*, count: i32*) -> u16**?
extern func LocalFree(block: void*) -> void*?
extern func atexit(callback: func() -> unit) -> i32
var windows_argument_vector: c.str[]

func free_windows_arguments():
    for text in windows_argument_vector:
        c_free((void*)text)
    c_free((void*)windows_argument_vector.data)

## The wide command line preserves names the Windows ANSI code page cannot encode.
func windows_arguments() -> c.str[]:
    if platform.windows:
        if windows_argument_vector.length > 0:
            return windows_argument_vector
        var count: i32 = 0
        let wide = CommandLineToArgvW(GetCommandLineW(), &count) else trap("could not read the Windows command line")
        defer _ = LocalFree((void*)wide)
        let block = malloc((usize)count * memory.size_of(c.str)) else trap("memory.exhausted")
        let items = (c.str*)block
        for index in 0..<(usize)count:
            let size = WideCharToMultiByte(65001, 128, wide[index], -1, none, 0, none, none)
            if size <= 0: trap("the command line contains invalid UTF-16")
            let text = malloc((usize)size) else trap("memory.exhausted")
            if WideCharToMultiByte(65001, 128, wide[index], -1, (u8*)text, size, none, none) != size:
                trap("could not encode the command line as UTF-8")
            items[index] = (c.str)text
        windows_argument_vector = c.str[](items, (usize)count)
        if atexit(free_windows_arguments) != 0:
            trap("could not register command line cleanup")
        return windows_argument_vector
    return c.str[]((c.str*)0, 0)

## The error of the fallible call that failed last on this thread, as the native backends
## pass it: a failing function leaves its error here and returns its flag set, and `try`
## passes the flag up with the error left where it is (§11.2's representation).
pub local var failure: Error

# mark: Messages in flight ==================================================================
#
# `error(code, message)` copies a message that is not a literal here, so the message stays
# readable after the cleanup the failure runs has freed what it was made from (§11.3). The
# room is a stack: a handler that finishes gives back its error's message and everything
# raised after it (`message_handled`), and a failure that leaves a handler takes the place of
# the handled message (`message_raised`'s `replaces`). A message that does not fit above the
# top starts the room again at its beginning, so the room never grows and never allocates.

## The room for the messages of the errors in flight on this thread, and its first free byte.
local var raised_room: u8[16384]
local var raised_top: usize = 0

## The longest message the room keeps: a longer one is cut at a character and ends in `…`.
let raised_most: usize = 4096

## Where `text` starts in this thread's room, or `none` when it lies elsewhere.
func in_room(text: str) -> usize?:
    let base = (usize)&raised_room[0]
    let at = (usize)text.bytes.data
    if at < base or at > base + raised_room.length or text.length > base + raised_room.length - at:
        return none
    return at - base

## The message of an error being raised, copied into this thread's room: a copy that lives
## until the handler that catches the error finishes (§11.3). `replaces` is the message of the
## error a handler is passing on a failure from, or empty: its place is reused when it is in
## the room, the new message copied before the old one is given up, so a new message made
## from the old one reads it whole.
pub func message_raised(message: str, replaces: str) -> str:
    var length = message.length
    var cut = false
    if length > raised_most:
        length = raised_most - 3
        while length > 0 and (message.bytes[length] & 0xC0) == 0x80:
            length -= 1
        cut = true
    let total = length + (3 if cut else 0)
    var at = raised_top
    if let start = in_room(replaces):
        if start <= raised_top and start + total <= raised_room.length:
            at = start
    if at + total > raised_room.length:
        at = 0
    let room = u8[](&raised_room[at], total)
    if length > 0:
        _ = memmove(room.data, message.bytes.data, length)
    if cut:
        room[length] = 0xE2
        room[length + 1] = 0x80
        room[length + 2] = 0xA6
    raised_top = at + total
    return (str)room

## A handler finished with the error whose message is `message`: its place in the room and
## everything raised after it are free again. A message elsewhere, a literal, frees nothing.
pub func message_handled(message: str):
    if let start = in_room(message):
        if start < raised_top:
            raised_top = start

# mark: Where errors were raised ============================================================
#
# An error keeps where it was raised (§11.3), the position text of the statement a trap there
# would name, in the word after its code: the text's distance from `origin_base`, a byte of
# this program's own data, so the `Error` stays three words and a `T!` result does not grow.
# The texts and the byte are in one image, well within 2 GiB of each other; 0 is no position.

## The byte an error's `at` is counted from: generated code subtracts its address from the
## position text's.
pub var origin_base: u8 = 0

## `failure.at`: the position text `raised` bytes from `origin_base`, `file:line:column`, or
## empty when it is 0.
pub func origin(raised: i32) -> str:
    if raised == 0:
        return ""
    let text = (u8*)(usize)((isize)(usize)&origin_base + (isize)raised)
    return (str)(c.str)text

## A failed `main`: its error on stderr, `error: file:line:column: message (code n)`, the
## place being where the error was raised, `at`; exit status 1. The code shown is the
## package's own number, `n` of `ErrorCode.package(n)`; the package identity above it (§11.3)
## tells packages apart and means nothing to a reader.
pub func main_failed(code: i32, message: str, raised: i32) -> i32:
    var bytes: u8[1024] = ---
    let at = origin(raised)
    let number = (u32)code & 0xFFFF
    let line = strings.format(bytes, f"error: {at}: {message} (code {number})\n" if at.length > 0 else f"error: {message} (code {number})\n") catch:
        return 1
    _ = write(2, line.bytes.data, line.length)
    return 1

## The failure of a test whose `assert` was false (§16.5).
pub let assert_failed: ErrorCode = ErrorCode.package(60)

## Where the `assert` that failed the running test stands, empty while none has, and the
## room its message is written in, which the failure views until the test is reported.
var assert_position: c.str = ""
var assert_message: u8[1024]

## A false `assert` in a test's own body (§16.5): the test fails with `text`, `assert failed:`
## and the condition, and `detail` after it when there is one, and is reported at `position`,
## the assert's.
pub func test_assert(position: c.str, text: c.str, detail: str, detailed: bool) -> !:
    assert_position = position
    let condition = (str)text
    let message = strings.format(assert_message, f"{condition}: {detail}" if detailed else f"{condition}") catch:
        recover condition
    error(assert_failed, message)

## The test the runner is running, empty between tests, and the tally so far: a trap or
## fatal signal in a test names it as failed and prints the tally before the run ends.
var test_running: str = ""
var tests_passed: i32 = 0
var tests_failed: i32 = 0

## The runner starts the test named `name`.
pub func test_start(name: str):
    test_running = name

## The test runner's report line for the test that ran: `ok`, or `FAIL` with the place and
## the message on the next line, the place being the failed `assert`'s or else the test's
## own, `at` (§16.5).
pub func test_report(failed: bool, at: c.str, message: str):
    let place = (str)(assert_position if ((str)assert_position).length > 0 else at)
    assert_position = ""
    test_result(failed, place, message)

## Report the test that ran and count it: `ok    name`, or `FAIL  name` and the indented
## `place: message`. Luce's runners report through here too, so every runner prints alike.
pub func test_result(failed: bool, place: str, message: str):
    let name = test_running
    test_running = ""
    if failed:
        tests_failed += 1
    else:
        tests_passed += 1
    if not failed:
        write_all(1, "ok    ".bytes)
        write_all(1, name.bytes)
        write_all(1, "\n".bytes)
        return
    write_all(1, "FAIL  ".bytes)
    write_all(1, name.bytes)
    write_all(1, "\n      ".bytes)
    write_all(1, place.bytes)
    write_all(1, ": ".bytes)
    write_all(1, message.bytes)
    write_all(1, "\n".bytes)

## Print the tally of the tests run, the failures counted when there are any; the process
## exit status. Formats without the heap or `strings`, since a trap may print it.
pub func test_summary() -> i32:
    var line: u8[128] = ---
    var used = put_decimal(line, 0, (usize)tests_passed)
    used = put_text(line, used, " passed\n")
    if tests_failed > 0:
        used = put_decimal(line, used, (usize)tests_failed)
        used = put_text(line, used, " failed\n")
    write_all(1, line[..<used])
    return 0 if tests_failed == 0 else 1

## `print`: the text and a newline on stdout; `answer()` programs print their number.
pub func print_str(text: str):
    _ = write(1, text.bytes.data, text.length)
    let newline = "\n"
    _ = write(1, newline.bytes.data, 1)

# mark: Streamed text =========================================================================

## `print(f"...")` and `trap(f"...")` fill a format buffer and write it out to `descriptor`
## (1, standard output; 2, the diagnostic) as it fills, so no buffer bounds the text and a
## short line is one write. Append `count` bytes at `data` and leave at least half the
## buffer free, which is room for the fields the compiler displays into it between pieces;
## a field that displays itself longer than that is cut, as `format_finish` marks.
pub func stream_put(b: FormatBuffer*, data: const u8*, count: usize, descriptor: i32):
    if b.used > b.capacity or count > b.capacity - b.used:
        stream_flush(b, descriptor)
    if count >= b.capacity:
        stream_write(descriptor, u8[]((u8*)data, count))
        return
    _ = format_put(b, data, count)
    if b.used > b.capacity // 2:
        stream_flush(b, descriptor)

## Write out the buffer's text and empty it: the end of a streamed text.
pub func stream_flush(b: FormatBuffer*, descriptor: i32):
    if b.used > 0:
        stream_write(descriptor, format_finish(b).bytes)
    b.used = 0

func stream_write(descriptor: i32, data: const u8[]):
    if descriptor == 2:
        write_diagnostic(data)
    else:
        write_all(descriptor, data)

## Print `value` followed by a newline.
pub func print_i64(value: i64):
    var bytes: u8[32] = ---
    let all: u8[] = bytes
    var b = FormatBuffer(data = all.data, capacity = 32, used = 0)
    _ = format_i64(&b, value)
    _ = write(1, all.data, b.used)
    let newline = "\n"
    _ = write(1, newline.bytes.data, 1)

## Ordering of text: bytewise, then by length (§7.4).
pub func str_compare(a: str, b: str) -> i32:
    let n = a.length if a.length < b.length else b.length
    var order: i32 = 0
    if n > 0:
        order = memcmp(a.bytes.data, b.bytes.data, n)
    if order != 0:
        return -1 if order < 0 else 1
    if a.length < b.length:
        return -1
    return 1 if a.length > b.length else 0

## The scalar starting at byte `index` of `count` bytes of valid UTF-8, its width left in
## `width`: what `for character in text` steps by (§5.5).
pub func utf8_scalar(text: const u8*, count: usize, index: usize, width: usize*) -> char:
    let byte = text[index]
    var w: usize = 1
    var cp: u32 = (u32)byte
    if byte >= 240:
        w = 4
        cp = (u32)(byte & 7)
    elif byte >= 224:
        w = 3
        cp = (u32)(byte & 15)
    elif byte >= 192:
        w = 2
        cp = (u32)(byte & 31)
    if index + w > count:
        w = count - index
    var k: usize = 1
    while k < w:
        cp = (cp << 6) | (u32)(text[index + k] & 63)
        k += 1
    *width = w
    return char(cp)

## Whether `count` bytes are well-formed UTF-8: no overlong forms, no surrogates, nothing past U+10FFFF.
pub func utf8_ok(text: const u8*?, count: usize) -> bool:
    let s = text else return count == 0
    var i: usize = 0
    while i < count:
        # eight ASCII bytes at a time: source text is mostly ASCII
        while i + 8 <= count:
            var word: u64 = 0
            _ = memcpy(&word, &s[i], 8)
            if (word & 0x8080808080808080) != 0:
                break
            i += 8
        if i >= count:
            break
        let byte = s[i]
        var w: usize = 1
        var cp: u32 = 0
        if byte < 128:
            cp = (u32)byte
        elif (byte & 224) == 192:
            w = 2
            cp = (u32)(byte & 31)
        elif (byte & 240) == 224:
            w = 3
            cp = (u32)(byte & 15)
        elif (byte & 248) == 240:
            w = 4
            cp = (u32)(byte & 7)
        else:
            return false
        if i + w > count:
            return false
        var k: usize = 1
        while k < w:
            let x = s[i + k]
            if (x & 192) != 128:
                return false
            cp = (cp << 6) | (u32)(x & 63)
            k += 1
        if w == 2 and cp < 128:
            return false
        if w == 3 and cp < 2048:
            return false
        if w == 4 and cp < 65536:
            return false
        if cp >= 55296 and cp <= 57343:
            return false
        if cp > 1114111:
            return false
        i += w
    return true

## `hash`: a per-process seed and a multiplicative mixer (§7.4).
var hash_seed_value: u64
var hash_seeded: bool

## A per-process seed for the collection hashers.
# mark: Hashing ===============================================================================

## The process's per-run hash seed, chosen once from the address space.
pub func hash_seed() -> u64:
    if not hash_seeded:
        hash_seed_value = 11400714819323198485 ^ (u64)(usize)&hash_seed_value
        hash_seeded = true
    return hash_seed_value

## Mix `x` into the running hash `h`.
pub func hash_mix(h: u64, x: u64) -> u64:
    var r = h ^ x
    r = r *% 11400714819323198485
    r = r ^ (r >> 32)
    return r

## Mix `count` bytes at `data` into the running hash `h`.
pub func hash_bytes(h: u64, data: const void*?, count: usize) -> u64:
    var r = h
    if let p = data:
        let bytes = (const u8*)p
        var i: usize = 0
        while i < count:
            r = hash_mix(r, (u64)bytes[i])
            i += 1
    return hash_mix(r, (u64)count)

## Integer conversions between widths: `bits` of `value` as a 64-bit word.
func mask_of(bits: i32) -> u64:
    if bits >= 64:
        return 18446744073709551615
    return (1 << (u64)bits) - 1

func sign_extend(value: i64, bits: i32) -> i64:
    if bits >= 64:
        return value
    let m = mask_of(bits)
    let x = (u64)value & m
    if (x & (1 << (u64)(bits - 1))) != 0:
        return (i64)(x | ~m)
    return (i64)x

func zero_extend(value: u64, bits: i32) -> u64:
    return value & mask_of(bits)

func signed_min(bits: i32) -> i64:
    if bits >= 64:
        return -9223372036854775807 - 1
    return 0 -% (1 << (i64)(bits - 1))

func signed_max(bits: i32) -> i64:
    if bits >= 64:
        return 9223372036854775807
    return (1 << (i64)(bits - 1)) - 1

func fits_signed(value: i64, bits: i32) -> bool:
    return value >= signed_min(bits) and value <= signed_max(bits)

func fits_unsigned(value: u64, bits: i32) -> bool:
    return value <= mask_of(bits)

## The source of an integer conversion as a sign and a magnitude, so a `u64` above
## `i64.max` stays itself.
struct Magnitude:
    var negative: bool
    var bits: u64

func magnitude(value: u64, from_bits: i32, from_signed: i32) -> Magnitude:
    if from_signed != 0:
        let v = sign_extend((i64)value, from_bits)
        return Magnitude(negative = v < 0, bits = (u64)v)
    return Magnitude(negative = false, bits = zero_extend(value, from_bits))

## A checked conversion's result as bits: outside the destination's range traps (§7.5),
## naming the statement at `at`.
func checked_bits(m: Magnitude, to_bits: i32, to_signed: i32, at: c.str) -> u64:
    var bad = false
    if to_signed != 0:
        bad = (i64)m.bits < signed_min(to_bits) if m.negative else m.bits > (u64)signed_max(to_bits)
    else:
        bad = m.negative or not fits_unsigned(m.bits, to_bits)
    if bad:
        trap_at(at, "integer conversion out of range")
    return m.bits

## `T(x)` between integers (`mode` 0, checked) and `(T)x` (`mode` 1, truncating).
pub func conv_s(value: i64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32, at: c.str) -> i64:
    let m = magnitude((u64)value, from_bits, from_signed)
    if mode == 0:
        return (i64)checked_bits(m, to_bits, to_signed, at)
    let bits = m.bits & mask_of(to_bits)
    if to_signed != 0:
        return sign_extend((i64)bits, to_bits)
    return (i64)bits

## Convert an unsigned value between integer widths and signedness; `mode` chooses checked or wrapping.
pub func conv_u(value: u64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32, at: c.str) -> u64:
    let m = magnitude(value, from_bits, from_signed)
    if mode == 0:
        return checked_bits(m, to_bits, to_signed, at)
    return zero_extend(m.bits, to_bits)

## A `char` from an integer's bits: a scalar value, or a trap when checked (`mode` 0).
pub func to_char(value: u64, mode: i32, at: c.str) -> u64:
    let bad = value > 1114111 or (value >= 55296 and value <= 57343)
    if bad and mode == 0:
        trap_at(at, "integer conversion out of range")
    return value & 4294967295

func is_finite(value: f64) -> bool:
    return value - value == 0.0

## `2^(bits-1)` and `2^bits` as floats: exact, where `(f64)signed_max(64)` rounds up to `2^63`.
func float_bound_s(bits: i32) -> f64:
    return (f64)((u64)1 << (u64)(bits - 1))

func float_bound_u(bits: i32) -> f64:
    return float_bound_s(bits) * 2.0

## Float to integer: checked (`mode` 0) or saturating (`mode` 1); the cast inside is the target's own.
pub func f_to_s(value: f64, bits: i32, mode: i32, at: c.str) -> i64:
    let high = float_bound_s(bits)
    let low = 0.0 - high
    if mode == 0:
        if not is_finite(value) or value < low or value >= high:
            trap_at(at, "integer conversion out of range")
        return (i64)value
    if value != value:
        return 0
    if value <= low:
        return signed_min(bits)
    if value >= high:
        return signed_max(bits)
    return (i64)value

## Convert a float to an unsigned integer of `bits`; `mode` checks the range.
pub func f_to_u(value: f64, bits: i32, mode: i32, at: c.str) -> u64:
    let high = float_bound_u(bits)
    if mode == 0:
        if not is_finite(value) or value < 0.0 or value >= high:
            trap_at(at, "integer conversion out of range")
        return (u64)value
    if value != value or value < 0.0:
        return 0
    if value >= high:
        return mask_of(bits)
    return (u64)value

## Saturating arithmetic (`+|`, `-|`, `*|`) on `bits`-wide operands in 64-bit words.
func add_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ r) & (b ^ r)) < 0

func sub_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ b) & (a ^ r)) < 0

func mul_overflows_s(a: i64, b: i64) -> bool:
    if a == 0 or b == 0:
        return false
    if a == -1:
        return b == signed_min(64)
    if b == -1:
        return a == signed_min(64)
    return (a *% b) // b != a

## Saturating signed addition at `bits`.
# mark: Saturating and checked arithmetic =====================================================

## Saturating signed addition of `x` and `y` at `bits` bits.
pub func adds_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

## Saturating unsigned addition at `bits`.
pub func adds_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return mask_of(bits)
    return r

## Saturating signed subtraction at `bits`.
pub func subs_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

## Saturating unsigned subtraction at `bits`.
pub func subs_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return 0
    return a - b

## Saturating signed multiplication at `bits`.
pub func muls_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return signed_min(bits) if (a < 0) != (b < 0) else signed_max(bits)
    return a *% b

## Saturating unsigned multiplication at `bits`.
pub func muls_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return mask_of(bits)
    return zero_extend(a *% b, bits)

## Checked-to-optional arithmetic (`+?`, `-?`, `*?`): the result through `out`, whether it fit.
pub func qadd_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

## Checked unsigned addition through `out`; whether it fit.
pub func qadd_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return false
    *out = r
    return true

## Checked signed subtraction through `out`; whether it fit.
pub func qsub_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

## Checked unsigned subtraction through `out`; whether it fit.
pub func qsub_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return false
    *out = a - b
    return true

## Checked signed multiplication through `out`; whether it fit.
pub func qmul_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return false
    *out = a *% b
    return true

## Checked unsigned multiplication through `out`; whether it fit.
pub func qmul_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return false
    *out = a *% b
    return true

## Terminate the process through the minimal runtime layer.
pub func exit(code: i32) -> never:
    c_exit(code)
"""

## The text of `src/std/memory.lucb`.
let text_7: str = r"""#==============================================================================================
#
#   memory - Allocators and byte primitives
#
#   DESCRIPTION:
#       The allocators of §12, the thread's current-allocator convention, the diagnostic
#       records of an allocation failure, and the byte copy, move, set, read and write helpers.
#
#==============================================================================================

from windows_abi import SystemInfo
from windows_abi import GetSystemInfo
import platform
extern func malloc(size: usize) -> void*?
extern func c_free as "free"(block: void*)
extern func posix_memalign(memptr: void*?*, alignment: usize, size: usize) -> i32
extern func aligned_malloc as "_aligned_malloc"(size: usize, alignment: usize) -> void*?
extern func aligned_free as "_aligned_free"(block: void*)
extern func memcpy(target: void*, source: const void*, count: usize) -> void*
extern func memmove(target: void*, source: const void*, count: usize) -> void*
extern func memset(target: void*, value: i32, count: usize) -> void*

## What every allocator offers: blocks of bytes at an alignment, optionally
## resized in place, and given back (§12.4). Zero alignment means one. A nonempty
## block must meet the requested alignment; an allocator may refuse an unsupported
## alignment. Bump allocators support every positive alignment, not only powers of two.
pub interface Allocator:
    func allocate(size: usize, alignment: usize) -> u8[]?

    func resize(block: u8[], size: usize) -> bool

    func release(block: u8[])

## A bump allocator over a caller's bytes. Only the last block can be resized or
## released; everything goes away together when the buffer does.
pub struct FixedBuffer: Allocator:
    var data: u8[]
    var used: usize

    ## An allocator handing out `buffer`'s bytes; only the last block resizes.
    pub static func over(buffer: u8[]) -> FixedBuffer:
        return FixedBuffer(data = buffer, used = 0)

    ## Allocate `size` bytes at `alignment`, or none when it cannot.
    pub func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return self.data[..<0]
        let align = alignment if alignment > 0 else 1
        let start = aligned_offset(self.data, self.used, align) else return none
        if start > self.data.length or size > self.data.length - start:
            return none
        self.used = start + size
        return self.data[start..<self.used]

    ## Try to resize `block` to `size` in place; whether it worked.
    pub func resize(block: u8[], size: usize) -> bool:
        if size == block.length:
            return true
        if block.length == 0:
            return false
        let start = (usize)block.data -? (usize)self.data.data else return false
        if start > self.used or block.length != self.used - start:
            return false
        if start > self.data.length or size > self.data.length - start:
            return false
        self.used = start + size
        return true

    ## Free `block`.
    pub func release(block: u8[]):
        if block.length == 0:
            return
        if diagnostic:
            _ = memset(block.data, 221, block.length)  # a fixed buffer releases all at once
        let start = (usize)block.data - (usize)self.data.data
        if start + block.length == self.used:
            self.used = start

## Align the address inside a bounded span, without rounding an addition past
## usize's range. The remainder works for arbitrary positive byte alignments.
func aligned_offset(storage: u8[], used: usize, alignment: usize) -> usize?:
    if used > storage.length:
        return none
    let address = (usize)storage.data +? used else return none
    let remainder = address % alignment
    let padding = 0 if remainder == 0 else alignment - remainder
    if padding > storage.length - used:
        return none
    return used + padding

## The C library's heap.
pub struct CAllocator: Allocator:
    var unused: u8

    ## Allocate `size` bytes at `alignment`, or none when it cannot.
    pub func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return u8[]((u8*)8, 0)
        if alignment != 0 and (alignment & (alignment - 1)) != 0:
            return none
        let align = alignment if alignment > 8 else 8
        var p: void*? = none
        if platform.windows:
            p = aligned_malloc(size, align)
        elif posix_memalign(&p, align, size) != 0:
            return none
        let block = p else return none
        return u8[]((u8*)block, size)

    ## Try to resize `block` to `size` in place; whether it worked.
    pub func resize(block: u8[], size: usize) -> bool:
        return size <= block.length

    ## Free `block`.
    pub func release(block: u8[]):
        if block.length == 0:
            return
        if not diagnostic:
            release_heap(block.data)
            return
        # the diagnostic profile (§19.4): the block is filled with a pattern and held back, so
        # a use after release reads the pattern rather than the next allocation; releasing
        # it again, or writing it while it is held, is reported
        lock(&records_lock)
        if already_held(quarantine, block):
            unlock(&records_lock)
            trap("double free: a block was released twice")
        _ = memset(block.data, (i32)released_fill, block.length)
        let slot = quarantine_next % quarantine.length
        if let old = quarantine[slot]:
            if not still_released(old):
                unlock(&records_lock)
                trap("use after free: a released block was written after its release")
            release_heap(old.data)
        quarantine[slot] = block
        quarantine_next += 1
        unlock(&records_lock)

func release_heap(block: void*):
    if platform.windows:
        aligned_free(block)
    else:
        c_free(block)

## Bump allocation over a parent allocator, released all at once by `reset` or `destroy`
## (§12.4, §24.3). One thread at a time.
pub struct Arena: Allocator:
    var parent: Allocator
    var block: u8[]
    var used: usize

    ## An arena of `capacity` bytes over `parent`, released all at once.
    pub static func over(parent: Allocator, capacity: usize) -> Arena!:
        let block = parent.allocate(capacity, 16) else error(exhausted, "memory.exhausted")
        return Arena(parent = parent, block = block, used = 0)

    ## Allocate `size` bytes at `alignment`, or none when it cannot.
    pub func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return self.block[..<0]
        let align = alignment if alignment > 0 else 1
        let start = aligned_offset(self.block, self.used, align) else return none
        let end = start +? size else return none
        if end > self.block.length:
            return none
        self.used = end
        return self.block[start..<end]

    ## Try to resize `block` to `size` in place; whether it worked.
    pub func resize(block: u8[], size: usize) -> bool:
        if size == block.length:
            return true
        if block.length == 0:
            return false
        # the last block may grow or shrink in place
        let start = (usize)block.data -? (usize)self.block.data else return false
        if start > self.used or block.length != self.used - start:
            return false
        if start > self.block.length or size > self.block.length - start:
            return false
        self.used = start + size
        return true

    ## Free `block`.
    pub func release(block: u8[]):
        if diagnostic and block.length > 0:
            _ = memset(block.data, 221, block.length)  # an arena releases all at once

    ## What has been handed out since the last reset, and what the arena holds in all.
    pub func in_use() -> usize:
        return self.used

    ## The arena's total capacity in bytes.
    pub func capacity() -> usize:
        return self.block.length

    ## Forget every allocation; the storage is reused from its start.
    pub func reset():
        self.used = 0

    ## Give the storage back to the parent; the arena is empty afterwards.
    pub func destroy():
        self.parent.release(self.block)
        self.block = self.block[..<0]
        self.used = 0

## Whole pages from the host, each block its own mapping (§12.4). Safe from several threads.
pub struct PageAllocator: Allocator:
    var unused: u8

    ## Allocate `size` bytes at `alignment`, or none when it cannot.
    pub func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return u8[]((u8*)8, 0)
        let page = page_size()
        if alignment > page or (alignment != 0 and page % alignment != 0):
            return none
        let padded = size +? (page - 1) else return none
        let rounded = padded // page * page
        let mapped = map_pages(rounded) else return none
        if (usize)mapped == ~(usize)0:
            return none
        return u8[]((u8*)mapped, rounded)

    ## Try to resize `block` to `size` in place; whether it worked.
    pub func resize(block: u8[], size: usize) -> bool:
        return size <= block.length

    ## Free `block`.
    pub func release(block: u8[]):
        if block.length == 0:
            return
        if not diagnostic:
            unmap_pages(block)
            return
        # the diagnostic profile (§19.4): the mapping is filled and kept for a while, so a
        # use after release reads the pattern rather than faulting or reading a new mapping
        lock(&records_lock)
        if already_held(held_pages, block):
            unlock(&records_lock)
            trap("double free: pages were released twice")
        _ = memset(block.data, (i32)released_fill, block.length)
        let slot = held_next % held_pages.length
        if let old = held_pages[slot]:
            if not still_released(old):
                unlock(&records_lock)
                trap("use after free: released pages were written after their release")
            unmap_pages(old)
        held_pages[slot] = block
        held_next += 1
        unlock(&records_lock)

extern func mmap(address: void*?, length: usize, protection: i32, flags: i32, descriptor: i32, offset: i64) -> void*?
## `MAP_PRIVATE | MAP_ANON`: `MAP_ANON` is 0x1000 on macOS and 0x20 on Linux; the
## protection `PROT_READ | PROT_WRITE` is 3 on both.
let private_anonymous: i32 = 4098 if platform.macos else 34
extern func munmap(address: void*, length: usize) -> i32
extern func getpagesize() -> i32
extern func VirtualAlloc(address: void*?, size: usize, kind: u32, protection: u32) -> void*?
extern func VirtualFree(address: void*, size: usize, kind: u32) -> i32

## The host's memory page size in bytes: the one query `os.page_size` and the threads'
## stack sizes use too.
pub func page_size() -> usize:
    if platform.windows:
        var info: SystemInfo = ---
        GetSystemInfo(&info)
        return (usize)info.page_size
    return (usize)getpagesize()

func map_pages(size: usize) -> void*?:
    if platform.windows:
        return VirtualAlloc(none, size, 12288, 4)
    return mmap(none, size, 3, private_anonymous, -1, 0)

func unmap_pages(block: u8[]):
    if platform.windows:
        _ = VirtualFree(block.data, 0, 32768)
    else:
        _ = munmap(block.data, block.length)

## `--profile diagnostic`: set by the startup shim before `startup` runs.
pub var diagnostic: bool

## An allocation the diagnostic profile recorded (§19.4): the block, its size, and where.
pub struct Site:
    ## The block's address, or none for a failed request.
    pub var address: void*?
    ## The requested size in bytes.
    pub var size: usize
    ## The function that requested it.
    pub var function: str
    ## The source line of the request.
    pub var line: u32

var sites: Site[256]
var site_next: usize

## The diagnostic profile's records are shared by every thread: a short spin lock guards
## each update, on the atomic `@bool` alone, since this module is below `sync`.
var records_lock: @bool

func lock(flag: (@bool)*):
    while true:
        let (exchanged, observed) = flag.cas(false, true)
        _ = observed
        if exchanged:
            return

func unlock(flag: (@bool)*):
    flag.store(false)

## Called by the compiled program after each allocation under `--profile diagnostic`.
## The record keeps the most recent 256 allocations, oldest first: once full, the oldest
## goes and the newest takes the last place.
pub func note_site(address: void*?, size: usize, function: str, line: u32):
    lock(&records_lock)
    if site_next < sites.length:
        sites[site_next] = Site(address = address, size = size, function = function, line = line)
    else:
        var i: usize = 1
        while i < sites.length:
            sites[i - 1] = sites[i]
            i += 1
        sites[sites.length - 1] = Site(address = address, size = size, function = function, line = line)
    site_next += 1
    unlock(&records_lock)

## The allocations recorded so far, the most recent 256 at most, oldest first. A view of
## the record: read it while no other thread allocates.
pub func allocation_sites() -> const Site[]:
    let held = site_next if site_next < sites.length else sites.length
    return sites[..<held]

## The released blocks the diagnostic profile still holds, oldest freed first.
var quarantine: (u8[]?)[256]
var quarantine_next: usize
## The released mappings the diagnostic profile still holds, oldest first.
var held_pages: (u8[]?)[8]
var held_next: usize
## The byte a released block is filled with under the diagnostic profile.
let released_fill: u8 = 221
## The byte unwritten storage is filled with under the diagnostic profile: `---` storage,
## `memory.allocate` and `memory.frame`; the compiler writes the same byte, 0xAA.
let unwritten_fill: u8 = 170

## Whether `block` is among the released blocks still `held`: releasing it again is a
## double free.
func already_held(blocks: const (u8[]?)[], block: u8[]) -> bool:
    for entry in blocks:
        if let kept = entry:
            if kept.data == block.data:
                return true
    return false

## Whether every byte of a held block is still the fill it was given at release: a write
## through a dangling pointer changes one.
func still_released(block: const u8[]) -> bool:
    for byte in block:
        if byte != released_fill:
            return false
    return true

## Allocation failed: out of memory.
# mark: Diagnostics and heap ==================================================================

## Allocation failed because memory is exhausted.
pub let exhausted: ErrorCode = ErrorCode.package(1)
## No allocator is current (§12.3).
pub let unset: ErrorCode = ErrorCode.package(2)

var c_allocator: CAllocator
## The current allocator of this thread (§12.3) and the process's initial one.
pub local var allocator: Allocator
## The process's C heap allocator.
pub var heap: Allocator

## Run by the startup shim before `main`, and by `thread.spawn` in a new thread.
pub func startup():
    heap = &c_allocator
    allocator = heap

## Copy `count` elements from `source` to `target` (no overlap).
# mark: Byte primitives =======================================================================

## Copy `count` elements from `source` into `target`.
pub func copy[T](target: T[], source: const T[], count: usize):
    if count > target.length or count > source.length:
        trap("index out of bounds")
    if count > 0:
        _ = memcpy(target.data, source.data, count * size_of(T))

## Copy `count` elements, allowing `source` and `target` to overlap.
pub func move[T](target: T[], source: const T[], count: usize):
    if count > target.length or count > source.length:
        trap("index out of bounds")
    if count > 0:
        _ = memmove(target.data, source.data, count * size_of(T))

## Set every byte of `target` to `value`.
pub func set(target: u8[], value: u8):
    if target.length > 0:
        _ = memset(target.data, (i32)value, target.length)

## Read a `T` from `address`, which may be unaligned.
pub func read[T](address: const void*) -> T:
    var value: T = ---
    _ = memcpy(&value, address, size_of(T))
    return value

## Write `value` to `address`, which may be unaligned.
pub func write[T](address: void*, value: T):
    var copy_of = value
    _ = memcpy(address, &copy_of, size_of(T))

## `count` uninitialised elements of `T` in the frame of the function that calls this, at
## most `most` (a constant; `most * size_of(T)` at most 4096 bytes), freed when that function
## returns (§12.7). The compiler takes the storage at the call, so this body never runs.
pub func frame[T](count: usize, most: usize) -> T[]:
    trap("memory.frame is answered where it is called")

## `size` unwritten bytes aligned to `alignment`, from the current allocator: storage a
## structure lays out itself (§12.2), given back with `free`; the diagnostic profile fills
## them with 0xAA (§19.4). Fails with `memory.exhausted`.
pub func allocate(size: usize, alignment: usize) -> u8[]!:
    let block = allocator.allocate(size, alignment) else error(exhausted, "memory.exhausted")
    if diagnostic:
        _ = memset(block.data, (i32)unwritten_fill, block.length)
    return block

## `block` with `size` bytes: in place when the current allocator can, else a
## new block with the old bytes copied and the old block released. The bytes past the
## old ones are unwritten, 0xAA under the diagnostic profile.
pub func grow(block: u8[], size: usize) -> u8[]!:
    var grown: u8[] = ---
    if allocator.resize(block, size):
        grown = u8[](block.data, size)
    else:
        grown = allocator.allocate(size, 8) else error(exhausted, "memory.exhausted")
        let keep = block.length if block.length < size else size
        if keep > 0:
            _ = memcpy(grown.data, block.data, keep)
        allocator.release(block)
    if diagnostic and size > block.length:
        _ = memset(&grown[block.length], (i32)unwritten_fill, size - block.length)
    return grown
"""

## The text of `src/std/windows_text.lucb`.
let text_8: str = r"""#==============================================================================================
#
#   windows_text - Allocating Windows text conversions
#
#   DESCRIPTION:
#       Returned storage belongs to the current allocator and includes a NUL terminator.
#       Callers select their API's error code.
#
#==============================================================================================

import c
import memory
import windows_abi

## UTF-8 `text` to a NUL-terminated UTF-16 buffer, `invalid` on malformed input.
pub func wide(text: c.str, invalid: ErrorCode) -> u16[]!:
    let count = windows_abi.MultiByteToWideChar(windows_abi.utf8_page, windows_abi.reject_invalid_utf8, text, -1, none, 0)
    if count <= 0:
        error(invalid, "OS text is not valid UTF-8")
    let result = try new u16[(usize)count] ---
    errdefer free(result)
    if windows_abi.MultiByteToWideChar(windows_abi.utf8_page, windows_abi.reject_invalid_utf8, text, -1, result.data, count) != count:
        error(invalid, "OS text could not be converted to UTF-16")
    return result

## UTF-16 `text` to a NUL-terminated UTF-8 string, `invalid` on malformed input.
pub func narrow(text: const u16[], invalid: ErrorCode) -> str!:
    if text.length > 2147483647:
        error(invalid, "OS text exceeds the conversion limit")
    let count = windows_abi.WideCharToMultiByte(windows_abi.utf8_page, windows_abi.reject_invalid_utf16, text.data, (i32)text.length, none, 0, none, none)
    if count == 0 and text.length > 0:
        error(invalid, "OS text is not valid UTF-16")
    let result = try new u8[(usize)count + 1] ---
    errdefer free(result)
    if count > 0 and windows_abi.WideCharToMultiByte(windows_abi.utf8_page, windows_abi.reject_invalid_utf16, text.data, (i32)text.length, result.data, count, none, none) != count:
        error(invalid, "OS text could not be converted to UTF-8")
    result[(usize)count] = 0
    return (str)result[..<(usize)count]
"""

## The text of `src/std/os/module.lucb`.
let text_9: str = r"""#==============================================================================================
#
#   os - The operating system's view of the process
#
#   DESCRIPTION:
#       Its environment, working directory, identity and host (§16.6). Text comes back as `str`
#       views of C storage that the system owns; copy what must outlive the next call.
#
#==============================================================================================
import c
import memory
import windows_text
import platform
extern func getenv(variable: c.str) -> c.str?
extern func setenv(variable: c.str, value: c.str, overwrite: i32) -> i32
extern func unsetenv(variable: c.str) -> i32
extern func getcwd(buffer: u8*, size: usize) -> c.str?
extern func readlink(path: c.str, buffer: void*, capacity: usize) -> isize
extern func mac_executable_path as "_NSGetExecutablePath"(buffer: u8*, size: u32*) -> i32
extern func chdir(path: c.str) -> i32
extern func getpid() -> i32
extern func getppid() -> i32
extern func gethostname(buffer: u8*, size: usize) -> i32
extern func c_exit as "exit"(code: i32) -> never
extern func sysconf(option: i32) -> i64
extern func getentropy(buffer: void*, count: usize) -> i32
extern func BCryptGenRandom(algorithm: void*?, buffer: u8*, count: u32, flags: u32) -> i32

## Fill bytes from the operating system's cryptographic random generator.
## A failure is reported; weak process IDs or timestamps are never substituted.
pub func random_bytes(buffer: u8[]) -> !:
    var offset: usize = 0
    while offset < buffer.length:
        let count = buffer.length - offset if buffer.length - offset < 256 else 256
        var result: i32 = 0
        if platform.windows:
            result = BCryptGenRandom(none, &buffer[offset], (u32)count, 2)
        else:
            result = getentropy(&buffer[offset], count)
        if result != 0:
            error(failed, "operating system randomness is unavailable")
        offset += count

## An operating-system call failed.
pub let failed: ErrorCode = ErrorCode.package(12)

## The target, as constants a program branches on: `if os.arm64:`, `if os.linux and
## os.x86_64:` (§19.5); the compiler decides them from `--target`, so the branch a target
## rules out is pruned (§19.6).
pub let arm64: bool = platform.arm64
## Whether the target architecture is x86-64.
pub let x86_64: bool = platform.x86_64
## Whether the target operating system is macOS.
pub let macos: bool = platform.macos
## Whether the target operating system is Linux.
pub let linux: bool = platform.linux
## Whether the target operating system is Windows.
pub let windows: bool = platform.windows
## Whether the target is a POSIX system.
pub let posix: bool = platform.posix
## The width of a pointer on the target, in bits.
pub let pointer_bits: u32 = platform.pointer_bits
## The target triple.
pub let name: str = platform.name
## The instruction-set level the program was compiled for (`--cpu`, §19.5): on x86-64, 1
## to 4 for x86-64-v1 to v4; on arm64, 1 for NEON, 2 for SVE.
pub let cpu_level: u32 = platform.cpu_level

## The instruction-set level of the processor this program runs on, in the same scale:
## what it may dispatch to at run time. On x86-64 `cpuid` answers; on arm64 the level is
## NEON until the system reports SVE.
# mark: Machine and process ===================================================================

## The microarchitecture level (§19.5) the CPU running this process supports.
pub func cpu_level_running() -> u32:
    if platform.x86_64:
        return x86_level()
    return 1

## x86-64: SSE4.2 and POPCNT make v2; AVX2, FMA, and BMI2 make v3; AVX-512F makes v4.
func x86_level() -> u32:
    var c1: u32 = 0
    var b7: u32 = 0
    asm x86_64 (in("eax") 1u32, out("ecx") c1, out("eax") _, out("ebx") _, out("edx") _, options(nostack)):
        cpuid
    asm x86_64 (in("eax") 7u32, in("ecx") 0u32, out("ebx") b7, out("eax") _, out("ecx") _, out("edx") _, options(nostack)):
        cpuid
    let sse42 = (c1 & (1 << 20)) != 0
    let popcnt = (c1 & (1 << 23)) != 0
    let fma = (c1 & (1 << 12)) != 0
    # the operating system saves the wide registers only with `OSXSAVE` set
    let osxsave = (c1 & (1 << 27)) != 0
    let avx2 = (b7 & (1 << 5)) != 0
    let bmi2 = (b7 & (1 << 8)) != 0
    let avx512f = (b7 & (1 << 16)) != 0
    if not (sse42 and popcnt):
        return 1
    if not (avx2 and fma and bmi2 and osxsave):
        return 2
    return 4 if avx512f else 3

## `_SC_NPROCESSORS_ONLN`: 58 on macOS, 84 on Linux.
let processors_online: i32 = 58 if platform.macos else 84

## The processors available to this process, at least one.
pub func cpus() -> u32:
    if platform.windows:
        let count = GetActiveProcessorCount(65535)
        return count if count > 0 else 1
    let n = sysconf(processors_online)
    return (u32)n if n > 0 else 1

## The host's memory page size in bytes.
pub func page_size() -> usize:
    return memory.page_size()

## The value of an environment variable, or none when it is not set. Copy a view
## that must survive another env call on this thread or an environment mutation.
pub func env(variable: c.str) -> str?:
    if platform.windows:
        return windows_env(variable)
    let value = getenv(variable) else return none
    return (str)value

## Set an environment variable for this process and the ones it starts.
pub func set_env(variable: c.str, value: c.str) -> !:
    if platform.windows:
        let key = try windows_text.wide(variable, failed)
        defer free(key)
        let text = try windows_text.wide(value, failed)
        defer free(text)
        if SetEnvironmentVariableW(key.data, text.data) == 0:
            error(failed, "the environment variable cannot be set")
        return
    if setenv(variable, value, 1) != 0:
        error(failed, "the environment variable cannot be set")

## Remove environment variable `variable`.
pub func unset_env(variable: c.str) -> !:
    if platform.windows:
        let key = try windows_text.wide(variable, failed)
        defer free(key)
        if SetEnvironmentVariableW(key.data, none) == 0 and GetLastError() != 203:
            error(failed, "the environment variable cannot be unset")
        return
    if unsetenv(variable) != 0:
        error(failed, "the environment variable cannot be unset")

## The working directory, in storage from the current allocator.
pub func cwd() -> str!:
    if platform.windows:
        return try windows_cwd()
    let buffer = try new u8[4096] ---
    errdefer free(buffer)
    let found = getcwd(buffer.data, buffer.length)
    if found == none:
        error(failed, "the working directory cannot be read")
    let path = found else trap("unreachable")
    return (str)path

## The path of this program's executable as the loader saw it, in an allocation of the
## current allocator, NUL-terminated for the C calls a path goes to.
pub func executable() -> str!:
    if platform.windows:
        return try windows_executable()
    let buffer = try new u8[4096] ---
    errdefer free(buffer)
    var count: usize = 0
    if platform.macos:
        var size: u32 = 4096
        if mac_executable_path(buffer.data, &size) != 0:
            error(failed, "the executable path cannot be read")
        while count < buffer.length and buffer[count] != 0:
            count += 1
    else:
        let read = readlink("/proc/self/exe", buffer.data, buffer.length - 1)
        if read < 0:
            error(failed, "the executable path cannot be read")
        count = (usize)read
    buffer[count] = 0
    return (str)buffer[..<count]

## Change the process's working directory to `path`.
pub func change_dir(path: c.str) -> !:
    if platform.windows:
        let text = try windows_text.wide(path, failed)
        defer free(text)
        if SetCurrentDirectoryW(text.data) == 0:
            error(failed, "the directory cannot be entered")
        return
    if chdir(path) != 0:
        error(failed, "the directory cannot be entered")

## The process identifier.
pub func pid() -> i32:
    if platform.windows:
        return (i32)GetCurrentProcessId()
    return getpid()

## The parent process's identifier.
pub func parent_pid() -> i32:
    if platform.windows:
        return windows_parent_pid()
    return getppid()

## The host's name, in storage from the current allocator.
pub func hostname() -> str!:
    if platform.windows:
        var host_text: u16[256]
        var count: u32 = 256
        if GetComputerNameW(&host_text[0], &count) == 0:
            error(failed, "the host name cannot be read")
        return try windows_text.narrow(host_text[..<(usize)count], failed)
    let buffer = try new u8[256] ---
    errdefer free(buffer)
    if gethostname(buffer.data, buffer.length) != 0:
        error(failed, "the host name cannot be read")
    var n: usize = 0
    while n < buffer.length and buffer[n] != 0:
        n += 1
    return (str)buffer[..<n]

## Stop the process with `code`, running no deferred work.
pub func exit(code: i32) -> never:
    c_exit(code)
"""

## The text of `src/std/os/windows.lucb`.
let text_10: str = r"""#==============================================================================================
#
#   windows - The os module's native Windows calls
#
#   DESCRIPTION:
#       Native Windows calls stay behind the portable `os` interface. Public text is UTF-8.
#
#==============================================================================================

from windows_abi import MultiByteToWideChar, WideCharToMultiByte, GetLastError, SetLastError, CloseHandle, GetCurrentProcessId, GetEnvironmentVariableW, SetEnvironmentVariableW, GetCurrentDirectoryW, SetCurrentDirectoryW
extern func GetComputerNameW(output: u16*, capacity: u32*) -> i32
extern func GetModuleFileNameW(module: void*?, output: u16*, capacity: u32) -> u32
extern func GetActiveProcessorCount(group: u16) -> u32
extern func CreateToolhelp32Snapshot(flags: u32, process: u32) -> void*
extern func Process32FirstW(snapshot: void*, entry: WinProcessEntry*) -> i32
extern func Process32NextW(snapshot: void*, entry: WinProcessEntry*) -> i32

extern struct WinProcessEntry:
    size: u32
    usage: u32
    pid: u32
    heap: usize
    module: u32
    threads: u32
    parent: u32
    priority: i32
    flags: u32
    executable: u16[260]

# Environment views last until the next env call on this thread. Fixed bounds are
# the Windows environment limit, independent of the caller's current allocator.
local var environment_wide: u16[32768]
local var environment_utf8: u8[131073]
local var environment_key: u16[32768]

func windows_env(variable: c.str) -> str?:
    if MultiByteToWideChar(65001, 8, variable, -1, &environment_key[0], 32768) == 0:
        return none
    SetLastError(0)
    let count = GetEnvironmentVariableW(&environment_key[0], &environment_wide[0], 32768)
    if count >= 32768 or (count == 0 and GetLastError() != 0):
        return none
    var size: i32 = 0
    if count > 0:
        size = WideCharToMultiByte(65001, 128, &environment_wide[0], (i32)count, &environment_utf8[0], 131072, none, none)
        if size == 0:
            return none
    environment_utf8[(usize)size] = 0
    return (str)environment_utf8[..<(usize)size]

func windows_cwd() -> str!:
    var attempt: usize = 0
    while attempt < 8:
        let capacity = GetCurrentDirectoryW(0, none)
        if capacity == 0:
            break
        let text = try new u16[(usize)capacity] ---
        defer free(text)
        let count = GetCurrentDirectoryW(capacity, text.data)
        if count == 0:
            break
        if count < capacity:
            return try windows_text.narrow(text[..<(usize)count], failed)
        attempt += 1
    error(failed, "the working directory cannot be read")

## The module path grows until the call answers a length below the capacity: a full
## buffer is a truncated path.
func windows_executable() -> str!:
    var capacity: usize = 260
    while capacity <= 32768:
        let text = try new u16[capacity] ---
        defer free(text)
        let count = GetModuleFileNameW(none, text.data, (u32)capacity)
        if count == 0:
            break
        if (usize)count < capacity:
            return try windows_text.narrow(text[..<(usize)count], failed)
        capacity *= 4
    error(failed, "the executable path cannot be read")

func windows_parent_pid() -> i32:
    let snapshot = CreateToolhelp32Snapshot(2, 0)
    if (usize)snapshot == ~(usize)0:
        return 0
    defer _ = CloseHandle(snapshot)
    var entry: WinProcessEntry
    entry.size = (u32)memory.size_of(WinProcessEntry)
    var found = Process32FirstW(snapshot, &entry)
    let current = GetCurrentProcessId()
    while found != 0:
        if entry.pid == current:
            return (i32)entry.parent
        found = Process32NextW(snapshot, &entry)
    return 0
"""

## The text of `src/std/io.lucb`.
let text_11: str = r"""#==============================================================================================
#
#   io - Byte streams
#
#   DESCRIPTION:
#       Readers and writers over bytes, buffered wrappers, the standard output and error
#       streams, the user's home directory, and the stream error codes.
#
#==============================================================================================

import c
import core
import memory
import platform
import os
import strings
extern func fwrite(data: const void*, size: usize, count: usize, stream: void*) -> usize
extern func fflush(stream: void*?) -> i32
extern func flockfile(stream: void*)
extern func funlockfile(stream: void*)
extern func win_lock_file as "_lock_file"(stream: void*)
extern func win_unlock_file as "_unlock_file"(stream: void*)
extern func posix_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func windows_read as "_read"(descriptor: i32, buffer: void*, count: u32) -> i32

func c_read(descriptor: i32, buffer: void*, count: usize) -> isize:
    if platform.windows:
        return (isize)windows_read(descriptor, buffer, (u32)(count if count < 2147483647 else 2147483647))
    return posix_read(descriptor, buffer, count)

## A borrowed byte source. A successful read returns at most the buffer length;
## zero for a nonempty buffer means EOF. Empty reads return zero without consuming
## input. Errors are distinct from EOF. The implementing object owns its lifetime.
pub interface Reader:
    func read(buffer: u8[]) -> usize!

## A borrowed byte sink (§14.4). A write may accept fewer bytes than supplied;
## callers needing the whole payload use `write_all`. Empty writes return zero.
## A failure may follow earlier successful writes; the view never owns the sink.
pub interface Writer:
    func write(data: const u8[]) -> usize!

## A stream ended before the expected bytes arrived.
pub let unexpected_eof: ErrorCode = ErrorCode.package(14)
## A stream made no progress and cannot continue.
pub let no_progress: ErrorCode = ErrorCode.package(15)
## A read or write was asked for an invalid count.
pub let invalid_count: ErrorCode = ErrorCode.package(16)
## A read or write was given an invalid buffer.
pub let invalid_buffer: ErrorCode = ErrorCode.package(17)

## Fill `buffer`, or fail at EOF or on a source error. Optional `transferred` is
## reset to zero on entry and updated after each successful read, including before
## a later failure. It must not overlap the buffer or the source's state. No call
## reaches the source for an empty buffer. The source remains borrowed and open.
pub func read_exact(source: Reader, buffer: u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < buffer.length:
        let count = try source.read(buffer[done..])
        if count > buffer.length - done:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            error(unexpected_eof, "the reader ended before the buffer was filled")
        done += count
        if let progress = transferred:
            *progress = done

## Write all bytes, preserving confirmed progress through `transferred` on error.
## The progress pointer must not overlap the data or sink state. A zero-length
## successful write on nonempty input fails with `no_progress` instead of spinning.
## This does not flush or close the borrowed sink. Empty input makes no sink call.
pub func write_all(destination: Writer, data: const u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < data.length:
        let count = try destination.write(data[done..])
        if count > data.length - done:
            error(invalid_count, "the writer returned more bytes than supplied")
        if count == 0:
            error(no_progress, "the writer accepted no bytes")
        done += count
        if let progress = transferred:
            *progress = done

## Copy at most `limit` bytes through caller-owned scratch storage; stop earlier
## at EOF. Reads never consume beyond the limit. `transferred` counts confirmed
## destination bytes, including before a failure; source consumption can be ahead
## by one scratch buffer if writing fails. Scratch and progress must not overlap
## either endpoint's state/data or each other. No allocation, flush or close occurs.
pub func copy_limit(source: Reader, destination: Writer, buffer: u8[], limit: usize, transferred: usize*? = none) -> usize!:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    if limit == 0:
        return 0
    if buffer.length == 0:
        error(invalid_buffer, "copying requires a nonempty scratch buffer")
    while done < limit:
        let available = limit - done
        let requested = buffer.length if buffer.length < available else available
        let count = try source.read(buffer[..<requested])
        if count > requested:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            break
        var written: usize = 0
        write_all(destination, buffer[..<count], &written) catch failure:
            if let progress = transferred:
                *progress = done + written
            error(failure.code, failure.message)
        done += written
        if let progress = transferred:
            *progress = done
    return done

## A cursor over borrowed bytes. Copying the reader copies its position, not its
## data. The backing storage must outlive the reader and every read using it.
pub struct SliceReader: Reader:
    var data: const u8[]
    var position: usize

    ## A reader over `data`.
    pub static func over(data: const u8[]) -> SliceReader:
        return SliceReader(data = data, position = 0)

    ## The number of bytes not yet read.
    pub func remaining() -> usize:
        return self.data.length - self.position

    ## Copy up to the buffer length; zero means no bytes remain (or an empty read).
    pub func read(buffer: u8[]) -> usize!:
        let left = self.remaining()
        let count = buffer.length if buffer.length < left else left
        memory.move(buffer, self.data[self.position..], count)
        self.position += count
        return count

## A writer into fixed borrowed storage. Copying it copies the cursor and aliases
## storage. Writes may be short; once full, a nonempty write fails with `full`.
pub struct SliceWriter: Writer:
    var data: u8[]
    var used: usize

    ## A writer into `data`.
    pub static func over(data: u8[]) -> SliceWriter:
        return SliceWriter(data = data, used = 0)

    ## View of confirmed written bytes, borrowed from the caller's storage.
    pub func written() -> const u8[]:
        return self.data[..<self.used]

    ## Write `data`; the number of bytes written.
    pub func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let left = self.data.length - self.used
        if left == 0:
            error(full, "the destination buffer is full")
        let count = data.length if data.length < left else left
        memory.move(self.data[self.used..], data, count)
        self.used += count
        return count

## Buffered input over a borrowed source and nonempty caller-owned storage. Both
## must outlive this adapter. Storage must not overlap source state or read buffers.
## Construct with `over`; serialize access and do not use copied adapters together.
## Reads may prefetch beyond the requested bytes. The adapter never closes its source.
pub struct BufferedReader: Reader:
    var source: Reader
    var storage: u8[]
    var position: usize
    var used: usize

    ## A buffered reader over `source`, using `storage`.
    pub static func over(source: Reader, storage: u8[]) -> BufferedReader!:
        if storage.length == 0:
            error(invalid_buffer, "buffered input requires nonempty storage")
        return BufferedReader(source = source, storage = storage, position = 0, used = 0)

    ## Unread bytes already fetched. No source operation occurs.
    pub func buffered() -> usize:
        return self.used - self.position

    ## Return buffered bytes first, otherwise perform one source read. Empty reads
    ## do not call the source. EOF is not cached, allowing a growing source to resume.
    pub func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        if self.position == self.used:
            let count = try self.source.read(self.storage)
            if count > self.storage.length:
                error(invalid_count, "the reader returned more bytes than requested")
            self.position = 0
            self.used = count
        let available = self.buffered()
        let count = buffer.length if buffer.length < available else available
        memory.copy(buffer, self.storage[self.position..], count)
        self.position += count
        return count

## Buffered output over a borrowed sink and nonempty caller-owned storage. Both
## must outlive this adapter; storage must not overlap sink state or write input.
## Construct with `over`; serialize access and do not use copied adapters together.
## Explicitly flush before discarding the adapter. There is no implicit flush/close.
pub struct BufferedWriter: Writer:
    var destination: Writer
    var storage: u8[]
    var used: usize

    ## A buffered writer over `destination`, using `storage`.
    pub static func over(destination: Writer, storage: u8[]) -> BufferedWriter!:
        if storage.length == 0:
            error(invalid_buffer, "buffered output requires nonempty storage")
        return BufferedWriter(destination = destination, storage = storage, used = 0)

    ## Bytes accepted by this adapter but not yet confirmed by the destination.
    pub func buffered() -> usize:
        return self.used

    ## Drain this buffer, preserving the unconfirmed suffix if the sink fails.
    ## Retrying does not resend bytes confirmed by earlier successful sink writes.
    ## This neither flushes downstream buffers nor requests filesystem durability.
    pub func flush() -> !:
        var written: usize = 0
        write_all(self.destination, self.storage[..<self.used], &written) catch failure:
            self.used -= written
            memory.move(self.storage, self.storage[written..], self.used)
            error(failure.code, failure.message)
        self.used = 0

    ## Accept up to the remaining capacity. A full buffer is drained before any
    ## new input is accepted; a failure accepts none of this call's input. Empty
    ## writes do not drain the buffer. Use write_all to accept an entire payload.
    pub func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        if self.used == self.storage.length:
            try self.flush()
        let available = self.storage.length - self.used
        let count = data.length if data.length < available else available
        memory.copy(self.storage[self.used..], data, count)
        self.used += count
        return count

## A compile-time source position, the value of `luce.location`.
pub struct Location:
    ## The source file of the location.
    pub var file: str
    ## The source line of the location.
    pub var line: u32
    ## The enclosing function of the location.
    pub var function: str

## The stream is closed.
pub let closed: ErrorCode = ErrorCode.package(3)
## The underlying stream operation failed.
pub let failed: ErrorCode = ErrorCode.package(24)
## A non-blocking stream has no data ready.
pub let would_block: ErrorCode = ErrorCode.package(28)

## Borrowed standard output stream. Each nonempty write uses the existing libc
## stream and flushes only that stream, making completed output visible before a
## following print. The libc stream lock serializes each write with other libc
## users; concurrent direct descriptor writes may interleave. No stream is created
## or owned here. A write/flush failure can follow partial output.
pub struct File: Writer:
    var descriptor: i32

    func stream() -> void*!:
        if self.descriptor == 1:
            return c.stdout()
        if self.descriptor == 2:
            return c.stderr()
        error(closed, "the standard output stream is unavailable")

    ## Flush this C stream, without closing it or requesting filesystem durability.
    pub func flush() -> !:
        let stream = try self.stream()
        if fflush(stream) != 0:
            error(closed, "the stream could not be flushed")

    ## Write `data`; the number of bytes written.
    pub func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let stream = try self.stream()
        lock_stream(stream)
        defer unlock_stream(stream)
        let written = fwrite(data.data, 1, data.length, stream)
        let flushed = fflush(stream)
        if written != data.length or flushed != 0:
            error(closed, "the stream refused the bytes")
        return written

func lock_stream(stream: void*):
    if platform.windows:
        win_lock_file(stream)
    else:
        flockfile(stream)

func unlock_stream(stream: void*):
    if platform.windows:
        win_unlock_file(stream)
    else:
        funlockfile(stream)

var out_file: File = File(descriptor = 1)
var err_file: File = File(descriptor = 2)

## Unbuffered input borrows descriptor zero. It retries interrupted calls, reports
## would-block separately, and never owns or closes the process's descriptor.
struct StandardInput: Reader:
    var descriptor: i32

    ## Read into `buffer`; the number of bytes read.
    pub func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        let requested = 1073741824 if buffer.length > 1073741824 else buffer.length
        while true:
            let count = c_read(self.descriptor, buffer.data, requested)
            if count >= 0:
                return (usize)count
            let number = c.errno()
            if number == c.interrupted:
                continue
            if number == (35 if platform.macos else 11):
                error(would_block, "standard input would block")
            if number == 9:
                error(closed, "standard input is closed")
            error(failed, "standard input could not be read")

var in_file: StandardInput = StandardInput(descriptor = 0)

## Borrowed unbuffered standard input. Reads may block; concurrent readers compete
## for bytes. Do not mix with buffered C stdin reads, which may have prefetched data.
pub func stdin() -> Reader:
    return &in_file

## The process's standard output stream.
# mark: Standard streams ======================================================================

## A writer over the process's standard output.
pub func stdout() -> Writer:
    return &out_file

## The process's standard error stream.
pub func stderr() -> Writer:
    return &err_file

## Explicitly flush C stdout, including bytes written through C interop.
pub func flush_stdout() -> !:
    try out_file.flush()

## Explicitly flush C stderr, including bytes written through C interop.
pub func flush_stderr() -> !:
    try err_file.flush()

## A fixed writer has no room left.
pub let full: ErrorCode = ErrorCode.package(4)

## The sink a formatted string offers a `Display` value (§14.4): it appends to the buffer
## the compiler is filling, and fails once that buffer is full, as `format` then does.
pub struct FormatSink: Writer:
    var buffer: core.FormatBuffer*

    ## Write `data`; the number of bytes written.
    pub func write(data: const u8[]) -> usize!:
        if core.format_put(self.buffer, data.data, data.length) != 0:
            error(full, "the buffer is full")
        return data.length

## The process's directories (§16.6): `from io import path`, then `path.user()`. Each is
## a `str` view of environment storage the system owns, or fresh storage from the current
## allocator where one has to be built.
pub struct path:
    var unused: u8

    ## The user's home directory: USERPROFILE on Windows, HOME on POSIX.
    pub static func user() -> str!:
        let home = os.env("USERPROFILE" if platform.windows else "HOME") else error(io_path_failed, "no home directory")
        return home

    ## The current user's home directory.
    pub static func home() -> str!:
        return try path.user()

    ## Where temporary files go: `$TMPDIR`, else `/tmp`.
    pub static func temp() -> str:
        if platform.windows:
            if let dir = os.env("TEMP"):
                if dir.length > 0: return dir
            if let dir = os.env("TMP"):
                if dir.length > 0: return dir
            return "."
        let dir = os.env("TMPDIR") else return "/tmp"
        return dir

    ## Where configuration lives: `$XDG_CONFIG_HOME`, else `$HOME/.config`.
    pub static func config() -> str!:
        if platform.windows:
            if let set = os.env("APPDATA"):
                if set.length > 0: return set
            let home = try path.user()
            let buffer = try new u8[home.length + 17] ---
            return try strings.format(buffer, f"{home}/AppData/Roaming")
        if let set = os.env("XDG_CONFIG_HOME"):
            return set
        let home = try path.user()
        let buffer = try new u8[home.length + 9] ---
        return try strings.format(buffer, f"{home}/.config")

## The home directory could not be determined.
pub let io_path_failed: ErrorCode = ErrorCode.package(13)
"""

## The text of `src/std/luce.lucb`.
let text_12: str = r"""#==============================================================================================
#
#   luce - The derived interface bounds
#
#   DESCRIPTION:
#       The derived bounds of §14.4: every type with `==` is Equatable, every hashable one
#       Hashable, every ordered one Comparable. Nothing implements them by hand.
#
#==============================================================================================

import io

## Implemented by every type with `==`.
pub interface Equatable:
    func equals(other: void*) -> bool

## Implemented by every hashable type: `value.hash()` (§7.4).
pub interface Hashable:
    func hash() -> u64

## Implemented by every ordered type.
pub interface Comparable:
    func compare(other: void*) -> i64

## The protocols `for` consumes (§8.3, §14.4): a value iterator answers each element
## until `none`; an iterable answers a fresh iterator of its own concrete type.
pub interface Iterator[T]:
    func next() -> T?

## A type a `for` loop can walk: it yields an iterator of `T` (§13.3).
pub interface Iterable[T, I: Iterator[T]]:
    func iterator() -> I

## A value that writes itself to a sink (§14.4); formatted strings call it for each field.
pub interface Display:
    func display(sink: io.Writer) -> !

## The source file of the use site; the backend replaces it (§9.1).
pub let file: str = ""
## The source line of the use site; the backend replaces it (§9.1).
pub let line: u32 = 0
## The enclosing function of the use site; the backend replaces it (§9.1).
pub let function: str = ""
## The use site's file, line and function together (§9.1).
pub let location: io.Location = io.Location(file = "", line = 0, function = "")
"""

## The text of `src/std/atomic.lucb`.
let text_13: str = r"""#==============================================================================================
#
#   atomic - Memory orderings and fences for `@T` operations
#
#   DESCRIPTION:
#       Memory orderings for the operations of `@T` (§15.1).
#
#==============================================================================================

## The memory ordering of an `@T` operation.
pub enum Ordering as u8:
    relaxed = 1
    acquire = 2
    release = 3
    acq_rel = 4
    seq_cst = 5
    ## A fence's alone: the compiler moves no memory access across it, and the processor is
    ## told nothing, what a signal handler sharing data with the code it interrupts needs.
    signal = 6

## A standalone fence; the backend supplies the instruction.
pub func fence(order: Ordering):
    _ = order
"""

## The text of `src/std/time.lucb`.
let text_14: str = r"""#==============================================================================================
#
#   time - Monotonic and wall-clock time
#
#   DESCRIPTION:
#       A monotonic clock that never goes backwards, and the wall clock as seconds since the
#       Unix epoch, over the host's `clock_gettime`.
#
#==============================================================================================

import c
import platform
extern func clock_gettime(clock: i32, out_time: Stamp*) -> i32
extern func c_time as "time"(out_time: void*?) -> i64

## `struct timespec`: `tv_nsec` is a C `long`, four bytes on Windows.
extern struct Stamp:
    seconds: i64
    nanoseconds: c.long

## `CLOCK_MONOTONIC`: 6 on macOS, 1 on Linux; `CLOCK_REALTIME` is 0 on both.
let monotonic: i32 = 6 if platform.macos else 1
let realtime: i32 = 0

## The clock read into `stamp`: the monotonic one or the wall clock.
func read_clock(monotonic_clock: bool, stamp: Stamp*) -> i32:
    return clock_gettime(monotonic if monotonic_clock else realtime, stamp)

## Nanoseconds from an arbitrary origin, never going backwards.
pub func now() -> u64:
    var stamp = Stamp(seconds = 0, nanoseconds = 0)
    _ = read_clock(true, &stamp)
    return (u64)stamp.seconds * 1000000000 + (u64)stamp.nanoseconds

## Seconds since the Unix epoch.
pub func unix() -> i64:
    return c_time(none)

## Nanoseconds elapsed since `start`, from `now()`.
pub func since(start: u64) -> u64:
    let current = now()
    return current - start if current > start else 0
"""

## The text of `src/std/thread.lucb`.
let text_15: str = r"""#==============================================================================================
#
#   thread - Native threads
#
#   DESCRIPTION:
#       Spawning, joining and detaching host threads over pthreads (Windows through its own
#       primitives), with the running thread's identity and yielding and sleeping.
#
#==============================================================================================

from windows_abi import Sleep
import c
import core
import memory
import platform
import time
extern func pthread_create(thread: void*?*, attributes: void*?, start: func(void*) -> void*?, argument: void*) -> i32
extern func pthread_join(thread: void*, result: void*?*?) -> i32
extern func pthread_detach(thread: void*) -> i32
extern func pthread_self() -> void*
extern func pthread_main_np() -> i32
extern func getpid() -> i32
extern func gettid() -> i32
extern func pthread_attr_init(attributes: void*) -> i32
extern func pthread_attr_setstacksize(attributes: void*, size: usize) -> i32
extern func pthread_attr_destroy(attributes: void*) -> i32
## macOS names the calling thread; Linux names one by handle. Both cap a name at 15 bytes.
extern func mac_setname as "pthread_setname_np"(name: c.str) -> i32
extern func linux_setname as "pthread_setname_np"(thread: void*, name: c.str) -> i32
extern func sched_yield() -> i32
extern func nanosleep(request: const Duration*, remaining: Duration*?) -> i32

## `struct timespec`: `tv_nsec` is a C `long`, four bytes on Windows.
extern struct Duration:
    seconds: i64
    nanoseconds: c.long

## A thread operation the operating system refused.
# mark: Threads ===============================================================================

## A thread operation failed.
pub let failed: ErrorCode = ErrorCode.package(5)

## `PTHREAD_STACK_MIN`: 16 KiB on macOS and x86-64 glibc; a smaller stack is raised to it.
let least_stack: usize = 16384
## The stack of a thread spawned without a size: 8 MiB on every host, the main thread's
## on Linux, where macOS gives a new thread 512 KiB and Windows 1 MiB. A program may set
## it before it spawns; `spawn(..., stack = n)` overrides it for one thread.
pub var default_stack: usize = 8388608
## The longest name a thread may carry, with its NUL.
let name_room: usize = 16
## What gives a new thread's `local var`s their initialisers (§6.3), run before its entry.
## The native backend's startup sets it when the program has such initialisers, since its
## thread-local storage starts zeroed; under C, `_Thread_local` storage starts initialised
## and it stays none.
pub var locals_start: (func() -> unit)?

## A running thread; the zero value is no thread at all, so arrays of handles exist.
pub struct Handle:
    var id: void*?

    ## Wait for the thread to finish.
    pub func join() -> !:
        let id = self.id else error(failed, "no thread to join")
        if pthread_join(id, none) != 0:
            error(failed, "join")

    ## Let the thread run on its own; its resources are reclaimed at exit.
    pub func detach():
        let id = self.id else return
        _ = pthread_detach(id)

## What a new thread starts with: the entry, its context, its name in a heap block of
## `name_room` bytes, NUL-terminated, and the allocator rule of §15.3.
struct Start:
    var entry: func(void*?) -> unit
    var context: void*?
    var name: u8[]
    var name_length: usize

func trampoline(raw: void*) -> void*?:
    let start = (Start*)raw
    if let initialise = locals_start:
        initialise()
    memory.allocator = memory.heap
    let entry = start.entry
    let context = start.context
    if start.name_length > 0:
        let text = (c.str)(str)start.name[..<start.name_length]
        if platform.macos:
            _ = mac_setname(text)
        else:
            _ = linux_setname(pthread_self(), text)
    release_start(start)
    entry(context)
    return none

## Free what `spawn` handed the new thread: the start record and its copy of the name.
func release_start(start: Start*):
    free(start.name) in memory.heap
    free(start) in memory.heap

## Start a thread running `entry(context)`. `stack` is its stack in bytes, `default_stack`
## when 0, at least `PTHREAD_STACK_MIN` and whole pages; `name` is what the host's tools
## show for it, its first fifteen bytes.
pub func spawn(entry: func(void*?) -> unit, context: void*?, stack: usize = 0, name: str = "") -> Handle!:
    let copy = try new u8[name_room] --- in memory.heap
    # on success the thread owns both, and `trampoline` frees them
    errdefer free(copy) in memory.heap
    let kept = name.length if name.length < name_room - 1 else name_room - 1
    memory.copy(copy, name.bytes, kept)
    copy[kept] = 0
    let start = new Start(entry = entry, context = context, name = copy, name_length = kept) in memory.heap catch failure:
        error(memory.exhausted, "memory.exhausted")
    errdefer free(start) in memory.heap
    var attributes: u64[16]
    if pthread_attr_init((void*)&attributes[0]) != 0:
        error(failed, "spawn")
    let wanted = stack if stack > 0 else default_stack
    let page = memory.page_size()
    var size = wanted if wanted > least_stack else least_stack
    size = (size + page - 1) // page * page
    if pthread_attr_setstacksize((void*)&attributes[0], size) != 0:
        _ = pthread_attr_destroy((void*)&attributes[0])
        error(failed, "the stack size is refused")
    var id: void*? = none
    let created = pthread_create(&id, (void*)&attributes[0], trampoline, (void*)start)
    _ = pthread_attr_destroy((void*)&attributes[0])
    if created != 0:
        error(failed, "spawn")
    let thread = id else error(failed, "spawn")
    return Handle(id = thread)

## A handle to the calling thread.
pub func current() -> Handle:
    return Handle(id = pthread_self())

## Whether this is the process's initial thread, for main-thread native resources.
pub func is_main() -> bool:
    if platform.windows:
        return core.on_initial_thread()
    if platform.macos:
        return pthread_main_np() != 0
    if platform.linux:
        return gettid() == getpid()
    return false

## A hint to the processor inside a spin loop.
pub func pause():
    asm arm64:
        yield
    asm x86_64:
        pause

## Yield the processor to another runnable thread.
pub func yield():
    _ = sched_yield()

## Sleep for at least `milliseconds`: a signal that interrupts the sleep leaves the time
## remaining, which is slept again.
pub func sleep(milliseconds: u64):
    if platform.windows:
        sleep_windows(milliseconds)
        return
    var request = Duration(seconds = (i64)(milliseconds // 1000), nanoseconds = (c.long)((i64)(milliseconds % 1000) * 1000000))
    var remaining = Duration(seconds = 0, nanoseconds = 0)
    while nanosleep(&request, &remaining) != 0 and c.errno() == c.interrupted:
        request = remaining

## Windows rounds waits to clock ticks and may wake before the requested interval.
## Recheck a monotonic deadline without changing system-wide timer resolution. A
## finite chunk also avoids narrowing long durations to Sleep's INFINITE sentinel.
func sleep_windows(milliseconds: u64):
    if milliseconds == 0:
        Sleep(0)
        return
    let longest_finite_wait: u64 = 0xFFFFFFFE
    let start = time.now()
    var elapsed: u64 = 0
    while elapsed < milliseconds:
        let remaining = milliseconds - elapsed
        Sleep((u32)(remaining if remaining < longest_finite_wait else longest_finite_wait))
        elapsed = time.since(start) // 1000000
"""

## The text of `src/std/sync.lucb`.
let text_16: str = r"""#==============================================================================================
#
#   sync - Locks, conditions, once and semaphores
#
#   DESCRIPTION:
#       Blocking synchronisation over the host's futex-like wait and wake: a mutex, a condition
#       variable, a run-once gate, and a counting semaphore.
#
#       The host's sleep returns on wakes nothing here sent: Linux and macOS rarely, and
#       Windows often when a thread waiting on an address less than 32 bytes away is woken.
#       Every sleep below checks its own word again and sleeps again when it has not
#       changed, so such a wake costs a context switch and is never seen by a caller.
#
#==============================================================================================

import platform
import time

## macOS: the `ulock` calls libSystem builds its own locks on.
extern func __ulock_wait(operation: u32, address: void*, value: u64, timeout: u32) -> i32
extern func __ulock_wake(operation: u32, address: void*, wake_value: u64) -> i32
## Linux: the futex system call, through `syscall`; the number is the architecture's.
extern func syscall(number: i64, ...) -> i64
extern func WaitOnAddress(address: void*, comparison: u32*, size: usize, milliseconds: u32) -> i32
extern func WakeByAddressSingle(address: void*)
extern func WakeByAddressAll(address: void*)

let compare_and_wait: u32 = 1
let wake_all: u32 = 256
let futex_number: i64 = 98 if platform.arm64 else 202
let futex_wait_private: i32 = 128
let futex_wake_private: i32 = 129

## Sleep in the kernel while the word at `address` still holds `value`; a change
## or a wake returns, and so may nothing at all, so every caller loops.
func sleep_on(address: void*, value: u32):
    if platform.windows:
        var expected = value
        _ = WaitOnAddress(address, &expected, 4, 4294967295)
    elif platform.macos:
        _ = __ulock_wait(compare_and_wait, address, (u64)value, 0)
    else:
        let no_timeout: void*? = none
        _ = syscall(futex_number, address, futex_wait_private, value, no_timeout)

## `sleep_on`, giving up after about `milliseconds`: a timeout, a change, a wake or nothing
## at all return, so every caller loops against its own deadline.
func sleep_on_for(address: void*, value: u32, milliseconds: u64):
    if milliseconds == 0:
        return
    if platform.windows:
        var expected = value
        _ = WaitOnAddress(address, &expected, 4, (u32)(milliseconds if milliseconds < 4294967294 else 4294967294))
    elif platform.macos:
        # microseconds, where 0 would wait for ever
        let micros = milliseconds *? 1000 else 4294967295
        _ = __ulock_wait(compare_and_wait, address, (u64)value, (u32)(micros if micros < 4294967295 else 4294967295))
    else:
        var timeout = Timeout(seconds = (i64)(milliseconds // 1000), nanoseconds = (i64)(milliseconds % 1000) * 1000000)
        _ = syscall(futex_number, address, futex_wait_private, value, &timeout)

## A relative `timespec` for the futex call.
extern struct Timeout:
    seconds: i64
    nanoseconds: i64

func wake_one(address: void*):
    if platform.windows:
        WakeByAddressSingle(address)
    elif platform.macos:
        _ = __ulock_wake(compare_and_wait, address, 0)
    else:
        _ = syscall(futex_number, address, futex_wake_private, 1)

func wake_every(address: void*):
    if platform.windows:
        WakeByAddressAll(address)
    elif platform.macos:
        _ = __ulock_wake(compare_and_wait | wake_all, address, 0)
    else:
        _ = syscall(futex_number, address, futex_wake_private, 2147483647)

## A lock whose waiters sleep: zero is unlocked, so `var lock: Mutex` is ready to
## use; one is locked; two is locked with someone asleep on it.
## A mutual-exclusion lock; a waiter sleeps until it is free.
pub struct Mutex:
    var state: @u32

    ## Acquire the lock, blocking until it is free.
    pub func lock():
        let (taken, seen) = self.state.cas(0, 1, .acquire, .relaxed)
        if taken:
            return
        var current = seen
        if current != 2:
            current = self.state.swap(2, .acquire)
        while current != 0:
            sleep_on((void*)&self.state, 2)
            # still held with sleepers: not the holder's wake, so sleep again
            if self.state.load(.relaxed) == 2:
                continue
            current = self.state.swap(2, .acquire)

    ## Release the lock and wake one waiter.
    pub func unlock():
        if self.state.swap(0, .release) == 2:
            wake_one((void*)&self.state)

    ## Acquire the lock without blocking; whether it was taken.
    pub func try_lock() -> bool:
        let (taken, seen) = self.state.cas(0, 1, .acquire, .relaxed)
        _ = seen
        return taken

## A sequence number waiters watch; every signal advances it and wakes.
## A condition variable: waiters sleep until signalled. As with every condition variable,
## a waiter checks its predicate in a loop around `wait`: a signal says that something
## changed, not what, and another thread may have acted on it first.
pub struct Condition:
    var sequence: @u32

    ## Release `mutex`, sleep until signalled, then reacquire it. A wake with no signal
    ## since the call is not returned; a signal or broadcast meant for another waiter may be.
    pub func wait(mutex: Mutex*):
        let seen = self.sequence.load(.acquire)
        mutex.unlock()
        while self.sequence.load(.acquire) == seen:
            sleep_on((void*)&self.sequence, seen)
        mutex.lock()

    ## `wait`, giving up after about `milliseconds`; a caller tells a timeout from a signal
    ## by checking its predicate.
    pub func wait_for(mutex: Mutex*, milliseconds: u64):
        let seen = self.sequence.load(.acquire)
        mutex.unlock()
        let start = time.now()
        var left = milliseconds
        while left > 0 and self.sequence.load(.acquire) == seen:
            sleep_on_for((void*)&self.sequence, seen, left)
            let waited = time.since(start) // 1000000
            left = milliseconds - waited if waited < milliseconds else 0
        mutex.lock()

    ## Wake one waiter.
    pub func signal():
        _ = self.sequence.add(1, .release)
        wake_one((void*)&self.sequence)

    ## Wake every waiter.
    pub func broadcast():
        _ = self.sequence.add(1, .release)
        wake_every((void*)&self.sequence)

## Runs its function exactly once; later callers wait for the first to finish.
## Runs a function exactly once; later callers wait for the first.
pub struct Once:
    var state: @u32

    ## Run `function` on the first call; later calls wait for it to finish.
    pub func run(function: func() -> unit):
        let (first, seen) = self.state.cas(0, 1, .acq_rel, .acquire)
        _ = seen
        if first:
            function()
            self.state.store(2, .release)
            wake_every((void*)&self.state)
            return
        while self.state.load(.acquire) != 2:
            sleep_on((void*)&self.state, 1)

## A counting semaphore whose waiters sleep.
## A counting semaphore whose waiters sleep.
pub struct Semaphore:
    var count: @u32

    ## Take one permit, blocking until one is available.
    pub func acquire():
        while true:
            let n = self.count.load(.acquire)
            if n > 0:
                let (taken, seen) = self.count.cas(n, n - 1, .acq_rel, .relaxed)
                _ = seen
                if taken:
                    return
            else:
                sleep_on((void*)&self.count, 0)

    ## Return one permit and wake one waiter.
    pub func release():
        _ = self.count.add(1, .release)
        wake_one((void*)&self.count)

# mark: Cancellation ========================================================================

## A one-way cancellation signal shared by reference. Zero is not requested.
## Keep this object alive until every waiting thread returns; do not copy or reset
## it while shared. Requests use release/acquire synchronization.
pub struct Cancellation:
    var requested: @u32

    ## Request cancellation.
    pub func request():
        self.requested.store(1, .release)

    ## Whether cancellation was requested.
    pub func is_requested() -> bool:
        return self.requested.load(.acquire) != 0
"""

## The text of `src/std/ownership/module.lucb`.
let text_17: str = r"""#==============================================================================================
#
#   ownership - Intrusive ownership shared by Base and Luce
#
#   DESCRIPTION:
#       Intrusive ownership shared by Base libraries and compiled Luce programs. Base callers
#       retain and release explicitly; Luce inserts those operations. One header and trace
#       protocol cover native/managed cycles on the owning thread. Runtime allocations use the
#       system heap; an explicit allocator can be supplied to reserve when its lifetime is
#       guaranteed by the native owner.
#
#==============================================================================================

import c
import io
import memory
import core

# mark: Objects ================================================================================

let black: u8 = 0
let gray: u8 = 1
let white: u8 = 2
let purple: u8 = 3
let color_mask: u8 = 3
let buffered: u8 = 4
let dead: u8 = 8
let collecting: u8 = 16
## A literal's text: never counted, never released, never alive at the end.
pub let immortal: u8 = 32
## An object whose `init` failed, while `abandon` releases its fields: a release of it is
## bookkeeping only and the collector never walks into it.
let abandoning: u8 = 64

## The ownership header every managed object carries, before its fields.
pub struct Object:
    ## The strong reference count; the object is finalized when it reaches zero.
    pub var strong: u32
    ## The number of weak references watching the object.
    pub var weak: u32
    ## The collector's color and state bits (§the cycle collector).
    pub var flags: u8
    ## The object's class description.
    pub var info: Info*
    ## Allocation identity never repeats, even when an allocator reuses an address.
    pub var generation: u64
    ## The owning context the object belongs to.
    pub var context: u64
    ## The size of the object's allocation in bytes.
    pub var allocation_size: usize
    ## The allocator that made the object, when one was supplied explicitly.
    pub var allocator: memory.Allocator?

## What the collector and the destructor need to know about a class.
pub struct Info:
    ## The class name, for diagnostics and the collector.
    pub var name: str
    ## The object's size in bytes, its fields included.
    pub var size: usize
    ## `deinit`, when the class declares one.
    pub var finish: (func(Object*) -> unit)?
    ## Releases the fields in reverse declaration order, tolerating unassigned ones.
    pub var drop: func(Object*) -> unit
    ## Visits every strong reference the object holds, fields in declaration order.
    pub var trace: func(Object*, func(Object*, void*) -> unit, void*) -> unit
    ## An interface adapter preserves the identity of its concrete owner.
    pub var identity: (func(Object*) -> u64)? = none
    ## No object of this type can be part of a reference cycle (text, a list of numbers, a
    ## class whose fields are all such): the collector never takes one as a candidate nor
    ## walks into one, so large acyclic data costs it nothing.
    pub var acyclic: bool = false

## Objects alive: allocated and not yet destroyed.
local var live: usize = 0

## Allocated objects not yet finalized on the calling runtime thread.
pub func live_count() -> usize:
    return live

## Where the thread's program is: `file:line:column` of the Luce statement running, set by
## the compiled code before each statement and restored when a function returns; what a
## trap names (§12.4).
pub local var site: str

## The caller's site again, deferred by every function the compiler writes.
pub func restore_site(saved: str):
    site = saved

## Stop the program with `trap: file:line:column: message` on standard error and status 1.
pub func stop(message: str) -> never:
    core.trap_located(site, message)

func color_of(o: Object*) -> u8:
    return o.flags & color_mask

func set_color(o: Object*, color: u8):
    o.flags = (o.flags & ~color_mask) | color

func has(o: Object*, flag: u8) -> bool:
    return (o.flags & flag) != 0

var next_context: @u64 = 1
var next_generation: @u64 = 1
local var thread_context: u64 = 0
local var runtime_depth: u32 = 0

## A unique runtime identity for this thread, independent of recycled OS thread IDs.
pub func context_id() -> u64:
    if thread_context == 0:
        thread_context = next_context.add(1, .relaxed)
        if thread_context == 0:
            stop("runtime context identity exhausted")
    return thread_context

## Application runtime entry is separate from ordinary manual Base ownership.
## Generated callbacks require entry; native worker adapters establish it internally.
pub func enter():
    _ = context_id()
    runtime_depth += 1

## Trap when no owning context has been entered.
pub func require_context():
    if runtime_depth == 0:
        stop("a managed callback needs a runtime entry on this thread")

## Trap when `o` is touched from a thread other than its owner.
pub func check_thread(o: Object*):
    if not has(o, immortal) and o.context != context_id():
        stop("an object belongs to another runtime thread")

## Trap when `o` has already been finalized.
pub func check_alive(o: Object*):
    check_thread(o)
    if has(o, dead) or o.strong == 0:
        stop("an object has already been destroyed")

## Reserve unpublished storage. The caller supplies a stable descriptor before
## publishing the object and abandons the storage if native initialization fails.
pub func reserve(info: Info*, size: usize, allocator: memory.Allocator? = none) -> Object*!:
    if size < memory.size_of(Object):
        stop("an object allocation is smaller than its header")
    let selected = allocator else memory.heap
    let block = selected.allocate(size, 16) else error(memory.exhausted, "memory.exhausted")
    memory.set(block, 0)
    let o = (Object*)block.data
    o.strong = 1
    o.info = info
    o.context = context_id()
    o.generation = next_generation.add(1, .relaxed)
    if o.generation == 0:
        stop("object allocation identity exhausted")
    o.allocation_size = block.length
    o.allocator = selected
    live += 1
    return o

## Allocate an object of class `info` and its header.
pub func allocate(info: Info*) -> Object*:
    return allocate_sized(info, info.size)

## Runtime wrapper/text allocation retains Luce's trap-on-exhaustion policy.
pub func allocate_sized(info: Info*, size: usize) -> Object*:
    return reserve(info, size) catch failure:
        trap("out of memory")

## Add a strong reference to `o` and return it.
pub func retain(o: Object*) -> Object*:
    check_alive(o)
    if has(o, immortal):
        return o
    o.strong += 1
    set_color(o, black)
    return o

## Drop a strong reference to `o`, finalizing it when the count reaches zero.
pub func release(o: Object*):
    check_thread(o)
    if has(o, immortal):
        return
    if has(o, collecting) or has(o, abandoning):
        # a white object's field, released while the collector drops it, or a reference
        # back to an object `abandon` is dropping: the count is bookkeeping only, the
        # collector or `abandon` frees the object
        if o.strong > 0:
            o.strong -= 1
        return
    check_alive(o)
    o.strong -= 1
    if o.strong == 0:
        destroy(o)
    elif not o.info.acyclic:
        possible_root(o)

## `deinit`, then the fields, then the storage unless a weak reference keeps the shell.
func destroy(o: Object*):
    set_color(o, black)
    if let f = o.info.finish:
        o.strong = 1
        f(o)
        if o.strong != 1:
            trap("`deinit` published `self`")
        o.strong = 0
    o.info.drop(o)
    live -= 1
    o.flags |= dead
    if not has(o, buffered):
        release_shell(o)

## The storage goes when nothing, strong or weak or the candidate buffer, refers to it.
func release_shell(o: Object*):
    if o.weak == 0 and has(o, dead) and not has(o, buffered):
        let allocator = o.allocator else stop("an object has no allocation owner")
        let block = u8[]((u8*)o, o.allocation_size)
        free(block) in allocator

## Free unpublished storage without invoking the successful object's cleanup.
## The native initializer owns cleanup of its partially acquired resources.
pub func discard_unpublished(o: Object*):
    check_alive(o)
    if o.strong != 1 or o.weak != 0 or has(o, buffered):
        stop("an incomplete object was published")
    live -= 1
    o.strong = 0
    o.flags |= dead
    release_shell(o)

## An `init` that failed: the fields assigned so far go, no `deinit` runs. Like `destroy`,
## the object leaves the collector's candidates first, so a collection the drop sets off
## never walks fields already released. What the fields held that refers back to the
## object, a closure over `self` or a child holding its parent, lets go of it in the drop;
## a reference still held after that was published by the failed `init`, which stops the
## program rather than leave it pointing at freed storage.
pub func abandon(o: Object*):
    check_alive(o)
    set_color(o, black)
    o.flags |= abandoning
    o.info.drop(o)
    o.flags &= ~abandoning
    if o.strong != 1:
        stop("a failed `init` published `self`")
    live -= 1
    o.strong = 0
    o.flags |= dead
    if not has(o, buffered):
        release_shell(o)

## The allocation identity, or the concrete owner's identity through an adapter.
pub func identity(object: Object*) -> u64:
    check_alive(object)
    if let resolve = object.info.identity:
        return resolve(object)
    return object.generation
"""

## The text of `src/std/ownership/pool.lucb`.
let text_18: str = r"""#==============================================================================================
#
#   pool - The temporaries pool
#
#   DESCRIPTION:
#       Owned values handed on as temporaries, released together by the next `drain`; the
#       generators emit `mark`/`drain` pairs around a statement's operands.
#
#==============================================================================================

# mark: The temporaries pool ===================================================================

struct Pending:
    var object: Object*?
    var cell: void*?
    var drop: (func(void*) -> unit)?
    var size: usize

local var pending: Pending[]
local var pending_count: usize = 0

## The current pool position, to `drain` back to later.
pub func mark() -> usize:
    return pending_count

func push_pending(p: Pending):
    if pending_count == pending.length:
        pending = grow(pending, pending_count, 64)
    pending[pending_count] = p
    pending_count += 1

## An owned object handed on as a temporary: released by the next `drain`.
pub func pool_object(o: Object*) -> Object*:
    push_pending(Pending(object = o, cell = none, drop = none, size = 0))
    return o

## An owned value of any type handed on as a temporary; `drop` releases what it holds.
pub func pool_value[T](v: T, drop: func(void*) -> unit) -> T:
    let block = memory.heap.allocate(memory.size_of(T), memory.align_of(T)) else trap("out of memory")
    memory.write[T](block.data, v)
    push_pending(Pending(object = none, cell = block.data, drop = drop, size = memory.size_of(T)))
    return v

## Releases every temporary pooled since `mark`, in the order they were pooled.
pub func drain(since: usize):
    if pending_count <= since:
        return
    let count = pending_count
    var i = since
    while i < count:
        let p = pending[i]
        if let o = p.object:
            release(o)
        elif let cell = p.cell:
            if let d = p.drop:
                d(cell)
            release_cell(cell, p.size)
        i += 1
    # a release pools nothing of its own, so nothing was added above `count`
    pending_count = since

## Free a pooled value's block of `size` bytes, which `pool_value` took from the heap.
func release_cell(cell: void*, size: usize):
    free(u8[]((u8*)cell, size)) in memory.heap

## `items` in heap storage with room for twice as many (`least` when it had none), its
## first `count` kept and its old storage freed: the growth of the runtime's own lists.
## Out of memory traps, as the bookkeeping has no failure to report into.
func grow[T](items: T[], count: usize, least: usize) -> T[]:
    let grown = new T[items.length * 2 if items.length > 0 else least] --- in memory.heap catch failure:
        trap("out of memory")
    for i in 0..<count:
        grown[i] = items[i]
    if items.length > 0:
        free(items) in memory.heap
    return grown
"""

## The text of `src/std/ownership/cycles.lucb`.
let text_19: str = r"""#==============================================================================================
#
#   cycles - The cycle collector
#
#   DESCRIPTION:
#       A synchronous trial-deletion collector for reference cycles on the owning thread,
#       run when the candidate set fills or at the end of a run. An object whose type is
#       acyclic is never a candidate and never walked into: it cannot be part of a cycle,
#       and every visitor skipping it keeps the trial counts balanced.
#
#==============================================================================================

# mark: The cycle collector ====================================================================
pub let candidate_limit: usize = 1024
local var roots: Object*[]
local var root_count: usize = 0
local var whites: Object*[]
local var white_count: usize = 0
local var collector_running: bool = false
## `LUCE_CYCLE_STRESS` in the environment: 0 not read yet, 1 absent, 2 present.
var stress_state: @u8
extern func stress_getenv as "getenv"(name: c.str) -> c.str?

## Whether `LUCE_CYCLE_STRESS` is set: the collector then runs at every new candidate, so a
## collection happens at every release that could leave a cycle, in `clear`, `remove`, a
## `deinit` and a failed `init` too (the stress mode of luce's tools/cycles_fuzz.py). The
## environment is read once; every thread reads the same answer.
func stressed() -> bool:
    var state = stress_state.load(.relaxed)
    if state == 0:
        state = 2 if stress_getenv("LUCE_CYCLE_STRESS") != none else 1
        stress_state.store(state, .relaxed)
    return state == 2

func push_root(o: Object*):
    if root_count == roots.length:
        roots = grow(roots, root_count, candidate_limit)
    roots[root_count] = o
    root_count += 1

func push_white(o: Object*):
    if white_count == whites.length:
        whites = grow(whites, white_count, 256)
    whites[white_count] = o
    white_count += 1

func possible_root(o: Object*):
    if color_of(o) != purple:
        set_color(o, purple)
        if not has(o, buffered):
            o.flags |= buffered
            push_root(o)
            if (root_count >= candidate_limit or stressed()) and not collector_running:
                collect()

## An object no walk enters: a literal, an acyclic one, or one `abandon` is dropping.
func skipped(child: Object*) -> bool:
    return has(child, immortal) or child.info.acyclic or has(child, abandoning)

func visit_mark_gray(child: Object*, context: void*):
    if skipped(child):
        return
    check_thread(child)
    child.strong -= 1
    mark_gray(child)

func mark_gray(o: Object*):
    if color_of(o) != gray:
        set_color(o, gray)
        o.info.trace(o, visit_mark_gray, (void*)o)

func visit_scan(child: Object*, context: void*):
    if skipped(child):
        return
    check_thread(child)
    scan(child)

func visit_scan_black(child: Object*, context: void*):
    if skipped(child):
        return
    check_thread(child)
    child.strong += 1
    if color_of(child) != black:
        scan_black(child)

func scan(o: Object*):
    if color_of(o) == gray:
        if o.strong > 0:
            scan_black(o)
        else:
            set_color(o, white)
            o.info.trace(o, visit_scan, (void*)o)

func scan_black(o: Object*):
    set_color(o, black)
    o.info.trace(o, visit_scan_black, (void*)o)

func visit_gather(child: Object*, context: void*):
    if skipped(child):
        return
    check_thread(child)
    gather(child)

## The white objects, each once, flagged as being collected (`sort_whites` orders them).
func gather(o: Object*):
    if color_of(o) == white and not has(o, collecting):
        o.flags |= collecting
        push_white(o)
        o.info.trace(o, visit_gather, (void*)o)

## Undo the trial deletion of one edge out of a garbage object. `mark_gray` took one count
## for every edge it walked; `scan_black` gave back those out of objects found reachable, but
## an edge out of garbage is still missing, whether it points at more garbage or at a live
## object. Restoring every one lets each field release below be an ordinary release: a live
## object loses exactly the reference the garbage held, where it once lost two.
func visit_restore(child: Object*, context: void*):
    if skipped(child):
        return
    check_thread(child)
    child.strong += 1

## The garbage in the order its objects were made, oldest first (their generations): what a
## cycle's deinits and the releases of its fields follow, the same in a compiled program and
## Luce's interpreter whatever let go of what when (a heap sort, in place).
func sort_whites():
    var start = white_count // 2
    while start > 0:
        start -= 1
        sift_white(start, white_count)
    var end = white_count
    while end > 1:
        end -= 1
        let top = whites[0]
        whites[0] = whites[end]
        whites[end] = top
        sift_white(0, end)

func sift_white(first: usize, end: usize):
    var root = first
    while root * 2 + 1 < end:
        var child = root * 2 + 1
        if child + 1 < end and whites[child + 1].generation > whites[child].generation:
            child += 1
        if whites[root].generation >= whites[child].generation:
            return
        let held = whites[root]
        whites[root] = whites[child]
        whites[child] = held
        root = child

## Free the garbage: deinits first, then every object's fields, then the storage.
pub func collect():
    if collector_running:
        return
    collector_running = true
    # candidates still purple and alive stay; the rest leave the buffer
    var kept: usize = 0
    var i: usize = 0
    while i < root_count:
        let o = roots[i]
        if color_of(o) == purple and o.strong > 0 and not has(o, dead):
            roots[kept] = o
            kept += 1
        else:
            o.flags &= ~buffered
            release_shell(o)
        i += 1
    root_count = kept
    i = 0
    while i < root_count:
        mark_gray(roots[i])
        i += 1
    i = 0
    while i < root_count:
        scan(roots[i])
        i += 1
    white_count = 0
    i = 0
    while i < root_count:
        gather(roots[i])
        i += 1
    i = 0
    while i < root_count:
        roots[i].flags &= ~buffered
        i += 1
    root_count = 0
    sort_whites()
    # the counts the trial deletion took for the garbage's edges are restored, to garbage and
    # to live objects alike, so that every field release below is an ordinary one; a release
    # of a white object then only lowers its count
    i = 0
    while i < white_count:
        whites[i].info.trace(whites[i], visit_restore, (void*)whites[i])
        i += 1
    i = 0
    while i < white_count:
        let o = whites[i]
        if let f = o.info.finish:
            let before = o.strong
            o.strong += 1
            f(o)
            if o.strong > before + 1:
                trap("`deinit` published `self`")
            # Native disposal may release edges, including an edge to itself.
            # Remove only the temporary finalizer reference, preserving those drops.
            o.strong -= 1
        i += 1
    i = 0
    while i < white_count:
        whites[i].info.drop(whites[i])
        i += 1
    i = 0
    while i < white_count:
        let o = whites[i]
        live -= 1
        o.strong = 0
        o.flags = dead
        release_shell(o)
        i += 1
    white_count = 0
    collector_running = false
"""

## The text of `src/std/ownership/weak.lucb`.
let text_20: str = r"""#==============================================================================================
#
#   weak - Weak references
#
#   DESCRIPTION:
#       A weak reference watches an object without keeping it alive, and yields it again only
#       while it is still alive.
#
#==============================================================================================

# mark: Weak references ========================================================================
## A weak reference: it watches an object without keeping it alive.
pub struct Weak:
    ## The watched object, or none once it is gone.
    pub var target: Object*?

## A weak reference watching `o`.
pub func weak_make(o: Object*) -> Weak:
    check_alive(o)
    if not has(o, immortal):
        o.weak += 1
    return Weak(target = o)

## A copy of `w`, counting one more watcher of its object.
pub func weak_copy(w: Weak) -> Weak:
    if let o = w.target:
        check_thread(o)
        if not has(o, immortal):
            o.weak += 1
    return w

## Drop `w`; the object's shell is freed when its last watcher goes.
pub func weak_drop(w: Weak):
    if let o = w.target:
        check_thread(o)
        if not has(o, immortal):
            o.weak -= 1
            release_shell(o)

## The object with a fresh strong reference, or none once it is dead.
pub func weak_get(w: Weak) -> Object*?:
    if let o = w.target:
        check_thread(o)
        if not has(o, dead):
            return retain(o)
    return none
"""

## The text of `src/std/ownership/lifecycle.lucb`.
let text_21: str = r"""#==============================================================================================
#
#   lifecycle - The end of a run
#
#   DESCRIPTION:
#       After `main` and after each worker, the collector runs and anything still alive is a
#       defect that stops the program.
#
#==============================================================================================

# mark: The end of a run =======================================================================

import strings

## After `main`: the collector runs, and anything still alive is a defect. The exit status.
pub func finish_run(status: i32) -> i32:
    drain(0)
    settle()
    if live != 0:
        var room: u8[96]
        let text = strings.format(room, f"runtime: {live} objects alive at exit\n") catch failure:
            recover "runtime: objects alive at exit\n"
        var e = io.stderr()
        _ = e.write(text.bytes) catch failure: recover 0
        return 3
    release_buffers()
    runtime_depth = 0
    thread_context = 0
    return status

## A worker's end (§14): its heap is its own, and it too must leave nothing alive once
## its arguments and result are released; what it does leave stops the program.
pub func finish_task():
    drain(0)
    settle()
    if live != 0:
        var room: u8[96]
        let text = strings.format(room, f"runtime: {live} objects alive when a task ended\n") catch failure:
            recover "runtime: objects alive when a task ended\n"
        var e = io.stderr()
        _ = e.write(text.bytes) catch failure: recover 0
        core.exit(3)
    release_buffers()
    runtime_depth = 0
    thread_context = 0

## Collecting a cycle drops its members' fields, which can release shared objects the cycle
## held: that buffers fresh candidates and may pool temporaries. During a run the next
## collection absorbs them, but at the end of a run there is no next, so repeat until the
## collector's buffers settle. A bound guards against a fixpoint that never empties.
func settle():
    collect()
    var guard: usize = 0
    while (pending_count > 0 or root_count > 0) and guard < 1000:
        drain(0)
        collect()
        guard += 1

## Empty object counts do not include the collector's and temporaries pool's
## backing allocations. A finished thread must release those too: its TLS roots
## disappear at thread exit, so retaining capacity would leak on every spawn.
func release_buffers():
    assert(pending_count == 0 and root_count == 0 and white_count == 0)
    if pending.length > 0:
        free(pending) in memory.heap
    if roots.length > 0:
        free(roots) in memory.heap
    if whites.length > 0:
        free(whites) in memory.heap
    var empty_pending: Pending[]
    var empty_objects: Object*[]
    pending = empty_pending
    roots = empty_objects
    whites = empty_objects
"""

## The text of `src/std/strings/module.lucb`.
let text_22: str = r"""#==============================================================================================
#
#   strings - Text operations over `str` views
#
#   DESCRIPTION:
#       Text operations over `str` views; what allocates says so and uses the current allocator,
#       and says how the allocation is given back: `release` for a text made here, `free` for
#       the borrowed-field arrays returned by split and split_by.
#
#==============================================================================================

import float_text
import io
import memory
import numerals
## An empty separator or needle where one is required.
pub let invalid_separator: ErrorCode = ErrorCode.package(48)
## A result exceeds the caller's byte limit.
pub let output_too_large: ErrorCode = ErrorCode.package(49)
## A radix outside 2 through 36.
pub let invalid_radix: ErrorCode = ErrorCode.package(50)
## The text is not a number in the given radix.
pub let invalid_number: ErrorCode = ErrorCode.package(51)
## The parsed value does not fit its type.
pub let number_out_of_range: ErrorCode = ErrorCode.package(52)
"""

## The text of `src/std/strings/search.lucb`.
let text_23: str = r"""#==============================================================================================
#
#   search - Substring search over `str`
#
#   DESCRIPTION:
#       Prefix, suffix, and forward or reverse substring search, all byte-exact and
#       allocation-free.
#
#==============================================================================================

## Whether `text` begins with `prefix`.
pub func starts_with(text: str, prefix: str) -> bool:
    if prefix.length > text.length:
        return false
    return (str)text.bytes[..<prefix.length] == prefix

## Whether `text` ends with `suffix`.
pub func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## The byte offset of the first exact needle, or none. Empty needles match at
## zero. No allocation or UTF-8 validation occurs; embedded NUL bytes are ordinary
## data. The search takes linear time and constant auxiliary space.
pub func find(text: str, needle: str) -> usize?:
    return search_bytes(text.bytes, needle.bytes, false)

## Search at or after a byte offset. An offset past the end returns none, including
## for an empty needle. This does not require a Unicode scalar boundary.
pub func find_from(text: str, needle: str, start: usize) -> usize?:
    if start > text.length:
        return none
    let offset = search_bytes(text.bytes[start..], needle.bytes, false) else return none
    return start + offset

## The last exact occurrence, including overlaps. Empty needles match at the end.
## Like find, this uses byte offsets, linear time, constant space and no allocation.
pub func find_last(text: str, needle: str) -> usize?:
    let offset = search_bytes(text.bytes, needle.bytes, true) else return none
    return text.length - needle.length - offset

## The byte offset of the last `byte` in `text`.
pub func last(text: str, byte: u8) -> usize?:
    var i = text.length
    while i > 0:
        i -= 1
        if text.bytes[i] == byte:
            return i
    return none

## Whether `needle` occurs anywhere in `text`.
pub func contains(text: str, needle: str) -> bool:
    return find(text, needle) != none

## Two-way matching splits the needle at a critical factorization. Match its right
## part first, then the left; the period lets repeated prefixes be skipped without
## comparing them again. Reversed indexing gives the same bound for find_last.
func search_bytes(text: const u8[], needle: const u8[], reversed: bool) -> usize?:
    if needle.length == 0:
        return 0
    if needle.length > text.length:
        return none
    let (forward_split, forward_period) = maximal_suffix(needle, reversed, false)
    let (backward_split, backward_period) = maximal_suffix(needle, reversed, true)
    var critical = forward_split
    var period = forward_period
    if backward_split > critical:
        critical = backward_split
        period = backward_period
    var periodic = critical <= needle.length - period
    var index: usize = 0
    while periodic and index < critical:
        if search_byte(needle, index, reversed) != search_byte(needle, period + index, reversed):
            periodic = false
        index += 1
    var remembered: usize = 0
    if periodic:
        remembered = needle.length - period
    else:
        let right = needle.length - critical + 1
        period = critical if critical > right else right
    var position: usize = 0
    var matched_prefix: usize = 0
    while needle.length <= text.length - position:
        var right = critical if critical > matched_prefix else matched_prefix
        while right < needle.length and search_byte(needle, right, reversed) == search_byte(text, position + right, reversed):
            right += 1
        if right < needle.length:
            position += right - critical + 1
            matched_prefix = 0
            continue
        var left = critical
        while left > matched_prefix and search_byte(needle, left - 1, reversed) == search_byte(text, position + left - 1, reversed):
            left -= 1
        if left <= matched_prefix:
            return position
        position += period
        matched_prefix = remembered
    return none

## Positions represent suffix starts rather than signed -1 sentinels. Every
## advance stays within the needle; no index arithmetic wraps at usize maximum.
func maximal_suffix(needle: const u8[], reversed: bool, opposite_order: bool) -> (usize, usize):
    var left: usize = 0
    var right: usize = 1
    var offset: usize = 0
    var period: usize = 1
    while right < needle.length and offset < needle.length - right:
        let a = search_byte(needle, right + offset, reversed)
        let b = search_byte(needle, left + offset, reversed)
        if a == b:
            if offset + 1 == period:
                right += period
                offset = 0
            else:
                offset += 1
        elif (a < b) != opposite_order:
            right += offset + 1
            offset = 0
            period = right - left
        else:
            left = right
            right = left + 1
            offset = 0
            period = 1
    return (left, period)

func search_byte(bytes: const u8[], index: usize, reversed: bool) -> u8:
    return bytes[bytes.length - index - 1] if reversed else bytes[index]
"""

## The text of `src/std/strings/split.lucb`.
let text_24: str = r"""#==============================================================================================
#
#   split - Splitting text into views
#
#   DESCRIPTION:
#       Split `str` at a byte or a substring into views over the input, once, last, or every
#       occurrence.
#
#==============================================================================================

## `text` split at every `separator`, as views into it; the array is an allocation of the
## current allocator, given back with `free`.
pub func split(text: str, separator: u8) -> str[]!:
    var count: usize = 1
    for b in text.bytes:
        if b == separator:
            count = count +? 1 else error(memory.exhausted, "the split result is too large")
    let parts = try new str[count] ---
    var n: usize = 0
    var start: usize = 0
    var i: usize = 0
    let b = text.bytes
    while i < b.length:
        if b[i] == separator:
            parts[n] = (str)b[start..<i]
            n += 1
            start = i + 1
        i += 1
    parts[n] = (str)b[start..]
    return parts

## Split a borrowed text at a nonempty byte substring. Empty fields, including the
## final one after a trailing separator, are preserved. Zero is an exhausted
## iterator. Keep text and separator storage alive and unchanged while iterating.
pub struct SplitIterator:
    var text: str
    var separator: str
    var position: usize
    var remaining: usize
    var active: bool

    ## max_parts=0 has no limit; one returns the entire input as a single field.
    ## No allocation occurs. An empty separator reports invalid_separator.
    pub static func over(text: str, separator: str, max_parts: usize = 0) -> SplitIterator!:
        if separator.length == 0:
            error(invalid_separator, "a split iterator requires a nonempty separator")
        return SplitIterator(text = text, separator = separator, remaining = max_parts, active = true)

    ## The next borrowed field. An empty field is present; none means exhausted.
    pub func next() -> str?:
        if not self.active:
            return none
        if self.remaining == 1:
            self.active = false
            return (str)self.text.bytes[self.position..]
        let found = find_from(self.text, self.separator, self.position)
        if let end = found:
            let start = self.position
            self.position = end + self.separator.length
            if self.remaining > 1:
                self.remaining -= 1
            return (str)self.text.bytes[start..<end]
        self.active = false
        return (str)self.text.bytes[self.position..]

## An allocated array of borrowed fields with SplitIterator semantics. Free the
## array through the allocator current on entry; its field bytes still borrow text.
## max_parts=0 has no limit. An empty separator reports invalid_separator.
pub func split_by(text: str, separator: str, max_parts: usize = 0) -> str[]!:
    let initial = try SplitIterator.over(text, separator, max_parts)
    var counter = initial
    var count: usize = 0
    while counter.next() != none:
        count = count +? 1 else error(memory.exhausted, "the split result is too large")
    let fields = try new str[count] ---
    var iterator = initial
    var index: usize = 0
    while let field = iterator.next():
        fields[index] = field
        index += 1
    return fields

## Borrow the text before and after the first separator, or none if absent. The
## separator is omitted. An empty separator splits at the start: (empty, text).
pub func split_once(text: str, separator: str) -> (str, str)?:
    let position = find(text, separator) else return none
    return ((str)text.bytes[..<position], (str)text.bytes[position + separator.length..])

## Borrow the text before and after the last separator, including overlapping
## candidates. An empty separator splits at the end: (text, empty).
pub func split_last(text: str, separator: str) -> (str, str)?:
    let position = find_last(text, separator) else return none
    return ((str)text.bytes[..<position], (str)text.bytes[position + separator.length..])
"""

## The text of `src/std/strings/transform.lucb`.
let text_25: str = r"""#==============================================================================================
#
#   transform - Trimming, joining and case
#
#   DESCRIPTION:
#       Trim, join, copy and ASCII case changes over `str`, returning fresh owned text.
#
#==============================================================================================

func is_space(byte: u8) -> bool:
    return byte == ' ' or byte == '\n' or byte == '\t' or byte == '\r'

## `text` without leading and trailing spaces, tabs, and line ends: a view.
pub func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    let b = text.bytes
    while start < end and is_space(b[start]):
        start += 1
    while end > start and is_space(b[end - 1]):
        end -= 1
    return (str)b[start..<end]

## The pieces joined with `separator` between them, NUL-terminated in the current
## allocator; `release` gives it back.
pub func join(pieces: const str[], separator: str) -> str!:
    var total: usize = 0
    var i: usize = 0
    while i < pieces.length:
        total = total +? pieces[i].length else error(memory.exhausted, "the joined text is too large")
        if i + 1 < pieces.length:
            total = total +? separator.length else error(memory.exhausted, "the joined text is too large")
        i += 1
    let out = try terminated_buffer(total)
    var n: usize = 0
    i = 0
    while i < pieces.length:
        memory.copy(out[n..], pieces[i].bytes, pieces[i].length)
        n += pieces[i].length
        if i + 1 < pieces.length:
            memory.copy(out[n..], separator.bytes, separator.length)
            n += separator.length
        i += 1
    out[n] = 0
    return (str)out[..<n]

## A copy of `text` in the current allocator, NUL-terminated so it may be a `c.str`;
## `release` gives it back.
pub func copy(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    memory.copy(out, text.bytes, text.length)
    out[text.length] = 0
    return (str)out[..<text.length]

## As much of `text` as fits in `buffer`, copied there and cut at a character's start; the
## result views `buffer`. A caught failure's message is kept past its handler so, or with
## `copy` (§11.3).
pub func copy_into(buffer: u8[], text: str) -> str:
    var n = text.length
    if n > buffer.length:
        n = buffer.length
        while n > 0 and (text.bytes[n] & 0xC0) == 0x80:
            n -= 1
    memory.copy(buffer, text.bytes, n)
    return (str)buffer[..<n]

## ASCII case folding; other bytes pass through. NUL-terminated in the current
## allocator; `release` gives the text back.
pub func to_upper(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b - 32 if b >= 'a' and b <= 'z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

## ASCII lowercase; other bytes pass through unchanged. The result is a
## NUL-terminated current-allocator allocation released with release.
pub func to_lower(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b + 32 if b >= 'A' and b <= 'Z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

## Give back text from join, copy, replace, to_upper or to_lower: the allocation is
## one byte longer than the text, its NUL.
pub func release(text: str):
    free(u8[]((u8*)text.bytes.data, text.length + 1))

## Allocate text storage including its terminator, reporting size overflow as the
## same fallible outcome as an allocation refusal. Callers initialize every byte.
func terminated_buffer(length: usize) -> u8[]!:
    let size = length +? 1 else error(memory.exhausted, "the text is too large")
    return try new u8[size] ---
"""

## The text of `src/std/strings/replace.lucb`.
let text_26: str = r"""#==============================================================================================
#
#   replace - Substring replacement
#
#   DESCRIPTION:
#       Replace nonoverlapping byte substrings left to right into fresh owned text, with
#       optional caps on the count and the result size.
#
#==============================================================================================

## Replace nonoverlapping byte substrings from left to right. Empty needles report
## invalid_separator. max_replacements=0 replaces all matches; max_bytes optionally
## limits result bytes excluding its terminator, reporting output_too_large before
## allocation. A result is always a fresh NUL-terminated current-allocator allocation,
## including unchanged or empty results; release gives it back. Inputs remain borrowed
## and unchanged and may overlap each other. No UTF-8 validation occurs.
pub func replace(text: str, needle: str, replacement: str, max_replacements: usize = 0, max_bytes: usize? = none) -> str!:
    if needle.length == 0:
        error(invalid_separator, "replacement requires a nonempty needle")
    var size = text.length
    var count: usize = 0
    var position: usize = 0
    while max_replacements == 0 or count < max_replacements:
        let found = find_from(text, needle, position) else break
        if replacement.length >= needle.length:
            size = size +? (replacement.length - needle.length) else error(memory.exhausted, "the replacement result is too large")
        else:
            size -= needle.length - replacement.length
        position = found + needle.length
        count += 1
    if let maximum = max_bytes:
        if size > maximum:
            error(output_too_large, "the replacement result exceeds its byte limit")
    let output = try terminated_buffer(size)
    var used: usize = 0
    var copied: usize = 0
    position = 0
    while copied < count:
        let found = find_from(text, needle, position) else trap("replacement input changed between scans")
        let prefix = found - position
        memory.copy(output[used..], text.bytes[position..<found], prefix)
        used += prefix
        memory.copy(output[used..], replacement.bytes, replacement.length)
        used += replacement.length
        position = found + needle.length
        copied += 1
    let tail = text.length - position
    memory.copy(output[used..], text.bytes[position..], tail)
    used += tail
    output[used] = 0
    return (str)output[..<used]
"""

## The text of `src/std/strings/numbers.lucb`.
let text_27: str = r"""#==============================================================================================
#
#   numbers - Integer formatting and parsing
#
#   DESCRIPTION:
#       Signed and unsigned integers in radix 2 through 36, ASCII digits only, over borrowed or
#       caller-provided storage.
#
#==============================================================================================

## A signed integer in radix 2 through 36. ASCII letters are case-insensitive
## digits; prefixes are not interpreted. Optional +/- and leading zeroes are
## accepted. None reports an invalid radix, invalid byte, missing digit or overflow.
pub func parse_i64(text: str, radix: u32 = 10) -> i64?:
    if radix < 2 or radix > 36 or text.length == 0:
        return none
    var position: usize = 0
    var negative = false
    if text.bytes[0] == '-' or text.bytes[0] == '+':
        negative = text.bytes[0] == '-'
        position = 1
    if position == text.length:
        return none
    # Accumulate on the sign's side so the negative endpoint fits without abs.
    var value: i64 = 0
    while position < text.length:
        let digit = integer_digit(text.bytes[position]) else return none
        if digit >= radix:
            return none
        let scaled = value *? (i64)radix else return none
        value = (scaled -? (i64)digit if negative else scaled +? (i64)digit) else return none
        position += 1
    return value

## Unsigned counterpart of parse_i64. A leading plus is accepted; every minus,
## including -0, is rejected. The entire input must fit u64 in the requested radix.
pub func parse_u64(text: str, radix: u32 = 10) -> u64?:
    if radix < 2 or radix > 36 or text.length == 0:
        return none
    var position: usize = 1 if text.bytes[0] == '+' else 0
    if position == text.length:
        return none
    var value: u64 = 0
    while position < text.length:
        let digit = integer_digit(text.bytes[position]) else return none
        if digit >= radix:
            return none
        let scaled = value *? (u64)radix else return none
        value = scaled +? (u64)digit else return none
        position += 1
    return value

## Canonical lowercase digits, with a minus only for negative values, no prefix,
## padding or terminator. Return a borrowed view of buffer. A 65-byte buffer always
## suffices. Invalid radix or insufficient capacity leaves buffer unchanged.
pub func format_i64(value: i64, buffer: u8[], radix: u32 = 10) -> str!:
    let magnitude = (u64)(-(value + 1)) + 1 if value < 0 else (u64)value
    return try format_integer(magnitude, value < 0, buffer, radix)

## Unsigned counterpart of format_i64; at most 64 bytes are needed. io.full reports
## insufficient capacity and invalid_radix reports a radix outside 2 through 36.
pub func format_u64(value: u64, buffer: u8[], radix: u32 = 10) -> str!:
    return try format_integer(value, false, buffer, radix)

func integer_digit(byte: u8) -> u32?:
    if byte >= '0' and byte <= '9':
        return (u32)(byte - '0')
    if byte >= 'a' and byte <= 'z':
        return (u32)(byte - 'a') + 10
    if byte >= 'A' and byte <= 'Z':
        return (u32)(byte - 'A') + 10
    return none

func format_integer(value: u64, negative: bool, buffer: u8[], radix: u32) -> str!:
    if radix < 2 or radix > 36:
        error(invalid_radix, "an integer radix must be between 2 and 36")
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var reversed: u8[65]
    var count: usize = 0
    var remaining = value
    while true:
        reversed[count] = digits.bytes[(usize)(remaining % (u64)radix)]
        count += 1
        remaining //= (u64)radix
        if remaining == 0:
            break
    if negative:
        reversed[count] = '-'
        count += 1
    if buffer.length < count:
        error(io.full, "the destination cannot hold the formatted integer")
    var position: usize = 0
    while position < count:
        buffer[position] = reversed[count - position - 1]
        position += 1
    return (str)buffer[..<count]
"""

