#==============================================================================================
#
#   standard_sources - The standard library carried inside the compiler
#
#   DESCRIPTION:
#       The standard modules of base.md §16.6 as raw text, each fragment as `src/std` holds
#       it, for a checker embedded in another program (`embed.check_root`), which reads no
#       standard library from disk. The command itself reads `src/std` (`standard`); this
#       copy is written by `tools/embed_std.py`, and the gate fails when the two differ. Do
#       not edit this file; edit `src/std` and rerun the tool.
#
#==============================================================================================

# mark: The modules ===========================================================================

## The standard modules in binding order, as `src/std/ORDER` lists them.
pub let modules: str[20] = ["platform", "c", "windows_abi", "float_text", "numerals", "core", "memory", "windows_text", "os", "io", "luce", "atomic", "time", "thread", "sync", "ownership", "strings", "testing", "interop", "debug"]

## Where each module's fragments begin in `paths` and `text`, by its index in `modules`;
## the last entry is the fragment count. `platform` has none: the checker writes it.
pub let firsts: u32[21] = [0, 0, 1, 2, 5, 6, 7, 8, 9, 11, 12, 13, 14, 15, 16, 17, 22, 31, 32, 47, 48]

## Each fragment's path as positions name it: `std/core.lucb`, `std/strings/search.lucb`.
pub let paths: str[48] = ["std/c.lucb", "std/windows_abi.lucb", "std/float_text/module.lucb", "std/float_text/tables.lucb", "std/float_text/ryu.lucb", "std/numerals.lucb", "std/core.lucb", "std/memory.lucb", "std/windows_text.lucb", "std/os/module.lucb", "std/os/windows.lucb", "std/io.lucb", "std/luce.lucb", "std/atomic.lucb", "std/time.lucb", "std/thread.lucb", "std/sync.lucb", "std/ownership/module.lucb", "std/ownership/pool.lucb", "std/ownership/cycles.lucb", "std/ownership/weak.lucb", "std/ownership/lifecycle.lucb", "std/strings/module.lucb", "std/strings/search.lucb", "std/strings/split.lucb", "std/strings/transform.lucb", "std/strings/replace.lucb", "std/strings/numbers.lucb", "std/strings/float_tables.lucb", "std/strings/floats.lucb", "std/strings/formatting.lucb", "std/testing.lucb", "std/interop/module.lucb", "std/interop/object.lucb", "std/interop/reference.lucb", "std/interop/weak.lucb", "std/interop/lease.lucb", "std/interop/view.lucb", "std/interop/interface.lucb", "std/interop/result.lucb", "std/interop/callback.lucb", "std/interop/connection.lucb", "std/interop/signal.lucb", "std/interop/transfer.lucb", "std/interop/worker_entry.lucb", "std/interop/worker_queue.lucb", "std/interop/worker.lucb", "std/debug.lucb"]

# mark: The sources ===========================================================================

## The text of `src/std/c.lucb`.
let text_0: str = r"""#==============================================================================================
#
#   c - C's types and errno
#
#   DESCRIPTION:
#       C's types live here (base.md §5.2); the checker supplies them, since their widths are
#       the target's: `c.int` and the other fixed-width ones are Base types by another name;
#       `c.char`, `c.long`, `c.ulong` and `c.wchar` are distinct; `c.va_list` is opaque; `c.str`
#       is C text.
#
#==============================================================================================

import platform
extern func mac_errno as "__error"() -> i32*
extern func linux_errno as "__errno_location"() -> i32*
extern func windows_errno as "_errno"() -> i32*

## The calling thread's `errno`: the C library's account of its last failure.
pub func errno() -> i32:
    if platform.windows:
        return *windows_errno()
    if platform.macos:
        return *mac_errno()
    return *linux_errno()

## Set the calling thread's errno. Clear it immediately before C calls such as
## readdir whose null result can mean either normal completion or failure.
pub func set_errno(value: i32):
    if platform.windows:
        *windows_errno() = value
    elif platform.macos:
        *mac_errno() = value
    else:
        *linux_errno() = value

## `EINTR`: a call a signal interrupted, to be made again. The same number on every host.
pub let interrupted: i32 = 4

## The C standard input stream; the backend supplies it.
pub func stdin() -> void*:
    trap("supplied by the backend")

## The C standard output stream; the backend supplies it.
pub func stdout() -> void*:
    trap("supplied by the backend")

## The C standard error stream; the backend supplies it.
pub func stderr() -> void*:
    trap("supplied by the backend")
"""

## The text of `src/std/windows_abi.lucb`.
let text_1: str = r"""#==============================================================================================
#
#   windows_abi - Internal shared Win32 ABI
#
#   DESCRIPTION:
#       Module-specific handles and records stay with their filesystem, process, input or
#       graphics adapter. Public standard APIs never expose these declarations. This module
#       cannot depend on allocation.
#
#==============================================================================================

import c
## The CP_UTF8 code page.
pub let utf8_page: u32 = 65001
## MB_ERR_INVALID_CHARS: fail on malformed UTF-8.
pub let reject_invalid_utf8: u32 = 8
## WC_ERR_INVALID_CHARS: fail on malformed UTF-16.
pub let reject_invalid_utf16: u32 = 128

## Win32 SYSTEM_INFO: the page size and processor count.
pub extern struct SystemInfo:
    pub architecture: u16
    pub reserved: u16
    pub page_size: u32
    pub minimum_address: void*
    pub maximum_address: void*
    pub active_processor_mask: usize
    pub processor_count: u32
    pub processor_type: u32
    pub allocation_granularity: u32
    pub processor_level: u16
    pub processor_revision: u16

## Win32 OVERLAPPED. File locking uses only its zero state; the explicit layout
## keeps packages from duplicating an ABI-sensitive record.
pub extern struct Overlapped:
    pub internal: usize
    pub internal_high: usize
    pub offset: u32
    pub offset_high: u32
    pub event: void*?

## Win32 MultiByteToWideChar: bytes to UTF-16.
pub extern func MultiByteToWideChar(page: u32, flags: u32, input: c.str, length: i32, output: u16*?, capacity: i32) -> i32
## Win32 WideCharToMultiByte: UTF-16 to bytes.
pub extern func WideCharToMultiByte(page: u32, flags: u32, input: const u16*, length: i32, output: u8*?, capacity: i32, fallback: void*?, used_fallback: void*?) -> i32
## Win32 GetLastError.
pub extern func GetLastError() -> u32
## Win32 SetLastError.
pub extern func SetLastError(error: u32)
## Win32 CloseHandle.
pub extern func CloseHandle(handle: void*) -> i32
## Win32 GetCurrentProcessId.
pub extern func GetCurrentProcessId() -> u32
## Win32 GetCurrentProcess.
pub extern func GetCurrentProcess() -> void*
## Win32 GetSystemInfo.
pub extern func GetSystemInfo(info: SystemInfo*)
## Win32 Sleep, in milliseconds.
pub extern func Sleep(milliseconds: u32)
## Win32 GetTempPathW.
pub extern func GetTempPathW(capacity: u32, output: u16*) -> u32
## Win32 GetModuleHandleW.
pub extern func GetModuleHandleW(name: u16*?) -> void*
## Win32 CreateFileW.
pub extern func CreateFileW(path: u16*, access: u32, share: u32, security: void*?, disposition: u32, flags: u32, template: void*?) -> void*
## Win32 LockFileEx.
pub extern func LockFileEx(handle: void*, flags: u32, reserved: u32, low: u32, high: u32, overlapped: Overlapped*) -> i32
## Win32 GetEnvironmentVariableW.
pub extern func GetEnvironmentVariableW(name: u16*, output: u16*, capacity: u32) -> u32
## Win32 SetEnvironmentVariableW.
pub extern func SetEnvironmentVariableW(name: u16*, value: u16*?) -> i32
## Win32 GetCurrentDirectoryW.
pub extern func GetCurrentDirectoryW(capacity: u32, output: u16*?) -> u32
## Win32 SetCurrentDirectoryW.
pub extern func SetCurrentDirectoryW(path: u16*) -> i32
"""

## The text of `src/std/float_text/module.lucb`.
let text_2: str = r"""#==============================================================================================
#
#   float_text - The shortest decimal text of a float
#
#   DESCRIPTION:
#       The fewest significant digits that read back as the value, of those the closest
#       (Ryu: Adams, "Ryu: Fast Float-to-String Conversion", PLDI 2018), each width with its
#       own digits, laid out as double-conversion's ToShortest: decimal notation for a decimal
#       exponent from -6 to 14, otherwise one digit, the rest after a point, and `e` with the
#       exponent. Integer arithmetic only. strings' format_f64 writes this text, and a
#       formatted string's float field this text with a `.0` after digits that have no point
#       (base.md §14). It comes before `core` and needs nothing else.
#
#==============================================================================================

# mark: Text ===================================================================================

## The shortest text of `value` into `text`, at least 32 bytes: `0.1`, `1e15`, `5e-324`,
## `-0`, `inf`, `-inf`, `nan`. Its length.
pub func write_f64(value: f64, text: u8[]) -> usize:
    let bits = value.bits()
    let negative = (bits >> 63) != 0
    let exponent_bits = (u32)((bits >> 52) & 0x7FF)
    let mantissa_bits = bits & 0xFFFFFFFFFFFFF
    if exponent_bits == 0x7FF:
        return special(text, negative, mantissa_bits != 0)
    if exponent_bits == 0 and mantissa_bits == 0:
        return copy_word(text, "-0" if negative else "0")
    let (digits, exponent) = shortest64(mantissa_bits, exponent_bits)
    return layout(text, negative, digits, exponent)

## The f32 counterpart of write_f64: the f32's own shortest digits (`0.1` for 0.1f32).
pub func write_f32(value: f32, text: u8[]) -> usize:
    let bits = value.bits()
    let negative = (bits >> 31) != 0
    let exponent_bits = (bits >> 23) & 0xFF
    let mantissa_bits = bits & 0x7FFFFF
    if exponent_bits == 0xFF:
        return special(text, negative, mantissa_bits != 0)
    if exponent_bits == 0 and mantissa_bits == 0:
        return copy_word(text, "-0" if negative else "0")
    let (digits, exponent) = shortest32(mantissa_bits, exponent_bits)
    return layout(text, negative, (u64)digits, exponent)

## A formatted string's field of `value` (base.md §14): write_f64's text, with `.0` after
## digits that have no point or exponent (`5.0`, `-0.0`, `123456789012345.0`). Its length.
pub func display_f64(value: f64, text: u8[]) -> usize:
    return with_point(text, write_f64(value, text))

## display_f64 for an f32: its own shortest digits.
pub func display_f32(value: f32, text: u8[]) -> usize:
    return with_point(text, write_f32(value, text))

func with_point(text: u8[], length: usize) -> usize:
    var at: usize = 0
    while at < length:
        let byte = text[at]
        if byte == '.' or byte == 'e' or byte == 'i' or byte == 'n':
            return length
        at += 1
    text[length] = '.'
    text[length + 1] = '0'
    return length + 2

func special(text: u8[], negative: bool, nan: bool) -> usize:
    if nan:
        return copy_word(text, "nan")
    return copy_word(text, "-inf" if negative else "inf")

func copy_word(text: u8[], word: str) -> usize:
    var at: usize = 0
    while at < word.length:
        text[at] = word.bytes[at]
        at += 1
    return word.length

## ToShortest's layout of `digits * 10^exponent` into `text`; its length.
func layout(text: u8[], negative: bool, digits: u64, exponent: i32) -> usize:
    var reversed: u8[20] = ---
    var count: usize = 0
    var rest = digits
    while rest > 0:
        reversed[count] = (u8)(48 + rest % 10)
        count += 1
        rest = rest // 10
    let point = (i64)exponent + (i64)count
    let decimal_exponent = point - 1
    var at: usize = 0
    if negative:
        text[0] = '-'
        at = 1
    if decimal_exponent >= -6 and decimal_exponent < 15:
        if point <= 0:
            text[at] = '0'
            text[at + 1] = '.'
            at += 2
            for _ in 0..<(usize)(-point):
                text[at] = '0'
                at += 1
            for index in 0..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
        elif (usize)point >= count:
            for index in 0..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
            for _ in 0..<((usize)point - count):
                text[at] = '0'
                at += 1
        else:
            for index in 0..<(usize)point:
                text[at] = reversed[count - 1 - index]
                at += 1
            text[at] = '.'
            at += 1
            for index in (usize)point..<count:
                text[at] = reversed[count - 1 - index]
                at += 1
        return at
    text[at] = reversed[count - 1]
    at += 1
    if count > 1:
        text[at] = '.'
        at += 1
        for index in 1..<count:
            text[at] = reversed[count - 1 - index]
            at += 1
    text[at] = 'e'
    at += 1
    var power = decimal_exponent
    if power < 0:
        text[at] = '-'
        at += 1
        power = -power
    var power_digits: u8[8] = ---
    var width: usize = 0
    while true:
        power_digits[width] = (u8)(48 + power % 10)
        width += 1
        power = power // 10
        if power == 0:
            break
    while width > 0:
        width -= 1
        text[at] = power_digits[width]
        at += 1
    return at
"""

