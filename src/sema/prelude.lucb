#==============================================================================================
#
#   prelude - The standard modules, as Base declarations
#
#   DESCRIPTION:
#       Generated by tools/embed_std.py from src/std/; edit those files, not this
#       one. base.md §16.6 names the standard modules; a Base program reaches them with
#       `import` or by their bare names. The checker needs their signatures, and the
#       right place for signatures is Base source. Each module below is a piece of Base
#       text the checker parses and binds before a program's own modules, so `memory`,
#       `io`, `files`, `process`, `thread`, `sync`, `atomic`, `c`, and `luce` are ordinary
#       modules with ordinary declarations, and the backend emits their bodies like any
#       other code. They reach the operating system through `extern` (§17): the C
#       library's own functions, declared here with the types Base gives them. The few
#       things no Base body can express, `atomic.fence`, the `luce` facts, and the C
#       standard streams, the backend supplies.
#
#       The constants that follow are those of the first target, arm64-macos (§19.5);
#       a second target gets its own copy of this module through the per-target
#       modules of §16.4.
#
#==============================================================================================

pub struct Prelude:
    pub var name: str
    pub var text: str

## The modules in binding order (src/std/ORDER): `memory` first because `io` names its
## types, `atomic` before `sync`, whose orderings it declares.
pub let modules: Prelude[21] = [
    Prelude(name = "platform", text = """
## The target of the build, as constants (§19.5): generated by the compiler from
## `--target` (`Target.module_text`); this placeholder is what the prelude embeds and the
## checker replaces. `os` re-exports these for programs; the standard library branches
## on them directly.
pub let name: str = "arm64-macos"
pub let macos: bool = true
pub let linux: bool = false
pub let windows: bool = false
pub let posix: bool = true
pub let arm64: bool = true
pub let x86_64: bool = false
pub let pointer_bits: u32 = 64
## The instruction-set level the program is compiled for (§19.5): 1 is the family's baseline.
pub let cpu_level: u32 = 1
"""),
    Prelude(name = "c", text = """
## C's types live here (base.md §5.2); the checker supplies them, since their widths are the
## target's: `c.int` and the other fixed-width ones are Base types by another name, `c.char`,
## `c.long`, `c.ulong`, and `c.wchar` are distinct, `c.va_list` is opaque, `c.str` is C text.

import platform

extern func mac_errno as "__error"() -> i32*
extern func linux_errno as "__errno_location"() -> i32*

## The calling thread's `errno`: the C library's account of its last failure.
pub func errno() -> i32:
    if platform.macos:
        return *mac_errno()
    return *linux_errno()

## Set the calling thread's errno. Clear it immediately before C calls such as
## readdir whose null result can mean either normal completion or failure.
pub func set_errno(value: i32):
    if platform.macos:
        *mac_errno() = value
    else:
        *linux_errno() = value

## `EINTR`: a call a signal interrupted, to be made again. The same number on both hosts.
pub let interrupted: i32 = 4

## The C standard streams; the backend supplies them.
pub func stdin() -> void*:
    trap("supplied by the backend")
pub func stdout() -> void*:
    trap("supplied by the backend")
pub func stderr() -> void*:
    trap("supplied by the backend")
"""),
    Prelude(name = "core", text = """
import c
extern func write(descriptor: i32, buffer: const void*, count: usize) -> isize
extern func c_exit as "exit"(code: i32) -> never
extern func malloc(size: usize) -> void*?
extern func memcpy(target: void*, source: const void*, count: usize) -> void*
extern func memcmp(a: const void*, b: const void*, count: usize) -> i32
extern func strlen(text: c.str) -> usize
extern func snprintf(buffer: void*, size: usize, format: c.str, ...) -> i32

## Stop the program with its reason on stderr (§8.7).
pub func trap(message: c.str) -> never:
    let prefix = "trap: "
    discard(write(2, prefix.bytes.data, prefix.length))
    discard(write(2, (const void*)message, strlen(message)))
    let newline = "\\n"
    discard(write(2, newline.bytes.data, 1))
    c_exit(1)

## `trap: file:line:column: message`: a trap naming the statement it stopped at (§11.5).
pub func trap_at(position: c.str, message: c.str) -> never:
    let prefix = "trap: "
    discard(write(2, prefix.bytes.data, prefix.length))
    discard(write(2, (const void*)position, strlen(position)))
    let sep = ": "
    discard(write(2, sep.bytes.data, 2))
    discard(write(2, (const void*)message, strlen(message)))
    let newline = "\\n"
    discard(write(2, newline.bytes.data, 1))
    c_exit(1)

## Positioned diagnostic with NUL-terminated C strings. Base assertions use
## trap_detail_at so their message spans retain their explicit lengths.
pub func trap_two_at(position: c.str, message: c.str, detail: c.str) -> never:
    let prefix = "trap: "
    discard(write(2, prefix.bytes.data, prefix.length))
    discard(write(2, (const void*)position, strlen(position)))
    let sep = ": "
    discard(write(2, sep.bytes.data, 2))
    discard(write(2, (const void*)message, strlen(message)))
    discard(write(2, sep.bytes.data, 2))
    discard(write(2, (const void*)detail, strlen(detail)))
    let newline = "\\n"
    discard(write(2, newline.bytes.data, 1))
    c_exit(1)

## Unpositioned diagnostic with NUL-terminated C strings.
pub func trap_two(message: c.str, detail: c.str) -> never:
    let prefix = "trap: "
    discard(write(2, prefix.bytes.data, prefix.length))
    discard(write(2, (const void*)message, strlen(message)))
    let sep = ": "
    discard(write(2, sep.bytes.data, 2))
    discard(write(2, (const void*)detail, strlen(detail)))
    let newline = "\\n"
    discard(write(2, newline.bytes.data, 1))
    c_exit(1)

## Fatal diagnostic for a Base string. Its explicit byte length permits slices,
## empty values and embedded NUL; no byte beyond the view is read.
pub func trap_text_at(position: c.str, message: str) -> never:
    diagnostic_location(position)
    write_diagnostic(message.bytes)
    write_diagnostic("\\n".bytes)
    c_exit(1)

## Assertion prefix plus a Base string detail, preserving the detail's length.
pub func trap_detail_at(position: c.str, message: c.str, detail: str) -> never:
    diagnostic_location(position)
    let prefix = (str)message
    write_diagnostic(prefix.bytes)
    write_diagnostic(": ".bytes)
    write_diagnostic(detail.bytes)
    write_diagnostic("\\n".bytes)
    c_exit(1)

func diagnostic_location(position: c.str):
    write_diagnostic("trap: ".bytes)
    let location = (str)position
    write_diagnostic(location.bytes)
    write_diagnostic(": ".bytes)

## Panic reporting cannot raise another language error. Retry interruptions and
## short writes; stop on a terminal write failure or lack of progress.
func write_diagnostic(data: const u8[]):
    var written: usize = 0
    while written < data.length:
        let remaining = data.length - written
        let count = remaining if remaining < 1073741824 else 1073741824
        let result = write(2, data[written..].data, count)
        if result < 0 and c.errno() == c.interrupted:
            continue
        if result <= 0:
            return
        written += (usize)result

## The buffer `format` and f"..." fill: the bytes, their capacity, and the count used.
pub struct FormatBuffer:
    pub var data: u8*
    pub var capacity: usize
    pub var used: usize

## Append `count` bytes; 1 when they do not fit, and the buffer is then over capacity.
pub func format_put(b: FormatBuffer*, text: const void*?, count: usize) -> i32:
    if count > b.capacity or b.used > b.capacity - count:
        b.used = b.capacity +% 1
        return 1
    if let source = text:
        if count > 0:
            discard(memcpy(&b.data[b.used], source, count))
    b.used += count
    return 0

pub func format_u64(b: FormatBuffer*, value: u64) -> i32:
    var digits: u8[24] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[23] = 48
        n = 1
    while v != 0:
        n += 1
        digits[24 - n] = (u8)(48 + v % 10)
        v = v // 10
    return format_put(b, &digits[24 - n], n)

pub func format_i64(b: FormatBuffer*, value: i64) -> i32:
    if value < 0:
        let minus = "-"
        if format_put(b, minus.bytes.data, 1) != 0:
            return 1
        return format_u64(b, 0 -% (u64)value)
    return format_u64(b, (u64)value)

## `%g`, as the C library spells it, so both backends print one text.
pub func format_f64(b: FormatBuffer*, value: f64) -> i32:
    var text: u8[64] = ---
    let n = snprintf((void*)&text[0], 64, "%g", value)
    if n < 0:
        return 1
    return format_put(b, &text[0], (usize)n)

pub func format_bool(b: FormatBuffer*, value: bool) -> i32:
    let word = "true" if value else "false"
    return format_put(b, word.bytes.data, word.length)

## A `char` displays as itself, in UTF-8 (§14.4).
pub func format_char(b: FormatBuffer*, value: char) -> i32:
    let cp = u32(value)
    var out: u8[4]
    var n: usize = 0
    if cp < 0x80:
        out[0] = u8(cp)
        n = 1
    elif cp < 0x800:
        out[0] = u8(0xC0 | (cp >> 6))
        out[1] = u8(0x80 | (cp & 0x3F))
        n = 2
    elif cp < 0x10000:
        out[0] = u8(0xE0 | (cp >> 12))
        out[1] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[2] = u8(0x80 | (cp & 0x3F))
        n = 3
    else:
        out[0] = u8(0xF0 | (cp >> 18))
        out[1] = u8(0x80 | ((cp >> 12) & 0x3F))
        out[2] = u8(0x80 | ((cp >> 6) & 0x3F))
        out[3] = u8(0x80 | (cp & 0x3F))
        n = 4
    return format_put(b, (const void*)&out, n)

## The text so far, NUL-terminated when there is room.
pub func format_finish(b: FormatBuffer*) -> str:
    if b.used < b.capacity:
        b.data[b.used] = 0
    if b.used > b.capacity:
        return ""
    return (str)u8[](b.data, b.used)

## `hex`, `bin`, and `pad` return text in one of four rotating thread-local slots.
local var show_bytes: u8[1024]
local var show_next: u32

func show_take(source: const u8*, count: usize) -> str:
    let slot = (usize)(show_next & 3) * 256
    show_next = show_next +% 1
    var n = count
    if n > 255:
        n = 255
    if n > 0:
        discard(memcpy(&show_bytes[slot], source, n))
    show_bytes[slot + n] = 0
    return (str)show_bytes[slot..<slot + n]

pub func show_hex(value: u64) -> str:
    var digits: u8[16] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[15] = 48
        n = 1
    while v != 0:
        n += 1
        let d = (u8)(v & 15)
        digits[16 - n] = d + 48 if d < 10 else d + 87
        v = v >> 4
    return show_take(&digits[16 - n], n)

pub func show_bin(value: u64) -> str:
    var digits: u8[64] = ---
    var n: usize = 0
    var v = value
    if v == 0:
        digits[63] = 48
        n = 1
    while v != 0:
        n += 1
        digits[64 - n] = 48 + (u8)(v & 1)
        v = v >> 1
    return show_take(&digits[64 - n], n)

pub func show_pad(inner: str, width: usize) -> str:
    var n = inner.length
    if n >= width:
        return show_take(inner.bytes.data, n)
    var text: u8[256] = ---
    var pad = width - n
    if width > 255:
        if n > 255:
            n = 255
        pad = 255 - n
    for i in 0..<pad:
        text[i] = 32
    if n > 0:
        discard(memcpy(&text[pad], inner.bytes.data, n))
    return show_take(&text[0], pad + n)

## The startup shim's pieces: the argument vector as `str[]` (checked) or `c.str[]`.
pub func arguments(count: i32, vector: c.str*) -> str[]:
    let n = (usize)count
    let block = malloc((n if n > 0 else 1) * sizeof(str)) else trap("memory.exhausted")
    let items = (str*)block
    var i: usize = 0
    while i < n:
        let text = (str)vector[i]
        if not utf8_ok(text.bytes.data, text.length):
            trap("invalid_utf8")
        items[i] = text
        i += 1
    return str[](items, n)

pub func raw_arguments(count: i32, vector: c.str*) -> c.str[]:
    return c.str[](vector, (usize)count)

## A failed `main`: its error on stderr, exit status 1.
pub func main_failed(code: i32, message: str) -> i32:
    var bytes: u8[1024] = ---
    let line = format(bytes, f"error {code}: {message}\\n") catch:
        return 1
    discard(write(2, line.bytes.data, line.length))
    return 1

## The test runner's report line and its summary.
pub func test_report(name: str, failed: bool, message: str):
    var bytes: u8[1024] = ---
    let line = format(bytes, f"FAIL  {name}\\n      error: {message}\\n" if failed else f"ok    {name}\\n") catch:
        return
    discard(write(1, line.bytes.data, line.length))

pub func test_summary(total: i32, failed: i32) -> i32:
    var bytes: u8[64] = ---
    let line = format(bytes, f"{total - failed} passed\\n") catch:
        return 1
    discard(write(1, line.bytes.data, line.length))
    return 0 if failed == 0 else 1

## `print`: the text and a newline on stdout; `answer()` programs print their number.
pub func print_str(text: str):
    discard(write(1, text.bytes.data, text.length))
    let newline = "\\n"
    discard(write(1, newline.bytes.data, 1))

pub func print_i64(value: i64):
    var bytes: u8[32] = ---
    let all: u8[] = bytes
    var b = FormatBuffer(data = all.data, capacity = 32, used = 0)
    discard(format_i64(&b, value))
    discard(write(1, all.data, b.used))
    let newline = "\\n"
    discard(write(1, newline.bytes.data, 1))

## Ordering of text: bytewise, then by length (§7.4).
pub func str_compare(a: str, b: str) -> i32:
    let n = a.length if a.length < b.length else b.length
    var order: i32 = 0
    if n > 0:
        order = memcmp(a.bytes.data, b.bytes.data, n)
    if order != 0:
        return -1 if order < 0 else 1
    if a.length < b.length:
        return -1
    return 1 if a.length > b.length else 0

## The scalar starting at byte `index` of `count` bytes of valid UTF-8, its width left in
## `width`: what `for character in text` steps by (§5.5).
pub func utf8_scalar(text: const u8*, count: usize, index: usize, width: usize*) -> char:
    let byte = text[index]
    var w: usize = 1
    var cp: u32 = (u32)byte
    if byte >= 240:
        w = 4
        cp = (u32)(byte & 7)
    elif byte >= 224:
        w = 3
        cp = (u32)(byte & 15)
    elif byte >= 192:
        w = 2
        cp = (u32)(byte & 31)
    if index + w > count:
        w = count - index
    var k: usize = 1
    while k < w:
        cp = (cp << 6) | (u32)(text[index + k] & 63)
        k += 1
    *width = w
    return char(cp)

## Whether `count` bytes are well-formed UTF-8: no overlong forms, no surrogates, nothing past U+10FFFF.
pub func utf8_ok(text: const u8*?, count: usize) -> bool:
    let s = text else return count == 0
    var i: usize = 0
    while i < count:
        let byte = s[i]
        var w: usize = 1
        var cp: u32 = 0
        if byte < 128:
            cp = (u32)byte
        elif (byte & 224) == 192:
            w = 2
            cp = (u32)(byte & 31)
        elif (byte & 240) == 224:
            w = 3
            cp = (u32)(byte & 15)
        elif (byte & 248) == 240:
            w = 4
            cp = (u32)(byte & 7)
        else:
            return false
        if i + w > count:
            return false
        var k: usize = 1
        while k < w:
            let x = s[i + k]
            if (x & 192) != 128:
                return false
            cp = (cp << 6) | (u32)(x & 63)
            k += 1
        if w == 2 and cp < 128:
            return false
        if w == 3 and cp < 2048:
            return false
        if w == 4 and cp < 65536:
            return false
        if cp >= 55296 and cp <= 57343:
            return false
        if cp > 1114111:
            return false
        i += w
    return true

## `hash`: a per-process seed and a multiplicative mixer (§7.4).
var hash_seed_value: u64
var hash_seeded: bool

pub func hash_seed() -> u64:
    if not hash_seeded:
        hash_seed_value = 11400714819323198485 ^ (u64)(usize)&hash_seed_value
        hash_seeded = true
    return hash_seed_value

pub func hash_mix(h: u64, x: u64) -> u64:
    var r = h ^ x
    r = r *% 11400714819323198485
    r = r ^ (r >> 32)
    return r

pub func hash_bytes(h: u64, data: const void*?, count: usize) -> u64:
    var r = h
    if let p = data:
        let bytes = (const u8*)p
        var i: usize = 0
        while i < count:
            r = hash_mix(r, (u64)bytes[i])
            i += 1
    return hash_mix(r, (u64)count)

## Integer conversions between widths: `bits` of `value` as a 64-bit word.
func mask_of(bits: i32) -> u64:
    if bits >= 64:
        return 18446744073709551615
    return (1 << (u64)bits) - 1

func sign_extend(value: i64, bits: i32) -> i64:
    if bits >= 64:
        return value
    let m = mask_of(bits)
    let x = (u64)value & m
    if (x & (1 << (u64)(bits - 1))) != 0:
        return (i64)(x | ~m)
    return (i64)x

func zero_extend(value: u64, bits: i32) -> u64:
    return value & mask_of(bits)

func signed_min(bits: i32) -> i64:
    if bits >= 64:
        return -9223372036854775807 - 1
    return 0 -% (1 << (i64)(bits - 1))

func signed_max(bits: i32) -> i64:
    if bits >= 64:
        return 9223372036854775807
    return (1 << (i64)(bits - 1)) - 1

func fits_signed(value: i64, bits: i32) -> bool:
    return value >= signed_min(bits) and value <= signed_max(bits)

func fits_unsigned(value: u64, bits: i32) -> bool:
    return value <= mask_of(bits)

## `T(x)` between integers (`mode` 0, checked) and `(T)x` (`mode` 1, truncating).
pub func conv_s(value: i64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32) -> i64:
    var a = value
    if from_signed != 0:
        a = sign_extend(a, from_bits)
    else:
        a = (i64)zero_extend((u64)a, from_bits)
    if mode == 0:
        if to_signed != 0:
            if not fits_signed(a, to_bits):
                trap("integer conversion out of range")
            return a
        if a < 0 or not fits_unsigned((u64)a, to_bits):
            trap("integer conversion out of range")
        return a
    let bits = (u64)a & mask_of(to_bits)
    if to_signed != 0:
        return sign_extend((i64)bits, to_bits)
    return (i64)bits

pub func conv_u(value: u64, from_bits: i32, from_signed: i32, to_bits: i32, to_signed: i32, mode: i32) -> u64:
    let s = sign_extend((i64)value, from_bits) if from_signed != 0 else (i64)zero_extend(value, from_bits)
    if mode == 0:
        if to_signed != 0:
            if not fits_signed(s, to_bits):
                trap("integer conversion out of range")
            return (u64)s
        if s < 0 or not fits_unsigned((u64)s, to_bits):
            trap("integer conversion out of range")
        return (u64)s
    return zero_extend((u64)s, to_bits)

func is_finite(value: f64) -> bool:
    return value - value == 0.0

## Float to integer: checked (`mode` 0) or saturating (`mode` 1); the cast inside is the target's own.
pub func f_to_s(value: f64, bits: i32, mode: i32) -> i64:
    let low = (f64)signed_min(bits)
    let high = (f64)signed_max(bits)
    if mode == 0:
        if not is_finite(value) or value < low or value > high:
            trap("integer conversion out of range")
        return (i64)value
    if value != value:
        return 0
    if value <= low:
        return signed_min(bits)
    if value >= high:
        return signed_max(bits)
    return (i64)value

pub func f_to_u(value: f64, bits: i32, mode: i32) -> u64:
    let high = (f64)mask_of(bits)
    if mode == 0:
        if not is_finite(value) or value < 0.0 or value > high:
            trap("integer conversion out of range")
        return (u64)value
    if value != value or value < 0.0:
        return 0
    if value >= high:
        return mask_of(bits)
    return (u64)value

## Saturating arithmetic (`+|`, `-|`, `*|`) on `bits`-wide operands in 64-bit words.
func add_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ r) & (b ^ r)) < 0

func sub_overflows_s(a: i64, b: i64, r: i64) -> bool:
    return ((a ^ b) & (a ^ r)) < 0

func mul_overflows_s(a: i64, b: i64) -> bool:
    if a == 0 or b == 0:
        return false
    if a == -1:
        return b == signed_min(64)
    if b == -1:
        return a == signed_min(64)
    return (a *% b) // b != a

pub func adds_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

pub func adds_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return mask_of(bits)
    return r

pub func subs_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return signed_min(bits) if a < 0 else signed_max(bits)
    return r

pub func subs_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return 0
    return a - b

pub func muls_s(x: i64, y: i64, bits: i32) -> i64:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return signed_min(bits) if (a < 0) != (b < 0) else signed_max(bits)
    return a *% b

pub func muls_u(x: u64, y: u64, bits: i32) -> u64:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return mask_of(bits)
    return zero_extend(a *% b, bits)

## Checked-to-optional arithmetic (`+?`, `-?`, `*?`): the result through `out`, whether it fit.
pub func qadd_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a +% b
    if add_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

pub func qadd_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    let r = a +% b
    if r < a or not fits_unsigned(r, bits):
        return false
    *out = r
    return true

pub func qsub_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    let r = a -% b
    if sub_overflows_s(a, b, r) or not fits_signed(r, bits):
        return false
    *out = r
    return true

pub func qsub_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if a < b:
        return false
    *out = a - b
    return true

pub func qmul_s(x: i64, y: i64, bits: i32, out: i64*) -> bool:
    let a = sign_extend(x, bits)
    let b = sign_extend(y, bits)
    if mul_overflows_s(a, b) or not fits_signed(a *% b, bits):
        return false
    *out = a *% b
    return true

pub func qmul_u(x: u64, y: u64, bits: i32, out: u64*) -> bool:
    let a = zero_extend(x, bits)
    let b = zero_extend(y, bits)
    if b != 0 and a > mask_of(bits) // b:
        return false
    *out = a *% b
    return true
"""),
    Prelude(name = "memory", text = """
import platform

extern func malloc(size: usize) -> void*?
extern func c_free as "free"(block: void*)
extern func posix_memalign(memptr: void*?*, alignment: usize, size: usize) -> i32
extern func memcpy(target: void*, source: const void*, count: usize) -> void*
extern func memmove(target: void*, source: const void*, count: usize) -> void*
extern func memset(target: void*, value: i32, count: usize) -> void*

## What every allocator offers: blocks of bytes at an alignment, optionally
## resized in place, and given back (§12.4).
pub interface Allocator:
    mutating func allocate(size: usize, alignment: usize) -> u8[]?
    mutating func resize(block: u8[], size: usize) -> bool
    mutating func release(block: u8[])

## A bump allocator over a caller's bytes. Only the last block can be resized or
## released; everything goes away together when the buffer does.
pub struct FixedBuffer: Allocator:
    var data: u8[]
    var used: usize

    pub static func over(buffer: u8[]) -> FixedBuffer:
        return FixedBuffer(data = buffer, used = 0)

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return self.data[..<0]
        let align = alignment if alignment > 0 else 1
        # the address is what must be aligned, not the offset: the backing span starts
        # wherever its owner put it
        let base = (usize)self.data.data
        let free_at = base + self.used
        let aligned = (free_at + (align - 1)) & ~(align - 1)
        if aligned < free_at:
            return none
        let start = aligned - base
        if start > self.data.length or size > self.data.length - start:
            note_refusal("fixed buffer", size, align, self.used)
            return none
        self.used = start + size
        return self.data[start..<self.used]

    pub mutating func resize(block: u8[], size: usize) -> bool:
        if size == block.length:
            return true
        if block.length == 0:
            return false
        let start = (usize)block.data - (usize)self.data.data
        if start + block.length != self.used:
            return false
        if start + size > self.data.length:
            return false
        self.used = start + size
        return true

    pub mutating func release(block: u8[]):
        if block.length == 0:
            return
        if diagnostic:
            discard(memset(block.data, 221, block.length))    # a fixed buffer releases all at once
        let start = (usize)block.data - (usize)self.data.data
        if start + block.length == self.used:
            self.used = start

## The C library's heap.
pub struct CAllocator: Allocator:
    var unused: u8

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return u8[]((u8*)8, 0)
        var align = alignment if alignment > 8 else 8
        var p: void*? = none
        if posix_memalign(&p, align, size) != 0:
            note_refusal("heap", size, align, 0)
            return none
        let block = p else return none
        return u8[]((u8*)block, size)

    pub mutating func resize(block: u8[], size: usize) -> bool:
        return size <= block.length

    pub mutating func release(block: u8[]):
        if block.length == 0:
            return
        if not diagnostic:
            c_free(block.data)
            return
        # the diagnostic profile (§19.4): the block is filled with a pattern and held back, so
        # a use after release reads the pattern rather than the next allocation
        discard(memset(block.data, 221, block.length))
        lock(&records_lock)
        let slot = quarantine_next % quarantine.length
        if let old = quarantine[slot]:
            c_free(old.data)
        quarantine[slot] = block
        quarantine_next += 1
        unlock(&records_lock)

## Bump allocation over a parent allocator, released all at once by `reset` or `destroy`
## (§12.4, §24.3). One thread at a time.
pub struct Arena: Allocator:
    var parent: Allocator
    var block: u8[]
    var used: usize

    pub static func over(parent: Allocator, capacity: usize) -> Arena!:
        let block = parent.allocate(capacity, 16) else error(exhausted, "memory.exhausted")
        return Arena(parent = parent, block = block, used = 0)

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return self.block[..<0]
        let align = alignment if alignment > 0 else 1
        let base = (usize)self.block.data
        let start = ((base + self.used + align - 1) // align * align) - base
        let end = start +? size else return none
        if end > self.block.length:
            note_refusal("arena", size, align, self.used)
            return none
        self.used = end
        return self.block[start..<end]

    pub mutating func resize(block: u8[], size: usize) -> bool:
        if size == block.length:
            return true
        if block.length == 0:
            return false
        # the last block may grow or shrink in place
        let start = (usize)block.data - (usize)self.block.data
        if start + block.length != self.used or start + size > self.block.length:
            return false
        self.used = start + size
        return true

    pub mutating func release(block: u8[]):
        if diagnostic and block.length > 0:
            discard(memset(block.data, 221, block.length))    # an arena releases all at once

    ## What has been handed out since the last reset, and what the arena holds in all.
    pub func in_use() -> usize:
        return self.used
    pub func capacity() -> usize:
        return self.block.length

    ## Forget every allocation; the storage is reused from its start.
    pub mutating func reset():
        self.used = 0

    ## Give the storage back to the parent; the arena is empty afterwards.
    pub mutating func destroy():
        self.parent.release(self.block)
        self.block = self.block[..<0]
        self.used = 0

## Whole pages from the host, each block its own mapping (§12.4). Safe from several threads.
pub struct PageAllocator: Allocator:
    var unused: u8

    pub mutating func allocate(size: usize, alignment: usize) -> u8[]?:
        if size == 0:
            return u8[]((u8*)8, 0)
        let page = (usize)getpagesize()
        if alignment > page:
            note_refusal("page allocator", size, alignment, 0)
            return none
        let rounded = (size + page - 1) // page * page
        let mapped = mmap(none, rounded, 3, private_anonymous, -1, 0) else return none
        if (usize)mapped == 18446744073709551615:
            note_refusal("page allocator", size, alignment, 0)
            return none
        return u8[]((u8*)mapped, rounded)

    pub mutating func resize(block: u8[], size: usize) -> bool:
        return size <= block.length

    pub mutating func release(block: u8[]):
        if block.length == 0:
            return
        if not diagnostic:
            discard(munmap(block.data, block.length))
            return
        # the diagnostic profile (§19.4): the mapping is filled and kept for a while, so a
        # use after release reads the pattern rather than faulting or reading a new mapping
        discard(memset(block.data, 221, block.length))
        lock(&records_lock)
        let slot = held_next % held_pages.length
        if let old = held_pages[slot]:
            discard(munmap(old.data, old.length))
        held_pages[slot] = block
        held_next += 1
        unlock(&records_lock)

extern func mmap(address: void*?, length: usize, protection: i32, flags: i32, descriptor: i32, offset: i64) -> void*?
## `MAP_PRIVATE | MAP_ANON`: `MAP_ANON` is 0x1000 on macOS and 0x20 on Linux; the
## protection `PROT_READ | PROT_WRITE` is 3 on both.
let private_anonymous: i32 = 4098 if platform.macos else 34
extern func munmap(address: void*, length: usize) -> i32
extern func getpagesize() -> i32

## The heap refusing a request is rare and worth a line on standard error: what was asked,
## so an exhaustion in the field says more than its error code. A fixed buffer running out
## is ordinary and says nothing.
func note_refusal(who: str, size: usize, alignment: usize, used: usize):
    var text: u8[160]
    let line = format(text, f"memory: the {who} refused {size} bytes at alignment {alignment} (used {used})\\n") catch failure:
        return
    discard(write_bytes(2, line.bytes.data, line.length))

extern func write_bytes as "write"(descriptor: i32, buffer: const void*, count: usize) -> isize

## `--profile diagnostic`: set by the startup shim before `startup` runs.
pub var diagnostic: bool

## An allocation the diagnostic profile recorded (§19.4): the block, its size, and where.
pub struct Site:
    pub var address: void*?
    pub var size: usize
    pub var function: str
    pub var line: u32

var sites: Site[256]
var site_next: usize

## The diagnostic profile's records are shared by every thread: a short spin lock guards
## each update, on the atomic `@bool` alone, since this module is below `sync`.
var records_lock: @bool

func lock(flag: (@bool)*):
    while true:
        let (exchanged, observed) = flag.cas(false, true)
        discard(observed)
        if exchanged:
            return

func unlock(flag: (@bool)*):
    flag.store(false)

## Called by the compiled program after each allocation under `--profile diagnostic`.
## The record keeps the most recent 256 allocations, oldest first: once full, the oldest
## goes and the newest takes the last place.
pub func note_site(address: void*?, size: usize, function: str, line: u32):
    lock(&records_lock)
    if site_next < sites.length:
        sites[site_next] = Site(address = address, size = size, function = function, line = line)
    else:
        var i: usize = 1
        while i < sites.length:
            sites[i - 1] = sites[i]
            i += 1
        sites[sites.length - 1] = Site(address = address, size = size, function = function, line = line)
    site_next += 1
    unlock(&records_lock)

## The allocations recorded so far, the most recent 256 at most, oldest first. A view of
## the record: read it while no other thread allocates.
pub func allocation_sites() -> const Site[]:
    let held = site_next if site_next < sites.length else sites.length
    return sites[..<held]
## The released blocks the diagnostic profile still holds, oldest freed first.
var quarantine: (u8[]?)[64]
var quarantine_next: usize
## The released mappings the diagnostic profile still holds, oldest first.
var held_pages: (u8[]?)[8]
var held_next: usize

pub let exhausted: ErrorCode = ErrorCode.package(1)
pub let unset: ErrorCode = ErrorCode.package(2)

var c_allocator: CAllocator
## The current allocator of this thread (§12.3) and the process's initial one.
pub local var allocator: Allocator
pub var heap: Allocator

## Run by the startup shim before `main`, and by `thread.spawn` in a new thread.
pub func startup():
    heap = &c_allocator
    allocator = heap

pub func copy[T](target: T[], source: const T[], count: usize):
    if count > target.length or count > source.length:
        trap("index out of bounds")
    if count > 0:
        discard(memcpy(target.data, source.data, count * sizeof(T)))

pub func move[T](target: T[], source: const T[], count: usize):
    if count > target.length or count > source.length:
        trap("index out of bounds")
    if count > 0:
        discard(memmove(target.data, source.data, count * sizeof(T)))

pub func set(target: u8[], value: u8):
    if target.length > 0:
        discard(memset(target.data, (i32)value, target.length))

pub func read[T](address: const void*) -> T:
    var value: T = ---
    discard(memcpy(&value, address, sizeof(T)))
    return value

pub func write[T](address: void*, value: T):
    var copy_of = value
    discard(memcpy(address, &copy_of, sizeof(T)))

## `block` with `size` bytes: in place when the current allocator can, else a
## new block with the old bytes copied and the old block released.
pub func grow(block: u8[], size: usize) -> u8[]!:
    if allocator.resize(block, size):
        return u8[](block.data, size)
    let fresh = allocator.allocate(size, 8) else error(exhausted, "memory.exhausted")
    let keep = block.length if block.length < size else size
    if keep > 0:
        discard(memcpy(fresh.data, block.data, keep))
    allocator.release(block)
    return fresh
"""),
    Prelude(name = "io", text = """
import c
import core
import memory
import platform
extern func fwrite(data: const void*, size: usize, count: usize, stream: void*) -> usize
extern func fflush(stream: void*?) -> i32
extern func flockfile(stream: void*)
extern func funlockfile(stream: void*)
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize

## A borrowed byte source. A successful read returns at most the buffer length;
## zero for a nonempty buffer means EOF. Empty reads return zero without consuming
## input. Errors are distinct from EOF. The implementing object owns its lifetime.
pub interface Reader:
    mutating func read(buffer: u8[]) -> usize!

## A borrowed byte sink (§14.4). A write may accept fewer bytes than supplied;
## callers needing the whole payload use `write_all`. Empty writes return zero.
## A failure may follow earlier successful writes; the view never owns the sink.
pub interface Writer:
    mutating func write(data: const u8[]) -> usize!

pub let unexpected_eof: ErrorCode = ErrorCode.package(14)
pub let no_progress: ErrorCode = ErrorCode.package(15)
pub let invalid_count: ErrorCode = ErrorCode.package(16)
pub let invalid_buffer: ErrorCode = ErrorCode.package(17)

## Fill `buffer`, or fail at EOF or on a source error. Optional `transferred` is
## reset to zero on entry and updated after each successful read, including before
## a later failure. It must not overlap the buffer or the source's state. No call
## reaches the source for an empty buffer. The source remains borrowed and open.
pub func read_exact(source: Reader, buffer: u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < buffer.length:
        let count = try source.read(buffer[done..])
        if count > buffer.length - done:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            error(unexpected_eof, "the reader ended before the buffer was filled")
        done += count
        if let progress = transferred:
            *progress = done

## Write all bytes, preserving confirmed progress through `transferred` on error.
## The progress pointer must not overlap the data or sink state. A zero-length
## successful write on nonempty input fails with `no_progress` instead of spinning.
## This does not flush or close the borrowed sink. Empty input makes no sink call.
pub func write_all(destination: Writer, data: const u8[], transferred: usize*? = none) -> !:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    while done < data.length:
        let count = try destination.write(data[done..])
        if count > data.length - done:
            error(invalid_count, "the writer returned more bytes than supplied")
        if count == 0:
            error(no_progress, "the writer accepted no bytes")
        done += count
        if let progress = transferred:
            *progress = done

## Copy at most `limit` bytes through caller-owned scratch storage; stop earlier
## at EOF. Reads never consume beyond the limit. `transferred` counts confirmed
## destination bytes, including before a failure; source consumption can be ahead
## by one scratch buffer if writing fails. Scratch and progress must not overlap
## either endpoint's state/data or each other. No allocation, flush or close occurs.
pub func copy_limit(source: Reader, destination: Writer, buffer: u8[], limit: usize, transferred: usize*? = none) -> usize!:
    var done: usize = 0
    if let progress = transferred:
        *progress = 0
    if limit == 0:
        return 0
    if buffer.length == 0:
        error(invalid_buffer, "copying requires a nonempty scratch buffer")
    while done < limit:
        let available = limit - done
        let requested = buffer.length if buffer.length < available else available
        let count = try source.read(buffer[..<requested])
        if count > requested:
            error(invalid_count, "the reader returned more bytes than requested")
        if count == 0:
            break
        var written: usize = 0
        write_all(destination, buffer[..<count], &written) catch failure:
            if let progress = transferred:
                *progress = done + written
            error(failure.code, failure.message)
        done += written
        if let progress = transferred:
            *progress = done
    return done

## A cursor over borrowed bytes. Copying the reader copies its position, not its
## data. The backing storage must outlive the reader and every read using it.
pub struct SliceReader: Reader:
    var data: const u8[]
    var position: usize

    pub static func over(data: const u8[]) -> SliceReader:
        return SliceReader(data = data, position = 0)

    pub func remaining() -> usize:
        return self.data.length - self.position

    ## Copy up to the buffer length; zero means no bytes remain (or an empty read).
    pub mutating func read(buffer: u8[]) -> usize!:
        let left = self.remaining()
        let count = buffer.length if buffer.length < left else left
        memory.move(buffer, self.data[self.position..], count)
        self.position += count
        return count

## A writer into fixed borrowed storage. Copying it copies the cursor and aliases
## storage. Writes may be short; once full, a nonempty write fails with `full`.
pub struct SliceWriter: Writer:
    var data: u8[]
    var used: usize

    pub static func over(data: u8[]) -> SliceWriter:
        return SliceWriter(data = data, used = 0)

    ## View of confirmed written bytes, borrowed from the caller's storage.
    pub func written() -> const u8[]:
        return self.data[..<self.used]

    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let left = self.data.length - self.used
        if left == 0:
            error(full, "the destination buffer is full")
        let count = data.length if data.length < left else left
        memory.move(self.data[self.used..], data, count)
        self.used += count
        return count

## Buffered input over a borrowed source and nonempty caller-owned storage. Both
## must outlive this adapter. Storage must not overlap source state or read buffers.
## Construct with `over`; serialize access and do not use copied adapters together.
## Reads may prefetch beyond the requested bytes. The adapter never closes its source.
pub struct BufferedReader: Reader:
    var source: Reader
    var storage: u8[]
    var position: usize
    var used: usize

    pub static func over(source: Reader, storage: u8[]) -> BufferedReader!:
        if storage.length == 0:
            error(invalid_buffer, "buffered input requires nonempty storage")
        return BufferedReader(source = source, storage = storage, position = 0, used = 0)

    ## Unread bytes already fetched. No source operation occurs.
    pub func buffered() -> usize:
        return self.used - self.position

    ## Return buffered bytes first, otherwise perform one source read. Empty reads
    ## do not call the source. EOF is not cached, allowing a growing source to resume.
    pub mutating func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        if self.position == self.used:
            let count = try self.source.read(self.storage)
            if count > self.storage.length:
                error(invalid_count, "the reader returned more bytes than requested")
            self.position = 0
            self.used = count
        let available = self.buffered()
        let count = buffer.length if buffer.length < available else available
        memory.copy(buffer, self.storage[self.position..], count)
        self.position += count
        return count

## Buffered output over a borrowed sink and nonempty caller-owned storage. Both
## must outlive this adapter; storage must not overlap sink state or write input.
## Construct with `over`; serialize access and do not use copied adapters together.
## Explicitly flush before discarding the adapter. There is no implicit flush/close.
pub struct BufferedWriter: Writer:
    var destination: Writer
    var storage: u8[]
    var used: usize

    pub static func over(destination: Writer, storage: u8[]) -> BufferedWriter!:
        if storage.length == 0:
            error(invalid_buffer, "buffered output requires nonempty storage")
        return BufferedWriter(destination = destination, storage = storage, used = 0)

    ## Bytes accepted by this adapter but not yet confirmed by the destination.
    pub func buffered() -> usize:
        return self.used

    ## Drain this buffer, preserving the unconfirmed suffix if the sink fails.
    ## Retrying does not resend bytes confirmed by earlier successful sink writes.
    ## This neither flushes downstream buffers nor requests filesystem durability.
    pub mutating func flush() -> !:
        var written: usize = 0
        write_all(self.destination, self.storage[..<self.used], &written) catch failure:
            self.used -= written
            memory.move(self.storage, self.storage[written..], self.used)
            error(failure.code, failure.message)
        self.used = 0

    ## Accept up to the remaining capacity. A full buffer is drained before any
    ## new input is accepted; a failure accepts none of this call's input. Empty
    ## writes do not drain the buffer. Use write_all to accept an entire payload.
    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        if self.used == self.storage.length:
            try self.flush()
        let available = self.storage.length - self.used
        let count = data.length if data.length < available else available
        memory.copy(self.storage[self.used..], data, count)
        self.used += count
        return count

## A compile-time source position, the value of `luce.location`.
pub struct Location:
    pub var file: str
    pub var line: u32
    pub var function: str

pub let closed: ErrorCode = ErrorCode.package(3)

pub let failed: ErrorCode = ErrorCode.package(24)
pub let would_block: ErrorCode = ErrorCode.package(28)

## Borrowed standard output stream. Each nonempty write uses the existing libc
## stream and flushes only that stream, making completed output visible before a
## following print. The libc stream lock serializes each write with other libc
## users; concurrent direct descriptor writes may interleave. No stream is created
## or owned here. A write/flush failure can follow partial output.
pub struct File: Writer:
    var descriptor: i32

    func stream() -> void*!:
        if self.descriptor == 1:
            return c.stdout()
        if self.descriptor == 2:
            return c.stderr()
        error(closed, "the standard output stream is unavailable")

    ## Flush this C stream, without closing it or requesting filesystem durability.
    pub mutating func flush() -> !:
        let stream = try self.stream()
        if fflush(stream) != 0:
            error(closed, "the stream could not be flushed")

    pub mutating func write(data: const u8[]) -> usize!:
        if data.length == 0:
            return 0
        let stream = try self.stream()
        flockfile(stream)
        defer funlockfile(stream)
        let written = fwrite(data.data, 1, data.length, stream)
        let flushed = fflush(stream)
        if written != data.length or flushed != 0:
            error(closed, "the stream refused the bytes")
        return written

var out_file: File = File(descriptor = 1)
var err_file: File = File(descriptor = 2)

## Unbuffered input borrows descriptor zero. It retries interrupted calls, reports
## would-block separately, and never owns or closes the process's descriptor.
struct StandardInput: Reader:
    var descriptor: i32

    pub mutating func read(buffer: u8[]) -> usize!:
        if buffer.length == 0:
            return 0
        let requested = 1073741824 if buffer.length > 1073741824 else buffer.length
        while true:
            let count = c_read(self.descriptor, buffer.data, requested)
            if count >= 0:
                return (usize)count
            let number = c.errno()
            if number == c.interrupted:
                continue
            if number == (35 if platform.macos else 11):
                error(would_block, "standard input would block")
            if number == 9:
                error(closed, "standard input is closed")
            error(failed, "standard input could not be read")

var in_file: StandardInput = StandardInput(descriptor = 0)

## Borrowed unbuffered standard input. Reads may block; concurrent readers compete
## for bytes. Do not mix with buffered C stdin reads, which may have prefetched data.
pub func stdin() -> Reader:
    return &in_file

pub func stdout() -> Writer:
    return &out_file

pub func stderr() -> Writer:
    return &err_file

## Explicitly flush C stdout, including bytes written through C interop.
pub func flush_stdout() -> !:
    try out_file.flush()

## Explicitly flush C stderr, including bytes written through C interop.
pub func flush_stderr() -> !:
    try err_file.flush()

pub let full: ErrorCode = ErrorCode.package(4)

## The sink a formatted string offers a `Display` value (§14.4): it appends to the buffer
## the compiler is filling, and fails once that buffer is full, as `format` then does.
pub struct FormatSink: Writer:
    var buffer: core.FormatBuffer*

    pub mutating func write(data: const u8[]) -> usize!:
        if core.format_put(self.buffer, data.data, data.length) != 0:
            error(full, "the buffer is full")
        return data.length

## The process's directories (§16.6): `from io import path`, then `path.user()`. Each is
## a `str` view of environment storage the system owns, or fresh storage from the current
## allocator where one has to be built.
pub struct path:
    var unused: u8

    ## The user's home directory: `$HOME`.
    pub static func user() -> str!:
        let home = getenv("HOME") else error(io_path_failed, "no home directory")
        return (str)home

    pub static func home() -> str!:
        return try path.user()

    ## Where temporary files go: `$TMPDIR`, else `/tmp`.
    pub static func temp() -> str:
        let dir = getenv("TMPDIR") else return "/tmp"
        return (str)dir

    ## Where configuration lives: `$XDG_CONFIG_HOME`, else `$HOME/.config`.
    pub static func config() -> str!:
        if let set = getenv("XDG_CONFIG_HOME"):
            return (str)set
        let home = try path.user()
        let buffer = try alloc u8[home.length + 8]
        return try format(buffer, f"{home}/.config")

extern func getenv(name: c.str) -> c.str?
pub let io_path_failed: ErrorCode = ErrorCode.package(13)
"""),
    Prelude(name = "luce", text = """
## The derived bounds of §14.4: every type with `==` is Equatable, every hashable
## one Hashable, every ordered one Comparable. Nothing implements them by hand.

import io

pub interface Equatable:
    func equals(other: void*) -> bool
pub interface Hashable:
    func hashed() -> u64
pub interface Comparable:
    func compare(other: void*) -> i64

## The protocols `for` consumes (§8.3, §14.4): a value iterator answers each element
## until `none`; an iterable answers a fresh iterator of its own concrete type.
pub interface Iterator[T]:
    mutating func next() -> T?
pub interface Iterable[T, I: Iterator[T]]:
    func iterator() -> I

## A value that writes itself to a sink (§14.4); formatted strings call it for each field.
pub interface Display:
    func display(sink: io.Writer) -> !

## Compile-time facts about the use site; the backend replaces them (§9.1).
pub let file: str = ""
pub let line: u32 = 0
pub let function: str = ""
pub let location: io.Location = io.Location(file = "", line = 0, function = "")
"""),
    Prelude(name = "atomic", text = """
## Memory orderings for the operations of `@T` (§15.1).
pub enum Ordering as u8:
    relaxed = 1
    acquire = 2
    release = 3
    acq_rel = 4
    seq_cst = 5

## A standalone fence; the backend supplies the instruction.
pub func fence(order: Ordering):
    discard(order)
"""),
    Prelude(name = "thread", text = """
import c
import memory
import platform

extern func pthread_create(thread: void*?*, attributes: void*?, start: func(void*) -> void*?, argument: void*) -> i32
extern func pthread_join(thread: void*, result: void*?*?) -> i32
extern func pthread_detach(thread: void*) -> i32
extern func pthread_self() -> void*
extern func pthread_attr_init(attributes: void*) -> i32
extern func pthread_attr_setstacksize(attributes: void*, size: usize) -> i32
extern func pthread_attr_destroy(attributes: void*) -> i32
## macOS names the calling thread; Linux names one by handle. Both cap a name at 15 bytes.
extern func mac_setname as "pthread_setname_np"(name: c.str) -> i32
extern func linux_setname as "pthread_setname_np"(thread: void*, name: c.str) -> i32
extern func sched_yield() -> i32
extern func nanosleep(request: const Duration*, remaining: Duration*?) -> i32
extern func getpagesize() -> i32

extern struct Duration:
    seconds: i64
    nanoseconds: i64

pub let failed: ErrorCode = ErrorCode.package(5)

## `PTHREAD_STACK_MIN` on both hosts: a smaller stack is raised to it.
let least_stack: usize = 16384
## The longest name a thread may carry, with its NUL.
let name_room: usize = 16

## A running thread; the zero value is no thread at all, so arrays of handles exist.
pub struct Handle:
    var id: void*?

    pub func join() -> !:
        let id = self.id else error(failed, "no thread to join")
        if pthread_join(id, none) != 0:
            error(failed, "join")

    pub func detach():
        let id = self.id else return
        discard(pthread_detach(id))

## What a new thread starts with: the entry, its context, its name in a heap block of
## `name_room` bytes, NUL-terminated, and the allocator rule of §15.3.
struct Start:
    var entry: func(void*?) -> unit
    var context: void*?
    var name: u8[]
    var name_length: usize

func trampoline(raw: void*) -> void*?:
    let start = (Start*)raw
    memory.allocator = memory.heap
    let entry = start.entry
    let context = start.context
    if start.name_length > 0:
        let text = (c.str)(str)start.name[..<start.name_length]
        if platform.macos:
            discard(mac_setname(text))
        else:
            discard(linux_setname(pthread_self(), text))
    free(start.name) in memory.heap
    free(start) in memory.heap
    entry(context)
    return none

## Start a thread running `entry(context)`. `stack` is its stack in bytes, the host's
## default when 0, else at least `PTHREAD_STACK_MIN` and whole pages; `name` is what the
## host's tools show for it, its first fifteen bytes.
pub func spawn(entry: func(void*?) -> unit, context: void*?, stack: usize = 0, name: str = "") -> Handle!:
    let copy = try alloc u8[name_room] in memory.heap
    let kept = name.length if name.length < name_room - 1 else name_room - 1
    memory.copy(copy, name.bytes, kept)
    copy[kept] = 0
    let start = new Start(entry = entry, context = context, name = copy, name_length = kept) in memory.heap catch failure:
        free(copy) in memory.heap
        error(memory.exhausted, "memory.exhausted")
    var attributes: u64[16]
    if pthread_attr_init((void*)&attributes[0]) != 0:
        free(copy) in memory.heap
        free(start) in memory.heap
        error(failed, "spawn")
    if stack > 0:
        let page = (usize)getpagesize()
        var size = stack if stack > least_stack else least_stack
        size = (size + page - 1) // page * page
        if pthread_attr_setstacksize((void*)&attributes[0], size) != 0:
            discard(pthread_attr_destroy((void*)&attributes[0]))
            free(copy) in memory.heap
            free(start) in memory.heap
            error(failed, "the stack size is refused")
    var id: void*? = none
    let created = pthread_create(&id, (void*)&attributes[0], trampoline, (void*)start)
    discard(pthread_attr_destroy((void*)&attributes[0]))
    if created != 0:
        free(copy) in memory.heap
        free(start) in memory.heap
        error(failed, "spawn")
    let thread = id else error(failed, "spawn")
    return Handle(id = thread)

pub func current() -> Handle:
    return Handle(id = pthread_self())

## A hint to the processor inside a spin loop.
pub func pause():
    asm arm64:
        yield
    asm x86_64:
        pause

pub func yield():
    discard(sched_yield())

## Sleep for at least `milliseconds`: a signal that interrupts the sleep leaves the time
## remaining, which is slept again.
pub func sleep(milliseconds: u64):
    var request = Duration(seconds = (i64)(milliseconds // 1000), nanoseconds = (i64)(milliseconds % 1000) * 1000000)
    var remaining = Duration(seconds = 0, nanoseconds = 0)
    while nanosleep(&request, &remaining) != 0 and c.errno() == c.interrupted:
        request = remaining
"""),
    Prelude(name = "sync", text = """
import platform

## macOS: the `ulock` calls libSystem builds its own locks on.
extern func __ulock_wait(operation: u32, address: void*, value: u64, timeout: u32) -> i32
extern func __ulock_wake(operation: u32, address: void*, wake_value: u64) -> i32
## Linux: the futex system call, through `syscall`; the number is the architecture's.
extern func syscall(number: i64, ...) -> i64

let compare_and_wait: u32 = 1
let wake_all: u32 = 256
let futex_number: i64 = 98 if platform.arm64 else 202
let futex_wait_private: i32 = 128
let futex_wake_private: i32 = 129

## Sleep in the kernel while the word at `address` still holds `value`; a change
## or a wake returns, and so may nothing at all, so every caller loops.
func sleep_on(address: void*, value: u32):
    if platform.macos:
        discard(__ulock_wait(compare_and_wait, address, (u64)value, 0))
    else:
        let no_timeout: void*? = none
        discard(syscall(futex_number, address, futex_wait_private, value, no_timeout))

func wake_one(address: void*):
    if platform.macos:
        discard(__ulock_wake(compare_and_wait, address, 0))
    else:
        discard(syscall(futex_number, address, futex_wake_private, 1))

func wake_every(address: void*):
    if platform.macos:
        discard(__ulock_wake(compare_and_wait | wake_all, address, 0))
    else:
        discard(syscall(futex_number, address, futex_wake_private, 2147483647))

## A lock whose waiters sleep: zero is unlocked, so `var lock: Mutex` is ready to
## use; one is locked; two is locked with someone asleep on it.
pub struct Mutex:
    var state: @u32

    pub mutating func lock():
        let (taken, seen) = self.state.cas(0, 1, .acquire, .relaxed)
        if taken:
            return
        var current = seen
        if current != 2:
            current = self.state.swap(2, .acquire)
        while current != 0:
            sleep_on((void*)&self.state, 2)
            current = self.state.swap(2, .acquire)

    pub mutating func unlock():
        if self.state.swap(0, .release) == 2:
            wake_one((void*)&self.state)

    pub mutating func try_lock() -> bool:
        let (taken, seen) = self.state.cas(0, 1, .acquire, .relaxed)
        discard(seen)
        return taken

## A sequence number waiters watch; every signal advances it and wakes.
pub struct Condition:
    var sequence: @u32

    pub mutating func wait(mutex: Mutex*):
        let seen = self.sequence.load(.acquire)
        mutex.unlock()
        sleep_on((void*)&self.sequence, seen)
        mutex.lock()

    pub mutating func signal():
        discard(self.sequence.add(1, .release))
        wake_one((void*)&self.sequence)

    pub mutating func broadcast():
        discard(self.sequence.add(1, .release))
        wake_every((void*)&self.sequence)

## Runs its function exactly once; later callers wait for the first to finish.
pub struct Once:
    var state: @u32

    pub mutating func run(function: func() -> unit):
        let (first, seen) = self.state.cas(0, 1, .acq_rel, .acquire)
        discard(seen)
        if first:
            function()
            self.state.store(2, .release)
            wake_every((void*)&self.state)
            return
        while self.state.load(.acquire) != 2:
            sleep_on((void*)&self.state, 1)

## A counting semaphore whose waiters sleep.
pub struct Semaphore:
    var count: @u32

    pub mutating func acquire():
        while true:
            let n = self.count.load(.acquire)
            if n > 0:
                let (taken, seen) = self.count.cas(n, n - 1, .acq_rel, .relaxed)
                discard(seen)
                if taken:
                    return
            else:
                sleep_on((void*)&self.count, 0)

    pub mutating func release():
        discard(self.count.add(1, .release))
        wake_one((void*)&self.count)
"""),
    Prelude(name = "process", text = """
import c
import memory
import platform

extern func pipe(descriptors: i32*) -> i32
extern func fork() -> i32
extern func dup2(from_fd: i32, to_fd: i32) -> i32
extern func close(descriptor: i32) -> i32
extern func execvp(program: c.str, arguments: void*?*) -> i32
extern func c_exit as "exit"(code: i32) -> never
extern func _exit(code: i32) -> never
extern func waitpid(pid: i32, status: i32*, options: i32) -> i32
extern func kill(pid: i32, signal: i32) -> i32
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func poll(descriptors: Poll*, count: u32, timeout: i32) -> i32
extern func fcntl(descriptor: i32, command: i32, ...) -> i32

extern struct Poll:
    descriptor: i32
    events: i16
    returned: i16

let poll_in: i16 = 1
let poll_hang_up: i16 = 16
let poll_error: i16 = 8
let set_flags: i32 = 4
## `O_NONBLOCK`: 4 on macOS, 2048 on Linux.
let non_blocking: i32 = 4 if platform.macos else 2048
let would_block: i32 = 35 if platform.macos else 11

pub let failed: ErrorCode = ErrorCode.package(8)

## A captured stream: bytes in the current allocator, grown as the program writes.
struct Capture:
    var descriptor: i32
    var data: u8[]
    var used: usize
    var open: bool

    mutating func pull() -> !:
        if self.data.length - self.used < 256:
            if self.data.length == 0:
                self.data = try alloc u8[1024]
            else:
                self.data = try memory.grow(self.data, self.data.length * 2)
        let n = c_read(self.descriptor, self.data[self.used..].data, self.data.length - self.used)
        if n == 0:
            self.open = false
        elif n > 0:
            self.used += (usize)n
        elif c.errno() != c.interrupted and c.errno() != would_block:
            error(failed, "the program's output cannot be read")

    ## What was captured, in an allocation exactly its length, or empty with none; the
    ## capture's own storage is given back.
    mutating func take() -> str!:
        var empty: u8[]
        if self.used == 0:
            if self.data.length > 0:
                free(self.data)
                self.data = empty
            return (str)empty
        let exact = try alloc u8[self.used]
        memory.copy(exact, self.data, self.used)
        free(self.data)
        self.data = empty
        return (str)exact

    mutating func drop():
        if self.data.length > 0:
            free(self.data)
            var empty: u8[]
            self.data = empty

## Run `program` with `arguments`, wait for it, and answer its exit status and what it
## wrote to its standard output and error. The two texts are allocations of the current
## allocator, each exactly its length, empty ones no allocation at all; `release` gives
## one back. A capture failure terminates and reaps the child, then closes the pipes and
## releases the captures; waiting never depends on output we stopped reading. The child
## does nothing between `fork` and `exec` but move descriptors,
## so a parent with other threads is safe (§15.3).
pub func run(program: c.str, arguments: const c.str[]) -> (i32, str, str)!:
    let argv = try alloc void*?[arguments.length + 2]
    argv[0] = (void*)program
    var i: usize = 0
    while i < arguments.length:
        argv[i + 1] = (void*)arguments[i]
        i += 1
    argv[arguments.length + 1] = none
    var out_pipe: i32[2]
    var err_pipe: i32[2]
    if pipe((i32*)&out_pipe) != 0:
        free(argv)
        error(failed, "run")
    if pipe((i32*)&err_pipe) != 0:
        discard(close(out_pipe[0]))
        discard(close(out_pipe[1]))
        free(argv)
        error(failed, "run")
    let pid = fork()
    if pid < 0:
        discard(close(out_pipe[0]))
        discard(close(out_pipe[1]))
        discard(close(err_pipe[0]))
        discard(close(err_pipe[1]))
        free(argv)
        error(failed, "run")
    if pid == 0:
        discard(close(out_pipe[0]))
        discard(close(err_pipe[0]))
        if dup2(out_pipe[1], 1) < 0 or dup2(err_pipe[1], 2) < 0:
            _exit(127)
        discard(close(out_pipe[1]))
        discard(close(err_pipe[1]))
        discard(execvp(program, argv.data))
        _exit(127)
    free(argv)
    discard(close(out_pipe[1]))
    discard(close(err_pipe[1]))
    var empty: u8[]
    var out = Capture(descriptor = out_pipe[0], data = empty, used = 0, open = true)
    var err = Capture(descriptor = err_pipe[0], data = empty, used = 0, open = true)
    defer discard(close(out_pipe[0]))
    defer discard(close(err_pipe[0]))
    defer out.drop()
    defer err.drop()
    try capture(pid, &out, &err)
    let status = try wait_for(pid)
    if (status & 127) != 0:
        error(failed, "the program was stopped by a signal")
    let out_text = try out.take()
    let err_text = err.take() catch failure:
        release(out_text)
        error(failure.code, failure.message)
    return ((status >> 8) & 255, out_text, err_text)

## Only capture owns the cancellation path. Once it returns, result allocation can fail
## after wait_for has reaped the child; that must never signal a potentially reused pid.
func capture(pid: i32, out: Capture*, err: Capture*) -> !:
    errdefer terminate(pid)
    if fcntl(out.descriptor, set_flags, non_blocking) < 0 or fcntl(err.descriptor, set_flags, non_blocking) < 0:
        error(failed, "the program's output cannot be read")
    while out.open or err.open:
        var watched: Poll[2] = ---
        watched[0] = Poll(descriptor = out.descriptor if out.open else -1, events = poll_in, returned = 0)
        watched[1] = Poll(descriptor = err.descriptor if err.open else -1, events = poll_in, returned = 0)
        if poll((Poll*)&watched, 2, -1) < 0:
            if c.errno() == c.interrupted:
                continue
            error(failed, "the program's output cannot be read")
        if out.open and (watched[0].returned & (poll_in | poll_hang_up | poll_error)) != 0:
            try out.pull()
        if err.open and (watched[1].returned & (poll_in | poll_hang_up | poll_error)) != 0:
            try err.pull()

## The child's wait status, waited for again when a signal interrupts the wait.
func wait_for(pid: i32) -> i32!:
    var status: i32 = 0
    while waitpid(pid, &status, 0) < 0:
        if c.errno() != c.interrupted:
            error(failed, "run")
    return status

## A child may ignore a broken pipe or SIGTERM. SIGKILL stops its writes before waiting.
func terminate(pid: i32):
    discard(kill(pid, 9))
    var status: i32 = 0
    while waitpid(pid, &status, 0) < 0 and c.errno() == c.interrupted:
        continue

## Give back a text `run` answered, to the allocator that was current then.
pub func release(text: str):
    if text.length > 0:
        free(u8[]((u8*)text.bytes.data, text.length))

pub func exit(code: i32) -> never:
    c_exit(code)
"""),
    Prelude(name = "utf8", text = """
## Strict UTF-8 scalar encoding and decoding, following RFC 3629 sections 3–4.
## https://www.rfc-editor.org/rfc/rfc3629.html
## These allocation-free operations accept raw bytes and do not replace invalid
## input, normalize text, strip a BOM, or apply locale rules. Noncharacters and
## unassigned scalar values are valid; surrogate values are not. Storage is borrowed.

## One decoded scalar and the number of source bytes consumed.
pub struct Decoded:
    pub var scalar: char
    pub var width: usize

## Encoded byte count, or none for a surrogate or a value beyond U+10FFFF.
pub func encoded_length(scalar: u32) -> usize?:
    if scalar > 1114111 or (scalar >= 55296 and scalar <= 57343):
        return none
    if scalar < 128:
        return 1
    if scalar < 2048:
        return 2
    return 3 if scalar < 65536 else 4

## Decode at a byte offset. None means an absent, truncated, overlong or otherwise
## invalid sequence. Only this scalar is checked, not the preceding/following bytes.
## Offsets at or beyond the buffer end return none without accessing storage.
pub func decode(data: const u8[], offset: usize = 0) -> Decoded?:
    if offset >= data.length:
        return none
    let lead = data[offset]
    if lead < 128:
        return Decoded(scalar = char(lead), width = 1)
    var width: usize = 0
    var scalar: u32 = 0
    if lead >= 194 and lead <= 223:
        width = 2
        scalar = (u32)(lead & 31)
    elif lead >= 224 and lead <= 239:
        width = 3
        scalar = (u32)(lead & 15)
    elif lead >= 240 and lead <= 244:
        width = 4
        scalar = (u32)(lead & 7)
    else:
        return none
    if width > data.length - offset:
        return none
    var i: usize = 1
    while i < width:
        let byte = data[offset + i]
        if (byte & 192) != 128:
            return none
        scalar = (scalar << 6) | (u32)(byte & 63)
        i += 1
    let shortest = encoded_length(scalar) else return none
    if shortest != width:
        return none
    return Decoded(scalar = char(scalar), width = width)

## Byte offset of the first invalid sequence's start, or none for valid input.
## For a truncated final sequence this is its leading byte, not the missing byte.
pub func invalid_offset(data: const u8[]) -> usize?:
    var offset: usize = 0
    while offset < data.length:
        let decoded = decode(data, offset) else return offset
        offset += decoded.width
    return none

## Whether all bytes form valid UTF-8; empty input is valid.
pub func valid(data: const u8[]) -> bool:
    return invalid_offset(data) == none

## Encode a scalar into the start of the buffer, returning bytes written. None
## means an invalid scalar or insufficient space; the buffer is then unchanged.
## Bytes beyond the returned length are untouched. No NUL terminator is appended.
pub func encode(scalar: u32, buffer: u8[]) -> usize?:
    let width = encoded_length(scalar) else return none
    if width > buffer.length:
        return none
    if width == 1:
        buffer[0] = (u8)scalar
        return 1
    var remaining = scalar
    var i = width
    while i > 1:
        i -= 1
        buffer[i] = 128 | (u8)(remaining & 63)
        remaining >>= 6
    let prefix: u8 = 192 if width == 2 else (224 if width == 3 else 240)
    buffer[0] = prefix | (u8)remaining
    return width
"""),
    Prelude(name = "strings", text = """
## Text operations over `str` views; what allocates says so and uses the current allocator,
## and says how the allocation is given back: `release` for a text made here, `free` for
## the array `split` answers.

import c
import io
import memory

pub func starts_with(text: str, prefix: str) -> bool:
    if prefix.length > text.length:
        return false
    return (str)text.bytes[..<prefix.length] == prefix

pub func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## The byte offset of the first `needle` in `text`.
pub func find(text: str, needle: str) -> usize?:
    if needle.length > text.length:
        return none
    var i: usize = 0
    while i + needle.length <= text.length:
        if (str)text.bytes[i..<i + needle.length] == needle:
            return i
        i += 1
    return none

## The byte offset of the last `byte` in `text`.
pub func last(text: str, byte: u8) -> usize?:
    var i = text.length
    while i > 0:
        i -= 1
        if text.bytes[i] == byte:
            return i
    return none

pub func contains(text: str, needle: str) -> bool:
    return find(text, needle) != none

func is_space(byte: u8) -> bool:
    return byte == ' ' or byte == '\\n' or byte == '\\t' or byte == '\\r'

## `text` without leading and trailing spaces, tabs, and line ends: a view.
pub func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    let b = text.bytes
    while start < end and is_space(b[start]):
        start += 1
    while end > start and is_space(b[end - 1]):
        end -= 1
    return (str)b[start..<end]

## `text` split at every `separator`, as views into it; the array is an allocation of the
## current allocator, given back with `free`.
pub func split(text: str, separator: u8) -> str[]!:
    var count: usize = 1
    for b in text.bytes:
        if b == separator:
            count += 1
    let parts = try alloc str[count]
    var n: usize = 0
    var start: usize = 0
    var i: usize = 0
    let b = text.bytes
    while i < b.length:
        if b[i] == separator:
            parts[n] = (str)b[start..<i]
            n += 1
            start = i + 1
        i += 1
    parts[n] = (str)b[start..]
    return parts

## The pieces joined with `separator` between them, NUL-terminated in the current
## allocator; `release` gives it back.
pub func join(pieces: const str[], separator: str) -> str!:
    var total: usize = 0
    var i: usize = 0
    while i < pieces.length:
        total = total +? pieces[i].length else error(memory.exhausted, "the joined text is too large")
        if i + 1 < pieces.length:
            total = total +? separator.length else error(memory.exhausted, "the joined text is too large")
        i += 1
    let out = try terminated_buffer(total)
    var n: usize = 0
    i = 0
    while i < pieces.length:
        memory.copy(out[n..], pieces[i].bytes, pieces[i].length)
        n += pieces[i].length
        if i + 1 < pieces.length:
            memory.copy(out[n..], separator.bytes, separator.length)
            n += separator.length
        i += 1
    out[n] = 0
    return (str)out[..<n]

## A copy of `text` in the current allocator, NUL-terminated so it may be a `c.str`;
## `release` gives it back.
pub func copy(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    memory.copy(out, text.bytes, text.length)
    out[text.length] = 0
    return (str)out[..<text.length]

## A decimal integer, with an optional sign; none when the text is not one.
pub func to_i64(text: str) -> i64?:
    let b = text.bytes
    if b.length == 0:
        return none
    var i: usize = 0
    var negative = false
    if b[0] == '-' or b[0] == '+':
        negative = b[0] == '-'
        i = 1
    if i >= b.length:
        return none
    # the value accumulates on the side of its sign, so the negative endpoint fits
    var value: i64 = 0
    while i < b.length:
        let byte = b[i]
        if byte < '0' or byte > '9':
            return none
        let digit = (i64)(byte - '0')
        let scaled = value *? 10 else return none
        value = (scaled -? digit if negative else scaled +? digit) else return none
        i += 1
    return value

## ASCII case folding; other bytes pass through. NUL-terminated in the current
## allocator; `release` gives the text back.
pub func to_upper(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b - 32 if b >= 'a' and b <= 'z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

pub func to_lower(text: str) -> str!:
    let out = try terminated_buffer(text.length)
    var i: usize = 0
    for b in text.bytes:
        out[i] = b + 32 if b >= 'A' and b <= 'Z' else b
        i += 1
    out[i] = 0
    return (str)out[..<i]

## Give back a text `join`, `copy`, `to_upper`, or `to_lower` answered: the allocation is
## one byte longer than the text, its NUL.
pub func release(text: str):
    free(u8[]((u8*)text.bytes.data, text.length + 1))

## Allocate text storage including its terminator, reporting size overflow as the
## same fallible outcome as an allocation refusal. Callers initialize every byte.
func terminated_buffer(length: usize) -> u8[]!:
    let size = length +? 1 else error(memory.exhausted, "the text is too large")
    return try alloc u8[size]

## Text built piece by piece. The builder keeps the allocator that was current when it
## was created and grows in it, so it may cross `with` blocks and outlive them; `destroy`
## gives its bytes back to that allocator.
pub struct Builder: io.Writer:
    var data: u8[]
    var used: usize
    var owner: memory.Allocator

    pub static func create(capacity: usize) -> Builder!:
        return Builder(data = try alloc u8[capacity if capacity > 0 else 64], used = 0, owner = memory.allocator)

    ## Ensure room for this many additional bytes and the NUL terminator. Growth
    ## uses the original allocator and preserves the old text if allocation fails.
    ## Growth invalidates borrowed views; a destroyed builder reports io.closed.
    pub mutating func reserve(additional: usize) -> !:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        let total = self.used +? additional else error(memory.exhausted, "the builder size overflows")
        let required = total +? 1 else error(memory.exhausted, "the builder size overflows")
        if required <= self.data.length:
            return
        var capacity = self.data.length *? 2 else required
        if capacity < required:
            capacity = required
        with self.owner:
            self.data = try memory.grow(self.data, capacity)

    ## Append bytes, including a view into this builder's current text. Preserve a
    ## self-view's offset before growth, then rebase it if the allocation moves.
    ## Aliased input must be wholly inside the initialized text, not spare capacity.
    pub mutating func write(data: const u8[]) -> usize!:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        if data.length == 0:
            return 0
        let start = (usize)self.data.data
        let source = (usize)data.data
        var offset: usize? = none
        if source >= start and source - start < self.data.length:
            let relative = source - start
            if relative > self.used or data.length > self.used - relative:
                error(io.invalid_buffer, "the builder input is outside its initialized text")
            offset = relative
        try self.reserve(data.length)
        if let relative = offset:
            memory.move(self.data[self.used..], self.data[relative..], data.length)
        else:
            memory.move(self.data[self.used..], data, data.length)
        self.used += data.length
        return data.length

    pub mutating func put(text: str) -> !:
        discard(try self.write(text.bytes))

    ## The text so far, NUL-terminated in the buffer: a borrowed view, invalid after
    ## write, clear, growing reserve, or destroy. A destroyed builder has an empty view.
    pub mutating func view() -> str:
        if self.used < self.data.length:
            self.data[self.used] = 0
        return (str)self.data[..<self.used]

    pub mutating func clear():
        self.used = 0

    ## Shorten to a byte length without allocation. Reject lengths past the
    ## initialized text, preserving it on failure. This does not validate a UTF-8
    ## boundary. Previously borrowed views expire; a destroyed builder is closed.
    pub mutating func truncate(length: usize) -> !:
        if self.data.length == 0:
            error(io.closed, "the string builder is destroyed")
        if length > self.used:
            error(io.invalid_buffer, "truncation cannot extend the builder")
        self.used = length
        self.data[length] = 0

    ## Give the bytes back; the builder is empty and holds nothing.
    pub mutating func destroy():
        if self.data.length > 0:
            free(self.data) in self.owner
        var empty: u8[]
        self.data = empty
        self.used = 0
"""),
    Prelude(name = "paths", text = """
## File system paths as text, with `/` as the separator.

import strings

pub func is_absolute(path: str) -> bool:
    return path.length > 0 and path.bytes[0] == '/'

## Everything up to the last separator, or `.` when there is none.
pub func directory(path: str) -> str:
    let cut = strings.last(path, '/') else return "."
    if cut == 0:
        return "/"
    return (str)path.bytes[..<cut]

## The last component.
pub func base(path: str) -> str:
    let cut = strings.last(path, '/') else return path
    return (str)path.bytes[cut + 1..]

## The extension with its dot, or the empty text.
pub func extension(path: str) -> str:
    let name = base(path)
    let dot = strings.last(name, '.') else return ""
    if dot == 0:
        return ""
    return (str)name.bytes[dot..]

## The last component without its extension.
pub func stem(path: str) -> str:
    let name = base(path)
    let ext = extension(name)
    return (str)name.bytes[..<name.length - ext.length]

## Join with a separator only when needed; an absolute right path wins. This is
## lexical joining, without normalization or filesystem access. The result is a
## NUL-terminated current-allocator allocation, released with strings.release.
pub func join(left: str, right: str) -> str!:
    if is_absolute(right) or left.length == 0:
        return try strings.copy(right)
    let separator = "" if left.bytes[left.length - 1] == '/' else "/"
    let pieces: str[2] = [left, right]
    return try strings.join(pieces, separator)
"""),
    Prelude(name = "files", text = """
import c
import memory
import platform
import io
import paths
import strings

extern func open(path: c.str, flags: i32, ...) -> i32
extern func openat(directory: i32, path: c.str, flags: i32, ...) -> i32
extern func close(descriptor: i32) -> i32
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func c_write as "write"(descriptor: i32, buffer: const void*, count: usize) -> isize
extern func lseek(descriptor: i32, offset: i64, whence: i32) -> i64
extern func fsync(descriptor: i32) -> i32
extern func ftruncate(descriptor: i32, length: i64) -> i32
extern func fchmod_macos as "fchmod"(descriptor: i32, permissions: u16) -> i32
extern func fchmod_linux as "fchmod"(descriptor: i32, permissions: u32) -> i32
extern func fdopendir(descriptor: i32) -> void*?
extern func dirfd(directory: void*) -> i32
extern func readdir_macos as "readdir"(directory: void*) -> MacEntry*?
extern func readdir_linux as "readdir"(directory: void*) -> LinuxEntry*?
extern func closedir(directory: void*) -> i32
extern func access(path: c.str, mode: i32) -> i32
extern func mkdir_macos as "mkdir"(path: c.str, permissions: u16) -> i32
extern func mkdir_linux as "mkdir"(path: c.str, permissions: u32) -> i32
extern func rmdir(path: c.str) -> i32
extern func unlink(path: c.str) -> i32
extern func c_rename as "rename"(source: c.str, destination: c.str) -> i32
extern func rename_exclusive_macos as "renamex_np"(source: c.str, destination: c.str, flags: u32) -> i32
extern func rename_exclusive_linux as "renameat2"(source_directory: i32, source: c.str, destination_directory: i32, destination: c.str, flags: u32) -> i32
extern func symlink(target: c.str, path: c.str) -> i32
extern func linkat(source_directory: i32, source: c.str, destination_directory: i32, destination: c.str, flags: i32) -> i32
extern func readlink(path: c.str, buffer: void*, capacity: usize) -> isize
extern func getentropy(buffer: void*, length: usize) -> i32

## A directory entry as macOS lays it out (`struct dirent`, 64-bit inodes).
extern struct MacEntry:
    inode: u64
    seek: u64
    length: u16
    name_length: u16
    kind: u8
    name: u8[1024]

## A directory entry as Linux lays it out: the name is NUL-terminated, not counted.
extern struct LinuxEntry:
    inode: u64
    offset: i64
    length: u16
    kind: u8
    name: u8[256]

## The next entry's name, or none at the end; `.` and `..` are entries like any other.
func next_entry(directory: void*) -> str?!:
    while true:
        c.set_errno(0)
        if platform.macos:
            if let entry = readdir_macos(directory):
                return (str)entry.name[..<(usize)entry.name_length]
        else:
            if let entry = readdir_linux(directory):
                var n: usize = 0
                while n < entry.name.length and entry.name[n] != 0:
                    n += 1
                return (str)entry.name[..<n]
        let number = c.errno()
        if number == c.interrupted:
            continue
        if number != 0:
            error(classify_error(number), "the directory could not be read")
        return none

## `open` flags: macOS keeps the BSD values, Linux its own (§19.5).
let write_only: i32 = 1
let create: i32 = 512 if platform.macos else 64
let truncate: i32 = 1024 if platform.macos else 512
let close_on_exec: i32 = 16777216 if platform.macos else 524288
let append_flag: i32 = 8 if platform.macos else 1024
let exclusive_flag: i32 = 2048 if platform.macos else 128
let would_block_errno: i32 = 35 if platform.macos else 11
let transfer_limit: usize = 1073741824
let current_directory_fd: i32 = -2 if platform.macos else -100
let directory_flag: i32 = 1048576 if platform.macos else 65536
let no_follow_flag: i32 = 256 if platform.macos else 131072
let at_no_follow_flag: i32 = 32 if platform.macos else 256

pub let missing: ErrorCode = ErrorCode.package(6)
pub let permission_denied: ErrorCode = ErrorCode.package(18)
pub let already_exists: ErrorCode = ErrorCode.package(19)
pub let no_space: ErrorCode = ErrorCode.package(20)
pub let would_block: ErrorCode = ErrorCode.package(21)
pub let invalid_options: ErrorCode = ErrorCode.package(22)
pub let too_large: ErrorCode = ErrorCode.package(23)
pub let not_directory: ErrorCode = ErrorCode.package(25)
pub let is_directory: ErrorCode = ErrorCode.package(26)
pub let read_only_filesystem: ErrorCode = ErrorCode.package(27)
pub let not_empty: ErrorCode = ErrorCode.package(29)
pub let cross_device: ErrorCode = ErrorCode.package(30)
pub let symlink_loop: ErrorCode = ErrorCode.package(31)
pub let name_too_long: ErrorCode = ErrorCode.package(32)
pub let failed: ErrorCode = ErrorCode.package(7)
## File type from mode bits; unknown preserves support for host-specific kinds.
pub enum FileKind as u8:
    unknown = 0
    regular = 1
    directory = 2
    symlink = 3
    fifo = 4
    socket = 5
    block_device = 6
    character_device = 7

## Unix-epoch seconds plus a nanosecond fraction in 0..999999999. Keeping the
## components separate preserves negative times and avoids nanosecond overflow.
pub struct FileTime:
    pub var seconds: i64
    pub var nanoseconds: u32

## Metadata returned by one OS query, without allocation. Concurrent mutations
## may affect different fields at different instants. Size and block counts keep
## the OS's signed representation; their meaning depends on the file kind.
pub struct Metadata:
    pub var kind: FileKind
    pub var permissions: u32
    pub var size: i64
    pub var device: u64
    pub var inode: u64
    pub var links: u64
    pub var user: u32
    pub var group: u32
    ## Allocated storage in 512-byte blocks, not the logical file size.
    pub var blocks_512: i64
    pub var accessed: FileTime
    pub var modified: FileTime
    ## Last metadata/status change, not creation time.
    pub var changed: FileTime
    ## The macOS birth-time field; none on Linux's stat interface. Filesystems
    ## may report zero when a meaningful birth time is unavailable.
    pub var created: FileTime?

extern struct NativeFileTime:
    seconds: i64
    nanoseconds: i64

## ARM64 Darwin struct stat, including reserved tail space written by libc.
extern struct MacMetadata:
    device: i32
    mode: u16
    links: u16
    inode: u64
    user: u32
    group: u32
    special_device: i32
    accessed: NativeFileTime
    modified: NativeFileTime
    changed: NativeFileTime
    created: NativeFileTime
    size: i64
    blocks: i64
    block_size: i32
    flags: u32
    generation: u32
    reserved_word: i32
    reserved: i64[2]

## x86-64 Linux struct stat. Layout is checked against the host's C headers by
## tests/programs/file_metadata, rather than inferred from matching field names.
extern struct LinuxMetadata:
    device: u64
    inode: u64
    links: u64
    mode: u32
    user: u32
    group: u32
    padding: i32
    special_device: u64
    size: i64
    block_size: i64
    blocks: i64
    accessed: NativeFileTime
    modified: NativeFileTime
    changed: NativeFileTime
    reserved: i64[3]

extern func stat_macos as "stat"(path: c.str, result: MacMetadata*) -> i32
extern func stat_linux as "stat"(path: c.str, result: LinuxMetadata*) -> i32
extern func lstat_macos as "lstat"(path: c.str, result: MacMetadata*) -> i32
extern func lstat_linux as "lstat"(path: c.str, result: LinuxMetadata*) -> i32
extern func fstat_macos as "fstat"(descriptor: i32, result: MacMetadata*) -> i32
extern func fstat_linux as "fstat"(descriptor: i32, result: LinuxMetadata*) -> i32
extern func fstatat_macos as "fstatat"(directory: i32, path: c.str, result: MacMetadata*, flags: i32) -> i32
extern func fstatat_linux as "fstatat"(directory: i32, path: c.str, result: LinuxMetadata*, flags: i32) -> i32
extern func futimens(descriptor: i32, times: const NativeFileTime*) -> i32

func file_kind(mode: u32) -> FileKind:
    let kind = mode & 61440
    if kind == 32768:
        return FileKind.regular
    if kind == 16384:
        return FileKind.directory
    if kind == 40960:
        return FileKind.symlink
    if kind == 4096:
        return FileKind.fifo
    if kind == 49152:
        return FileKind.socket
    if kind == 24576:
        return FileKind.block_device
    if kind == 8192:
        return FileKind.character_device
    return FileKind.unknown

func file_time(value: NativeFileTime) -> FileTime:
    return FileTime(seconds = value.seconds, nanoseconds = (u32)value.nanoseconds)

func mac_metadata(value: MacMetadata) -> Metadata:
    return Metadata(kind = file_kind((u32)value.mode), permissions = (u32)value.mode & 4095,
                    size = value.size, device = (u64)(u32)value.device, inode = value.inode,
                    links = (u64)value.links, user = value.user, group = value.group,
                    blocks_512 = value.blocks, accessed = file_time(value.accessed),
                    modified = file_time(value.modified), changed = file_time(value.changed),
                    created = file_time(value.created))

func linux_metadata(value: LinuxMetadata) -> Metadata:
    return Metadata(kind = file_kind(value.mode), permissions = value.mode & 4095,
                    size = value.size, device = value.device, inode = value.inode,
                    links = value.links, user = value.user, group = value.group,
                    blocks_512 = value.blocks, accessed = file_time(value.accessed),
                    modified = file_time(value.modified), changed = file_time(value.changed), created = none)

## Query a path, following its final symlink by default. With follow_symlinks=false,
## query that entry itself, including dangling links. Intermediate links resolve
## normally. Interrupted calls retry; failure never returns partly filled metadata.
pub func metadata(path: c.str, follow_symlinks: bool = true) -> Metadata!:
    if platform.macos:
        var raw: MacMetadata
        while true:
            let result = stat_macos(path, &raw) if follow_symlinks else lstat_macos(path, &raw)
            if result == 0:
                return mac_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "file metadata could not be read")
    else:
        var raw: LinuxMetadata
        while true:
            let result = stat_linux(path, &raw) if follow_symlinks else lstat_linux(path, &raw)
            if result == 0:
                return linux_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "file metadata could not be read")

func metadata_descriptor(descriptor: i32) -> Metadata!:
    if platform.macos:
        var raw: MacMetadata
        while true:
            if fstat_macos(descriptor, &raw) == 0:
                return mac_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "open-file metadata could not be read")

    else:
        var raw: LinuxMetadata
        while true:
            if fstat_linux(descriptor, &raw) == 0:
                return linux_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "open-file metadata could not be read")

func metadata_at(directory: i32, path: c.str, follow_symlinks: bool) -> Metadata!:
    let flags: i32 = 0 if follow_symlinks else at_no_follow_flag
    if platform.macos:
        var raw: MacMetadata
        while true:
            if fstatat_macos(directory, path, &raw, flags) == 0:
                return mac_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "directory-entry metadata could not be read")
    else:
        var raw: LinuxMetadata
        while true:
            if fstatat_linux(directory, path, &raw, flags) == 0:
                return linux_metadata(raw)
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "directory-entry metadata could not be read")
## File opening policy. `replace` creates or truncates; `create_new` refuses an
## existing path; `create_new_read_write` also permits reads. `append` creates if
## needed and makes each write append atomically.
## Creation permissions are filtered by the process umask, never changed afterward.
pub enum OpenMode as u8:
    read = 0
    read_write = 1
    replace = 2
    create_new = 3
    append = 4
    create_new_read_write = 5

pub enum SeekOrigin as u8:
    start = 0
    current = 1
    end = 2

## One owned descriptor. The zero value is closed. Borrow through a pointer or an
## io interface; copying this value does not duplicate ownership or the OS handle.
## A copied value must not be independently closed. Calls on one handle require
## external synchronization. `close` reports errors; `destroy` is unwind cleanup.
pub struct File: io.Reader, io.Writer:
    var handle: i32?

    ## Open a close-on-exec descriptor. Only the named creation modes create paths.
    pub static func open(path: c.str, mode: OpenMode = OpenMode.read, permissions: u32 = 420) -> File!:
        if permissions > 4095:
            error(invalid_options, "file permissions must fit the Unix mode bits")
        var flags = close_on_exec
        if mode == OpenMode.read_write:
            flags |= 2
        elif mode == OpenMode.replace:
            flags |= write_only | create | truncate
        elif mode == OpenMode.create_new or mode == OpenMode.create_new_read_write:
            flags |= create | exclusive_flag | (2 if mode == OpenMode.create_new_read_write else write_only)
        elif mode == OpenMode.append:
            flags |= write_only | create | append_flag
        elif mode != OpenMode.read:
            error(invalid_options, "unknown file opening mode")
        var fd = open(path, flags, permissions)
        while fd < 0 and c.errno() == c.interrupted:
            fd = open(path, flags, permissions)
        if fd < 0:
            error(classify_error(c.errno()), "the file could not be opened")
        return File(handle = fd)

    ## Borrow the descriptor for OS interoperability; none after close. The caller
    ## must not close it or retain it past this owner's lifetime.
    pub func descriptor() -> i32?:
        return self.handle

    ## Query the open object, even after its pathname has been renamed or removed.
    pub func metadata() -> Metadata!:
        let descriptor = self.handle else error(io.closed, "the file is closed")
        return try metadata_descriptor(descriptor)

    ## Set the logical length without moving the file position. Shrinking
    ## discards the suffix; extension reads as zero bytes. Requires a writable
    ## descriptor. Reject negative lengths before calling the OS.
    pub mutating func truncate(length: i64) -> !:
        let descriptor = self.handle else error(io.closed, "the file is closed")
        if length < 0:
            error(invalid_options, "a file length cannot be negative")
        var result = ftruncate(descriptor, length)
        while result != 0 and c.errno() == c.interrupted:
            result = ftruncate(descriptor, length)
        if result != 0:
            error(classify_error(c.errno()), "the file length could not be changed")

    ## Set permission and special mode bits on this opened object, independent
    ## of pathname changes. Umask is not applied. Host permission rules may
    ## reject or clear requested special bits; inspect metadata for the result.
    pub mutating func set_permissions(permissions: u32) -> !:
        let descriptor = self.handle else error(io.closed, "the file is closed")
        if permissions > 4095:
            error(invalid_options, "file permissions must fit the Unix mode bits")
        while true:
            let result = fchmod_macos(descriptor, (u16)permissions) if platform.macos else fchmod_linux(descriptor, permissions)
            if result == 0:
                return
            if c.errno() != c.interrupted:
                error(classify_error(c.errno()), "file permissions could not be changed")

    ## Set explicit access and modification times; creation/status-change times
    ## are not set by this operation. Validate nanoseconds before the OS call.
    ## The filesystem's range and timestamp resolution still apply.
    pub mutating func set_times(accessed: FileTime, modified: FileTime) -> !:
        let descriptor = self.handle else error(io.closed, "the file is closed")
        if accessed.nanoseconds >= 1000000000 or modified.nanoseconds >= 1000000000:
            error(invalid_options, "a timestamp nanosecond fraction must be below one billion")
        let times: NativeFileTime[2] = [NativeFileTime(seconds = accessed.seconds, nanoseconds = (i64)accessed.nanoseconds),
                                         NativeFileTime(seconds = modified.seconds, nanoseconds = (i64)modified.nanoseconds)]
        var result = futimens(descriptor, &times[0])
        while result != 0 and c.errno() == c.interrupted:
            result = futimens(descriptor, &times[0])
        if result != 0:
            error(classify_error(c.errno()), "file timestamps could not be changed")

    ## Read some bytes, retrying interruption. Zero for nonempty storage is EOF;
    ## empty input makes no system call. The handle must be open even for empty I/O.
    pub mutating func read(buffer: u8[]) -> usize!:
        let fd = self.handle else error(io.closed, "the file is closed")
        if buffer.length == 0:
            return 0
        let count = buffer.length if buffer.length < transfer_limit else transfer_limit
        var received = c_read(fd, buffer.data, count)
        while received < 0 and c.errno() == c.interrupted:
            received = c_read(fd, buffer.data, count)
        if received < 0:
            error(classify_error(c.errno()), "the file could not be read")
        return (usize)received

    ## Write some bytes, retrying interruption. Use io.write_all for a full payload.
    ## Success confirms an OS write, not durable storage; call sync when required.
    pub mutating func write(data: const u8[]) -> usize!:
        let fd = self.handle else error(io.closed, "the file is closed")
        if data.length == 0:
            return 0
        let count = data.length if data.length < transfer_limit else transfer_limit
        var written = c_write(fd, data.data, count)
        while written < 0 and c.errno() == c.interrupted:
            written = c_write(fd, data.data, count)
        if written < 0:
            error(classify_error(c.errno()), "the file could not be written")
        return (usize)written

    ## Seek a seekable file and return its resulting byte offset. Pipes and other
    ## unseekable descriptors report failure instead of pretending their size is zero.
    pub mutating func seek(offset: i64, origin: SeekOrigin = SeekOrigin.start) -> i64!:
        let fd = self.handle else error(io.closed, "the file is closed")
        var position = lseek(fd, offset, (i32)origin)
        while position < 0 and c.errno() == c.interrupted:
            position = lseek(fd, offset, (i32)origin)
        if position < 0:
            error(classify_error(c.errno()), "the file could not be positioned")
        return position

    ## Request the OS's fsync durability boundary for this file; this does not sync
    ## a containing directory or promise persistence beyond the OS/device contract.
    pub mutating func sync() -> !:
        let fd = self.handle else error(io.closed, "the file is closed")
        var result = fsync(fd)
        while result < 0 and c.errno() == c.interrupted:
            result = fsync(fd)
        if result < 0:
            error(classify_error(c.errno()), "the file could not be synchronized")

    ## Consume ownership before closing, so repeated calls on this value are safe
    ## even after failure. Never retry close: a reused descriptor may belong to
    ## another thread. A reported failure must not be retried using descriptor().
    pub mutating func close() -> !:
        let fd = self.handle else return
        self.handle = none
        if close(fd) != 0:
            error(classify_error(c.errno()), "the file could not be closed")

    ## Best-effort cleanup while unwinding another error. Use close explicitly on
    ## the successful path when delayed close errors must be reported to the caller.
    pub mutating func destroy():
        self.close() catch failure:
            discard(failure)

func classify_error(number: i32) -> ErrorCode:
    if number == 2:
        return missing
    if number == 1 or number == 13:
        return permission_denied
    if number == 17:
        return already_exists
    if number == 28:
        return no_space
    if number == 20:
        return not_directory
    if number == 21:
        return is_directory
    if number == 30:
        return read_only_filesystem
    if number == (66 if platform.macos else 39):
        return not_empty
    if number == 18:
        return cross_device
    if number == (62 if platform.macos else 40):
        return symlink_loop
    if number == (63 if platform.macos else 36):
        return name_too_long
    if number == would_block_errno:
        return would_block
    return failed
## Whether the path currently resolves to an existing object, following symlinks.
## This convenience form returns false on lookup errors; use exists_checked when
## permission or I/O failures must be distinguished from absence. It never opens a
## file, so checking a FIFO cannot block waiting for a writer.
pub func exists(path: c.str) -> bool:
    return exists_checked(path) catch failure:
        discard(failure)
        recover false

## Checked existence lookup. Missing components, non-directory parent components
## and dangling symlinks return false. Other failures retain their error category.
pub func exists_checked(path: c.str) -> bool!:
    var result = access(path, 0)
    while result < 0 and c.errno() == c.interrupted:
        result = access(path, 0)
    if result == 0:
        return true
    let number = c.errno()
    if number == 2 or number == 20:
        return false
    error(classify_error(number), "the path could not be inspected")

## Create one directory; parents must already exist. An existing final entry is
## already_exists, including a symlink. Permissions are filtered by the process
## umask. No recursive creation, permission repair, or implicit retry occurs.
pub func create_directory(path: c.str, permissions: u32 = 493) -> !:
    if permissions > 4095:
        error(invalid_options, "directory permissions must fit the Unix mode bits")
    let result = mkdir_macos(path, (u16)permissions) if platform.macos else mkdir_linux(path, permissions)
    if result != 0:
        error(classify_error(c.errno()), "the directory could not be created")

## Remove one non-directory entry. A final symlink is removed without touching
## its target. Open handles and other hard links keep the object alive. Parents
## are resolved normally; a missing entry is an error, not successful removal.
pub func remove_file(path: c.str) -> !:
    if unlink(path) != 0:
        error(classify_error(c.errno()), "the file entry could not be removed")

## Remove an empty directory; do not recurse or follow a final symlink. A
## nonempty directory reports not_empty (or already_exists if the OS uses EEXIST).
pub func remove_directory(path: c.str) -> !:
    if rmdir(path) != 0:
        error(classify_error(c.errno()), "the directory could not be removed")

## Rename an entry, atomically replacing an existing compatible destination on
## the same filesystem. Final symlinks are entries, not followed targets. Open
## handles keep referring to their objects. This does not copy across devices
## or request durable storage. With replace=false, atomically refuse an existing
## destination; unsupported exclusive renames fail without an unsafe fallback.
## On a remote
## filesystem a reported failure may follow a completed server-side mutation.
pub func rename(source: c.str, destination: c.str, replace: bool = true) -> !:
    var result: i32 = 0
    if replace:
        result = c_rename(source, destination)
    elif platform.macos:
        result = rename_exclusive_macos(source, destination, 4)
    else:
        result = rename_exclusive_linux(current_directory_fd, source, current_directory_fd, destination, 1)
    if result != 0:
        error(classify_error(c.errno()), "the entry could not be renamed")

## Create a symlink containing target's bytes; the target need not exist. A
## relative target is resolved from the link's parent when later followed.
## Creation refuses an existing link_path, including a dangling symlink.
pub func create_symlink(target: c.str, link_path: c.str) -> !:
    if symlink(target, link_path) != 0:
        error(classify_error(c.errno()), "the symbolic link could not be created")

## Create another name for the source entry on the same filesystem, refusing an
## existing destination. A final source symlink is linked itself, not followed.
## Directories cannot be linked. Intermediate path components resolve normally.
pub func create_hard_link(source: c.str, destination: c.str) -> !:
    if linkat(current_directory_fd, source, current_directory_fd, destination, 0) != 0:
        error(classify_error(c.errno()), "the hard link could not be created")

## Read a final symlink's raw target bytes without following it. Return a
## NUL-terminated current-allocator allocation released with strings.release.
## At most limit bytes are accepted; excess reports too_large, never truncates.
## One extra byte detects excess without trusting metadata. Interrupted reads
## retry; concurrent replacement may therefore change the observed link target.
pub func read_symlink(path: c.str, limit: usize = 4096) -> str!:
    let capacity = limit +? 1 else error(memory.exhausted, "the link target limit overflows")
    let buffer = try alloc u8[capacity]
    defer free(buffer)
    var count = readlink(path, buffer.data, buffer.length)
    while count < 0 and c.errno() == c.interrupted:
        count = readlink(path, buffer.data, buffer.length)
    if count < 0:
        error(classify_error(c.errno()), "the symbolic link could not be read")
    if (usize)count > limit:
        error(too_large, "the link target exceeds the requested limit")
    let length = (usize)count
    let exact = try alloc u8[length + 1]
    memory.copy(exact, buffer, length)
    exact[length] = 0
    return (str)exact[..<length]
## A temporary file and its owned pathname. The zero value is closed. Copying does
## not duplicate ownership. Borrow the object for I/O and serialize its use.
## The pathname allocator is retained, so cleanup may occur outside its with block.
pub struct TemporaryFile: io.Reader, io.Writer:
    var file: File
    var name: str
    var owner: memory.Allocator?

    ## Create an exclusive close-on-exec file in directory, with permissions
    ## filtered by umask. The OS supplies 128 random filename bits per attempt;
    ## collisions retry up to 128 times. Entropy acquisition may block. No
    ## existing entry is opened or overwritten, and failure retains no allocation.
    pub static func create(directory: c.str, permissions: u32 = 384) -> TemporaryFile!:
        let candidate = try paths.join((str)directory, ".luce-00000000000000000000000000000000")
        errdefer strings.release(candidate)
        let digits = "0123456789abcdef"
        let data = (u8*)candidate.bytes.data
        let suffix = candidate.length - 32
        var attempt: usize = 0
        while attempt < 128:
            var random: u8[16]
            if getentropy(&random[0], random.length) != 0:
                error(failed, "temporary filename randomness is unavailable")
            for i in 0..<random.length:
                data[suffix + i * 2] = digits.bytes[random[i] >> 4]
                data[suffix + i * 2 + 1] = digits.bytes[random[i] & 15]
            let file = File.open((c.str)candidate, OpenMode.create_new_read_write, permissions) catch failure:
                if failure.code == already_exists:
                    attempt += 1
                    continue
                error(failure.code, failure.message)
            return TemporaryFile(file = file, name = candidate, owner = memory.allocator)
        error(already_exists, "no unused temporary filename was found")

    ## Borrowed NUL-terminated pathname, valid until publication or cleanup.
    pub func path() -> str:
        return self.name

    pub mutating func read(buffer: u8[]) -> usize!:
        return try self.file.read(buffer)

    pub mutating func write(data: const u8[]) -> usize!:
        return try self.file.write(data)

    pub mutating func seek(offset: i64, origin: SeekOrigin = SeekOrigin.start) -> i64!:
        return try self.file.seek(offset, origin)

    pub mutating func sync() -> !:
        try self.file.sync()

    ## Close successfully, then rename over destination. A close failure does
    ## not publish. A rename failure leaves the temporary pathname owned here
    ## for retry or discard. With replace=false, an existing destination is
    ## atomically refused. Success consumes ownership and invalidates path().
    ## This does not synchronize data or the parent directory; call sync first
    ## and synchronize the destination directory when that guarantee is needed.
    pub mutating func publish(destination: c.str, replace: bool = true) -> !:
        if self.name.length == 0:
            error(io.closed, "the temporary file has no owned pathname")
        try self.file.close()
        try rename((c.str)self.name, destination, replace)
        self.release_name()

    mutating func release_name():
        if self.name.length > 0:
            let owner = self.owner else trap("a temporary pathname lost its allocator")
            with owner:
                strings.release(self.name)
            self.name = ""
            self.owner = none

    mutating func remove_name() -> !:
        if self.name.length == 0:
            return
        remove_file((c.str)self.name) catch failure:
            if failure.code != missing:
                error(failure.code, failure.message)
        self.release_name()

    ## Close and remove the temporary entry. Report the first failure; still
    ## attempt removal after a close failure. A failed removal retains path()
    ## for retry. Repeated successful discard calls are safe.
    pub mutating func discard() -> !:
        self.file.close() catch failure:
            self.remove_name() catch cleanup:
                discard(cleanup)
            error(failure.code, failure.message)
        try self.remove_name()

    ## Best-effort cleanup, releasing pathname memory even if the OS refuses
    ## removal. Such a refusal can leave a file behind; use discard to observe it.
    pub mutating func destroy():
        self.discard() catch failure:
            discard(failure)
        self.release_name()

## Write through a temporary sibling, then atomically rename it over path. The
## replacement receives permissions filtered by umask; existing ownership, mode
## and extended metadata are not preserved. A final symlink is replaced itself.
## Parent directories must remain stable throughout the operation.
## With synchronize, fsync the file before publication and its parent afterward;
## this also requires read access to the parent directory. Optional published is
## reset on entry and set immediately after successful rename, before directory
## sync/close. A later failure can therefore report published=true. It must not
## overlap input or allocator state. Temporary cleanup on failure is best effort.
pub func write_atomic(path: c.str, data: const u8[], permissions: u32 = 420, synchronize: bool = false, published: bool*? = none) -> !:
    if let flag = published:
        *flag = false
    var replacement = try Replacement.prepare(path, permissions, synchronize)
    defer replacement.destroy()
    try io.write_all(&replacement.temporary, data)
    try replacement.finish(path, true, published)

## Shared ownership and publication ordering for atomic writes and file copies.
struct Replacement:
    var parent: File
    var temporary: TemporaryFile
    var synchronize: bool

    static func prepare(path: c.str, permissions: u32, synchronize: bool) -> Replacement!:
        let parent_name = try strings.copy(paths.directory((str)path))
        defer strings.release(parent_name)
        var parent: File
        errdefer parent.destroy()
        if synchronize:
            parent = try File.open((c.str)parent_name)
        let temporary = try TemporaryFile.create((c.str)parent_name, permissions)
        return Replacement(parent = parent, temporary = temporary, synchronize = synchronize)

    mutating func finish(path: c.str, replace: bool, published: bool*?) -> !:
        if self.synchronize:
            try self.temporary.sync()
        try self.temporary.publish(path, replace)
        if let flag = published:
            *flag = true
        if self.synchronize:
            try self.parent.sync()
            try self.parent.close()

    mutating func destroy():
        self.temporary.destroy()
        self.parent.destroy()
## Copy through a temporary sibling and atomically publish the complete result.
## The source is followed and read through EOF; directories are rejected. Refuse
## an existing destination unless replace=true, and reject an observed source/
## destination identity match. Final destination symlinks are entries to replace.
## Use a finite limit for streams: one extra byte detects excess, which fails
## without publishing. Memory for payload transfer is bounded to 4096 bytes.
## Concurrent source writes can change the bytes observed; this is not a snapshot.
## Return bytes copied. Permissions, synchronize, parent-path stability and
## published have the same contracts as write_atomic; metadata is not copied.
pub func copy_file(source_path: c.str, destination: c.str, limit: usize = 18446744073709551615, replace: bool = false, permissions: u32 = 420, synchronize: bool = false, published: bool*? = none) -> usize!:
    if let flag = published:
        *flag = false
    var source = try File.open(source_path)
    defer source.destroy()
    let source_info = try source.metadata()
    if source_info.kind == FileKind.directory:
        error(is_directory, "a directory cannot be copied as file bytes")
    if let destination_info = try metadata_if_present(destination):
        if not replace:
            error(already_exists, "the copy destination already exists")
        if source_info.device == destination_info.device and source_info.inode == destination_info.inode:
            error(invalid_options, "source and destination identify the same file")
        if destination_info.kind == FileKind.directory:
            error(is_directory, "the copy destination is a directory")
    var replacement = try Replacement.prepare(destination, permissions, synchronize)
    defer replacement.destroy()
    var buffer: u8[4096]
    let count = try io.copy_limit(&source, &replacement.temporary, buffer, limit)
    if count == limit:
        if try source.read(buffer[..<1]) != 0:
            error(too_large, "the copy source exceeds the requested limit")
    try source.close()
    try replacement.finish(destination, replace, published)
    return count

func metadata_if_present(path: c.str) -> Metadata?!:
    let value = metadata(path, false) catch failure:
        if failure.code == missing:
            return none
        error(failure.code, failure.message)
    return value

## Read through EOF, including files whose size changes or cannot be sought. The
## result is an allocation of the current allocator; free the returned span there.
## Use read_limit for untrusted or potentially unbounded input.
pub func read(path: c.str) -> u8[]!:
    return try read_limit(path, 18446744073709551615)

## Read a whole file up to `limit` bytes. One extra byte may be read to distinguish
## an exact fit from excess input; excess fails with too_large, never truncates.
## All allocations and the descriptor are released on failure. An empty result is
## still an owned zero-length allocation, following read's existing free contract.
pub func read_limit(path: c.str, limit: usize) -> u8[]!:
    var file = try File.open(path)
    defer file.destroy()
    var bytes: u8[]
    errdefer release_buffer(bytes)
    var used: usize = 0
    var scratch: u8[4096]
    while true:
        let remaining = limit - used
        let requested = 1 if remaining == 0 else (remaining if remaining < scratch.length else scratch.length)
        let count = try file.read(scratch[..<requested])
        if count == 0:
            break
        if remaining == 0:
            error(too_large, "the file exceeds the read limit")
        let needed = used + count
        if needed > bytes.length:
            var capacity = bytes.length *? 2 else limit
            if capacity < 4096:
                capacity = 4096
            if capacity < needed:
                capacity = needed
            if capacity > limit:
                capacity = limit
            if bytes.length == 0:
                bytes = try alloc u8[capacity]
            else:
                bytes = try memory.grow(bytes, capacity)
        memory.copy(bytes[used..], scratch, count)
        used += count
    try file.close()
    if used == bytes.length and used > 0:
        return bytes
    let exact = try alloc u8[used]
    memory.copy(exact, bytes, used)
    release_buffer(bytes)
    return exact

## Create or truncate and write all bytes, reporting write and close failures.
## This is neither atomic replacement nor durable sync; use those operations
## explicitly when their guarantees are required.
pub func write(path: c.str, data: const u8[]) -> !:
    var file = try File.open(path, OpenMode.replace)
    defer file.destroy()
    try io.write_all(&file, data)
    try file.close()

func release_buffer(bytes: u8[]):
    if bytes.length > 0:
        free(bytes)

## One owned directory stream; the zero value is closed. Copying does not duplicate
## ownership. Borrow it for iteration and serialize access to the stream.
pub struct Directory:
    var handle: void*?

    ## Open a close-on-exec directory stream. With follow_symlinks=false, refuse
    ## a final symlink; intermediate path components still resolve normally.
    pub static func open(path: c.str, follow_symlinks: bool = true) -> Directory!:
        return try open_directory_at(current_directory_fd, path, follow_symlinks)

    ## Borrow the descriptor until close. Do not close it or change its position.
    pub func descriptor() -> i32!:
        let directory = self.handle else error(io.closed, "the directory is closed")
        let descriptor = dirfd(directory)
        if descriptor < 0:
            error(classify_error(c.errno()), "the directory has no usable descriptor")
        return descriptor

    ## Metadata for the opened directory, independent of its current pathname.
    pub func metadata() -> Metadata!:
        return try metadata_descriptor(try self.descriptor())

    ## Resolve a relative path from this open directory, even after it is renamed.
    ## Absolute paths use normal OS resolution. With follow_symlinks=false, inspect
    ## the final link itself. Separators and parent components retain OS semantics.
    pub func entry_metadata(path: c.str, follow_symlinks: bool = true) -> Metadata!:
        return try metadata_at(try self.descriptor(), path, follow_symlinks)

    ## Open a directory relative to this handle. The new stream owns a separate
    ## descriptor and position; closing either stream does not close the other.
    ## With follow_symlinks=false, refuse a final symlink atomically during open.
    pub func open_directory(path: c.str, follow_symlinks: bool = true) -> Directory!:
        return try open_directory_at(try self.descriptor(), path, follow_symlinks)

    ## The next name excluding dot and dot-dot, or none at end. Names are raw path
    ## bytes, NUL-terminated but not guaranteed UTF-8. The view expires on the next
    ## call or close.
    pub mutating func next() -> str?!:
        let directory = self.handle else error(io.closed, "the directory is closed")
        while true:
            let name = try next_entry(directory) else return none
            if name != "." and name != "..":
                return name

    ## Consume ownership even on failure; repeated calls on this value are safe.
    pub mutating func close() -> !:
        let directory = self.handle else return
        self.handle = none
        if closedir(directory) != 0:
            error(classify_error(c.errno()), "the directory could not be closed")

    ## Best-effort unwind cleanup; use close to observe an error on the success path.
    pub mutating func destroy():
        self.close() catch failure:
            discard(failure)

## Acquire a descriptor first so CLOEXEC and final-symlink policy are atomic.
## fdopendir takes ownership only on success; capture errno before closing on failure.
func open_directory_at(parent: i32, path: c.str, follow_symlinks: bool) -> Directory!:
    var flags = directory_flag | close_on_exec
    if not follow_symlinks:
        flags |= no_follow_flag
    var descriptor = openat(parent, path, flags)
    while descriptor < 0 and c.errno() == c.interrupted:
        descriptor = openat(parent, path, flags)
    if descriptor < 0:
        error(classify_error(c.errno()), "the directory could not be opened")
    if let stream = fdopendir(descriptor):
        return Directory(handle = stream)
    let number = c.errno()
    discard(close(descriptor))
    error(classify_error(number), "the directory stream could not be created")

## The names in a directory, sorted by bytes, without `.` and `..`: each name and the
## array holding them, exactly as long as the names, are allocations of the current
## allocator, which `release_list` returns together. On a failure nothing allocated is
## kept and the directory is closed.
pub func list(path: c.str) -> str[]!:
    var directory = try Directory.open(path)
    defer directory.destroy()
    var names = try alloc str[16]
    var count: usize = 0
    errdefer release_entries(names, count)
    while let name = try directory.next():
        if count == names.length:
            let capacity = names.length *? 2 else error(memory.exhausted, "the directory listing is too large")
            let grown = try alloc str[capacity]
            memory.copy(grown, names, count)
            free(names)
            names = grown
        let copy = try alloc u8[name.length + 1]
        memory.copy(copy, name.bytes, name.length)
        copy[name.length] = 0
        names[count] = (str)copy[..<name.length]
        count += 1
    try directory.close()
    sort_names(names[..<count])
    # the array as long as the names, so that `release_list` returns what was allocated
    if count == 0:
        free(names)
        var empty: str[]
        return empty
    let exact = try alloc str[count]
    memory.copy(exact, names, count)
    free(names)
    return exact

## In-place heapsort gives large directories O(n log n) comparisons without a
## second allocation or a recursion depth dependent on filesystem enumeration order.
func sort_names(names: str[]):
    var root = names.length // 2
    while root > 0:
        root -= 1
        sift_names(names, root, names.length)
    var end = names.length
    while end > 1:
        end -= 1
        let largest = names[0]
        names[0] = names[end]
        names[end] = largest
        sift_names(names, 0, end)

func sift_names(names: str[], start: usize, end: usize):
    var parent = start
    while parent < end // 2:
        var child = parent * 2 + 1
        if child + 1 < end and names[child] < names[child + 1]:
            child += 1
        if not (names[parent] < names[child]):
            return
        let saved = names[parent]
        names[parent] = names[child]
        names[child] = saved
        parent = child

## Return what `list` allocated: every name, then the array, to the allocator that is
## current, which must be the one `list` allocated from. The names are one byte longer
## than they read, the NUL after each (§5.5).
pub func release_list(names: str[]):
    release_entries(names, names.length)

## Partial lists still own the whole array allocation, including its unfilled capacity.
func release_entries(names: str[], count: usize):
    for name in names[..<count]:
        free(u8[]((u8*)name.bytes.data, name.length + 1))
    if names.length > 0:
        free(names)
pub let directory_cycle: ErrorCode = ErrorCode.package(33)
pub let depth_limit: ErrorCode = ErrorCode.package(34)

## A borrowed traversal callback. For directories, true requests descent and
## false prunes that subtree; the return value is ignored for other entry kinds.
## Path is a NUL-terminated borrowed label, valid only during this callback. Copy
## it to retain it. Error-message storage must outlive the walk, as for other
## borrowed Base errors. Callbacks run serially in depth-first enumeration order.
pub interface WalkVisitor:
    mutating func visit(path: str, info: Metadata, depth: usize) -> bool!

## Visit root at depth zero, then its descendants, without following directory
## symlinks below root. Root uses ordinary OS path resolution. Labels are built
## from the supplied root; directory renames do not redirect handle-based traversal
## and may leave those labels unusable as OS paths. This is not a filesystem snapshot.
## A child deeper than max_depth reports depth_limit instead of silently skipping
## entries. Repeated ancestor identities report directory_cycle. OS/callback errors
## stop traversal; earlier callback effects remain. All owned resources are cleaned
## up on failure. Storage is proportional to depth plus the longest path label;
## cycle detection compares each descended directory with its open ancestors.
pub func walk(root: c.str, visitor: WalkVisitor, max_depth: usize = 64) -> !:
    let owner = memory.allocator
    let root_info = try metadata(root)
    let descend = try visitor.visit((str)root, root_info, 0)
    if root_info.kind != FileKind.directory or not descend:
        return
    var state = try WalkState.start(root, root_info, owner)
    defer state.destroy()
    while state.count > 0:
        let index = state.count - 1
        let next_name = try state.frames[index].directory.next()
        if next_name == none:
            try state.pop()
            continue
        let name = next_name else continue
        let depth = state.count
        if depth > max_depth:
            error(depth_limit, "directory traversal exceeded its depth limit")
        let info = try state.frames[index].directory.entry_metadata((c.str)name, false)
        let parent_length = state.path.view().length
        if parent_length > 0 and state.path.view().bytes[parent_length - 1] != '/':
            try state.path.put("/")
        try state.path.put(name)
        let visit_children = try visitor.visit(state.path.view(), info, depth)
        if info.kind != FileKind.directory or not visit_children:
            try state.path.truncate(parent_length)
            continue
        if state.contains(info.device, info.inode):
            error(directory_cycle, "directory traversal encountered an ancestor again")
        var child = try state.frames[index].directory.open_directory((c.str)name, false)
        errdefer child.destroy()
        let opened = try child.metadata()
        if opened.device != info.device or opened.inode != info.inode:
            error(failed, "a directory changed before traversal could enter it")
        try state.push(child, opened)

struct WalkFrame:
    var directory: Directory
    var device: u64
    var inode: u64
    var path_length: usize

## Frames own open directories; one builder owns the current path. No borrowed
## frame pointer survives growth, and the allocator is independent of callback
## changes to memory.allocator.
struct WalkState:
    var frames: WalkFrame[]
    var count: usize
    var path: strings.Builder
    var owner: memory.Allocator

    static func start(root: c.str, expected: Metadata, owner: memory.Allocator) -> WalkState!:
        var directory = try Directory.open(root)
        errdefer directory.destroy()
        let info = try directory.metadata()
        if info.device != expected.device or info.inode != expected.inode:
            error(failed, "the traversal root changed before it could be opened")
        with owner:
            var path = try strings.Builder.create(64)
            errdefer path.destroy()
            try path.put((str)root)
            let frames = try alloc WalkFrame[8]
            frames[0] = WalkFrame(directory = directory, device = info.device, inode = info.inode,
                                  path_length = path.view().length)
            return WalkState(frames = frames, count = 1, path = path, owner = owner)

    func contains(device: u64, inode: u64) -> bool:
        for frame in self.frames[..<self.count]:
            if frame.device == device and frame.inode == inode:
                return true
        return false

    ## Ownership transfers only after growth succeeds. The caller closes child
    ## on failure; after success this frame is its sole owner.
    mutating func push(child: Directory, info: Metadata) -> !:
        if self.count == self.frames.length:
            let capacity = self.frames.length *? 2 else error(memory.exhausted, "the traversal stack is too large")
            with self.owner:
                let grown = try alloc WalkFrame[capacity]
                memory.copy(grown, self.frames, self.count)
                free(self.frames)
                self.frames = grown
        self.frames[self.count] = WalkFrame(directory = child, device = info.device, inode = info.inode,
                                           path_length = self.path.view().length)
        self.count += 1

    mutating func pop() -> !:
        let index = self.count - 1
        self.frames[index].directory.close() catch failure:
            self.count -= 1
            error(failure.code, failure.message)
        self.count -= 1
        if self.count > 0:
            try self.path.truncate(self.frames[self.count - 1].path_length)

    mutating func destroy():
        while self.count > 0:
            self.count -= 1
            self.frames[self.count].directory.destroy()
        self.path.destroy()
        if self.frames.length > 0:
            free(self.frames) in self.owner
            var empty: WalkFrame[]
            self.frames = empty
"""),
    Prelude(name = "math", text = """
## The mathematical functions of the standard library (§16.6): `import math` for
## `math.sqrt(x)`, `from math import sqrt` for `sqrt(x)`. The float functions are the C
## library's, declared here with the types Base gives them; the integer functions are Base.
extern func c_floor as "floor"(x: f64) -> f64
extern func c_ceil as "ceil"(x: f64) -> f64
extern func c_round as "round"(x: f64) -> f64
extern func c_trunc as "trunc"(x: f64) -> f64
extern func c_sqrt as "sqrt"(x: f64) -> f64
extern func c_cbrt as "cbrt"(x: f64) -> f64
extern func c_hypot as "hypot"(x: f64, y: f64) -> f64
extern func c_fmod as "fmod"(x: f64, y: f64) -> f64
extern func c_pow as "pow"(x: f64, y: f64) -> f64
extern func c_exp as "exp"(x: f64) -> f64
extern func c_exp2 as "exp2"(x: f64) -> f64
extern func c_log as "log"(x: f64) -> f64
extern func c_log2 as "log2"(x: f64) -> f64
extern func c_log10 as "log10"(x: f64) -> f64
extern func c_sin as "sin"(x: f64) -> f64
extern func c_cos as "cos"(x: f64) -> f64
extern func c_tan as "tan"(x: f64) -> f64
extern func c_asin as "asin"(x: f64) -> f64
extern func c_acos as "acos"(x: f64) -> f64
extern func c_atan as "atan"(x: f64) -> f64
extern func c_atan2 as "atan2"(y: f64, x: f64) -> f64
extern func c_sinh as "sinh"(x: f64) -> f64
extern func c_cosh as "cosh"(x: f64) -> f64
extern func c_tanh as "tanh"(x: f64) -> f64
extern func c_log1p as "log1p"(x: f64) -> f64
extern func c_expm1 as "expm1"(x: f64) -> f64
extern func c_fma as "fma"(x: f64, y: f64, z: f64) -> f64
extern func c_nextafter as "nextafter"(x: f64, toward: f64) -> f64
extern func c_frexp as "frexp"(x: f64, out exponent: i32) -> f64
extern func c_scalbn as "scalbn"(x: f64, exponent: i32) -> f64
extern func c_modf as "modf"(x: f64, out integral: f64) -> f64
extern func c_remainder as "remainder"(x: f64, y: f64) -> f64

pub let pi: f64 = 3.141592653589793
pub let tau: f64 = 6.283185307179586
pub let e: f64 = 2.718281828459045
## Built from bits so that no constant expression needs to overflow.
pub let infinity: f64 = f64.bits(9218868437227405312)
pub let nan: f64 = f64.bits(9221120237041090560)

let sign_mask: u64 = 0x8000000000000000
let magnitude_mask: u64 = 0x7fffffffffffffff
let exponent_mask: u64 = 0x7ff0000000000000

## Rounding: `floor` toward negative infinity, `ceil` toward positive, `round` to the
## nearest with halves away from zero, `trunc` toward zero.
pub func floor(x: f64) -> f64:
    return c_floor(x)
pub func ceil(x: f64) -> f64:
    return c_ceil(x)
pub func round(x: f64) -> f64:
    return c_round(x)
pub func trunc(x: f64) -> f64:
    return c_trunc(x)

pub func sqrt(x: f64) -> f64:
    return c_sqrt(x)
pub func cbrt(x: f64) -> f64:
    return c_cbrt(x)
## `sqrt(x * x + y * y)` without overflow in the squares.
pub func hypot(x: f64, y: f64) -> f64:
    return c_hypot(x, y)
## The remainder of `x / y` with the sign of `x`, as C's `fmod`.
pub func mod(x: f64, y: f64) -> f64:
    return c_fmod(x, y)
pub func pow(x: f64, y: f64) -> f64:
    return c_pow(x, y)
pub func exp(x: f64) -> f64:
    return c_exp(x)
pub func exp2(x: f64) -> f64:
    return c_exp2(x)
pub func log(x: f64) -> f64:
    return c_log(x)
pub func log2(x: f64) -> f64:
    return c_log2(x)
pub func log10(x: f64) -> f64:
    return c_log10(x)

## Natural logarithm of `1 + x`, retaining accuracy when adding `x` to one would
## round it away. At -1 the result is negative infinity; below -1 it is NaN.
pub func log1p(x: f64) -> f64:
    return c_log1p(x)

## `exp(x) - 1` without cancellation near zero. Signed zero is preserved.
pub func expm1(x: f64) -> f64:
    return c_expm1(x)

## Multiply `x * y` and add `z` with one final rounding, rather than rounding the
## product first. Uses the host's floating-point rounding mode.
pub func fma(x: f64, y: f64, z: f64) -> f64:
    return c_fma(x, y, z)

## The adjacent representable value toward `toward`; equal arguments return
## `toward`, including its zero sign. A NaN argument produces NaN.
pub func nextafter(x: f64, toward: f64) -> f64:
    return c_nextafter(x, toward)

## The adjacent representable value toward positive infinity. Positive infinity
## stays infinite; either zero becomes the smallest positive subnormal.
pub func next_up(x: f64) -> f64:
    return c_nextafter(x, infinity)

## The adjacent representable value toward negative infinity. Negative infinity
## stays infinite; either zero becomes the smallest negative subnormal.
pub func next_down(x: f64) -> f64:
    return c_nextafter(x, copysign(infinity, -1.0))

## Split `x` into `(fraction, exponent)` such that `x = fraction * 2**exponent`.
## A finite nonzero fraction has magnitude in [0.5, 1). Zero, infinity and NaN
## are returned unchanged with exponent zero, avoiding an unspecified C exponent.
pub func frexp(x: f64) -> (f64, i32):
    if x == 0.0 or not is_finite(x):
        return (x, 0)
    return c_frexp(x)

## Scale by an integer power of two, without forming that power as an intermediate
## float. Overflow/underflow follow the host rounding mode; signed zero survives.
pub func scalbn(x: f64, exponent: i32) -> f64:
    return c_scalbn(x, exponent)

## `(fractional, integral)` parts, both with the sign of `x`; the integral part
## truncates toward zero. Infinity has a signed-zero fraction; NaN gives two NaNs.
pub func modf(x: f64) -> (f64, f64):
    return c_modf(x)

## `x - n*y` for the nearest integer `n` to `x/y`, with ties choosing even `n`.
## This differs from `mod`, which truncates the quotient. Zero has the sign of `x`;
## a zero divisor or infinite dividend produces NaN.
pub func remainder(x: f64, y: f64) -> f64:
    return c_remainder(x, y)

pub func sin(x: f64) -> f64:
    return c_sin(x)
pub func cos(x: f64) -> f64:
    return c_cos(x)
pub func tan(x: f64) -> f64:
    return c_tan(x)
pub func asin(x: f64) -> f64:
    return c_asin(x)
pub func acos(x: f64) -> f64:
    return c_acos(x)
pub func atan(x: f64) -> f64:
    return c_atan(x)
## The angle of the point `(x, y)`, in all four quadrants.
pub func atan2(y: f64, x: f64) -> f64:
    return c_atan2(y, x)
pub func sinh(x: f64) -> f64:
    return c_sinh(x)
pub func cosh(x: f64) -> f64:
    return c_cosh(x)
pub func tanh(x: f64) -> f64:
    return c_tanh(x)

## True for quiet and signaling NaNs, independent of sign and payload.
pub func is_nan(x: f64) -> bool:
    return (x.bits() & magnitude_mask) > exponent_mask
## True for zeros, subnormals and normal finite values. Classification inspects the
## representation and performs no floating-point arithmetic on a signaling NaN.
pub func is_finite(x: f64) -> bool:
    return (x.bits() & exponent_mask) != exponent_mask
## True only for positive or negative infinity.
pub func is_infinite(x: f64) -> bool:
    return (x.bits() & magnitude_mask) == exponent_mask
## Whether the sign bit is set, including negative zero and signed NaNs.
pub func signbit(x: f64) -> bool:
    return (x.bits() & sign_mask) != 0
## Clear the sign bit: negative zero becomes positive zero. NaN payload bits survive.
pub func abs(x: f64) -> f64:
    return f64.bits(x.bits() & magnitude_mask)
## The magnitude and payload of `magnitude` with the sign bit of `sign_source`.
pub func copysign(magnitude: f64, sign_source: f64) -> f64:
    return f64.bits((magnitude.bits() & magnitude_mask) | (sign_source.bits() & sign_mask))
## `-1.0` or `1.0` for nonzero numbers; zero and NaN are returned unchanged.
pub func sign(x: f64) -> f64:
    if is_nan(x):
        return x
    if x < 0.0:
        return -1.0
    if x > 0.0:
        return 1.0
    return x
## Minimum with NaN propagation (left NaN wins if both are NaNs). Negative zero
## wins over positive zero; a selected NaN retains its original bits.
pub func min(a: f64, b: f64) -> f64:
    if is_nan(a):
        return a
    if is_nan(b):
        return b
    if a == 0.0 and b == 0.0:
        return f64.bits(a.bits() | b.bits())
    return a if a < b else b
## Maximum with NaN propagation (left NaN wins if both are NaNs). Positive zero
## wins over negative zero; a selected NaN retains its original bits.
pub func max(a: f64, b: f64) -> f64:
    if is_nan(a):
        return a
    if is_nan(b):
        return b
    if a == 0.0 and b == 0.0:
        return f64.bits(a.bits() & b.bits())
    return a if a > b else b
## Restrict `x` to inclusive ordered bounds. Reversed or NaN bounds trap. An input
## NaN or an input equal to a bound is returned unchanged, including its zero sign.
pub func clamp(x: f64, low: f64, high: f64) -> f64:
    assert(low <= high)
    if is_nan(x):
        return x
    return low if x < low else (high if x > high else x)

## The integer functions. `//` and `%` truncate toward zero as C does (§7.2); these two
## floor, so `div_floor(-7, 2)` is `-4` and `mod_floor(-7, 2)` is `1`.
pub func div_floor(a: i64, b: i64) -> i64:
    let q = a // b
    if (a % b != 0) and ((a < 0) != (b < 0)):
        return q - 1
    return q
pub func mod_floor(a: i64, b: i64) -> i64:
    let r = a % b
    if r != 0 and ((r < 0) != (b < 0)):
        return r + b
    return r
pub func iabs(a: i64) -> i64:
    return 0 - a if a < 0 else a
## Absolute value, or none for the minimum i64 whose positive magnitude cannot fit.
pub func checked_iabs(a: i64) -> i64?:
    if a < 0:
        return 0 -? a
    return a
## Floor division, or none for a zero divisor or a quotient outside i64.
pub func checked_div_floor(a: i64, b: i64) -> i64?:
    if b == 0 or (a == -9223372036854775808 and b == -1):
        return none
    return div_floor(a, b)
## Remainder with the divisor's sign, or none for a zero divisor. The minimum i64
## modulo -1 is zero even though its quotient cannot be represented.
pub func checked_mod_floor(a: i64, b: i64) -> i64?:
    if b == 0:
        return none
    if b == -1:
        return 0
    return mod_floor(a, b)
pub func imin(a: i64, b: i64) -> i64:
    return a if a < b else b
pub func imax(a: i64, b: i64) -> i64:
    return a if a > b else b
## Restrict `x` to inclusive ordered bounds. Reversed bounds trap.
pub func iclamp(x: i64, low: i64, high: i64) -> i64:
    assert(low <= high)
    return low if x < low else (high if x > high else x)
