    Prelude(name = "time", text = """
import platform

extern func clock_gettime(clock: i32, out_time: Stamp*) -> i32
extern func c_time as "time"(out_time: void*?) -> i64

extern struct Stamp:
    seconds: i64
    nanoseconds: i64

## `CLOCK_MONOTONIC`: 6 on macOS, 1 on Linux; `CLOCK_REALTIME` is 0 on both.
let monotonic: i32 = 6 if platform.macos else 1
let realtime: i32 = 0

## Nanoseconds from an arbitrary origin, never going backwards.
pub func now() -> u64:
    var stamp = Stamp(seconds = 0, nanoseconds = 0)
    discard(clock_gettime(monotonic, &stamp))
    return (u64)stamp.seconds * 1000000000 + (u64)stamp.nanoseconds

## Seconds since the Unix epoch.
pub func unix() -> i64:
    return c_time(none)

## Nanoseconds elapsed since `start`, from `now()`.
pub func since(start: u64) -> u64:
    let current = now()
    return current - start if current > start else 0
"""),
    Prelude(name = "os", text = """
## The operating system's view of the process (§16.6): its environment, working
## directory, identity, and host. Text comes back as `str` views of C storage that the
## system owns; copy what must outlive the next call.
import c
import memory
import platform

extern func getenv(variable: c.str) -> c.str?
extern func setenv(variable: c.str, value: c.str, overwrite: i32) -> i32
extern func unsetenv(variable: c.str) -> i32
extern func getcwd(buffer: u8*, size: usize) -> c.str?
extern func chdir(path: c.str) -> i32
extern func getpid() -> i32
extern func getppid() -> i32
extern func gethostname(buffer: u8*, size: usize) -> i32
extern func c_exit as "exit"(code: i32) -> never
extern func sysconf(option: i32) -> i64
extern func getpagesize() -> i32

pub let failed: ErrorCode = ErrorCode.package(12)

## The target, as constants a program branches on: `if os.arm64:`, `if os.linux and
## os.x86_64:` (§19.5); the compiler decides them from `--target`, so the branch a target
## rules out is pruned (§19.6).
pub let arm64: bool = platform.arm64
pub let x86_64: bool = platform.x86_64
pub let macos: bool = platform.macos
pub let linux: bool = platform.linux
pub let windows: bool = platform.windows
pub let posix: bool = platform.posix
pub let pointer_bits: u32 = platform.pointer_bits
pub let name: str = platform.name
## The instruction-set level the program was compiled for (`--cpu`, §19.5): on x86-64, 1
## to 4 for x86-64-v1 to v4; on arm64, 1 for NEON, 2 for SVE.
pub let cpu_level: u32 = platform.cpu_level

## The instruction-set level of the processor this program runs on, in the same scale:
## what it may dispatch to at run time. On x86-64 `cpuid` answers; on arm64 the level is
## NEON until the system reports SVE.
pub func cpu_level_running() -> u32:
    if platform.x86_64:
        return x86_level()
    return 1

## x86-64: SSE4.2 and POPCNT make v2; AVX2, FMA, and BMI2 make v3; AVX-512F makes v4.
func x86_level() -> u32:
    var c1: u32 = 0
    var b7: u32 = 0
    asm x86_64 (in("eax") 1u32, out("ecx") c1, out("eax") _, out("ebx") _, out("edx") _, options(nostack)):
        cpuid
    asm x86_64 (in("eax") 7u32, in("ecx") 0u32, out("ebx") b7, out("eax") _, out("ecx") _, out("edx") _, options(nostack)):
        cpuid
    let sse42 = (c1 & (1 << 20)) != 0
    let popcnt = (c1 & (1 << 23)) != 0
    let fma = (c1 & (1 << 12)) != 0
    let avx2 = (b7 & (1 << 5)) != 0
    let bmi2 = (b7 & (1 << 8)) != 0
    let avx512f = (b7 & (1 << 16)) != 0
    if not (sse42 and popcnt):
        return 1
    if not (avx2 and fma and bmi2):
        return 2
    return 4 if avx512f else 3

## `_SC_NPROCESSORS_ONLN`: 58 on macOS, 84 on Linux.
let processors_online: i32 = 58 if platform.macos else 84

## The processors available to this process, at least one.
pub func cpus() -> u32:
    let n = sysconf(processors_online)
    return (u32)n if n > 0 else 1

pub func page_size() -> usize:
    return (usize)getpagesize()

## The value of an environment variable, or none when it is not set.
pub func env(variable: c.str) -> str?:
    let value = getenv(variable) else return none
    return (str)value

## Set an environment variable for this process and the ones it starts.
pub func set_env(variable: c.str, value: c.str) -> !:
    if setenv(variable, value, 1) != 0:
        error(failed, "the environment variable cannot be set")

pub func unset_env(variable: c.str) -> !:
    if unsetenv(variable) != 0:
        error(failed, "the environment variable cannot be unset")

## The working directory, in storage from the current allocator.
pub func cwd() -> str!:
    let buffer = try alloc u8[4096]
    let found = getcwd(buffer.data, buffer.length)
    if found == none:
        free(buffer)
        error(failed, "the working directory cannot be read")
    let path = found else trap("unreachable")
    return (str)path

pub func change_dir(path: c.str) -> !:
    if chdir(path) != 0:
        error(failed, "the directory cannot be entered")

pub func pid() -> i32:
    return getpid()

pub func parent_pid() -> i32:
    return getppid()

## The host's name, in storage from the current allocator.
pub func hostname() -> str!:
    let buffer = try alloc u8[256]
    if gethostname(buffer.data, buffer.length) != 0:
        free(buffer)
        error(failed, "the host name cannot be read")
    var n: usize = 0
    while n < buffer.length and buffer[n] != 0:
        n += 1
    return (str)buffer[..<n]

## Stop the process with `code`, running no deferred work.
pub func exit(code: i32) -> never:
    c_exit(code)
"""),
    Prelude(name = "testing", text = """
## What a Base test runs under (§16.5): a fixed-buffer allocator made current for
## each test, a deterministic seed, and assertions that name what differed.

import memory
from memory import Allocator, FixedBuffer

var arena_bytes: u8[1048576]
var arena: FixedBuffer
var saved: Allocator
var current_seed: u64 = 1

## Called by the runner before each test.
pub func begin(index: u64):
    arena = FixedBuffer.over(arena_bytes)
    saved = memory.allocator
    memory.allocator = &arena
    current_seed = index * 2654435761 + 1

## Called by the runner after each test.
pub func end():
    memory.allocator = saved

## A seed that is the same on every run of the same test.
pub func seed() -> u64:
    return current_seed

## The next pseudo-random value from the seed, and the seed advanced.
pub func random() -> u64:
    var x = current_seed
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    current_seed = x
    return x

pub func expect(condition: bool, message: str):
    if not condition:
        trap(message)

pub func expect_equal(actual: i64, expected: i64, message: str):
    if actual != expected:
        print(f"expected {expected}, got {actual}: {message}")
        trap(message)

pub func expect_text(actual: str, expected: str, message: str):
    if actual != expected:
        print(f"expected `{expected}`, got `{actual}`: {message}")
        trap(message)
"""),
    Prelude(name = "net", text = """
import c
import platform
from io import Writer

extern func socket(domain: i32, kind: i32, protocol: i32) -> i32
extern func bind(descriptor: i32, address: const SocketAddress*, length: u32) -> i32
extern func listen(descriptor: i32, backlog: i32) -> i32
extern func accept(descriptor: i32, address: SocketAddress*?, length: u32*?) -> i32
extern func connect(descriptor: i32, address: const SocketAddress*, length: u32) -> i32
extern func send(descriptor: i32, data: const void*, length: usize, flags: i32) -> isize
extern func recv(descriptor: i32, buffer: void*, length: usize, flags: i32) -> isize
extern func sendto(descriptor: i32, data: const void*, length: usize, flags: i32, address: const SocketAddress*, address_length: u32) -> isize
extern func recvfrom(descriptor: i32, buffer: void*, length: usize, flags: i32, address: SocketAddress*?, address_length: u32*?) -> isize
extern func close(descriptor: i32) -> i32
extern func setsockopt(descriptor: i32, level: i32, option: i32, value: const void*, length: u32) -> i32
extern func getsockname(descriptor: i32, address: SocketAddress*, length: u32*) -> i32
extern func getaddrinfo(host: c.str, service: c.str?, hints: const AddressInfo*?, result: AddressInfo*?*) -> i32
extern func freeaddrinfo(info: AddressInfo*)

## `sockaddr_in`: 16 bytes everywhere; macOS splits the first two into a length and a
## one-byte family, Linux keeps a two-byte family. `family_word` reads and writes it.
extern struct SocketAddress:
    head: u16
    port: u16
    address: u32
    zero: u8[8]

## The first two bytes of `sockaddr_in` as one little-endian word: on macOS the length
## byte (16) comes first and the family byte second, on Linux the family fills both.
func family_word(family: u8) -> u16:
    if platform.macos:
        return (u16)16 | ((u16)family << 8)
    return (u16)family

## `addrinfo`: macOS puts the canonical name before the address, Linux after it.
extern struct AddressInfo:
    flags: i32
    family: i32
    kind: i32
    protocol: i32
    address_length: u32
    fifth: void*?
    sixth: void*?
    next: AddressInfo*?

func info_address(info: AddressInfo*) -> SocketAddress*?:
    let raw = info.sixth if platform.macos else info.fifth
    let p = raw else return none
    return (SocketAddress*)p

let inet: i32 = 2
let stream: i32 = 1
let datagram: i32 = 2
## `SOL_SOCKET` and `SO_REUSEADDR`: 65535 and 4 on macOS, 1 and 2 on Linux.
let socket_level: i32 = 65535 if platform.macos else 1
let reuse_address: i32 = 4 if platform.macos else 2
## A write to a socket the peer closed answers an error, never the process's death:
## macOS marks the socket (`SO_NOSIGPIPE`, 4130), Linux marks the send (`MSG_NOSIGNAL`,
## 16384).
let no_sigpipe_option: i32 = 4130
let send_flags: i32 = 0 if platform.macos else 16384

pub let failed: ErrorCode = ErrorCode.package(9)
pub let closed: ErrorCode = ErrorCode.package(10)
pub let unknown_host: ErrorCode = ErrorCode.package(11)

## An IPv4 address and port, both in host order.
pub struct Address:
    pub var ip: u32
    pub var port: u16

    pub static func loopback(port: u16) -> Address:
        return Address(ip = 2130706433, port = port)

    pub static func any(port: u16) -> Address:
        return Address(ip = 0, port = port)

    func raw() -> SocketAddress:
        var zero: u8[8]
        return SocketAddress(head = family_word(2), port = swap16(self.port), address = swap32(self.ip), zero = zero)

    static func from_raw(raw: SocketAddress) -> Address:
        return Address(ip = swap32(raw.address), port = swap16(raw.port))

## Host to network byte order and back; the machine is little-endian.
func swap16(value: u16) -> u16:
    return (value << 8) | (value >> 8)

func swap32(value: u32) -> u32:
    return (value << 24) | ((value << 8) & 16711680) | ((value >> 8) & 65280) | (value >> 24)

## The first IPv4 address of `host`.
pub func resolve(host: c.str, port: u16) -> Address!:
    var hints = AddressInfo(flags = 0, family = inet, kind = stream, protocol = 0, address_length = 0, fifth = none, sixth = none, next = none)
    var found: AddressInfo*? = none
    if getaddrinfo(host, none, &hints, &found) != 0:
        error(unknown_host, "unknown host")
    let info = found else error(unknown_host, "unknown host")
    let raw = info_address(info) else error(unknown_host, "unknown host")
    var address = Address.from_raw(*raw)
    address.port = port
    freeaddrinfo(info)
    return address

## A bound TCP socket waiting for connections.
pub struct Listener:
    var descriptor: i32

    pub static func bind(address: Address) -> Listener!:
        let fd = socket(inet, stream, 0)
        if fd < 0:
            error(failed, "socket")
        var yes: i32 = 1
        discard(setsockopt(fd, socket_level, reuse_address, &yes, 4))
        let raw = address.raw()
        if bind(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "bind")
        if listen(fd, 16) != 0:
            discard(close(fd))
            error(failed, "listen")
        return Listener(descriptor = fd)

    ## The address the socket ended up with; a port of zero asked for any free one.
    pub func address() -> Address:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        discard(getsockname(self.descriptor, &raw, &length))
        return Address.from_raw(raw)

    pub func accept() -> Connection!:
        var fd = accept(self.descriptor, none, none)
        while fd < 0 and c.errno() == c.interrupted:
            fd = accept(self.descriptor, none, none)
        if fd < 0:
            error(failed, "accept")
        return Connection.over(fd)

    pub func close():
        discard(close(self.descriptor))

## One TCP connection; it is a `Writer`.
pub struct Connection: Writer:
    ## The socket, for callers that poll or pass it on.
    pub var descriptor: i32
    ## Whether the socket is marked against `SIGPIPE` (macOS); `write` marks it on first
    ## use, so a connection built any other way than `over` is guarded too.
    var guarded: bool

    pub static func connect(address: Address) -> Connection!:
        let fd = socket(inet, stream, 0)
        if fd < 0:
            error(failed, "socket")
        let raw = address.raw()
        if connect(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "connect")
        return Connection.over(fd)

    ## A connection over a socket the caller made (a `socketpair`, an inherited
    ## descriptor): the socket is marked so that a write after the peer closed fails
    ## instead of ending the process. Make the connection while the peer is still there:
    ## macOS refuses the mark on a socket whose peer has already gone, and a write on
    ## such a connection answers `closed` without sending.
    pub static func over(descriptor: i32) -> Connection:
        var connection = Connection(descriptor = descriptor, guarded = false)
        discard(connection.guard())
        return connection

    ## Whether a write cannot raise `SIGPIPE`. Linux asks with every `send`
    ## (`MSG_NOSIGNAL`); macOS marks the socket once (`SO_NOSIGPIPE`), and refuses the mark
    ## with `EINVAL` on a socket whose peer has disconnected.
    mutating func guard() -> bool:
        if self.guarded:
            return true
        if not platform.macos:
            self.guarded = true
            return true
        var yes: i32 = 1
        if setsockopt(self.descriptor, socket_level, no_sigpipe_option, &yes, 4) == 0:
            self.guarded = true
        return self.guarded

    ## Send every byte; a peer that closed is `closed`, never a signal.
    pub mutating func write(data: const u8[]) -> usize!:
        if not self.guard():
            error(closed, "the connection closed")
        var done: usize = 0
        while done < data.length:
            let n = send(self.descriptor, data[done..].data, data.length - done, send_flags)
            if n < 0 and c.errno() == c.interrupted:
                continue
            if n <= 0:
                error(closed, "the connection closed")
            done += (usize)n
        return done

    ## Receive what is available, up to the buffer; zero means the peer closed.
    pub func receive(buffer: u8[]) -> usize!:
        var n = recv(self.descriptor, buffer.data, buffer.length, 0)
        while n < 0 and c.errno() == c.interrupted:
            n = recv(self.descriptor, buffer.data, buffer.length, 0)
        if n < 0:
            error(closed, "the connection closed")
        return (usize)n

    pub func close():
        discard(close(self.descriptor))

## A UDP socket.
pub struct Datagram:
    var descriptor: i32

    pub static func bind(address: Address) -> Datagram!:
        let fd = socket(inet, datagram, 0)
        if fd < 0:
            error(failed, "socket")
        let raw = address.raw()
        if bind(fd, &raw, 16) != 0:
            discard(close(fd))
            error(failed, "bind")
        return Datagram(descriptor = fd)

    pub func address() -> Address:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        discard(getsockname(self.descriptor, &raw, &length))
        return Address.from_raw(raw)

    pub func send_to(data: const u8[], address: Address) -> !:
        let raw = address.raw()
        var n = sendto(self.descriptor, data.data, data.length, 0, &raw, 16)
        while n < 0 and c.errno() == c.interrupted:
            n = sendto(self.descriptor, data.data, data.length, 0, &raw, 16)
        if n < 0 or (usize)n != data.length:
            error(failed, "send")

    pub func receive_from(buffer: u8[]) -> (usize, Address)!:
        var raw = SocketAddress(head = 0, port = 0, address = 0, zero = [0, 0, 0, 0, 0, 0, 0, 0])
        var length: u32 = 16
        var n = recvfrom(self.descriptor, buffer.data, buffer.length, 0, &raw, &length)
        while n < 0 and c.errno() == c.interrupted:
            length = 16
            n = recvfrom(self.descriptor, buffer.data, buffer.length, 0, &raw, &length)
        if n < 0:
            error(failed, "receive")
        return ((usize)n, Address.from_raw(raw))

    pub func close():
        discard(close(self.descriptor))
"""),
    Prelude(name = "debug", text = """
import c
import memory

extern func getenv(name: c.str) -> c.str?
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func c_exit as "exit"(code: i32) -> never

## A frame as the compiler described it under `--debug`: the function's name and
## source, then `count` locals laid out after it.
extern struct Shape:
    name: str
    source: str
    count: u64

extern struct Local:
    name: str
    kind: str
    offset: u64
    size: u64

struct Activation:
    var shape: Shape*?
    var frame: void*?
    var line: u32

struct Break:
    var file: str
    var line: u32

var activations: Activation[512]
var depth: usize
var checked: bool
var active: bool
var started: bool
var stepping: bool
var step_over: usize
var breaks: Break[32]
var break_count: usize
var names: u8[4096]
var names_used: usize
var line_bytes: u8[512]

## Called at every function entry and exit of a `--debug` build.
pub func enter(shape: void*):
    if depth < activations.length:
        activations[depth] = Activation(shape = (Shape*)shape, frame = none, line = 0)
    depth += 1

pub func leave():
    if depth > 0:
        depth -= 1

## Called before every statement: stop when a breakpoint, a step, or the start asks.
pub func at(shape: void*, line: u32, frame: void*):
    if not checked:
        checked = true
        active = getenv("LUCE_DEBUG") != none
    if not active or depth == 0 or depth > activations.length:
        return
    let top = depth - 1
    let s = (Shape*)shape
    activations[top] = Activation(shape = s, frame = frame, line = line)
    var stop = false
    if not started:
        started = true
        stop = true
    elif stepping:
        stop = true
    elif step_over > 0 and depth <= step_over:
        stop = true
    elif hits(s.source, line):
        stop = true
    if not stop:
        return
    stepping = false
    step_over = 0
    print(f"stopped at {s.source}:{line} in {s.name}")
    prompt(top)

func hits(file: str, line: u32) -> bool:
    var i: usize = 0
    while i < break_count:
        let b = breaks[i]
        if b.line == line and (b.file == file or ends_with(file, b.file)):
            return true
        i += 1
    return false

func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## Read commands until one lets the program run.
func prompt(top: usize):
    while true:
        let line = read_line() else return
        let command = first_word(line)
        let rest = trim((str)line.bytes[command.length..])
        if command == "r" or command == "run" or command == "c" or command == "continue":
            return
        if command == "s" or command == "step":
            stepping = true
            return
        if command == "n" or command == "next":
            step_over = depth
            return
        if command == "q" or command == "quit":
            print("quit")
            c_exit(0)
        if command == "b" or command == "break":
            add_break(rest)
        elif command == "p" or command == "print":
            show_named(top, rest)
        elif command == "locals":
            show_all(top)
        elif command == "bt" or command == "backtrace":
            backtrace()
        elif command.length == 0:
            continue
        else:
            print(f"unknown command `{command}`; commands: break FILE:LINE, run, step, next, print NAME, locals, backtrace, quit")

func add_break(spec: str):
    var colon: usize = spec.length
    var i = spec.length
    while i > 0:
        i -= 1
        if spec.bytes[i] == ':':
            colon = i
            break
    if colon == spec.length:
        print("break needs FILE:LINE")
        return
    let file = (str)spec.bytes[..<colon]
    let number = parse_line((str)spec.bytes[colon + 1..])
    if number == 0 or break_count == breaks.length or names_used + file.length > names.length:
        print("cannot set that breakpoint")
        return
    memory.copy(names[names_used..], file.bytes, file.length)
    let kept = (str)names[names_used..<names_used + file.length]
    names_used += file.length
    breaks[break_count] = Break(file = kept, line = number)
    break_count += 1
    print(f"breakpoint {break_count} at {file}:{number}")

func parse_line(text: str) -> u32:
    var value: u32 = 0
    for byte in text.bytes:
        if byte < '0' or byte > '9':
            return 0
        value = value * 10 + (u32)(byte - '0')
    return value

func backtrace():
    var i = depth
    var index: usize = 0
    while i > 0:
        i -= 1
        let a = activations[i]
        if let s = a.shape:
            print(f"#{index} {s.name} at {s.source}:{a.line}")
        index += 1

func show_all(top: usize):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        show(local_of(s, i), a.frame)
        i += 1

func show_named(top: usize, name: str):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        let described = local_of(s, i)
        if described.name == name:
            show(described, a.frame)
            return
        i += 1
    print(f"no local named `{name}`")

## The locals follow the shape, each `sizeof(Local)` bytes.
func local_of(s: Shape*, index: u64) -> Local*:
    let base = (usize)s + sizeof(Shape) + (usize)index * sizeof(Local)
    return (Local*)base

## A local's value read from the frame and shown by its type's spelling.
func show(described: Local*, frame: void*?):
    let f = frame else return
    let address = (void*)((usize)f - (usize)described.offset)
    let kind = described.kind
    if kind == "i64" or kind == "isize":
        print(f"{described.name}: {kind} = {memory.read[i64](address)}")
    elif kind == "i32":
        print(f"{described.name}: {kind} = {memory.read[i32](address)}")
    elif kind == "i16":
        print(f"{described.name}: {kind} = {memory.read[i16](address)}")
    elif kind == "i8":
        print(f"{described.name}: {kind} = {memory.read[i8](address)}")
    elif kind == "u64" or kind == "usize":
        print(f"{described.name}: {kind} = {memory.read[u64](address)}")
    elif kind == "u32" or kind == "char":
        print(f"{described.name}: {kind} = {memory.read[u32](address)}")
    elif kind == "u16":
        print(f"{described.name}: {kind} = {memory.read[u16](address)}")
    elif kind == "u8":
        print(f"{described.name}: {kind} = {memory.read[u8](address)}")
    elif kind == "bool":
        print(f"{described.name}: {kind} = {memory.read[bool](address)}")
    elif kind == "f64":
        print(f"{described.name}: {kind} = {memory.read[f64](address)}")
    elif kind == "f32":
        print(f"{described.name}: {kind} = {memory.read[f32](address)}")
    elif kind == "str":
        let text = memory.read[str](address)
        print(f"{described.name}: {kind} = \\"{text}\\"")
    elif kind == "c.str":
        let text = memory.read[c.str](address)
        print(f"{described.name}: {kind} = \\"{(str)text}\\"")
    elif ends_with(kind, "*") or ends_with(kind, "*?"):
        print(f"{described.name}: {kind} = 0x{hex(memory.read[usize](address))}")
    else:
        var shown: usize = (usize)described.size
        if shown > 32:
            shown = 32
        var text: u8[160]
        var used: usize = 0
        var i: usize = 0
        while i < shown:
            let byte = memory.read[u8]((void*)((usize)address + i))
            let digits = "0123456789abcdef".bytes
            text[used] = digits[(usize)(byte >> 4)]
            text[used + 1] = digits[(usize)(byte & 15)]
            text[used + 2] = ' '
            used += 3
            i += 1
        print(f"{described.name}: {kind} = {described.size} bytes {(str)text[..<used]}")

func first_word(line: str) -> str:
    var i: usize = 0
    while i < line.length and line.bytes[i] != ' ':
        i += 1
    return (str)line.bytes[..<i]

func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    while start < end and text.bytes[start] == ' ':
        start += 1
    while end > start and (text.bytes[end - 1] == ' ' or text.bytes[end - 1] == '\\r'):
        end -= 1
    return (str)text.bytes[start..<end]

## One line from standard input, without its newline; none at the end of input.
func read_line() -> str?:
    var used: usize = 0
    while used < line_bytes.length:
        var byte: u8[1]
        let n = c_read(0, &byte[0], 1)
        if n <= 0:
            if used == 0:
                return none
            break
        if byte[0] == '\\n':
            break
        line_bytes[used] = byte[0]
        used += 1
    return (str)line_bytes[..<used]
"""),
]
