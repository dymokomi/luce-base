import platform

extern func clock_gettime(clock: i32, out_time: Stamp*) -> i32
extern func c_time as "time"(out_time: void*?) -> i64

extern struct Stamp:
    seconds: i64
    nanoseconds: i64

## `CLOCK_MONOTONIC`: 6 on macOS, 1 on Linux; `CLOCK_REALTIME` is 0 on both.
let monotonic: i32 = 6 if platform.macos else 1
let realtime: i32 = 0

## Nanoseconds from an arbitrary origin, never going backwards.
pub func now() -> u64:
    var stamp = Stamp(seconds = 0, nanoseconds = 0)
    discard(clock_gettime(monotonic, &stamp))
    return (u64)stamp.seconds * 1000000000 + (u64)stamp.nanoseconds

## Seconds since the Unix epoch.
pub func unix() -> i64:
    return c_time(none)

## Nanoseconds elapsed since `start`, from `now()`.
pub func since(start: u64) -> u64:
    let current = now()
    return current - start if current > start else 0
"""),
    Prelude(name = "os", text = """
## The operating system's view of the process (§16.6): its environment, working
## directory, identity, and host. Text comes back as `str` views of C storage that the
## system owns; copy what must outlive the next call.
import c
import memory
import platform

extern func getenv(variable: c.str) -> c.str?
extern func setenv(variable: c.str, value: c.str, overwrite: i32) -> i32
extern func unsetenv(variable: c.str) -> i32
extern func getcwd(buffer: u8*, size: usize) -> c.str?
extern func chdir(path: c.str) -> i32
extern func getpid() -> i32
extern func getppid() -> i32
extern func gethostname(buffer: u8*, size: usize) -> i32
extern func c_exit as "exit"(code: i32) -> never
extern func sysconf(option: i32) -> i64
extern func getpagesize() -> i32

pub let failed: ErrorCode = ErrorCode.package(12)

## The target, as constants a program branches on: `if os.arm64:`, `if os.linux and
## os.x86_64:` (§19.5); the compiler decides them from `--target`, so the branch a target
## rules out is pruned (§19.6).
pub let arm64: bool = platform.arm64
pub let x86_64: bool = platform.x86_64
pub let macos: bool = platform.macos
pub let linux: bool = platform.linux
pub let windows: bool = platform.windows
pub let posix: bool = platform.posix
pub let pointer_bits: u32 = platform.pointer_bits
pub let name: str = platform.name
## The instruction-set level the program was compiled for (`--cpu`, §19.5): on x86-64, 1
## to 4 for x86-64-v1 to v4; on arm64, 1 for NEON, 2 for SVE.
pub let cpu_level: u32 = platform.cpu_level

## The instruction-set level of the processor this program runs on, in the same scale:
## what it may dispatch to at run time. On x86-64 `cpuid` answers; on arm64 the level is
## NEON until the system reports SVE.
pub func cpu_level_running() -> u32:
    if platform.x86_64:
        return x86_level()
    return 1

## x86-64: SSE4.2 and POPCNT make v2; AVX2, FMA, and BMI2 make v3; AVX-512F makes v4.
func x86_level() -> u32:
    var c1: u32 = 0
    var b7: u32 = 0
    asm x86_64 (in("eax") 1u32, out("ecx") c1, out("eax") _, out("ebx") _, out("edx") _, options(nostack)):
        cpuid
    asm x86_64 (in("eax") 7u32, in("ecx") 0u32, out("ebx") b7, out("eax") _, out("ecx") _, out("edx") _, options(nostack)):
        cpuid
    let sse42 = (c1 & (1 << 20)) != 0
    let popcnt = (c1 & (1 << 23)) != 0
    let fma = (c1 & (1 << 12)) != 0
    let avx2 = (b7 & (1 << 5)) != 0
    let bmi2 = (b7 & (1 << 8)) != 0
    let avx512f = (b7 & (1 << 16)) != 0
    if not (sse42 and popcnt):
        return 1
    if not (avx2 and fma and bmi2):
        return 2
    return 4 if avx512f else 3

## `_SC_NPROCESSORS_ONLN`: 58 on macOS, 84 on Linux.
let processors_online: i32 = 58 if platform.macos else 84

## The processors available to this process, at least one.
pub func cpus() -> u32:
    let n = sysconf(processors_online)
    return (u32)n if n > 0 else 1

pub func page_size() -> usize:
    return (usize)getpagesize()

## The value of an environment variable, or none when it is not set.
pub func env(variable: c.str) -> str?:
    let value = getenv(variable) else return none
    return (str)value

## Set an environment variable for this process and the ones it starts.
pub func set_env(variable: c.str, value: c.str) -> !:
    if setenv(variable, value, 1) != 0:
        error(failed, "the environment variable cannot be set")

pub func unset_env(variable: c.str) -> !:
    if unsetenv(variable) != 0:
        error(failed, "the environment variable cannot be unset")

## The working directory, in storage from the current allocator.
pub func cwd() -> str!:
    let buffer = try alloc u8[4096]
    let found = getcwd(buffer.data, buffer.length)
    if found == none:
        free(buffer)
        error(failed, "the working directory cannot be read")
    let path = found else trap("unreachable")
    return (str)path

pub func change_dir(path: c.str) -> !:
    if chdir(path) != 0:
        error(failed, "the directory cannot be entered")

pub func pid() -> i32:
    return getpid()

pub func parent_pid() -> i32:
    return getppid()

## The host's name, in storage from the current allocator.
pub func hostname() -> str!:
    let buffer = try alloc u8[256]
    if gethostname(buffer.data, buffer.length) != 0:
        free(buffer)
        error(failed, "the host name cannot be read")
    var n: usize = 0
    while n < buffer.length and buffer[n] != 0:
        n += 1
    return (str)buffer[..<n]

## Stop the process with `code`, running no deferred work.
pub func exit(code: i32) -> never:
    c_exit(code)
"""),
    Prelude(name = "testing", text = """
## What a Base test runs under (§16.5): a fixed-buffer allocator made current for
## each test, a deterministic seed, and assertions that name what differed.

import memory
from memory import Allocator, FixedBuffer

var arena_bytes: u8[1048576]
var arena: FixedBuffer
var saved: Allocator
var current_seed: u64 = 1

## Called by the runner before each test.
pub func begin(index: u64):
    arena = FixedBuffer.over(arena_bytes)
    saved = memory.allocator
    memory.allocator = &arena
    current_seed = index * 2654435761 + 1

## Called by the runner after each test.
pub func end():
    memory.allocator = saved

## A seed that is the same on every run of the same test.
pub func seed() -> u64:
    return current_seed

## The next pseudo-random value from the seed, and the seed advanced.
pub func random() -> u64:
    var x = current_seed
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    current_seed = x
    return x

pub func expect(condition: bool, message: str):
    if not condition:
        trap(message)

pub func expect_equal(actual: i64, expected: i64, message: str):
    if actual != expected:
        print(f"expected {expected}, got {actual}: {message}")
        trap(message)

pub func expect_text(actual: str, expected: str, message: str):
    if actual != expected:
        print(f"expected `{expected}`, got `{actual}`: {message}")
        trap(message)
"""),
    Prelude(name = "net", text = """
## Blocking socket I/O. Created and accepted sockets are close-on-exec. Linux
## sets that flag atomically; macOS requires a separate call, so applications
## must serialize socket creation/acceptance with concurrent fork/exec there.
## Adopting a caller-created descriptor also needs this coordination on either OS.
import c
import atomic
import platform
import memory
import io
from io import Reader, Writer

extern func socket(domain: i32, kind: i32, protocol: i32) -> i32
extern func bind(descriptor: i32, address: const void*, length: u32) -> i32
extern func listen(descriptor: i32, backlog: i32) -> i32
extern func accept(descriptor: i32, address: void*?, length: u32*?) -> i32
extern func accept4(descriptor: i32, address: void*?, length: u32*?, flags: i32) -> i32
extern func fcntl(descriptor: i32, command: i32, ...) -> i32
extern func connect(descriptor: i32, address: const void*, length: u32) -> i32
extern func send(descriptor: i32, data: const void*, length: usize, flags: i32) -> isize
extern func recv(descriptor: i32, buffer: void*, length: usize, flags: i32) -> isize
extern func sendto(descriptor: i32, data: const void*, length: usize, flags: i32, address: const void*, address_length: u32) -> isize
extern func receive_message_macos as "recvmsg"(descriptor: i32, message: MacMessage*, flags: i32) -> isize
extern func receive_message_linux as "recvmsg"(descriptor: i32, message: LinuxMessage*, flags: i32) -> isize
extern func close(descriptor: i32) -> i32
extern func getsockopt(descriptor: i32, level: i32, option: i32, value: void*, length: u32*) -> i32
extern func setsockopt(descriptor: i32, level: i32, option: i32, value: const void*, length: u32) -> i32
extern func getsockname(descriptor: i32, address: void*, length: u32*) -> i32
extern func getpeername(descriptor: i32, address: void*, length: u32*) -> i32
extern func shutdown(descriptor: i32, direction: i32) -> i32
extern func getaddrinfo(host: c.str, service: c.str?, hints: const AddressInfo*?, result: AddressInfo*?*) -> i32
extern func freeaddrinfo(info: AddressInfo*)

## `sockaddr_in`: 16 bytes everywhere; macOS splits the first two into a length and a
## one-byte family, Linux keeps a two-byte family. `family_word` reads and writes it.
extern struct NativeIpv4Address:
    head: u16
    port: u16
    address: u32
    zero: u8[8]

## sockaddr_in6 is 28 bytes on both native hosts. Flow information is left zero;
## the scope index is a host-order u32, while the port is network-order u16.
extern struct NativeIpv6Address:
    head: u16
    port: u16
    flow: u32
    address: u8[16]
    scope: u32

## Enough aligned storage for either supported IP sockaddr representation.
extern union NativeAddress:
    ipv4: NativeIpv4Address
    ipv6: NativeIpv6Address

extern struct ReceiveVector:
    data: u8*?
    length: usize

## Host msghdr layouts: macOS uses int for the vector count and socklen_t for
## control length; glibc uses size_t for both. Their flags offsets differ.
extern struct MacMessage:
    address: void*
    address_length: u32
    vectors: ReceiveVector*
    vector_count: i32
    control: void*?
    control_length: u32
    flags: i32

extern struct LinuxMessage:
    address: void*
    address_length: u32
    vectors: ReceiveVector*
    vector_count: usize
    control: void*?
    control_length: usize
    flags: i32

## The first two bytes of `sockaddr_in` as one little-endian word: on macOS the length
## byte comes first and the family byte second, on Linux the family fills both.
func family_word(family: i32, length: u8) -> u16:
    if platform.macos:
        return (u16)length | ((u16)family << 8)
    return (u16)family

## `addrinfo`: macOS puts the canonical name before the address, Linux after it.
extern struct AddressInfo:
    flags: i32
    family: i32
    kind: i32
    protocol: i32
    address_length: u32
    fifth: void*?
    sixth: void*?
    next: AddressInfo*?

func info_address(info: const AddressInfo*) -> void*?:
    return info.sixth if platform.macos else info.fifth

let inet: i32 = 2
let inet6: i32 = 30 if platform.macos else 10
let stream: i32 = 1
let datagram: i32 = 2
let socket_close_on_exec: i32 = 524288
let get_descriptor_flags: i32 = 1
let set_descriptor_flags: i32 = 2
let descriptor_close_on_exec: i32 = 1
## `SOL_SOCKET` and `SO_REUSEADDR`: 65535 and 4 on macOS, 1 and 2 on Linux.
let socket_level: i32 = 65535 if platform.macos else 1
let reuse_address_option: i32 = 4 if platform.macos else 2
## A write to a socket the peer closed answers an error, never the process's death:
## macOS marks the socket (`SO_NOSIGPIPE`, 4130), Linux marks the send (`MSG_NOSIGNAL`,
## 16384).
let ipv6_level: i32 = 41
let ipv6_only_option: i32 = 27 if platform.macos else 26
let no_sigpipe_option: i32 = 4130
let send_flags: i32 = 0 if platform.macos else 16384

pub let failed: ErrorCode = ErrorCode.package(9)
pub let closed: ErrorCode = ErrorCode.package(10)
pub let unknown_host: ErrorCode = ErrorCode.package(11)
pub let invalid_options: ErrorCode = ErrorCode.package(35)
pub let message_too_large: ErrorCode = ErrorCode.package(36)

pub let cancelled: ErrorCode = ErrorCode.package(37)
pub let timed_out: ErrorCode = ErrorCode.package(38)
## IP version carried by an address value. IPv4-mapped IPv6 remains IPv6.
pub enum IpVersion as u8:
    ipv4 = 0
    ipv6 = 1

## An IP value without a port, prefix length or interface scope. Storage is owned
## inline; copying is safe and requires no cleanup. Zero represents 0.0.0.0.
pub struct IpAddress:
    var kind: IpVersion
    var octets: u8[16]

    pub static func from_ipv4(number: u32) -> IpAddress:
        var result: IpAddress
        var i: usize = 0
        while i < 4:
            result.octets[i] = (u8)((number >> ((3 - i) * 8)) & 255)
            i += 1
        return result

    ## Copy exactly four IPv4 or sixteen IPv6 octets in network order.
    pub static func from_bytes(bytes: const u8[]) -> IpAddress!:
        if bytes.length != 4 and bytes.length != 16:
            error(invalid_options, "an IP address needs four or sixteen octets")
        var result = IpAddress(kind = IpVersion.ipv4 if bytes.length == 4 else IpVersion.ipv6)
        memory.copy(result.octets, bytes, bytes.length)
        return result

    ## Parse one complete address, without DNS. Accept IPv6 compression, uppercase
    ## hex and dotted IPv4 tails. IPv4 needs four decimal components without leading
    ## zeros. Reject whitespace, NUL, brackets, ports, prefix lengths and zone IDs.
    pub static func parse(text: str) -> IpAddress?:
        if text.length == 0 or text.length > 45:
            return none
        var has_colon = false
        var i: usize = 0
        while i < text.length:
            let byte = text.bytes[i]
            # Bare IP values have a fixed ASCII grammar and no interface zone.
            let digit = byte >= '0' and byte <= '9'
            let hex = (byte >= 'a' and byte <= 'f') or (byte >= 'A' and byte <= 'F')
            if not digit and not hex and byte != ':' and byte != '.':
                return none
            if byte == ':':
                has_colon = true
            i += 1
        if not has_colon:
            let number = parse_ipv4_number(text) else return none
            return IpAddress.from_ipv4(number)
        return parse_ipv6(text)

    pub func version() -> IpVersion:
        return self.kind

    ## IPv4 in host-order numeric notation; none for IPv6, including mapped values.
    pub func ipv4_number() -> u32?:
        if self.kind != IpVersion.ipv4:
            return none
        return ((u32)self.octets[0] << 24) | ((u32)self.octets[1] << 16) | ((u32)self.octets[2] << 8) | (u32)self.octets[3]

    pub func is_ipv4_mapped() -> bool:
        if self.kind != IpVersion.ipv6:
            return false
        var i: usize = 0
        while i < 10:
            if self.octets[i] != 0:
                return false
            i += 1
        return self.octets[10] == 255 and self.octets[11] == 255

    ## Compare address bits and version. Mapped IPv6 and IPv4 are distinct values.
    pub func equals(other: IpAddress) -> bool:
        if self.kind != other.kind:
            return false
        var i: usize = 0
        while i < 16:
            if self.octets[i] != other.octets[i]:
                return false
            i += 1
        return true

    ## Copy network-order octets, returning four or sixteen. On insufficient
    ## storage report io.full without modifying the destination.
    pub func write_octets(destination: u8[]) -> usize!:
        let count: usize = 4 if self.kind == IpVersion.ipv4 else 16
        if destination.length < count:
            error(io.full, "the destination cannot hold the IP address octets")
        memory.move(destination, self.octets[..<count], count)
        return count

    ## Format into borrowed storage without allocation or a trailing NUL. IPv6
    ## uses lowercase hex, the first longest zero run, and never compresses one
    ## zero field. Mapped IPv6 uses ::ffff: followed by dotted IPv4. A 39-byte buffer
    ## always suffices; smaller buffers work when the result fits. On io.full the
    ## destination is unchanged. The returned view lives only as long as the buffer.
    pub func format(buffer: u8[]) -> str!:
        var text: u8[39]
        var used: usize = 0
        if self.kind == IpVersion.ipv4:
            used = render_ipv4(self.octets[..<4], text, 0)
        elif self.is_ipv4_mapped():
            memory.copy(text, "::ffff:".bytes, 7)
            used = render_ipv4(self.octets[12..], text, 7)
        else:
            var best_start: usize = 8
            var best_length: usize = 1
            var i: usize = 0
            while i < 8:
                if self.word(i) != 0:
                    i += 1
                    continue
                let start = i
                while i < 8 and self.word(i) == 0:
                    i += 1
                if i - start > best_length:
                    best_start = start
                    best_length = i - start
            i = 0
            while i < 8:
                if i == best_start:
                    text[used] = ':'
                    text[used + 1] = ':'
                    used += 2
                    i += best_length
                    continue
                if used > 0 and text[used - 1] != ':':
                    text[used] = ':'
                    used += 1
                used = render_hex_word(self.word(i), text, used)
                i += 1
        if buffer.length < used:
            error(io.full, "the destination cannot hold the formatted IP address")
        memory.move(buffer, text, used)
        return (str)buffer[..<used]

    func word(index: usize) -> u16:
        return ((u16)self.octets[index * 2] << 8) | (u16)self.octets[index * 2 + 1]

func parse_ipv4_number(text: str) -> u32?:
    var result: u32 = 0
    var position: usize = 0
    var component: usize = 0
    while component < 4:
        let start = position
        var value: u32 = 0
        while position < text.length and text.bytes[position] >= '0' and text.bytes[position] <= '9':
            if position - start == 3:
                return none
            value = value * 10 + (u32)(text.bytes[position] - '0')
            position += 1
        if position == start or value > 255:
            return none
        if position - start > 1 and text.bytes[start] == '0':
            return none
        result = (result << 8) | value
        component += 1
        if component < 4:
            if position == text.length or text.bytes[position] != '.':
                return none
            position += 1
    if position != text.length:
        return none
    return result

func render_ipv4(octets: const u8[], output: u8[], start: usize) -> usize:
    var used = start
    var i: usize = 0
    while i < 4:
        if i > 0:
            output[used] = '.'
            used += 1
        let value = octets[i]
        if value >= 100:
            output[used] = '0' + value // 100
            used += 1
        if value >= 10:
            output[used] = '0' + (value // 10) % 10
            used += 1
        output[used] = '0' + value % 10
        used += 1
        i += 1
    return used

func render_hex_word(word: u16, output: u8[], start: usize) -> usize:
    let digits = "0123456789abcdef"
    var used = start
    var shift: i32 = 12
    var started = false
    while shift >= 0:
        let digit = (usize)((word >> shift) & 15)
        if digit != 0 or started or shift == 0:
            output[used] = digits.bytes[digit]
            used += 1
            started = true
        shift -= 4
    return used

## Decode at most eight fields, then expand a single compression gap in place.
## The public parser has already restricted input to hex digits, dots and colons.
func parse_ipv6(text: str) -> IpAddress?:
    var result = IpAddress(kind = IpVersion.ipv6)
    var position: usize = 0
    var count: usize = 0
    var compression: usize? = none
    if text.bytes[0] == ':':
        if text.length < 2 or text.bytes[1] != ':':
            return none
        compression = 0
        position = 2
    while position < text.length:
        if count >= 8:
            return none
        let start = position
        var value: u16 = 0
        while position < text.length and text.bytes[position] != ':' and text.bytes[position] != '.':
            if position - start == 4:
                return none
            let byte = text.bytes[position]
            let digit = (u16)(byte - '0') if byte <= '9' else ((u16)(byte - 'A' + 10) if byte <= 'F' else (u16)(byte - 'a' + 10))
            value = (value << 4) | digit
            position += 1
        if position < text.length and text.bytes[position] == '.':
            if count > 6:
                return none
            let number = parse_ipv4_number((str)text.bytes[start..]) else return none
            var i: usize = 0
            while i < 4:
                result.octets[count * 2 + i] = (u8)((number >> ((3 - i) * 8)) & 255)
                i += 1
            count += 2
            position = text.length
            break
        if position == start:
            return none
        result.octets[count * 2] = (u8)(value >> 8)
        result.octets[count * 2 + 1] = (u8)(value & 255)
        count += 1
        if position == text.length:
            break
        position += 1
        if position == text.length:
            return none
        if text.bytes[position] == ':':
            if compression != none:
                return none
            compression = count
            position += 1
    if let gap = compression:
        if count >= 8:
            return none
        let missing = (8 - count) * 2
        var i = count * 2
        while i > gap * 2:
            i -= 1
            result.octets[i + missing] = result.octets[i]
        i = gap * 2
        while i < gap * 2 + missing:
            result.octets[i] = 0
            i += 1
    elif count != 8:
        return none
    return result
## An IP endpoint: address, port and optional IPv6 interface scope. A zero value is
## 0.0.0.0:0. The port is host order; scope zero means no explicit interface index.
## IPv4 endpoints must have scope zero. Values own their inline storage.
pub struct SocketAddress:
    pub var ip: IpAddress
    pub var port: u16
    pub var scope_id: u32

    pub static func loopback(port: u16, version: IpVersion = IpVersion.ipv4) -> SocketAddress:
        if version == IpVersion.ipv4:
            return SocketAddress(ip = IpAddress.from_ipv4(2130706433), port = port)
        var ip = IpAddress(kind = version)
        ip.octets[15] = 1
        return SocketAddress(ip = ip, port = port)

    pub static func any(port: u16, version: IpVersion = IpVersion.ipv4) -> SocketAddress:
        return SocketAddress(ip = IpAddress(kind = version), port = port)

    ## Parse IPv4:port or [IPv6%scope]:port without DNS. Scope is optional and
    ## numeric, not an interface name. Ports use 1–5 decimal digits; scope IDs use
    ## 1–10. Leading zeroes in these numbers are accepted and omitted on output.
    pub static func parse(text: str) -> SocketAddress?:
        if text.length == 0 or text.length > 64:
            return none
        var ip_start: usize = 0
        var ip_end: usize = 0
        var port_start: usize = 0
        var scope: u32 = 0
        let bracketed = text.bytes[0] == '['
        if bracketed:
            ip_start = 1
            var end: usize = 1
            while end < text.length and text.bytes[end] != ']':
                end += 1
            if end + 1 >= text.length or text.bytes[end + 1] != ':':
                return none
            ip_end = end
            port_start = end + 2
            var i: usize = 1
            while i < end:
                if text.bytes[i] == '%':
                    ip_end = i
                    let parsed = parse_endpoint_number((str)text.bytes[i + 1..<end], 4294967295, 10) else return none
                    scope = parsed
                    break
                i += 1
        else:
            while ip_end < text.length and text.bytes[ip_end] != ':':
                ip_end += 1
            if ip_end == text.length:
                return none
            port_start = ip_end + 1
        let ip = IpAddress.parse((str)text.bytes[ip_start..<ip_end]) else return none
        if (ip.kind == IpVersion.ipv6) != bracketed:
            return none
        let port = parse_endpoint_number((str)text.bytes[port_start..], 65535, 5) else return none
        return SocketAddress(ip = ip, port = (u16)port, scope_id = scope)

    pub func equals(other: SocketAddress) -> bool:
        return self.ip.equals(other.ip) and self.port == other.port and self.scope_id == other.scope_id

    ## Canonical numeric endpoint text. IPv6 is bracketed; a nonzero scope is
    ## decimal. A 58-byte buffer always suffices. The returned view borrows buffer,
    ## has no trailing NUL, and insufficient storage is left unchanged (io.full).
    pub func format(buffer: u8[]) -> str!:
        try self.validate()
        var text: u8[58]
        var used: usize = 0
        if self.ip.kind == IpVersion.ipv6:
            text[0] = '['
            let address = try self.ip.format(text[1..<40])
            used = 1 + address.length
            if self.scope_id != 0:
                text[used] = '%'
                used = render_endpoint_number(self.scope_id, text, used + 1)
            text[used] = ']'
            used += 1
        else:
            let address = try self.ip.format(text[..<39])
            used = address.length
        text[used] = ':'
        used = render_endpoint_number((u32)self.port, text, used + 1)
        if buffer.length < used:
            error(io.full, "the destination cannot hold the formatted socket address")
        memory.move(buffer, text, used)
        return (str)buffer[..<used]

    func validate() -> !:
        if self.ip.kind != IpVersion.ipv4 and self.ip.kind != IpVersion.ipv6:
            error(invalid_options, "unknown IP address version")
        if self.ip.kind == IpVersion.ipv4 and self.scope_id != 0:
            error(invalid_options, "IPv4 endpoints cannot have an interface scope")

    func write_native(output: NativeAddress*) -> u32!:
        try self.validate()
        if self.ip.kind == IpVersion.ipv4:
            let number = self.ip.ipv4_number() else error(invalid_options, "IPv4 address bits are missing")
            output.ipv4 = NativeIpv4Address(head = family_word(inet, 16), port = swap16(self.port), address = swap32(number))
            return 16
        output.ipv6 = NativeIpv6Address(head = family_word(inet6, 28), port = swap16(self.port), address = self.ip.octets, scope = self.scope_id)
        return 28

func decode_address(storage: const void*, length: u32) -> SocketAddress!:
    if length < 2:
        error(failed, "the socket address is shorter than its family field")
    let head = memory.read[u16](storage)
    let family = (i32)(head >> 8) if platform.macos else (i32)head
    if family == inet:
        if length < 16 or head != family_word(inet, 16):
            error(failed, "the IPv4 socket address has an invalid layout")
        let raw = memory.read[NativeIpv4Address](storage)
        return SocketAddress(ip = IpAddress.from_ipv4(swap32(raw.address)), port = swap16(raw.port))
    if family == inet6:
        if length < 28 or head != family_word(inet6, 28):
            error(failed, "the IPv6 socket address has an invalid layout")
        let raw = memory.read[NativeIpv6Address](storage)
        return SocketAddress(ip = IpAddress(kind = IpVersion.ipv6, octets = raw.address), port = swap16(raw.port), scope_id = raw.scope)
    error(failed, "the socket address is not IPv4 or IPv6")

func parse_endpoint_number(text: str, maximum: u32, width: usize) -> u32?:
    if text.length == 0 or text.length > width:
        return none
    var value: u32 = 0
    for byte in text.bytes:
        if byte < '0' or byte > '9':
            return none
        let digit = (u32)(byte - '0')
        if value > (maximum - digit) // 10:
            return none
        value = value * 10 + digit
    return value

func render_endpoint_number(value: u32, output: u8[], start: usize) -> usize:
    var reversed: u8[10]
    var count: usize = 0
    var remaining = value
    while true:
        reversed[count] = (u8)(remaining % 10) + '0'
        count += 1
        remaining //= 10
        if remaining == 0:
            break
    var used = start
    while count > 0:
        count -= 1
        output[used] = reversed[count]
        used += 1
    return used

## Host to network byte order and back; both native targets are little-endian.
func swap16(value: u16) -> u16:
    return (value << 8) | (value >> 8)

func swap32(value: u32) -> u32:
    return (value << 24) | ((value << 8) & 16711680) | ((value >> 8) & 65280) | (value >> 24)
## An owned collection of resolved endpoints. Values preserve host resolver order,
## including duplicates. Copying the collection does not duplicate ownership.
## The allocator used by resolve_all must outlive this collection.
pub struct ResolvedAddresses:
    var data: SocketAddress[]
    var owner: memory.Allocator?

    ## Borrow the endpoints until destroy. Individual SocketAddress values may be
    ## copied and retained independently. Zero and destroyed collections are empty.
    pub func view() -> const SocketAddress[]:
        return self.data

    ## Release through the original allocator, regardless of the current context.
    ## Repeated destruction is safe; previously borrowed views become invalid.
    pub mutating func destroy():
        if self.data.length > 0:
            let owner = self.owner else trap("resolved addresses lost their allocator")
            free(self.data) in owner
        var empty: SocketAddress[]
        self.data = empty
        self.owner = none

## The first usable IPv4 or IPv6 stream endpoint in host resolver order. An
## explicit version restricts results. Resolution can block in the OS. Every
## resolver node is released, including on malformed or unusable results.
pub func resolve(host: c.str, port: u16, version: IpVersion? = none) -> SocketAddress!:
    var query = try ResolverQuery.open(host, version)
    defer query.destroy()
    var current = query.head
    while let entry = current:
        if let address = resolved_endpoint(entry, port, query.family):
            return address
        current = entry.next
    error(unknown_host, "the host has no usable stream address for the requested IP version")

## All usable stream endpoints from one OS lookup, filtered by optional version.
## This blocks in the resolver and does not attempt connections or reorder results.
## No usable result reports unknown_host. Allocation failure releases the complete
## OS result; successful storage belongs to the returned collection's destroy.
pub func resolve_all(host: c.str, port: u16, version: IpVersion? = none) -> ResolvedAddresses!:
    var query = try ResolverQuery.open(host, version)
    defer query.destroy()
    # Count before allocating: the immutable resolver chain lets us allocate once
    # at its exact extent, without retaining OS pointers in the public result.
    var count: usize = 0
    var current = query.head
    while let entry = current:
        if resolved_endpoint(entry, port, query.family) != none:
            count = count +? 1 else error(memory.exhausted, "the resolver result is too large")
        current = entry.next
    if count == 0:
        error(unknown_host, "the host has no usable stream address for the requested IP version")
    let owner = memory.allocator
    let data = try alloc SocketAddress[count]
    var used: usize = 0
    current = query.head
    while let entry = current:
        if let address = resolved_endpoint(entry, port, query.family):
            data[used] = address
            used += 1
        current = entry.next
    return ResolvedAddresses(data = data, owner = owner)

## Keep libc ownership in one scope shared by both public resolution APIs.
struct ResolverQuery:
    var head: AddressInfo*?
    var family: i32

    static func open(host: c.str, version: IpVersion?) -> ResolverQuery!:
        var family: i32 = 0
        if let requested = version:
            if requested != IpVersion.ipv4 and requested != IpVersion.ipv6:
                error(invalid_options, "unknown resolver IP version")
            family = inet if requested == IpVersion.ipv4 else inet6
        var hints = AddressInfo(family = family, kind = stream)
        var found: AddressInfo*? = none
        if getaddrinfo(host, none, &hints, &found) != 0:
            error(unknown_host, "unknown host")
        let head = found else error(unknown_host, "unknown host")
        return ResolverQuery(head = head, family = family)

    mutating func destroy():
        if let head = self.head:
            self.head = none
            freeaddrinfo(head)

func resolved_endpoint(entry: const AddressInfo*, port: u16, family: i32) -> SocketAddress?:
    let known = entry.family == inet or entry.family == inet6
    if not known or entry.kind != stream or (family != 0 and entry.family != family):
        return none
    let raw = info_address(entry) else return none
    var address = decode_address(raw, entry.address_length) catch failure:
        discard(failure)
        return none
    let matches = (entry.family == inet and address.ip.kind == IpVersion.ipv4) or (entry.family == inet6 and address.ip.kind == IpVersion.ipv6)
    if not matches:
        return none
    address.port = port
    return address
## One owned TCP listener. Zero is closed. Copying does not duplicate ownership;
## copies must not be independently closed. Synchronize calls on one owner.
pub struct Listener:
    var socket: SocketHandle

    ## Bind and listen with a positive requested backlog. The OS may cap the
    ## pending connection queue; the value does not limit accepted connections.
    ## IPv6 listeners default to IPv6-only on both hosts. Set ipv6_only=false to
    ## also permit mapped IPv4 peers; the option has no effect for IPv4 listeners.
    pub static func bind(address: SocketAddress, backlog: i32 = 128, ipv6_only: bool = true) -> Listener!:
        if backlog <= 0:
            error(invalid_options, "the listener backlog must be positive")
        var raw: NativeAddress
        let length = try address.write_native(&raw)
        var owned = try SocketHandle.create(stream, address.ip.kind)
        errdefer owned.destroy()
        let fd = try owned.require()
        try set_socket_integer(fd, socket_level, reuse_address_option, 1)
        if address.ip.kind == IpVersion.ipv6:
            try set_socket_integer(fd, ipv6_level, ipv6_only_option, 1 if ipv6_only else 0)
        if bind(fd, &raw, length) != 0:
            error(failed, "the listener could not bind its address")
        var result = listen(fd, backlog)
        while result < 0 and c.errno() == c.interrupted:
            result = listen(fd, backlog)
        if result != 0:
            error(failed, "the listener could not begin listening")
        return Listener(socket = owned)

    ## Query the bound endpoint, including an automatically assigned port.
    pub func address() -> SocketAddress!:
        return try socket_address(try self.socket.require())

    ## Accept one connection, or io.would_block when a nonblocking listener has
    ## none pending. Accepted connections are blocking unless nonblocking=true,
    ## independently of the listener setting and host inheritance defaults.
    pub func accept(nonblocking: bool = false) -> Connection!:
        let descriptor = try self.socket.require()
        var fd = accept_socket(descriptor)
        while fd < 0 and c.errno() == c.interrupted:
            fd = accept_socket(descriptor)
        if fd < 0:
            error(transfer_error(c.errno()), "the listener could not accept a connection")
        var connection = try Connection.over(fd)
        errdefer connection.destroy()
        try connection.set_nonblocking(nonblocking)
        return connection

    ## Wait for advisory readiness without allocating. Expiration reports timed_out;
    ## cancellation reports cancelled. Use nonblocking I/O after readiness because
    ## another user can consume it. The socket remains borrowed and open.
    pub func wait(interest: WaitInterest = WaitInterest.read, deadline: Deadline = Deadline(), cancellation: Cancellation*? = none) -> Readiness!:
        return try wait_socket(try self.socket.require(), interest, deadline, cancellation)

    ## Change O_NONBLOCK without changing other status flags. Descriptor aliases
    ## share this setting; synchronize changes with all users of this socket.
    pub mutating func set_nonblocking(enabled: bool) -> !:
        try set_nonblocking(try self.socket.require(), enabled)

    pub func is_nonblocking() -> bool!:
        return (try socket_status_flags(try self.socket.require()) & nonblocking_flag) != 0

    ## Request kernel buffering in bytes, not a guaranteed transfer size. The OS
    ## may cap or round the request; receive_buffer returns its reported setting.
    pub mutating func set_receive_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), receive_buffer_option, bytes)

    pub func receive_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, receive_buffer_option)

    ## Request kernel buffering in bytes. Linux reports a doubled bookkeeping
    ## size; both hosts may adjust the request. This does not change user buffers.
    pub mutating func set_send_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), send_buffer_option, bytes)

    pub func send_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, send_buffer_option)

    ## Borrow the descriptor; the caller must not close it or retain it past this owner.
    pub func descriptor() -> i32?:
        return self.socket.value

    ## Consume ownership before the OS call. Repeated close is safe even after failure.
    pub mutating func close() -> !:
        try self.socket.close()

    ## Best-effort cleanup for unwinding; use close to observe delayed errors.
    pub mutating func destroy():
        self.socket.destroy()

func accept_socket(descriptor: i32) -> i32:
    if platform.macos:
        return accept(descriptor, none, none)
    return accept4(descriptor, none, none, socket_close_on_exec)
## Which direction to stop using on a connection. This does not close its owner.
pub enum ShutdownDirection as u8:
    read = 0
    write = 1
    both = 2

## One owned TCP connection implementing borrowed Reader and Writer interfaces.
## Zero is closed. Copying does not duplicate ownership; copies must not be
## independently closed. Synchronize calls on one owner.
pub struct Connection: Reader, Writer:
    var socket: SocketHandle
    ## Whether the socket is marked against `SIGPIPE` (macOS); `write` marks it on first
    ## use, so a connection built any other way than `over` is guarded too.
    var guarded: bool

    ## Establish a TCP connection with an optional absolute deadline/cancellation.
    ## Connection setup is nonblocking internally; the returned socket is blocking
    ## unless nonblocking=true. Failure closes the newly acquired descriptor. DNS
    ## resolution is separate and is not covered by this connection deadline.
    pub static func connect(address: SocketAddress, deadline: Deadline = Deadline(), cancellation: Cancellation*? = none, nonblocking: bool = false) -> Connection!:
        try check_operation(deadline, cancellation)
        var raw: NativeAddress
        let length = try address.write_native(&raw)
        var owned = try SocketHandle.create(stream, address.ip.kind)
        errdefer owned.destroy()
        let fd = try owned.require()
        if address.ip.kind == IpVersion.ipv6:
            try set_socket_integer(fd, ipv6_level, ipv6_only_option, 0)
        try set_nonblocking(fd, true)
        if connect(fd, &raw, length) != 0:
            let number = c.errno()
            let in_progress = 36 if platform.macos else 115
            let already_pending = 37 if platform.macos else 114
            if number != in_progress and number != already_pending and number != c.interrupted:
                error(transfer_error(number), "the connection could not reach its peer")
            discard(try wait_socket(fd, WaitInterest.write, deadline, cancellation))
            try check_operation(deadline, cancellation)
            let pending_error = try get_socket_integer(fd, socket_level, 4103 if platform.macos else 4)
            if pending_error != 0:
                error(transfer_error(pending_error), "the pending connection failed")
        try check_operation(deadline, cancellation)
        try set_nonblocking(fd, nonblocking)
        return Connection.from_socket(owned)

    ## Take ownership of a socket the caller made (a `socketpair`, an inherited
    ## descriptor), including on failure. Set close-on-exec, preserving existing
    ## flags; this is not atomic with the caller's creation/fork/exec operations.
    ## A negative descriptor is rejected. The socket is marked so that a write after the peer closed fails
    ## instead of ending the process. Make the connection while the peer is still there:
    ## macOS refuses the mark on a socket whose peer has already gone, and a write on
    ## such a connection answers `closed` without sending.
    pub static func over(descriptor: i32) -> Connection!:
        return Connection.from_socket(try SocketHandle.adopt(descriptor))

    static func from_socket(owned: SocketHandle) -> Connection:
        var connection = Connection(socket = owned, guarded = false)
        discard(connection.guard())
        return connection

    ## Query this connection's local IP endpoint, including its assigned port.
    pub func local_address() -> SocketAddress!:
        return try socket_address(try self.socket.require())

    ## Query the connected peer's IP endpoint; this is an address, not an identity.
    pub func peer_address() -> SocketAddress!:
        return try socket_address(try self.socket.require(), true)

    ## Stop one or both directions while retaining ownership. Shutting down writes
    ## sends EOF after queued TCP bytes, so the peer can still send its response.
    ## Use read shutdown only when input is no longer needed; treatment of queued
    ## input follows the host. Neither direction flushes user buffers; flush any
    ## io.BufferedWriter before shutting down writes.
    pub mutating func shutdown(direction: ShutdownDirection = ShutdownDirection.both) -> !:
        let descriptor = try self.socket.require()
        if direction != ShutdownDirection.read and direction != ShutdownDirection.write and direction != ShutdownDirection.both:
            error(invalid_options, "unknown socket shutdown direction")
        var result = shutdown(descriptor, (i32)direction)
        while result < 0 and c.errno() == c.interrupted:
            result = shutdown(descriptor, (i32)direction)
        if result != 0:
            error(transfer_error(c.errno()), "the connection could not be shut down")

    ## Whether a write cannot raise `SIGPIPE`. Linux asks with every `send`
    ## (`MSG_NOSIGNAL`); macOS marks the socket once (`SO_NOSIGPIPE`), and refuses the mark
    ## with `EINVAL` on a socket whose peer has disconnected.
    mutating func guard() -> bool:
        let descriptor = self.socket.value else return false
        if self.guarded:
            return true
        if not platform.macos:
            self.guarded = true
            return true
        var yes: i32 = 1
        var result = setsockopt(descriptor, socket_level, no_sigpipe_option, &yes, 4)
        while result < 0 and c.errno() == c.interrupted:
            result = setsockopt(descriptor, socket_level, no_sigpipe_option, &yes, 4)
        if result == 0:
            self.guarded = true
        return self.guarded

    ## Send some bytes, retrying interruption. Use io.write_all for a complete
    ## payload and its optional progress output to resume after a later failure.
    ## An empty input makes no syscall. A closed peer never raises SIGPIPE.
    pub mutating func write(data: const u8[]) -> usize!:
        let descriptor = try self.socket.require()
        if data.length == 0:
            return 0
        if not self.guard():
            error(closed, "the connection closed")
        let count = data.length if data.length < transfer_limit else transfer_limit
        var sent = send(descriptor, data.data, count, send_flags)
        while sent < 0 and c.errno() == c.interrupted:
            sent = send(descriptor, data.data, count, send_flags)
        if sent < 0:
            error(transfer_error(c.errno()), "the connection could not send data")
        if sent == 0:
            error(io.no_progress, "the connection made no write progress")
        return (usize)sent

    ## Receive some bytes. For nonempty storage, zero is peer EOF; empty storage
    ## returns zero without probing the peer. This call does not fill the buffer.
    pub mutating func read(buffer: u8[]) -> usize!:
        return try self.receive(buffer)

    ## Compatibility spelling of read; shares its short-read and EOF contract.
    pub func receive(buffer: u8[]) -> usize!:
        let descriptor = try self.socket.require()
        if buffer.length == 0:
            return 0
        let count = buffer.length if buffer.length < transfer_limit else transfer_limit
        var received = recv(descriptor, buffer.data, count, 0)
        while received < 0 and c.errno() == c.interrupted:
            received = recv(descriptor, buffer.data, count, 0)
        if received < 0:
            error(transfer_error(c.errno()), "the connection could not receive data")
        return (usize)received

    ## Disable Nagle coalescing when enabled. This is a latency policy, not a
    ## delivery guarantee; writes may still be buffered by the OS or network.
    pub mutating func set_no_delay(enabled: bool) -> !:
        try set_socket_integer(try self.socket.require(), 6, 1, 1 if enabled else 0)

    pub func no_delay() -> bool!:
        return try get_socket_integer(try self.socket.require(), 6, 1) != 0

    ## Enable OS TCP keepalive probes. Timing and retry defaults remain host
    ## policy; keepalive does not provide an application operation deadline.
    pub mutating func set_keepalive(enabled: bool) -> !:
        try set_socket_integer(try self.socket.require(), socket_level, keepalive_option, 1 if enabled else 0)

    pub func keepalive() -> bool!:
        return try get_socket_integer(try self.socket.require(), socket_level, keepalive_option) != 0

    ## Wait for advisory readiness without allocating. Expiration reports timed_out;
    ## cancellation reports cancelled. Use nonblocking I/O after readiness because
    ## another user can consume it. The socket remains borrowed and open.
    pub func wait(interest: WaitInterest = WaitInterest.read, deadline: Deadline = Deadline(), cancellation: Cancellation*? = none) -> Readiness!:
        return try wait_socket(try self.socket.require(), interest, deadline, cancellation)

    ## Change O_NONBLOCK without changing other status flags. Descriptor aliases
    ## share this setting; synchronize changes with all users of this socket.
    pub mutating func set_nonblocking(enabled: bool) -> !:
        try set_nonblocking(try self.socket.require(), enabled)

    pub func is_nonblocking() -> bool!:
        return (try socket_status_flags(try self.socket.require()) & nonblocking_flag) != 0

    ## Request kernel buffering in bytes, not a guaranteed transfer size. The OS
    ## may cap or round the request; receive_buffer returns its reported setting.
    pub mutating func set_receive_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), receive_buffer_option, bytes)

    pub func receive_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, receive_buffer_option)

    ## Request kernel buffering in bytes. Linux reports a doubled bookkeeping
    ## size; both hosts may adjust the request. This does not change user buffers.
    pub mutating func set_send_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), send_buffer_option, bytes)

    pub func send_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, send_buffer_option)

    ## Borrow the descriptor; the caller must not close it or retain it past this owner.
    pub func descriptor() -> i32?:
        return self.socket.value

    ## Consume ownership before the OS call. Repeated close is safe even after failure.
    pub mutating func close() -> !:
        try self.socket.close()

    ## Best-effort cleanup for unwinding; use close to observe delayed errors.
    pub mutating func destroy():
        self.socket.destroy()
## One owned UDP socket. Zero is closed. Copying does not duplicate ownership;
## copies must not be independently closed. Synchronize calls on one owner.
pub struct Datagram:
    var socket: SocketHandle
    var version: IpVersion

    ## IPv6 sockets are IPv6-only by default. Set ipv6_only=false to permit
    ## mapped IPv4 packets; it has no effect when binding an IPv4 address.
    pub static func bind(address: SocketAddress, ipv6_only: bool = true) -> Datagram!:
        var raw: NativeAddress
        let length = try address.write_native(&raw)
        var owned = try SocketHandle.create(datagram, address.ip.kind)
        errdefer owned.destroy()
        let fd = try owned.require()
        if address.ip.kind == IpVersion.ipv6:
            try set_socket_integer(fd, ipv6_level, ipv6_only_option, 1 if ipv6_only else 0)
        if bind(fd, &raw, length) != 0:
            error(failed, "the datagram socket could not bind its address")
        return Datagram(socket = owned, version = address.ip.kind)

    ## Query the bound endpoint, including an automatically assigned port.
    pub func address() -> SocketAddress!:
        return try socket_address(try self.socket.require())

    ## Send one complete IP datagram, including an empty packet. A successful
    ## send confirms local acceptance, not peer delivery. IPv4 permits up to 65507
    ## payload bytes, IPv6 up to 65527; host/path limits may be smaller. IPv6
    ## jumbograms are not supported. The destination must match the socket version.
    pub func send_to(data: const u8[], address: SocketAddress) -> !:
        let descriptor = try self.socket.require()
        if address.ip.kind != self.version:
            error(invalid_options, "the datagram destination has a different IP version")
        let maximum: usize = 65507 if self.version == IpVersion.ipv4 else 65527
        if data.length > maximum:
            error(message_too_large, "the UDP payload exceeds the IP version's maximum")
        var raw: NativeAddress
        let length = try address.write_native(&raw)
        var n = sendto(descriptor, data.data, data.length, 0, &raw, length)
        while n < 0 and c.errno() == c.interrupted:
            n = sendto(descriptor, data.data, data.length, 0, &raw, length)
        if n < 0:
            error(datagram_error(c.errno()), "the datagram could not be sent")
        if (usize)n != data.length:
            error(failed, "the datagram send did not confirm the complete packet")

    ## Consume one packet. Zero means a valid empty datagram, not stream EOF.
    ## If storage is too small, consume/discard the packet and report
    ## message_too_large; a copied prefix may remain in the buffer. The next call
    ## receives the next packet. Empty storage can receive only an empty packet.
    pub func receive_from(buffer: u8[]) -> (usize, SocketAddress)!:
        let descriptor = try self.socket.require()
        var raw: NativeAddress
        # macOS can return immediately without consuming a packet when receive
        # capacity is zero. Probe into one scratch byte so even empty storage
        # consumes exactly one packet and obtains its sender address.
        var scratch: u8[1]
        var vector = ReceiveVector(data = buffer.data, length = buffer.length)
        if buffer.length == 0:
            vector = ReceiveVector(data = &scratch[0], length = 1)
        while true:
            var received: isize = 0
            var address_length: u32 = 0
            var flags: i32 = 0
            if platform.macos:
                var message = MacMessage(address = &raw, address_length = 28, vectors = &vector, vector_count = 1)
                received = receive_message_macos(descriptor, &message, 0)
                address_length = message.address_length
                flags = message.flags
            else:
                var message = LinuxMessage(address = &raw, address_length = 28, vectors = &vector, vector_count = 1)
                received = receive_message_linux(descriptor, &message, 0)
                address_length = message.address_length
                flags = message.flags
            if received < 0:
                let number = c.errno()
                if number == c.interrupted:
                    continue
                error(datagram_error(number), "the datagram could not be received")
            let truncated: i32 = 16 if platform.macos else 32
            if (flags & truncated) != 0 or (usize)received > buffer.length:
                error(message_too_large, "the receive buffer was too small for the datagram")
            if address_length > 28:
                error(failed, "the datagram sender address exceeds the supported storage")
            return ((usize)received, try decode_address(&raw, address_length))

    ## Wait for advisory readiness without allocating. Expiration reports timed_out;
    ## cancellation reports cancelled. Use nonblocking I/O after readiness because
    ## another user can consume it. The socket remains borrowed and open.
    pub func wait(interest: WaitInterest = WaitInterest.read, deadline: Deadline = Deadline(), cancellation: Cancellation*? = none) -> Readiness!:
        return try wait_socket(try self.socket.require(), interest, deadline, cancellation)

    ## Change O_NONBLOCK without changing other status flags. Descriptor aliases
    ## share this setting; synchronize changes with all users of this socket.
    pub mutating func set_nonblocking(enabled: bool) -> !:
        try set_nonblocking(try self.socket.require(), enabled)

    pub func is_nonblocking() -> bool!:
        return (try socket_status_flags(try self.socket.require()) & nonblocking_flag) != 0

    ## Request kernel buffering in bytes, not a guaranteed transfer size. The OS
    ## may cap or round the request; receive_buffer returns its reported setting.
    pub mutating func set_receive_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), receive_buffer_option, bytes)

    pub func receive_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, receive_buffer_option)

    ## Request kernel buffering in bytes. Linux reports a doubled bookkeeping
    ## size; both hosts may adjust the request. This does not change user buffers.
    pub mutating func set_send_buffer(bytes: i32) -> !:
        try set_socket_buffer(try self.socket.require(), send_buffer_option, bytes)

    pub func send_buffer() -> i32!:
        return try get_socket_integer(try self.socket.require(), socket_level, send_buffer_option)

    ## Borrow the descriptor; the caller must not close it or retain it past this owner.
    pub func descriptor() -> i32?:
        return self.socket.value

    ## Consume ownership before the OS call. Repeated close is safe even after failure.
    pub mutating func close() -> !:
        try self.socket.close()

    ## Best-effort cleanup for unwinding; use close to observe delayed errors.
    pub mutating func destroy():
        self.socket.destroy()

func datagram_error(number: i32) -> ErrorCode:
    if number == (40 if platform.macos else 90):
        return message_too_large
    return transfer_error(number)
## Bound individual transfers below both supported hosts' signed syscall limits.
let transfer_limit: usize = 1073741824

func transfer_error(number: i32) -> ErrorCode:
    if number == (35 if platform.macos else 11):
        return io.would_block
    if number == 9 or number == 32 or number == (54 if platform.macos else 104) or number == (57 if platform.macos else 107):
        return closed
    return failed

## Shared ownership state for all socket kinds. Consume before close because an
## interrupted or failed close may already have released the descriptor for reuse.
struct SocketHandle:
    var value: i32?

    ## Linux sets close-on-exec atomically with creation. macOS requires a
    ## separate fcntl call; callers must serialize concurrent fork/exec there.
    static func create(kind: i32, version: IpVersion) -> SocketHandle!:
        let flags: i32 = 0 if platform.macos else socket_close_on_exec
        let family = inet if version == IpVersion.ipv4 else inet6
        let descriptor = socket(family, kind | flags, 0)
        if descriptor < 0:
            error(failed, "a socket could not be created")
        if platform.macos:
            return try SocketHandle.adopt(descriptor)
        return SocketHandle(value = descriptor)

    ## Ownership transfers on entry, including failure. Preserve existing
    ## descriptor flags and close once if setting close-on-exec fails.
    static func adopt(descriptor: i32) -> SocketHandle!:
        if descriptor < 0:
            error(closed, "the socket descriptor is invalid")
        var flags = fcntl(descriptor, get_descriptor_flags)
        while flags < 0 and c.errno() == c.interrupted:
            flags = fcntl(descriptor, get_descriptor_flags)
        if flags < 0:
            discard(close(descriptor))
            error(failed, "socket descriptor flags could not be queried")
        if (flags & descriptor_close_on_exec) == 0:
            var result = fcntl(descriptor, set_descriptor_flags, flags | descriptor_close_on_exec)
            while result < 0 and c.errno() == c.interrupted:
                result = fcntl(descriptor, set_descriptor_flags, flags | descriptor_close_on_exec)
            if result < 0:
                discard(close(descriptor))
                error(failed, "the socket could not be marked close-on-exec")
        return SocketHandle(value = descriptor)

    func require() -> i32!:
        let descriptor = self.value else error(closed, "the socket is closed")
        return descriptor

    mutating func close() -> !:
        let descriptor = self.value else return
        self.value = none
        if close(descriptor) != 0:
            error(failed, "the socket could not be closed")

    mutating func destroy():
        self.close() catch failure:
            discard(failure)

func socket_address(descriptor: i32, peer: bool = false) -> SocketAddress!:
    var raw: NativeAddress
    var length: u32 = 28
    var result = query_address(descriptor, &raw, &length, peer)
    while result < 0 and c.errno() == c.interrupted:
        length = 28
        result = query_address(descriptor, &raw, &length, peer)
    if result != 0:
        error(failed, "the socket address could not be queried")
    if length > 28:
        error(failed, "the socket address exceeds the supported IP storage")
    return try decode_address(&raw, length)

func query_address(descriptor: i32, address: void*, length: u32*, peer: bool) -> i32:
    if peer:
        return getpeername(descriptor, address, length)
    return getsockname(descriptor, address, length)

func set_socket_integer(descriptor: i32, level: i32, option: i32, value: i32) -> !:
    var result = setsockopt(descriptor, level, option, &value, 4)
    while result < 0 and c.errno() == c.interrupted:
        result = setsockopt(descriptor, level, option, &value, 4)
    if result != 0:
        error(failed, "the socket option could not be set")
## Host option numbers stay private; public methods expose typed policies.
let nonblocking_flag: i32 = 4 if platform.macos else 2048
let receive_buffer_option: i32 = 4098 if platform.macos else 8
let send_buffer_option: i32 = 4097 if platform.macos else 7
let keepalive_option: i32 = 8 if platform.macos else 9

func socket_status_flags(descriptor: i32) -> i32!:
    var flags = fcntl(descriptor, 3)
    while flags < 0 and c.errno() == c.interrupted:
        flags = fcntl(descriptor, 3)
    if flags < 0:
        error(transfer_error(c.errno()), "socket status flags could not be queried")
    return flags

func set_nonblocking(descriptor: i32, enabled: bool) -> !:
    let before = try socket_status_flags(descriptor)
    let after = before | nonblocking_flag if enabled else before & ~nonblocking_flag
    if after == before:
        return
    var result = fcntl(descriptor, 4, after)
    while result < 0 and c.errno() == c.interrupted:
        result = fcntl(descriptor, 4, after)
    if result < 0:
        error(transfer_error(c.errno()), "socket nonblocking mode could not be changed")

func get_socket_integer(descriptor: i32, level: i32, option: i32) -> i32!:
    var value: i32 = 0
    var length: u32 = 4
    var result = getsockopt(descriptor, level, option, &value, &length)
    while result < 0 and c.errno() == c.interrupted:
        length = 4
        result = getsockopt(descriptor, level, option, &value, &length)
    if result != 0 or length != 4:
        error(failed, "the socket option could not be queried")
    return value

func set_socket_buffer(descriptor: i32, option: i32, bytes: i32) -> !:
    if bytes <= 0:
        error(invalid_options, "a socket buffer size must be positive")
    try set_socket_integer(descriptor, socket_level, option, bytes)
## Readiness uses poll on both hosts. Keep its ABI private and distinct from the
## public interests/results, so host event bits never leak into application code.
extern struct NativePoll:
    descriptor: i32
    events: i16
    returned: i16

extern struct MonotonicStamp:
    seconds: i64
    nanoseconds: i64

extern func poll_macos as "poll"(entries: NativePoll*, count: u32, timeout: i32) -> i32
extern func poll_linux as "poll"(entries: NativePoll*, count: usize, timeout: i32) -> i32
extern func read_monotonic as "clock_gettime"(clock: i32, stamp: MonotonicStamp*) -> i32

## A monotonic absolute deadline. Zero has no time limit. Reuse the same value
## across retries and partial transfers so interruptions cannot restart a timeout.
pub struct Deadline:
    var instant: u64?

    ## Expire this many nanoseconds from now. Zero is an immediate check. A delay
    ## that exceeds the clock's representable range reports invalid_options.
    pub static func after(nanoseconds: u64) -> Deadline!:
        let current = try monotonic_nanoseconds()
        let end = current +? nanoseconds else error(invalid_options, "the deadline exceeds the monotonic clock range")
        return Deadline(instant = end)

    ## Use an absolute nanosecond instant from the same monotonic origin as time.now.
    pub static func at(nanoseconds: u64) -> Deadline:
        return Deadline(instant = nanoseconds)

## A one-way cancellation signal shared by reference. Zero is not requested.
## Keep this object alive until every waiting thread returns; do not copy or reset
## it while shared. Requests use release/acquire synchronization.
pub struct Cancellation:
    var requested: @u32

    pub mutating func request():
        self.requested.store(1, .release)

    pub func is_requested() -> bool:
        return self.requested.load(.acquire) != 0

pub enum WaitInterest as u8:
    read = 0
    write = 1
    both = 2

## Events are advisory: another user may consume readiness before the next call.
## Use nonblocking I/O and handle io.would_block. Hangup can coexist with queued
## readable bytes; read until EOF rather than discarding data on this flag alone.
pub struct Readiness:
    pub var readable: bool
    pub var writable: bool
    pub var hangup: bool
    pub var failure: bool
    pub var invalid: bool

## Reusable storage for a fixed number of borrowed descriptors. All slots begin
## disabled; watch/disable mutate slots without allocation. Copying does not
## duplicate ownership. The retained allocator must outlive this object.
## Synchronize all operations; watched descriptors must stay open during wait.
pub struct Poller:
    var entries: NativePoll[]
    var owner: memory.Allocator?

    pub static func create(capacity: usize) -> Poller!:
        if capacity == 0 or capacity > 2147483647:
            error(invalid_options, "poller capacity must be between one and i32 maximum")
        let entries = try alloc NativePoll[capacity]
        var index: usize = 0
        while index < capacity:
            entries[index] = NativePoll(descriptor = -1)
            index += 1
        return Poller(entries = entries, owner = memory.allocator)

    pub func capacity() -> usize:
        return self.entries.length

    ## Watch a nonnegative borrowed descriptor. A descriptor may occupy only one
    ## slot: host poll implementations differ on duplicate entries. Use both for
    ## combined read/write interest. Replacing a slot clears its events.
    pub mutating func watch(index: usize, descriptor: i32, interest: WaitInterest = WaitInterest.read) -> !:
        try self.check_slot(index)
        if descriptor < 0:
            error(invalid_options, "a watched descriptor must be nonnegative")
        let events = try poll_interest(interest)
        var other: usize = 0
        while other < self.entries.length:
            if other != index and self.entries[other].descriptor == descriptor:
                error(invalid_options, "the descriptor already occupies another poller slot")
            other += 1
        self.entries[index] = NativePoll(descriptor = descriptor, events = events)

    pub mutating func disable(index: usize) -> !:
        try self.check_slot(index)
        self.entries[index] = NativePoll(descriptor = -1)

    ## Wait for ready slots, returning their count or zero on deadline expiration.
    ## No allocation occurs. Empty interest sets may be used as a timed sleep.
    ## Cancellation reports cancelled; it is checked before and after each poll.
    ## With cancellation supplied, kernel waits are capped at 10 ms between checks;
    ## scheduling can delay return. A simultaneous observed cancellation wins over
    ## readiness. Expired deadlines still perform one nonblocking readiness check.
    ## Interrupted calls recompute the remaining deadline. Output events are cleared
    ## on entry and on error. This does not make later I/O obey the deadline itself.
    pub mutating func wait(deadline: Deadline = Deadline(), cancellation: Cancellation*? = none) -> usize!:
        if self.entries.length == 0:
            error(closed, "the poller is closed")
        return try wait_poll(self.entries, deadline, cancellation)

    ## Borrow a copy of the most recent wait's events for this slot. Disabled slots
    ## have no events. Invalid descriptors are reported per slot, not silently closed.
    pub func readiness(index: usize) -> Readiness!:
        try self.check_slot(index)
        return poll_readiness(self.entries[index].returned)

    pub mutating func destroy():
        if self.entries.length > 0:
            let owner = self.owner else trap("the poller lost its allocator")
            free(self.entries) in owner
        var empty: NativePoll[]
        self.entries = empty
        self.owner = none

    func check_slot(index: usize) -> !:
        if self.entries.length == 0:
            error(closed, "the poller is closed")
        if index >= self.entries.length:
            error(invalid_options, "the poller slot is outside its capacity")

func poll_interest(interest: WaitInterest) -> i16!:
    if interest == WaitInterest.read:
        return 1
    if interest == WaitInterest.write:
        return 4
    if interest == WaitInterest.both:
        return 5
    error(invalid_options, "unknown readiness interest")

func poll_readiness(events: i16) -> Readiness:
    return Readiness(readable = (events & 1) != 0, writable = (events & 4) != 0, hangup = (events & 16) != 0, failure = (events & 8) != 0, invalid = (events & 32) != 0)

func clear_poll(entries: NativePoll[]):
    var index: usize = 0
    while index < entries.length:
        entries[index].returned = 0
        index += 1

func check_cancellation(cancellation: Cancellation*?) -> !:
    if let signal = cancellation:
        if signal.is_requested():
            error(cancelled, "the readiness wait was cancelled")

func wait_poll(entries: NativePoll[], deadline: Deadline, cancellation: Cancellation*?) -> usize!:
    clear_poll(entries)
    errdefer clear_poll(entries)
    while true:
        try check_cancellation(cancellation)
        var milliseconds: i32 = -1
        if let end = deadline.instant:
            let current = try monotonic_nanoseconds()
            let remaining = end - current if end > current else 0
            # Round up without adding to the possibly maximal nanosecond count.
            let rounded = remaining // 1000000 + (1 if remaining % 1000000 != 0 else 0)
            milliseconds = (i32)rounded if rounded < 2147483647 else 2147483647
        if cancellation != none and (milliseconds < 0 or milliseconds > 10):
            milliseconds = 10
        clear_poll(entries)
        let result = poll_macos(entries.data, (u32)entries.length, milliseconds) if platform.macos else poll_linux(entries.data, entries.length, milliseconds)
        try check_cancellation(cancellation)
        if result < 0:
            if c.errno() == c.interrupted:
                continue
            error(failed, "the readiness wait failed")
        if result > 0:
            return (usize)result
        if let end = deadline.instant:
            if (try monotonic_nanoseconds()) >= end:
                return 0

func wait_socket(descriptor: i32, interest: WaitInterest, deadline: Deadline, cancellation: Cancellation*?) -> Readiness!:
    var entry: NativePoll[1]
    entry[0] = NativePoll(descriptor = descriptor, events = try poll_interest(interest))
    if (try wait_poll(entry, deadline, cancellation)) == 0:
        error(timed_out, "the socket readiness deadline expired")
    let ready = poll_readiness(entry[0].returned)
    if ready.invalid:
        error(closed, "the socket descriptor is no longer open")
    return ready

func monotonic_nanoseconds() -> u64!:
    var stamp: MonotonicStamp
    if read_monotonic(6 if platform.macos else 1, &stamp) != 0:
        error(failed, "the monotonic clock could not be read")
    if stamp.seconds < 0 or stamp.nanoseconds < 0 or stamp.nanoseconds >= 1000000000:
        error(failed, "the monotonic clock returned an invalid timestamp")
    let seconds = (u64)stamp.seconds *? 1000000000 else error(failed, "the monotonic clock exceeds its range")
    return seconds +? (u64)stamp.nanoseconds else error(failed, "the monotonic clock exceeds its range")

## Actual operations check before each attempt, unlike a readiness-only zero-time
## probe. A continuously ready socket must not defeat a transfer's total deadline.
func check_operation(deadline: Deadline, cancellation: Cancellation*?) -> !:
    try check_cancellation(cancellation)
    if let end = deadline.instant:
        if (try monotonic_nanoseconds()) >= end:
            error(timed_out, "the operation deadline expired")
## A borrowed Reader/Writer applying one absolute deadline to all its transfers.
## Use with io.read_exact, io.write_all or buffered adapters; confirmed progress
## remains available from those helpers when a later call times out or is cancelled.
## This adapter allocates nothing and never owns/closes the connection. Keep the
## connection and optional cancellation signal alive, and synchronize their use.
## The connection must remain nonblocking. This is checked when creating the view
## and before nonempty transfers; coordinate all descriptor aliases. macOS can
## block sends despite MSG_DONTWAIT alone. The adapter never changes socket flags.
## Copying this view preserves the same deadline; it does not restart a timeout.
pub struct DeadlineStream: Reader, Writer:
    var connection: Connection*?
    var deadline: Deadline
    var cancellation: Cancellation*?

    pub static func over(connection: Connection*, deadline: Deadline = Deadline(), cancellation: Cancellation*? = none) -> DeadlineStream!:
        try require_nonblocking(try connection.socket.require())
        return DeadlineStream(connection = connection, deadline = deadline, cancellation = cancellation)

    ## Read some bytes, waiting only when no data is ready. Zero on a nonempty
    ## buffer is EOF. Empty input succeeds on an open connection even after its
    ## deadline or cancellation, because it performs no transfer. The connection
    ## must remain nonblocking; the adapter never changes its shared status flags.
    pub mutating func read(buffer: u8[]) -> usize!:
        let connection = self.connection else error(closed, "the deadline stream has no connection")
        let descriptor = try connection.socket.require()
        if buffer.length == 0:
            return 0
        try require_nonblocking(descriptor)
        let count = buffer.length if buffer.length < transfer_limit else transfer_limit
        while true:
            try check_operation(self.deadline, self.cancellation)
            let received = recv(descriptor, buffer.data, count, dont_wait_flag)
            if received >= 0:
                return (usize)received
            try await_transfer_retry(descriptor, WaitInterest.read, c.errno(), self.deadline, self.cancellation)

    ## Write some bytes, waiting only when kernel buffers are full. Each successful
    ## count is confirmed before checking the next attempt's deadline/cancellation;
    ## do not discard it when a later transfer fails. Empty writes make no syscall.
    pub mutating func write(data: const u8[]) -> usize!:
        let connection = self.connection else error(closed, "the deadline stream has no connection")
        let descriptor = try connection.socket.require()
        if data.length == 0:
            return 0
        try require_nonblocking(descriptor)
        try check_operation(self.deadline, self.cancellation)
        if not connection.guard():
            error(closed, "the connection closed")
        let count = data.length if data.length < transfer_limit else transfer_limit
        while true:
            try check_operation(self.deadline, self.cancellation)
            let sent = send(descriptor, data.data, count, send_flags | dont_wait_flag)
            if sent > 0:
                return (usize)sent
            if sent == 0:
                error(io.no_progress, "the connection made no write progress")
            try await_transfer_retry(descriptor, WaitInterest.write, c.errno(), self.deadline, self.cancellation)

let dont_wait_flag: i32 = 128 if platform.macos else 64

func await_transfer_retry(descriptor: i32, interest: WaitInterest, number: i32, deadline: Deadline, cancellation: Cancellation*?) -> !:
    if number == c.interrupted:
        return
    let code = transfer_error(number)
    if code != io.would_block:
        error(code, "the deadline stream transfer failed")
    discard(try wait_socket(descriptor, interest, deadline, cancellation))

func require_nonblocking(descriptor: i32) -> !:
    if ((try socket_status_flags(descriptor)) & nonblocking_flag) == 0:
        error(invalid_options, "a deadline stream requires a nonblocking connection")
"""),
    Prelude(name = "debug", text = """
import c
import memory

extern func getenv(name: c.str) -> c.str?
extern func c_read as "read"(descriptor: i32, buffer: void*, count: usize) -> isize
extern func c_exit as "exit"(code: i32) -> never

## A frame as the compiler described it under `--debug`: the function's name and
## source, then `count` locals laid out after it.
extern struct Shape:
    name: str
    source: str
    count: u64

extern struct Local:
    name: str
    kind: str
    offset: u64
    size: u64

struct Activation:
    var shape: Shape*?
    var frame: void*?
    var line: u32

struct Break:
    var file: str
    var line: u32

var activations: Activation[512]
var depth: usize
var checked: bool
var active: bool
var started: bool
var stepping: bool
var step_over: usize
var breaks: Break[32]
var break_count: usize
var names: u8[4096]
var names_used: usize
var line_bytes: u8[512]

## Called at every function entry and exit of a `--debug` build.
pub func enter(shape: void*):
    if depth < activations.length:
        activations[depth] = Activation(shape = (Shape*)shape, frame = none, line = 0)
    depth += 1

pub func leave():
    if depth > 0:
        depth -= 1

## Called before every statement: stop when a breakpoint, a step, or the start asks.
pub func at(shape: void*, line: u32, frame: void*):
    if not checked:
        checked = true
        active = getenv("LUCE_DEBUG") != none
    if not active or depth == 0 or depth > activations.length:
        return
    let top = depth - 1
    let s = (Shape*)shape
    activations[top] = Activation(shape = s, frame = frame, line = line)
    var stop = false
    if not started:
        started = true
        stop = true
    elif stepping:
        stop = true
    elif step_over > 0 and depth <= step_over:
        stop = true
    elif hits(s.source, line):
        stop = true
    if not stop:
        return
    stepping = false
    step_over = 0
    print(f"stopped at {s.source}:{line} in {s.name}")
    prompt(top)

func hits(file: str, line: u32) -> bool:
    var i: usize = 0
    while i < break_count:
        let b = breaks[i]
        if b.line == line and (b.file == file or ends_with(file, b.file)):
            return true
        i += 1
    return false

func ends_with(text: str, suffix: str) -> bool:
    if suffix.length > text.length:
        return false
    return (str)text.bytes[text.length - suffix.length..] == suffix

## Read commands until one lets the program run.
func prompt(top: usize):
    while true:
        let line = read_line() else return
        let command = first_word(line)
        let rest = trim((str)line.bytes[command.length..])
        if command == "r" or command == "run" or command == "c" or command == "continue":
            return
        if command == "s" or command == "step":
            stepping = true
            return
        if command == "n" or command == "next":
            step_over = depth
            return
        if command == "q" or command == "quit":
            print("quit")
            c_exit(0)
        if command == "b" or command == "break":
            add_break(rest)
        elif command == "p" or command == "print":
            show_named(top, rest)
        elif command == "locals":
            show_all(top)
        elif command == "bt" or command == "backtrace":
            backtrace()
        elif command.length == 0:
            continue
        else:
            print(f"unknown command `{command}`; commands: break FILE:LINE, run, step, next, print NAME, locals, backtrace, quit")

func add_break(spec: str):
    var colon: usize = spec.length
    var i = spec.length
    while i > 0:
        i -= 1
        if spec.bytes[i] == ':':
            colon = i
            break
    if colon == spec.length:
        print("break needs FILE:LINE")
        return
    let file = (str)spec.bytes[..<colon]
    let number = parse_line((str)spec.bytes[colon + 1..])
    if number == 0 or break_count == breaks.length or names_used + file.length > names.length:
        print("cannot set that breakpoint")
        return
    memory.copy(names[names_used..], file.bytes, file.length)
    let kept = (str)names[names_used..<names_used + file.length]
    names_used += file.length
    breaks[break_count] = Break(file = kept, line = number)
    break_count += 1
    print(f"breakpoint {break_count} at {file}:{number}")

func parse_line(text: str) -> u32:
    var value: u32 = 0
    for byte in text.bytes:
        if byte < '0' or byte > '9':
            return 0
        value = value * 10 + (u32)(byte - '0')
    return value

func backtrace():
    var i = depth
    var index: usize = 0
    while i > 0:
        i -= 1
        let a = activations[i]
        if let s = a.shape:
            print(f"#{index} {s.name} at {s.source}:{a.line}")
        index += 1

func show_all(top: usize):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        show(local_of(s, i), a.frame)
        i += 1

func show_named(top: usize, name: str):
    let a = activations[top]
    let s = a.shape else return
    var i: u64 = 0
    while i < s.count:
        let described = local_of(s, i)
        if described.name == name:
            show(described, a.frame)
            return
        i += 1
    print(f"no local named `{name}`")

## The locals follow the shape, each `sizeof(Local)` bytes.
func local_of(s: Shape*, index: u64) -> Local*:
    let base = (usize)s + sizeof(Shape) + (usize)index * sizeof(Local)
    return (Local*)base

## A local's value read from the frame and shown by its type's spelling.
func show(described: Local*, frame: void*?):
    let f = frame else return
    let address = (void*)((usize)f - (usize)described.offset)
    let kind = described.kind
    if kind == "i64" or kind == "isize":
        print(f"{described.name}: {kind} = {memory.read[i64](address)}")
    elif kind == "i32":
        print(f"{described.name}: {kind} = {memory.read[i32](address)}")
    elif kind == "i16":
        print(f"{described.name}: {kind} = {memory.read[i16](address)}")
    elif kind == "i8":
        print(f"{described.name}: {kind} = {memory.read[i8](address)}")
    elif kind == "u64" or kind == "usize":
        print(f"{described.name}: {kind} = {memory.read[u64](address)}")
    elif kind == "u32" or kind == "char":
        print(f"{described.name}: {kind} = {memory.read[u32](address)}")
    elif kind == "u16":
        print(f"{described.name}: {kind} = {memory.read[u16](address)}")
    elif kind == "u8":
        print(f"{described.name}: {kind} = {memory.read[u8](address)}")
    elif kind == "bool":
        print(f"{described.name}: {kind} = {memory.read[bool](address)}")
    elif kind == "f64":
        print(f"{described.name}: {kind} = {memory.read[f64](address)}")
    elif kind == "f32":
        print(f"{described.name}: {kind} = {memory.read[f32](address)}")
    elif kind == "str":
        let text = memory.read[str](address)
        print(f"{described.name}: {kind} = \\"{text}\\"")
    elif kind == "c.str":
        let text = memory.read[c.str](address)
        print(f"{described.name}: {kind} = \\"{(str)text}\\"")
    elif ends_with(kind, "*") or ends_with(kind, "*?"):
        print(f"{described.name}: {kind} = 0x{hex(memory.read[usize](address))}")
    else:
        var shown: usize = (usize)described.size
        if shown > 32:
            shown = 32
        var text: u8[160]
        var used: usize = 0
        var i: usize = 0
        while i < shown:
            let byte = memory.read[u8]((void*)((usize)address + i))
            let digits = "0123456789abcdef".bytes
            text[used] = digits[(usize)(byte >> 4)]
            text[used + 1] = digits[(usize)(byte & 15)]
            text[used + 2] = ' '
            used += 3
            i += 1
        print(f"{described.name}: {kind} = {described.size} bytes {(str)text[..<used]}")

func first_word(line: str) -> str:
    var i: usize = 0
    while i < line.length and line.bytes[i] != ' ':
        i += 1
    return (str)line.bytes[..<i]

func trim(text: str) -> str:
    var start: usize = 0
    var end = text.length
    while start < end and text.bytes[start] == ' ':
        start += 1
    while end > start and (text.bytes[end - 1] == ' ' or text.bytes[end - 1] == '\\r'):
        end -= 1
    return (str)text.bytes[start..<end]

## One line from standard input, without its newline; none at the end of input.
func read_line() -> str?:
    var used: usize = 0
    while used < line_bytes.length:
        var byte: u8[1]
        let n = c_read(0, &byte[0], 1)
        if n <= 0:
            if used == 0:
                return none
            break
        if byte[0] == '\\n':
            break
        line_bytes[used] = byte[0]
        used += 1
    return (str)line_bytes[..<used]
"""),
]
