## `luce-base describe module.lucb` (§17.7): the module's public declarations, one per
## line, for a tool that must know them without parsing Base. Functions, constants,
## structs with their public fields, integer-backed enums with their cases, handles with
## their destroyers, and aliases; types spelled as the specification spells them.
import front.ast
import io
import sema.check
import sema.types

pub func write(out: io.Writer, checker: check.Checker*, tree: ast.Node*, name: str) -> !:
    try out.write(f"module {name}\n")
    # Describe only dependencies mentioned by public signatures. Module-qualified
    # identities keep an imported handle the same type through every package.
    let used = try alloc bool[checker.modules.count]
    var zero: usize = 0
    while zero < used.length:
        used[zero] = false
        zero += 1
    var scan = tree.body
    while let d = scan:
        if d.has(ast.flag_pub):
            mark_type(checker, tree, d.type_id, used)
            var members = d.body
            while let member = members:
                if member.kind == ast.Kind.field and member.has(ast.flag_pub):
                    mark_type(checker, tree, member.type_id, used)
                members = member.next
        scan = d.next
    var i: usize = 0
    while i < used.length:
        if used[i]:
            try out.write(f"import {checker.modules.get(i).name} as __base_{i}\n")
            var declarations = checker.modules.get(i).tree.body
            while let d = declarations:
                if d.kind == ast.Kind.extern_type and d.has(ast.flag_pub) and d.right != none:
                    try out.write(f"foreign __base_{i}.{d.text} handle\n")
                declarations = d.next
        i += 1
    var cursor = tree.body
    while let d = cursor:
        # a generic declaration (its `left` holds the parameters) is Base's own
        let generic = d.left != none and d.kind != ast.Kind.constant
        if d.has(ast.flag_pub) and not generic:
            try declaration(out, checker, tree, d)
        cursor = d.next

func declaration(out: io.Writer, checker: check.Checker*, tree: ast.Node*, d: ast.Node*) -> !:
    match d.kind:
        .func_:
            try out.write(f"func {d.text}(")
            var first = true
            var p = d.right
            while let param = p:
                if not first:
                    try out.write(", ")
                first = false
                try out.write(f"{param.text}: ")
                try describe_type(out, checker, tree, param.type_id)
                p = param.next
            try out.write(")")
            let result = checker.table.get(d.type_id).elem
            if result != types.unit_id:
                try out.write(" -> ")
                try describe_type(out, checker, tree, result)
            try out.write("\n")
        .constant:
            try out.write(f"let {d.text}: ")
            try describe_type(out, checker, tree, d.type_id)
            try out.write("\n")
        .struct_, .extern_struct:
            try out.write(f"struct {d.text}\n")
            var m = d.body
            while let member = m:
                if member.kind == ast.Kind.field and member.has(ast.flag_pub):
                    try out.write(f"    field {member.text}: ")
                    try describe_type(out, checker, tree, member.type_id)
                    try out.write("\n")
                    # Older readers ignore this additive record and retain a
                    # conservative read-only view of an imported field.
                    if not member.has(ast.flag_const):
                        try out.write(f"    mutable {member.text}\n")
                m = member.next
        .enum_:
            # an integer-backed enum crosses; one with payloads is Base's own
            let backing = d.ty else return
            try out.write(f"enum {d.text} as ")
            try describe_type(out, checker, tree, backing.type_id)
            try out.write("\n")
            var m = d.body
            while let member = m:
                if member.kind == ast.Kind.enum_case:
                    try out.write(f"    case {member.text} = {types.case_value(d, member)}\n")
                m = member.next
        .extern_type:
            let destroy = d.right else return
            try out.write(f"handle {d.text} destroy {destroy.text}\n")
        .type_alias:
            try out.write(f"type {d.text} = ")
            try describe_type(out, checker, tree, d.type_id)
            try out.write("\n")
        _:
            discard(0)

func foreign_module(checker: check.Checker*, tree: ast.Node*, id: u32) -> usize?:
    let target_decl = checker.table.get(id).decl else return none
    var i: usize = 0
    while i < checker.modules.count:
        let module = checker.modules.get(i)
        if module.tree != tree:
            var cursor = module.tree.body
            while let d = cursor:
                if d == target_decl:
                    return i
                cursor = d.next
        i += 1
    return none

func mark_type(checker: check.Checker*, tree: ast.Node*, id: u32, used: bool[]):
    if let module = foreign_module(checker, tree, id):
        if not checker.modules.get(module).is_prelude:
            used[module] = true
    let t = checker.table.get(id)
    if t.elem != 0:
        mark_type(checker, tree, t.elem, used)
    for argument in t.args:
        mark_type(checker, tree, argument, used)

## Diagnostics remain short; the machine-readable boundary additionally spells
## public foreign types with their import alias. Private/prelude types stay opaque
## to Luce until an explicit public boundary for them is provided.
func describe_type(out: io.Writer, checker: check.Checker*, tree: ast.Node*, id: u32) -> !:
    let t = checker.table.get(id)
    if let module = foreign_module(checker, tree, id):
        if t.args.length == 0:
            try out.write(f"__base_{module}.{t.name}")
            return
    match t.kind:
        .pointer, .span:
            if t.is_const:
                try out.write("const ")
            if t.is_volatile:
                try out.write("volatile ")
            try describe_type(out, checker, tree, t.elem)
            try out.write("*" if t.kind == types.Kind.pointer else "[]")
        .optional, .fallible:
            if t.elem != types.unit_id or t.kind == types.Kind.optional:
                try describe_type(out, checker, tree, t.elem)
            try out.write("?" if t.kind == types.Kind.optional else "!")
        .func_:
            try out.write("func(")
            var i: usize = 0
            while i < t.args.length:
                if i > 0:
                    try out.write(", ")
                try describe_type(out, checker, tree, t.args[i])
                i += 1
            try out.write(") -> ")
            try describe_type(out, checker, tree, t.elem)
        _:
            try checker.table.describe(out, id)
