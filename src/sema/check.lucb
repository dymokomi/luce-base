#==============================================================================================
#
#   check - Names, types, and effects
#
#   DESCRIPTION:
#       Turns parsed modules into a checked program (base.md §5–§17). Declarations are
#       collected first so forward references and recursion work, then every signature
#       and field type is resolved, then every body is checked. What the checker
#       learns is written onto the tree: `type_id` on every expression, type, and
#       declaration node; `resolved` on names, members, and calls.
#
#       Generic declarations are checked once against their written constraints with
#       opaque parameter types (§13). A use with concrete arguments substitutes them
#       into the signature; bodies are not re-checked per instance, which is what
#       declaration-time checking means. The standard modules come from `prelude`,
#       parsed and bound before the program's own modules, so `io.stdout()` and
#       `Writer` resolve like any other declaration.
#
#       The first error stops the check and names its position.
#
#==============================================================================================

import c
import files
import back.target as targets
import front.ast
import front.parser
import front.source
import front.token
import io
import memory
import sema.init_rules
import sema.prelude
import sema.prune
import sema.types
import support.list

pub let unknown_name: ErrorCode = ErrorCode.package(9)
pub let type_error: ErrorCode = ErrorCode.package(10)
pub let unsupported: ErrorCode = ErrorCode.package(11)

# mark: Bindings and modules ===================================================================

## One name in scope: what it is, what type it has, whether it may change.
struct Binding:
    var name: str
    var type_id: u32
    var decl: ast.Node*?
    var mutable: bool
    var depth: u32
    ## Set when the binding was initialised from a local address, so a name that reads it
    ## carries the escape taint of §6.6.
    var from_local: bool
    ## The import that made this name visible, so a use of the name marks the import.
    var origin: ast.Node*?
    ## Some expression read or assigned the name; a local nothing used is pruned (§19.6).
    var used: bool

## One module of the program: its tree, its source for positions, and whether
## the checker supplied it from the prelude.
pub struct Module:
    pub var name: str
    pub var tree: ast.Node*
    pub var src: source.Source
    pub var is_prelude: bool

## A `Writer` over a caller's buffer, for spelling types into diagnostics.
struct SpanWriter: io.Writer:
    var data: u8[]
    var used: usize

    pub mutating func write(bytes: const u8[]) -> usize!:
        var i: usize = 0
        while i < bytes.length and self.used < self.data.length:
            self.data[self.used] = bytes[i]
            self.used += 1
            i += 1
        return i

# mark: The checker ============================================================================

pub struct Checker:
    pub var table: types.Table
    pub var modules: list.List[Module]
    var scope: list.List[Binding]
    var depth: u32
    ## Diagnostics are formatted into the first half; type spellings into the second.
    ## The buffer outlives the arena, so the backends format their own reports here too.
    pub var scratch: u8[]
    ## The target of the build (§19.5): what the `target` module says and what the backends
    ## emit for.
    pub var build_target: targets.Target
    ## The module being checked, as an index into `modules`.
    var current: usize
    var current_func: ast.Node*?
    ## The unwrapped result type of the function being checked, and whether it may fail.
    var result_type: u32
    var fallible: bool
    var self_type: u32
    var self_mutable: bool
    ## Inside `init`, where `let` fields take their first value.
    var in_init: bool
    var loop_depth: u32
    ## The labels of the loops open around the statement being checked (§8.5).
    var labels: str[16]
    var label_count: usize
    var in_catch: bool
    ## The member expression being checked is a call's callee: a method may stand there.
    var calling: bool
    var catch_result: u32
    ## Inside a generic declaration, where parameter types stand for themselves.
    var checking_template: bool
    ## Inside a top-level constant initialiser, where `ErrorCode.package` is allowed.
    var at_top_level: bool
    ## The directory of the entry file; dotted imports resolve beneath it.
    var root: str
    ## The manifest's name (§16.4): the identity of the package's error codes (§11.3).
    pub var package_name: str
    ## Every `ErrorCode.package(n)` folded so far, with its package identity: no two alike.
    var package_codes: list.List[u64]
    ## Every symbol an `export` claimed: no two alike (§17.6).
    var export_symbols: list.List[str]
    ## Inside a lambda body, bindings below this index (the enclosing locals) are hidden:
    ## a lambda captures nothing (§9.6).
    var lambda_floor: usize
    var lambda_count: u32
    ## The warnings of the whole program, formatted with their positions (§19.6).
    pub var warnings: list.List[str]

    pub static func create(scratch: u8[]) -> Checker!:
        return Checker(table = try types.Table.create(), modules = try list.List[Module].create(16),
                       scope = try list.List[Binding].create(512), warnings = try list.List[str].create(16), depth = 0, scratch = scratch,
                       current = 0, current_func = none, result_type = types.unit_id, fallible = false,
                       self_type = types.none_id, self_mutable = false, in_init = false, loop_depth = 0, in_catch = false,
                       catch_result = types.none_id, checking_template = false, at_top_level = false, root = "", package_name = "app",
                       package_codes = try list.List[u64].create(64), export_symbols = try list.List[str].create(32),
                       build_target = targets.Target.host())

    # -- diagnostics ----------------------------------------------------------------------

    ## Report `what` at `node` and stop; the message lives in the first half of `scratch`.
    func fail(node: ast.Node*, what: str) -> never!:
        let half = self.scratch.length // 2
        var name: str = "?"
        var line: u32 = node.line
        var column: u32 = 0
        if self.current < self.modules.count:
            let m = self.modules.get(self.current)
            name = m.src.path
            let (l, col) = m.src.position(node.start)
            line = l
            column = col
        let message = try format(self.scratch[..<half], f"{name}:{line}:{column}: {what}")
        error(type_error, message)

    ## The spelling of a type, kept in the current allocator.
    pub func spell(id: u32) -> str!:
        let text = try self.with_type("", id, "")
        var out = try alloc u8[text.length if text.length > 0 else 1]
        memory.copy(out, text.bytes, text.length)
        return (str)out[..<text.length]

    ## `prefix` + the spelling of a type + `suffix`, in the second half of `scratch`.
    func with_type(prefix: str, id: u32, suffix: str) -> str!:
        let half = self.scratch.length // 2
        var sink = SpanWriter(data = self.scratch[half..], used = 0)
        discard(try sink.write(prefix.bytes))
        try self.table.describe(&sink, id)
        discard(try sink.write(suffix.bytes))
        return (str)self.scratch[half..<half + sink.used]

    func mismatch(node: ast.Node*, expected: u32, got: u32) -> never!:
        let half = self.scratch.length // 2
        var sink = SpanWriter(data = self.scratch[half..], used = 0)
        discard(try sink.write("expected `".bytes))
        try self.table.describe(&sink, expected)
        discard(try sink.write("`, got `".bytes))
        try self.table.describe(&sink, got)
        discard(try sink.write("`".bytes))
        return try self.fail(node, (str)self.scratch[half..<half + sink.used])

    # -- scopes ---------------------------------------------------------------------------

    mutating func push_scope():
        self.depth += 1

    mutating func pop_scope():
        while self.scope.count > 0 and self.scope.get(self.scope.count - 1).depth == self.depth:
            mark_if_unused(self.scope.get(self.scope.count - 1))
            self.scope.count -= 1
        self.depth -= 1

    func lookup(name: str) -> Binding?:
        var i = self.scope.count
        while i > 0:
            i -= 1
            let b = self.scope.get(i)
            if i < self.lambda_floor and b.depth > 0:
                continue
            if b.name == name:
                return b
        return none

    ## Bind `name` in the innermost scope. Base has no shadowing (§3.5): a local may not
    ## reuse the name of another local, a parameter, or an import, and nothing may reuse a
    ## core name.
    mutating func bind(at: ast.Node*, name: str, type_id: u32, decl: ast.Node*?, mutable: bool) -> !:
        if token.is_core_name(name) and not self.in_prelude():
            discard(try self.fail(at, "this name belongs to the language"))
        if let existing = self.lookup(name):
            if existing.depth >= 2 or existing.depth == self.depth:
                discard(try self.fail(at, "this name is already in scope"))
            elif existing.origin != none and self.depth >= 2:
                discard(try self.fail(at, "this name is an import; a local may not shadow it"))
        try self.scope.push(Binding(name = name, type_id = type_id, decl = decl, mutable = mutable, depth = self.depth, from_local = false, origin = none, used = false))

    ## A default argument that is `luce.line`, `luce.file`, or `luce.function` expands at
    ## the call site (§6.4): the call gains a named argument holding the fact as a literal.
    mutating func expand_fact_argument(call: ast.Node*, p: ast.Node*, fact: ast.Node*) -> !:
        if fact.text == "location":
            # `luce.location` itself, re-spelled at the call so the backends read its line there
            let owner = fact.left else return
            let module = try ast.Node.make(ast.Kind.name, owner.text, call.start, call.line)
            module.type_id = owner.type_id
            module.resolved = owner.resolved
            let here = try ast.Node.make(ast.Kind.member, fact.text, call.start, call.line)
            here.left = module
            here.type_id = p.type_id
            here.resolved = fact.resolved
            let argument = try ast.Node.make(ast.Kind.argument, p.text, call.start, call.line)
            argument.left = here
            argument.type_id = p.type_id
            self.append_argument(call, argument)
            return
        var text = ""
        var id = types.str_id
        if fact.text == "line":
            var digits = try alloc u8[12]
            text = try format(digits, f"{call.line}")
            id = types.u32_id
        elif fact.text == "file":
            let path = self.modules.get(self.current).src.path
            var spelled = try alloc u8[path.length + 2]
            text = try format(spelled, f"\"{path}\"")
        else:
            var name = "main"
            if let f = self.current_func:
                name = f.text
            var spelled = try alloc u8[name.length + 2]
            text = try format(spelled, f"\"{name}\"")
        let literal = try ast.Node.make(ast.Kind.literal, text, call.start, call.line)
        literal.type_id = id
        let argument = try ast.Node.make(ast.Kind.argument, p.text, call.start, call.line)
        argument.left = literal
        argument.type_id = id
        self.append_argument(call, argument)

    func append_argument(call: ast.Node*, argument: ast.Node*):
        var tail: ast.Node*? = none
        var cursor = call.body
        while let a = cursor:
            tail = a
            cursor = a.next
        if let last = tail:
            last.next = argument
        else:
            call.body = argument

    ## A constant expression (§6.4): literals; `sizeof`, `alignof`, `offsetof`, and the
    ## `luce` facts; operators and casts on constants; array, tuple, and struct literals of
    ## constants; enum cases; the address of a global or a function; top-level `let` names.
    func is_constant(e: ast.Node*) -> bool:
        match e.kind:
            .literal:
                return true
            .group:
                let inner = e.left else return false
                return self.is_constant(inner)
            .unary:
                let inner = e.left else return false
                if e.text == "&":
                    return self.global_place(inner)
                return self.is_constant(inner)
            .binary:
                let l = e.left else return false
                let r = e.right else return false
                return self.is_constant(l) and self.is_constant(r)
            .cast:
                let inner = e.left else return false
                return self.is_constant(inner)
            .conditional:
                let cond = e.ty else return false
                let l = e.left else return false
                let r = e.right else return false
                return self.is_constant(cond) and self.is_constant(l) and self.is_constant(r)
            .array_lit, .tuple:
                return self.all_constant(e.body)
            .case_value:
                return self.all_constant(e.body)
            .name:
                let d = e.resolved else return false
                return d.kind == ast.Kind.constant or d.kind == ast.Kind.func_ or d.kind == ast.Kind.enum_case
            .member:
                let owner = e.left else return false
                if owner.kind == ast.Kind.name and owner.text == "luce":
                    return true
                let d = e.resolved else return false
                return d.kind == ast.Kind.constant or d.kind == ast.Kind.enum_case or d.kind == ast.Kind.func_
            .call:
                let callee = e.left else return false
                if callee.kind == ast.Kind.name and (callee.text == "sizeof" or callee.text == "alignof" or callee.text == "offsetof"):
                    return true
                # a struct construction or a payload case from constants; a static function
                # runs, so its result is not one
                if let f = callee.resolved:
                    if f.kind == ast.Kind.func_ or f.kind == ast.Kind.extern_func:
                        return false
                if callee.has(ast.flag_type_ref) or callee.has(ast.flag_static):
                    return self.all_constant(e.body)
                return false
            _:
                return false

    ## Every item of a list is constant; an argument node wraps its expression, an array or
    ## tuple element is the expression itself.
    func all_constant(items: ast.Node*?) -> bool:
        var cursor = items
        while let a = cursor:
            if a.kind == ast.Kind.argument:
                let v = a.left else return false
                if not self.is_constant(v):
                    return false
            elif not self.is_constant(a):
                return false
            cursor = a.next
        return true

    ## A global, or an element or field of one reached by constant steps (§6.4).
    func global_place(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                return self.names_a_global(e)
            .group:
                let inner = e.left else return false
                return self.global_place(inner)
            .index:
                let owner = e.left else return false
                let i = e.body else return false
                return self.global_place(owner) and self.is_constant(i)
            .member:
                let owner = e.left else return false
                let d = e.resolved else return false
                if d.kind == ast.Kind.global or d.kind == ast.Kind.constant:
                    return true    # `module.global`
                return d.kind == ast.Kind.field and self.global_place(owner)
            _:
                return false

    ## `&global` and a function name are constant addresses (§6.4).
    func names_a_global(e: ast.Node*) -> bool:
        if e.kind != ast.Kind.name:
            return false
        let d = e.resolved else return false
        return d.kind == ast.Kind.global or d.kind == ast.Kind.constant or d.kind == ast.Kind.func_

    ## A tuple or array literal holding a local's address is as local as that address:
    ## `return (1, &n)` leaves the frame through the tuple (§6.6).
    mutating func mark_if_member_local(e: ast.Node*):
        var cursor = e.body
        while let m = cursor:
            if self.is_local_value(m):
                self.mark_local(e)
                return
            cursor = m.next

    ## §6.6: whether an expression's value is the address of a local, or aliases one.
    func is_local_value(e: ast.Node*) -> bool:
        return e.has(ast.flag_local)

    mutating func mark_local(e: ast.Node*):
        e.flags |= ast.flag_local

    ## Whether a place (an lvalue) is rooted in the current frame: a local `var`/`let`/param,
    ## an element or field reached from one, or a dereference of a local pointer.
    func place_is_local(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                let b = self.lookup(e.text) else return false
                let d = b.decl else return false
                if d.kind == ast.Kind.global or d.kind == ast.Kind.constant:
                    return false
                return b.depth > 0
            .self_:
                return false
            .group:
                let inner = e.left else return false
                return self.place_is_local(inner)
            .member:
                let owner = e.left else return false
                let ok = self.table.kind(owner.type_id)
                if ok == types.Kind.module:
                    return false    # `module.global`
                if ok == types.Kind.pointer or ok == types.Kind.span or owner.type_id == types.str_id:
                    return self.is_local_value(owner)    # wherever the pointer or view points
                return self.place_is_local(owner)
            .index:
                let owner = e.left else return false
                let ok = self.table.kind(owner.type_id)
                if ok == types.Kind.pointer or ok == types.Kind.span or owner.type_id == types.str_id:
                    return self.is_local_value(owner)
                return self.place_is_local(owner) or self.is_local_value(owner)
            .unary:
                if e.text == "*":
                    let inner = e.left else return false
                    return self.is_local_value(inner)
                return self.is_local_value(e)
            _:
                return self.is_local_value(e)

    ## Record on a binding that it holds a local address (a `let` alias of §6.6).
    mutating func set_from_local(name: str, taint: bool):
        var i = self.scope.count
        while i > 0:
            i -= 1
            var b = self.scope.get(i)
            if b.name == name and b.depth == self.depth:
                b.from_local = taint
                self.scope.set(i, b)
                return

    ## The escape rule (§6.6): a pointer, span, or `str` that names a local must not leave,
    ## alone or as a component of a tuple, an array, a struct, or an optional.
    func escapes(id: u32) -> bool:
        let t = self.table.get(id)
        match t.kind:
            .pointer, .span:
                return true
            .optional, .array:
                return self.escapes(t.elem)
            .tuple:
                for m in t.args:
                    if self.escapes(m):
                        return true
                return false
            .struct_:
                let d = t.decl else return false
                var cursor = d.body
                while let f = cursor:
                    if f.kind == ast.Kind.field and self.escapes(f.type_id):
                        return true
                    cursor = f.next
                return false
            _:
                return id == types.str_id

    ## The innermost binding of `name` was read or assigned (§19.6).
    mutating func mark_used(name: str):
        var i = self.scope.count
        while i > 0:
            i -= 1
            var b = self.scope.get(i)
            if b.name == name:
                b.used = true
                self.scope.set(i, b)
                return

    ## The reporter for the module being checked.
    mutating func reporter() -> prune.Reporter:
        let m = self.modules.get(self.current)
        return prune.Reporter(path = m.src.path, src = m.src, warnings = &self.warnings, silent = m.is_prelude)

    ## The binding just made came through import `at`.
    mutating func set_origin(at: ast.Node*):
        if self.scope.count == 0:
            return
        var b = self.scope.get(self.scope.count - 1)
        b.origin = at
        self.scope.set(self.scope.count - 1, b)

    ## A name was used: the import it came through is referenced (§16.3).
    func note_origin(b: Binding):
        if let o = b.origin:
            o.flags |= ast.flag_referenced

    ## The standard modules may spell core names (`c.char`, `c.int`).
    func in_prelude() -> bool:
        return self.current < self.modules.count and self.modules.get(self.current).is_prelude

    mutating func rebind(name: str, type_id: u32) -> !:
        var i = self.scope.count
        while i > 0:
            i -= 1
            var b = self.scope.get(i)
            if b.name == name:
                b.type_id = type_id
                self.scope.set(i, b)
                return

    # mark: Modules ============================================================================

    ## Parse `src` and add it as module `name`.
    pub mutating func add_module(name: str, src: source.Source, is_prelude: bool) -> !:
        var p = try parser.Parser.over(src, self.scratch)
        p.allow_core_names = is_prelude
        let tree = try p.parse_module()
        tree.text = name
        if is_prelude:
            var cursor = tree.body
            while let d = cursor:
                d.flags |= ast.flag_builtin
                var member = d.body
                while let m = member:
                    m.flags |= ast.flag_builtin
                    member = m.next
                cursor = d.next
        try self.modules.push(Module(name = name, tree = tree, src = src, is_prelude = is_prelude))

    ## Parse and add every standard module. The target is settled by now: its word sizes
    ## the pointer-shaped types (§19.5).
    pub mutating func add_prelude() -> !:
        self.table.word = (u64)self.build_target.pointer_bits // 8
        for p in prelude.modules:
            var text = p.text
            if p.name == "platform":
                # the one module written for the build: the target's facts (§19.5)
                let buffer = try alloc u8[1024]
                text = try self.build_target.module_text(buffer)
            let src = try source.Source.over(p.name, text.bytes)
            try self.add_module(p.name, src, true)

    ## Load `path` and, first, every module it imports from the same directory.
    pub mutating func load(path: c.str) -> !:
        self.root = directory_of((str)path)
        try self.load_as(path, module_name_of((str)path))

    ## Load `path` as module `name`; an imported module keeps its dotted path as its name.
    pub mutating func load_as(path: c.str, name: str) -> !:
        let text = (str)path
        let src = source.Source.load(path) catch failure:
            let half = self.scratch.length // 2
            let message = try format(self.scratch[..<half], f"cannot read {text}: {failure.message}")
            error(unknown_name, message)
        var p = try parser.Parser.over(src, self.scratch)
        let tree = try p.parse_module()
        if is_standard_module(name):
            let half = self.scratch.length // 2
            let message = try format(self.scratch[..<half], f"{text}: a module cannot take a standard module's name")
            error(unknown_name, message)
        if self.find_module(name) != none:
            return
        var cursor = tree.body
        while let d = cursor:
            if d.kind == ast.Kind.import_ or d.kind == ast.Kind.from_import:
                if self.find_module(d.text) == none and not is_standard_module(d.text):
                    let sibling = try self.resolve_import(d.text)
                    try self.load_as((c.str)sibling, d.text)
            cursor = d.next
        tree.text = name
        try self.modules.push(Module(name = name, tree = tree, src = src, is_prelude = false))

    ## `import front.lexer` is `front/lexer.lucb` under the root. The root starts as the
    ## entry file's directory; when a module under a subdirectory is the entry (its tests,
    ## say), the first import that is missing there moves the root up until it resolves.
    mutating func resolve_import(text: str) -> str!:
        var dir = self.root
        while true:
            var buffer = try alloc u8[dir.length + text.length + 6]
            let candidate = try format(buffer, f"{dir}{text}.lucb")
            for i in dir.length..<candidate.length:
                if candidate.bytes[i] == '.' and i + 5 < candidate.length:
                    buffer[i] = '/'
            if file_exists((c.str)candidate) or dir.length == 0:
                self.root = dir
                return candidate
            dir = parent_of(dir)

    ## Whether `m` is the standard `c` module, whose types the checker supplies (§5.2).
    func is_c_module(m: ast.Node*) -> bool:
        let index = self.find_module("c") else return false
        return self.modules.get(index).tree == m

    pub func find_module(name: str) -> usize?:
        var i: usize = 0
        while i < self.modules.count:
            if self.modules.get(i).name == name:
                return i
            i += 1
        return none

    ## Check every module in order: the prelude, then each program module.
    pub mutating func check_program() -> !:
        var i: usize = 0
        while i < self.modules.count:
            self.current = i
            try self.check_module(i)
            i += 1

    mutating func check_module(index: usize) -> !:
        let m = self.modules.get(index)
        let tree = m.tree
        self.push_scope()
        try self.bind_standard()
        try self.bind_imports(tree)
        try self.collect(tree)
        try self.resolve_signatures(tree)
        var decl = tree.body
        while let d = decl:
            if d.kind == ast.Kind.struct_ or d.kind == ast.Kind.union_:
                try self.check_containment(d)
            decl = d.next
        if index + 1 == self.modules.count:
            try self.check_entry(tree)
        var cursor = tree.body
        while let d = cursor:
            try self.check_declaration(d)
            cursor = d.next
        var r = self.reporter()
        try prune.prune_unused_functions(tree, &r, m.is_prelude)
        try prune.prune_unused_imports(tree, &r)
        self.pop_scope()

    ## A `naked func` owns its frame: the body is asm blocks and nothing else (§9.8), and the
    ## blocks are what returns, so the every-path rule does not apply.
    mutating func check_naked_body(body: ast.Node*) -> !:
        var cursor = body.body
        if cursor == none:
            discard(try self.fail(body, "a naked function's body is one asm block per architecture"))
        while let s = cursor:
            if s.kind != ast.Kind.asm_:
                discard(try self.fail(s, "a naked function's body is asm blocks only"))
            cursor = s.next

    ## `main` takes `str[]` or `c.str[]` and returns `i32` or `i32!` (§9.7).
    mutating func check_entry(tree: ast.Node*) -> !:
        let d = find_decl(tree, "main") else return
        if d.kind != ast.Kind.func_:
            return
        let ft = self.table.get(d.type_id)
        var result = ft.elem
        if self.table.kind(result) == types.Kind.fallible:
            result = self.table.get(result).elem
        var good = ft.args.length == 1 and result == types.i32_id
        if good:
            let p = self.table.get(ft.args[0])
            good = p.kind == types.Kind.span and (p.elem == types.str_id or p.elem == types.cstr_id)
        if not good:
            discard(try self.fail(d, "`main` takes `str[]` or `c.str[]` and returns `i32` or `i32!`"))

    ## Nothing is visible without an import (§16.3): a standard module is `import io`,
    ## one of its declarations `from io import Writer`, in the prelude as anywhere else.
    mutating func bind_standard() -> !:
        return

    mutating func bind_module(tree: ast.Node*, alias: str, at: ast.Node*) -> !:
        if self.lookup(alias) != none:
            return
        if tree.type_id == types.none_id:
            tree.type_id = try self.table.nominal(types.Kind.module, tree, try types.no_args())
        try self.bind(at, alias, tree.type_id, tree, false)
        self.set_origin(at)

    mutating func bind_public(tree: ast.Node*, name: str) -> !:
        if self.lookup(name) != none:
            return
        let d = find_decl(tree, name) else return
        try self.bind(d, name, d.type_id, d, d.kind == ast.Kind.global)

    mutating func bind_imports(tree: ast.Node*) -> !:
        var cursor = tree.body
        while let d = cursor:
            if d.kind == ast.Kind.import_ or d.kind == ast.Kind.from_import:
                var earlier = tree.body
                while let e = earlier:
                    if e == d:
                        break
                    if e.kind == d.kind and e.text == d.text:
                        if d.kind == ast.Kind.import_:
                            return try self.fail(d, "this module is already imported (§16.3)")
                        if let again = repeated_name(e.body, d.body):
                            return try self.fail(again, "this name is already imported (§16.3)")
                    earlier = e.next
            if d.kind == ast.Kind.import_:
                let index = self.find_module(d.text) else return try self.fail(d, "cannot find that module")
                let other = self.modules.get(index).tree
                var alias = last_component(d.text)
                if let a = d.left:
                    alias = a.text
                d.resolved = other
                try self.bind_module(other, alias, d)
            elif d.kind == ast.Kind.from_import:
                let index = self.find_module(d.text) else return try self.fail(d, "cannot find that module")
                let other = self.modules.get(index).tree
                d.resolved = other
                # `from io import Writer` brings `Writer` alone; `io` itself needs `import io`
                var names = d.body
                while let n = names:
                    let member = find_decl(other, n.text) else return try self.fail(n, "no such public name in that module")
                    if not member.has(ast.flag_pub):
                        discard(try self.fail(n, "that name is not public"))
                    n.resolved = member
                    try self.bind(n, n.text, member.type_id, member, member.kind == ast.Kind.global)
                    self.set_origin(d)
                    names = n.next
            cursor = d.next

    # mark: Declarations =======================================================================

    ## Give every top-level declaration a binding and, for types, a nominal id, so
    ## signatures can refer to each other in any order.
    mutating func collect(tree: ast.Node*) -> !:
        var cursor = tree.body
        while let d = cursor:
            # a top-level declaration remembers its module, for the backend's names
            d.resolved = tree
            match d.kind:
                .struct_, .extern_struct, .extern_type:
                    d.type_id = try self.table.nominal(types.Kind.struct_, d, try self.generic_ids(d))
                    try self.bind(d, d.text, d.type_id, d, false)
                .enum_:
                    d.type_id = try self.table.nominal(types.Kind.enum_, d, try self.generic_ids(d))
                    try self.bind(d, d.text, d.type_id, d, false)
                .union_, .extern_union:
                    d.type_id = try self.table.nominal(types.Kind.union_, d, try types.no_args())
                    try self.bind(d, d.text, d.type_id, d, false)
                .interface_:
                    d.type_id = try self.table.nominal(types.Kind.interface_, d, try self.generic_ids(d))
                    try self.bind(d, d.text, d.type_id, d, false)
                .type_alias, .func_, .extern_func, .constant:
                    try self.bind(d, d.text, types.none_id, d, false)
                .global, .extern_var:
                    try self.bind(d, d.text, types.none_id, d, true)
                _:
                    discard(0)
            cursor = d.next

    ## The generic parameters of a declaration, registered as param types.
    mutating func generic_ids(d: ast.Node*) -> u32[]!:
        let params = generic_params_of(d)
        let n = ast.count(params)
        if n == 0:
            return try types.no_args()
        var ids = try alloc u32[n]
        var i: usize = 0
        var cursor = params
        while let g = cursor:
            g.type_id = try self.table.parameter(d, g.text)
            ids[i] = g.type_id
            i += 1
            cursor = g.next
        return ids

    ## Bind a declaration's generic parameters and resolve their constraints.
    mutating func bind_generics(d: ast.Node*) -> !:
        var cursor = generic_params_of(d)
        while let g = cursor:
            if let existing = self.lookup(g.text):
                if let ed = existing.decl:
                    if (is_type_decl(ed) or ed.kind == ast.Kind.type_alias) and ed != d:
                        discard(try self.fail(g, "a type parameter may not take the name of a type in scope"))
            if g.type_id == types.none_id:
                g.type_id = try self.table.parameter(d, g.text)
            try self.bind(g, g.text, g.type_id, g, false)
            var bound = g.body
            while let constraint = bound:
                let id = try self.resolve_type(constraint)
                if self.table.kind(id) != types.Kind.interface_:
                    discard(try self.fail(constraint, "a constraint must be an interface"))
                bound = constraint.next
            cursor = g.next

    mutating func resolve_signatures(tree: ast.Node*) -> !:
        var cursor = tree.body
        while let d = cursor:
            try self.resolve_declaration(d)
            cursor = d.next

    mutating func resolve_declaration(d: ast.Node*) -> !:
        match d.kind:
            .type_alias:
                let t = d.ty else return try self.fail(d, "an alias needs a type")
                if d.type_id == types.none_id:
                    d.type_id = try self.resolve_type(t)
                try self.rebind(d.text, d.type_id)
            .constant:
                if let t = d.ty:
                    d.type_id = try self.resolve_type(t)
                    try self.rebind(d.text, d.type_id)
            .global, .extern_var:
                let t = d.ty else return try self.fail(d, "a global needs a type")
                d.type_id = try self.resolve_type(t)
                try self.storable(d.type_id, t)
                try self.rebind(d.text, d.type_id)
            .func_, .extern_func:
                try self.resolve_function(d, none)
                try self.rebind(d.text, d.type_id)
            .extern_type:
                if let t = d.ty:
                    discard(try self.resolve_type(t))
            .struct_, .extern_struct, .union_, .extern_union, .enum_, .interface_:
                try self.resolve_members(d)
            _:
                discard(0)

    ## A struct or union cannot contain itself by value; a pointer, span, or optional
    ## pointer breaks the cycle (§10.1). The offending field loses its type so no layout recurses.
    mutating func check_containment(d: ast.Node*) -> !:
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.field and self.contains_by_value(m.type_id, d, 0):
                discard(try self.fail(m, "this struct contains itself; use a pointer (§10.1)"))
                m.type_id = types.error_id
            cursor = m.next

    func contains_by_value(id: u32, d: ast.Node*, depth: u32) -> bool:
        if depth > 32:
            return false
        let t = self.table.get(id)
        match t.kind:
            .array, .atomic:
                return self.contains_by_value(t.elem, d, depth + 1)
            .optional:
                let inner = self.table.get(t.elem)
                if inner.kind == types.Kind.pointer or inner.kind == types.Kind.func_:
                    return false
                return self.contains_by_value(t.elem, d, depth + 1)
            .tuple:
                for a in t.args:
                    if self.contains_by_value(a, d, depth + 1):
                        return true
                return false
            .struct_, .union_:
                let decl = t.decl else return false
                if decl == d:
                    return true
                var cursor = decl.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and self.contains_by_value(m.type_id, d, depth + 1):
                        return true
                    cursor = m.next
                return false
            _:
                return false

    ## An `extern` or `export` signature crosses the C boundary: no generic, no `str`, no
    ## `fmt`, no array by value, no span outside a parameter, no tagged optional, no view
    ## (§17.1, §17.6); an export's symbol is unique in the program.
    mutating func check_foreign_signature(f: ast.Node*, owner: ast.Node*?) -> !:
        let exported = f.has(ast.flag_export)
        let which = "an `export`" if exported else "an `extern`"
        if generic_params_of(f) != none:
            var text: u8[128]
            return try self.fail(f, try format(text, f"{which} cannot be generic (§17.6)"))
        var cursor = f.right
        while let p = cursor:
            if not p.has(ast.flag_variadic) and not self.c_representable(p.type_id, true):
                var text: u8[160]
                return try self.fail(p, try format(text, f"this type is not C-representable in {which} signature; C text is `c.str` (§17.6)"))
            if exported and p.has(ast.flag_out):
                return try self.fail(p, "an `export` cannot have `out` parameters")
            cursor = p.next
        let ft = self.table.get(f.type_id)
        var result = ft.elem
        if self.table.kind(result) == types.Kind.fallible:
            result = self.table.get(result).elem
        if self.table.kind(result) == types.Kind.tuple:
            for m in self.table.get(result).args:
                if not self.c_representable(m, false):
                    return try self.fail(f, "an `out` result is not C-representable (§17.1)")
        elif result != types.unit_id and not self.c_representable(result, false):
            var text: u8[160]
            return try self.fail(f, try format(text, f"the result is not C-representable in {which} signature (§17.6)"))
        if exported:
            var symbol_bytes = try alloc u8[f.text.length + 128]
            var symbol = f.text
            if let o = owner:
                symbol = try format(symbol_bytes, f"{o.text}_{f.text}")
            for known in self.export_symbols.span():
                if known == symbol:
                    return try self.fail(f, "two exports share this symbol (§17.6)")
            try self.export_symbols.push(symbol)

    ## C-representable (§17.6): scalars, the `c` types, pointers, `c.str`, spans in
    ## parameter position, records of representable fields, integer-backed enums, and
    ## function pointers with representable signatures.
    func c_representable(id: u32, parameter: bool) -> bool:
        let t = self.table.get(id)
        if self.table.is_numeric(id) or id == types.bool_id or id == types.char_id or id == types.cstr_id or id == types.void_id or id == types.unit_id or id == types.never_id:
            return true
        match t.kind:
            .pointer:
                return t.elem == types.void_id or self.c_representable(t.elem, false) or self.table.kind(t.elem) == types.Kind.struct_ or self.table.kind(t.elem) == types.Kind.union_
            .span:
                return parameter and self.c_representable(t.elem, false)
            .optional:
                return self.table.has_null_niche(t.elem) and self.c_representable(t.elem, false)
            .struct_, .union_:
                if self.table.is_opaque_handle(id):
                    return true
                let d = t.decl else return false
                var member = d.body
                while let m = member:
                    if m.kind == ast.Kind.field and not self.c_representable(m.type_id, false):
                        return false
                    member = m.next
                return true
            .enum_:
                return self.is_backed_enum(id)
            .func_:
                for a in t.args:
                    if not self.c_representable(a, true):
                        return false
                return t.elem == types.unit_id or self.c_representable(t.elem, false)
            _:
                return false

    ## `T!` is a result effect, not a storable type: no parameter, field, element, or local
    ## holds one (§11.2).
    func storable(id: u32, at: ast.Node*) -> !:
        if self.table.kind(id) == types.Kind.fallible:
            return try self.fail(at, "`T!` is a result, not a storable type; declare an enum to hold one (§11.2)")

    ## The fields, cases, and method signatures of a type declaration.
    mutating func resolve_members(d: ast.Node*) -> !:
        self.push_scope()
        try self.bind_generics(d)
        if d.kind == ast.Kind.enum_:
            if let backing = d.ty:
                let bt = try self.resolve_type(backing)
                if not self.table.is_integer(bt):
                    discard(try self.fail(backing, "an enum is backed by an integer type"))
        var implemented = d.ty if d.kind != ast.Kind.enum_ else d.right
        while let i = implemented:
            let id = try self.resolve_type(i)
            if self.table.kind(id) != types.Kind.interface_:
                discard(try self.fail(i, "a conformance names an interface"))
            implemented = i.next
        var cursor = d.body
        while let m = cursor:
            match m.kind:
                .field:
                    let t = m.ty else return try self.fail(m, "a field needs a type")
                    m.type_id = try self.resolve_type(t)
                    try self.storable(m.type_id, t)
                .enum_case:
                    var pcursor = m.body
                    while let p = pcursor:
                        let t = p.ty else return try self.fail(p, "a payload needs a type")
                        p.type_id = try self.resolve_type(t)
                        pcursor = p.next
                    m.type_id = d.type_id
                .func_:
                    if d.kind == ast.Kind.interface_ and generic_params_of(m) != none:
                        discard(try self.fail(m, "an interface has no generic methods (§14.1)"))
                    try self.resolve_function(m, d)
                _:
                    discard(0)
            cursor = m.next
        self.pop_scope()

    ## The function type of `f`. A method's receiver is implicit and not part of it, and so
    ## is an extern's `out` parameter, which the call answers instead (§17.1).
    mutating func resolve_function(f: ast.Node*, owner: ast.Node*?) -> !:
        self.push_scope()
        try self.bind_generics(f)
        let n = ast.count(f.right)
        var params = try types.no_args()
        if n > 0:
            params = try alloc u32[n]
        var i: usize = 0
        var outs: usize = 0
        var cursor = f.right
        while let p = cursor:
            let t = p.ty else return try self.fail(p, "a parameter needs a type")
            p.type_id = try self.resolve_type(t)
            try self.storable(p.type_id, t)
            if p.has(ast.flag_out):
                if f.kind != ast.Kind.extern_func:
                    return try self.fail(p, "only an extern function has `out` parameters")
                outs += 1
            else:
                params[i] = p.type_id
                i += 1
            cursor = p.next
        var result = types.unit_id
        if let r = f.ty:
            result = try self.resolve_type(r)
            r.type_id = result # the declared result, which the backends need beside `out` values
            # `-> T!` spells the failure on the type; `-> !` on the flag. One flag serves both.
            if self.table.kind(result) == types.Kind.fallible:
                f.flags |= ast.flag_fallible
        elif f.has(ast.flag_fallible):
            result = try self.table.fallible(result)
        if outs > 0:
            result = try self.extern_result(f, result)
        f.type_id = try self.table.function(params[..<i], result, f.has(ast.flag_variadic))
        if f.kind == ast.Kind.extern_func or f.has(ast.flag_export):
            try self.check_foreign_signature(f, owner)
        self.pop_scope()

    ## What a call of extern `f` answers: `declared`, then every `out` parameter, as a tuple
    ## when there is more than one value (§17.1).
    mutating func extern_result(f: ast.Node*, declared: u32) -> u32!:
        var parts = try alloc u32[ast.count(f.right) + 1]
        var n: usize = 0
        if declared != types.unit_id:
            parts[n] = declared
            n += 1
        var cursor = f.right
        while let p = cursor:
            if p.has(ast.flag_out):
                parts[n] = p.type_id
                n += 1
            cursor = p.next
        if n == 1:
            return parts[0]
        return try self.table.tuple(parts[..<n])

    # mark: Types ==============================================================================

    ## Resolve a written type (§5, §21) to its id, recording it on the node.
    pub mutating func resolve_type(t: ast.Node*) -> u32!:
        # a type node resolved once keeps its type; the checker re-reads calls it rewrites
        if t.type_id != types.none_id and t.kind == ast.Kind.type_:
            return t.type_id
        var id = types.none_id
        if t.has(ast.flag_func_type):
            let n = ast.count(t.body)
            var params = try types.no_args()
            if n > 0:
                params = try alloc u32[n]
            var i: usize = 0
            var cursor = t.body
            while let p = cursor:
                params[i] = try self.resolve_type(p)
                i += 1
                cursor = p.next
            let result = t.left else return try self.fail(t, "a function type needs a result")
            id = try self.table.function(params, try self.resolve_type(result), false)
        elif t.has(ast.flag_void):
            id = types.void_id
        elif t.has(ast.flag_tuple_type):
            let n = ast.count(t.body)
            var members = try alloc u32[n]
            var i: usize = 0
            var cursor = t.body
            while let m = cursor:
                members[i] = try self.resolve_type(m)
                i += 1
                cursor = m.next
            id = try self.table.tuple(members)
        elif t.has(ast.flag_star):
            let inner = t.left else return try self.fail(t, "a pointer needs a pointee")
            let elem = try self.resolve_type(inner)
            id = try self.table.pointer(elem, inner.has(ast.flag_const), inner.has(ast.flag_volatile))
        elif t.has(ast.flag_span):
            let inner = t.left else return try self.fail(t, "a span needs an element type")
            let elem = try self.resolve_type(inner)
            id = try self.table.span(elem, inner.has(ast.flag_const))
        elif t.has(ast.flag_array):
            let inner = t.left else return try self.fail(t, "an array needs an element type")
            let count = t.right else return try self.fail(t, "an array needs a length")
            let elem = try self.resolve_type(inner)
            let length = try self.constant_length(count)
            if length == 0:
                return try self.fail(count, "an array length is positive; C has no zero-length arrays (§5.4)")
            id = try self.table.array(elem, length)
        elif t.has(ast.flag_optional):
            let inner = t.left else return try self.fail(t, "an optional needs a payload")
            id = try self.table.optional(try self.resolve_type(inner))
        elif t.has(ast.flag_fallible):
            let inner = t.left else return try self.fail(t, "a result needs a payload")
            id = try self.table.fallible(try self.resolve_type(inner))
        elif t.text == "(":
            let inner = t.left else return try self.fail(t, "empty parentheses")
            id = try self.resolve_type(inner)
        else:
            id = try self.resolve_named(t)
        if t.has(ast.flag_atomic):
            if not self.atomic_allowed(id):
                return try self.fail(t, "`@T` needs an integer, `bool`, or a pointer of at most pointer width, or a struct of two words (§5.9)")
            id = try self.table.atomic(id)
        t.type_id = id
        return id

    ## What `@T` may hold (§5.9): an integer, `bool`, a pointer or nullable pointer, all of at
    ## most pointer width; or a struct of two pointer-width words for the double-width cas.
    func atomic_allowed(id: u32) -> bool:
        let k = self.table.kind(id)
        if self.table.is_integer(id) or id == types.bool_id or k == types.Kind.pointer:
            return self.table.size_of(id) <= 8
        if k == types.Kind.optional:
            return self.table.is_nullable_pointer(id)    # one word; a view's optional is two
        if k == types.Kind.struct_:
            return self.table.size_of(id) == 16 and self.table.align_of(id) == 8
        return false

    ## A named type: a scalar, a declaration in scope, `module.Type`, or an
    ## instance `Name[args]` of a generic declaration.
    mutating func resolve_named(t: ast.Node*) -> u32!:
        if let arr = try self.array_reading(t):
            return try self.resolve_type(arr)
        let scalar = scalar_id(t.text)
        if scalar != types.none_id:
            if t.body != none:
                return try self.fail(t, "a scalar takes no type arguments")
            return scalar
        var decl: ast.Node*? = none
        if let b = self.lookup(t.text):
            self.note_origin(b)
            let d = b.decl else return try self.fail(t, "that name is not a type")
            decl = d
        else:
            let dot = find_byte(t.text, '.')
            if dot >= t.text.length:
                return try self.unknown_type(t)
            let head = (str)t.text.bytes[..<dot]
            let rest = (str)t.text.bytes[dot + 1..]
            let mb = self.lookup(head) else return try self.unknown_type(t)
            self.note_origin(mb)
            let module = mb.decl else return try self.unknown_type(t)
            if module.kind != ast.Kind.module:
                return try self.fail(t, "that is not a module")
            if self.is_c_module(module) and c_type_id(rest) != types.none_id:
                return c_type_id(rest)
            let d = find_decl(module, rest) else return try self.fail(t, "no such type in that module")
            if not d.has(ast.flag_pub):
                return try self.fail(t, "that type is not public")
            decl = d
        let d = decl else return try self.fail(t, "that name is not a type")
        t.resolved = d
        if d.kind == ast.Kind.type_alias:
            if d.type_id == types.none_id:
                let target = d.ty else return try self.fail(t, "an alias needs a type")
                d.type_id = try self.resolve_type(target)
            return d.type_id
        if d.kind == ast.Kind.generic_param:
            return d.type_id
        if not is_type_decl(d):
            return try self.fail(t, "that name is not a type")
        let arity = ast.count(generic_params_of(d))
        if t.body != none:
            let n = ast.count(t.body)
            if arity != n:
                return try self.fail(t, "wrong number of type arguments")
            var args = try alloc u32[n]
            var i: usize = 0
            var cursor = t.body
            while let a = cursor:
                args[i] = try self.resolve_type(a)
                i += 1
                cursor = a.next
            return try self.table.nominal(self.table.kind(d.type_id), d, args)
        if arity > 0:
            # inside its own declaration the generic type stands for itself
            if self.self_decl() != d:
                return try self.fail(t, "this type needs type arguments")
        return d.type_id

    ## The declaration a bare or `module.`-qualified name refers to when it is a value rather
    ## than a type: a constant, a global, or a local.
    mutating func bracket_value_decl(text: str) -> ast.Node*?:
        let dot = find_byte(text, '.')
        var decl: ast.Node*? = none
        if dot >= text.length:
            let b = self.lookup(text) else return none
            decl = b.decl
        else:
            let mb = self.lookup((str)text.bytes[..<dot]) else return none
            let m = mb.decl else return none
            if m.kind != ast.Kind.module:
                return none
            decl = find_decl(m, (str)text.bytes[dot + 1..])
        let d = decl else return none
        if d.kind == ast.Kind.constant or d.kind == ast.Kind.global or d.kind == ast.Kind.let_ or d.kind == ast.Kind.var_ or d.kind == ast.Kind.param:
            return d
        return none

    ## The expression a bracketed name spells: `NAME` or `module.NAME`.
    func bracket_name_expr(arg: ast.Node*) -> ast.Node*!:
        let dot = find_byte(arg.text, '.')
        if dot >= arg.text.length:
            return try ast.Node.make(ast.Kind.name, arg.text, arg.start, arg.line)
        let m = try ast.Node.make(ast.Kind.member, (str)arg.text.bytes[dot + 1..], arg.start, arg.line)
        m.left = try ast.Node.make(ast.Kind.name, (str)arg.text.bytes[..<dot], arg.start, arg.line)
        return m

    ## `T[NAME]` where NAME is a value, not a type: the parser read a type argument, the
    ## program means an array of NAME elements (§5.4). That array type, or none.
    mutating func array_reading(t: ast.Node*) -> ast.Node*?!:
        let arg = t.body else return none
        if arg.next != none or arg.kind != ast.Kind.type_ or arg.flags != 0 or arg.left != none or arg.body != none or arg.text.length == 0:
            return none
        if self.bracket_value_decl(arg.text) == none:
            return none
        let base = try ast.Node.make(ast.Kind.type_, t.text, t.start, t.line)
        let arr = try ast.Node.make(ast.Kind.type_, "[", t.start, t.line)
        arr.flags |= ast.flag_array
        arr.left = base
        arr.right = try self.bracket_name_expr(arg)
        return arr

    ## `table[NAME].f` read as a generic instance of a value: an index (§7.6). Rewrites `e`
    ## in place and says whether it did.
    mutating func index_reading(e: ast.Node*) -> bool!:
        let holder = e.ty else return false
        let arg = holder.body else return false
        if arg.next != none or arg.kind != ast.Kind.type_ or arg.flags != 0 or arg.left != none or arg.body != none:
            return false
        if self.bracket_value_decl(e.text) == none or self.bracket_value_decl(arg.text) == none:
            return false
        let owner = try ast.Node.make(ast.Kind.name, e.text, e.start, e.line)
        e.kind = ast.Kind.index
        e.text = ""
        e.ty = none
        e.left = owner
        e.body = try self.bracket_name_expr(arg)
        return true

    ## The type declaration whose members are being checked, if any.
    func self_decl() -> ast.Node*?:
        if self.self_type == types.none_id:
            return none
        return self.table.get(self.self_type).decl

    ## An array length: a literal, a constant name, `sizeof`, or arithmetic on those.
    mutating func constant_length(e: ast.Node*) -> u64!:
        if e.kind == ast.Kind.literal:
            return try decode_integer(e.text)
        if e.kind == ast.Kind.group:
            let inner = e.left else return 0
            return try self.constant_length(inner)
        if e.kind == ast.Kind.name or e.kind == ast.Kind.member:
            let d = try self.constant_decl(e) else return try self.fail(e, "an array length must be a constant")
            let v = d.left else return try self.fail(e, "an array length must be a constant")
            return try self.constant_length(v)
        if e.kind == ast.Kind.binary:
            let l = e.left else return 0
            let r = e.right else return 0
            let a = try self.constant_length(l)
            let b = try self.constant_length(r)
            if e.text == "*":
                return a * b
            if e.text == "+":
                return a + b
            if e.text == "-":
                return a - b
            if e.text == "//":
                return a // b
            if e.text == "<<":
                return a << b
        if e.kind == ast.Kind.call:
            let callee = e.left else return 0
            if callee.kind == ast.Kind.name and (callee.text == "sizeof" or callee.text == "alignof"):
                let arg = e.body else return try self.fail(e, "sizeof needs an argument")
                let inner = arg.left else return 0
                let id = try self.type_of_argument(inner)
                return self.table.size_of(id) if callee.text == "sizeof" else self.table.align_of(id)
        return try self.fail(e, "an array length must be a constant")

    ## The constant a name or `module.name` denotes, or none.
    mutating func constant_decl(e: ast.Node*) -> ast.Node*?!:
        if e.kind == ast.Kind.name:
            # a name inside another module's initialiser was resolved when that module was checked
            if let d = e.resolved:
                return d if d.kind == ast.Kind.constant else none
            let b = self.lookup(e.text) else return none
            let d = b.decl else return none
            return d if d.kind == ast.Kind.constant else none
        if e.kind == ast.Kind.member:
            let owner = e.left else return none
            if owner.kind != ast.Kind.name:
                return none
            let b = self.lookup(owner.text) else return none
            self.note_origin(b)
            let m = b.decl else return none
            if m.kind != ast.Kind.module:
                return none
            let d = find_decl(m, e.text) else return none
            return d if d.kind == ast.Kind.constant else none
        return none

    ## The type an argument of `sizeof`/`alignof` names, or the type of the expression.
    mutating func type_of_argument(e: ast.Node*) -> u32!:
        if e.kind == ast.Kind.type_:
            e.type_id = try self.resolve_type(e)
            e.flags |= ast.flag_type_ref
            return e.type_id
        if e.kind == ast.Kind.name:
            let scalar = scalar_id(e.text)
            if scalar != types.none_id:
                # a scalar type name is a type reference; the backends read `type_id` and the flag
                e.type_id = scalar
                e.flags |= ast.flag_type_ref
                return scalar
            if let b = self.lookup(e.text):
                self.note_origin(b)
                if let d = b.decl:
                    if is_type_decl(d) or d.kind == ast.Kind.type_alias or d.kind == ast.Kind.generic_param:
                        if d.kind == ast.Kind.type_alias and d.type_id == types.none_id:
                            let target = d.ty else return 0
                            d.type_id = try self.resolve_type(target)
                        e.type_id = d.type_id
                        e.flags |= ast.flag_type_ref
                        return d.type_id
        let id = try self.check_expr(e, types.none_id)
        if e.has(ast.flag_type_ref):
            return e.type_id
        if id == types.untyped_int_id:
            return types.i64_id
        if id == types.untyped_float_id:
            return types.f64_id
        return id

    # mark: Substitution =======================================================================

    ## Replace the generic parameters of `decl` inside `id` with `args`.
    pub mutating func substitute(id: u32, decl: ast.Node*, args: u32[]) -> u32!:
        if args.length == 0:
            return id
        let t = self.table.get(id)
        match t.kind:
            .param:
                var i: usize = 0
                var cursor = generic_params_of(decl)
                while let g = cursor:
                    if g.type_id == id and i < args.length:
                        return args[i]
                    i += 1
                    cursor = g.next
                return id
            .pointer:
                return try self.table.pointer(try self.substitute(t.elem, decl, args), t.is_const, t.is_volatile)
            .span:
                return try self.table.span(try self.substitute(t.elem, decl, args), t.is_const)
            .array:
                return try self.table.array(try self.substitute(t.elem, decl, args), t.length)
            .optional:
                return try self.table.optional(try self.substitute(t.elem, decl, args))
            .fallible:
                return try self.table.fallible(try self.substitute(t.elem, decl, args))
            .atomic:
                return try self.table.atomic(try self.substitute(t.elem, decl, args))
            .tuple:
                var members = try alloc u32[t.args.length]
                var i: usize = 0
                while i < t.args.length:
                    members[i] = try self.substitute(t.args[i], decl, args)
                    i += 1
                return try self.table.tuple(members)
            .func_:
                var params = try types.no_args()
                if t.args.length > 0:
                    params = try alloc u32[t.args.length]
                var i: usize = 0
                while i < t.args.length:
                    params[i] = try self.substitute(t.args[i], decl, args)
                    i += 1
                return try self.table.function(params, try self.substitute(t.elem, decl, args), t.variadic)
            .struct_, .enum_, .union_, .interface_:
                let d = t.decl else return id
                if t.args.length == 0:
                    # the template's own name inside its declaration: instantiate it
                    if d == decl and ast.count(generic_params_of(d)) == args.length:
                        return try self.table.nominal(t.kind, d, args)
                    return id
                var inner = try alloc u32[t.args.length]
                var i: usize = 0
                while i < t.args.length:
                    inner[i] = try self.substitute(t.args[i], decl, args)
                    i += 1
                return try self.table.nominal(t.kind, d, inner)
            _:
                return id

    ## Learn the generic arguments of `decl` by matching a parameter type against
    ## an argument type; `out` holds one slot per generic parameter.
    mutating func infer(param: u32, arg: u32, decl: ast.Node*, out: u32[]) -> !:
        let p = self.table.get(param)
        let a = self.table.get(arg)
        if p.kind == types.Kind.param:
            var i: usize = 0
            var cursor = generic_params_of(decl)
            while let g = cursor:
                if g.type_id == param and i < out.length and out[i] == types.none_id:
                    out[i] = self.concrete(arg)
                i += 1
                cursor = g.next
            return
        if p.kind == a.kind:
            if p.kind == types.Kind.pointer or p.kind == types.Kind.span or p.kind == types.Kind.array or p.kind == types.Kind.optional or p.kind == types.Kind.fallible or p.kind == types.Kind.atomic:
                try self.infer(p.elem, a.elem, decl, out)
                return
            if p.kind == types.Kind.tuple or p.kind == types.Kind.func_:
                var i: usize = 0
                while i < p.args.length and i < a.args.length:
                    try self.infer(p.args[i], a.args[i], decl, out)
                    i += 1
                if p.kind == types.Kind.func_:
                    try self.infer(p.elem, a.elem, decl, out)
                return
            if p.decl == a.decl and p.args.length == a.args.length:
                var i: usize = 0
                while i < p.args.length:
                    try self.infer(p.args[i], a.args[i], decl, out)
                    i += 1
                return
        if p.kind == types.Kind.span and a.kind == types.Kind.array:
            try self.infer(p.elem, a.elem, decl, out)
        if p.kind == types.Kind.interface_ and a.kind == types.Kind.pointer:
            try self.infer(param, a.elem, decl, out)

    ## An untyped literal type made concrete for inference and bindings.
    func concrete(id: u32) -> u32:
        if id == types.untyped_int_id:
            return types.i64_id
        if id == types.untyped_float_id:
            return types.f64_id
        return id

    # mark: Conversions ========================================================================

    ## Can `source` stand where `target` is required with nothing written (§7.5)?
    ## `e` is the expression, consulted for literal-only conversions.
    func assignable(e: ast.Node*?, have: u32, want: u32) -> bool:
        if have == want or want == types.none_id:
            return true
        if have == types.never_id or have == types.error_id:
            return true
        let s = self.table.get(have)
        let t = self.table.get(want)
        if have == types.untyped_int_id:
            return self.table.is_numeric(want) or want == types.error_code_id or (t.kind == types.Kind.optional and self.assignable(e, have, t.elem))
        if have == types.untyped_float_id:
            return self.table.is_float(want) or (t.kind == types.Kind.optional and self.assignable(e, have, t.elem))
        if have == types.none_id:
            # the `none` literal
            return t.kind == types.Kind.optional
        if self.table.widens(have, want):
            return true
        if t.kind == types.Kind.optional:
            if s.kind == types.Kind.optional:
                return false
            return self.assignable(e, have, t.elem)
        if t.kind == types.Kind.fallible:
            return self.assignable(e, have, t.elem)
        if have == types.char_id and want == types.u8_id:
            if let n = e:
                return n.kind == ast.Kind.literal and n.text.bytes[0] == '\'' and decode_char(n.text) < 128
            return false
        if have == types.str_id and (want == types.cstr_id or (t.kind == types.Kind.optional and t.elem == types.cstr_id)):
            if let n = e:
                return n.kind == ast.Kind.literal and n.text.bytes[0] == '"'
            return false
        if want == types.fmt_id:
            return have == types.str_id or have == types.fmt_id
        if t.kind == types.Kind.pointer and s.kind == types.Kind.pointer:
            if s.is_const and not t.is_const:
                return false
            if t.elem == types.void_id or self.same_pointee(s.elem, t.elem):
                return true
            return false
        if t.kind == types.Kind.span:
            if s.kind == types.Kind.span or s.kind == types.Kind.array:
                if s.kind == types.Kind.span and s.is_const and not t.is_const:
                    return false
                # a mutable `T[N]` converts to `T[]`; a `let` array, or an array that is no
                # place, to `const T[]` only (§5.3)
                if s.kind == types.Kind.array and not t.is_const:
                    let n = e else return false
                    if not self.is_mutable_place(n):
                        return false
                return self.same_pointee(s.elem, t.elem)
            # a `Writer` takes text as bytes
            if t.elem == types.u8_id and t.is_const and (have == types.str_id or have == types.fmt_id):
                return true
            return false
        if t.kind == types.Kind.interface_:
            if s.kind == types.Kind.pointer:
                # a `mutating` requirement needs the conformer addressable as `var` (§14.3)
                if s.is_const and self.interface_mutates(want):
                    return false
                return self.conforms(s.elem, want)
            return false
        if t.kind == types.Kind.func_ and s.kind == types.Kind.func_:
            return self.function_converts(have, want)
        if t.kind == types.Kind.atomic:
            return self.assignable(e, have, t.elem)
        if s.kind == types.Kind.atomic:
            return self.assignable(e, s.elem, want)
        if t.kind == types.Kind.param and self.checking_template:
            return false
        return false

    ## Pointees agree when equal, or when the target drops nothing the source has.
    func same_pointee(have: u32, want: u32) -> bool:
        if have == want:
            return true
        let s = self.table.get(have)
        let t = self.table.get(want)
        if s.kind == types.Kind.array and t.kind == types.Kind.array:
            return s.elem == t.elem and s.length == t.length
        return false

    ## A function type converts when parameters agree and the result may gain `!`.
    func function_converts(have: u32, want: u32) -> bool:
        let s = self.table.get(have)
        let t = self.table.get(want)
        if s.args.length != t.args.length:
            return false
        var i: usize = 0
        while i < s.args.length:
            if s.args[i] != t.args[i]:
                # a pointer and its nullable form share a representation; either may stand for the other
                let sp = self.table.get(s.args[i])
                let tp = self.table.get(t.args[i])
                let s_opt = sp.kind == types.Kind.optional and sp.elem == t.args[i] and self.table.kind(sp.elem) == types.Kind.pointer
                let t_opt = tp.kind == types.Kind.optional and tp.elem == s.args[i] and self.table.kind(tp.elem) == types.Kind.pointer
                if not (s_opt or t_opt):
                    return false
            i += 1
        if s.elem == t.elem:
            return true
        let r = self.table.get(t.elem)
        return r.kind == types.Kind.fallible and r.elem == s.elem

    func unknown_type(t: ast.Node*) -> never!:
        var text: u8[256]
        return try self.fail(t, try format(text, f"unknown type `{t.text}`"))

    ## The type a plain read of `id` yields: an `@T` reads as its `T`.
    func plain_read(id: u32) -> u32:
        let t = self.table.get(id)
        return t.elem if t.kind == types.Kind.atomic else id

    ## Whether any requirement of interface `iface` is `mutating`.
    func interface_mutates(iface: u32) -> bool:
        let d = self.table.get(iface).decl else return false
        var cursor = d.body
        while let m = cursor:
            if m.kind == ast.Kind.func_ and m.has(ast.flag_mutating):
                return true
            cursor = m.next
        return false

    ## Does struct or enum `id` declare conformance to interface `iface`?
    func conforms(id: u32, iface: u32) -> bool:
        let t = self.table.get(id)
        let i = self.table.get(iface)
        if is_derived_bound(i.decl):
            return true
        if t.kind == types.Kind.param:
            return self.constraint_has(id, iface)
        let d = t.decl else return false
        var listed = d.ty if d.kind != ast.Kind.enum_ else d.right
        while let l = listed:
            if l.type_id == iface:
                return true
            let lt = self.table.get(l.type_id)
            if lt.decl == i.decl:
                return true
            listed = l.next
        return false

    ## Every type argument satisfies the constraints of its parameter (§13.1).
    mutating func check_constraints(d: ast.Node*, args: u32[], at: ast.Node*) -> !:
        var i: usize = 0
        var cursor = generic_params_of(d)
        while let g = cursor:
            if i >= args.length:
                return
            var bound = g.body
            while let constraint = bound:
                if not self.satisfies(args[i], constraint.type_id):
                    var text: u8[256]
                    var name: str = "the constraint"
                    if let iface = self.table.get(constraint.type_id).decl:
                        name = iface.text
                    return try self.fail(at, try format(text, f"the type argument for `{g.text}` does not satisfy `{name}`"))
                bound = constraint.next
            i += 1
            cursor = g.next

    ## Whether type `id` satisfies interface `iface`: the derived protocols by structure,
    ## `Display` by what formats, any other by declared conformance (§14).
    func satisfies(id: u32, iface: u32) -> bool:
        let t = self.table.get(id)
        if t.kind == types.Kind.param:
            return self.has_written_constraint(id, iface)
        let d = self.table.get(iface).decl else return false
        if is_derived_bound(d):
            if d.text == "Comparable":
                if self.table.is_numeric(id) or id == types.char_id or id == types.str_id:
                    return true
                let sd = t.decl else return false
                return t.kind == types.Kind.struct_ and find_member(sd, "compare", ast.Kind.func_) != none
            return self.comparable(id)
        if d.has(ast.flag_builtin) and d.text == "Display":
            return self.printable(id) or self.displays_itself(id)
        if t.kind == types.Kind.interface_:
            return t.decl == d
        if t.kind == types.Kind.pointer:
            return self.satisfies(t.elem, iface)
        if t.kind == types.Kind.struct_ or t.kind == types.Kind.enum_:
            return self.conforms(id, iface)
        return false

    ## Does generic parameter `id` carry interface `iface` as a constraint? The derived
    ## protocols count as carried: a conforming argument satisfies them by structure.
    func constraint_has(id: u32, iface: u32) -> bool:
        if is_derived_bound(self.table.get(iface).decl):
            return true
        return self.has_written_constraint(id, iface)

    ## Whether `iface` is written among parameter `id`'s constraints (§13.1): what a generic
    ## body may rely on, the derived protocols included.
    func has_written_constraint(id: u32, iface: u32) -> bool:
        let g = self.generic_param_node(id) else return false
        var bound = g.body
        while let constraint = bound:
            if constraint.type_id == iface or self.table.get(constraint.type_id).decl == self.table.get(iface).decl:
                return true
            bound = constraint.next
        return false

    ## The `generic_param` node behind a param type.
    func generic_param_node(id: u32) -> ast.Node*?:
        let t = self.table.get(id)
        let owner = t.decl else return none
        var cursor = generic_params_of(owner)
        while let g = cursor:
            if g.type_id == id:
                return g
            cursor = g.next
        return none

    ## Check `e` against `target`, then require assignability. Untyped literals
    ## take the target type. Returns the type the expression has afterwards.
    mutating func expect(e: ast.Node*, target: u32) -> u32!:
        # an `@T` is initialised from a `T`: the initial value is the first store (§15.1)
        let t = self.table.get(target)
        if t.kind == types.Kind.atomic:
            let got = try self.check_expr(e, t.elem)
            if self.table.kind(got) != types.Kind.atomic:
                return try self.coerce(e, got, t.elem)
            return try self.coerce(e, got, target)
        let got = try self.check_expr(e, target)
        return try self.coerce(e, got, target)

    mutating func coerce(e: ast.Node*, got: u32, target: u32) -> u32!:
        if target == types.none_id:
            return got
        if not self.assignable(e, got, target):
            if got == types.none_id:
                return try self.fail(e, "`none` needs an optional type here")
            return try self.mismatch(e, target, got)
        if got == types.untyped_int_id or got == types.untyped_float_id:
            if e.kind == ast.Kind.literal and got == types.untyped_int_id:
                try self.check_fits(e, target)
            e.type_id = self.table.get(target).elem if self.table.kind(target) == types.Kind.optional else target
            return e.type_id
        if got == types.never_id:
            return got
        if self.table.kind(got) == types.Kind.func_ and self.table.kind(target) == types.Kind.func_ and self.table.get(got).elem != self.table.get(target).elem:
            try self.wrap_as_fallible(e, target)
        # a local array passed where a span is wanted aliases the frame (§6.6)
        if self.table.kind(got) == types.Kind.array and self.escapes(target) and self.place_is_local(e):
            self.mark_local(e)
        return target

    ## An integer literal must fit its type (§7.5).
    func check_fits(e: ast.Node*, target: u32) -> !:
        var dest = target
        if self.table.kind(dest) == types.Kind.optional:
            dest = self.table.get(dest).elem
        if not self.table.is_integer(dest):
            return
        let value = try decode_integer(e.text)
        let bits = self.table.bits(dest)
        if bits >= 64:
            if self.table.is_signed(dest) and value > 9223372036854775807:
                discard(try self.fail(e, "integer literal does not fit"))
            return
        var limit: u64 = (u64)1 << bits
        if self.table.is_signed(dest):
            limit = limit // 2
        if value >= limit:
            discard(try self.fail(e, "integer literal does not fit"))

    ## Two operand types made one: untyped literals follow the typed side.
    mutating func unify(l: ast.Node*, lt: u32, r: ast.Node*, rt: u32) -> u32!:
        if lt == rt:
            return lt
        if lt == types.untyped_int_id or lt == types.untyped_float_id or lt == types.none_id:
            return try self.coerce(l, lt, rt)
        if rt == types.untyped_int_id or rt == types.untyped_float_id or rt == types.none_id:
            return try self.coerce(r, rt, lt)
        if self.assignable(r, rt, lt):
            return lt
        if self.assignable(l, lt, rt):
            return rt
        # two integers of one width and signedness compute together, `hash(key) % length`,
        # in the pointer-sized type when one is (§7.2); storing the result is still strict
        if self.table.is_integer(lt) and self.table.is_integer(rt) and self.table.is_signed(lt) == self.table.is_signed(rt) and self.table.bits(lt) == self.table.bits(rt) and not types.is_distinct_c(lt) and not types.is_distinct_c(rt):
            if rt == types.usize_id or rt == types.isize_id:
                return rt
            return lt
        return try self.mismatch(r, lt, rt)

    # mark: Places =============================================================================

    ## May `e` be assigned to, or have a mutating method called on it?
    func is_mutable_place(e: ast.Node*) -> bool:
        match e.kind:
            .name:
                let b = self.lookup(e.text) else return false
                return b.mutable
            .self_:
                return self.self_mutable
            .group:
                let inner = e.left else return false
                return self.is_mutable_place(inner)
            .member:
                let owner = e.left else return false
                if let field = e.resolved:
                    # `init` gives every field its first value, `let` fields included (§9.4)
                    if field.kind == ast.Kind.field and field.has(ast.flag_const) and not self.in_init:
                        return false
                    if field.kind == ast.Kind.global:
                        return true
                let ot = self.table.get(owner.type_id)
                if ot.kind == types.Kind.pointer:
                    return not ot.is_const
                if ot.kind == types.Kind.module:
                    return false
                return self.is_mutable_place(owner)
            .index:
                let owner = e.left else return false
                let ot = self.table.get(owner.type_id)
                if ot.kind == types.Kind.span:
                    return not ot.is_const
                if ot.kind == types.Kind.pointer:
                    return not ot.is_const
                return self.is_mutable_place(owner)
            .unary:
                if e.text != "*":
                    return false
                let inner = e.left else return false
                let it = self.table.get(inner.type_id)
                return it.kind == types.Kind.pointer and not it.is_const
            _:
                return false

    ## A `let` local, parameter, or `const` view whose address is taken yields a
    ## const pointer; a `var` yields a mutable one.
    func address_is_const(e: ast.Node*) -> bool:
        return not self.is_mutable_place(e)

    # mark: Expressions ========================================================================

    ## The type of `e`, recorded on the node. `hint` is the type the context wants,
    ## used by literals, `none`, `.case`, array literals, and lambdas; it is a hint,
    ## not a requirement, so callers `coerce` afterwards.
    pub mutating func check_expr(e: ast.Node*, hint: u32) -> u32!:
        let id = try self.expr_type(e, hint)
        e.type_id = id
        return id

    mutating func expr_type(e: ast.Node*, hint: u32) -> u32!:
        match e.kind:
            .literal:
                return try self.literal_type(e, hint)
            .name:
                return try self.name_type(e)
            .self_:
                if self.self_type == types.none_id:
                    return try self.fail(e, "`self` outside a method")
                return self.self_type
            .unit_:
                return types.unit_id
            .group:
                let inner = e.left else return try self.fail(e, "empty group")
                return try self.check_expr(inner, hint)
            .unary:
                return try self.unary_type(e, hint)
            .binary:
                return try self.binary_type(e, hint)
            .conditional:
                let cond = e.ty else return try self.fail(e, "a conditional needs a condition")
                discard(try self.expect(cond, types.bool_id))
                let l = e.left else return try self.fail(e, "a conditional needs a value")
                let r = e.right else return try self.fail(e, "a conditional needs an alternative")
                let lt = try self.check_expr(l, hint)
                let rt = try self.check_expr(r, hint if hint != types.none_id else lt)
                # a `never` branch takes the other branch's type: its value never exists (§5.1)
                if lt == types.never_id:
                    return rt
                if rt == types.never_id:
                    return lt
                return try self.unify(l, lt, r, rt)
            .call:
                return try self.call_type(e, hint)
            .member:
                return try self.member_type(e)
            .index:
                return try self.index_type(e)
            .slice:
                return try self.slice_type(e)
            .tuple:
                let t = try self.tuple_type(e, hint)
                self.mark_if_member_local(e)
                return t
            .array_lit:
                let t = try self.array_type(e, hint)
                self.mark_if_member_local(e)
                return t
            .lambda:
                return try self.lambda_type(e, hint)
            .else_:
                return try self.else_type(e, hint)
            .catch_:
                return try self.catch_type(e)
            .cast:
                return try self.cast_type(e)
            .case_value:
                return try self.case_type(e, hint)
            .formatted:
                var part = e.body
                while let p = part:
                    if p.kind == ast.Kind.format_field:
                        let v = p.left else return try self.fail(p, "empty field")
                        let vt = try self.check_expr(v, types.none_id)
                        if not self.printable(vt):
                            if self.displays_itself(vt):
                                try self.display_through_sink(p)
                            else:
                                discard(try self.fail(v, "this value cannot be formatted"))
                    part = p.next
                return types.fmt_id
            .new_:
                return try self.new_type(e)
            .alloc_:
                return try self.alloc_type(e)
            .span_make:
                let t = e.ty else return try self.fail(e, "a span constructor needs a type")
                let span = try self.resolve_type(t)
                let elem = self.table.get(span).elem
                let pointer = try self.table.pointer(elem, self.table.get(span).is_const, false)
                var args = e.body
                let p = args else return try self.fail(e, "a span constructor takes a pointer and a count")
                let pv = p.left else return try self.fail(e, "empty argument")
                discard(try self.expect(pv, pointer))
                let second = p.next else return try self.fail(e, "a span constructor takes a pointer and a count")
                let cv = second.left else return try self.fail(e, "empty argument")
                discard(try self.expect(cv, types.usize_id))
                return span
            .match_expr:
                return try self.match_type(e, hint, true)
            .return_, .break_, .continue_:
                try self.check_stmt(e)
                return types.never_id
            _:
                return try self.fail(e, "unsupported expression")

    ## A struct that is `Display` (§14.4) shows itself in a formatted string.
    func displays_itself(id: u32) -> bool:
        let iface = self.standard_type("luce", "Display")
        if iface == types.none_id:
            return false
        if self.table.kind(id) == types.Kind.param:
            # a parameter bound by `Display` writes itself through the sink; the instantiation
            # supplies the how, a struct's own `display` or the compiler's for a scalar
            return self.has_written_constraint(id, iface)
        if self.table.kind(id) != types.Kind.struct_:
            return false
        return self.conforms(id, iface)

    ## The type of a standard module's declaration, `io.Writer`; `none_id` when absent.
    pub func standard_type(module: str, name: str) -> u32:
        let index = self.find_module(module) else return types.none_id
        let d = find_decl(self.modules.get(index).tree, name) else return types.none_id
        return d.type_id

    ## A field whose value writes itself becomes the call `value.display(__sink)`, where
    ## `__sink` stands for the string's own sink (`flag_format_sink`); the backends supply
    ## that sink where they build the string.
    mutating func display_through_sink(field: ast.Node*) -> !:
        let v = field.left else return
        let sink = try ast.Node.make(ast.Kind.name, "__sink", field.start, field.line)
        sink.flags |= ast.flag_format_sink
        let argument = try ast.Node.make(ast.Kind.argument, "", field.start, field.line)
        argument.left = sink
        let call = try self.method_call(v, "display", field)
        call.body = argument
        call.flags |= ast.flag_format_sink
        field.left = call
        field.flags |= ast.flag_format_sink
        discard(try self.check_expr(call, types.none_id))

    ## Values a formatted string or `print` can show.
    func printable(id: u32) -> bool:
        let t = self.table.get(id)
        if t.kind == types.Kind.atomic:
            # a plain read of `@T` is a load (§15.1): the value displays as its `T`
            return self.printable(t.elem)
        if self.table.is_numeric(id) or id == types.untyped_int_id or id == types.untyped_float_id:
            return true
        if id == types.bool_id or id == types.char_id or id == types.str_id or id == types.cstr_id or id == types.fmt_id:
            return true
        if t.kind == types.Kind.pointer or t.kind == types.Kind.enum_:
            return true
        return false

    mutating func literal_type(e: ast.Node*, hint: u32) -> u32!:
        let b = e.text.bytes
        let first = b[0]
        if e.text == "true" or e.text == "false":
            return types.bool_id
        if e.text == "none":
            if self.table.kind(hint) == types.Kind.optional:
                return hint
            return types.none_id
        if first == '\'':
            # an ASCII character adapts to a byte (§4.4); any other is a `char`
            if hint == types.u8_id and decode_char(e.text) < 128:
                return types.u8_id
            return types.char_id
        if first == '"':
            if hint == types.cstr_id:
                return types.cstr_id
            return types.str_id
        if first == 'r' or first == 'b':
            if first == 'b':
                return try self.table.span(types.u8_id, true)
            return types.str_id
        let suffix = literal_suffix(e.text)
        if suffix.length > 0:
            return try self.suffixed_literal(e, suffix)
        if is_float_literal(e.text):
            return types.untyped_float_id
        return types.untyped_int_id

    ## `255u8`, `0.5f32`: the suffix names the literal's exact type (§4.2, §4.3), and the
    ## literal must fit it.
    mutating func suffixed_literal(e: ast.Node*, suffix: str) -> u32!:
        let id = scalar_id(suffix)
        if id == types.none_id or not self.table.is_numeric(id):
            return try self.fail(e, "a literal suffix names an integer or float type")
        if self.table.is_float(id) != is_float_literal(e.text):
            return try self.fail(e, "a float suffix needs a float literal, an integer suffix an integer literal")
        if self.table.is_integer(id):
            try self.check_fits(e, id)
        return id

    ## A name is a local, a declaration, a module, or a type used as a value.
    mutating func name_type(e: ast.Node*) -> u32!:
        if e.has(ast.flag_format_sink):
            return self.standard_type("io", "Writer")
        if e.ty != none and try self.index_reading(e):
            return try self.index_type(e)
        let scalar = scalar_id(e.text)
        if scalar != types.none_id:
            e.flags |= ast.flag_type_ref
            return scalar
        let b = self.lookup(e.text) else return try self.unknown_name(e)
        e.resolved = b.decl
        self.note_origin(b)
        self.mark_used(e.text)
        if let d = b.decl:
            if d.kind == ast.Kind.func_:
                d.flags |= ast.flag_referenced
        if b.from_local:
            self.mark_local(e)
        let d = b.decl else return b.type_id
        match d.kind:
            .func_, .extern_func:
                return d.type_id
            .struct_, .enum_, .union_, .interface_, .extern_type, .extern_struct, .extern_union, .generic_param:
                e.flags |= ast.flag_type_ref
                if e.ty != none:
                    # `Map[str, u32]` before a static member
                    let t = e.ty else return d.type_id
                    let named = try ast.Node.make(ast.Kind.type_, e.text, e.start, e.line)
                    named.body = t.body
                    return try self.resolve_type(named)
                return d.type_id
            .type_alias:
                e.flags |= ast.flag_type_ref
                if d.type_id == types.none_id:
                    let target = d.ty else return try self.fail(e, "an alias needs a type")
                    d.type_id = try self.resolve_type(target)
                return d.type_id
            .module:
                return b.type_id
            .constant:
                if d.type_id == types.none_id:
                    try self.check_constant(d)
                return d.type_id
            _:
                return b.type_id

    ## An unresolved name; inside a lambda, a local of the enclosing function is the usual
    ## cause, and a lambda captures nothing (§9.6).
    func unknown_name(e: ast.Node*) -> u32!:
        if self.lambda_floor > 0:
            var i = self.lambda_floor
            while i > 0:
                i -= 1
                if self.scope.get(i).name == e.text:
                    return try self.fail(e, "a lambda captures nothing; pass the value as a parameter (§9.6)")
        return try self.fail(e, "unknown name")

    ## The value of a constant integer expression (§6.4), or `none` when it is not one this
    ## evaluator folds: literals, `sizeof`, `alignof`, constants, the arithmetic, bit, and
    ## shift operators, and casts.
    pub func constant_u64(e: ast.Node*) -> u64?:
        match e.kind:
            .literal:
                let v = decode_integer(e.text) catch failure:
                    return none
                return v
            .group, .cast:
                let inner = e.left else return none
                return self.constant_u64(inner)
            .unary:
                let inner = e.left else return none
                let v = self.constant_u64(inner) else return none
                if e.text == "-" or e.text == "-%":
                    return 0 -% v
                if e.text == "~":
                    return ~v
                if e.text == "+":
                    return v
                return none
            .binary:
                let l = e.left else return none
                let r = e.right else return none
                let a = self.constant_u64(l) else return none
                let b = self.constant_u64(r) else return none
                return fold_binary(e.text, a, b)
            .call:
                let callee = e.left else return none
                if callee.kind != ast.Kind.name or callee.resolved != none:
                    return none
                let arg = e.resolved else return none
                if callee.text == "sizeof":
                    return self.table.size_of(arg.type_id)
                if callee.text == "alignof":
                    return self.table.align_of(arg.type_id)
                return none
            .name, .member:
                # a top-level `let`, this module's or an imported one's: `os.pointer_bits`
                let d = e.resolved else return none
                if d.kind != ast.Kind.constant:
                    return none
                let init = d.left else return none
                return self.constant_u64(init)
            .conditional:
                # `6 if target.macos else 1`: the arm the constant condition picks
                let cond = e.ty else return none
                let l = e.left else return none
                let r = e.right else return none
                let truth = self.constant_bool(cond) else return none
                return self.constant_u64(l if truth else r)
            _:
                return none

    ## The truth of a constant condition (§11.6): the literals, top-level `let`s of `bool`
    ## such as `os.arm64`, `not`, `and`, `or`, and comparisons of constant integers, signed
    ## when either operand's type is.
    pub func constant_bool(e: ast.Node*) -> bool?:
        match e.kind:
            .literal:
                if e.text == "true":
                    return true
                if e.text == "false":
                    return false
                return none
            .name, .member:
                let d = e.resolved else return none
                if d.kind != ast.Kind.constant:
                    return none
                let init = d.left else return none
                return self.constant_bool(init)
            .conditional:
                let cond = e.ty else return none
                let l = e.left else return none
                let r = e.right else return none
                let truth = self.constant_bool(cond) else return none
                return self.constant_bool(l if truth else r)
            .group:
                let inner = e.left else return none
                return self.constant_bool(inner)
            .unary:
                let inner = e.left else return none
                if e.text != "not":
                    return none
                let v = self.constant_bool(inner) else return none
                return not v
            .binary:
                let l = e.left else return none
                let r = e.right else return none
                if e.text == "and" or e.text == "or":
                    let a = self.constant_bool(l) else return none
                    let b = self.constant_bool(r) else return none
                    return (a and b) if e.text == "and" else (a or b)
                let a = self.constant_u64(l) else return none
                let b = self.constant_u64(r) else return none
                let signed = self.table.is_signed(l.type_id) or self.table.is_signed(r.type_id)
                return compare_constants(e.text, a, b, signed)
            _:
                return none

    ## The text a constant `str` expression denotes: a literal, or a top-level `let` of one,
    ## `os.name`; none for anything else.
    pub func constant_text(e: ast.Node*) -> str?:
        match e.kind:
            .literal:
                if e.text.bytes[0] != '"':
                    return none
                return decode_text(e.text)
            .group:
                let inner = e.left else return none
                return self.constant_text(inner)
            .name, .member:
                let d = e.resolved else return none
                if d.kind != ast.Kind.constant:
                    return none
                let init = d.left else return none
                return self.constant_text(init)
            .conditional:
                let cond = e.ty else return none
                let l = e.left else return none
                let r = e.right else return none
                let truth = self.constant_bool(cond) else return none
                return self.constant_text(l if truth else r)
            _:
                return none

    ## A condition that is a constant but not a literal, `if os.arm64:`, becomes the literal
    ## it stands for, so the branch it rules out is pruned; the program meant it, so no
    ## warning follows. Says whether it folded one.
    mutating func fold_condition(s: ast.Node*) -> bool!:
        let cond = s.left else return false
        if cond.kind == ast.Kind.literal:
            return false
        let truth = self.constant_bool(cond) else return false
        let folded = try ast.Node.make(ast.Kind.literal, "true" if truth else "false", cond.start, cond.line)
        folded.type_id = types.bool_id
        s.left = folded
        return true

    ## A top-level constant typed on first use, so order does not matter.
    mutating func check_constant(d: ast.Node*) -> !:
        let init = d.left else return try self.fail(d, "a constant needs a value")
        if d.type_id == types.error_id:
            discard(try self.fail(d, "this constant depends on itself"))
        d.type_id = types.error_id
        let saved_top = self.at_top_level
        self.at_top_level = true
        var declared = types.none_id
        if let t = d.ty:
            declared = try self.resolve_type(t)
        let got = try self.expect(init, declared)
        self.at_top_level = saved_top
        if not self.is_constant(init):
            discard(try self.fail(init, "a top-level `let` needs a constant expression (§6.4)"))
        d.type_id = declared if declared != types.none_id else self.concrete(got)
        if d.type_id == types.none_id:
            discard(try self.fail(d, "`none` needs a type"))
        try self.rebind(d.text, d.type_id)

    mutating func unary_type(e: ast.Node*, hint: u32) -> u32!:
        let inner = e.left else return try self.fail(e, "missing operand")
        if e.text == "try":
            let it = try self.check_expr(inner, types.none_id)
            if self.table.kind(it) != types.Kind.fallible:
                return try self.fail(e, "`try` needs a fallible expression")
            if not self.fallible:
                return try self.fail(e, "`try` is only valid in a fallible function")
            if self.is_local_value(inner):
                self.mark_local(e)    # the value still views the local it came from (§6.6)
            return self.table.get(it).elem
        if e.text == "not":
            discard(try self.expect(inner, types.bool_id))
            return types.bool_id
        if e.text == "&":
            let it = try self.check_expr(inner, types.none_id)
            if it == types.untyped_int_id or it == types.untyped_float_id or it == types.none_id:
                return try self.fail(e, "cannot take the address of a literal")
            if inner.has(ast.flag_type_ref):
                return try self.fail(e, "cannot take the address of a type")
            if not is_place(inner):
                return try self.fail(e, "cannot take the address of a temporary; bind it first")
            if self.is_packed_field(inner):
                return try self.fail(e, "a packed field's address is not taken unless its alignment is one (§5.11)")
            if self.place_is_local(inner):
                self.mark_local(e)
            return try self.table.pointer(it, self.address_is_const(inner), false)
        if e.text == "*":
            let it = try self.check_expr(inner, types.none_id)
            let t = self.table.get(it)
            if t.kind != types.Kind.pointer:
                return try self.fail(e, "`*` needs a pointer")
            if t.elem == types.void_id:
                return try self.fail(e, "cannot dereference `void*`")
            return t.elem
        if e.text == "-" and inner.kind == ast.Kind.literal and self.table.is_integer(hint) and not self.table.is_signed(hint):
            return try self.fail(e, "a negative literal does not fit an unsigned type")
        let it = try self.check_expr(inner, hint)
        if e.text == "-" and self.table.is_integer(it) and not self.table.is_signed(it):
            return try self.fail(e, "unary `-` is rejected on unsigned types; use `-%`")
        if e.text == "-" or e.text == "+":
            if it == types.untyped_int_id or it == types.untyped_float_id or self.table.is_numeric(it):
                return it
            return try self.fail(e, "arithmetic needs a number")
        if e.text == "-%":
            if it == types.untyped_int_id or self.table.is_integer(it):
                return it
            return try self.fail(e, "wrapping negation needs an integer")
        if e.text == "~":
            if it == types.untyped_int_id or self.table.is_integer(it) or self.is_backed_enum(it):
                return it
            return try self.fail(e, "`~` needs an integer")
        return try self.fail(e, "unknown operator")

    mutating func binary_type(e: ast.Node*, hint: u32) -> u32!:
        let l = e.left else return try self.fail(e, "missing operand")
        let r = e.right else return try self.fail(e, "missing operand")
        let op = e.text
        if op == "and" or op == "or":
            discard(try self.expect(l, types.bool_id))
            discard(try self.expect(r, types.bool_id))
            return types.bool_id
        if op == "..<" or op == "..=":
            let lt = try self.check_expr(l, hint)
            let rt = try self.check_expr(r, hint if hint != types.none_id else lt)
            let joined = try self.unify(l, lt, r, rt)
            var t = self.concrete(joined)
            if joined == types.untyped_int_id and hint != types.none_id and self.table.is_integer(hint):
                t = hint
            if not self.table.is_integer(t):
                return try self.fail(e, "a range needs integer bounds")
            discard(try self.coerce(l, lt, t))
            discard(try self.coerce(r, rt, t))
            return try self.table.span(t, true)
        if op == "<<" or op == ">>":
            let lt = try self.check_expr(l, hint)
            let rt = try self.check_expr(r, types.none_id)
            if not (lt == types.untyped_int_id or self.table.is_integer(lt)):
                return try self.fail(e, "a shift needs an integer")
            if not (rt == types.untyped_int_id or self.table.is_integer(rt)):
                return try self.fail(e, "a shift count is an integer")
            if rt != types.untyped_int_id:
                discard(try self.coerce(r, rt, rt))
            return lt
        # `let fits: u8? = 1 +? 2` adds bytes: the optional's element is the operands' context
        var context = hint if is_arithmetic(op) else types.none_id
        if (op == "+?" or op == "-?" or op == "*?") and self.table.kind(hint) == types.Kind.optional:
            context = self.table.get(hint).elem
        # a plain read of an `@T` operand is a load: the operator sees the `T` (§15.1), except
        # that checked arithmetic never applies to an atomic: a checked update is a `cas` loop
        let raw_lt = try self.check_expr(l, context)
        if self.table.kind(raw_lt) == types.Kind.atomic and (op == "+?" or op == "-?" or op == "*?"):
            return try self.fail(e, "checked arithmetic does not apply to an atomic; write a `cas` loop (§15.1)")
        let lt = self.plain_read(raw_lt)
        if (op == "+" or op == "-") and self.table.kind(lt) == types.Kind.pointer:
            # `p + n`, `p - n`, and `p - q` (§6.5): element-scaled, unchecked
            let rt = try self.check_expr(r, types.usize_id)
            if op == "-" and self.table.kind(rt) == types.Kind.pointer:
                if self.table.get(lt).elem != self.table.get(rt).elem:
                    return try self.fail(e, "pointer difference needs one pointee type")
                return types.isize_id
            if rt == types.untyped_int_id:
                discard(try self.coerce(r, rt, types.usize_id))
                return lt
            if rt != types.usize_id and rt != types.isize_id and not self.table.widens(rt, types.usize_id) and not self.table.widens(rt, types.isize_id):
                return try self.fail(e, "a pointer offset is `usize` or `isize`")
            return lt
        var rhint = lt
        if lt == types.untyped_int_id or lt == types.untyped_float_id or lt == types.none_id:
            rhint = context
        let rt = self.plain_read(try self.check_expr(r, rhint))
        var t = try self.unify(l, lt, r, rt)
        # two untyped literals under a typed context compute in that type: `3 -| 7` as `u8`
        if is_arithmetic(op) and t == types.untyped_int_id and self.table.is_integer(context):
            discard(try self.coerce(l, lt, context))
            discard(try self.coerce(r, rt, context))
            t = context
        elif is_arithmetic(op) and (t == types.untyped_int_id or t == types.untyped_float_id) and self.table.is_float(context):
            discard(try self.coerce(l, lt, context))
            discard(try self.coerce(r, rt, context))
            t = context
        if op == "==" or op == "!=":
            # `x == none` asks whether an optional holds a value, whatever the payload (§11.1)
            if (is_none_literal(l) or is_none_literal(r)) and self.table.kind(t) == types.Kind.optional:
                return types.bool_id
            if not self.comparable(t):
                return try self.fail(e, "these values have no equality")
            return types.bool_id
        if op == "<" or op == "<=" or op == ">" or op == ">=":
            if self.table.kind(t) == types.Kind.pointer:
                return types.bool_id    # the total order of addresses (§5.3)
            if not (t == types.untyped_int_id or t == types.untyped_float_id or self.table.is_numeric(t) or t == types.char_id or t == types.str_id or self.table.kind(t) == types.Kind.param):
                return try self.fail(e, "ordering needs numbers or text")
            return types.bool_id
        if op == "&" or op == "|" or op == "^":
            if t == types.untyped_int_id or self.table.is_integer(t) or t == types.bool_id or self.is_backed_enum(t):
                return t
            return try self.fail(e, "bit operators need integers")
        if op == "/":
            if t == types.untyped_float_id or self.table.is_float(t):
                return t
            if t == types.untyped_int_id or self.table.is_integer(t):
                return try self.fail(e, "integer division is `//`")
            return try self.fail(e, "arithmetic needs numbers")
        if op == "//" or op == "%":
            if t == types.untyped_int_id or self.table.is_integer(t):
                return t
            return try self.fail(e, "`//` and `%` need integers")
        if op == "+" or op == "-" or op == "*":
            if t == types.untyped_int_id or t == types.untyped_float_id or self.table.is_numeric(t):
                return t
            return try self.fail(e, "arithmetic needs numbers")
        if op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|":
            if t == types.untyped_int_id or self.table.is_integer(t):
                return t
            return try self.fail(e, "wrapping and saturating arithmetic need integers")
        if op == "+?" or op == "-?" or op == "*?":
            if t == types.untyped_int_id or self.table.is_integer(t):
                var base = self.concrete(t)
                if t == types.untyped_int_id and self.table.is_integer(context):
                    base = context
                    discard(try self.coerce(l, lt, base))
                    discard(try self.coerce(r, rt, base))
                return try self.table.optional(base)
            return try self.fail(e, "checked arithmetic needs integers")
        return try self.fail(e, "unknown operator")

    pub func is_backed_enum(id: u32) -> bool:
        let t = self.table.get(id)
        if t.kind != types.Kind.enum_:
            return false
        let d = t.decl else return false
        return d.ty != none

    ## Types with `==` (§7.4).
    ## `==` exists where every component supports it; unions and views never do (§7.4).
    func comparable(id: u32) -> bool:
        let t = self.table.get(id)
        if id == types.untyped_int_id or id == types.untyped_float_id or id == types.none_id:
            return true
        match t.kind:
            .union_, .interface_, .func_, .span, .module, .fmt_, .error_value:
                return false
            .array, .optional, .atomic:
                return self.comparable(t.elem)
            .tuple:
                for a in t.args:
                    if not self.comparable(a):
                        return false
                return true
            .param:
                return self.has_written_constraint(id, self.standard_type("luce", "Equatable"))
            .struct_, .enum_:
                let d = t.decl else return true
                var cursor = d.body
                while let m = cursor:
                    if m.kind == ast.Kind.field and not self.comparable(m.type_id):
                        return false
                    if m.kind == ast.Kind.enum_case:
                        var payload = m.body
                        while let p = payload:
                            if not self.comparable(p.type_id):
                                return false
                            payload = p.next
                    cursor = m.next
                return true
            _:
                return true

    mutating func index_type(e: ast.Node*) -> u32!:
        let owner = e.left else return try self.fail(e, "missing operand")
        let index = e.body else return try self.fail(e, "missing index")
        let raw = try self.check_expr(owner, types.none_id)
        let ot = self.deref(raw)
        var t = self.table.get(ot)
        let through = self.table.get(raw)
        if through.kind == types.Kind.pointer and through.elem != types.void_id and self.table.kind(through.elem) != types.Kind.span:
            # `p[i]` on a pointer: element-scaled by the pointee and unchecked, an array
            # pointee included, so `rows[n][i]` reads row `n` (§7.7)
            t = through
        elif t.kind != types.Kind.span and t.kind != types.Kind.array:
            let pointee = self.table.get(raw)
            if pointee.kind == types.Kind.pointer and pointee.elem != types.void_id:
                t = pointee
            elif ot == types.str_id:
                return try self.fail(e, "`str` is not indexed; slice `.bytes` or iterate")
            else:
                return try self.fail(e, "indexing needs a span, an array, or a pointer")
        var it = try self.check_expr(index, types.usize_id)
        if it == types.char_id and index.kind == ast.Kind.literal and index.text.bytes[0] == '\'' and check_decode_char(index.text) < 128:
            index.type_id = types.usize_id    # `table['P']`: an ASCII literal in an integer context (§4.4)
            it = types.usize_id
        if not (it == types.untyped_int_id or self.table.is_integer(it)):
            return try self.fail(index, "an index is an integer")
        discard(try self.coerce(index, it, types.usize_id if it == types.untyped_int_id else it))
        # the element is a copy: a `str` read from a local table views its own text, not
        # the frame; only `&a[i]` and a slice view the array (§6.6)
        return t.elem

    mutating func slice_type(e: ast.Node*) -> u32!:
        let owner = e.left else return try self.fail(e, "missing operand")
        let ot = self.deref(try self.check_expr(owner, types.none_id))
        let t = self.table.get(ot)
        if let start = e.body:
            let st = try self.check_expr(start, types.usize_id)
            if not (st == types.untyped_int_id or self.table.is_integer(st)):
                return try self.fail(start, "a slice bound is an integer")
            discard(try self.coerce(start, st, types.usize_id if st == types.untyped_int_id else st))
        if let end = e.right:
            let et = try self.check_expr(end, types.usize_id)
            if not (et == types.untyped_int_id or self.table.is_integer(et)):
                return try self.fail(end, "a slice bound is an integer")
            discard(try self.coerce(end, et, types.usize_id if et == types.untyped_int_id else et))
        # a span or str of a local array names the frame; a slice of a tainted view stays tainted
        if self.is_local_value(owner) or (t.kind == types.Kind.array and self.place_is_local(owner)):
            self.mark_local(e)
        if t.kind == types.Kind.span:
            return ot
        if t.kind == types.Kind.array:
            return try self.table.span(t.elem, not self.is_mutable_place(owner))
        if ot == types.str_id:
            return try self.fail(e, "slice `text.bytes`, not the text")
        return try self.fail(e, "slicing needs a span or an array")

    ## A pointer's pointee for member access and indexing; anything else unchanged.
    func deref(id: u32) -> u32:
        let t = self.table.get(id)
        if t.kind == types.Kind.pointer and t.elem != types.void_id:
            return t.elem
        return id

    mutating func tuple_type(e: ast.Node*, hint: u32) -> u32!:
        let n = ast.count(e.body)
        let h = self.table.get(hint)
        var members = try alloc u32[n]
        var i: usize = 0
        var cursor = e.body
        while let m = cursor:
            var mh = types.none_id
            if h.kind == types.Kind.tuple and i < h.args.length:
                mh = h.args[i]
            let mt = try self.check_expr(m, mh)
            members[i] = try self.coerce(m, mt, mh) if mh != types.none_id else self.concrete(mt)
            if members[i] == types.none_id:
                return try self.fail(m, "`none` needs a type")
            i += 1
            cursor = m.next
        return try self.table.tuple(members)

    mutating func array_type(e: ast.Node*, hint: u32) -> u32!:
        let n = ast.count(e.body)
        if n == 0:
            return try self.fail(e, "an array literal needs at least one element (§5.4)")
        let h = self.table.get(hint)
        var elem = types.none_id
        if h.kind == types.Kind.array or h.kind == types.Kind.span:
            elem = h.elem
        var cursor = e.body
        while let m = cursor:
            let mt = try self.check_expr(m, elem)
            if elem == types.none_id:
                elem = self.concrete(mt)
                if elem == types.none_id:
                    return try self.fail(m, "`none` needs a type")
            discard(try self.coerce(m, mt, elem))
            cursor = m.next
        return try self.table.array(elem, (u64)n)

    ## `(a, b) => body`: parameters come from the written types or the expected function type.
    mutating func lambda_type(e: ast.Node*, hint: u32) -> u32!:
        let h = self.table.get(hint)
        let n = ast.count(e.right)
        var params = try types.no_args()
        if n > 0:
            params = try alloc u32[n]
        let saved_floor = self.lambda_floor
        let saved_self = self.self_type
        self.lambda_floor = self.scope.count
        self.self_type = types.none_id
        self.push_scope()
        var i: usize = 0
        var cursor = e.right
        while let p = cursor:
            var pt = types.none_id
            if let t = p.ty:
                pt = try self.resolve_type(t)
            elif h.kind == types.Kind.func_ and i < h.args.length:
                pt = h.args[i]
            else:
                return try self.fail(p, "this parameter needs a type")
            p.type_id = pt
            params[i] = pt
            try self.bind(p, p.text, pt, p, false)
            i += 1
            cursor = p.next
        let body = e.body else return try self.fail(e, "a lambda needs a body")
        var want = types.none_id
        if h.kind == types.Kind.func_:
            want = h.elem
        let saved_result = self.result_type
        let saved_fallible = self.fallible
        self.result_type = want
        self.fallible = self.table.kind(want) == types.Kind.fallible
        let bt = try self.check_expr(body, want)
        var result = self.concrete(bt)
        if want != types.none_id:
            result = try self.coerce(body, bt, want)
            result = want
        self.result_type = saved_result
        self.fallible = saved_fallible
        self.pop_scope()
        self.lambda_floor = saved_floor
        self.self_type = saved_self
        let fn_type = try self.table.function(params, result, false)
        e.resolved = try self.hoist_lambda(e, body, fn_type)
        return fn_type

    ## A lambda is a hidden module function (§9.6): its parameters, a body of one `return`,
    ## and no captures. The backends emit it as any other function of the module.
    mutating func hoist_lambda(e: ast.Node*, body: ast.Node*, fn_type: u32) -> ast.Node*!:
        let fn = try ast.Node.make(ast.Kind.func_, try self.lambda_name(), e.start, e.line)
        fn.flags |= ast.flag_lambda | ast.flag_referenced
        fn.right = e.right
        fn.type_id = fn_type
        let ret = try ast.Node.make(ast.Kind.return_, "", body.start, body.line)
        ret.left = body
        ret.type_id = types.never_id
        let block = try ast.Node.make(ast.Kind.block, "", body.start, body.line)
        block.body = ret
        fn.body = block
        self.hoist(fn)
        return fn

    ## A synthesised function joins the module's declarations, after the last one.
    mutating func hoist(fn: ast.Node*):
        let tree = self.modules.get(self.current).tree
        var cursor = tree.body
        var last: ast.Node*? = none
        while let d = cursor:
            last = d
            cursor = d.next
        if let l = last:
            l.next = fn
        else:
            tree.body = fn

    ## A named function where a fallible function type is wanted (§9.4): the name comes to
    ## mean a hoisted function of the wanted type that calls the named one and answers its
    ## result as success. Only a declaration can be wrapped this way; a function value
    ## held in a variable has no name to wrap.
    mutating func wrap_as_fallible(e: ast.Node*, want: u32) -> !:
        let f = e.resolved else return try self.fail(e, "only a named function converts to a fallible function type")
        if f.kind != ast.Kind.func_ and f.kind != ast.Kind.extern_func:
            return try self.fail(e, "only a named function converts to a fallible function type")
        let fn = try ast.Node.make(ast.Kind.func_, try self.hidden_name("__thunk"), e.start, e.line)
        fn.flags |= ast.flag_lambda | ast.flag_referenced | ast.flag_fallible
        fn.type_id = want
        var params: ast.Node*? = none
        var params_tail: ast.Node*? = none
        var args: ast.Node*? = none
        var args_tail: ast.Node*? = none
        var cursor = f.right
        while let p = cursor:
            let np = try ast.Node.make(ast.Kind.param, p.text, e.start, e.line)
            np.type_id = p.type_id
            np.ty = p.ty
            ast.append(&params, &params_tail, np)
            let use = try ast.Node.make(ast.Kind.name, p.text, e.start, e.line)
            use.type_id = p.type_id
            use.resolved = np
            let a = try ast.Node.make(ast.Kind.argument, "", e.start, e.line)
            a.left = use
            a.type_id = p.type_id
            ast.append(&args, &args_tail, a)
            cursor = p.next
        fn.right = params
        let callee = try ast.Node.make(ast.Kind.name, f.text, e.start, e.line)
        callee.type_id = f.type_id
        callee.resolved = f
        let call = try ast.Node.make(ast.Kind.call, "", e.start, e.line)
        call.left = callee
        call.body = args
        call.resolved = f
        call.type_id = self.table.get(f.type_id).elem
        let ret = try ast.Node.make(ast.Kind.return_, "", e.start, e.line)
        ret.left = call
        ret.type_id = types.never_id
        let block = try ast.Node.make(ast.Kind.block, "", e.start, e.line)
        block.body = ret
        fn.body = block
        self.hoist(fn)
        e.resolved = fn
        e.text = fn.text
        e.type_id = want

    ## `__lambda1`, `__lambda2`, ...: names no source can spell.
    mutating func lambda_name() -> str!:
        return try self.hidden_name("__lambda")

    ## `prefix` followed by a fresh number: a name no source can spell.
    mutating func hidden_name(prefix: str) -> str!:
        self.lambda_count += 1
        var digits: u8[12]
        var n = self.lambda_count
        var k: usize = 0
        while true:
            digits[k] = (u8)48 + (u8)(n % 10)
            k += 1
            n = n // 10
            if n == 0:
                break
        var out = try alloc u8[prefix.length + k]
        memory.copy(out, prefix.bytes, prefix.length)
        var j: usize = 0
        while j < k:
            out[prefix.length + j] = digits[k - 1 - j]
            j += 1
        return (str)out[..<prefix.length + k]

    ## `x else y`: the payload of an optional or fallible `x`, or `y` (§11.1).
    mutating func else_type(e: ast.Node*, hint: u32) -> u32!:
        let l = e.left else return try self.fail(e, "missing operand")
        let r = e.right else return try self.fail(e, "`else` needs an alternative")
        var lt = self.plain_read(try self.check_expr(l, try self.table.optional(hint) if hint != types.none_id else types.none_id))
        let t = self.table.get(lt)
        if t.kind == types.Kind.fallible:
            return try self.fail(l, "`else` takes an optional; a fallible result takes `try` or `catch` (§11.2)")
        if t.kind != types.Kind.optional:
            return try self.fail(l, "`else` needs an optional")
        let payload = t.elem
        if r.kind == ast.Kind.return_ or r.kind == ast.Kind.break_ or r.kind == ast.Kind.continue_:
            try self.check_stmt(r)
            r.type_id = types.never_id
            return payload
        let rt = try self.check_expr(r, payload)
        discard(try self.coerce(r, rt, payload))
        return payload

    ## `x catch name:` handles the failure of `x`; the handler recovers or leaves.
    mutating func catch_type(e: ast.Node*) -> u32!:
        let l = e.left else return try self.fail(e, "missing operand")
        let body = e.body else return try self.fail(e, "`catch` needs a handler")
        let lt = try self.check_expr(l, types.none_id)
        let t = self.table.get(lt)
        if t.kind != types.Kind.fallible:
            return try self.fail(l, "`catch` needs a fallible value")
        if self.is_local_value(l):
            self.mark_local(e)    # the handled value still views what it viewed (§6.6)
        self.push_scope()
        if e.text.length > 0:
            try self.bind(e, e.text, types.error_value_id, e, false)
        let saved_in = self.in_catch
        let saved_result = self.catch_result
        self.in_catch = true
        self.catch_result = t.elem
        try self.check_block(body)
        self.in_catch = saved_in
        self.catch_result = saved_result
        self.pop_scope()
        # a handler for a value recovers one or leaves; one for `unit` may fall through (§11.4)
        if t.elem != types.unit_id and not handler_leaves(body):
            discard(try self.fail(e, "a `catch` handler must `recover` a value or leave with `return`, `error`, `trap`, `break`, or `continue`"))
        return t.elem

    ## `(T)x`: C's cast, with every case defined (§7.5).
    mutating func cast_type(e: ast.Node*) -> u32!:
        let t = e.ty else return try self.fail(e, "a cast needs a type")
        let inner = e.left else return try self.fail(e, "a cast needs an operand")
        if t.body == none and t.left == none and t.flags == 0 and scalar_id(t.text) == types.none_id and self.bracket_value_decl(t.text) != none:
            # `(NPtr) * n`: the parenthesised name is a value, the operator a binary one (§7.5)
            if inner.kind == ast.Kind.unary and (inner.text == "*" or inner.text == "-"):
                let l = try self.bracket_name_expr(t)
                e.kind = ast.Kind.binary
                e.text = inner.text
                e.ty = none
                e.left = l
                e.right = inner.left
                return try self.check_expr(e, types.none_id)
            return try self.fail(t, "that name is a value, not a type")
        let want = try self.resolve_type(t)
        let got = try self.check_expr(inner, types.none_id)
        # a reinterpreting cast of a local address keeps it local: `(str)local_bytes` (§6.6)
        let local_array = self.table.kind(got) == types.Kind.array and self.place_is_local(inner)
        if (self.is_local_value(inner) or local_array) and self.escapes(want):
            self.mark_local(e)
        var have = self.concrete(got)
        if got == types.untyped_int_id and inner.kind == ast.Kind.literal:
            # a bare literal past `i64` is `u64` under a cast: `(u64)18446744073709551615`
            if try decode_integer(inner.text) > 9223372036854775807:
                have = types.u64_id
        if got == types.untyped_int_id or got == types.untyped_float_id:
            discard(try self.coerce(inner, got, have))
        if have == want:
            return want
        let s = self.table.get(have)
        let d = self.table.get(want)
        let s_num = self.table.is_numeric(have) or have == types.char_id
        let d_num = self.table.is_numeric(want) or want == types.char_id
        if s_num and d_num:
            return want
        # `(i32)flag` is 0 or 1 and `(bool)n` is `n != 0`, as in C (§7.5); the cast is
        # written, since `bool` has no implicit numeric conversion (§5.1)
        if have == types.bool_id and self.table.is_integer(want):
            return want
        if self.table.is_integer(have) and want == types.bool_id:
            return want
        if self.is_backed_enum(have) and self.table.is_integer(want):
            return want
        if self.table.is_integer(have) and self.is_backed_enum(want):
            return want
        if s.kind == types.Kind.pointer and d.kind == types.Kind.pointer:
            return want
        if s.kind == types.Kind.pointer and d.kind == types.Kind.optional and self.table.kind(d.elem) == types.Kind.pointer:
            return want
        if s.kind == types.Kind.optional and self.table.kind(s.elem) == types.Kind.pointer and d.kind == types.Kind.pointer:
            return try self.fail(e, "a nullable pointer needs `if let`, not a cast")
        if self.table.is_integer(have) and (d.kind == types.Kind.pointer or (d.kind == types.Kind.optional and self.table.kind(d.elem) == types.Kind.pointer)):
            return want
        if s.kind == types.Kind.pointer and self.table.is_integer(want):
            return want
        if (s.kind == types.Kind.span or s.kind == types.Kind.array) and want == types.str_id:
            if s.elem == types.u8_id:
                return want
        if have == types.str_id and want == types.cstr_id:
            return want
        if have == types.cstr_id and want == types.str_id:
            return want
        # `c.str` is a pointer to C text; it converts to and from object pointers
        if have == types.cstr_id and d.kind == types.Kind.pointer:
            return want
        if s.kind == types.Kind.pointer and want == types.cstr_id:
            return want
        if (s.kind == types.Kind.span or s.kind == types.Kind.array) and d.kind == types.Kind.span:
            # a span keeps its element type: `(u8[])ints` would lie about the length (§7.5)
            if s.elem != d.elem:
                return try self.fail(e, "a cast cannot change a span's element type; slice the bytes through a pointer")
            return want
        if s.kind == types.Kind.func_ and d.kind == types.Kind.pointer and d.elem == types.void_id:
            return want
        if s.kind == types.Kind.pointer and s.elem == types.void_id and d.kind == types.Kind.func_:
            return want
        if s.kind == types.Kind.pointer and d.kind == types.Kind.interface_:
            return try self.fail(e, "an interface view is formed by assignment, not a cast")
        return try self.mismatch(e, want, have)

    ## `.case` or `.case(args)` of the enum the context expects.
    mutating func case_type(e: ast.Node*, hint: u32) -> u32!:
        let h = self.table.get(hint)
        var enum_id = hint
        if h.kind == types.Kind.optional:
            enum_id = h.elem
        if self.table.kind(enum_id) != types.Kind.enum_:
            return try self.fail(e, "`.case` needs an enum type from the context")
        let d = self.table.get(enum_id).decl else return try self.fail(e, "no enum here")
        let case_decl = find_member(d, e.text, ast.Kind.enum_case) else return try self.fail(e, "no such case")
        e.resolved = case_decl
        if case_decl.body != none or e.body != none:
            try self.check_payload(e, case_decl, enum_id, d)
        return enum_id

    ## The arguments of a payload case against its declared parameters.
    mutating func check_payload(at: ast.Node*, case_decl: ast.Node*, enum_id: u32, d: ast.Node*) -> !:
        let instance = self.table.get(enum_id)
        var param = case_decl.body
        var arg = at.body
        while let p = param:
            let a = arg else return try self.fail(at, "this case needs more arguments")
            let v = a.left else return try self.fail(a, "empty argument")
            if a.text.length > 0 and a.text != p.text:
                discard(try self.fail(a, "argument name does not match the case"))
            let want = try self.substitute(p.type_id, d, instance.args)
            discard(try self.expect(v, want))
            param = p.next
            arg = a.next
        if arg != none:
            discard(try self.fail(at, "too many arguments for this case"))

    ## `new T(...)`, `new T`, `new T[n]`, `new Kind.case(...)`, with `in allocator`.
    mutating func new_type(e: ast.Node*) -> u32!:
        let t = e.ty else return try self.fail(e, "`new` needs a type")
        if let alloc_in = e.right:
            try self.check_allocator(alloc_in)
        if t.has(ast.flag_array):
            let inner = t.left else return try self.fail(t, "an array needs an element type")
            let count = t.right else return try self.fail(t, "`new T[n]` needs a count")
            let elem = try self.resolve_type(inner)
            try self.storable(elem, inner)
            if not self.table.zeroable(elem):
                return try self.fail(t, "`new T[count]` zeroes its elements, so `T` must be zeroable; use `alloc`")
            discard(try self.expect(count, types.usize_id))
            t.type_id = try self.table.span(elem, false)
            return try self.table.fallible(t.type_id)
        let id = try self.resolve_type(t)
        try self.storable(id, t)
        let pointer = try self.table.pointer(id, false, false)
        if let body = e.body:
            if body.kind == ast.Kind.case_value:
                body.type_id = try self.case_type(body, id)
            else:
                discard(try self.construct(e, id, e.body))
        elif not self.table.zeroable(id):
            return try self.fail(e, "`new T` needs a zeroable type; give it arguments")
        return try self.table.fallible(pointer)

    ## `alloc T[n]` and `alloc(size, alignment)`.
    mutating func alloc_type(e: ast.Node*) -> u32!:
        if let alloc_in = e.right:
            try self.check_allocator(alloc_in)
        if let t = e.ty:
            if not t.has(ast.flag_array):
                return try self.fail(t, "`alloc` takes `T[count]`")
            let inner = t.left else return try self.fail(t, "an array needs an element type")
            let count = t.right else return try self.fail(t, "`alloc T[n]` needs a count")
            let elem = try self.resolve_type(inner)
            discard(try self.expect(count, types.usize_id))
            t.type_id = try self.table.span(elem, false)
            return try self.table.fallible(t.type_id)
        var args = e.body
        let size = args else return try self.fail(e, "`alloc(size, alignment)` takes two arguments")
        let sv = size.left else return try self.fail(e, "empty argument")
        discard(try self.expect(sv, types.usize_id))
        let align = size.next else return try self.fail(e, "`alloc(size, alignment)` takes two arguments")
        let av = align.left else return try self.fail(e, "empty argument")
        discard(try self.expect(av, types.usize_id))
        return try self.table.fallible(try self.table.span(types.u8_id, false))

    ## `in x` and `with x:` name an allocator: a `var` implementing `Allocator`,
    ## a pointer to one, or an `Allocator` view.
    mutating func check_allocator(e: ast.Node*) -> !:
        let got = try self.check_expr(e, types.none_id)
        let t = self.table.get(got)
        if t.kind == types.Kind.interface_:
            let d = t.decl else return
            if d.text == "Allocator":
                return
        var conc = got
        if t.kind == types.Kind.pointer:
            conc = t.elem
        let concrete_type = self.table.get(conc)
        if concrete_type.kind == types.Kind.struct_ or concrete_type.kind == types.Kind.param:
            let d = concrete_type.decl else return try self.fail(e, "this is not an allocator")
            if self.implements_named(conc, "Allocator"):
                if t.kind != types.Kind.pointer and not self.is_mutable_place(e):
                    discard(try self.fail(e, "an allocator must be a `var`"))
                return
        discard(try self.fail(e, "this is not an allocator"))

    func implements_named(id: u32, name: str) -> bool:
        let t = self.table.get(id)
        let d = t.decl else return false
        if t.kind == types.Kind.param:
            let g = self.generic_param_node(id) else return false
            var bound = g.body
            while let constraint = bound:
                if let cd = self.table.get(constraint.type_id).decl:
                    if cd.text == name:
                        return true
                bound = constraint.next
            return false
        var listed = d.ty if d.kind != ast.Kind.enum_ else d.right
        while let l = listed:
            if let ld = self.table.get(l.type_id).decl:
                if ld.text == name:
                    return true
            listed = l.next
        return false

    # mark: Members ============================================================================

    ## `x.name`: a field, method, case, static member, module member, or a
    ## builtin member of a span, `str`, or `Error`.
    mutating func member_type(e: ast.Node*) -> u32!:
        let owner = e.left else return try self.fail(e, "missing operand")
        let name = e.text
        let as_callee = self.calling
        self.calling = false
        # `luce.location` and its pieces are compile-time facts, not members
        if owner.kind == ast.Kind.name and owner.text == "luce":
            if let b = self.lookup("luce"):
                self.note_origin(b)
                owner.type_id = b.type_id
                owner.resolved = b.decl
                if name == "location":
                    return try self.location_type()
                if name == "file" or name == "function":
                    return types.str_id
                if name == "line":
                    return types.u32_id
        let raw = try self.check_expr(owner, types.none_id)
        if owner.has(ast.flag_type_ref):
            return try self.static_member(e, owner, raw)
        let ot = self.table.get(raw)
        if ot.kind == types.Kind.module:
            let m = ot.decl else return try self.fail(e, "no module")
            if self.is_c_module(m) and c_type_id(name) != types.none_id:
                e.flags |= ast.flag_type_ref
                return c_type_id(name)
            let d = find_decl(m, name) else return try self.fail(e, "no such public name in that module")
            if not d.has(ast.flag_pub):
                return try self.fail(e, "that name is not public")
            e.resolved = d
            if d.kind == ast.Kind.constant and d.type_id == types.none_id:
                let saved = self.current
                try self.check_constant_in(m, d)
                self.current = saved
            if is_type_decl(d) or d.kind == ast.Kind.type_alias:
                e.flags |= ast.flag_type_ref
                if d.kind == ast.Kind.type_alias and d.type_id == types.none_id:
                    let target = d.ty else return try self.fail(e, "an alias needs a type")
                    d.type_id = try self.resolve_type(target)
                if let t = e.ty:
                    let named = try ast.Node.make(ast.Kind.type_, name, e.start, e.line)
                    named.body = t.body
                    named.resolved = d
                    return try self.instantiate_node(named, d)
            return d.type_id
        let id = self.deref(raw)
        let t = self.table.get(id)
        if t.kind == types.Kind.span or t.kind == types.Kind.array:
            if name == "length":
                return types.usize_id
            if name == "data":
                return try self.table.pointer(t.elem, t.is_const, false)
            if name == "first" or name == "last" or name == "indexed":
                let span = id if t.kind == types.Kind.span else try self.table.span(t.elem, false)
                return try self.builtin_method(e, span, name)
            return try self.fail(e, "spans have `length`, `data`, `first()`, `last()`, and `indexed()`")
        if id == types.str_id:
            if name == "length":
                return types.usize_id
            if name == "bytes":
                return try self.table.span(types.u8_id, true)
            if name == "compare":
                return try self.builtin_method(e, types.str_id, name)
            return try self.fail(e, "`str` has `length`, `bytes`, and `compare`")
        if id == types.error_value_id:
            if name == "code":
                return types.error_code_id
            if name == "message":
                return types.str_id
            return try self.fail(e, "an `Error` has `code` and `message`")
        if self.table.is_float(id) and name == "bits":
            return try self.builtin_method(e, id, name)
        if t.kind == types.Kind.struct_ or t.kind == types.Kind.union_ or t.kind == types.Kind.enum_:
            let d = t.decl else return try self.fail(e, "no declaration")
            if let f = find_member(d, name, ast.Kind.field):
                e.resolved = f
                if not f.has(ast.flag_pub) and not self.same_module(d) and not self.inside(d):
                    return try self.fail(e, "that field is not public")
                if self.is_local_value(owner) and self.table.kind(owner.type_id) != types.Kind.pointer:
                    self.mark_local(e)    # a field read through a pointer is not the pointer (§6.6)
                return try self.substitute(f.type_id, d, t.args)
            if let m = find_member(d, name, ast.Kind.func_):
                if m.has(ast.flag_static):
                    return try self.fail(e, "a static method is called through the type")
                if not as_callee:
                    # `value.member` without `()` is always a field (§9.5)
                    return try self.fail(e, "a method is called; write `name()`")
                e.resolved = m
                if not m.has(ast.flag_pub) and not self.same_module(d) and not self.inside(d):
                    return try self.fail(e, "that method is not public")
                return try self.substitute(m.type_id, d, t.args)
            if t.kind == types.Kind.enum_ and find_member(d, name, ast.Kind.enum_case) != none:
                return try self.fail(e, "a case is named through the type, `Kind.case`")
            return try self.fail(e, "no such member")
        if t.kind == types.Kind.interface_:
            let d = t.decl else return try self.fail(e, "no declaration")
            let m = find_member(d, name, ast.Kind.func_) else return try self.fail(e, "the interface has no such method")
            e.resolved = m
            return try self.substitute(m.type_id, d, t.args)
        if name == "compare" and (self.table.is_numeric(id) or id == types.char_id or id == types.str_id):
            return try self.builtin_method(e, id, name)
        if t.kind == types.Kind.param:
            let g = self.generic_param_node(id) else return try self.fail(e, "no such member")
            var bound = g.body
            while let constraint = bound:
                let ct = self.table.get(constraint.type_id)
                if let cd = ct.decl:
                    if let m = find_member(cd, name, ast.Kind.func_):
                        e.resolved = m
                        let fn = try self.substitute(m.type_id, cd, ct.args)
                        if is_derived_bound(cd):
                            # `compare(other: void*)` in the prelude is `compare(other: T)` here
                            return try self.with_self_arguments(fn, id)
                        return fn
                bound = constraint.next
            return try self.fail(e, "no constraint of this parameter has that method")
        if t.kind == types.Kind.pointer and t.elem == types.void_id:
            return try self.fail(e, "`void*` has no members")
        return try self.fail(e, "this value has no members")

    func all_params(ids: u32[]) -> bool:
        for id in ids:
            if self.table.kind(id) != types.Kind.param:
                return false
        return ids.length > 0

    ## The instance of generic `d` whose parameters the construction's values imply.
    mutating func infer_construction(e: ast.Node*, d: ast.Node*, generic_count: usize) -> u32!:
        var inferred = try alloc u32[generic_count]
        var j: usize = 0
        while j < generic_count:
            inferred[j] = types.none_id
            j += 1
        var cursor = e.body
        var positional = d.body
        while let a = cursor:
            let v = a.left else return try self.fail(a, "empty argument")
            var field: ast.Node*? = none
            if a.text.length > 0:
                field = find_member(d, a.text, ast.Kind.field)
            else:
                while let p = positional:
                    if p.kind == ast.Kind.field:
                        break
                    positional = p.next
                field = positional
                if let p = positional:
                    positional = p.next
            let f = field else return try self.fail(a, "no field with that name")
            var got = try self.check_expr(v, types.none_id if self.mentions_param(f.type_id) else f.type_id)
            got = self.concrete(got) if got != types.none_id else got
            try self.infer(f.type_id, got, d, inferred)
            cursor = a.next
        j = 0
        while j < generic_count:
            if inferred[j] == types.none_id:
                return try self.fail(e, "a type argument could not be inferred; write `Name[T](...)`")
            j += 1
        let holder = try ast.Node.make(ast.Kind.type_, "", e.start, e.line)
        var tail: ast.Node*? = none
        j = 0
        while j < generic_count:
            let node = try ast.Node.make(ast.Kind.type_, "", e.start, e.line)
            node.type_id = inferred[j]
            ast.append(&holder.body, &tail, node)
            j += 1
        e.ty = holder
        return try self.table.nominal(self.table.kind(d.type_id), d, inferred)

    ## A function type with every `void*` parameter replaced by `self_id`.
    mutating func with_self_arguments(fn: u32, self_id: u32) -> u32!:
        let f = self.table.get(fn)
        var params = try alloc u32[f.args.length if f.args.length > 0 else 1]
        var i: usize = 0
        while i < f.args.length:
            let a = self.table.get(f.args[i])
            params[i] = self_id if a.kind == types.Kind.pointer and a.elem == types.void_id else f.args[i]
            i += 1
        return try self.table.function(params[..<f.args.length], f.elem, false)

    ## `ErrorCode.package(n)` becomes the literal `(identity << 16) | n` (§11.3): the identity is
    ## sixteen bits of the package's name, `luce` for the standard modules, so that no two
    ## packages share a code and the backends see a plain constant.
    mutating func fold_package_code(e: ast.Node*) -> !:
        let argument = e.body else return try self.fail(e, "`ErrorCode.package` takes a code")
        let v = argument.left else return try self.fail(e, "`ErrorCode.package` takes a code")
        if v.kind != ast.Kind.literal:
            return try self.fail(v, "`ErrorCode.package` takes an integer literal")
        let code = try decode_integer(v.text)
        if code > 65535:
            return try self.fail(v, "an error code is at most 65535; the package's identity takes the high half")
        let name = "luce" if self.in_prelude() else self.package_name
        let full = ((u64)package_identity(name) << 16) | code
        for known in self.package_codes.span():
            if known == full:
                return try self.fail(v, "two constants of one package share this error code (§11.3)")
        try self.package_codes.push(full)
        var digits = try alloc u8[24]
        v.text = try format(digits, f"{full}")

    ## The unsigned integer as wide as the float `id`: the type its `bits` are (§7.5).
    pub func bits_type(id: u32) -> u32:
        let width = self.table.bits(id)
        return types.u16_id if width == 16 else (types.u32_id if width == 32 else types.u64_id)

    ## The function type of a method taken through its type: `self` is its first parameter,
    ## `const Self*` unless the method is `mutating` (§9.5).
    mutating func method_as_function(ft: u32, owner: u32, writes: bool) -> u32!:
        let f = self.table.get(ft)
        var params = try alloc u32[f.args.length + 1]
        params[0] = try self.table.pointer(owner, not writes, false)
        var i: usize = 0
        while i < f.args.length:
            params[i + 1] = f.args[i]
            i += 1
        return try self.table.function(params, f.elem, f.variadic)

    ## `Type.name`: a static method, an enum case, `ErrorCode.package`, `f32.bits`.
    mutating func static_member(e: ast.Node*, owner: ast.Node*, id: u32) -> u32!:
        let name = e.text
        let t = self.table.get(id)
        if id == types.error_code_id and name == "package":
            if not self.at_top_level:
                return try self.fail(e, "`ErrorCode.package` only initialises a top-level constant")
            e.flags |= ast.flag_static
            return try self.table.function(try one_arg(types.u32_id), types.error_code_id, false)
        if self.table.is_float(id) and name == "bits":
            let bits = self.bits_type(id)
            e.flags |= ast.flag_static
            return try self.table.function(try one_arg(bits), id, false)
        if t.kind == types.Kind.enum_:
            let d = t.decl else return try self.fail(e, "no declaration")
            if let case_decl = find_member(d, name, ast.Kind.enum_case):
                e.resolved = case_decl
                if case_decl.body != none:
                    # a payload case is a constructor
                    e.flags |= ast.flag_static
                    return try self.case_constructor(case_decl, d, t.args)
                return id
        if t.kind == types.Kind.struct_ or t.kind == types.Kind.enum_ or t.kind == types.Kind.union_:
            let d = t.decl else return try self.fail(e, "no declaration")
            let m = find_member(d, name, ast.Kind.func_) else return try self.fail(e, "no such static member")
            if not m.has(ast.flag_pub) and not self.same_module(d) and not self.inside(d):
                return try self.fail(e, "that method is not public")
            e.resolved = m
            e.flags |= ast.flag_static
            let ft = try self.substitute(m.type_id, d, t.args)
            if not m.has(ast.flag_static):
                # `Point.distance` through its type is a function taking the receiver first (§5.6)
                return try self.method_as_function(ft, id, m.has(ast.flag_mutating))
            return ft
        return try self.fail(e, "this type has no such member")

    ## The function type that builds a payload case.
    mutating func case_constructor(case_node: ast.Node*, d: ast.Node*, args: u32[]) -> u32!:
        let n = ast.count(case_node.body)
        var params = try types.no_args()
        if n > 0:
            params = try alloc u32[n]
        var i: usize = 0
        var cursor = case_node.body
        while let p = cursor:
            params[i] = try self.substitute(p.type_id, d, args)
            i += 1
            cursor = p.next
        let result = d.type_id if args.length == 0 else try self.table.nominal(types.Kind.enum_, d, args)
        return try self.table.function(params, result, false)

    ## Function types for the builtin methods of spans and floats.
    mutating func builtin_method(e: ast.Node*, id: u32, name: str) -> u32!:
        let t = self.table.get(id)
        e.flags |= ast.flag_static
        if name == "first" or name == "last":
            return try self.table.function(try types.no_args(), try self.table.optional(t.elem), false)
        if name == "indexed":
            var pair = try alloc u32[2]
            pair[0] = types.usize_id
            pair[1] = t.elem
            let tuple = try self.table.tuple(pair)
            return try self.table.function(try types.no_args(), try self.table.span(tuple, true), false)
        if name == "bits":
            let bits = self.bits_type(id)
            return try self.table.function(try types.no_args(), bits, false)
        if name == "compare":
            # numbers, `char`, and `str` order themselves (§14.4)
            var one = try alloc u32[1]
            one[0] = id
            return try self.table.function(one, types.i64_id, false)
        return try self.fail(e, "no such builtin member")

    mutating func location_type() -> u32!:
        let ii = self.find_module("io") else return try self.fail_now("the `io` module is missing")
        let io_tree = self.modules.get(ii).tree
        let d = find_decl(io_tree, "Location") else return try self.fail_now("`io.Location` is missing")
        return d.type_id

    func fail_now(what: str) -> never!:
        error(unsupported, what)

    ## Whether `d` was declared in the module being checked.
    func same_module(d: ast.Node*) -> bool:
        let m = self.modules.get(self.current)
        var cursor = m.tree.body
        while let x = cursor:
            if x == d:
                return true
            cursor = x.next
        return false

    ## Whether the body being checked belongs to `d`.
    func inside(d: ast.Node*) -> bool:
        let own = self.self_decl() else return false
        return own == d

    mutating func check_constant_in(m: ast.Node*, d: ast.Node*) -> !:
        var i: usize = 0
        while i < self.modules.count:
            if self.modules.get(i).tree == m:
                let saved = self.current
                self.current = i
                # the other module's names are not in scope; a constant initialiser
                # may only use literals and names from its own module, so check it there
                self.push_scope()
                try self.bind_standard()
                try self.bind_imports(m)
                try self.collect(m)
                try self.check_constant(d)
                self.pop_scope()
                self.current = saved
                return
            i += 1

    mutating func instantiate_node(named: ast.Node*, d: ast.Node*) -> u32!:
        let n = ast.count(named.body)
        if ast.count(generic_params_of(d)) != n:
            return try self.fail(named, "wrong number of type arguments")
        var args = try alloc u32[n]
        var i: usize = 0
        var cursor = named.body
        while let a = cursor:
            args[i] = try self.resolve_type(a)
            i += 1
            cursor = a.next
        try self.check_constraints(d, args, named)
        return try self.table.nominal(self.table.kind(d.type_id), d, args)

    # mark: Calls ==============================================================================

    ## `f(args)`: an intrinsic, a conversion, a construction, or a call of a
    ## function, method, or function value.
    mutating func call_type(e: ast.Node*, hint: u32) -> u32!:
        let callee = e.left else return try self.fail(e, "missing callee")
        if callee.kind == ast.Kind.name and self.lookup(callee.text) == none:
            if is_intrinsic(callee.text):
                return try self.intrinsic_type(e, callee.text)
        if callee.kind == ast.Kind.member:
            if let receiver = callee.left:
                if receiver.kind != ast.Kind.name or self.lookup(receiver.text) != none:
                    let rt = try self.check_expr(receiver, types.none_id)
                    if self.table.kind(self.deref(rt)) == types.Kind.atomic:
                        return try self.atomic_call(e, callee, self.deref(rt))
        self.calling = callee.kind == ast.Kind.member
        let ct = try self.check_expr(callee, types.none_id)
        self.calling = false
        if callee.kind == ast.Kind.member and callee.has(ast.flag_static) and callee.text == "package" and is_error_code_type(callee.left):
            let answered = try self.check_call(e, ct, none, none, none, try types.no_args(), hint)
            try self.fold_package_code(e)
            return answered
        if let resolved = callee.resolved:
            if resolved.kind == ast.Kind.enum_case and callee.kind == ast.Kind.member:
                # `Kind.case(args)`: the payload's parameters take named or positional arguments
                let enum_id = self.table.get(ct).elem
                let d = self.table.get(enum_id).decl else return try self.fail(e, "no enum")
                e.resolved = resolved
                try self.check_payload(e, resolved, enum_id, d)
                return enum_id
        if callee.has(ast.flag_type_ref):
            return try self.construct_or_convert(e, callee, ct)
        let t = self.table.get(ct)
        if t.kind != types.Kind.func_:
            return try self.fail(callee, "this is not callable")
        # the declaration behind the callee, for names, defaults, and generics
        var decl: ast.Node*? = callee.resolved
        var owner_args = try types.no_args()
        var owner: ast.Node*? = none
        if callee.kind == ast.Kind.member:
            if let receiver = callee.left:
                let rt = self.table.get(self.deref(receiver.type_id))
                if rt.kind == types.Kind.struct_ or rt.kind == types.Kind.enum_ or rt.kind == types.Kind.union_ or rt.kind == types.Kind.interface_:
                    owner = rt.decl
                    owner_args = rt.args
                if let m = callee.resolved:
                    if m.kind == ast.Kind.func_ and m.has(ast.flag_mutating) and not callee.has(ast.flag_static):
                        try self.require_mutable_receiver(receiver)
                if callee.has(ast.flag_static) and callee.resolved == none:
                    decl = none
        if let d = decl:
            if d.kind != ast.Kind.func_ and d.kind != ast.Kind.extern_func:
                decl = none
        e.resolved = decl
        return try self.check_call(e, ct, decl, e.ty if e.ty != none else callee.ty, owner, owner_args, hint)

    ## The operations of an `@T` (§15.1): read-modify-write methods returning the
    ## previous value, `load`, `store`, `cas`, `wait`, and `wake`. An omitted
    ## ordering is `seq_cst`.
    mutating func atomic_call(e: ast.Node*, callee: ast.Node*, atomic_id: u32) -> u32!:
        let name = callee.text
        let elem = self.table.get(atomic_id).elem
        let ordering = try self.ordering_type()
        callee.flags |= ast.flag_static
        callee.type_id = atomic_id
        var args = e.body
        var given: usize = 0
        while let a = args:
            given += 1
            args = a.next
        if name == "load":
            if given > 1:
                return try self.fail(e, "`load(order)` takes at most one argument")
            if given == 1:
                try self.expect_argument(e, 0, ordering)
            return elem
        if name == "store":
            if given < 1 or given > 2:
                return try self.fail(e, "`store(value, order)` takes one or two arguments")
            try self.expect_argument(e, 0, elem)
            if given == 2:
                try self.expect_argument(e, 1, ordering)
            return types.unit_id
        if name == "add" or name == "sub" or name == "set" or name == "clear" or name == "flip" or name == "max" or name == "min" or name == "swap":
            if given < 1 or given > 2:
                return try self.fail(e, "this atomic method takes a value and an optional ordering")
            if name != "swap" and not self.table.is_integer(elem):
                return try self.fail(e, "this atomic method needs an integer atomic")
            try self.expect_argument(e, 0, elem)
            if given == 2:
                try self.expect_argument(e, 1, ordering)
            return elem
        if name == "cas":
            if given < 2 or given > 5:
                return try self.fail(e, "`cas(expected, desired, success, failure, weak)` takes two to five arguments")
            try self.expect_argument(e, 0, elem)
            try self.expect_argument(e, 1, elem)
            if given >= 3:
                try self.expect_argument(e, 2, ordering)
            if given >= 4:
                try self.expect_argument(e, 3, ordering)
                # the failure ordering is never `release` or `acq_rel`, nor stronger than success
                let failure = argument_at(e, 3) else return try self.fail(e, "no failure ordering")
                if failure.kind == ast.Kind.case_value and (failure.text == "release" or failure.text == "acq_rel"):
                    return try self.fail(failure, "the failure ordering of `cas` may not be `release` or `acq_rel` (§15.1)")
                if let success = argument_at(e, 2):
                    if ordering_rank(failure) > ordering_rank(success):
                        return try self.fail(failure, "the failure ordering of `cas` may not be stronger than the success ordering (§15.1)")
            if given == 5:
                try self.expect_argument(e, 4, types.bool_id)
            var pair = try alloc u32[2]
            pair[0] = types.bool_id
            pair[1] = elem
            return try self.table.tuple(pair)
        if name == "wait":
            if given != 1:
                return try self.fail(e, "`wait(expected)` takes one argument")
            try self.expect_argument(e, 0, elem)
            return types.unit_id
        if name == "wake":
            if given != 1:
                return try self.fail(e, "`wake(count)` takes one argument")
            try self.expect_argument(e, 0, types.u32_id)
            return types.unit_id
        return try self.fail(callee, "an atomic has add, sub, set, clear, flip, max, min, swap, load, store, cas, wait, and wake")

    ## The `atomic.Ordering` enum from the prelude.
    mutating func ordering_type() -> u32!:
        let ai = self.find_module("atomic") else return try self.fail_now("the `atomic` module is missing")
        let tree = self.modules.get(ai).tree
        let d = find_decl(tree, "Ordering") else return try self.fail_now("`atomic.Ordering` is missing")
        return d.type_id

    ## Check the `index`th argument of a call against `want`.
    mutating func expect_argument(e: ast.Node*, index: usize, want: u32) -> !:
        var i: usize = 0
        var args = e.body
        while let a = args:
            if i == index:
                if a.text.length > 0:
                    discard(try self.fail(a, "this argument is positional"))
                let v = a.left else return try self.fail(a, "empty argument")
                discard(try self.expect(v, want))
                return
            i += 1
            args = a.next
        discard(try self.fail(e, "missing argument"))

    ## A `mutating` call needs a `var`, a mutable pointer, or a mutable element (§9.5).
    mutating func require_mutable_receiver(receiver: ast.Node*) -> !:
        let rt = self.table.get(receiver.type_id)
        if rt.kind == types.Kind.pointer:
            if rt.is_const:
                discard(try self.fail(receiver, "a mutating method needs a mutable pointer"))
            return
        if rt.kind == types.Kind.interface_:
            return
        if not self.is_mutable_place(receiver):
            discard(try self.fail(receiver, "a mutating method needs a `var` receiver"))

    ## Match arguments to parameters, infer generic arguments, and yield the result.
    mutating func check_call(e: ast.Node*, fn: u32, decl: ast.Node*?, explicit: ast.Node*?, owner: ast.Node*?, owner_args: u32[], hint: u32) -> u32!:
        let f = self.table.get(fn)
        var generic_count: usize = 0
        var template: ast.Node*? = none
        if let d = decl:
            generic_count = ast.count(generic_params_of(d))
            if generic_count > 0:
                template = d
        var inferred = try types.no_args()
        if generic_count > 0:
            inferred = try alloc u32[generic_count]
            var i: usize = 0
            while i < generic_count:
                inferred[i] = types.none_id
                i += 1
            if let ex = explicit:
                let n = ast.count(ex.body)
                if n != generic_count:
                    return try self.fail(ex, "wrong number of type arguments")
                var cursor = ex.body
                var j: usize = 0
                while let a = cursor:
                    inferred[j] = try self.resolve_type(a)
                    j += 1
                    cursor = a.next
        # first pass: bind positional and named arguments to parameters and type them
        let n_params = f.args.length
        var slots = try alloc ast.Node*?[n_params + 1]
        var i: usize = 0
        while i <= n_params:
            slots[i] = none
            i += 1
        var position: usize = 0
        var cursor = e.body
        var extra = 0
        while let a = cursor:
            if a.text.length > 0:
                let d = decl else return try self.fail(a, "named arguments need a declared function")
                let index = param_index(d, a.text) else return try self.fail(a, "no parameter with that name")
                if slots[index] != none:
                    return try self.fail(a, "this argument is given twice")
                slots[index] = a
            elif position < n_params:
                slots[position] = a
                position += 1
            elif f.variadic:
                extra += 1
                let v = a.left else return try self.fail(a, "empty argument")
                let vt = try self.check_expr(v, types.none_id)
                let ck = self.table.kind(vt)
                if vt == types.str_id and v.kind == ast.Kind.literal and v.text.bytes[0] == '"':
                    # a text literal passes as `c.str`, the way C's own literals do (§17.2)
                    discard(try self.coerce(v, vt, types.cstr_id))
                elif ck == types.Kind.span or ck == types.Kind.interface_ or ck == types.Kind.tuple or ck == types.Kind.array or vt == types.str_id or vt == types.fmt_id or (ck == types.Kind.optional and not self.table.is_nullable_pointer(vt)):
                    # C's `...` carries scalars, pointers, and records only (§17.2)
                    return try self.fail(v, "this type cannot be a variadic argument; C has no shape for it; text goes as `c.str`")
                else:
                    discard(try self.coerce(v, vt, types.i32_id if vt == types.untyped_int_id else self.concrete(vt)))
            else:
                return try self.fail(a, "too many arguments")
            cursor = a.next
        i = 0
        while i < n_params:
            var want = f.args[i]
            if let t = template:
                if self.mentions_param(want):
                    want = types.none_id
            if let a = slots[i]:
                let v = a.left else return try self.fail(a, "empty argument")
                var got = try self.check_expr(v, want)
                if let t = template:
                    if want == types.none_id:
                        got = self.concrete(got) if got != types.none_id else got
                        try self.infer(f.args[i], got, t, inferred)
            else:
                let d = decl else return try self.fail(e, "too few arguments")
                let p = param_at(d, i) else return try self.fail(e, "too few arguments")
                let default = p.left else return try self.fail(e, "a required argument is missing")
                if is_luce_fact(default):
                    try self.expand_fact_argument(e, p, default)
            i += 1
        if let t = template:
            var j: usize = 0
            while j < generic_count:
                if inferred[j] == types.none_id:
                    return try self.fail(e, "a type argument could not be inferred; write it")
                j += 1
            try self.check_constraints(t, inferred, e)
            if let here = self.current_func:
                if here == t:
                    var k: usize = 0
                    var own = generic_params_of(t)
                    while let g = own:
                        if k < generic_count and inferred[k] != g.type_id and self.mentions_param(inferred[k]):
                            return try self.fail(e, "an infinite chain of instantiations: the call nests its own type parameter")
                        k += 1
                        own = g.next
        # second pass: coerce each argument to its (substituted) parameter type
        i = 0
        while i < n_params:
            var want = f.args[i]
            if let t = template:
                want = try self.substitute(want, t, inferred)
            if let a = slots[i]:
                let v = a.left else return try self.fail(a, "empty argument")
                if v.type_id == types.none_id or v.type_id == types.untyped_int_id or v.type_id == types.untyped_float_id or self.mentions_param(want) == false:
                    discard(try self.coerce(v, v.type_id if v.type_id != types.none_id else try self.check_expr(v, want), want))
            i += 1
        var result = f.elem
        if let t = template:
            result = try self.substitute(result, t, inferred)
            # the instance the backend must build: the arguments as type nodes on the call
            if explicit == none:
                let holder = try ast.Node.make(ast.Kind.type_, "", e.start, e.line)
                var tail: ast.Node*? = none
                var j: usize = 0
                while j < generic_count:
                    let a = try ast.Node.make(ast.Kind.type_, "", e.start, e.line)
                    a.type_id = inferred[j]
                    ast.append(&holder.body, &tail, a)
                    j += 1
                e.ty = holder
        discard(owner)
        discard(owner_args)
        discard(hint)
        discard(extra)
        return result

    ## Does `id` mention a generic parameter type anywhere?
    func mentions_param(id: u32) -> bool:
        let t = self.table.get(id)
        match t.kind:
            .param:
                return true
            .pointer, .span, .array, .optional, .fallible, .atomic:
                return self.mentions_param(t.elem)
            .tuple, .func_, .struct_, .enum_, .union_, .interface_:
                var i: usize = 0
                while i < t.args.length:
                    if self.mentions_param(t.args[i]):
                        return true
                    i += 1
                if t.kind == types.Kind.func_:
                    return self.mentions_param(t.elem)
                return false
            _:
                return false

    ## `T(x)` on a type: a checked conversion for scalars and integer-backed enums,
    ## a construction for structs, a payload case for enums.
    mutating func construct_or_convert(e: ast.Node*, callee: ast.Node*, id: u32) -> u32!:
        var target = id
        if let ex = callee.ty:
            if callee.kind == ast.Kind.name:
                target = id
        if let ex = e.ty:
            # `List[T](...)`: the type arguments sit on the call
            let d = self.table.get(id).decl else return try self.fail(e, "this type takes no type arguments")
            let named = try ast.Node.make(ast.Kind.type_, callee.text, e.start, e.line)
            named.body = ex.body
            target = try self.instantiate_node(named, d)
            callee.type_id = target
        let t = self.table.get(target)
        if self.table.is_numeric(target) or target == types.char_id:
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            let have = self.concrete(got)
            if got == types.untyped_int_id or got == types.untyped_float_id:
                discard(try self.coerce(arg, got, have))
            if not (self.table.is_numeric(have) or have == types.char_id or have == types.bool_id):
                return try self.fail(arg, "a checked conversion takes a number")
            if is_negative_literal(arg) and self.table.is_integer(target) and not self.table.is_signed(target):
                # a conversion the compiler can prove impossible is an error (§7.5)
                return try self.fail(arg, "a negative literal never fits an unsigned type")
            return target
        if target == types.str_id:
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            let s = self.table.get(got)
            if (s.kind == types.Kind.span or s.kind == types.Kind.array) and s.elem == types.u8_id:
                return try self.table.fallible(types.str_id)
            if got == types.cstr_id:
                return try self.table.fallible(types.str_id)
            return try self.fail(arg, "`str(x)` takes bytes or a C string")
        if t.kind == types.Kind.enum_ and self.is_backed_enum(target):
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            if not (got == types.untyped_int_id or self.table.is_integer(got)):
                return try self.fail(arg, "an enum conversion takes an integer")
            discard(try self.coerce(arg, got, self.concrete(got)))
            return target
        if t.kind == types.Kind.struct_:
            let d = t.decl else return try self.fail(e, "no declaration")
            let generic_count = ast.count(generic_params_of(d))
            if generic_count > 0 and t.args.length == 0 and not self.inside(d):
                return try self.fail(e, "this type needs type arguments, `Name[T](...)`")
            if generic_count > 0 and e.ty == none and not self.inside(d) and self.all_params(t.args):
                # `Pair(key = 1, value = 2)`: the arguments come from the fields' values
                let instance = try self.infer_construction(e, d, generic_count)
                callee.type_id = instance
                return try self.construct(e, instance, e.body)
            return try self.construct(e, target, e.body)
        if t.kind == types.Kind.union_:
            return try self.fail(e, "a union is built by assigning one member")
        return try self.fail(e, "this type cannot be called")

    func single_argument(e: ast.Node*) -> ast.Node*!:
        let a = e.body else return try self.fail(e, "one argument is needed")
        if a.next != none:
            return try self.fail(e, "one argument is needed")
        let v = a.left else return try self.fail(e, "empty argument")
        return v

    ## `Name(field = value, ...)`: the memberwise initialiser, positional or named,
    ## or the struct's own `init` (§10.1). Yields the struct, or `Name!` when
    ## `init` is fallible.
    mutating func construct(e: ast.Node*, id: u32, args: ast.Node*?) -> u32!:
        let t = self.table.get(id)
        let d = t.decl else return try self.fail(e, "no declaration")
        if let init = find_member(d, "init", ast.Kind.func_):
            e.resolved = init
            let fn = try self.substitute(init.type_id, d, t.args)
            discard(try self.check_call(e, fn, init, none, d, t.args, types.none_id))
            if init.has(ast.flag_fallible):
                return try self.table.fallible(id)
            return id
        var cursor = args
        var positional = d.body
        var named = false
        while let a = cursor:
            let v = a.left else return try self.fail(a, "empty argument")
            var field: ast.Node*? = none
            if a.text.length > 0:
                named = true
                field = find_member(d, a.text, ast.Kind.field)
                if field == none:
                    return try self.fail(a, "no field with that name")
                var earlier = args
                while let o = earlier:
                    if o == a:
                        break
                    if o.text == a.text:
                        return try self.fail(a, "this field is given twice")
                    earlier = o.next
            else:
                if named:
                    return try self.fail(a, "a positional value cannot follow a named one")
                while let p = positional:
                    if p.kind == ast.Kind.field:
                        break
                    positional = p.next
                let p = positional else return try self.fail(a, "too many values for this struct")
                field = p
                positional = p.next
            let f = field else return try self.fail(a, "no field")
            a.text = f.text
            if not f.has(ast.flag_pub) and not self.same_module(d) and not self.inside(d):
                return try self.fail(a, "that field is not public")
            let want = try self.substitute(f.type_id, d, t.args)
            discard(try self.expect(v, want))
            a.resolved = f
            cursor = a.next
        # a field with a default or a zero value may be omitted; every other field is required
        var member = d.body
        while let f = member:
            if f.kind == ast.Kind.field and f.left == none and not self.table.zeroable(try self.substitute(f.type_id, d, t.args)):
                if not argument_names(args, f, d):
                    return try self.fail(e, "a required field is missing")
            member = f.next
        return id

    # -- intrinsics -----------------------------------------------------------------------

    ## The core functions (§3.5): typed here, never declared.
    mutating func intrinsic_type(e: ast.Node*, name: str) -> u32!:
        if name == "print":
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            if got != types.str_id and got != types.fmt_id:
                return try self.fail(arg, "`print` takes text or a formatted string")
            return types.unit_id
        if name == "format":
            let first = e.body else return try self.fail(e, "`format(buffer, text)` takes two arguments")
            let bv = first.left else return try self.fail(e, "empty argument")
            discard(try self.expect(bv, try self.table.span(types.u8_id, false)))
            let second = first.next else return try self.fail(e, "`format(buffer, text)` takes two arguments")
            let tv = second.left else return try self.fail(e, "empty argument")
            let got = try self.check_expr(tv, types.none_id)
            if got != types.str_id and got != types.fmt_id:
                return try self.fail(tv, "`format` takes text or a formatted string")
            # the returned text views the buffer: a local array, or a span derived from one, makes
            # the result local (§6.6); a span variable or parameter views memory elsewhere
            if self.is_local_value(bv) or (self.table.kind(bv.type_id) == types.Kind.array and self.place_is_local(bv)):
                self.mark_local(e)
            return try self.table.fallible(types.str_id)
        if name == "assert":
            let first = e.body else return try self.fail(e, "`assert` needs a condition")
            let cv = first.left else return try self.fail(e, "empty argument")
            discard(try self.expect(cv, types.bool_id))
            if let second = first.next:
                let mv = second.left else return try self.fail(e, "empty argument")
                discard(try self.expect(mv, types.str_id))
            return types.unit_id
        if name == "trap":
            if let first = e.body:
                let mv = first.left else return try self.fail(e, "empty argument")
                let got = try self.check_expr(mv, types.none_id)
                if got != types.str_id and got != types.fmt_id:
                    return try self.fail(mv, "`trap` takes text")
            return types.never_id
        if name == "error":
            if not self.fallible:
                return try self.fail(e, "`error` is only valid in a fallible function, in a handler or not")
            let first = e.body else return try self.fail(e, "`error(code, message)` takes two arguments")
            let cv = first.left else return try self.fail(e, "empty argument")
            discard(try self.expect(cv, types.error_code_id))
            let second = first.next else return try self.fail(e, "`error(code, message)` takes two arguments")
            let mv = second.left else return try self.fail(e, "empty argument")
            discard(try self.expect(mv, types.str_id))
            if self.is_local_value(mv):
                discard(try self.fail(mv, "an error message must not name a local; format into a buffer that outlives the function"))
            return types.never_id
        if name == "discard":
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            if self.table.kind(got) == types.Kind.fallible:
                return try self.fail(arg, "a fallible result must be handled before it is discarded")
            return types.unit_id
        if name == "hash":
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            if self.table.kind(got) == types.Kind.param:
                if not self.has_written_constraint(got, self.standard_type("luce", "Hashable")):
                    return try self.fail(arg, "a type parameter hashes only under `Hashable`")
            elif not self.comparable(got):
                return try self.fail(arg, "this value is not hashable")
            discard(try self.coerce(arg, got, self.concrete(got)))
            return types.u64_id
        if name == "hex" or name == "bin":
            let arg = try self.single_argument(e)
            let got = try self.check_expr(arg, types.none_id)
            if not (got == types.untyped_int_id or self.table.is_integer(got)):
                return try self.fail(arg, "`hex` and `bin` take an integer")
            discard(try self.coerce(arg, got, self.concrete(got)))
            return types.fmt_id
        if name == "pad":
            let first = e.body else return try self.fail(e, "`pad(value, width)` takes two arguments")
            let v = first.left else return try self.fail(e, "empty argument")
            let got = try self.check_expr(v, types.none_id)
            if not self.printable(got):
                return try self.fail(v, "this value cannot be formatted")
            discard(try self.coerce(v, got, self.concrete(got)))
            let second = first.next else return try self.fail(e, "`pad(value, width)` takes two arguments")
            let w = second.left else return try self.fail(e, "empty argument")
            discard(try self.expect(w, types.usize_id))
            return types.fmt_id
        if name == "sizeof" or name == "alignof":
            let arg = try self.single_argument(e)
            let id = try self.type_of_argument(arg)
            if name == "alignof" and not arg.has(ast.flag_type_ref):
                return try self.fail(arg, "`alignof` takes a type")
            e.resolved = arg
            discard(id)
            return types.usize_id
        if name == "offsetof":
            let first = e.body else return try self.fail(e, "`offsetof(T, field)` takes two arguments")
            let tv = first.left else return try self.fail(e, "empty argument")
            let id = try self.type_of_argument(tv)
            let second = first.next else return try self.fail(e, "`offsetof(T, field)` takes two arguments")
            let fv = second.left else return try self.fail(e, "empty argument")
            if fv.kind != ast.Kind.name:
                return try self.fail(fv, "`offsetof` names a field")
            let d = self.table.get(id).decl else return try self.fail(tv, "`offsetof` takes a struct")
            let f = find_member(d, fv.text, ast.Kind.field) else return try self.fail(fv, "no such field")
            fv.resolved = f
            return types.usize_id
        return try self.fail(e, "unknown core function")

    # mark: Statements =========================================================================

    mutating func check_block(block: ast.Node*) -> !:
        self.push_scope()
        var cursor = block.body
        while let s = cursor:
            try self.check_stmt(s)
            if let rest = s.next:
                if prune.certainly_leaves(s):
                    var r = self.reporter()
                    try r.warn(rest, "unreachable code")
                    s.next = none
            cursor = s.next
        self.pop_scope()
        var r = self.reporter()
        try prune.prune_block(block, &r)

    mutating func check_stmt(s: ast.Node*) -> !:
        match s.kind:
            .let_, .var_:
                try self.check_binding(s)
            .assign:
                try self.check_assign(s)
            .if_:
                try self.check_if(s)
                if not s.has(ast.flag_if_let):
                    let quiet = try self.fold_condition(s)
                    var r = self.reporter()
                    try prune.fold_constant_branch(s, &r, quiet)
            .while_:
                self.push_scope()
                try self.check_condition(s)
                try self.enter_loop(s)
                let body = s.body else return try self.fail(s, "a loop needs a body")
                try self.check_block(body)
                self.leave_loop(s)
                self.pop_scope()
                if not s.has(ast.flag_if_let):
                    let quiet = try self.fold_condition(s)
                    var r = self.reporter()
                    try prune.fold_constant_branch(s, &r, quiet)
            .for_:
                try self.check_for(s)
            .match_:
                discard(try self.match_type(s, types.none_id, false))
            .return_:
                try self.check_return(s)
            .break_, .continue_:
                if self.loop_depth == 0:
                    discard(try self.fail(s, "not inside a loop"))
                elif s.text.length > 0 and not self.has_label(s.text):
                    discard(try self.fail(s, "no enclosing loop has this label"))
            .defer_, .errdefer_:
                if s.kind == ast.Kind.errdefer_ and not self.fallible:
                    discard(try self.fail(s, "`errdefer` needs a fallible function"))
                let call = s.left else return try self.fail(s, "`defer` needs a call")
                if call.kind == ast.Kind.free_:
                    try self.check_stmt(call)
                    return
                let got = try self.check_expr(call, types.none_id)
                if self.table.kind(got) == types.Kind.fallible:
                    discard(try self.fail(call, "a deferred call must handle its failure with `catch`"))
                if got != types.unit_id and got != types.never_id:
                    discard(try self.fail(call, "a deferred call must produce `unit`; wrap it in `discard`"))
            .recover_:
                if not self.in_catch:
                    discard(try self.fail(s, "`recover` belongs in a `catch` handler"))
                let v = s.left else return try self.fail(s, "`recover` needs a value")
                discard(try self.expect(v, self.catch_result))
            .free_:
                let v = s.left else return try self.fail(s, "`free` needs a value")
                let got = try self.check_expr(v, types.none_id)
                let t = self.table.get(got)
                if t.kind != types.Kind.pointer and t.kind != types.Kind.span:
                    discard(try self.fail(v, "`free` takes a pointer or a span"))
                if let alloc_in = s.right:
                    try self.check_allocator(alloc_in)
            .with_:
                let a = s.left else return try self.fail(s, "`with` names an allocator")
                try self.check_allocator(a)
                let body = s.body else return try self.fail(s, "`with` needs a body")
                try self.check_block(body)
            .expr_stmt:
                let v = s.left else return try self.fail(s, "empty statement")
                let got = try self.check_expr(v, types.none_id)
                if self.table.kind(got) == types.Kind.fallible:
                    discard(try self.fail(v, "a fallible result must be handled: `try`, `catch`, or `else`"))
                if not is_call_statement(v):
                    discard(try self.fail(v, "a statement is a call; an expression whose value is unused is not one (§7.9)"))
            .asm_:
                var operand = s.right
                while let o = operand:
                    if let v = o.left:
                        if v.kind != ast.Kind.name or v.text != "_":
                            discard(try self.check_expr(v, types.none_id))
                    operand = o.next
                try self.check_asm_references(s)
            .block:
                try self.check_block(s)
            _:
                discard(try self.fail(s, "unsupported statement"))

    ## `{name}` in an asm block's text stands for the register the compiler chose for the
    ## `reg` operand whose expression is the name `name` (§8.9); anything else is an error.
    mutating func check_asm_references(s: ast.Node*) -> !:
        var lines = s.body
        while let l = lines:
            let b = l.text.bytes
            var i: usize = 0
            while i < b.length:
                if b[i] == '{':
                    var j = i + 1
                    while j < b.length and b[j] != '}':
                        j += 1
                    if j >= b.length:
                        return try self.fail(l, "an unclosed `{` in assembly text")
                    let name = (str)b[i + 1..<j]
                    if not asm_names_operand(s, name):
                        let message = try format(self.scratch, f"the assembly text names `{name}`, which is not a `reg` operand")
                        return try self.fail(l, message)
                    i = j
                i += 1
            lines = l.next

    ## `let`/`var`, with a name or a tuple of names (§6.1).
    ## Whether `e` is a member of a `packed` struct whose natural alignment exceeds one:
    ## the address C would make undefined to dereference (§5.11).
    func is_packed_field(e: ast.Node*) -> bool:
        if e.kind != ast.Kind.member:
            return false
        let owner = e.left else return false
        let field = e.resolved else return false
        if field.kind != ast.Kind.field:
            return false
        let decl = self.table.get(self.deref(owner.type_id)).decl else return false
        return decl.has(ast.flag_packed) and self.table.align_of(field.type_id) > 1

    ## A loop opens: its label, when it has one, may be neither a core name (§3.5) nor one
    ## of the labels already open around it (§8.5).
    mutating func enter_loop(s: ast.Node*) -> !:
        self.loop_depth += 1
        if s.text.length == 0:
            return
        if token.is_core_name(s.text):
            discard(try self.fail(s, "this name belongs to the language; a label cannot take it (§3.5)"))
        elif self.has_label(s.text):
            discard(try self.fail(s, "this label is already open"))
        if self.label_count < self.labels.length:
            self.labels[self.label_count] = s.text
        self.label_count += 1

    mutating func leave_loop(s: ast.Node*):
        self.loop_depth -= 1
        if s.text.length > 0:
            self.label_count -= 1

    func has_label(name: str) -> bool:
        var i: usize = 0
        while i < self.label_count and i < self.labels.length:
            if self.labels[i] == name:
                return true
            i += 1
        return false

    mutating func check_binding(s: ast.Node*) -> !:
        let mutable = s.kind == ast.Kind.var_
        var declared = types.none_id
        if let t = s.ty:
            declared = try self.resolve_type(t)
            try self.storable(declared, t)
        if s.body != none:
            let init = s.left else return try self.fail(s, "a tuple binding needs a value")
            let got = try self.expect(init, declared)
            let t = self.table.get(got)
            if t.kind != types.Kind.tuple:
                return try self.fail(init, "a tuple binding needs a tuple value")
            if ast.count(s.body) != t.args.length:
                return try self.fail(s, "the number of names does not match the tuple")
            var i: usize = 0
            var cursor = s.body
            while let n = cursor:
                n.type_id = t.args[i]
                if n.text != "_":
                    try self.bind(n, n.text, t.args[i], n, mutable)
                i += 1
                cursor = n.next
            s.type_id = got
            return
        var id = declared
        if declared == types.fmt_id:
            return try self.fail(s, "a formatted string is not stored; `fmt` is a parameter type only (§9.1)")
        if let init = s.left:
            if declared != types.none_id:
                discard(try self.expect(init, declared))
            else:
                let got = try self.check_expr(init, declared)
                id = self.concrete(got)
                if id == types.none_id:
                    return try self.fail(init, "`none` needs a written type")
                if got == types.untyped_int_id or got == types.untyped_float_id:
                    discard(try self.coerce(init, got, id))
                if id == types.fmt_id:
                    return try self.fail(init, "a formatted string is not a value: print it, write it, or format it (§4.4)")
                if id == types.unit_id:
                    return try self.fail(init, "this expression has no value")
                if id == types.never_id:
                    return try self.fail(init, "this expression never yields a value")
                if self.table.kind(id) == types.Kind.fallible:
                    return try self.fail(init, "a fallible result must be handled: `try`, `catch`, or `else`")
                if init.has(ast.flag_type_ref):
                    return try self.fail(init, "a type is not a value")
        elif s.has(ast.flag_uninit):
            if not mutable or declared == types.none_id:
                return try self.fail(s, "`= ---` needs `var` with a written type")
        else:
            if not mutable:
                return try self.fail(s, "a `let` needs a value")
            if declared == types.none_id:
                return try self.fail(s, "a `var` without a value needs a type")
            if not self.table.zeroable(declared):
                return try self.fail(s, "this type has no zero value; give it one")
        s.type_id = id
        try self.bind(s, s.text, id, s, mutable)
        # `let s = &local` or `let s = local_array[..]`: the name inherits the escape taint
        if let init = s.left:
            if self.is_local_value(init) and s.text != "_":
                self.set_from_local(s.text, true)

    mutating func check_assign(s: ast.Node*) -> !:
        let place = s.left else return try self.fail(s, "missing place")
        let value = s.right else return try self.fail(s, "missing value")
        let pt = try self.check_expr(place, types.none_id)
        if not self.is_mutable_place(place):
            if place.kind == ast.Kind.name:
                return try self.fail(place, "cannot assign to a `let`")
            return try self.fail(place, "this place is not mutable")
        if s.text == "=":
            discard(try self.expect(value, pt))
            if self.is_local_value(value) and self.escapes(pt) and not self.place_is_local(place):
                # §6.6: a local's address may not be stored in a global or through a pointer
                discard(try self.fail(value, "this pointer or view names a local and must not be stored where it outlives the function"))
            return
        let target = self.table.get(pt).elem if self.table.kind(pt) == types.Kind.atomic else pt
        let vt = try self.expect(value, target)
        let op = (str)s.text.bytes[..<s.text.length - 1]
        if self.table.kind(pt) == types.Kind.atomic and not (op == "+" or op == "-" or op == "|" or op == "&" or op == "^"):
            return try self.fail(s, "an atomic compound assignment is `+=` `-=` `|=` `&=` or `^=` (§15.1)")
        if op == "<<" or op == ">>":
            if not self.table.is_integer(target):
                discard(try self.fail(s, "a shift needs an integer"))
            return
        if op == "&" or op == "|" or op == "^":
            if not (self.table.is_integer(target) or target == types.bool_id or self.is_backed_enum(target)):
                discard(try self.fail(s, "bit operators need integers"))
            return
        if op == "/":
            if not self.table.is_float(target):
                discard(try self.fail(s, "integer division is `//`"))
            return
        if op == "//" or op == "%" or op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|":
            if not self.table.is_integer(target):
                discard(try self.fail(s, "this operator needs integers"))
            return
        if not self.table.is_numeric(target):
            discard(try self.fail(s, "arithmetic needs numbers"))
        discard(vt)

    ## The condition of `if` and `while`: a `bool`, or `let name = optional`.
    mutating func check_condition(s: ast.Node*) -> !:
        let condition = s.left else return try self.fail(s, "missing condition")
        if s.has(ast.flag_if_let):
            let init = condition.left else return try self.fail(condition, "`let` needs a value")
            let got = self.plain_read(try self.check_expr(init, types.none_id))
            let t = self.table.get(got)
            if t.kind != types.Kind.optional:
                return try self.fail(init, "`if let` needs an optional value")
            condition.type_id = t.elem
            try self.bind(condition, condition.text, t.elem, condition, false)
            return
        discard(try self.expect(condition, types.bool_id))

    mutating func check_if(s: ast.Node*) -> !:
        self.push_scope()
        try self.check_condition(s)
        let body = s.body else return try self.fail(s, "`if` needs a body")
        try self.check_block(body)
        self.pop_scope()
        if let rest = s.right:
            if rest.kind == ast.Kind.if_:
                try self.check_if(rest)
                if not rest.has(ast.flag_if_let):
                    # an `elif` on a constant folds like the `if` it follows (§19.6)
                    let quiet = try self.fold_condition(rest)
                    var r = self.reporter()
                    try prune.fold_constant_branch(rest, &r, quiet)
            else:
                try self.check_block(rest)

    ## `for x in items`, `for (i, x) in items.indexed()`, `for i in a..<b`,
    ## `for c in text`, `for p in &items` (§8.3).
    mutating func check_for(s: ast.Node*) -> !:
        let binding = s.left else return try self.fail(s, "`for` needs a name")
        let iterable = s.right else return try self.fail(s, "`for` needs something to iterate")
        var declared = types.none_id
        if let t = binding.ty:
            declared = try self.resolve_type(t)
        let got = try self.check_expr(iterable, declared)
        let t = self.table.get(got)
        var elem = types.none_id
        if t.kind == types.Kind.span or t.kind == types.Kind.array:
            elem = t.elem
            if s.has(ast.flag_by_pointer):
                let const_elem = t.is_const if t.kind == types.Kind.span else not self.is_mutable_place(iterable)
                elem = try self.table.pointer(t.elem, const_elem, false)
        elif got == types.str_id:
            elem = types.char_id
        elif self.iterator_method(got) != none:
            return try self.desugar_iterable_for(s, binding, iterable)
        else:
            return try self.fail(iterable, "`for` iterates a span, an array, a range, text, or an Iterable")
        self.push_scope()
        if binding.body != none:
            let et = self.table.get(elem)
            if et.kind != types.Kind.tuple:
                return try self.fail(binding, "a tuple of names needs tuple elements; use `.indexed()`")
            if ast.count(binding.body) != et.args.length:
                return try self.fail(binding, "the number of names does not match the element")
            var i: usize = 0
            var cursor = binding.body
            while let n = cursor:
                n.type_id = et.args[i]
                if n.text != "_":
                    try self.bind(n, n.text, et.args[i], n, false)
                i += 1
                cursor = n.next
        else:
            if declared != types.none_id and not self.assignable(none, elem, declared):
                return try self.mismatch(binding, declared, elem)
            binding.type_id = elem if declared == types.none_id else declared
            try self.bind(binding, binding.text, binding.type_id, binding, false)
        try self.enter_loop(s)
        let body = s.body else return try self.fail(s, "a loop needs a body")
        try self.check_block(body)
        self.leave_loop(s)
        self.pop_scope()

    ## The `iterator()` method of a struct or enum type, the mark of an Iterable (§14.4).
    func iterator_method(id: u32) -> ast.Node*?:
        let t = self.table.get(id)
        if t.kind != types.Kind.struct_ and t.kind != types.Kind.enum_:
            return none
        let d = t.decl else return none
        return find_member(d, "iterator", ast.Kind.func_)

    ## `for x in source: body` over an Iterable (§8.3) becomes, in its own block,
    ## `var __iterN = source.iterator()` and `while let x = __iterN.next(): body`: the
    ## iterator lives in a hidden local of its concrete type, and the backends see only a
    ## loop they already know.
    mutating func desugar_iterable_for(s: ast.Node*, binding: ast.Node*, sequence: ast.Node*) -> !:
        if binding.body != none:
            return try self.fail(binding, "an Iterable yields one value per step; bind one name")
        let hidden = try self.hidden_name("__iter")
        let start = try ast.Node.make(ast.Kind.var_, hidden, s.start, s.line)
        start.left = try self.method_call(sequence, "iterator", s)
        let advance = try ast.Node.make(ast.Kind.name, hidden, s.start, s.line)
        var step = try ast.Node.make(ast.Kind.let_, binding.text, binding.start, binding.line)
        step.ty = binding.ty
        step.left = try self.method_call(advance, "next", s)
        let loop = try ast.Node.make(ast.Kind.while_, s.text, s.start, s.line)
        loop.flags |= ast.flag_if_let
        loop.left = step
        loop.body = s.body
        start.next = loop
        s.kind = ast.Kind.block
        s.left = none
        s.right = none
        s.body = start
        try self.check_block(s)

    ## The call `receiver.name()` as a fresh tree at `at`'s position.
    func method_call(receiver: ast.Node*, name: str, at: ast.Node*) -> ast.Node*!:
        let member = try ast.Node.make(ast.Kind.member, name, at.start, at.line)
        member.left = receiver
        let call = try ast.Node.make(ast.Kind.call, "", at.start, at.line)
        call.left = member
        return call

    mutating func check_return(s: ast.Node*) -> !:
        let want = self.result_type
        if s.left == none and want != types.unit_id and want != types.none_id:
            discard(try self.fail(s, "this function returns a value"))
        let v = s.left else return
        if want == types.unit_id:
            let got = try self.check_expr(v, types.unit_id)
            if got != types.unit_id and got != types.never_id:
                discard(try self.fail(v, "this function returns nothing"))
            return
        discard(try self.expect(v, want))
        if self.is_local_value(v) and self.escapes(want):
            discard(try self.fail(v, "this pointer or view names a local and must not escape the function"))

    ## `match` as a statement (`is_expr` false) or an expression yielding a type.
    mutating func match_type(m: ast.Node*, hint: u32, is_expr: bool) -> u32!:
        let scrutinee = m.left else return try self.fail(m, "`match` needs a value")
        var st = try self.check_expr(scrutinee, types.none_id)
        if st == types.untyped_int_id or st == types.untyped_float_id:
            st = try self.coerce(scrutinee, st, self.concrete(st))
        var result = hint
        var coverage = Coverage(wildcard = false, some = false, none_ = false, truth = false, falsity = false, cases = 0, seen = 0)
        var arm = m.body
        while let a = arm:
            self.push_scope()
            var pattern = a.left
            var first = true
            while let p = pattern:
                try self.check_pattern(p, st, first)
                try self.note_pattern(p, st, a.right == none, &coverage)
                first = false
                pattern = p.next
            if let guard = a.right:
                discard(try self.expect(guard, types.bool_id))
            let body = a.body else return try self.fail(a, "an arm needs a body")
            if is_expr:
                let bt = try self.check_expr(body, result)
                if result == types.none_id:
                    result = self.concrete(bt) if bt != types.never_id else result
                else:
                    discard(try self.coerce(body, bt, result))
            else:
                try self.check_block(body)
            self.pop_scope()
            arm = a.next
        if is_expr and result == types.none_id:
            return try self.fail(m, "the arms yield no value")
        try self.check_exhaustive(m, st, coverage)
        return result if is_expr else types.unit_id

    ## What the unguarded arms of a `match` cover so far (§8.4): a guarded arm counts for
    ## nothing, since its guard may fail.
    mutating func note_pattern(p: ast.Node*, st: u32, unguarded: bool, coverage: Coverage*) -> !:
        if coverage.wildcard:
            return try self.fail(p, "this pattern is unreachable: an earlier `_` arm takes everything")
        if p.has(ast.flag_wildcard):
            if unguarded:
                coverage.wildcard = true
            return
        let v = p.left else return
        let t = self.table.get(st)
        if v.kind == ast.Kind.case_value and t.kind == types.Kind.optional and v.resolved == none:
            let already = coverage.some if v.text == "some" else coverage.none_
            if already:
                return try self.fail(p, "duplicate pattern")
            if unguarded:
                if v.text == "some":
                    coverage.some = true
                else:
                    coverage.none_ = true
            return
        if v.kind == ast.Kind.case_value:
            let case_decl = v.resolved else return
            let d = self.table.get(v.type_id).decl else return
            let index = case_index(d, case_decl)
            let bit: u64 = (u64(1) << index) if index < 64 else 0
            if (coverage.cases & bit) != 0 and bit != 0:
                return try self.fail(p, "duplicate pattern")
            if unguarded:
                coverage.cases |= bit
            return
        if v.kind == ast.Kind.literal and p.right == none:
            if v.text == "true" or v.text == "false":
                let already = coverage.truth if v.text == "true" else coverage.falsity
                if already:
                    return try self.fail(p, "duplicate pattern")
                if unguarded:
                    if v.text == "true":
                        coverage.truth = true
                    else:
                        coverage.falsity = true
                return
            var i: usize = 0
            while i < coverage.seen and i < coverage.texts.length:
                if coverage.texts[i] == v.text:
                    return try self.fail(p, "duplicate pattern")
                i += 1
            if coverage.seen < coverage.texts.length:
                coverage.texts[coverage.seen] = v.text
            coverage.seen += 1

    ## Every `match` is exhaustive (§8.4): the compiler names what is missing.
    mutating func check_exhaustive(m: ast.Node*, st: u32, coverage: Coverage) -> !:
        if coverage.wildcard:
            return
        let t = self.table.get(st)
        if t.kind == types.Kind.optional:
            if not (coverage.some and coverage.none_):
                discard(try self.fail(m, "`match` on an optional needs `.some` and `.none`, or a `_` arm"))
            return
        if t.kind == types.Kind.enum_ and not self.is_backed_enum(st):
            let d = t.decl else return
            let count = case_count(d)
            var index: usize = 0
            while index < count and index < 64:
                if (coverage.cases & (1 << index)) == 0:
                    return try self.fail(m, "`match` is missing a case; name it or add a `_` arm")
                index += 1
            if count > 64:
                discard(try self.fail(m, "`match` on an enum with more than 64 cases needs a `_` arm"))
            return
        if st == types.bool_id:
            if not (coverage.truth and coverage.falsity):
                discard(try self.fail(m, "`match` on a `bool` needs `true` and `false`, or a `_` arm"))
            return
        if self.is_backed_enum(st):
            return try self.fail(m, "`match` on an integer-backed enum needs a `_` arm: a combination need not be a declared case")
        discard(try self.fail(m, "`match` on this type needs a `_` arm"))

    ## A pattern against the scrutinee type: `_`, `.case(names)`, a literal, a
    ## constant, or a range of literals.
    ## A pattern of an arm; after the first pattern of an arm the names are bound
    ## already and every further pattern must bind the same names to the same types.
    mutating func check_pattern(p: ast.Node*, st: u32, first: bool) -> !:
        if p.has(ast.flag_wildcard):
            p.type_id = st
            return
        let t = self.table.get(st)
        let v = p.left else return try self.fail(p, "empty pattern")
        if v.kind == ast.Kind.case_value and t.kind == types.Kind.optional and (v.text == "some" or v.text == "none"):
            # `.some(name)` and `.none` take an optional apart (§8.4)
            v.type_id = st
            p.type_id = st
            if v.text == "none":
                if v.body != none:
                    return try self.fail(v, "`.none` carries no value")
                return
            let name = v.body else return try self.fail(v, "`.some` binds its value: write `.some(name)`")
            if name.next != none:
                return try self.fail(name, "`.some` carries one value")
            name.type_id = t.elem
            if name.text != "_":
                if first:
                    try self.bind(name, name.text, t.elem, name, false)
                else:
                    let b = self.lookup(name.text) else return try self.fail(name, "every pattern of an arm binds the same names")
                    if b.type_id != t.elem:
                        return try self.fail(name, "a name bound by every pattern of an arm has one type")
                    name.resolved = b.decl
            return
        if v.kind == ast.Kind.case_value:
            var enum_id = st
            if t.kind == types.Kind.optional:
                enum_id = t.elem
            if self.table.kind(enum_id) != types.Kind.enum_:
                return try self.fail(p, "`.case` needs an enum scrutinee")
            let d = self.table.get(enum_id).decl else return try self.fail(p, "no enum")
            let case_decl = find_member(d, v.text, ast.Kind.enum_case) else return try self.fail(v, "no such case")
            v.resolved = case_decl
            v.type_id = enum_id
            var name = v.body
            var param = case_decl.body
            while let n = name:
                let q = param else return try self.fail(n, "this case carries fewer values")
                n.type_id = try self.substitute(q.type_id, d, self.table.get(enum_id).args)
                if n.text != "_":
                    if first:
                        try self.bind(n, n.text, n.type_id, n, false)
                    else:
                        let b = self.lookup(n.text) else return try self.fail(n, "every pattern of an arm binds the same names")
                        if b.type_id != n.type_id:
                            return try self.fail(n, "a name bound by every pattern of an arm has one type")
                        n.resolved = b.decl
                name = n.next
                param = q.next
            if param != none and v.body != none:
                discard(try self.fail(v, "this case carries more values"))
            p.type_id = enum_id
            return
        let vt = try self.check_expr(v, st)
        discard(try self.coerce(v, vt, st))
        if let hi = p.right:
            let ht = try self.check_expr(hi, st)
            discard(try self.coerce(hi, ht, st))
            if not self.table.is_integer(st) and st != types.char_id:
                discard(try self.fail(p, "a range pattern needs integers"))
        p.type_id = st

    # mark: Bodies =============================================================================

    ## Check the body of a top-level declaration.
    mutating func check_declaration(d: ast.Node*) -> !:
        match d.kind:
            .func_:
                if not d.has(ast.flag_lambda):
                    try self.check_function(d, none)
            .constant:
                if d.type_id == types.none_id or d.ty != none:
                    d.type_id = types.none_id
                    try self.check_constant(d)
            .global:
                if let init = d.left:
                    let saved = self.at_top_level
                    self.at_top_level = true
                    discard(try self.expect(init, d.type_id))
                    self.at_top_level = saved
                    if not self.is_constant(init):
                        discard(try self.fail(init, "a global's initialiser is a constant expression (§6.3)"))
                elif not d.has(ast.flag_uninit) and not self.table.zeroable(d.type_id) and not self.modules.get(self.current).is_prelude:
                    # the startup shim initialises the prelude's own globals (§12.3)
                    discard(try self.fail(d, "this global's type has no zero value; give it one"))
            .struct_, .union_, .enum_:
                try self.check_type_body(d)
            .interface_:
                discard(0)
            .test_:
                try self.check_test(d)
            .assert_:
                let first = d.body else return try self.fail(d, "`assert` needs a condition")
                let cv = first.left else return try self.fail(d, "empty argument")
                discard(try self.expect(cv, types.bool_id))
                if not self.is_constant(cv):
                    discard(try self.fail(cv, "a module-level `assert` needs a constant condition (§6.4)"))
                elif let holds = self.constant_bool(cv):
                    if not holds:
                        var text: u8[256]
                        var reason: str = ""
                        if let second = first.next:
                            if let mv = second.left:
                                if mv.kind == ast.Kind.literal and mv.text.length >= 2:
                                    reason = (str)mv.text.bytes[1..<mv.text.length - 1]
                        discard(try self.fail(cv, try format(text, f"a module-level `assert` failed: {reason}")))
            .extern_func, .extern_type, .extern_var, .extern_struct, .extern_union, .type_alias, .import_, .from_import, .asm_:
                discard(0)
            _:
                discard(try self.fail(d, "unsupported declaration"))

    ## A function or method body, with its parameters and result in place.
    mutating func check_function(f: ast.Node*, owner: ast.Node*?) -> !:
        if f.has(ast.flag_mutating) and f.has(ast.flag_static):
            discard(try self.fail(f, "a static method has no receiver to mutate"))
        self.push_scope()
        try self.bind_generics(f)
        let saved_template = self.checking_template
        if ast.count(generic_params_of(f)) > 0:
            self.checking_template = true
        let saved_func = self.current_func
        let saved_result = self.result_type
        let saved_fallible = self.fallible
        let saved_self = self.self_type
        let saved_self_mutable = self.self_mutable
        let saved_in_init = self.in_init
        let saved_loop = self.loop_depth
        let saved_labels = self.label_count
        self.current_func = f
        self.loop_depth = 0
        self.label_count = 0
        let ft = self.table.get(f.type_id)
        self.fallible = f.has(ast.flag_fallible)
        self.result_type = self.table.get(ft.elem).elem if self.fallible else ft.elem
        if self.result_type == types.fmt_id:
            discard(try self.fail(f, "a function does not return `fmt`; it is a parameter type only (§9.1)"))
        if let o = owner:
            if f.has(ast.flag_static):
                self.self_type = types.none_id
            else:
                self.self_type = o.type_id
                self.self_mutable = f.has(ast.flag_mutating) or f.text == "init"
                self.in_init = f.text == "init"
                if f.has(ast.flag_mutating) and f.has(ast.flag_static):
                    discard(try self.fail(f, "a static method has no receiver to mutate"))
        else:
            self.self_type = types.none_id
        var cursor = f.right
        while let p = cursor:
            if p.text == "self":
                discard(try self.fail(p, "`self` is implicit and cannot be a parameter"))
            if let default = p.left:
                let saved_top = self.at_top_level
                self.at_top_level = true
                discard(try self.expect(default, p.type_id))
                self.at_top_level = saved_top
                if not self.is_constant(default):
                    discard(try self.fail(default, "a default argument is a constant expression (§9.1)"))
            try self.bind(p, p.text, p.type_id, p, p.has(ast.flag_out))
            cursor = p.next
        if let body = f.body:
            try self.check_block(body)
            if let o = owner:
                if f.text == "init" and o.kind == ast.Kind.struct_:
                    if self.result_type != types.unit_id:
                        discard(try self.fail(f, "`init` returns `unit` or `!` (§10.1)"))
                    if let found = init_rules.verify(f, o):
                        discard(try self.fail(found.at, found.what))
            if ast.has_attribute(f, "naked"):
                try self.check_naked_body(body)
            elif self.result_type != types.unit_id and self.result_type != types.never_id and not prune.always_leaves(body):
                discard(try self.fail(f, "this function may reach its end without returning"))
        self.current_func = saved_func
        self.result_type = saved_result
        self.fallible = saved_fallible
        self.self_type = saved_self
        self.self_mutable = saved_self_mutable
        self.in_init = saved_in_init
        self.label_count = saved_labels
        self.loop_depth = saved_loop
        self.checking_template = saved_template
        self.pop_scope()

    ## A struct, union, or enum body: field defaults, case values, conformance, methods.
    mutating func check_type_body(d: ast.Node*) -> !:
        if d.kind == ast.Kind.struct_ and not has_field(d):
            discard(try self.fail(d, "a struct has at least one field, as in C (§10.1)"))
        if d.kind == ast.Kind.union_ and not has_field(d):
            discard(try self.fail(d, "a union has at least one member (§10.4)"))
        self.push_scope()
        try self.bind_generics(d)
        let saved_template = self.checking_template
        if ast.count(generic_params_of(d)) > 0:
            self.checking_template = true
        let saved_self = self.self_type
        self.self_type = d.type_id
        var cursor = d.body
        while let m = cursor:
            match m.kind:
                .field:
                    if let default = m.left:
                        let saved_top = self.at_top_level
                        self.at_top_level = true
                        discard(try self.expect(default, m.type_id))
                        self.at_top_level = saved_top
                    if let layout = m.right:
                        discard(try self.expect(layout, types.usize_id))
                .enum_case:
                    if let value = m.left:
                        let backing = d.ty else return try self.fail(m, "a case value needs `enum Name as T`")
                        discard(try self.expect(value, backing.type_id))
                        if not self.is_constant(value):
                            discard(try self.fail(value, "a case value is a constant"))
                        var earlier = d.body
                        while let o = earlier:
                            if o == m:
                                break
                            if o.kind == ast.Kind.enum_case and case_value(d, o) == case_value(d, m):
                                discard(try self.fail(m, "two cases share one value"))
                            earlier = o.next
                    elif d.ty != none:
                        discard(try self.fail(m, "an integer-backed enum gives every case its value (§10.3)"))
                .func_:
                    try self.check_function(m, d)
                _:
                    discard(0)
            cursor = m.next
        try self.check_conformance(d)
        self.self_type = saved_self
        self.checking_template = saved_template
        self.pop_scope()

    ## Every requirement of each implemented interface is supplied (§14.1).
    mutating func check_conformance(d: ast.Node*) -> !:
        var listed = d.ty if d.kind != ast.Kind.enum_ else d.right
        while let l = listed:
            let it = self.table.get(l.type_id)
            let iface = it.decl else return try self.fail(l, "no interface")
            if iface.has(ast.flag_builtin) and (iface.text == "Equatable" or iface.text == "Hashable"):
                return try self.fail(l, "this protocol is derived from the fields; it is not implemented by hand (§14.4)")
            var req = iface.body
            while let r = req:
                let m = find_member(d, r.text, ast.Kind.func_) else return try self.fail(l, "a required method is missing")
                var want = try self.substitute(r.type_id, iface, it.args)
                if is_derived_bound(iface):
                    # `compare(other: void*)` in the prelude is `compare(other: Self)` here
                    want = try self.with_self_arguments(want, d.type_id)
                if not self.signature_matches(m.type_id, want):
                    return try self.fail(m, "this method does not match the interface's signature")
                if r.has(ast.flag_mutating) != m.has(ast.flag_mutating):
                    return try self.fail(m, "the interface declares this method mutating" if r.has(ast.flag_mutating) else "the interface declares this method non-mutating")
                if r.has(ast.flag_fallible) and not m.has(ast.flag_fallible):
                    try self.witness_thunk(d, m, r, want)
                req = r.next
            listed = l.next

    ## A hidden fallible method `__wit_name` that calls the non-fallible implementation `m`
    ## and answers its result as the requirement's `T!`: what the witness table points at, so
    ## a call through a view has the ABI the requirement declares (§14.1, §14.3).
    mutating func witness_thunk(d: ast.Node*, m: ast.Node*, r: ast.Node*, want: u32) -> !:
        var name_bytes = try alloc u8[r.text.length + 8]
        let fn = try ast.Node.make(ast.Kind.func_, try format(name_bytes, f"__wit_{r.text}"), m.start, m.line)
        fn.flags |= ast.flag_lambda | ast.flag_referenced | ast.flag_fallible | (m.flags & ast.flag_mutating) | ast.flag_pub
        fn.type_id = want
        var params: ast.Node*? = none
        var params_tail: ast.Node*? = none
        var args: ast.Node*? = none
        var args_tail: ast.Node*? = none
        var cursor = m.right
        while let p = cursor:
            let np = try ast.Node.make(ast.Kind.param, p.text, m.start, m.line)
            np.type_id = p.type_id
            np.ty = p.ty
            ast.append(&params, &params_tail, np)
            let use = try ast.Node.make(ast.Kind.name, p.text, m.start, m.line)
            use.type_id = p.type_id
            use.resolved = np
            let a = try ast.Node.make(ast.Kind.argument, "", m.start, m.line)
            a.left = use
            a.type_id = p.type_id
            ast.append(&args, &args_tail, a)
            cursor = p.next
        fn.right = params
        let receiver = try ast.Node.make(ast.Kind.self_, "self", m.start, m.line)
        receiver.type_id = d.type_id
        let callee = try ast.Node.make(ast.Kind.member, m.text, m.start, m.line)
        callee.left = receiver
        callee.type_id = m.type_id
        callee.resolved = m
        let call = try ast.Node.make(ast.Kind.call, "", m.start, m.line)
        call.left = callee
        call.body = args
        call.resolved = m
        let result = self.table.get(m.type_id).elem
        call.type_id = result
        let block = try ast.Node.make(ast.Kind.block, "", m.start, m.line)
        if result == types.unit_id:
            let stmt = try ast.Node.make(ast.Kind.expr_stmt, "", m.start, m.line)
            stmt.left = call
            block.body = stmt
        else:
            let ret = try ast.Node.make(ast.Kind.return_, "", m.start, m.line)
            ret.left = call
            ret.type_id = types.never_id
            block.body = ret
        fn.body = block
        var tail: ast.Node*? = none
        var last = d.body
        while let n = last:
            tail = n
            last = n.next
        ast.append(&d.body, &tail, fn)

    ## Parameters equal; the implementation may be non-fallible where the requirement is fallible.
    func signature_matches(have: u32, want: u32) -> bool:
        if have == want:
            return true
        let h = self.table.get(have)
        let w = self.table.get(want)
        if h.args.length != w.args.length:
            return false
        var i: usize = 0
        while i < h.args.length:
            if h.args[i] != w.args[i]:
                return false
            i += 1
        let wr = self.table.get(w.elem)
        return wr.kind == types.Kind.fallible and wr.elem == h.elem

    ## A test is a fallible body with no parameters (§16.5).
    mutating func check_test(d: ast.Node*) -> !:
        let saved_result = self.result_type
        let saved_fallible = self.fallible
        let saved_func = self.current_func
        self.result_type = types.unit_id
        self.fallible = true
        self.current_func = d
        let body = d.body else return try self.fail(d, "a test needs a body")
        try self.check_block(body)
        self.result_type = saved_result
        self.fallible = saved_fallible
        self.current_func = saved_func

# mark: Tree helpers ===========================================================================

## The top-level declaration named `name` in a module tree.
pub func find_decl(tree: ast.Node*, name: str) -> ast.Node*?:
    var cursor = tree.body
    while let d = cursor:
        if d.text == name and d.kind != ast.Kind.import_ and d.kind != ast.Kind.from_import and d.kind != ast.Kind.test_:
            return d
        cursor = d.next
    return none

## The member of `owner` named `name` with the given kind.
pub func find_member(owner: ast.Node*, name: str, kind: ast.Kind) -> ast.Node*?:
    var cursor = owner.body
    while let m = cursor:
        if m.kind == kind and m.text == name:
            return m
        cursor = m.next
    return none

## The generic parameter list of a declaration, or none.
## The first name in `later` that `earlier` already lists, if any.
func repeated_name(earlier: ast.Node*?, later: ast.Node*?) -> ast.Node*?:
    var cursor = later
    while let item = cursor:
        var known = earlier
        while let k = known:
            if k.text == item.text:
                return item
            known = k.next
        cursor = item.next
    return none

pub func generic_params_of(d: ast.Node*) -> ast.Node*?:
    let l = d.left else return none
    if l.kind != ast.Kind.generic_param:
        return none
    return l.body

## `Equatable`, `Hashable`, and `Comparable` are satisfied by structure, never declared.
func is_derived_bound(d: ast.Node*?) -> bool:
    let decl = d else return false
    if decl.kind != ast.Kind.interface_ or not decl.has(ast.flag_builtin):
        return false
    return decl.text == "Equatable" or decl.text == "Hashable" or decl.text == "Comparable"

func is_type_decl(d: ast.Node*) -> bool:
    return d.kind == ast.Kind.struct_ or d.kind == ast.Kind.enum_ or d.kind == ast.Kind.union_ or d.kind == ast.Kind.interface_ or d.kind == ast.Kind.extern_type or d.kind == ast.Kind.extern_struct or d.kind == ast.Kind.extern_union

## Was field `f` of `d` given among `args`, by name or by position?
func argument_names(args: ast.Node*?, f: ast.Node*, d: ast.Node*) -> bool:
    var cursor = args
    while let a = cursor:
        if a.resolved == f:
            return true
        cursor = a.next
    return false

## Whether asm block `s` has a `reg` operand whose expression is the name `name`.
pub func asm_names_operand(s: ast.Node*, name: str) -> bool:
    var operand = s.right
    while let o = operand:
        if asm_operand_place(o) == "reg":
            if let v = o.left:
                if v.kind == ast.Kind.name and v.text == name:
                    return true
        operand = o.next
    return false

## The register an asm operand names, `x0`, or `reg` for one the compiler chooses.
pub func asm_operand_place(o: ast.Node*) -> str:
    let p = o.body else return ""
    return decode_text(p.text)

## The integer an `enum Name as T` is backed by; `i32` when the enum names none.
pub func enum_backing(table: types.Table*, id: u32) -> u32:
    let d = table.get(id).decl else return types.i32_id
    let backing = d.ty else return types.i32_id
    return backing.type_id

## The value of case `target` of enum `d`: as written, or one more than the case before.
pub func case_value(d: ast.Node*, target: ast.Node*) -> u64:
    var next: u64 = 0
    var cursor = d.body
    while let node = cursor:
        if node.kind == ast.Kind.enum_case:
            var v = next
            if let written = node.left:
                v = written_value(written) else next
            if node == target:
                return v
            next = v +% 1
        cursor = node.next
    return 0

## A case value as written: a literal, possibly grouped or negated.
func written_value(e: ast.Node*) -> u64?:
    if e.kind == ast.Kind.group:
        let inner = e.left else return none
        return written_value(inner)
    if e.kind == ast.Kind.unary and e.text == "-":
        let inner = e.left else return none
        let v = written_value(inner) else return none
        return 0 -% v
    if e.kind == ast.Kind.literal:
        let v = decode_integer(e.text) catch failure:
            return none
        return v
    return none

## The identity of a package's error codes (§11.3): sixteen bits of its name, the same
## computation in every compiler of the language.
pub func package_identity(name: str) -> u32:
    var h: u32 = 2166136261
    for byte in name.bytes:
        h = (h ^ (u32)byte) *% 16777619
    return (h ^ (h >> 16)) & 65535

## How deeply generic instances nest in `id`: `Pair[Pair[i64, i64], i64]` is two. A chain of
## instantiations whose arguments nest past `max_nesting` never ends (§13.1).
pub let max_nesting: u32 = 16

pub func nesting(table: types.Table*, id: u32) -> u32:
    let t = table.get(id)
    match t.kind:
        .struct_, .enum_, .union_:
            var deepest: u32 = 0
            for a in t.args:
                let n = nesting(table, a)
                if n > deepest:
                    deepest = n
            return deepest + 1 if t.args.length > 0 else 0
        .pointer, .span, .array, .optional, .fallible, .atomic:
            return nesting(table, t.elem)
        .tuple, .func_:
            var deepest: u32 = 0
            for a in t.args:
                let n = nesting(table, a)
                if n > deepest:
                    deepest = n
            return deepest
        _:
            return 0

pub func nesting_of_all(table: types.Table*, args: u32[]) -> u32:
    var deepest: u32 = 0
    for a in args:
        let n = nesting(table, a)
        if n > deepest:
            deepest = n
    return deepest

## The code of `memory.exhausted` (§11.7) as the backends raise it: the prelude's constant,
## under the standard modules' identity `luce`, so a program's comparison holds.
pub func exhausted_code() -> u64:
    return ((u64)package_identity("luce") << 16) | 1

## Whether a callee's receiver is the `ErrorCode` type itself.
func is_error_code_type(receiver: ast.Node*?) -> bool:
    let r = receiver else return false
    return r.has(ast.flag_type_ref) and r.type_id == types.error_code_id

## The position of parameter `name` among the ones a caller supplies: an extern's `out`
## parameter takes no argument (§17.1), so it has no position.
func param_index(d: ast.Node*, name: str) -> usize?:
    var i: usize = 0
    var cursor = d.right
    while let p = cursor:
        if not p.has(ast.flag_out):
            if p.text == name:
                return i
            i += 1
        cursor = p.next
    return none

## The parameter at `index` among the ones a caller supplies.
func param_at(d: ast.Node*, index: usize) -> ast.Node*?:
    var i: usize = 0
    var cursor = d.right
    while let p = cursor:
        if not p.has(ast.flag_out):
            if i == index:
                return p
            i += 1
        cursor = p.next
    return none

## Does a block end in a way that never reaches its own end?
# mark: Name helpers ===========================================================================

## The id of a scalar or core type name, or `none_id`.
## The `c` module's types (base.md §5.2): the fixed-width ones are Base types by another
## name; `char`, `long`, `ulong`, `wchar`, and `va_list` are distinct; `str` is C text.
pub func c_type_id(name: str) -> u32:
    if name == "int": return types.i32_id
    if name == "uint": return types.u32_id
    if name == "short": return types.i16_id
    if name == "ushort": return types.u16_id
    if name == "schar": return types.i8_id
    if name == "uchar": return types.u8_id
    if name == "longlong": return types.i64_id
    if name == "ulonglong": return types.u64_id
    if name == "float": return types.f32_id
    if name == "double": return types.f64_id
    if name == "bool": return types.bool_id
    if name == "size" or name == "uintptr": return types.usize_id
    if name == "ssize" or name == "ptrdiff" or name == "intptr": return types.isize_id
    if name == "char": return types.c_char_id
    if name == "long": return types.c_long_id
    if name == "ulong": return types.c_ulong_id
    if name == "wchar": return types.c_wchar_id
    if name == "va_list": return types.c_va_list_id
    if name == "str": return types.cstr_id
    return types.none_id

pub func scalar_id(name: str) -> u32:
    if name == "i8":
        return types.i8_id
    if name == "i16":
        return types.i16_id
    if name == "i32":
        return types.i32_id
    if name == "i64":
        return types.i64_id
    if name == "isize":
        return types.isize_id
    if name == "u8":
        return types.u8_id
    if name == "u16":
        return types.u16_id
    if name == "u32":
        return types.u32_id
    if name == "u64":
        return types.u64_id
    if name == "usize":
        return types.usize_id
    if name == "f16":
        return types.f16_id
    if name == "f32":
        return types.f32_id
    if name == "f64":
        return types.f64_id
    if name == "bool":
        return types.bool_id
    if name == "char":
        return types.char_id
    if name == "str":
        return types.str_id
    if name == "fmt":
        return types.fmt_id
    if name == "unit":
        return types.unit_id
    if name == "never":
        return types.never_id
    if name == "void":
        return types.void_id
    if name == "ErrorCode":
        return types.error_code_id
    if name == "Error":
        return types.error_value_id
    return types.none_id

## The core functions (§3.5) and modules that no declaration may shadow.
func is_intrinsic(name: str) -> bool:
    let names: str[13] = ["assert", "discard", "error", "trap", "hash", "print", "format", "sizeof", "alignof", "offsetof", "hex", "bin", "pad"]
    for n in names:
        if n == name:
            return true
    return false

pub func is_standard_module(name: str) -> bool:
    for p in prelude.modules:
        if p.name == name:
            return true
    return false

func is_arithmetic(op: str) -> bool:
    return op == "+" or op == "-" or op == "*" or op == "/" or op == "//" or op == "%" or op == "+%" or op == "-%" or op == "*%" or op == "+|" or op == "-|" or op == "*|" or op == "+?" or op == "-?" or op == "*?" or op == "&" or op == "|" or op == "^"

## A number literal with a point or an exponent, outside the prefixed forms.
pub func is_float_text(text: str) -> bool:
    return is_float_literal(text)

## What the arms of a `match` cover: `_`, an optional's two cases, `true` and `false`, an
## enum's cases as bits by declaration order, and the literals seen, for duplicates.
struct Coverage:
    var wildcard: bool
    var some: bool
    var none_: bool
    var truth: bool
    var falsity: bool
    var cases: u64
    var seen: usize
    var texts: str[64]

## The position of a case among its enum's cases, in declaration order.
func case_index(d: ast.Node*, case_decl: ast.Node*) -> usize:
    var index: usize = 0
    var cursor = d.body
    while let m = cursor:
        if m == case_decl:
            return index
        if m.kind == ast.Kind.enum_case:
            index += 1
        cursor = m.next
    return index

func case_count(d: ast.Node*) -> usize:
    var count: usize = 0
    var cursor = d.body
    while let m = cursor:
        if m.kind == ast.Kind.enum_case:
            count += 1
        cursor = m.next
    return count

## `luce.line`, `luce.file`, or `luce.function`: a fact of the use site (§6.4).
func is_luce_fact(e: ast.Node*) -> bool:
    if e.kind != ast.Kind.member:
        return false
    let owner = e.left else return false
    return owner.kind == ast.Kind.name and owner.text == "luce" and (e.text == "line" or e.text == "file" or e.text == "function" or e.text == "location")

## `-1`: unary minus on an integer literal.
func is_negative_literal(e: ast.Node*) -> bool:
    if e.kind != ast.Kind.unary or e.text != "-":
        return false
    let inner = e.left else return false
    return inner.kind == ast.Kind.literal and not is_float_literal(inner.text) and inner.text.bytes[0] >= '0' and inner.text.bytes[0] <= '9'

## Whether a type declaration holds a field (§10.1).
## The wrapping integer result of a constant binary operator, or `none` for an operator this
## evaluator does not fold or a division by zero.
func fold_binary(op: str, a: u64, b: u64) -> u64?:
    if op == "+" or op == "+%":
        return a +% b
    if op == "-" or op == "-%":
        return a -% b
    if op == "*" or op == "*%":
        return a *% b
    if op == "//":
        return (a // b) if b != 0 else none
    if op == "%":
        return (a % b) if b != 0 else none
    if op == "<<":
        return (a << b) if b < 64 else 0
    if op == ">>":
        return (a >> b) if b < 64 else 0
    if op == "&":
        return a & b
    if op == "|":
        return a | b
    if op == "^":
        return a ^ b
    return none

func compare_constants(op: str, a: u64, b: u64, signed: bool) -> bool?:
    if op == "==":
        return a == b
    if op == "!=":
        return a != b
    let sa = (i64)a
    let sb = (i64)b
    if op == "<":
        return (sa < sb) if signed else (a < b)
    if op == "<=":
        return (sa <= sb) if signed else (a <= b)
    if op == ">":
        return (sa > sb) if signed else (a > b)
    if op == ">=":
        return (sa >= sb) if signed else (a >= b)
    return none

## The method a witness table points at for requirement `name` of `d`: the hidden fallible
## thunk when the implementation is not fallible, else the implementation itself.
pub func witness_member(d: ast.Node*, name: str) -> ast.Node*?:
    var cursor = d.body
    while let m = cursor:
        if m.kind == ast.Kind.func_ and m.has(ast.flag_lambda) and m.text.length == name.length + 6 and ends_with_name(m.text, name):
            return m
        cursor = m.next
    return find_member(d, name, ast.Kind.func_)

func ends_with_name(text: str, name: str) -> bool:
    let t = text.bytes
    let n = name.bytes
    if t.length < n.length + 6:
        return false
    if (str)t[..<6] != "__wit_":
        return false
    return (str)t[6..] == name

## The `index`th argument's value of call `e`.
func argument_at(e: ast.Node*, index: usize) -> ast.Node*?:
    var i: usize = 0
    var cursor = e.body
    while let a = cursor:
        if i == index:
            return a.left
        i += 1
        cursor = a.next
    return none

## How strong a written `Ordering` case is: relaxed, then acquire and release, then
## acq_rel, then seq_cst; a non-literal ordering ranks as the weakest.
func ordering_rank(e: ast.Node*) -> u32:
    if e.kind != ast.Kind.case_value:
        return 0
    if e.text == "seq_cst":
        return 3
    if e.text == "acq_rel":
        return 2
    if e.text == "acquire" or e.text == "release":
        return 1
    return 0

## A call, alone or under `try`, `catch`, or parentheses (§7.9).
func is_call_statement(e: ast.Node*) -> bool:
    match e.kind:
        .call:
            return true
        .group, .catch_:
            let inner = e.left else return false
            return is_call_statement(inner)
        .unary:
            let inner = e.left else return false
            return e.text == "try" and is_call_statement(inner)
        _:
            return false

func is_none_literal(e: ast.Node*) -> bool:
    return e.kind == ast.Kind.literal and e.text == "none"

## A place: something with an address (§6.6): a name, `self`, a member, an element, a
## dereference, or one of those in parentheses.
func is_place(e: ast.Node*) -> bool:
    match e.kind:
        .name, .self_, .member, .index:
            return true
        .group:
            let inner = e.left else return false
            return is_place(inner)
        .unary:
            return e.text == "*"
        _:
            return false

## Whether a handler's every path ends in `recover`, `return`, `error`, `trap`, `break`, or
## `continue` (§11.4).
func handler_leaves(block: ast.Node*) -> bool:
    var cursor = block.body
    while let s = cursor:
        if handler_statement_leaves(s):
            return true
        cursor = s.next
    return false

func handler_statement_leaves(s: ast.Node*) -> bool:
    match s.kind:
        .recover_, .break_, .continue_:
            return true
        .if_:
            let then = s.body else return false
            let rest = s.right else return false
            if not handler_leaves(then):
                return false
            return handler_statement_leaves(rest) if rest.kind == ast.Kind.if_ else handler_leaves(rest)
        _:
            return prune.statement_leaves(s)

func has_field(d: ast.Node*) -> bool:
    var cursor = d.body
    while let m = cursor:
        if m.kind == ast.Kind.field:
            return true
        cursor = m.next
    return false

## The bytes a text literal denotes, in the current allocator: delimiters and
## prefix removed, CRLF normalised and indentation stripped for triple quotes,
## escapes decoded except in raw text (§4.4).
pub func decode_text(spelled: str) -> str:
    var b = spelled.bytes
    var raw = false
    var is_bytes = false
    if b.length >= 2 and b[0] == 'r' and b[1] == '"':
        raw = true
        b = b[1..]
    elif b.length >= 2 and b[0] == 'b' and b[1] == '"':
        is_bytes = true
        b = b[1..]
    var body = b
    var triple = false
    if b.length >= 6 and b[0] == '"' and b[1] == '"' and b[2] == '"':
        triple = true
        body = b[3..<b.length - 3]
    elif b.length >= 2 and b[0] == '"':
        body = b[1..<b.length - 1]
    let out = alloc u8[body.length + 1] catch failure:
        trap("out of memory")
    var n: usize = 0
    if triple:
        # the closing delimiter's column is the indentation to strip
        var indent: usize = 0
        var k = body.length
        while k > 0 and body[k - 1] == ' ':
            k -= 1
            indent += 1
        if k > 0 and body[k - 1] != '\n':
            indent = 0
        var i: usize = 0
        # a newline directly after the opening delimiter is not part of the text (§4.4)
        if body.length > 0 and body[0] == '\n':
            i = 1
        elif body.length > 1 and body[0] == '\r' and body[1] == '\n':
            i = 2
        var at_line_start = true
        while i < body.length:
            if body[i] == '\r' and i + 1 < body.length and body[i + 1] == '\n':
                i += 1
                continue
            if at_line_start:
                var skipped: usize = 0
                while skipped < indent and i < body.length and body[i] == ' ':
                    i += 1
                    skipped += 1
                at_line_start = false
                if i >= body.length:
                    break
            let byte = body[i]
            out[n] = byte
            n += 1
            if byte == '\n':
                at_line_start = true
            i += 1
        body = out[..<n]
        n = 0
        if raw:
            return (str)body
        # decode escapes in place is unsafe; copy again
        let second = alloc u8[body.length + 1] catch failure:
            trap("out of memory")
        n = decode_escapes(body, second, is_bytes)
        return (str)second[..<n]
    if raw:
        memory.copy(out, body, body.length)
        return (str)out[..<body.length]
    n = decode_escapes(body, out, is_bytes)
    return (str)out[..<n]

## Decode the escapes of `body` into `out`; returns the byte count.
func decode_escapes(body: const u8[], out: u8[], is_bytes: bool) -> usize:
    var n: usize = 0
    var i: usize = 0
    while i < body.length:
        let byte = body[i]
        if byte != '\\' or i + 1 >= body.length:
            out[n] = byte
            n += 1
            i += 1
            continue
        let e = body[i + 1]
        i += 2
        if e == 'n':
            out[n] = '\n'
            n += 1
        elif e == 'r':
            out[n] = '\r'
            n += 1
        elif e == 't':
            out[n] = '\t'
            n += 1
        elif e == '0':
            out[n] = 0
            n += 1
        elif e == 'x' and is_bytes and i + 1 < body.length:
            out[n] = (u8)(hex_value(body[i]) * 16 + hex_value(body[i + 1]))
            n += 1
            i += 2
        elif e == 'u' and i < body.length and body[i] == '{':
            var cp: u32 = 0
            i += 1
            while i < body.length and body[i] != '}':
                cp = cp * 16 + (u32)hex_value(body[i])
                i += 1
            i += 1
            n += encode_utf8(cp, out[n..])
        else:
            out[n] = e
            n += 1
    return n

func hex_value(digit: u8) -> u8:
    if digit >= '0' and digit <= '9':
        return digit - '0'
    if digit >= 'a' and digit <= 'f':
        return digit - 'a' + 10
    if digit >= 'A' and digit <= 'F':
        return digit - 'A' + 10
    return 0

## Write `cp` as UTF-8 into `out`; returns the byte count.
pub func encode_utf8(cp: u32, out: u8[]) -> usize:
    if cp < 128:
        out[0] = (u8)cp
        return 1
    if cp < 2048:
        out[0] = (u8)(192 + (cp >> 6))
        out[1] = (u8)(128 + (cp & 63))
        return 2
    if cp < 65536:
        out[0] = (u8)(224 + (cp >> 12))
        out[1] = (u8)(128 + ((cp >> 6) & 63))
        out[2] = (u8)(128 + (cp & 63))
        return 3
    out[0] = (u8)(240 + (cp >> 18))
    out[1] = (u8)(128 + ((cp >> 12) & 63))
    out[2] = (u8)(128 + ((cp >> 6) & 63))
    out[3] = (u8)(128 + (cp & 63))
    return 4

## The scalar value of a character literal.
pub func decode_char(spelled: str) -> u32:
    let b = spelled.bytes
    if b.length < 3:
        return 0
    let body = b[1..<b.length - 1]
    if body[0] != '\\':
        # one UTF-8 scalar
        let c0 = body[0]
        if c0 < 128:
            return (u32)c0
        if c0 < 224 and body.length >= 2:
            return ((u32)(c0 & 31) << 6) | (u32)(body[1] & 63)
        if c0 < 240 and body.length >= 3:
            return ((u32)(c0 & 15) << 12) | ((u32)(body[1] & 63) << 6) | (u32)(body[2] & 63)
        if body.length >= 4:
            return ((u32)(c0 & 7) << 18) | ((u32)(body[1] & 63) << 12) | ((u32)(body[2] & 63) << 6) | (u32)(body[3] & 63)
        return 0
    let e = body[1]
    if e == 'n':
        return 10
    if e == 'r':
        return 13
    if e == 't':
        return 9
    if e == '0':
        return 0
    if e == 'u' and body.length > 3:
        var cp: u32 = 0
        var i: usize = 3
        while i < body.length and body[i] != '}':
            cp = cp * 16 + (u32)hex_value(body[i])
            i += 1
        return cp
    return (u32)e

func is_float_literal(text: str) -> bool:
    let b = literal_body(text).bytes
    if b.length > 1 and b[0] == '0' and (b[1] == 'x' or b[1] == 'X' or b[1] == 'b' or b[1] == 'B' or b[1] == 'o' or b[1] == 'O'):
        return false
    for byte in b:
        if byte == '.' or byte == 'e' or byte == 'E':
            return true
    return false

## The type suffix of a number literal, `u8` in `255u8` or `f32` in `0.5f32`, or empty
## (§4.2, §4.3). A based literal's suffix begins at its first non-digit.
pub func literal_suffix(text: str) -> str:
    let b = text.bytes
    var i: usize = 0
    if b.length > 1 and b[0] == '0' and (b[1] == 'x' or b[1] == 'o' or b[1] == 'b'):
        i = 2
        while i < b.length and (is_hex_digit(b[i]) or b[i] == '_'):
            i += 1
        return (str)b[i..]
    while i < b.length and b[i] != 'i' and b[i] != 'u' and b[i] != 'f':
        i += 1
    return (str)b[i..]

## A number literal without its suffix: what its digits say.
pub func literal_body(text: str) -> str:
    return (str)text.bytes[..<text.length - literal_suffix(text).length]

func is_hex_digit(b: u8) -> bool:
    return (b >= '0' and b <= '9') or (b >= 'a' and b <= 'f') or (b >= 'A' and b <= 'F')

## Decode an integer literal: decimal, `0x`, `0b`, `0o`, with `_` separators.
pub func decode_integer(text: str) -> u64!:
    let b = literal_body(text).bytes
    var base: u64 = 10
    var i: usize = 0
    if b.length > 1 and b[0] == '0':
        if b[1] == 'x' or b[1] == 'X':
            base = 16
            i = 2
        elif b[1] == 'b' or b[1] == 'B':
            base = 2
            i = 2
        elif b[1] == 'o' or b[1] == 'O':
            base = 8
            i = 2
    var value: u64 = 0
    while i < b.length:
        let byte = b[i]
        i += 1
        if byte == '_':
            continue
        var digit: u64 = 0
        if byte >= '0' and byte <= '9':
            digit = (u64)(byte - '0')
        elif byte >= 'a' and byte <= 'f':
            digit = (u64)(byte - 'a') + 10
        elif byte >= 'A' and byte <= 'F':
            digit = (u64)(byte - 'A') + 10
        else:
            error(type_error, "bad digit in integer literal")
        if digit >= base:
            error(type_error, "bad digit in integer literal")
        value = value * base + digit
    return value

## The first `b` in `s`, or `s.length`.
func check_decode_char(text: str) -> u32:
    return decode_char(text)

func find_byte(s: str, b: u8) -> usize:
    var i: usize = 0
    let bytes = s.bytes
    while i < bytes.length:
        if bytes[i] == b:
            return i
        i += 1
    return bytes.length

## `a.b.c` -> `c`.
func last_component(path: str) -> str:
    var start: usize = 0
    var i: usize = 0
    let b = path.bytes
    while i < b.length:
        if b[i] == '.':
            start = i + 1
        i += 1
    return (str)b[start..]

## `dir/name.lucb` -> `name`.
pub func module_name_of(path: str) -> str:
    let b = path.bytes
    var start: usize = 0
    var end: usize = b.length
    var i: usize = 0
    while i < b.length:
        if b[i] == '/':
            start = i + 1
        i += 1
    i = start
    while i < b.length:
        if b[i] == '.':
            end = i
        i += 1
    return (str)b[start..<end]

## `dir/name.lucb` -> `dir/`; a bare name yields the empty string.
## `a/b/` for `a/b/c/`, `` for `c/`.
pub func parent_of(dir: str) -> str:
    let b = dir.bytes
    var end: usize = 0
    var i: usize = 0
    while i + 1 < b.length:
        if b[i] == '/':
            end = i + 1
        i += 1
    return (str)b[..<end]

func file_exists(path: c.str) -> bool:
    let data = files.read(path) catch:
        return false
    return data.length >= 0

pub func directory_of(path: str) -> str:
    let b = path.bytes
    var end: usize = 0
    var i: usize = 0
    while i < b.length:
        if b[i] == '/':
            end = i + 1
        i += 1
    return (str)b[..<end]

func one_arg(id: u32) -> u32[]!:
    var one = try alloc u32[1]
    one[0] = id
    return one

# mark: Tests ==================================================================================

## Check a program given as text, in a fresh arena; the first error is returned.
pub func check_text(text: str, scratch: u8[]) -> !:
    var checker = try Checker.create(scratch)
    try checker.add_prelude()
    let src = try source.Source.over("test", text.bytes)
    try checker.add_module("test", src, false)
    try checker.check_program()

## The standard modules alone take over two megabytes of tree; the tests' arenas hold eight.
let test_arena_size: usize = 8388608

func expect_error(text: str, fragment: str) -> !:
    let backing = try alloc u8[test_arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[1024]
    var failed = false
    with arena:
        check_text(text, scratch) catch failure:
            if not contains(failure.message, fragment):
                print(f"expected `{fragment}`, got: {failure.message}")
                error(failure.code, "wrong diagnostic")
            failed = true
            recover ()
    if not failed:
        error(type_error, "expected an error, the program checked")

func expect_ok(text: str) -> !:
    let backing = try alloc u8[test_arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[1024]
    with arena:
        check_text(text, scratch) catch failure:
            # the message lives in this frame's scratch; the runner reads it after the return
            let kept = try format(test_message, f"{failure.message}")
            error(failure.code, kept)

var test_message: u8[1024]

func contains(haystack: str, needle: str) -> bool:
    let h = haystack.bytes
    let n = needle.bytes
    if n.length > h.length:
        return false
    var i: usize = 0
    while i + n.length <= h.length:
        if (str)h[i..<i + n.length] == needle:
            return true
        i += 1
    return false

test "a function with a typed body checks":
    try expect_ok("func add(a: i64, b: i64) -> i64:\n    return a + b\n")

test "an unknown name is reported with its position":
    try expect_error("func f() -> i64:\n    return missing\n", "test:2:12: unknown name")

test "a mismatched return is reported":
    try expect_error("func f() -> i64:\n    return \"x\"\n", "expected `i64`, got `str`")

test "widening is implicit and narrowing is not":
    try expect_ok("func f(a: u8) -> u32:\n    return a\n")
    try expect_error("func f(a: u32) -> u8:\n    return a\n", "expected `u8`, got `u32`")

test "a let cannot be assigned":
    try expect_error("func f():\n    let x = 1\n    x = 2\n", "cannot assign to a `let`")

test "try needs a fallible function":
    try expect_error("func g() -> i64!:\n    return 1\nfunc f() -> i64:\n    return try g()\n", "only valid in a fallible function")

test "an unhandled fallible call is an error":
    try expect_error("func g() -> !:\n    return\nfunc f():\n    g()\n", "must be handled")

test "structs construct by name and expose fields":
    try expect_ok("struct P:\n    var x: i64\n    var y: i64\n    func sum() -> i64:\n        return self.x + self.y\nfunc f() -> i64:\n    let p = P(x = 1, y = 2)\n    return p.sum() + p.x\n")

test "a mutating method needs a var receiver":
    try expect_error("struct C:\n    var n: i64\n    mutating func bump():\n        self.n += 1\nfunc f():\n    let c = C(n = 0)\n    c.bump()\n", "needs a `var` receiver")

test "enums match by case":
    try expect_ok("enum K as u8:\n    a = 1\n    b = 2\nfunc f(k: K) -> i64:\n    match k:\n        .a:\n            return 1\n        .b:\n            return 2\n        _:\n            return 0\n")
    try expect_error("enum K as u8:\n    a = 1\n    b = 2\nfunc f(k: K) -> i64:\n    match k:\n        .a:\n            return 1\n        .b:\n            return 2\n", "needs a `_` arm")

test "a memberwise initialiser is positional or named, each field once":
    try expect_ok("struct P:\n    var x: i64\n    var y: i64\nfunc f() -> i64:\n    let p = P(1, 2)\n    let q = P(1, y = 2)\n    return p.x + q.y\n")
    try expect_error("struct P:\n    var x: i64\n    var y: i64\nfunc f() -> i64:\n    let p = P(x = 1, x = 2)\n    return p.x\n", "given twice")
    try expect_error("struct P:\n    var x: i64\n    var y: i64\nfunc f() -> i64:\n    let p = P(x = 1, 2)\n    return p.x\n", "cannot follow a named one")
    try expect_error("struct P:\n    var x: i64\nfunc f() -> i64:\n    let p = P(1, 2)\n    return p.x\n", "too many values")

test "an init assigns every field once and reads none early":
    try expect_ok("struct P:\n    let a: i64\n    let b: i64\n    pub func init(n: i64) -> !:\n        if n < 0:\n            error(1, \"neg\")\n        self.a = n\n        self.b = n * 2\n        discard(self.a + self.b)\nfunc f() -> i64!:\n    let p = try P(1)\n    return p.b\n")
    try expect_error("struct P:\n    let a: i64\n    let b: i64\n    pub func init(n: i64):\n        self.a = n\nfunc f() -> i64:\n    return P(1).a\n", "not assigned")
    try expect_error("struct P:\n    let a: i64\n    pub func init(n: i64):\n        self.a = n\n        self.a = n + 1\nfunc f() -> i64:\n    return P(1).a\n", "assigned twice")
    try expect_error("struct P:\n    let a: i64\n    let b: i64\n    pub func init(n: i64):\n        self.a = n\n        self.b = self.a * 2\nfunc f() -> i64:\n    return P(1).a\n", "before every field is assigned")
    try expect_error("struct P:\n    let a: i64\n    pub func init(n: i64):\n        while n > 0:\n            self.a = n\nfunc f() -> i64:\n    return P(1).a\n", "assigned twice")
    try expect_error("struct P:\n    let a: i64\n    pub func init(n: i64) -> i64:\n        self.a = n\n        return n\nfunc f() -> i64:\n    return 0\n", "`init` returns")

test "a struct cannot contain itself by value":
    try expect_error("struct N:\n    var next: N\nfunc f() -> i64:\n    return 0\n", "contains itself")
    try expect_error("struct A:\n    var b: B\nstruct B:\n    var a: A\nfunc f() -> i64:\n    return 0\n", "contains itself")
    try expect_ok("struct N:\n    var value: i64\n    var next: N*?\nfunc f() -> i64:\n    let n = N(value = 1, next = none)\n    return n.value\n")

test "integer-backed enums: values for every case, distinct, and the bit operators":
    try expect_ok("enum A as u32:\n    r = 1\n    w = 2\nfunc f() -> u32:\n    return (u32)(~A.r & (A.r | A.w))\n")
    try expect_error("enum A as u8:\n    a = 1\n    b = 1\nfunc f() -> i64:\n    return 0\n", "share one value")
    try expect_error("enum A as u8:\n    a\n    b\nfunc f() -> i64:\n    return 0\n", "every case its value")
    try expect_ok("enum L as i8:\n    low = -1\n    high = 1\nfunc f() -> i64:\n    return (i64)(i8)L.low\n")

test "equality needs it in every component; a union has a member":
    try expect_error("union U:\n    a: i64\n    b: f64\nstruct S:\n    var u: U\nfunc f() -> bool:\n    var x: S\n    var y: S\n    return x == y\n", "no equality")
    try expect_error("union U:\n    func g() -> i64:\n        return 1\nfunc f() -> i64:\n    return 0\n", "at least one member")

test "a catch handler for a value recovers or leaves":
    try expect_error("func g() -> i64!:\n    return 1\nfunc f() -> i64:\n    let v = g() catch e:\n        discard(e)\n    return v\n", "must `recover`")
    try expect_ok("func g() -> i64!:\n    return 1\nfunc f() -> i64:\n    let v = g() catch e:\n        recover 2\n    return v\n")
    try expect_ok("func g() -> !:\n    return\nfunc f() -> i64:\n    g() catch e:\n        discard(e)\n    return 1\n")

test "a module-level assert is decided at compile time":
    try expect_ok("assert(sizeof(i64) == 8, \"a word\")\nfunc f() -> i64:\n    return 0\n")
    try expect_error("assert(sizeof(i64) == 4, \"a word\")\nfunc f() -> i64:\n    return 0\n", "`assert` failed: a word")
    try expect_error("assert(not (1 < 2 and true))\nfunc f() -> i64:\n    return 0\n", "`assert` failed")

test "a message formatted on a local buffer is local through try and let":
    try expect_error("let code = ErrorCode.package(1)\nfunc fail(n: i64) -> !:\n    var buffer: u8[64]\n    let text = try format(buffer, f\"bad {n}\")\n    error(code, text)\n", "must not name a local")
    try expect_ok("let code = ErrorCode.package(1)\nfunc fail(n: i64, buffer: u8[]) -> !:\n    let text = try format(buffer, f\"bad {n}\")\n    error(code, text)\n")

test "two constants of one package do not share an error code":
    try expect_error("let first = ErrorCode.package(1)\nlet second = ErrorCode.package(1)\nfunc f() -> i64:\n    return 0\n", "share this error code")

test "a result is not a storable type":
    try expect_error("func take(r: i64!) -> i64:\n    return 0\n", "not a storable type")
    try expect_error("struct S:\n    var r: i64!\nfunc f() -> i64:\n    return 0\n", "not a storable type")
    try expect_error("func may() -> i64!:\n    return 1\nfunc f() -> i64:\n    var r: i64! = may()\n    return 0\n", "not a storable type")

test "error needs a fallible function, in a handler too":
    try expect_error("func may() -> i64!:\n    return 1\nfunc f() -> i64:\n    let v = may() catch e:\n        error(e.code, e.message)\n    return v\n", "only valid in a fallible function")

test "sizeof takes every type form":
    try expect_ok("struct P:\n    var x: i64\nfunc f() -> usize:\n    return sizeof(i64*) + sizeof(i64?) + sizeof(P*?) + sizeof(i64[4]) + sizeof((i64?)[2]) + sizeof(func(i64) -> i64) + alignof(P)\n")

test "the code of memory.exhausted is the one the runtime header names":
    assert(exhausted_code() == 208273409)

test "new zeroes its elements and allocates no result":
    try expect_error("func f() -> !:\n    let p = try new (i64*)[4]\n    discard(p.length)\n", "must be zeroable")
    try expect_error("func f() -> !:\n    let p = try new (i64!)\n    discard(p)\n", "not a storable type")
    try expect_ok("func f() -> !:\n    let p = try alloc (i64*)[4]\n    free(p)\n")

test "the allocator named by in binds below catch":
    try expect_ok("import memory\nfunc f() -> usize:\n    var backing: u8[64]\n    var arena = memory.FixedBuffer.over(backing)\n    let block = new u8[8] in arena catch e:\n        recover backing[..<0]\n    return block.length\n")

test "a type argument satisfies its constraints":
    try expect_error("from luce import Comparable\nstruct P:\n    var x: i64\nfunc largest[T: Comparable](a: T, b: T) -> T:\n    return a if a.compare(b) >= 0 else b\nfunc f() -> i64:\n    return largest(P(x = 1), P(x = 2)).x\n", "does not satisfy `Comparable`")
    try expect_error("from luce import Equatable\nunion U:\n    a: i64\n    b: f64\nfunc same[T: Equatable](a: T, b: T) -> bool:\n    return a == b\nfunc f() -> bool:\n    var x: U\n    var y: U\n    return same(x, y)\n", "does not satisfy `Equatable`")
    try expect_ok("from luce import Display\nfunc show[T: Display](a: T):\n    print(f\"{a}\")\nfunc f():\n    show(1)\n    show(\"x\")\n")

test "an unconstrained type parameter has no equality, hash, or display":
    try expect_error("func same[T](a: T, b: T) -> bool:\n    return a == b\n", "no equality")
    try expect_error("func h[T](a: T) -> u64:\n    return hash(a)\n", "only under `Hashable`")
    try expect_error("func show[T](a: T):\n    print(f\"{a}\")\n", "cannot be formatted")
    try expect_ok("from luce import Equatable\nfrom luce import Hashable\nfunc both[T: Equatable & Hashable](a: T, b: T) -> bool:\n    return a == b and hash(a) == hash(b)\n")

test "a type parameter may not take the name of a type in scope":
    try expect_error("struct Point:\n    var x: i64\nfunc f[Point](a: Point) -> Point:\n    return a\n", "name of a type in scope")

test "a generic that nests its own parameter in a recursive call is an infinite chain":
    try expect_error("struct Pair[A, B]:\n    var first: A\n    var second: B\nfunc grow[T](depth: T) -> i64:\n    return grow(Pair[T, T](first = depth, second = depth))\n", "infinite chain")

test "a mutating view needs a var; a view comes from a pointer; a temporary has no address":
    try expect_error("interface Shape:\n    mutating func scale(f: f64)\nstruct Q: Shape:\n    var s: f64\n    mutating func scale(f: f64):\n        self.s = f\nfunc f() -> unit:\n    let q = Q(s = 1.0)\n    let v: Shape = &q\n    v.scale(2.0)\n", "expected `Shape`")
    try expect_ok("interface Shape:\n    func area() -> f64\nstruct Q: Shape:\n    var s: f64\n    func area() -> f64:\n        return self.s\nfunc f() -> f64:\n    let q = Q(s = 1.0)\n    let v: Shape = &q\n    return v.area()\n")
    try expect_error("struct Q:\n    var s: f64\nfunc f() -> Q*:\n    return &Q(s = 1.0)\n", "address of a temporary")

test "interfaces have no generic methods; Equatable is not written by hand; mutating is exact":
    try expect_error("interface Shape:\n    func scaled[T](f: T) -> f64\n", "no generic methods")
    try expect_error("from luce import Equatable\nstruct P: Equatable:\n    var x: i64\n    func equals(other: P) -> bool:\n        return true\n", "not implemented by hand")
    try expect_error("interface Sink:\n    mutating func put(v: i64)\nstruct S: Sink:\n    var n: i64\n    func put(v: i64):\n        discard(v)\n", "declares this method mutating")

test "an atomic takes its payload as initial value and reads as it in expressions":
    try expect_ok("struct C:\n    var hits: @u64\n    var flag: @bool\nfunc f() -> u64:\n    var byte: @u8 = 250\n    var c = C(hits = 1, flag = false)\n    var head: @i64*? = none\n    let same = c.hits == 1 and byte == 250 and head == none\n    return 1 if same else 0\n")
    try expect_ok("struct N:\n    var v: i64\nfunc f(head: (@N*?)*) -> i64:\n    if let n = *head:\n        return n.v\n    return 0\n")

test "atomic compound assignments are the five instructions and never checked arithmetic":
    try expect_error("func f() -> unit:\n    var hits: @u64\n    hits *= 2\n", "atomic compound assignment")
    try expect_error("func f() -> u64:\n    var hits: @u64\n    return hits +? 1\n", "does not apply to an atomic")

test "cas orderings: no release on failure, and failure no stronger than success":
    try expect_error("func f() -> unit:\n    var hits: @u64\n    let (ok, seen) = hits.cas(0, 1, .acq_rel, .release)\n    discard(ok)\n", "may not be `release`")
    try expect_error("func f() -> unit:\n    var hits: @u64\n    let (ok, seen) = hits.cas(0, 1, .relaxed, .acquire)\n    discard(ok)\n", "stronger than the success")
    try expect_ok("func f() -> bool:\n    var hits: @u64\n    let (ok, seen) = hits.cas(0, 1, .acq_rel, .acquire)\n    return ok and seen == 0\n")

test "generics infer from arguments and substitute results":
    try expect_ok("func first[T](values: const T[]) -> T?:\n    if values.length == 0:\n        return none\n    return values[0]\nfunc f() -> i64:\n    let xs: i64[3] = [1, 2, 3]\n    let v = first(xs) else return 0\n    return v\n")

test "a generic struct instantiates and its methods substitute":
    try expect_ok("struct Box[T]:\n    var item: T\n    func get() -> T:\n        return self.item\nfunc f() -> i64:\n    let b = Box[i64](item = 3)\n    return b.get()\n")

test "the standard modules need an import":
    try expect_ok("import io\nfunc f() -> !:\n    let out = io.stdout()\n    try out.write(\"hi\")\n    var buf: u8[16]\n    let s = try format(buf, f\"{buf.length}\")\n    discard(s.length)\n")
    try expect_error("func f() -> !:\n    let out = io.stdout()\n    try out.write(\"hi\")\n", "unknown name")
    try expect_ok("from io import Writer\nfunc f(w: Writer) -> !:\n    discard(try w.write(\"hi\".bytes))\n")
    try expect_error("func f(w: Writer) -> !:\n    discard(try w.write(\"hi\".bytes))\n", "unknown type")

test "interfaces form views from pointers":
    try expect_ok("from io import Writer\nstruct W: Writer:\n    var n: usize\n    pub mutating func write(bytes: const u8[]) -> usize!:\n        self.n += bytes.length\n        return bytes.length\nfunc f() -> !:\n    var w = W(n = 0)\n    let v: Writer = &w\n    discard(try v.write(\"abc\"))\n")

test "none needs an optional and if let unwraps":
    try expect_error("func f() -> i64:\n    let x = none\n    return 0\n", "`none` needs a written type")
    try expect_ok("func f(x: i64?) -> i64:\n    if let v = x:\n        return v\n    return 0\n")

test "error and catch handle failure":
    try expect_ok("let bad: ErrorCode = ErrorCode.package(1)\nfunc g(n: i64) -> i64!:\n    if n < 0:\n        error(bad, \"negative\")\n    return n\nfunc f() -> i64:\n    let v = g(-1) catch e:\n        if e.code == bad:\n            recover 0\n        recover 1\n    return v\n")

test "modules import and qualify names":
    let backing = try alloc u8[test_arena_size] in memory.heap
    defer free(backing) in memory.heap
    var arena = memory.FixedBuffer.over(backing)
    var scratch: u8[1024]
    with arena:
        var checker = try Checker.create(scratch)
        try checker.add_prelude()
        let a = try source.Source.over("a", "pub struct Point:\n    pub var x: i64\npub func origin() -> Point:\n    return Point(x = 0)\n".bytes)
        try checker.add_module("a", a, false)
        let b = try source.Source.over("b", "import a\nfunc f() -> i64:\n    let p = a.origin()\n    return p.x\n".bytes)
        try checker.add_module("b", b, false)
        try checker.check_program()

test "a function that may fall off its end is rejected":
    try expect_error("func f(b: bool) -> i64:\n    if b:\n        return 1\n", "may reach its end")

## A binding leaving scope that nothing read: marked for the block to prune (§19.6). Names
## beginning with `_` say the silence is intended; a tuple's names are not pruned.
func mark_if_unused(b: Binding):
    if b.used or b.depth == 0 or b.name.length == 0 or b.name.bytes[0] == '_':
        return
    let d = b.decl else return
    if (d.kind == ast.Kind.let_ or d.kind == ast.Kind.var_) and d.text == b.name:
        # `let d = x else return ...` is a guard: the binding is the condition, not a value
        if let init = d.left:
            if init.kind == ast.Kind.else_:
                return
        d.flags |= ast.flag_unused
