#==============================================================================================
#
#   types - Interned types and their target layout
#
#   DESCRIPTION:
#       Every type the checker names lives once in a `Table` and is referred to by its
#       index, so two equal types have one id and equality is an integer compare. The
#       scalars are pre-seeded at fixed ids. Nominal types (structs, enums, unions,
#       interfaces) are identified by their declaration node; structural ones (pointers,
#       spans, arrays, tuples, optionals, results, functions, atomics) by their parts.
#       Layout answers `sizeof`, `alignof`, and `offsetof` for the 64-bit host target
#       (base.md §5.11); pointers to unsized things carry a length word (§5.4, §5.5).
#
#==============================================================================================

import c
import front.ast
import io
import memory
import support.list

pub enum Kind as u8:
    error_ = 1
    never_ = 2
    unit_ = 3
    bool_ = 4
    i8_ = 5
    i16_ = 6
    i32_ = 7
    i64_ = 8
    isize_ = 9
    u8_ = 10
    u16_ = 11
    u32_ = 12
    u64_ = 13
    usize_ = 14
    f32_ = 15
    f64_ = 16
    char_ = 17
    str_ = 18
    cstr_ = 19
    fmt_ = 20
    void_ = 21
    untyped_int = 22
    untyped_float = 23
    error_code = 24
    error_value = 25
    ## the half-precision float, seeded after the first slice's scalars
    f16_ = 26
    pointer = 30
    span = 31
    array = 32
    tuple = 33
    optional = 34
    fallible = 35
    func_ = 36
    atomic = 37
    struct_ = 40
    enum_ = 41
    union_ = 42
    interface_ = 43
    param = 44
    module = 45
    type_name = 46

# mark: Fixed ids ==============================================================================

## Ids of the pre-seeded types, in the order `Table.create` seeds them.
pub let none_id: u32 = 0
pub let error_id: u32 = 1
pub let never_id: u32 = 2
pub let unit_id: u32 = 3
pub let bool_id: u32 = 4
pub let i8_id: u32 = 5
pub let i16_id: u32 = 6
pub let i32_id: u32 = 7
pub let i64_id: u32 = 8
pub let isize_id: u32 = 9
pub let u8_id: u32 = 10
pub let u16_id: u32 = 11
pub let u32_id: u32 = 12
pub let u64_id: u32 = 13
pub let usize_id: u32 = 14
pub let f32_id: u32 = 15
pub let f64_id: u32 = 16
pub let char_id: u32 = 17
pub let str_id: u32 = 18
pub let cstr_id: u32 = 19
pub let fmt_id: u32 = 20
pub let void_id: u32 = 21
pub let untyped_int_id: u32 = 22
pub let untyped_float_id: u32 = 23
pub let error_code_id: u32 = 24
pub let error_value_id: u32 = 25
## The `c` module's distinct types (base.md §5.2): integers of a target-dependent width,
## and the opaque `va_list`, each its own type although its kind is a Base one.
pub let c_char_id: u32 = 26
pub let c_long_id: u32 = 27
pub let c_ulong_id: u32 = 28
pub let c_wchar_id: u32 = 29
pub let c_va_list_id: u32 = 30
pub let f16_id: u32 = 31
let seeded: u32 = 32

## Whether `id` is one of the `c` module's distinct types, which convert only explicitly.
pub func is_distinct_c(id: u32) -> bool:
    return id >= c_char_id and id <= c_va_list_id

## Every bucket empty.
func zero_index(index: u32[]):
    var i: usize = 0
    while i < index.length:
        index[i] = 0
        i += 1

## A hash of what `same_type` compares: the structure, and the name where it counts.
func structure_hash(t: Type) -> u64:
    var h = mix(0x9e3779b97f4a7c15, (u64)t.kind)
    h = mix(h, (u64)t.elem)
    h = mix(h, t.length)
    h = mix(h, (1 if t.is_const else 0) | (2 if t.is_volatile else 0) | (4 if t.variadic else 0))
    if let d = t.decl:
        h = mix(h, (u64)(usize)d)
    for arg in t.args:
        h = mix(h, (u64)arg)
    if t.decl == none or t.kind == Kind.param:
        for byte in t.name.bytes:
            h = mix(h, (u64)byte)
    return h

func mix(h: u64, x: u64) -> u64:
    var r = h ^ x
    r = r *% 11400714819323198485
    return r ^ (r >> 29)

# mark: The type record ========================================================================

pub struct Type:
    pub var kind: Kind
    ## The pointee, element, payload, or result, by id; `none_id` when absent.
    pub var elem: u32
    ## Tuple members or function parameters, by id.
    pub var args: u32[]
    ## Array length.
    pub var length: u64
    pub var is_const: bool
    pub var is_volatile: bool
    ## Variadic function type (C only).
    pub var variadic: bool
    ## Nominal types: the declaration; generic instances: the same declaration
    ## plus the type arguments in `args`.
    pub var decl: ast.Node*?
    pub var name: str

# mark: The table ==============================================================================

pub struct Table:
    var types: list.List[Type]
    ## The target's word: the size and alignment of a pointer, and so of `usize`, `isize`,
    ## a text or span (two words), and an error value (three), in bytes (§19.5).
    pub var word: u64
    ## An open-addressing index from a type's structure to its id + 1 (0 marks an empty
    ## bucket), so `intern` is a lookup rather than a scan over every type so far.
    var index: u32[]

    pub static func create() -> Table!:
        var t = Table(types = try list.List[Type].create(256), word = 8, index = try alloc u32[1024])
        zero_index(t.index)
        # id 0 is "no type"; the scalars follow in Kind order
        let seeds: Kind[32] = [Kind.error_, Kind.error_, Kind.never_, Kind.unit_, Kind.bool_, Kind.i8_, Kind.i16_, Kind.i32_, Kind.i64_, Kind.isize_, Kind.u8_, Kind.u16_, Kind.u32_, Kind.u64_, Kind.usize_, Kind.f32_, Kind.f64_, Kind.char_, Kind.str_, Kind.cstr_, Kind.fmt_, Kind.void_, Kind.untyped_int, Kind.untyped_float, Kind.error_code, Kind.error_value, Kind.i8_, Kind.i64_, Kind.u64_, Kind.i32_, Kind.pointer, Kind.f16_]
        let names: str[32] = ["", "<error>", "never", "unit", "bool", "i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize", "f32", "f64", "char", "str", "c.str", "fmt", "void", "<integer>", "<float>", "ErrorCode", "Error", "c.char", "c.long", "c.ulong", "c.wchar", "c.va_list", "f16"]
        var i: usize = 0
        while i < (usize)seeded:
            # `c.va_list` is a pointer-sized opaque value on the supported targets
            let elem = void_id if i == (usize)c_va_list_id else 0
            try t.types.push(Type(kind = seeds[i], elem = elem, args = try no_args(), length = 0, is_const = false, is_volatile = false, variadic = false, decl = none, name = names[i]))
            i += 1
        i = 0
        while i < t.types.count:
            t.index_add(u32(i))
            i += 1
        return t

    pub func get(id: u32) -> Type:
        return self.types.get((usize)id)

    pub func kind(id: u32) -> Kind:
        return self.types.get((usize)id).kind

    pub func count() -> u32:
        return u32(self.types.count)

    func same_args(a: const u32[], b: const u32[]) -> bool:
        if a.length != b.length:
            return false
        var i: usize = 0
        while i < a.length:
            if a[i] != b[i]:
                return false
            i += 1
        return true

    ## The id of a type equal to `t`, adding it when new. Nominal types with a
    ## declaration compare by declaration and type arguments.
    pub mutating func intern(t: Type) -> u32!:
        let mask = self.index.length - 1
        var at = (usize)structure_hash(t) & mask
        while self.index[at] != 0:
            let id = self.index[at] - 1
            if id >= seeded and self.same_type(self.types.get((usize)id), t):
                return id
            at = (at + 1) & mask
        let id = u32(self.types.count)
        try self.types.push(t)
        if self.types.count * 2 > self.index.length:
            try self.grow_index()
        else:
            self.index_add(id)
        return id

    ## Whether `have` is the type `t` describes: the same structure, and for a generic
    ## parameter, which is its own type, or a type without a declaration, the same name.
    func same_type(have: Type, t: Type) -> bool:
        if have.kind != t.kind or have.elem != t.elem or have.length != t.length or have.is_const != t.is_const or have.is_volatile != t.is_volatile or have.variadic != t.variadic or have.decl != t.decl or not self.same_args(have.args, t.args):
            return false
        if t.kind == Kind.param:
            return have.name == t.name
        return have.decl != none or have.name == t.name

    ## Put type `id` into the first empty bucket on its hash's probe path.
    mutating func index_add(id: u32):
        let mask = self.index.length - 1
        var at = (usize)structure_hash(self.types.get((usize)id)) & mask
        while self.index[at] != 0:
            at = (at + 1) & mask
        self.index[at] = id + 1

    ## Twice the buckets, every type re-added.
    mutating func grow_index() -> !:
        let old = self.index
        self.index = try alloc u32[old.length * 2]
        zero_index(self.index)
        var i: usize = 0
        while i < self.types.count:
            self.index_add(u32(i))
            i += 1
        free(old)

    func plain(kind: Kind, elem: u32, name: str) -> Type!:
        return Type(kind = kind, elem = elem, args = try no_args(), length = 0, is_const = false, is_volatile = false, variadic = false, decl = none, name = name)

    # -- constructors ---------------------------------------------------------------------

    pub mutating func pointer(elem: u32, is_const: bool, is_volatile: bool) -> u32!:
        var t = try self.plain(Kind.pointer, elem, "")
        t.is_const = is_const
        t.is_volatile = is_volatile
        return try self.intern(t)

    pub mutating func span(elem: u32, is_const: bool) -> u32!:
        var t = try self.plain(Kind.span, elem, "")
        t.is_const = is_const
        return try self.intern(t)

    pub mutating func array(elem: u32, length: u64) -> u32!:
        var t = try self.plain(Kind.array, elem, "")
        t.length = length
        return try self.intern(t)

    pub mutating func optional(elem: u32) -> u32!:
        if self.kind(elem) == Kind.optional:
            return elem
        return try self.intern(try self.plain(Kind.optional, elem, ""))

    pub mutating func fallible(elem: u32) -> u32!:
        if self.kind(elem) == Kind.fallible:
            return elem
        return try self.intern(try self.plain(Kind.fallible, elem, ""))

    pub mutating func atomic(elem: u32) -> u32!:
        return try self.intern(try self.plain(Kind.atomic, elem, ""))

    pub mutating func tuple(members: u32[]) -> u32!:
        var t = try self.plain(Kind.tuple, 0, "")
        t.args = members
        return try self.intern(t)

    pub mutating func function(params: u32[], result: u32, variadic: bool) -> u32!:
        var t = try self.plain(Kind.func_, result, "")
        t.args = params
        t.variadic = variadic
        return try self.intern(t)

    ## A nominal type for a declaration; the same declaration yields the same id.
    pub mutating func nominal(kind: Kind, decl: ast.Node*, args: u32[]) -> u32!:
        var t = try self.plain(kind, 0, decl.text)
        t.decl = decl
        t.args = args
        return try self.intern(t)

    ## A generic parameter of a declaration.
    pub mutating func parameter(decl: ast.Node*, name: str) -> u32!:
        var t = try self.plain(Kind.param, 0, name)
        t.decl = decl
        return try self.intern(t)

    # -- predicates -----------------------------------------------------------------------

    pub func is_integer(id: u32) -> bool:
        let k = (u8)self.kind(id)
        return (k >= (u8)Kind.i8_ and k <= (u8)Kind.usize_) or k == (u8)Kind.untyped_int

    pub func is_signed(id: u32) -> bool:
        let k = self.kind(id)
        return k == Kind.i8_ or k == Kind.i16_ or k == Kind.i32_ or k == Kind.i64_ or k == Kind.isize_ or k == Kind.untyped_int

    pub func is_float(id: u32) -> bool:
        let k = self.kind(id)
        return k == Kind.f16_ or k == Kind.f32_ or k == Kind.f64_ or k == Kind.untyped_float

    pub func is_numeric(id: u32) -> bool:
        return self.is_integer(id) or self.is_float(id)

    ## A vector (§5.12): an array of one integer type of a stated width, or of `f32` or
    ## `f64`, whose bytes number eight or sixteen.
    pub func is_vector(id: u32) -> bool:
        let t = self.get(id)
        if t.kind != Kind.array or is_distinct_c(t.elem):
            return false
        let k = self.kind(t.elem)
        let lane = k == Kind.i8_ or k == Kind.i16_ or k == Kind.i32_ or k == Kind.i64_ or k == Kind.u8_ or k == Kind.u16_ or k == Kind.u32_ or k == Kind.u64_ or k == Kind.f32_ or k == Kind.f64_
        if not lane:
            return false
        let bytes = self.size_of(t.elem) * t.length
        return bytes == 8 or bytes == 16

    pub func is_pointer(id: u32) -> bool:
        return self.kind(id) == Kind.pointer

    ## `T*?`, `c.str?`, and `func(...)?` are one word with null as the niche (§5.3, §5.5,
    ## §5.6); an interface view's optional is the two-word view with a null data word
    ## (§14.3). None of them carries a flag.
    pub func has_null_niche(elem: u32) -> bool:
        let inner = self.kind(elem)
        return inner == Kind.pointer or inner == Kind.cstr_ or inner == Kind.func_ or inner == Kind.interface_ or self.is_opaque_handle(elem)

    ## An `extern type Name` with no integer shape: a pointer-shaped handle that is never
    ## null bare and keeps `none` in the null niche (§17.1).
    pub func is_opaque_handle(id: u32) -> bool:
        let t = self.get(id)
        if t.kind != Kind.struct_:
            return false
        let d = t.decl else return false
        return d.kind == ast.Kind.extern_type and d.ty == none

    ## An optional that is one word with null as its niche rather than a flag.
    pub func is_nullable_pointer(id: u32) -> bool:
        let t = self.get(id)
        return t.kind == Kind.optional and self.has_null_niche(t.elem) and self.kind(t.elem) != Kind.interface_

    ## `Writer?`: an interface view's optional, the two-word view whose data word is null
    ## for `none` (§14.3).
    pub func is_nullable_view(id: u32) -> bool:
        let t = self.get(id)
        return t.kind == Kind.optional and self.kind(t.elem) == Kind.interface_

    ## Bits of an integer or float type; `isize` and `usize` are the target's word; 0 for
    ## anything else.
    pub func bits(id: u32) -> u32:
        match self.kind(id):
            .i8_, .u8_: return 8
            .i16_, .u16_: return 16
            .i32_, .u32_: return 32
            .i64_, .u64_, .untyped_int: return 64
            .isize_, .usize_: return (u32)(self.word * 8)
            .f16_: return 16
            .f32_: return 32
            .f64_, .untyped_float: return 64
            .char_: return 32
            .bool_: return 8
            _: return 0

    ## Whether an integer of `from` widens implicitly to `to` (base.md §7.5):
    ## the same signedness and no fewer bits.
    pub func widens(source: u32, target: u32) -> bool:
        if not self.is_integer(source) or not self.is_integer(target):
            return false
        if is_distinct_c(source) or is_distinct_c(target):
            return false
        if self.kind(source) == Kind.untyped_int:
            return true
        # strictly wider: `u64` and `usize` share a width and stay distinct (§5.1)
        return self.is_signed(source) == self.is_signed(target) and self.bits(source) < self.bits(target)

    ## Whether the zero bit pattern is a valid value (base.md §6.1).
    pub func zeroable(id: u32) -> bool:
        if self.is_opaque_handle(id):
            return false    # never null bare (§17.1)
        let t = self.get(id)
        match t.kind:
            .pointer, .cstr_, .func_, .never_, .error_, .fmt_, .void_, .param: return false
            .optional: return true
            .array: return self.zeroable(t.elem)
            .tuple:
                for m in t.args:
                    if not self.zeroable(m):
                        return false
                return true
            .struct_, .union_:
                if let decl = t.decl:
                    var cursor = decl.body
                    while let member = cursor:
                        if member.kind == ast.Kind.field and not self.zeroable(member.type_id):
                            return false
                        cursor = member.next
                return true
            .enum_:
                # integer-backed enums need a case for zero; payload enums use tag 0
                return true
            .interface_: return false
            _: return true

    # -- layout ---------------------------------------------------------------------------

    ## Sizes and alignments of a type; a generic instance's fields are measured with
    ## the declaration's parameters standing for the instance's arguments.
    pub func size_of(id: u32) -> u64:
        return self.sized(id, none, no_args_view())

    pub func align_of(id: u32) -> u64:
        return self.aligned(id, none, no_args_view())

    ## The parameter `t` (of `env_decl`) resolved through `env_args`, or the id itself.
    func through(id: u32, env_decl: ast.Node*?, env_args: u32[]) -> u32:
        let t = self.get(id)
        if t.kind != Kind.param:
            return id
        let d = env_decl else return id
        let owner = t.decl else return id
        if owner != d:
            return id
        var index: usize = 0
        var cursor = d.left
        if let l = cursor:
            if l.kind == ast.Kind.generic_param:
                cursor = l.body
            else:
                cursor = none
        while let g = cursor:
            if g.text == t.name:
                return env_args[index] if index < env_args.length else id
            index += 1
            cursor = g.next
        return id

    ## An instance's arguments resolved through the enclosing environment, into `out`.
    func instance_args(t: Type, env_decl: ast.Node*?, env_args: u32[], out: u32[]) -> u32[]:
        var n: usize = 0
        while n < t.args.length and n < out.length:
            out[n] = self.through(t.args[n], env_decl, env_args)
            n += 1
        return out[..<n]

    func sized(id: u32, env_decl: ast.Node*?, env_args: u32[]) -> u64:
        if self.is_opaque_handle(id):
            return self.word    # a pointer-shaped handle (§17.1)
        let t = self.get(id)
        match t.kind:
            .i8_, .u8_, .bool_: return 1
            .i16_, .u16_, .f16_: return 2
            .i32_, .u32_, .f32_, .char_, .error_code: return 4
            .i64_, .u64_, .f64_, .untyped_int, .untyped_float: return 8
            .isize_, .usize_, .pointer, .func_, .cstr_: return self.word
            .str_, .span, .interface_, .fmt_: return 2 * self.word
            .error_value: return 3 * self.word
            .param:
                let resolved = self.through(id, env_decl, env_args)
                return 0 if resolved == id else self.sized(resolved, none, no_args_view())
            .array: return self.sized(t.elem, env_decl, env_args) * t.length
            .atomic: return self.sized(t.elem, env_decl, env_args)
            .optional:
                if self.has_null_niche(t.elem):
                    return self.sized(t.elem, env_decl, env_args)    # the payload itself
                let inner = self.sized(t.elem, env_decl, env_args)
                let a = self.aligned(t.elem, env_decl, env_args)
                return round_up(inner, a) + a if a > 0 else inner + 1
            .fallible:
                # the value, then the error (a code and a message), then the flag, as C lays them out
                let inner = self.sized(t.elem, env_decl, env_args) if t.elem != unit_id and t.elem != never_id else 0
                return round_up(round_up(inner, self.word) + 3 * self.word + 1, self.word)
            .tuple:
                var offset: u64 = 0
                var largest: u64 = 1
                for m in t.args:
                    let a = self.aligned(m, env_decl, env_args)
                    offset = round_up(offset, a) + self.sized(m, env_decl, env_args)
                    largest = a if a > largest else largest
                return round_up(offset, largest)
            .struct_:
                var offset: u64 = 0
                var largest: u64 = 1
                let decl = t.decl else return 0
                var room: u32[16]
                let inner = self.instance_args(t, env_decl, env_args, room)
                var cursor = decl.body
                while let member = cursor:
                    if member.kind == ast.Kind.field:
                        let a = field_align(self.aligned(member.type_id, decl, inner), member)
                        if not decl.has(ast.flag_packed):
                            offset = round_up(offset, a)
                        offset += self.sized(member.type_id, decl, inner)
                        largest = a if a > largest else largest
                    cursor = member.next
                if decl.has(ast.flag_packed):
                    return offset
                return round_up(offset, declared_align(largest, decl))
            .union_:
                var largest: u64 = 0
                var widest: u64 = 1
                let decl = t.decl else return 0
                var room: u32[16]
                let inner = self.instance_args(t, env_decl, env_args, room)
                var cursor = decl.body
                while let member = cursor:
                    if member.kind == ast.Kind.field:
                        let s = self.sized(member.type_id, decl, inner)
                        largest = s if s > largest else largest
                        let a = field_align(self.aligned(member.type_id, decl, inner), member)
                        widest = a if a > widest else widest
                    cursor = member.next
                return round_up(largest, widest)
            .enum_:
                let decl = t.decl else return 4
                if let backing = decl.ty:
                    return self.sized(backing.type_id, none, no_args_view()) if backing.type_id != none_id else 4
                var room: u32[16]
                let inner = self.instance_args(t, env_decl, env_args, room)
                var largest: u64 = 0
                var widest: u64 = 4
                var cursor = decl.body
                while let node = cursor:
                    if node.kind == ast.Kind.enum_case:
                        var offset: u64 = 0
                        var pcursor = node.body
                        while let p = pcursor:
                            let a = self.aligned(p.type_id, decl, inner)
                            offset = round_up(offset, a) + self.sized(p.type_id, decl, inner)
                            widest = a if a > widest else widest
                            pcursor = p.next
                        largest = offset if offset > largest else largest
                    cursor = node.next
                return round_up(round_up(4, widest) + largest, widest)
            _: return 0

    func aligned(id: u32, env_decl: ast.Node*?, env_args: u32[]) -> u64:
        if self.is_opaque_handle(id):
            return self.word
        let t = self.get(id)
        match t.kind:
            .param:
                let resolved = self.through(id, env_decl, env_args)
                return 1 if resolved == id else self.aligned(resolved, none, no_args_view())
            .array: return self.aligned(t.elem, env_decl, env_args)
            .atomic: return self.aligned(t.elem, env_decl, env_args)
            .optional:
                if self.has_null_niche(t.elem):
                    return self.aligned(t.elem, env_decl, env_args)
                let a = self.aligned(t.elem, env_decl, env_args)
                return a if a > 0 else 1
            .fallible: return self.word
            .tuple:
                var widest: u64 = 1
                for m in t.args:
                    let a = self.aligned(m, env_decl, env_args)
                    widest = a if a > widest else widest
                return widest
            .struct_, .union_, .enum_:
                let decl = t.decl else return 1
                if decl.has(ast.flag_packed):
                    return 1
                if t.kind == Kind.enum_:
                    if let backing = decl.ty:
                        return self.aligned(backing.type_id, none, no_args_view()) if backing.type_id != none_id else 4
                var room: u32[16]
                let inner = self.instance_args(t, env_decl, env_args, room)
                var widest: u64 = 4 if t.kind == Kind.enum_ else 1
                var cursor = decl.body
                while let member = cursor:
                    if member.kind == ast.Kind.field:
                        let a = field_align(self.aligned(member.type_id, decl, inner), member)
                        widest = a if a > widest else widest
                    elif member.kind == ast.Kind.enum_case:
                        var pcursor = member.body
                        while let p = pcursor:
                            let a = self.aligned(p.type_id, decl, inner)
                            widest = a if a > widest else widest
                            pcursor = p.next
                    cursor = member.next
                return declared_align(widest, decl)
            .str_, .span, .interface_, .fmt_, .error_value: return self.word
            _:
                let s = self.sized(id, env_decl, env_args)
                return s if s > 0 else 1

    ## A field's alignment: its type's, raised by the `align(N)` before the field (§5.11).
    ## Every layout, in the table and in the backends, places a field by this.
    pub func field_alignment(id: u32, member: ast.Node*) -> u64:
        return field_align(self.align_of(id), member)

    ## Byte offset of `field` in the struct `id`; 0 when absent.
    pub func offset_of(id: u32, field: str) -> u64:
        let t = self.get(id)
        let decl = t.decl else return 0
        var room: u32[16]
        let inner = self.instance_args(t, none, no_args_view(), room)
        var offset: u64 = 0
        var cursor = decl.body
        while let member = cursor:
            if member.kind == ast.Kind.field:
                if not decl.has(ast.flag_packed):
                    offset = round_up(offset, field_align(self.aligned(member.type_id, decl, inner), member))
                if member.text == field:
                    return offset
                offset += self.sized(member.type_id, decl, inner)
            cursor = member.next
        return 0

    # -- names ----------------------------------------------------------------------------

    ## Write the type as a programmer would spell it, for diagnostics.
    pub func describe(out: io.Writer, id: u32) -> !:
        let t = self.get(id)
        match t.kind:
            .pointer:
                if t.is_const:
                    try out.write("const ")
                if t.is_volatile:
                    try out.write("volatile ")
                try self.describe(out, t.elem)
                try out.write("*")
            .span:
                if t.is_const:
                    try out.write("const ")
                try self.describe(out, t.elem)
                try out.write("[]")
            .array:
                try self.describe(out, t.elem)
                try out.write(f"[{t.length}]")
            .optional:
                try self.describe(out, t.elem)
                try out.write("?")
            .fallible:
                if t.elem != unit_id:
                    try self.describe(out, t.elem)
                try out.write("!")
            .atomic:
                try out.write("@")
                try self.describe(out, t.elem)
            .tuple:
                try out.write("(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try out.write(", ")
                    try self.describe(out, t.args[i])
                    i += 1
                try out.write(")")
            .func_:
                try out.write("func(")
                var i: usize = 0
                while i < t.args.length:
                    if i > 0:
                        try out.write(", ")
                    try self.describe(out, t.args[i])
                    i += 1
                try out.write(") -> ")
                try self.describe(out, t.elem)
            .struct_, .enum_, .union_, .interface_, .param, .module, .type_name:
                try out.write(t.name)
                if t.args.length > 0:
                    try out.write("[")
                    var i: usize = 0
                    while i < t.args.length:
                        if i > 0:
                            try out.write(", ")
                        try self.describe(out, t.args[i])
                        i += 1
                    try out.write("]")
            _:
                try out.write(t.name)

## An empty argument list: a one-element allocation sliced to nothing, since a
## Base array literal cannot be empty (§5.4).
## An empty argument list that lives forever, for measuring types outside any instance.
var no_arguments: u32[1]

func no_args_view() -> u32[]:
    return no_arguments[..<0]

pub func no_args() -> u32[]!:
    let one = try alloc u32[1]
    return one[..<0]

func round_up(value: u64, align: u64) -> u64:
    if align <= 1:
        return value
    return (value + align - 1) // align * align

# mark: Tests ==================================================================================

test "scalars are seeded at fixed ids and interning deduplicates":
    var backing: u8[65536]
    var arena = memory.FixedBuffer.over(backing)
    with arena:
        var table = try Table.create()
        assert(table.kind(i64_id) == Kind.i64_)
        assert(table.kind(str_id) == Kind.str_)
        let p1 = try table.pointer(u8_id, true, false)
        let p2 = try table.pointer(u8_id, true, false)
        let p3 = try table.pointer(u8_id, false, false)
        assert(p1 == p2)
        assert(p1 != p3)
        let o = try table.optional(p3)
        assert(table.is_nullable_pointer(o))
        assert(table.size_of(o) == 8)
        assert(table.size_of(try table.array(i32_id, 5)) == 20)
        var members: u32[2] = [u8_id, i64_id]
        let tup = try table.tuple(members)
        assert(table.size_of(tup) == 16)
        assert(table.align_of(tup) == 8)
        assert(table.widens(u8_id, u32_id))
        assert(not table.widens(u8_id, i32_id))

## The `N` of `align(N)` (§5.11) on a declaration or a field, a decimal literal, or 0 when
## there is none.
func explicit_align(n: ast.Node*?) -> u64:
    let e = n else return 0
    if e.kind != ast.Kind.literal:
        return 0
    var value: u64 = 0
    for b in e.text.bytes:
        if b < '0' or b > '9':
            return 0
        value = value * 10 + (u64)(b - '0')
    return value

## A field's alignment: its type's, raised by `align(N)` before the field.
func field_align(natural: u64, member: ast.Node*) -> u64:
    let e = explicit_align(member.right)
    return e if e > natural else natural

## A struct's alignment: its widest field's, raised by `align(N)` before the struct.
func declared_align(natural: u64, decl: ast.Node*) -> u64:
    if decl.kind != ast.Kind.struct_:
        return natural
    let e = explicit_align(decl.right)
    return e if e > natural else natural
