## The same algorithms and traversal order as kernels.c. Exporting keeps the
## measurement driver identical and prevents whole-program constant folding.
import geometry
import memory

export func integer_mix(iterations: usize, seed: u64) -> u64:
    var value = seed
    var at: usize = 0
    while at < iterations:
        value ^= value >> 12
        value ^= value << 25
        value ^= value >> 27
        value *%= 2685821657736338717
        at += 1
    return value

export func float_recurrence(iterations: usize, seed: f64) -> f64:
    var value = seed
    var at: usize = 0
    while at < iterations:
        value = value * 0.99999994 + 0.00000003
        at += 1
    return value

export func sum_words(values: const u64[], rounds: usize) -> u64:
    var result: u64 = 0
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < values.length:
            result +%= values[at]
            at += 1
        round += 1
    return result

export func transform(values: f64[], source: const f64[], rounds: usize):
    assert(values.length == source.length)
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < values.length:
            values[at] = values[at] * 0.999 + source[at] * 0.001
            at += 1
        round += 1

export func byte_scan(data: const u8[], rounds: usize) -> u64:
    var count: u64 = 0
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < data.length:
            let value = data[at]
            if value == 10 or value == 13 or value == 32:
                count +%= 1
            at += 1
        round += 1
    return count

## An unpredictable dependent load isolates indexing and memory latency.
export func chase(links: const u32[], steps: usize, start: u32) -> u32:
    var current = start
    var at: usize = 0
    while at < steps:
        current = links[current]
        at += 1
    return current

## Deliberately ordinary i/j/k multiplication, without tiling in either language.
export func matrix_product(a: const f64[], b: const f64[], out: f64[], width: usize, rounds: usize):
    assert(a.length == width * width and b.length == a.length and out.length == a.length)
    var round: usize = 0
    while round < rounds:
        var row: usize = 0
        while row < width:
            var column: usize = 0
            while column < width:
                var value: f64 = 0.0
                var inner: usize = 0
                while inner < width:
                    value += a[row * width + inner] * b[inner * width + column]
                    inner += 1
                out[row * width + column] = value
                column += 1
            row += 1
        round += 1

## Unaligned 32-bit words read and written through `memory.read` and `memory.write`, the
## shape of a codec's bit packing; each round changes every word, so no copy is skipped.
export func word_copy(out: u8[], data: const u8[], rounds: usize):
    assert(out.length == data.length and data.length > 0)
    let words = (data.length - 1) // 4
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < words:
            let value = memory.read[u32]((const void*)&data[at * 4 + 1])
            memory.write[u32]((void*)&out[at * 4 + 1], value ^ (u32)round)
            at += 1
        round += 1

## Each point's normal from its two predecessors, through another module's Vector3 methods
## (geometry.lucb), the largest z kept and the x summed: luce-geocore's per-face kernels.
export func vector_normals(values: const f64[], rounds: usize) -> f64:
    assert(values.length >= 9 and values.length % 3 == 0)
    let points = values.length // 3
    var total: f64 = 0.0
    var round: usize = 0
    while round < rounds:
        var at: usize = 2
        while at < points:
            let a = geometry.Vector3(values[at * 3], values[at * 3 + 1], values[at * 3 + 2])
            let b = geometry.Vector3(values[at * 3 - 3], values[at * 3 - 2], values[at * 3 - 1])
            let c = geometry.Vector3(values[at * 3 - 6], values[at * 3 - 5], values[at * 3 - 4])
            let n = a.subtract(b).cross(c.subtract(b))
            total = geometry.max(total * 0.5, n.z) + n.x
            at += 1
        round += 1
    return total

## A Huffman-style bit reader, the shape of inflate's inner loop: a 64-bit accumulator refilled
## a byte at a time under a masked shift, a 12-bit table lookup, the symbol's length shifted
## out, and a loop condition of two comparisons joined by `and`.
export func bit_decode(data: const u8[], table: const u32[], rounds: usize) -> u64:
    assert(data.length > 16 and table.length == 4096)
    var total: u64 = 0
    var round: usize = 0
    while round < rounds:
        var acc: u64 = 0
        var bits: u32 = 0
        var pos: usize = 0
        while pos + 8 <= data.length and total != 1:
            while bits <= 56 and pos < data.length:
                acc |= (u64)data[pos] << (u64)(bits & 63)
                bits = bits +% 8
                pos += 1
            let e = table[(usize)(acc & 4095)]
            acc >>= (u64)(e & 15)
            bits = bits -% (e & 15)
            total = total +% (u64)(e >> 4)
        round += 1
    return total
