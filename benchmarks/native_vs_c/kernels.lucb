## The same algorithms and traversal order as kernels.c. Exporting keeps the
## measurement driver identical and prevents whole-program constant folding.
import geometry
import memory
import strings

export func integer_mix(iterations: usize, seed: u64) -> u64:
    var value = seed
    var at: usize = 0
    while at < iterations:
        value ^= value >> 12
        value ^= value << 25
        value ^= value >> 27
        value *%= 2685821657736338717
        at += 1
    return value

export func float_recurrence(iterations: usize, seed: f64) -> f64:
    var value = seed
    var at: usize = 0
    while at < iterations:
        value = value * 0.99999994 + 0.00000003
        at += 1
    return value

export func sum_words(values: const u64[], rounds: usize) -> u64:
    var result: u64 = 0
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < values.length:
            result +%= values[at]
            at += 1
        round += 1
    return result

export func transform(values: f64[], source: const f64[], rounds: usize):
    assert(values.length == source.length)
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < values.length:
            values[at] = values[at] * 0.999 + source[at] * 0.001
            at += 1
        round += 1

export func byte_scan(data: const u8[], rounds: usize) -> u64:
    var count: u64 = 0
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < data.length:
            let value = data[at]
            if value == 10 or value == 13 or value == 32:
                count +%= 1
            at += 1
        round += 1
    return count

## An unpredictable dependent load isolates indexing and memory latency.
export func chase(links: const u32[], steps: usize, start: u32) -> u32:
    var current = start
    var at: usize = 0
    while at < steps:
        current = links[current]
        at += 1
    return current

## Deliberately ordinary i/j/k multiplication, without tiling in either language.
export func matrix_product(a: const f64[], b: const f64[], out: f64[], width: usize, rounds: usize):
    assert(a.length == width * width and b.length == a.length and out.length == a.length)
    var round: usize = 0
    while round < rounds:
        var row: usize = 0
        while row < width:
            var column: usize = 0
            while column < width:
                var value: f64 = 0.0
                var inner: usize = 0
                while inner < width:
                    value += a[row * width + inner] * b[inner * width + column]
                    inner += 1
                out[row * width + column] = value
                column += 1
            row += 1
        round += 1

## Unaligned 32-bit words read and written through `memory.read` and `memory.write`, the
## shape of a codec's bit packing; each round changes every word, so no copy is skipped.
export func word_copy(out: u8[], data: const u8[], rounds: usize):
    assert(out.length == data.length and data.length > 0)
    let words = (data.length - 1) // 4
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < words:
            let value = memory.read[u32]((const void*)&data[at * 4 + 1])
            memory.write[u32]((void*)&out[at * 4 + 1], value ^ (u32)round)
            at += 1
        round += 1

## Each point's normal from its two predecessors, through another module's Vector3 methods
## (geometry.lucb), the largest z kept and the x summed: luce-geocore's per-face kernels.
export func vector_normals(values: const f64[], rounds: usize) -> f64:
    assert(values.length >= 9 and values.length % 3 == 0)
    let points = values.length // 3
    var total: f64 = 0.0
    var round: usize = 0
    while round < rounds:
        var at: usize = 2
        while at < points:
            let a = geometry.Vector3(values[at * 3], values[at * 3 + 1], values[at * 3 + 2])
            let b = geometry.Vector3(values[at * 3 - 3], values[at * 3 - 2], values[at * 3 - 1])
            let c = geometry.Vector3(values[at * 3 - 6], values[at * 3 - 5], values[at * 3 - 4])
            let n = a.subtract(b).cross(c.subtract(b))
            total = geometry.max(total * 0.5, n.z) + n.x
            at += 1
        round += 1
    return total

## A Huffman-style bit reader, the shape of inflate's inner loop: a 64-bit accumulator refilled
## a byte at a time under a masked shift, a 12-bit table lookup, the symbol's length shifted
## out, and a loop condition of two comparisons joined by `and`.
export func bit_decode(data: const u8[], table: const u32[], rounds: usize) -> u64:
    assert(data.length > 16 and table.length == 4096)
    var total: u64 = 0
    var round: usize = 0
    while round < rounds:
        var acc: u64 = 0
        var bits: u32 = 0
        var pos: usize = 0
        while pos + 8 <= data.length and total != 1:
            while bits <= 56 and pos < data.length:
                acc |= (u64)data[pos] << (u64)(bits & 63)
                bits = bits +% 8
                pos += 1
            let e = table[(usize)(acc & 4095)]
            acc >>= (u64)(e & 15)
            bits = bits -% (e & 15)
            total = total +% (u64)(e >> 4)
        round += 1
    return total

## Numbers as a usda array or a JSON document writes them, `12.5, -0.375, 0.1234567890123456`,
## read back and summed: std's strings.scan_f64 against the C library's strtod.
export func number_scan(text: const u8[], rounds: usize) -> f64:
    var total: f64 = 0.0
    var round: usize = 0
    while round < rounds:
        var at: usize = 0
        while at < text.length:
            let (value, used) = strings.scan_f64(text[at..]) catch failure:
                recover (0.0, text.length)
            total += value
            at += used + 2
        round += 1
    return total

## One operator of an FM synthesizer's voice, an OPL2's slot: 40 bytes.
struct Operator:
    var state: u32
    var shift: u32
    var select: u32
    var volume: i32
    var sustain: u32
    var vibrato: u32
    var count: u32
    var step: u32
    var feedback: i32[2]

## A voice of two operators: 84 bytes.
struct Voice:
    var operators: Operator[2]
    var block: u32

## The chip: nine voices, the envelope counter and the noise register.
struct Chip:
    var voices: Voice[9]
    var counter: u32
    var noise: u32

## The envelope's increments: a row of eight per rate's low bits.
let rates: u32[16] = [0, 1, 0, 1, 0, 1, 0, 1, 1, 1, 1, 1, 1, 1, 1, 2]

## One sample's operator work, as an OPL2 emulator ported from C writes it (fmopl.c's
## `advance`): each envelope steps through a chain of `if`/`elif` tests of its state, gated
## by the counter's low bits under the operator's shift and read from the rate table; each
## phase advances; the noise register shifts, taking its taps on its low bit.
noinline func advance(chip: Chip*):
    chip.counter +%= 1
    for i: usize in 0..<18:
        let op = &chip.voices[i // 2].operators[i & 1]
        if op.state == 4:
            if (chip.counter & ((1 << op.shift) - 1)) == 0:
                op.volume += (~op.volume * (i32)rates[op.select + ((chip.counter >> op.shift) & 7)]) >> 3
                if op.volume <= 0:
                    op.volume = 0
                    op.state = 3
        elif op.state == 3:
            if (chip.counter & ((1 << op.shift) - 1)) == 0:
                op.volume += (i32)rates[op.select + ((chip.counter >> op.shift) & 7)]
                if (u32)op.volume >= op.sustain:
                    op.state = 2
        elif op.state == 2:
            if (chip.counter & ((1 << op.shift) - 1)) == 0:
                op.volume += (i32)rates[op.select + ((chip.counter >> op.shift) & 7)]
                if op.volume >= 511:
                    op.volume = 511
                    op.state = 1
        elif op.state == 1:
            if (chip.counter & ((1 << op.shift) - 1)) == 0:
                op.volume += (i32)rates[op.select + ((chip.counter >> op.shift) & 7)]
                if op.volume >= 511:
                    op.volume = 511
                    op.state = 4
    for i: usize in 0..<18:
        let voice = &chip.voices[i // 2]
        let op = &voice.operators[i & 1]
        if op.vibrato != 0:
            op.count +%= (voice.block >> 3) *% op.step
        else:
            op.count +%= op.step
    var shifts = chip.counter & 3
    while shifts != 0:
        if (chip.noise & 1) != 0:
            chip.noise ^= 0x800302
        chip.noise >>= 1
        shifts -= 1

## An FM synthesizer's eighteen operators, seeded from `words`, advanced `rounds` samples.
export func operators(words: const u64[], rounds: usize) -> u64:
    assert(words.length >= 18)
    var chip: Chip = ---
    for i: usize in 0..<18:
        let w = words[i]
        chip.voices[i // 2].operators[i & 1] = Operator(state = (u32)(w % 5), shift = (u32)((w >> 8) % 12), select = (u32)((w >> 16) & 1) * 8, volume = (i32)((w >> 24) % 512), sustain = (u32)((w >> 33) % 32) * 16, vibrato = (u32)((w >> 42) & 1), count = (u32)(w >> 43), step = (u32)((w >> 3) & 0xFFFF), feedback = [0, 0])
        chip.voices[i // 2].block = (u32)((w >> 50) & 0x1FFF)
    chip.counter = 0
    chip.noise = 1
    var round: usize = 0
    while round < rounds:
        advance(&chip)
        round += 1
    var total = (u64)chip.noise
    for i: usize in 0..<18:
        let op = &chip.voices[i // 2].operators[i & 1]
        total = total *% 31 +% (u64)op.count +% (u64)(u32)op.volume +% (u64)op.state
    return total
